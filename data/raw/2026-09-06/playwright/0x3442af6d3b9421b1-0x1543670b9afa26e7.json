ull,"0ahUKEwjFm8H79dmWAxX-nq8BHbhHKvsQ3IcHCN8BKAw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjFm8H79dmWAxX-nq8BHbhHKvsQ3IcHCOABKA0",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjFm8H79dmWAxX-nq8BHbhHKvsQ3IcHCOEBKA4",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[null,[1]],null,"建議的餐點",null,"0ahUKEwjFm8H79dmWAxX-nq8BHbhHKvsQ3IcHCOIBKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["在關渡這個小小的市區裡面，這間日式拉麵存在了許多年，常常經過，今天倒是第一次進來。\n點名叫做豚將，想當然的是以豚骨高湯為主的拉麵店。\n整體的氣氛不錯，介紹的文件和消費的方式都明白清楚，我喜歡。牆上的海報製作也是精美，比起那種大圖輸出的裝潢好多了。\n先上的是辣味增燙野菜，通行的人很喜歡，所以大概吃掉了七八成。\n我點的是地獄大蒜豚骨拉麵，細麵果然是比較容易入口的，不過豚骨湯比想像中清淡，辣味對我來說大概只有一兩分意思而已，感覺可以加倍的辣大概還不成問題。叉燒四片是有加價的，原來是兩片。不過覺得這個厚度稍微降低了口感，如果把四片的份量變成三片，增加了厚度可能口感會更滿足些。\n炸餃子搭配拉麵吃起來稍增加了飽足感，不過麵皮太厚是個遺憾啦！\n可樂餅一口都沒吃就不評論了。\n吃完步出門口，看到店家貼著不使用高湯粉而是自熬高湯的海報，急著要走就沒再拍照了。\n整體來說覺得口味比起其他日式拉麵店稍微清淡了點，如果可以自選濃湯或是淡湯的話，也許可以更加吸引人。",null,[0,123]]]],[],[null,null,4586,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUQzOWZmVkh3EAE!2m1!1s0x0:0x1543670b9afa26e7!3m1!1s2@1:CIHM0ogKEICAgID39ffVHw%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUQzOWZmVkh3EAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUQzOWZmVkh3Ei0KF0NJSE0wb2dLRUlDQWdJRDM5ZmZWbndFEhJDZ3NJbk1UbnVRWVFnS1BhYVEaLAoWQ0lITTBvZ0tFSUNBZ0lEMzlmZlZYdxISQ2dzSW5NVG51UVlRZ0tQYWFRIhIJAAAAAAAAAAAR5yb6mgtnQxUqCzBiRFQ3UkNDZDUt\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjFm8H79dmWAxX-nq8BHbhHKvsQoykI4wEoEA"],null,[null,[[1,0]]]],"0ahUKEwjw2MX79dmWAxX7eV4EHZzECRUQ0pMFCH8oBg"],null,null,null,"0ahUKEwjFm8H79dmWAxX-nq8BHbhHKvsQ0pMFCMcBKAY"],[["Ci9DQUlRQUNvZENodHljRjlvT20xdWJ5MTVWbVJQU2kxdlpVVldjMWhCUkU5RGMwRRAB",["0x0:0x1543670b9afa26e7",null,1781689200997299,1782546669325377,[null,null,["https://www.google.com/maps/contrib/106