時，也能感受到清新、溫暖與健康。\n\n這就是我與拉麵的故事。\n一碗麵，不只是味道，\n更是一段旅程、一份心意。\n希望大家也能喜歡我用心打造的這碗拉麵 🍜✨"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-S0XC1_cTwAY/AAAAAAAAAAI/AAAAAAAAAAA/6YoOFMPHZb4/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"臺北市大同區永樂里",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwiijuC999mWAxWculYBHdcnF-EQhbADCLACKAA","全部",[["CIABIhAGbzaqChiQ-2fzHgMABt-E",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmvZdYDL0yvnq1i93EczkFiHONflSzaRqu4prJtC7AEVe-WXmCNb9BMuNLmdN6vvLPGwTla85FUmpMC8DrwqeWqTBoRInz1emoYBCrZuTZwXgLAznA20vacKKIbZ2of5qOeagjugGtDkkaU\u003dw404-h298-k-no","",[1284,947],[203,100]],null,[[3,121.5099209,25.056212499999997],[0,90],[1284,947],75],"jVmdauKTIZz12roP18_ciA4","0ahUKEwiijuC999mWAxWculYBHdcnF-EQzCcIsQIoAA",null,null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhAGbzaqChiQ-2fzHgMABt-E"],[10,3,[947,1284]],null,null,[[[2],[[null,null,25.056212499999997,121.5099209]]]],[1,null,null,null,null,[null,null,"bizbuilder:gmb_on_local_universal_desktop",[6,7,4,1,3]],null,null,[2025,4,7,0]],null,null,null,null,null,null,null,null,null,null,null,null,["UGCS_REFERENCE","CIABIhAGbzaqChiQ-2fzHgMABt-E||","1"]],1,null,null,null,null,null,null,["3765758601074472581","6790775583011295407"],null,"R9VYaCVQDsg"]],null,null,null,null,null,null,0,1,null,0],["CgIgARICGAI\u003d","0ahUKEwiijuC999mWAxWculYBHdcnF-EQhbADCLICKAE","最新",[["CIABIhCfDEMZAne84wiQFMISTPP3",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkMbqLSKQ8H2R9TPHgK1s1xxMaFYYCXSl_3MeJBwDOtGZS8TwWf1D5VcpclM-cI_yO1rZRRNckoeRjUGDJEiBD4Aw60ENRUcv05BBGOYHEOOyhfxwcGlXArK1wDJGLY-57gOWYyZLj9WuE\u003dw224-h298-k-no","",[3000,4000],[203,100]],null,[[3,121.5099209,25.056212499999997],[0,90],[3000,4000],75],"jVmdauKTIZz12roP18_ciA4","0ahUKEwiijuC999mWAxWculYBHdcnF-EQzCcIswIoAA",null,n