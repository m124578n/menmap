,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSURCeXF6eWpRRRAB"]],"CIHM0ogKEICAgIDByqzybQ",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwiq8NSn99mWAxX2FLkGHSh9M_YQ3YcHCGsoAA"]],1],null,null,"訂單類型",null,"0ahUKEwiq8NSn99mWAxX2FLkGHSh9M_YQ3IcHCGooBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiq8NSn99mWAxX2FLkGHSh9M_YQ3YcHCG0oAA"]],1],null,null,"餐點類型",null,"0ahUKEwiq8NSn99mWAxX2FLkGHSh9M_YQ3IcHCGwoBQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwiq8NSn99mWAxX2FLkGHSh9M_YQ3YcHCG8oAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiq8NSn99mWAxX2FLkGHSh9M_YQ3IcHCG4oBg",null,null,null,null,null,1,[[2]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["內用座位不多，約6個雙人座位+4個吧檯座位，小小的空間加上親切的外場妹妹，還有外頭車水馬龍人來人往，像極了在日本旅遊時吃的某家拉麵店，但不同的是這家拉麵店是台式拉麵。\n\n湯底有5種可以選(忘了拍菜單…)，麻辣湯底要額外加10元；今天點的是叉燒拉麵配上豚骨湯底，上菜速度可以說是非常快！是因為在捷運站旁邊的關係嗎…湯底部分不像日式來的濃郁，但口味也是有的，個人感覺偏鹹一點點，但還不到讓人喝了會想喝水的地步；第一眼看到麵條的時候，想說是不是煮太爛了，個人偏好硬一點的，吃了幾口發現煮的剛剛好，軟而不爛，吃起來還是有Q度的；叉燒部分也很有味道，厚薄剛好，不會太薄吃了不滿足，也不會太厚吃了乾柴；配料有海帶芽、魚板、半顆滷蛋、大陸妹、玉米粒，沒錯～就是台式拉麵！\n\n另外點了兩盤小菜，海鮮沙拉和蒲燒鰻；海鮮沙拉大推，吃起來就像是龍蝦沙拉的味道，但口感一級棒，問了店家是說裡面有蝦肉、花枝、魚卵；蒲燒鰻油酯十足，味道也不錯，可惜的是店家沒有賣白飯，不然配上白飯就是蒲燒鰻魚飯了啊～～～\n\n停車部分，因為在新埔捷運站出口，門口附近看起來是沒有汽車停車位，機車車位也常常客滿，較近的就是旁邊64號橋下的停車場了。\n\n整體來說是一間CP值極高的台式拉麵店。",null,[0,83]]]],[null,null,null,null,null,"https://business.google.com/local/business/4576938983226645281/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkNlWEY2ZVdwUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4576938983226645281/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkNlWEY2ZVdwUlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/4576938983226645281/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkNlWEY2ZVdwUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4576938983226645281/customers/reviews/deletereply