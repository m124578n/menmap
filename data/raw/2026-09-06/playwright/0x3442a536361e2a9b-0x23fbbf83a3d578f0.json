l,null,"0ahUKEwjdsb7j9tmWAxUvSfUHHeFkIbsQ3IcHCOUBKBI",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["店內氣氛很安靜，很適合一個人用餐\n使用點餐機自己點餐並結帳\n所以只能接受現金\n這次點油拌拉麵加蛋，另外還有加20元加麵\n\n桌上的魚乾醋很適合加到麵裡面\n建議先吃原味，再加一點麵裡\n如果味道不夠再一點點的加\n魚乾醋剛吃起來會有醋的味道\n到最後會有嚐到一點魚的鮮味\n\n湯麵吃起來偏鹹\n帶著點海鮮的香氣跟鮮味\n就是日式拉麵店會有的樣子\n所以不建議直接喝\n\n乾拌麵的味道很特別\n帶著一點魚的鮮香跟胡椒的風味\n唯一的缺點就是吃到後面會覺得有點太鹹\n\n叉燒飯有用美乃滋跟叉燒\n而且有經過炙燒\n本來以為這次組合應該會很油膩\n結果沒想到意外的清爽\n很適合作為收尾\n\n另外飯類都是限量，這次是晚上六點半來\n我們點完後店員就張貼賣完\n如果想吃飯類的話建議儘早",null,[0,38]]]],[null,1768387537000000,1768387537000000,"7 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfRm5IMmE5b1AzZlo4N0FaUTZfblU1Zw%7CCAEQrcz1_gkiMAoZQ0hfRm5IMmE5b1AzZlo4N0FaUTZfblU1ZxoTQ2d3STBlZWR5d1lRX3BYcDFnTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjdsb7j9tmWAxUvSfUHHeFkIbsQ_2MI6wEoEw"],"https://business.google.com/local/business/11284795925912942161/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHWmxnelNrZFRSMmd5WVZoT1drMVlWazVYVlhjeFdESjRjR0pyUlJBQhAA",[null,null,null,"/local/business/11284795925912942161/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHWmxnelNrZFRSMmd5WVZoT1drMVlWazVYVlhjeFdESjRjR0pyUlJBQhAA"],"https://business.google.com/local/business/11284795925912942161/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHWmxnelNrZFRSMmd5WVZoT1drMVlWazVYVlhjeFdESjRjR0pyUlJBQhAA",[null,null,null,"/local/business/11284795925912942161/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHWmxnelNrZFRSMmd5WVZoT1drMVlWazVYVlhjeFdESjRjR0pyUlJBQhAA"],null,"https://business.google.com/local/business/11284795925912942161/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHWmxnelNrZFRSMmd5WVZoT1drMVlWazVYVlhjeFdESjRjR0pyUlJBQhAA",[null,null,null,"/local/business/11284795925912942161/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHWmxnelNrZFRSMmd5WVZoT1drMVlWazVYVlhjeFdESjRjR0py