CMkBKBQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjcy6iz9tmWAxVlSfUHHTn8J7QQ3IcHCMoBKBU",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["2026/3月，經過幾次，第一次去用餐，店裡乾整潔，可能還不到用餐時間所以人不多，所以只有兩位店員在忙，其他都在休息，店內採用掃碼點餐再先結帳，小孩超過110公分要單點一份餐或其他，店裡有供應免費自助飲料跟水，還有冰淇淋，點了博多滿福套餐，選了和風秋葵跟南瓜可樂餅，老小都喜歡，主餐豚骨拉麵，可以免費加麵，湯頭我喜歡，麵也很Q彈，選了糖心蛋，小孩喜歡，也點了醬油叉燒拉麵，湯頭我不愛所以是我媽媽吃，又點了炸蝦丼飯，炸蝦是酥脆好吃的，最後吃了泰奶冰淇淋，覺得還好但沒有奶精味道可以接受，唯一只有出餐有點慢有點可惜，最後吃的好飽好滿足，小孩說下次還要再來吃。",null,[0,277]]]],[null,null,null,null,null,"https://business.google.com/local/business/4113828771456188976/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGZUdScVRURlpNSGd5VWxab2NsSnFRa3hXTTFaWldqTnNVMWxZWXhBQhAA",[null,null,null,"/local/business/4113828771456188976/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGZUdScVRURlpNSGd5VWxab2NsSnFRa3hXTTFaWldqTnNVMWxZWXhBQhAA"],"https://business.google.com/local/business/4113828771456188976/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGZUdScVRURlpNSGd5VWxab2NsSnFRa3hXTTFaWldqTnNVMWxZWXhBQhAA",[null,null,null,"/local/business/4113828771456188976/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGZUdScVRURlpNSGd5VWxab2NsSnFRa3hXTTFaWldqTnNVMWxZWXhBQhAA"],null,"https://business.google.com/local/business/4113828771456188976/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGZUdScVRURlpNSGd5VWxab2NsSnFRa3hXTTFaWldqTnNVMWxZWXhBQhAA",[null,null,null,"/local/business/4113828771456188976/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGZUdScVRURlpNSGd5VWxab2NsSnFRa3hXTTFaWldqTnNVMWxZWXhBQhAA"]],[null,null,1594,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21FeGRqTTFZMHgyUlZoclJqQkxWM1ZZWjNsU1lYYxAB!2m1!1s0x0:0x627dce986867f73!3m1!1s2@1:CAIQACodChtycF9oOmExdjM1Y0x2RVhrRjBLV3VYZ3lSYXc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local