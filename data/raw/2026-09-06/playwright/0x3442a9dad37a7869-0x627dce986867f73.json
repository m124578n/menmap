HHTn8J7QQ3IcHCO8BKBI",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjcy6iz9tmWAxVlSfUHHTn8J7QQ3IcHCPABKBM",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwjcy6iz9tmWAxVlSfUHHTn8J7QQ3YcHCPIBKAA"]]],null,"用餐人數",null,"0ahUKEwjcy6iz9tmWAxVlSfUHHTn8J7QQ3IcHCPEBKBQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["偶然經過來吃吃看\n採用QR code點餐，麵可以選軟硬度跟免費加麵或減半麵，湯頭口味也可以選濃淡\n\n點了味噌叉燒拉麵、火山熔岩豚骨叉燒拉麵、芙蓉炸蝦丼飯及胡麻時蔬烏龍冷麵\n\n店內的飲料及冰淇淋可以無限續，今天是芒果口味冰淇淋\n飲料是蜂蜜綠茶、檸檬茶及雪梨茶\n\n上菜速度很快，一下子四個人餐點就上齊了～我們16:30進來吃的，大約17:00過沒多久就坐滿，客人滿多的\n\n味噌拉麵的湯頭喝起來是豚骨湯的感覺，比較喝不出味噌的味道；烏龍冷麵的麵很Q彈，好吃😋；炸蝦丼飯的炸蝦有淋醬，是甜辣口味像泰式的醬，但對孩子來說太辣，所以只好大人吃\n\n整體是中規中矩的台式拉麵🍜\n價格算親民，麵條吃起來口感很讚",null,[0,48]]]],[null,null,null,null,null,"https://business.google.com/local/business/4113828771456188976/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZG1Jd01VMVRiRVpLVVZjNVFsUXhhek5UZWtwdFlVZHdWbGRIWXhBQhAA",[null,null,null,"/local/business/4113828771456188976/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZG1Jd01VMVRiRVpLVVZjNVFsUXhhek5UZWtwdFlVZHdWbGRIWXhBQhAA"],"https://business.google.com/local/business/4113828771456188976/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZG1Jd01VMVRiRVpLVVZjNVFsUXhhek5UZWtwdFlVZHdWbGRIWXhBQhAA",[null,null,null,"/local/business/4113828771456188976/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZG1Jd01VMVRiRVpLVVZjNVFsUXhhek5UZWtwdFlVZHdWbGRIWXhBQhAA"],null,"https://business.google.com/local/business/4113828771456188976/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZG1Jd01VMVRiRVpLVVZjNVFsUXhhek5UZWtwdFlVZHdWbGRIWXhBQhAA",[null,null,null,"/local/business/4113828771456188976/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZG1Jd01VMVRiRVpLVVZjNVFsUXhhek5UZWtwdFl