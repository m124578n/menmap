ap/report?postId\u003d!1e10!2sCIABIhDMxbn5AHWQwTSiRgCF68sB\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x5919fb8d1c87610e"]],1,null,null,null,null,null,null,["0","6420439327280947470"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT20xek0wMHlhVU55YWpReldFRlhNamhPTnpSZmMxRRAB"]],"CIABIhDMxbn5AHWQwTSiRgCF68sB",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3YcHCGMoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3IcHCGIoCw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3YcHCGUoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3IcHCGQoDA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3IcHCGYoDQ",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3IcHCGcoDg",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3IcHCGgoDw",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11kqslxy91"],"豚骨魚介沾麵",2,null,null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3YcHCGooAA"],[["M:/g/11n520ks3h"],"豚骨魚介拉麵",2,null,null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3YcHCGsoAQ"]],[1]],null,"建議的餐點",null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3IcHCGkoEA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3YcHCG0oAA"]]],null,"用餐人數",null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3IcHCGwoEQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["拉麵本身表現不錯，湯頭濃郁、全麥麵口感特別，叉燒軟嫩，糖心蛋也很入味，沾麵吃完了可以加高湯，整體餐點有一定水準。\n\n不過，相較於餐點，我對用餐體驗的印象更深刻。從電話訂位時告知有兩位小朋友開始，店家就特別提醒小朋友也需要 280 元低消；之後因為修改了一次訂位人數，又再次提醒一次；到了現場入座前，也再次確認我們是否知道小朋友有低消規定。\n\n我完全能理解店家有自己的規定，也都配合接受，只是短時間內反覆確認好幾次，難免讓人有種被再三提醒、甚至有些緊張的感覺，不禁好奇店家是不是曾經遇過不少爭議，才會如此謹慎。\n\n另外，用餐結束後不到五分鐘，就有服務人員詢問是否可以收走空碗，但當時碗裡還有湯還沒喝完，讓人覺得用餐節奏有點被催促，沒辦法很放鬆地享受這一餐。\n\n如果餐點維持現在的水準，同時能讓客人在用餐過程中多一點從容、少一點壓力，我想整體體驗會更好，拉麵店能訂位是一大特色。",null,[0,114]]]],[null,null,null,null,null,"https://business.google.com/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA",[null,null,null,"/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA"],"https://business.google.com/local/business/14538826069739229445/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA",[null,null,null,"/local/business/14538826069739229445/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA"],null,"https://business.google.com/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA",[null,null,null,"/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA"]],[null,null,1168,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT20xek0wMHlhVU55YWpReldFRlhNamhPTnpSZmMxRRAB!2m1!1s0x0:0x5919fb8d1c87610e!3m1!1s2@1:CAIQACodChtycF9oOm1zM00yaUNyajQzWEFXMjhONzRfc1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT20xek0wMHlhVU55YWpReldFRlhNamhPTnpSZmMxRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQU