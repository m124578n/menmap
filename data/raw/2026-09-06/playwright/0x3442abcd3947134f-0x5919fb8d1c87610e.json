]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,4,28,21,null,null,null,null,["4 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhC6pnmyD82VYhQIdEIT4uF6\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x5919fb8d1c87610e"]],1,null,null,null,null,null,null,["0","6420439327280947470"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xad2MwcHFNR1o0YjJOelJrVmFNakZWU1VKakxVRRAB"]],"CIABIhC6pnmyD82VYhQIdEIT4uF6",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3YcHCMMBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjC8__i99mWAxWBSmwGHfQQLksQ3IcHCMIBKAU",null,null,null,null,null,1,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["整體是有特色、也吃得出用心的一家拉麵店。店內很有日式小店的規矩感，即使現場看起來還有空位，也不一定能直接入座，還是要依照店家的安排先在後方等待。這點一開始會覺得有點不彈性，但也看得出他們對出餐節奏和座位管理滿有制度。\n\n這次吃下來，最有印象的是麵條和湯頭。麵屋緣主打全麥麵，網路上不少評價也提到它的麵條口感很有特色，帶一點小麥香，和一般拉麵店的麵體不太一樣。湯頭則是偏濃厚系，魚介、豚骨、柴魚類的風味明顯，喜歡濃郁日式拉麵的人應該會很買單。\n\n叉燒份量看起來也有誠意，肉片不算薄，搭配湯頭和麵條整體完成度不錯。白醬／濃湯類的品項也滿特別，跟一般拉麵店相比比較有記憶點。網路評價裡也有人特別稱讚叉燒有炙燒香氣、不會太柴，這點跟實際看到的呈現滿一致。\n\n不過這家店不是那種服務很熱情、客人可以完全自由入座的類型，比較像是店家有自己節奏的小店。若用餐尖峰或不習慣這種規矩，可能會覺得稍微被限制；但若能接受這種日式拉麵店的運作方式，餐點本身是有水準的。\n\n整體來說，麵屋緣是值得四顆星的店：麵條有特色、湯頭濃郁、餐點有記憶點，只是入座與服務流程比較有自己的規矩，不一定適合每個人。\n\n問我好吃嗎？我說：還不錯\n為我划算嗎？我說：還行",null,[0,108]]]],[null,null,null,null,null,"https://business.google.com/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZDJNd2NIRk5SMW8wWWpKT2VsSnJWbUZOYWtaV1UxVktha3hWUlJBQhAA",[null,null,null,"/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZDJNd2NIRk5SMW8wWWpKT2VsSnJWbUZOYWtaV1UxVktha3hWUlJBQhAA"],"https://business.google.com/local/business/14538826069739229445/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZDJNd2NIRk5SMW8wWWpKT2VsSnJWbUZOYWtaV1UxVktha3hWUlJBQhAA"