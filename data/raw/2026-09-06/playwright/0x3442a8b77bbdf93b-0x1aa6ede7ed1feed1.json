,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwisqpmM9tmWAxVpGTQIHbP5LDoQ3YcHCFEoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwisqpmM9tmWAxVpGTQIHbP5LDoQ3IcHCFAoAw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwisqpmM9tmWAxVpGTQIHbP5LDoQ3IcHCFIoBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwisqpmM9tmWAxVpGTQIHbP5LDoQ3IcHCFMoBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwisqpmM9tmWAxVpGTQIHbP5LDoQ3IcHCFQoBg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["我是看評論去吃的，一開始看評論想說大家會不會太誇張，形容的也太好吃？所以想說去試試\n\n想不到真的很不錯！麵跟一般拉麵店真的不一樣，麵偏細，有嚼勁又Q，好好吃有驚艷到我\n是給一整顆溏心蛋\n豆芽菜跟玉米也很新鮮，讚讚\n湯頭濃郁但不會厚重，可以全部喝完但不會口乾舌燥！辣豚骨的胡椒辣好香～忍不住多點一碗白飯當湯飯😁\n\n炸豆腐也好吃，炸的很乾爽，蒜蓉醬好蒜好香，旁邊的洋蔥是醃過的酸酸好解膩，配炸豆腐太搭了\n\n老闆跟老闆娘都很客氣。今天結帳少5元老闆娘很客氣跟我說下次路過再還就好！很感激，但還是馬上領錢把五元還回去了🤣\n\n總之是很滿意的台式拉麵店，好喜歡，一定會再回訪！！",null,[0,83]]]],[],[null,null,1014,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xNM2NqQTBRMW80Vms5RWFGTTVTV0ZIU2tseVVVRRAB!2m1!1s0x0:0x1aa6ede7ed1feed1!3m1!1s2@1:CAIQACodChtycF9oOlM3cjA0Q1o4Vk9EaFM5SWFHSklyUUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xNM2NqQTBRMW80Vms5RWFGTTVTV0ZIU2tseVVVRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xNM2NqQTBRMW80Vms5RWFGTTVTV0ZIU2tseVVVRRI-Ci9DQUlRQUNvZENodHljRjlvT2xNM2NqQTBRMW80Vms5RWFGTTVTV0ZIU2tseVVVRRILMGVEZU5JRTU3OHoaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sTTNjakEwUTFvNFZrOUVhRk01U1dGSFNrbHlVVUUSCzBlRGVOSUU1Nzh6IhIJAAAAAAAAAAAR0e4f7eftphoqCzBlRGVOSUU1Nzh6\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwisqpmM9tmWAxVpGTQIHbP5LDoQoykIVSgH"],null,[null,[[1,1]]]],"0ahUKEwi9x52M9tmWAxURe0wIHWeqIlkQ0pMFCAIoAA"],null,null,null,"0ahUKEwisqpmM9tmWAxVpGTQIHbP5