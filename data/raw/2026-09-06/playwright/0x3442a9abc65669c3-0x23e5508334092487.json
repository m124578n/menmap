SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwils5-A99mWAxVKHjQIHYdmJkEQ3YcHCOQBKAA"]]],null,"座位類型",null,"0ahUKEwils5-A99mWAxVKHjQIHYdmJkEQ3IcHCOMBKBE",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["N訪\n一如往常下班後來吃晚餐\n常常覺得晚下班（10點）還能吃到一碗用心的拉麵，真的是一整天裡最幸福的事🥰🥰🥰\n\n濃郁的湯頭與美味的豚雞叉燒、溏心蛋、還有溫暖的老闆、親切的店員～與認真品嚐這碗拉麵時的自己！就覺得感動😭💦\n\n幾個月前覺得高麗菜有點生的感覺，這幾次吃起來覺得更融入湯頭了～非常開心😚\n\nps.第一次去洗手間，把門推開，有嚇一跳的比想像中還大間（有浴缸那種）旁邊還有恐龍真可愛🦖🦕\n\n————————————————————————\n一個月內來訪3次，就是很好吃的證明😆😆😆\n這三次都挑戰吃不同口味（甘味清湯、豚骨、味噌濃蒜）再搭配燒肉丼或叉燒飯，完全大滿足！\n\n非常開心吃到用心的餐點，不論是麵條Q彈、筍乾、豬雞叉燒的嫩度，都很可以的呀～～～\n對了，如果可以 應該將「高麗菜」再更融入麵裡\n（突然吃到清脆的高麗菜，有點驚，因為個人喜歡柔軟的菜🥹）\n\n之後會常常下班來這裡吃一份好吃的晚餐\n也會繼續用行動支持💕💕💕\n\n環境蠻安靜涼快、老闆待人親切👍🏻👍🏻👍🏻",null,[0,54]]]],[null,null,null,null,null,"https://business.google.com/local/business/11832649143266428801/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRTnkweU4yMUlOV1ZEUTBkQkVBRRAA",[null,null,null,"/local/business/11832649143266428801/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRTnkweU4yMUlOV1ZEUTBkQkVBRRAA"],"https://business.google.com/local/business/11832649143266428801/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRTnkweU4yMUlOV1ZEUTBkQkVBRRAA",[null,null,null,"/local/business/11832649143266428801/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRTnkweU4yMUlOV1ZEUTBkQkVBRRAA"],null,"https://business.google.com/local/business/11832649143266428801/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRTnkweU4yMUlOV1ZEUTBkQkVBRRAA",[null,null,null,"/local/business/11832649143266428801/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRTnkweU4yMUlOV1ZEUTBkQkVBRRAA"]],[null,null,12570,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VQNy0yN21INWVDQ0dBEAE!2m1!1s0x0:0x23e5508334092487!3m1!1s2@1:CIHM0ogKEP7-27mH5eCCGA%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VQNy0yN21INWVDQ0dBEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VQNy0yN21I