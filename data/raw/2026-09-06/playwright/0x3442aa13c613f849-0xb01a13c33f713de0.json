,2,null,null,"0ahUKEwjvxtT-9dmWAxUvma8BHdNYBjQQ3YcHCKkBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjvxtT-9dmWAxUvma8BHdNYBjQQ3IcHCKgBKAc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["龍丼亭 日本料理整體走的是一種比較穩定、家常型的日式料理路線，不是那種高級割烹或華麗擺盤的類型，但反而有種樸實耐吃的感覺。餐點選擇以定食、丼飯、生魚片和基本日式料理為主，口味調整得蠻貼近台灣人的習慣，不會太鹹或太重口味，吃起來算順口。\n\n比較有記憶點的是生魚片和幾款炸物，食材新鮮度表現中規中矩，不會驚艷但也不太會踩雷，屬於「穩穩的安全牌」。定食類份量給得還算實在，男生吃也有一定飽足感，加上白飯、味噌湯和小菜的組合，整體完整度OK。\n\n店內環境偏簡單，沒有太多裝潢，但整理得算乾淨，座位安排也不會太擁擠，用餐起來是舒服的。尖峰時間偶爾會需要等一下，不過出餐速度還算正常。\n\n服務方面就是中規中矩，沒有特別熱情但也不會冷淡，整體流程順順的。價格落在日常可以接受的範圍，屬於附近想吃日式料理、又不想花太多預算時會想到的一間店。\n\n整體來說，龍井亭日本料理就是一間「穩定、實在、吃得飽」的日式餐廳，適合平常想簡單吃日料、不追求浮誇但要安心的一餐 🍱🙂",null,[0,117]]]],[null,null,null,null,null,"https://business.google.com/local/business/13180502974332068581/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZDB4WFRuUk5SV3N6VFZSa1IyRkdVa2xhUjJjMFRqRlNlR0pzUlJBQhAA",[null,null,null,"/local/business/13180502974332068581/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZDB4WFRuUk5SV3N6VFZSa1IyRkdVa2xhUjJjMFRqRlNlR0pzUlJBQhAA"],"https://business.google.com/local/business/13180502974332068581/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZDB4WFRuUk5SV3N6VFZSa1IyRkdVa2xhUjJjMFRqRlNlR0pzUlJBQhAA",[null,null,null,"/local/business/13180502974332068581/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZDB4WFRuUk5SV3N6VFZSa1IyRkdVa2xhUjJjMFRqRlNlR0pzUlJBQhAA"],null,"https://business.google.com/local/business/13180502974332068581/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZDB4WFRuUk5SV3N6VFZSa1IyRkdVa2xhUjJjMFRqRlNlR0pzUlJBQhAA",[null,null,null,"/local/business/13180502974332068581/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZDB4WFRuUk5SV3N6VFZSa1IyRkdVa2xhUjJjMFRqRlNlR0pzUlJBQhAA"]],[null,null,869,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21od0xXTnRNRWszTVRkR2FGUklaR2c0TjFSeGJsRRAB!2