003d!1e10!2sCIHM0ogKEICAgICG1dqY9QE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xb01a13c33f713de0",null,null,"0ahUKEwjvxtT-9dmWAxUvma8BHdNYBjQQ-y4IzAEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgICG1dqY9QE"],[10,3,[3024,4032]],[null,null,null,null,null,null,null,["龍丼亭"]],[null,[[["伍玖玖"],"https://www.google.com/maps/contrib/104628999236830952049?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjUAbOsS-f6r5ETR5Qel5m5RoeKcMBmkAG8wgLBRAx6WzYNmmZWCAA\u003ds120-c-rp-mo-ba12-br100",null,null,"104628999236830952049"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2021,11,5,2,null,null,null,null,["4 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICG1dqY9QE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xb01a13c33f713de0"]],1,null,null,null,null,null,null,["0","-5757267444335821344"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUNHMWRxWXBRRRAB"]],"CIHM0ogKEICAgICG1dqY9QE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["晚間到店用餐，1樓座位數不算多，但還有位置。有看到一些家庭客人、與朋友聚餐，空間還算大，座位也算是舒適。\n\n自助區有味增湯跟紅茶、蜂蜜水可以自行取用，還有芝麻跟蔥花可以自助加料。菜單上寫著可以加價增加叉燒跟飯量，但因為第一次來沒點過餐，就先沒有加了，麵條口感也可以依個人喜歡調整。\n\n今天拉麵類點了辣味叉燒麵、丼飯類點了照燒雞腿丼，小菜點了炸豆腐(4塊)、黃金蛋(1顆)。\n\n(不推)小菜，原因是炸豆腐豆腐很小塊，像是鹽酥雞攤的炸豆腐加上醬膏；黃金蛋的醬汁也不夠入味，而且蛋很小顆。\n\n(不推)辣味叉燒麵麵條QQ的挺好吃，湯頭是豚骨湯，上面有一團肉醬攪進湯後有些微辣，叉燒算是軟爛味道普通，但湯頭真的有點鹹，偏台式擔擔麵的口味。\n\n(推)照燒雞腿丼，有一塊烤得香香的雞腿排，端上桌有很香的海苔味，一旁有二根花椰菜跟一小團高麗菜絲，白飯也沾滿了醬汁很下飯。\n\n用餐期間還有很多在地客人來外帶，也有外送員進進出出，價格普通口味普通，生意不算差。整體來說份量還算足夠，但餐點都較鹹，若能調整鹹度會較好。",null,[0,52]]]],[null,null,null,null,null,"https://business.google.com/local/business/13180502974332068581/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkhNV1J4V1hCUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/13180502974332068581/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkhNV1J4V1hCUlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/13180502974332068581/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkhNV1J4V1hCUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/13180502974332068581/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkhNV1J4V1hCUlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/13180502974332068581/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkhNV1J4V1hCUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/13180502974332068581/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkhNV1J4V1hCUlJSQUIQAA%3D%3D"]],[null,null,17093,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUNHMWRxWXBRRRAB!2m1!1s0x0:0xb01a13c33f713de0!3m1!1s2@1:CIHM0ogKEICAgICG1dqYpQE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUNHMWRxWXBRRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUNHMWRxWXBRRRIsChZDSUhNMG9nS0VJQ0FnSUNHMWRxWVpREhJDZ3NJbkxXU2pBWVF5SURnQncaLgoXQ0lITTBvZ0tFSUNBZ0lDRzFkcVk1UUUSE0Nnd0loYldTakFZUWtMS0szZ0UiEgkAAAAAAAAAABHgPXE_wxMasCoLMFdXOGVSLXktMDc\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjvxtT-9dmWAxUvma8BHdNYBjQQoykIzQEoCQ"],null,[null,[[1,13]]]],"0ahUKEwifntv-9dmWAxX7eV4EHVAvCSEQ0pMFCHUoBQ"],null,null,null,"0ahUKEwjvxtT-9dmWAxUvma8BHdNYBjQQ0pMFCLsBKAU"],[["ChdDSUhNMG9nS0VJQ0FnSURXc0tlUTdBRRAB",["0x0:0xb01a13c33f713de0",null,1647152244736829,1653140541105290,[null,null,["https://www.google.com/maps/contrib/111778887427367837757/reviews?hl\u003dzh-TW"],null,null,["Lin Vanessa","https://lh3.googleusercontent.com/a/ACg8ocJRVLpzlvdLRN0r-77pYCN_MgHi9mYPk37nudoEGtHpUPIMDg\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/111778887427367837757?hl\u003dzh-TW"],"111778887427367837757",null,133,215,null,[1,7,1],12,["在地嚮導 · 133 則評論",null,null,null,null,[null,"0ahUKEwjvxtT-9dmWAxUvma8BHdNYBjQQpr8GCM8BKAA"]]]],null,"上次編輯：4 年前",null,null,null,null,null,null,["Goo