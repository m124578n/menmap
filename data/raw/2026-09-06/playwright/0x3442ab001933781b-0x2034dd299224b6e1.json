iXhOLc9dmWAxU-oa8BHfdZJBQQpr8GCJYBKAA"]]]],null,"4 個月前",null,null,null,null,null,null,["Google","https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,1],[[1],null,null,null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwiXhOLc9dmWAxU-oa8BHfdZJBQQ3YcHCJgBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiXhOLc9dmWAxU-oa8BHfdZJBQQ3IcHCJcBKAE",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwiXhOLc9dmWAxU-oa8BHfdZJBQQ3YcHCJoBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiXhOLc9dmWAxU-oa8BHfdZJBQQ3IcHCJkBKAI",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiXhOLc9dmWAxU-oa8BHfdZJBQQ3IcHCJsBKAM",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiXhOLc9dmWAxU-oa8BHfdZJBQQ3IcHCJwBKAQ",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiXhOLc9dmWAxU-oa8BHfdZJBQQ3IcHCJ0BKAU",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_VERY_QUIET"],"非常安靜",2,null,null,"0ahUKEwiXhOLc9dmWAxU-oa8BHfdZJBQQ3YcHCJ8BKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiXhOLc9dmWAxU-oa8BHfdZJBQQ3IcHCJ4BKAY",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["我覺得裝麵所謂的鋁碗有很大的問題，我的材料放進碗裡，放上加熱設備注水之後20秒內就看到碗邊冒白煙有燒焦的味道，但我們不知道什麼情況，等三四分鐘煮好之後在座位上吃就完全是燒焦的味道，整碗麵都是焦炭味，但沒有服務鈴或任何溝通的方式，勉強吃了大約一半，這時候麵湯開始流出弄了我一身，我自己想辦法清潔，店內有超過六隻攝影機可以回放看一下當時我的狼狽狀況，最後麵湯全部流光才看到，原來是我整個碗底大概燒穿掉1/4，鋁箔剝落且碗底焦黑，幸好現場有抹布，我來回擦拭清潔洗抹布大概四五次，整間店是有便利性沒錯，也明顯標榜無人拉麵，但遇上這種情況應該還是要有處置方法",null,[0,274]]]],[],[null,null,564,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xNek9FTlFRVEZCUVhscE9XZHNZMjloVG1aVlozYxAB!2m1!1s0x0:0x2034dd299224b6e1!3m1!1s2@1:CAIQACodChtycF9oOlMzOENQQTFBQXlpOWdsY29hTmZVZ3c%7C%7C?hl\u003dzh-TW"],