人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjPncvl9dmWAxWTkq8BHbziIXgQ3YcHCL8BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjPncvl9dmWAxWTkq8BHbziIXgQ3IcHCL4BKAc",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjPncvl9dmWAxWTkq8BHbziIXgQ3IcHCMABKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjPncvl9dmWAxWTkq8BHbziIXgQ3IcHCMEBKAk",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjPncvl9dmWAxWTkq8BHbziIXgQ3IcHCMIBKAo",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["店內的用餐環境非常的舒適，蠻喜歡的！店員也很熱情。\n招牌的豚骨拉麵175元，湯頭清爽，個人蠻喜歡的，可以再加他們店內的七味粉或是特製的辣椒油，湯頭都會有不一樣的層次👍。裡面各有一個花椰菜跟玉米筍、筍子當蔬菜，玉米筍有稍微燒烤一下，很香。麵體的部分我選的是細麵的基本款，比外面賣的拉麵還細很多，真的是蠻中間值的，另外可能是因為太細了所以跟湯體不太合。糖心蛋很讚不用說。另外豚骨部分很不錯，吃起來有一股炙燒的感覺，放入口中，瞬間口腔充斥著一股迷人的香氣了，我很喜歡！\n40元的桂花紅茶很好喝，桂花香很誘人，推！\n不過今天發生了一個很糟糕的事情，店家忘了給我龍鬚菜，但我已經付錢了😞\n這邊還有集點機制，可以linepay付款喔！",null,[0,25]]]],[null,1725581245000000,1725581245000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04RGFJNDZISlZtMmtlOUFBbWI0QQ%7CCAEQrcz1_gkiMAoZQ0hfQm04RGFJNDZISlZtMmtlOUFBbWI0QRoTQ2d3SXZZX3B0Z1lROXBtMXBRSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjPncvl9dmWAxWTkq8BHbziIXgQ_2MIwwEoCw"],"https://business.google.com/local/business/1630689603408244237/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTklkbkpQV0VSbkVBRRAA",[null,null,null,"/local/business/1630689603408244237/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTklkbkpQV0VSbkVBRRAA"],"https://business.google.com/local/business/1630689603408244237/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTklkbkpQV0VSbkVBRRAA",[null,null,null,"/local/business/1630689603408244237/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTklkbkpQV0VSbkVBRRAA"],null,"https://busin