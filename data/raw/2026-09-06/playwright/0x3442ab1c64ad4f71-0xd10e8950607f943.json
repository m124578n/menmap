ICAgICZtaX5Yg",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3YcHCLsBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3IcHCLoBKAc",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3YcHCL0BKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3IcHCLwBKAg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3YcHCL8BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3IcHCL4BKAk",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3IcHCMABKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3IcHCMEBKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3IcHCMIBKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11t77yc0d6"],"日本柚子迪迪",2,null,null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3YcHCMQBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQ3IcHCMMBKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["晚上臨時想吃拉麵，但21：00後大部份的拉麵店都打烊了，就在google map上找到了這家營業到深夜的拉麵+酒吧。打電話詢問可以只吃拉麵也沒關係，確定後就出發到休憩了。\n\n我點的是日本柚子迪迪拉麵，口味很清爽，喜歡柑橘類/柚子味湯頭的人可以試試，而且詢問之下，才知道雞胸肉有用琴酒醃過，肉的味道非常香。份量不多，是女生吃的完的量，如果是拉麵吃貨應該會吃不飽，需要再多點小菜比較好。\n\n看酒單可以選擇的調酒種類非常多，感覺是以茶類的調酒為主；如果對調酒的口味和材料有疑問，調酒師也都會耐心解答。由於自己在養生中，這次沒有點調酒，不然我是蠻想點「水豚茶」這杯的，聽調酒師說味道會接近港式奶茶，是很多客人推薦的調酒。\n\n整體服務很親切熱情，而且店裡的氛圍很舒適，到處都看得到可愛的水豚玩偶，在這裡用餐很療癒，如果有機會還想介紹朋友一起來~🥺",null,[0,85]]]],[null,null,null,null,null,"https://business.google.com/local/business/14153642209563073577/customers/reviews/repl