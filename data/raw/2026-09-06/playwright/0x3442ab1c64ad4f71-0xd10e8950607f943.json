ll,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["深夜拉麵酒吧\n聽起來超吸引人適合跑吧最終站！\n熱熱的拉麵在冷冷的冬天瞬間暖胃\n當天點的是柚子拉麵以及酸辣拉麵\n_\n淡淡的柚子香會讓我聯想到日本有名的柚子拉麵 一入口香氣撲鼻而來 口腔裡滿滿柚子的甜味與香味出充斥 搭配細拉麵 完美組合欸！\n對於已經跑了三家酒吧的我們 無疑是一種救贖\n_\n酸辣拉麵 吃起來就是東南亞料理\n本人我很愛酸辣的口味 這道也值得給過\n又酸又辣才符合標準！但是很看人有人愛有人不愛！整體的麵條都不會太爛！👍🏻\n_\n個人覺得調酒表現相比之下遜色了點\n酒單很用心介紹的很詳細 裝飾物也有令人驚艷 店長也有用心介紹！只可惜當天點了五杯都沒有對中我們的心啊～～\n_\n適合情侶 朋友 一起吃宵夜好場所❤️",null,[0,38]]]],[null,null,null,null,null,"https://business.google.com/local/business/14153642209563073577/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldjSFpNVTJGUkVBRRAA",[null,null,null,"/local/business/14153642209563073577/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldjSFpNVTJGUkVBRRAA"],"https://business.google.com/local/business/14153642209563073577/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldjSFpNVTJGUkVBRRAA",[null,null,null,"/local/business/14153642209563073577/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldjSFpNVTJGUkVBRRAA"],null,"https://business.google.com/local/business/14153642209563073577/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldjSFpNVTJGUkVBRRAA",[null,null,null,"/local/business/14153642209563073577/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldjSFpNVTJGUkVBRRAA"]],[null,null,9215,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSURWcHZMU2FREAE!2m1!1s0x0:0xd10e8950607f943!3m1!1s2@1:CIHM0ogKEICAgIDVpvLSaQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSURWcHZMU2FREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSURWcHZMU2FREi4KF0NJSE0wb2dLRUlDQWdJRFZwdkxTNlFFEhNDZ3dJM2FyaXF3WVFxSURzd2dFGi0KFkNJSE0wb2dLRUlDQWdJRFZwdkxTR1ESE0Nnd0kzYXJpcXdZUXFJRHN3Z0UiEgkAAAAAAAAAABFD-QcGlegQDSoLMF9UOEtTTkxrLWM\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjMls7Q9dmWAxX5fPUHHeXmFGgQoykI6AEoCg"],null,[null,[[1,2]]]],"0ahUKEwjGw9bQ9dmWA