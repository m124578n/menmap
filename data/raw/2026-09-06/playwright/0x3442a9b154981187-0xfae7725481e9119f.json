,"吵雜程度",null,"0ahUKEwjhwMfB9dmWAxUOZfUHHdQnCF8Q3IcHCFAoBw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwjhwMfB9dmWAxUOZfUHHdQnCF8Q3YcHCFMoAA"]]],null,"座位類型",null,"0ahUKEwjhwMfB9dmWAxUOZfUHHdQnCF8Q3IcHCFIoCA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["第一次來，看到湯頭口味多樣，醬油、鹽味、濃厚雞白糖、甚至還有泡系；這是一個訊號，通常代表樣樣不精。最後想吃清淡點，點了鹽味。\n驚艷點：湯頭佈滿白洋蔥，吃起來卻不辛辣。口味確實清淡，完全可以喝，讓人想到台灣味。\n麵條相當普通，某種程度台灣味。份量不多。\n筍乾意外是充滿了菜脯味的那種，個人不愛，也不算太鹹，也蠻台灣味的。\n糖心蛋味道和口感都毫無特色，沒到難吃地相當普通。\n叉燒算是還算好吃的東西了，配上桌上七味粉，整體還不錯。\n整體就是相當普通，不致於難吃但毫無特色，配上價格只能說沒甚麼讓人二訪的念頭。同樣價格完全可以吃到更有特色的拉麵。\n另一個特色就是裝潢還不錯，以及支援信用卡、Line Pay和可存載具。\n味道是個人主觀感受，但我想回應一個評論：自稱30年古亭人從未踏入此間店，感到慚愧；對於一間兩年前才開的店，也不到有名，不知道慚愧的原因在哪。",null,[0,125]]]],[null,null,null,null,null,"https://business.google.com/local/business/16034476167396523691/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTkUxdGRETmpNazVHWlVac05GTXhiRTlhVlRGSlRWaE9XbFpGUlJBQhAA",[null,null,null,"/local/business/16034476167396523691/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTkUxdGRETmpNazVHWlVac05GTXhiRTlhVlRGSlRWaE9XbFpGUlJBQhAA"],"https://business.google.com/local/business/16034476167396523691/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTkUxdGRETmpNazVHWlVac05GTXhiRTlhVlRGSlRWaE9XbFpGUlJBQhAA",[null,null,null,"/local/business/16034476167396523691/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTkUxdGRETmpNazVHWlVac05GTXhiRTlhVlRGSlRWaE9XbFpGUlJBQhAA"],null,"https://business.google.com/local/business/16034476167396523691/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTkUxdGRETmpNazVHWlVac05GTXhiRTlhVlRGSlRWaE9XbFpGUlJBQhAA",[null,null,null,"/local/business/16034476167396523691/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTkUxdGRETmpNazVHWlVac05GTXhiRTlhVlRGSlRWaE9XbFpGUlJBQhAA"]],[null,null,31