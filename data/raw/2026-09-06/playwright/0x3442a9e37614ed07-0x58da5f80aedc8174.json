,null,[null,[10,"CIHM0ogKEICAgICc-OrPpwE"],[10,3,[4140,5520]],[null,null,null,null,null,null,null,["九湯屋日本拉麵新北永和民生店"]],[null,[[["634 CCS"],"https://www.google.com/maps/contrib/104852572985447110652?hl\u003dzh-TW","https://lh3.googleusercontent.com/a/ACg8ocKOKbkGHYttkZstN-y4l7QLVLiQZkpfNvZbyJTQgoBpQ8cYnA\u003ds120-c-rp-mo-ba12-br100",null,null,"104852572985447110652"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2019,11,3,13,null,null,null,null,["6 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICc-OrPpwE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x58da5f80aedc8174"]],1,null,null,null,null,null,null,["0","6402534826554720628"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUQwNXFUZ3ZRRRAB"]],"CIHM0ogKEICAgICc-OrPpwE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["首先，這家店一進去的第一個感覺是冷氣非常足夠，是不穿外套就會打冷顫的那種，在吃熱騰騰的拉麵的時候就會感覺很爽，而且也能使麵體更快涼下來入口，進入正題，今天我點的是醬油拉麵，他們的拉麵價格以份量來說，在台北來說算是很便宜，我吃完後竟然會感到很飽，而在湯頭味道的體驗上比較不足的是對我來說口味偏淡，醬油拉麵如果可以再鹹一點就更好了，也比較能夠跟甜甜的玉米做襯托，而且湯的量也比較少，或許是麵太多，碗的極限無法盛裝太多東西，麵體本身偏硬，不過我喜歡，如果有要去吃的人也可以帶飲料進去，因為裡面沒付飲料，整體感覺不錯，下次有機會還會去吃。",null,[0,265]]]],[],[null,null,5096,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUQwNXFUZ3ZRRRAB!2m1!1s0x0:0x58da5f80aedc8174!3m1!1s2@1:CIHM0ogKEICAgID05qTgvQE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUQwNXFUZ3ZRRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUQwNXFUZ3ZRRRItChZDSUhNMG9nS0VJQ0FnSUQwNXRTNmZREhNDZ3dJcmJUNzdRVVEtTVBUaHdNGi4KF0NJSE0wb2dLRUlDQWdJRDA1dFM2X1FFEhNDZ3dJcmJUNzdRVVEtTVBUaHdNIhIJAAAAAAAAAAARdIHcroBf2lgqCzBTamhjaGt4RDZz\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwifyJH89tmWAxXHV2wGHe42ELUQoykIrQEoBQ"],null,[null,[[1,2]]]],"0ahUKEwiPhZb89tmWAxW6sawCHX-BDRkQ0pMFCFwoBQ"],null,null,null,"0ahUKEwifyJH89tmWAxXHV2wGHe42ELUQ0pM