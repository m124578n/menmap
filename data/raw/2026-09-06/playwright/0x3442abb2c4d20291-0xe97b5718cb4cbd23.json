額",null,"0ahUKEwjXpN6699mWAxVXs1YBHZasGqEQ3IcHCNYBKAQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjXpN6699mWAxVXs1YBHZasGqEQ3IcHCNgBKAU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjXpN6699mWAxVXs1YBHZasGqEQ3IcHCNkBKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjXpN6699mWAxVXs1YBHZasGqEQ3IcHCNoBKAc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjXpN6699mWAxVXs1YBHZasGqEQ3YcHCNwBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjXpN6699mWAxVXs1YBHZasGqEQ3IcHCNsBKAg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["第一次吃日式沾麵，選了當天限定的蝦沾麵，然後再單點一份叉燒，\n不得不說-一碗沾麵裡面真的各種細節，\n有金桔，也有一點類似蔥油+山葵醬的醬料，\n還有炙燒過的干貝（超好吃，居然能在這價位的拉麵吃到這麼好吃的干貝！），\n\n叉燒也是我吃過最棒的，\n雖然是冷的，但是吃起來有一種很像熟成過的肉品和油脂的香氣，\n照著食用建議先不沾醬單吃麵，\n是我很喜歡的口感，Q彈有嚼勁，\n本身也有獨特的香氣，\n沾了蝦沾醬又是另一個驚豔，味道非常鮮、絕美！\n\n雖然店家有提供高湯，\n讓沒吃完的沾醬可以稀釋成湯品飲用，\n但蝦醬本身實在太美味了，\n我個人是在食用過程中就一點一點的把蝦醬也直接配著麵吃乾抹淨了😅\n\n實在非常喜歡，\n當天只是路過抱持著簡單吃個午餐的心態，\n但這種價位那吃到這樣的品質，\n實在非常超值，\n有時間一定會特地再去拜訪，\n當天吃完就已念念不忘！",null,[0,70]]]],[null,null,null,null,null,"https://business.google.com/local/business/11227828546023699830/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXZUdGcVZrbGxSR1J4VTIxMFFrNXNjRTVhUkZKbVlsaFdNR05JWXhBQhAA",[null,null,null,"/local/business/11227828546023699830/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXZUdGcVZrbGxSR1J4VTIxMFFrNXNjRTVhUkZKbVlsaFdNR05JWXhBQhAA"],"https://business.google.com/local/business/11227828546023699830/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXZUdGcVZrbGxSR1J4VTIxMFFrNXNjRTVhUkZKbVlsaFdNR05JWXhBQhAA",[null,null,null,"/local/business/11227828546023699830/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXZUdGcVZrbGxSR1J4VTIxMFFrNXNjRTVhUk