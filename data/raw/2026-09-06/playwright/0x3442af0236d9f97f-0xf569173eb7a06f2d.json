ll,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["這是一個連鎖拉麵品牌\n我只吃過芝山店\n但每次去吃都很滿意\n\n第一次吃雞湯拉麵\n被頭湯震撼到了\n清澈鮮甜香濃美味\n喝完身體還暖烘烘的\n\n這次點了沒試過的\n真鯛魚白湯拉麵\n有點像帶點海味的雞湯\n而不是我以為的傳統魚湯\n也是很推薦的口味\n\n除了湯頭，麵條、配菜、蛋\n還有份量都讓人滿足\n\n另外，每每來這裡\n我一定會點綜合肉盤\n三種肉大概共有八片\n每片都非常可口美味\n現在漲價要$140\n但想想麵攤一盤嘴邊肉\n只給碎碎幾塊肉就要$80\n隱家的綜合肉盤真是CP值爆表\n建議大家一定要加點啊",null,[0,28]]]],[null,null,null,null,null,"https://business.google.com/local/business/12243181635370566383/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYjFkR1FsbFJWelZ2VFd0YU1rNUVXalpPUjFKRVUwaE9ibEpIWXhBQhAA",[null,null,null,"/local/business/12243181635370566383/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYjFkR1FsbFJWelZ2VFd0YU1rNUVXalpPUjFKRVUwaE9ibEpIWXhBQhAA"],"https://business.google.com/local/business/12243181635370566383/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYjFkR1FsbFJWelZ2VFd0YU1rNUVXalpPUjFKRVUwaE9ibEpIWXhBQhAA",[null,null,null,"/local/business/12243181635370566383/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYjFkR1FsbFJWelZ2VFd0YU1rNUVXalpPUjFKRVUwaE9ibEpIWXhBQhAA"],null,"https://business.google.com/local/business/12243181635370566383/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYjFkR1FsbFJWelZ2VFd0YU1rNUVXalpPUjFKRVUwaE9ibEpIWXhBQhAA",[null,null,null,"/local/business/12243181635370566383/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYjFkR1FsbFJWelZ2VFd0YU1rNUVXalpPUjFKRVUwaE9ibEpIWXhBQhAA"]],[null,null,4598,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pkb1dGQllRVzVvTWtaMk5EWjZOR1JEU0hOblJHYxAB!2m1!1s0x0:0xf569173eb7a06f2d!3m1!1s2@1:CAIQACodChtycF9oOjdoWFBYQW5oMkZ2NDZ6NGRDSHNnRGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pkb1dGQllRVzVvTWtaMk5EWjZOR1JEU0hOblJHYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pkb1dGQl