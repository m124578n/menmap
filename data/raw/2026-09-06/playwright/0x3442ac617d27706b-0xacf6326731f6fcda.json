"],"$1-200",2,null,"$1 到 $200","0ahUKEwjJ5oGu-NmWAxUHZvUHHQ8OLacQ3YcHCIwBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjJ5oGu-NmWAxUHZvUHHQ8OLacQ3IcHCIsBKAQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjJ5oGu-NmWAxUHZvUHHQ8OLacQ3IcHCI0BKAU",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjJ5oGu-NmWAxUHZvUHHQ8OLacQ3IcHCI4BKAY",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjJ5oGu-NmWAxUHZvUHHQ8OLacQ3IcHCI8BKAc",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["2025.07.15\n老闆很用心，除了有在關心客人的評論之外，還真的有聽取建議，今天又來用餐，發現老闆很認真擦桌子，店內清潔也有改善了，地上也沒有常常很多衛生紙亂飛了。\n麵還是很好吃，推薦大家。\n\n\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n2025.07.12\n拉麵好吃，而且上菜速度很快，但是店員不曉得為什麼常常不擦桌子，或者擦不乾淨，每個禮拜都會來吃，但是很少一入座桌子就是乾淨的，每次都是髒的，希望衛生可以加強。",null,[0,97]]]],[null,1752307281000000,1752307281000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfbjBtTHUtbGlWSUkwQTlVLUtyMU5DQQ%7CCAEQrcz1_gkiMAoZQ0hfbjBtTHUtbGlWSUkwQTlVLUtyMU5DQRoTQ2d3STBhekl3d1lRc2NIa3lRTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjJ5oGu-NmWAxUHZvUHHQ8OLacQ_2MIkAEoCA"],"https://business.google.com/local/business/11087343036127346454/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXTVdKSGJFNVRhbWQ2VVZaQk1sWnROVkpVYm5Cb1V6SjBNbFpXUlJBQhAA",[null,null,null,"/local/business/11087343036127346454/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXTVdKSGJFNVRhbWQ2VVZaQk1sWnROVkpVYm5Cb1V6SjBNbFpXUlJBQhAA"],"https://business.google.com/local/business/11087343036127346454/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXTVdKSGJFNVRhbWQ2VVZaQk1sWnROVkpVYm5Cb1V6SjBNbFpXUlJBQhAA",[null,null,null,"/local/business/11087343036127346454/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaR