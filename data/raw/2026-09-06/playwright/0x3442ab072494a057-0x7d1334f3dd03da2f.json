]],null,"座位類型",null,"0ahUKEwjRvubp99mWAxWkDjQIHRcyI20Q3IcHCJoCKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這次造訪這家拉麵店，整體體驗算是頗為滿意。湯頭濃郁但不過油，第一口就能感受到豚骨／柴魚的厚實風味，鹹度與膠質掌握得剛剛好，讓人一喝就感覺溫暖、舒服。麵條有彈性、有咬勁，不會因為浸湯太久就變軟，一口口都保持好的口感。叉燒柔嫩、入口即化，配蛋／蔥花／筍乾等配料也都新鮮、適量 — 整碗吃起來有層次、有細節，但不會過於複雜。\n\n店內氣氛乾淨、燈光柔和，座位安排舒適，服務人員態度友善，上菜速度也算快速。如果要挑剔的話，大概是價位比一般簡單拉麵略高，但考量整體品質與份量，我覺得是值得的。整體來說，非常推薦給想喝一碗「用心熬煮、有溫度」拉麵的人。",null,[0,159]]]],[null,null,null,null,null,"https://business.google.com/local/business/11781067302341308871/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVjAxVmJFaFZNVTAwVmpCTmVWWlZPVVphYlVwTFdXMWtNMUl6WXhBQhAA",[null,null,null,"/local/business/11781067302341308871/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVjAxVmJFaFZNVTAwVmpCTmVWWlZPVVphYlVwTFdXMWtNMUl6WXhBQhAA"],"https://business.google.com/local/business/11781067302341308871/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVjAxVmJFaFZNVTAwVmpCTmVWWlZPVVphYlVwTFdXMWtNMUl6WXhBQhAA",[null,null,null,"/local/business/11781067302341308871/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVjAxVmJFaFZNVTAwVmpCTmVWWlZPVVphYlVwTFdXMWtNMUl6WXhBQhAA"],null,"https://business.google.com/local/business/11781067302341308871/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVjAxVmJFaFZNVTAwVmpCTmVWWlZPVVphYlVwTFdXMWtNMUl6WXhBQhAA",[null,null,null,"/local/business/11781067302341308871/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVjAxVmJFaFZNVTAwVmpCTmVWWlZPVVphYlVwTFdXMWtNMUl6WXhBQhAA"]],[null,null,16954,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21GV01VbEhVMU00VjBNeVZVOUZabUpLWW1kM1IzYxAB!2m1!1s0x0:0x7d1334f3dd03da2f!3m1!1s2@1:CAIQACodChtycF9oOmFWMUlHU1M4V0MyVU9FZmJKYmd3R3c%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21GV01VbEhVMU00VjBNeVZVOUZabUp