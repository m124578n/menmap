,null,["zh-Hant"],[["乾淨、整潔有裝潢的店內（但少了吃日本拉麵應有的風格、氣氛）。店外抽號碼牌等叫號進店，入座後掃碼點餐，飲用水、高湯就請自理。沾麵的麵體Q彈、滑口、粗麵體、有口感（韌性十足）。沾醬重味還有筍干、雞肉丸在其中，雞肉丸雖然小小，但口感很好（不軟爛），不論是雞肉、豬叉燒都是嫩口無誤，溏心蛋（酒味），入口還真是濃濃酒香味，但也相當鹹口的。餐前一小杯冰沙（酸甜味）、餐後一球冰淇淋（香草巧克力），可用手機電子付款。值得一試～",null,[0,206]]]],[null,null,null,null,null,"https://business.google.com/local/business/5852855742768164933/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnllbk5IU2xsbkVBRRAA",[null,null,null,"/local/business/5852855742768164933/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnllbk5IU2xsbkVBRRAA"],"https://business.google.com/local/business/5852855742768164933/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnllbk5IU2xsbkVBRRAA",[null,null,null,"/local/business/5852855742768164933/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnllbk5IU2xsbkVBRRAA"],null,"https://business.google.com/local/business/5852855742768164933/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnllbk5IU2xsbkVBRRAA",[null,null,null,"/local/business/5852855742768164933/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnllbk5IU2xsbkVBRRAA"]],[null,null,13479,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNyenNHSllnEAE!2m1!1s0x0:0xc45a4fb872906ad6!3m1!1s2@1:CIHM0ogKEICAgICrzsGJYg%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUNyenNHSllnEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUNyenNHSllnEi4KF0NJSE0wb2dLRUlDQWdJQ3J6c0dKNGdFEhNDZ3dJMnZ1b3RBWVFxTURqclFJGi0KFkNJSE0wb2dLRUlDQWdJQ3J6c0dKRWcSE0Nnd0k2UG1vdEFZUXdLdmE2UUkiEgkAAAAAAAAAABHWapByuE9axCoLMGFYWXJQX2lELWM\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwj9npz499mWAxWnnq8BHVSdOVUQoykIxAEoHw"],null,[null,[[1,0]]]],"0ahUKEwixlKP499mWAxVWbV4EHX5fKxwQ0pMFCEooAw"],null,null,null,"0ahUKEwj9npz499mWAxWnnq8BHVSdOVUQ0pMFCIkBKAM"],[["ChZDSUhNMG9nS0VJQ0FnSUNyenRHT0dnEAE",["0x0:0xc45a4fb872906ad6",null,1720335857