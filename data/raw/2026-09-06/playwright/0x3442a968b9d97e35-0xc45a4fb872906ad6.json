Fqdav36Cae9vr0P1LrmqQU","0ahUKEwj9npz499mWAxWnnq8BHVSdOVUQzCcIhgEoCg",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDjkPWN5QE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xc45a4fb872906ad6",null,null,"0ahUKEwj9npz499mWAxWnnq8BHVSdOVUQ-y4IhwEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIDjkPWN5QE"],[10,3,[2648,3530]],[null,null,null,null,null,null,null,["麵屋一燈 南京店"]],[null,[[["戽斗"],"https://www.google.com/maps/contrib/116030415446858019923?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjUOHPlhyrk7gFZAF-XH_XW2zs3X38_K7WK4Ji4aPDf0X647IGw\u003ds120-c-rp-mo-ba12-br100",null,null,"116030415446858019923"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2024,4,28,8,null,null,null,null,["2 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDjkPWN5QE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xc45a4fb872906ad6"]],1,null,null,null,null,null,null,["0","-4298035240757073194"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSURqa1BXTk9REAE"]],"CIHM0ogKEICAgIDjkPWN5QE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["✨ 重點整理：新手機第一發🤙(後面有菜單)\n\n這間很有名吧！居然在中山站的拉麵一級戰區開到三層樓，是有沒有賺這麼多🤣。\n\n🍜 淡麗！芳醇干貝雞湯拉麵(麵硬) $238\n🥚 一燈招牌蛋 酒味 $38\n湯頭清澈，清新淡雅的風味，入口鹹香後回甘，肯定會有人喜歡，不過個人覺得整體偏向鹽味拉麵，比較喜歡雞湯味更重一些。豬叉燒很好吃，軟嫩的梅花，咀嚼散發的肉香味十足，而雞叉燒則相形見絀，是沒什麼調味的舒肥雞。不過沒有很喜歡他的麵，雖然表層吸附湯頭的油脂，但似乎不太吸湯汁，所以吃幾口就容易乏味。醣心蛋非常酒，酒味深入蛋黃內部，雖然沒有流心但口感濃厚。\n\n🍜 期間限定！醬油煮干拉麵(麵正常、不要龍鬚菜) $288\n🍖 肉量加倍 $49\n🥚 一燈招牌蛋 原味 $38\n喝了一口朋友的湯，和平常喝到的煮干湯很不一樣，醬油感比較強烈，還隱約嚐到淡淡的鳳梨味(不知道是不是真的有鳳梨🤣)。\n\n每碗拉麵吃完都會附上一碗冰淇淋，有點退冰未完全，還有冰塊在裡面😳。這間整體口味偏清淡(以拉麵來說)，但不會沒味道，適合喜歡清甜口味的人。\n\n📅 造訪日期：2024.04.27\n👨\u200d⚖️ ig請搜尋：戽斗食記",null,[0,59]]]],[null,null,null,null,null,"https://business.google.com/local/business/5852855742768164933/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUnFhMUJYVGs5UkVBRRAA",[null,n