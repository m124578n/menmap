人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwia3v6q-NmWAxX5mq8BHY-bNcUQ3YcHCIsBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwia3v6q-NmWAxX5mq8BHY-bNcUQ3IcHCIoBKAo",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwia3v6q-NmWAxX5mq8BHY-bNcUQ3IcHCIwBKAs",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwia3v6q-NmWAxX5mq8BHY-bNcUQ3IcHCI0BKAw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwia3v6q-NmWAxX5mq8BHY-bNcUQ3IcHCI4BKA0",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_MODERATE"],"有點吵雜",2,null,null,"0ahUKEwia3v6q-NmWAxX5mq8BHY-bNcUQ3YcHCJABKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwia3v6q-NmWAxX5mq8BHY-bNcUQ3IcHCI8BKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwia3v6q-NmWAxX5mq8BHY-bNcUQ3YcHCJIBKAA"]],1],null,null,"等待時間",null,"0ahUKEwia3v6q-NmWAxX5mq8BHY-bNcUQ3IcHCJEBKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["在台北有很多道地的日式拉麵店，所以評價標準也相對嚴格，不過這家拉麵對於附近的上班族或到賣場購物的民眾來說，仍然是一個可以列入考慮的選項。\n\n店面空間迷你，從規模看得出備料空間有限，因此湯頭與肉品應該非傳統日式烹調方式處理，但出餐速度很快、環境相當乾淨。店內裝潢精緻，有吧檯座位可內用，也能選擇到賣場的美食街享用。\n\n湯頭的表現不死鹹，味道順口，配料部分還有炸蒜末，這點算是小小的加分特色。麵條屬於細麵，雖然吃得出不是傳統日式拉麵的煮法，但店員對煮麵的時間和溫度掌握得很好，整體口感還算可以接受。\n\n口味整體中規中矩，不算特別驚豔，但絕對不會踩雷。加上點餐機的使用方便，也能自由加配料，對講求效率的顧客來說相當友善。",null,[0,68]]]],[null,null,null,null,null,"https://business.google.com/local/business/1987814725024032176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHY2xFelJuTlBSR3hUVVc1d01Ga3dOVXRqVlRGMlltNWpOV1J0WXhBQhAA",[null,null,null,"/local/business/1987814725024032176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHY2xFelJuTlBSR3hUVVc1d01Ga3dOVXRqVlRGMlltNWpOV1J0WXhBQhAA"],"https://business.google.com/local/business/1987814