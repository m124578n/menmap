AA"]],1],null,null,"餐點類型",null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3IcHCGUoDQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3YcHCGgoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3IcHCGcoDg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3IcHCGkoDw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3IcHCGooEA",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3IcHCGsoEQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3YcHCG0oAA"]]],null,"座位類型",null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3IcHCGwoEg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["好像沒什麼吃蝦評論，害我想吃蝦搜索不到🤣\n單點白蝦好吃😋\n10隻119不算特別貴，整體還算新鮮，搭配火鍋吃真的挺爽快的，湯也變蝦湯，推薦\n\n點了那個什麼泡泡拉麵，280不便宜，但我覺得比醬油的好吃很多，不懂拉麵的我也覺得挺好吃的，\n尤其吃麵時能感受到檸檬的清香，特別好吃，跟老闆多要一片檸檬老闆也直接幫我送來，很讚😎\n\n低消漲到150了，不過選兩樣蔬菜有折扣價，我點了叉燒飯+溫泉蛋+水蓮+玉米筍，只點到149老闆給過\n水蓮跟玉米筍很鮮甜，而叉燒飯真的非常好吃😋\n\n嗯…拉麵我不是很懂，不好評論（覺得醬油好鹹🤣）\n\n單點叉燒飯青菜是可以的，也是非常好吃的一餐😊\n\n搬來港墘的第一餐，\n挺好吃，豆皮不是炸的非常加分！火鍋料的比例較低，肉幾乎是瘦肉，\n整體吃起來挺健康😋\n\n辣椒沒有加油很讚，湯本身偏鹹，其實不用沾醬就很有味道。\n\n需自行拿餐跟回收，如果餐盤再更好拿一點就好了。\n\n內用冷氣真的跟宣稱一樣開超強🤣",null,[0,68]]]],[null,null,null,null,null,"https://business.google.com/local/business/17605764245117156394/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZQUTBZelNTMXZNbkIxWjJwQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/17605764245117156394/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZQUTBZelNTMXZNbkIxWjJwQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/17605764245117156394/customers/reviews/deletereply?p\u003dCiRDaGREU