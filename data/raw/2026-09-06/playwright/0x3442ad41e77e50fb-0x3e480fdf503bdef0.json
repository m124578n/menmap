喜歡，拌入溫泉蛋有更多變化，很好吃～",null,[0,17]]]],[null,null,null,null,null,"https://business.google.com/local/business/17605764245117156394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVDFGVmFFOWxia3BJVmxVNWFFeFhXbEpoUjNSMFdsaGtXVTVXUlJBQhAA",[null,null,null,"/local/business/17605764245117156394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVDFGVmFFOWxia3BJVmxVNWFFeFhXbEpoUjNSMFdsaGtXVTVXUlJBQhAA"],"https://business.google.com/local/business/17605764245117156394/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVDFGVmFFOWxia3BJVmxVNWFFeFhXbEpoUjNSMFdsaGtXVTVXUlJBQhAA",[null,null,null,"/local/business/17605764245117156394/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVDFGVmFFOWxia3BJVmxVNWFFeFhXbEpoUjNSMFdsaGtXVTVXUlJBQhAA"],null,"https://business.google.com/local/business/17605764245117156394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVDFGVmFFOWxia3BJVmxVNWFFeFhXbEpoUjNSMFdsaGtXVTVXUlJBQhAA",[null,null,null,"/local/business/17605764245117156394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVDFGVmFFOWxia3BJVmxVNWFFeFhXbEpoUjNSMFdsaGtXVTVXUlJBQhAA"]],[null,null,5389,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21ST1FVaE9lbkpIVlU5aExXWlJhR3R0WlhkWU5WRRAB!2m1!1s0x0:0x3e480fdf503bdef0!3m1!1s2@1:CAIQACodChtycF9oOmROQUhOenJHVU9hLWZRaGttZXdYNVE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21ST1FVaE9lbkpIVlU5aExXWlJhR3R0WlhkWU5WRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT21ST1FVaE9lbkpIVlU5aExXWlJhR3R0WlhkWU5WRRI-Ci9DQUlRQUNvZENodHljRjlvT21ST1FVaE9lbkpIVlU5aExXWlJhR3R0WlhkWU5WRRILMGNxcEdPNllEMGgaPgovQ0FJUUFDb2RDaHR5Y0Y5b09tUk9RVWhPZW5KSFZVOWhMV1pSYUd0dFpYZFlOVkUSCzBjcXBHTzZZRDBoIhIJAAAAAAAAAAAR8N47UN8PSD4qCzBjcXBHTzZZRDBo\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAE