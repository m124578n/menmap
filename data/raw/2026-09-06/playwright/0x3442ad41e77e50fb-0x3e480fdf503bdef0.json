,null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3YcHCJ8BKAA"]]],null,"用餐人數",null,"0ahUKEwjWyK6d-NmWAxW3DjQIHeLVAEUQ3IcHCJ4BKA4",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["點了蒜頭雞湯小火鍋（梅花豬增量）+蛤蜊\n和雞貝鹽味玉子拉麵\n小火鍋超推！料很多很好吃\n蒜頭雞湯頭很溫潤\n飯可以無限續、但小火鍋裡有冬粉可以吃\n都是偏原味的蔬菜和少數火鍋料\n整體吃起來很健康無負擔\n湯幾乎喝光光！\n叉燒飯必須點喔！炙燒香氣非常好吃～\n雞貝鹽味的拉麵偏清淡\n不過我剛好今天想吃清湯麵\n所以覺得非常棒\n舒肥雞胸肉也好吃\n溏心蛋很讚！滑嫩且熟度剛好！\n\n小火鍋要自取\n拉麵會由店家送來\n吃完也要記得自己收喔！\n口味非常合我胃口\n下次還想嘗試其他湯底的小火鍋",null,[0,42]]]],[null,null,null,null,null,"https://business.google.com/local/business/17605764245117156394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZVdKdVZqSlZTR3h4WXpKR1UwNVZUakJaYlZwTVRXNW9kMU14UlJBQhAA",[null,null,null,"/local/business/17605764245117156394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZVdKdVZqSlZTR3h4WXpKR1UwNVZUakJaYlZwTVRXNW9kMU14UlJBQhAA"],"https://business.google.com/local/business/17605764245117156394/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZVdKdVZqSlZTR3h4WXpKR1UwNVZUakJaYlZwTVRXNW9kMU14UlJBQhAA",[null,null,null,"/local/business/17605764245117156394/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZVdKdVZqSlZTR3h4WXpKR1UwNVZUakJaYlZwTVRXNW9kMU14UlJBQhAA"],null,"https://business.google.com/local/business/17605764245117156394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZVdKdVZqSlZTR3h4WXpKR1UwNVZUakJaYlZwTVRXNW9kMU14UlJBQhAA",[null,null,null,"/local/business/17605764245117156394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZVdKdVZqSlZTR3h4WXpKR1UwNVZUakJaYlZwTVRXNW9kMU14UlJBQhAA"]],[null,null,10682,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xaeWJuVjJVSGxxYzJGU05VTjBZbVpMTW5od1MxRRAB!2m1!1s0x0:0x3e480fdf503bdef0!3m1!1s2@1:CAIQACodChtycF9oOlZybnV2UHlqc2FSNUN0YmZLMnhwS1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjl