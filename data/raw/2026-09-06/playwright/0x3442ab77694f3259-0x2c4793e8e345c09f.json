w02RoOG8DK9lV\u003ds120-c-rp-mo-br100",null,null,"113574322280386283523"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,7,7,6,null,null,null,null,["1 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDQTMjSGkOw6Z8-sOHxZ7_s\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x2c4793e8e345c09f"]],1,null,null,null,null,null,null,["0","3190681489469980831"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2tWaE9FbDRjME16Y21jek1VbFlWM1ozWXpsTVNYYxAB"]],"CIABIhDQTMjSGkOw6Z8-sOHxZ7_s",1]],null,null,null,[[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwi76Kft99mWAxX9ADQIHYF4LYwQ3YcHCJIBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi76Kft99mWAxX9ADQIHYF4LYwQ3IcHCJEBKAI",null,null,null,null,null,1,[[2]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["餐點出餐速度還算快，大約等候5到10分鐘即可，雖然當下店裡不算繁忙，但是看來廚師們很有餘俗，就算在繁忙時段應該不會等超過20分鐘\n服務員有點多餘，我不知道為什麼帶位要先帶到沒有水壺的座位上，是因為只有一個人嗎？但是整間店很空欸，是有什麼原因這麼做嗎？雖然我當下沒有很想喝水就是了，但是服務真的沒有很好。\n氣氛其實還好，因為開在商店街內部所以不太會有那種安靜吃飯的感覺。\n\n最後是我點的餐點，干貝清湯鹽味拉麵，首先每日限量15份要價340元，在菜單內算是偏貴的餐點，湯頭有鮮甜的味道，但是沒有非常的入味，可能是因為干貝和湯是分開的，並不是用干貝或其他海鮮熬湯。再順帶一提，干貝的種類是瑤柱，所以不要期待裡面有會大口爆汁的帆立貝。其中有兩片雞叉燒和豬叉燒，坦白說跟吃水煮肉沒什麼差別，不用刻意去加點，但是餐點裡面沒有糖心蛋和筍絲，也沒放蔥花而是放洋蔥絲，想挑戰不同口味的人可以嘗試",null,[0,151]]]],[null,null,null,null,null,"https://business.google.com/local/business/7472768851453659966/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXYUU5RmJEUmpNRTE2WTIxamVrMVZiRmxXTTFveldYcHNUVk5ZWXhBQhAA",[null,null,null,"/local/business/7472768851453659966/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXYUU5RmJEUmpNRTE2WTIxamVrMVZiRmxXTTFveldYcHNUVk5ZWXhBQhAA"],"https://business.google.com/local/business/7472768851453659966/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXYUU5RmJEUmpNRTE2WTIxamVrMVZiRmxXTTFveldYcHNUVk5ZWXhBQhAA",[null,null,null,"/local/busin