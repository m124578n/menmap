ull,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjg24mh-NmWAxUGklYBHf52NxAQ3IcHCIMBKA4",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjg24mh-NmWAxUGklYBHf52NxAQ3IcHCIQBKA8",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11kqsltjfx"],"松露牛肝菌拉麵",2,null,null,"0ahUKEwjg24mh-NmWAxUGklYBHf52NxAQ3YcHCIYBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwjg24mh-NmWAxUGklYBHf52NxAQ3IcHCIUBKBA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjg24mh-NmWAxUGklYBHf52NxAQ3YcHCIgBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjg24mh-NmWAxUGklYBHf52NxAQ3IcHCIcBKBE",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["店內環境乾淨明亮，如果坐吧台還能近距離看廚師準備餐點的過程，很有臨場感。\n店內設施也很貼心，有置物籃可以用，餐具則是自取。點餐是用手機掃 QR code，餐前會先送上一小杯可爾必斯冰沙。\n我這次點的是松露牛肝菌雞湯麵，硬度可以依照喜好調整成硬、正常或軟。湯頭端上來就能聞到很濃的松露味，喝起來濃郁但不會過鹹，拉麵裡的配料走台式風格，包含了舒肥雞胸肉、雞腿肉、雞肉丸跟雞胗。老實說，雖然整體味道還不錯，但沒有到讓人印象深刻的地步，不過雞胸肉確實很軟嫩。\n但以這個價位來說，份量感確實偏少了一些，但在現在這個通膨的時代好像也沒辦法。最後飯後還有附贈灑上抹茶粉的香草冰淇淋，算是給這一餐做了一個簡單的收尾。",null,[0,93]]]],[null,null,null,null,null,"https://business.google.com/local/business/10130315969850992271/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFrVVZKSE1IaFRSRkp0V1ZkV01GcEZWa3hSYTFaMFRsWmFjMVJyUlJBQhAA",[null,null,null,"/local/business/10130315969850992271/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFrVVZKSE1IaFRSRkp0V1ZkV01GcEZWa3hSYTFaMFRsWmFjMVJyUlJBQhAA"],"https://business.google.com/local/business/10130315969850992271/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFrVVZKSE1IaFRSRkp0V1ZkV01GcEZWa3hSYTFaMFRsWmFjMVJyUlJBQhAA",[null,null,null,"/local/business/10130315969850992271/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFrVVZKSE1IaFRSRkp0V1ZkV01GcEZWa3hSYTFaMFRsWmFjMVJyUlJBQhAA"],null,"https: