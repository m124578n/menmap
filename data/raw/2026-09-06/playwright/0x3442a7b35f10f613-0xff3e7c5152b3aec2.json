usiness.google.com/local/business/2904753738490998532/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkdPSEIxVFhoM1JSQUIQAQ%3D%3D",[null,null,null,"/local/business/2904753738490998532/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkdPSEIxVFhoM1JSQUIQAQ%3D%3D"],"https://business.google.com/local/business/2904753738490998532/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkdPSEIxVFhoM1JSQUIQAQ%3D%3D",[null,null,null,"/local/business/2904753738490998532/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkdPSEIxVFhoM1JSQUIQAQ%3D%3D"],null,"https://business.google.com/local/business/2904753738490998532/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkdPSEIxVFhoM1JSQUIQAQ%3D%3D",[null,null,null,"/local/business/2904753738490998532/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkdPSEIxVFhoM1JSQUIQAQ%3D%3D"],null,["zh-Hant"],[["謝謝您的意見，叉燒飯在第一週後的確有細微的改版（東西沒有少只是為求速度流暢的流程修改）。但我之後又改回來了，您的意見剛好給我一個要做好就不應妥協的當頭棒喝。再次謝謝再訪，也希望還有機會讓您滿意。",null,[0,97]]]],[null,null,null,["https://www.google.com/maps/@/data\u003d!4m7!23m6!1m5!1sChdDSUhNMG9nS0VJQ0FnSURGOHB1TXh3RRAB!2m1!1s0x0:0xff3e7c5152b3aec2!3m1!1s2@1:CIHM0ogKEICAgIDF8puMxwE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURGOHB1TXh3RRAB\u0026t\u003d3\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURGOHB1TXh3RRItChZDSUhNMG9nS0VJQ0FnSURGOHB1TUp3EhNDZ3dJa01PY3FnWVE2SmlxLUFFIhIJAAAAAAAAAAARwq6zUlF8Pv8qCzBfR201RlUxY2xj\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwj37J6r99mWAxX0ke4BHbxwLi0QoykIrgIoAw"],null,[null,[[1,1]]]],"0ahUKEwjAvKSr99mWAxWugYoHHf5KB8AQ0pMFCOIBKA8"],null,null,null,"0ahUKEwj37J6r99mWAxX0ke4BHbxwLi0Q0pMFCKkCKAc"]]],null,[[[[["Ci9DQUlRQUNvZENodHljRjlvT25odGVEVldOMGhpYkZkc2QzZEJNVWhKT1hKWlJuYxAB",["0x0:0xff3e7c5152b3aec2",null,1779637806246475,1783438475617670,[null,null,["https://www.google.com/maps/contrib/106565826569046201832/reviews?hl\u003dzh-TW"],null,nul