null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiGqdib9tmWAxXKHLkGHbtIG8sQ3YcHCOwBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiGqdib9tmWAxXKHLkGHbtIG8sQ3IcHCOsBKBE",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiGqdib9tmWAxXKHLkGHbtIG8sQ3YcHCO4BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiGqdib9tmWAxXKHLkGHbtIG8sQ3IcHCO0BKBI",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiGqdib9tmWAxXKHLkGHbtIG8sQ3IcHCO8BKBM",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiGqdib9tmWAxXKHLkGHbtIG8sQ3IcHCPABKBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiGqdib9tmWAxXKHLkGHbtIG8sQ3IcHCPEBKBU",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11n6623wv0"],"味噌豚骨拉麵",2,null,null,"0ahUKEwiGqdib9tmWAxXKHLkGHbtIG8sQ3YcHCPMBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiGqdib9tmWAxXKHLkGHbtIG8sQ3IcHCPIBKBY",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["印象中在之前有吃過這家初原麵場，只是沒評論。\n店門口左側有機器可以點餐，付款完會有紙張落下，上面有號碼，進去後找座位，等叫號去餐，吃完有回收台需要自助回收座位比其他三重日式拉麵寬敞多。\n這次點味增豚骨拉麵。\n叉燒我覺得不錯，湯頭就感覺不到味增，但是滿濃郁，若有吃辣的在放飲料的冰箱有辣椒罐，加上去味道會增色不少，加的麵有比較硬一些。\n總之中規中矩，難怪客人也不少。",null,[0,103]]]],[],[null,null,8352,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSURiMm9HQ1pnEAE!2m1!1s0x0:0x4382d31ca9fe1bd0!3m1!1s2@1:CIHM0ogKEICAgIDb2oGCZg%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSURiMm9HQ1pnEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSURiMm9HQ1pnEi0KF0NJSE0wb2dLRUlDQWdJRGIyb0dDNWdFEhJDZ3NJLV9xOXRRWVE4SUM3S1EaLAoWQ0lITTBvZ0tFSUNBZ0lEYjJvR0NGZxISQ2dzSS1fcTl0UVlROElDN0tRIhIJAAAAAAAAAAAR0Bv-qRzTgkMqCzBhZ1dVUVB0VjBj\u002