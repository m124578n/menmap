,null,null,null,"餐點",null,"0ahUKEwjfyrTL9dmWAxUjb_UHHZ22F0UQ3IcHCOEBKAk",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjfyrTL9dmWAxUjb_UHHZ22F0UQ3IcHCOIBKAo",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjfyrTL9dmWAxUjb_UHHZ22F0UQ3IcHCOMBKAs",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["相當濃郁的蒜味豚骨湯頭，喝湯吃得到許多蒜末，愛吃重口味的饕客應該會喜歡。不過個人覺得副食才是花月嵐厲害的，鮮蝦餃子很飽滿，咬下去還有湯汁。另外炸豬排也不錯，豬肉的厚度挺有誠意，外皮酥脆也不會裹得太厚。蒜香飯也超乎預期的下飯，味道很夠不輸台灣的滷肉飯店家。個人比較喜歡濃郁豚骨，但不愛蒜味如此重的口味⋯下次要再來可能不是點拉麵。",null,[0,163]]]],[null,null,null,null,null,"https://business.google.com/local/business/5695379790624833989/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZNYWtrMVMweHlNbG8zTFRGQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/5695379790624833989/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZNYWtrMVMweHlNbG8zTFRGQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/5695379790624833989/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZNYWtrMVMweHlNbG8zTFRGQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/5695379790624833989/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZNYWtrMVMweHlNbG8zTFRGQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/5695379790624833989/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZNYWtrMVMweHlNbG8zTFRGQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/5695379790624833989/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZNYWtrMVMweHlNbG8zTFRGQlJSQUIQAA%3D%3D"]],[null,null,3933,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VMakk1S0xyMlo3LTFBRRAB!2m1!1s0x0:0x2d4acd848b7a170c!3m1!1s2@1:CIHM0ogKELjI5KLr2Z7-1AE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VMakk1S0xyMlo3LTFBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VMakk1S0xyMlo3LTFBRRIuChdDSUhNMG9nS0VMTHVfX0hLb2JxejFnRRITQ2