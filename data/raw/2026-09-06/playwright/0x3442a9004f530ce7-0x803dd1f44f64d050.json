[7,3]],null,null,[2025,6,7,9,null,null,null,null,["1 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhAEbzo8rI4EHLXKjMH626ye\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x803dd1f44f64d050"]],1,null,null,null,null,null,null,["0","-9205971216041193392"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25jemNIZEdOR3BsYVhCQ2IwSmxiVXhTUlRGd2NGRRAB"]],"CIABIhAEbzo8rI4EHLXKjMH626ye",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["【雞白湯拉麵 $260】\n這碗雞白湯拉麵的湯頭屬於濃郁系，喝起來滑順香濃卻不會過於死鹹，最棒的是完全沒有惱人的雞腥味，讓人一口接一口停不下來。麵條是比較粗一點的，Q彈有嚼勁，和濃郁湯頭搭配得恰到好處！\n\n肉的部分也很用心，給了四片舒肥雞＋兩片雞腿叉燒，肉質都嫩嫩的，吃起來完全不乾柴。舒肥雞很清爽，雞腿叉燒則帶點炙燒香氣，整碗吃完蠻有飽足感的🙂\u200d↕️\n\n【柚子清湯拉麵 $230】\n這碗柚子清湯的湯頭很清爽，柚子的香氣蠻明顯的，喝起來有點像在吃日式柚子鹽拉麵那種感覺～不過尾韻會帶出一股蔥味，而且還蠻重的，如果本身不太愛蔥味的人可能要考慮一下🤔\n\n麵條比雞白湯的還細，滑順但少了點咬勁，個人比較偏愛雞白湯的麵體口感。不過如果你是喜歡清爽派，這碗應該會很對味( ⸝⸝⸝˃֊˂)\n\n【炸雞 $100】\n他們家的炸雞還不錯！外皮炸得酥酥脆脆的，咬下去肉還很多汁，完全不乾柴，而且本身就有調味，不沾醬也很好吃。一份大概有 5～6 塊，份量剛剛好，當作配拉麵的小點很加分( ˘ᵕ˘ )♡♡\n\n━━━━━ ᴛʜᴏᴜɢʜᴛs ━━━━\n\n這次吃下來覺得整體還不錯，不管是湯頭、麵條還是配料都能感受到店家的用心。雞白湯濃郁順口、肉嫩湯香，是我這次最喜歡的！柚子清湯走的是清爽派，柚香＋蔥味滿明顯的，推薦給喜歡清爽系拉麵的朋友( * ॑꒳ ॑*)\n\n環境部分我也蠻喜歡的，店內乾淨明亮，雖然座位不多，但氛圍還蠻舒適的。水是加了檸檬片的冰開水，吃完濃湯或炸物喝一口很解膩，這小細節有加分到！整體來說是一間會還不錯的拉麵店，喜歡吃拉麵的人可以來試試～🍜✨\n\n🔍Instagram: belle_ame_bouffe",null,[0,100]]]],[null,null,null,null,null,"https://business.google.com/local/business/11884214279400090410/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVqZW1OSVpFZE9SM0JzWVZoQ1EySXdTbXhpVlhoVFVsUkdkMk5HUlJBQhAA",[null,null,null,"/local/business/11884214279400090410/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVqZW1OSVpFZE9SM0JzWVZoQ1EySXdTbXhpVlhoVFVsUkdkMk5HUlJBQhAA"],"https://business.google.com/local/business/11884214279400090410/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVqZW1OSVpFZE9SM0JzWVZoQ1EySXdTbXhpVlhoVFVsUkdkMk5HUlJBQhAA",[null,null,null,"/local/business/11884214279400090410/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUl