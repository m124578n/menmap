,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjR9_qw9tmWAxUPj68BHeVLDzoQ3YcHCLABKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjR9_qw9tmWAxUPj68BHeVLDzoQ3IcHCK8BKAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjR9_qw9tmWAxUPj68BHeVLDzoQ3YcHCLIBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjR9_qw9tmWAxUPj68BHeVLDzoQ3IcHCLEBKA0",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjR9_qw9tmWAxUPj68BHeVLDzoQ3IcHCLMBKA4",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjR9_qw9tmWAxUPj68BHeVLDzoQ3IcHCLQBKA8",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjR9_qw9tmWAxUPj68BHeVLDzoQ3IcHCLUBKBA",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["👉雞白湯：湯頭比較濃郁，但喝到一半，湯越喝越沙沙的，湯帶點顆粒狀的感覺，喝到後面也會膩，麵條有說要軟，但煮出來的麵條還是很硬，吃的很辛苦\n\n👉柚子清湯：個人覺得湯頭比雞白湯清爽好喝許多，朋友後來有續半碗麵，半碗麵份量滿多的～\n👉炸雞：(活動給的)，很油的炸雞\n\n晚餐內用滿座，\n在外等候，\n店員有稍微介紹了菜單以及活動，\n\n內用用餐時，\n因朋友想吃叉燒飯就好，\n所以想點叉燒飯和一碗拉麵，\n結果被告知低消一人一碗拉麵，\n店員先前沒告知，菜單上也沒有說明低消，\n後續內用的客人也是發生這樣的事情，\n建議店家可以在菜單上說明和告知！ 🧐",null,[0,112]]]],[null,1744200977000000,1744202858000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQkY1THNTMGVXQnRuOW1VUkFBYzVldw%7CCAEQrcz1_gkiLwoZQ0hfQkY1THNTMGVXQnRuOW1VUkFBYzVldxoSQ2dzSTZ0alp2d1lRMDVmcFh3\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjR9_qw9tmWAxUPj68BHeVLDzoQ_2MItgEoEQ"],"https://business.google.com/local/business/11884214279400090410/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUlJlVGR5WW5WblJSQUIQAA%3D%3D",[null,null,null,"/local/business/11884214279400090410/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUlJlVGR5WW5WblJSQUIQAA%3D%3D"],"https://business.google.com/local/busines