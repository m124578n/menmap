果可以淡一點把味道稍微還給叉燒本身會更優秀。",null,[0,256]]]],[null,null,null,null,null,"https://business.google.com/local/business/10584014678872789672/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTm1FeWNHbFpWM0JNWlVVeFZscHJhRXhUUjJoeVpHcFZkRkl6WXhBQhAA",[null,null,null,"/local/business/10584014678872789672/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTm1FeWNHbFpWM0JNWlVVeFZscHJhRXhUUjJoeVpHcFZkRkl6WXhBQhAA"],"https://business.google.com/local/business/10584014678872789672/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTm1FeWNHbFpWM0JNWlVVeFZscHJhRXhUUjJoeVpHcFZkRkl6WXhBQhAA",[null,null,null,"/local/business/10584014678872789672/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTm1FeWNHbFpWM0JNWlVVeFZscHJhRXhUUjJoeVpHcFZkRkl6WXhBQhAA"],null,"https://business.google.com/local/business/10584014678872789672/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTm1FeWNHbFpWM0JNWlVVeFZscHJhRXhUUjJoeVpHcFZkRkl6WXhBQhAA",[null,null,null,"/local/business/10584014678872789672/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTm1FeWNHbFpWM0JNWlVVeFZscHJhRXhUUjJoeVpHcFZkRkl6WXhBQhAA"]],[null,null,3128,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xKNmEycGlZV3BMZUUxVlpraExTR2hyZGpVdFIzYxAB!2m1!1s0x0:0xa07f719df2f937b9!3m1!1s2@1:CAIQACodChtycF9oOlJ6a2piYWpLeE1VZkhLSGhrdjUtR3c%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xKNmEycGlZV3BMZUUxVlpraExTR2hyZGpVdFIzYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xKNmEycGlZV3BMZUUxVlpraExTR2hyZGpVdFIzYxI-Ci9DQUlRQUNvZENodHljRjlvT2xKNmEycGlZV3BMZUUxVlpraExTR2hyZGpVdFIzYxILMGR2Mm9sVEtwZU4aPgovQ0FJUUFDb2RDaHR5Y0Y5b09sSjZhMnBpWVdwTGVFMVZaa2hMU0docmRqVXRSM2MSCzBkdjJvbFRLcGVOIhIJAAAAAAAAAAARuTf58p1xf6AqCzBkdjJvbFRLcGVO\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi_0MST-NmWAxXLkmoFH