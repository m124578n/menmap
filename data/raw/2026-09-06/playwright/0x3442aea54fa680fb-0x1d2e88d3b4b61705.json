意嘗試。",null,[0,138]]]],[null,null,null,null,null,"https://business.google.com/local/business/6762372654130041113/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZVZreU9WaE5WVm95VFVWb2VWWklhRnBQU0hCWFRUTldlbGRWUlJBQhAA",[null,null,null,"/local/business/6762372654130041113/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZVZreU9WaE5WVm95VFVWb2VWWklhRnBQU0hCWFRUTldlbGRWUlJBQhAA"],"https://business.google.com/local/business/6762372654130041113/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZVZreU9WaE5WVm95VFVWb2VWWklhRnBQU0hCWFRUTldlbGRWUlJBQhAA",[null,null,null,"/local/business/6762372654130041113/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZVZreU9WaE5WVm95VFVWb2VWWklhRnBQU0hCWFRUTldlbGRWUlJBQhAA"],null,"https://business.google.com/local/business/6762372654130041113/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZVZreU9WaE5WVm95VFVWb2VWWklhRnBQU0hCWFRUTldlbGRWUlJBQhAA",[null,null,null,"/local/business/6762372654130041113/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZVZreU9WaE5WVm95VFVWb2VWWklhRnBQU0hCWFRUTldlbGRWUlJBQhAA"]],[null,null,3059,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xweVkyOVhNVVoyTUVoeVZIaFpPSHBXTTNWeldVRRAB!2m1!1s0x0:0x1d2e88d3b4b61705!3m1!1s2@1:CAIQACodChtycF9oOlpyY29XMUZ2MEhyVHhZOHpWM3VzWUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xweVkyOVhNVVoyTUVoeVZIaFpPSHBXTTNWeldVRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xweVkyOVhNVVoyTUVoeVZIaFpPSHBXTTNWeldVRRI-Ci9DQUlRQUNvZENodHljRjlvT2xweVkyOVhNVVoyTUVoeVZIaFpPSHBXTTNWeldVRRILMGR5U29RRF9NeW0aPgovQ0FJUUFDb2RDaHR5Y0Y5b09scHlZMjlYTVVaMk1FaHlWSGhaT0hwV00zVnpXVUUSCzBkeVNvUURfTXltIhIJAAAAAAAAAAARBRe2tNOILh0qCzBkeVNvUURfTXlt\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjL3dXJ99mWAxXFoK8BHVQUFmgQoykIwgEoCw"],null