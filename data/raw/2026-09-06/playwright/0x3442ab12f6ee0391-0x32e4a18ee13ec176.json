_REQUIRED"],"不需要訂位",2,null,null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3YcHCIgBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3IcHCIcBKBA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3YcHCIoBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3YcHCIsBKAE"]]],null,"用餐人數",null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3IcHCIkBKBE",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["用餐空間舒適且有質感，座位有吧台區、四桌雙人桌、一桌四人桌和一張多人共用的大桌，採用機器點餐（店員有空時會來協助），可現金/linepay，有飲用水自取，第一次來手機集點送烏龍茶。\n**午間套餐：鯛擔湯麵+溏心蛋+鯛魚炊飯390元。\n鯛擔湯麵—麵體Q彈，湯底濃郁帶芝麻香，很鹹，加了辣油帶麻香，不配水真的會被膩到和鹹死😅鯛魚天婦羅軟嫩，有淡淡淡水魚腥味，豚叉燒則軟嫩透紅好吃，內附生菜可解膩。\n鯛魚炊飯—看起來小碗平凡，但飯有濃濃的魚鮮味，飯的口感很好，個人很喜歡。",null,[0,116]]]],[null,null,null,null,null,"https://business.google.com/local/business/12875841807872572412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwYUZGclduRk9SWGh5VGtSV2RHRXlXakJUVjFwVFpGZHdWMWd6WXhBQhAA",[null,null,null,"/local/business/12875841807872572412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwYUZGclduRk9SWGh5VGtSV2RHRXlXakJUVjFwVFpGZHdWMWd6WXhBQhAA"],"https://business.google.com/local/business/12875841807872572412/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwYUZGclduRk9SWGh5VGtSV2RHRXlXakJUVjFwVFpGZHdWMWd6WXhBQhAA",[null,null,null,"/local/business/12875841807872572412/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwYUZGclduRk9SWGh5VGtSV2RHRXlXakJUVjFwVFpGZHdWMWd6WXhBQhAA"],null,"https://business.google.com/local/business/12875841807872572412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwYUZGclduRk9SWGh5VGtSV2RHRXlXakJUVjFwVFpGZHdWMWd6WXhBQhAA",[null,null,null,"/local/business/12875841807872572412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwYUZGclduRk9SWGh5VGtSV2RHRXlXakJUVjFwVFpGZHdWMWd