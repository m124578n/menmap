xVDj68BHQxAHaMQ3IcHCKQBKAU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3IcHCKUBKAY",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["真的是法式料理耶 只是做成像拉麵的樣子\n擺盤很漂亮 這次點鮭魚拉麵$340\n湯像是鮭魚奶油湯 湯有鮭魚香很特別\n麵條偏軟但有Q 吸附湯汁 吃起來像義大利麵\n很喜歡配料的炸馬鈴薯絲 直接吃酥酥的增加口感，泡到湯裡吸湯汁 更好吃\n肉類有炸鮭魚、薄切叉燒 也都好吃\n不喜歡的是加點的溏心蛋$40跟起司可樂餅$120，溏心蛋像是一般水煮蛋，起司可樂餅有迷迭香不太習慣 味道偏酸，旁邊有酸甜百香果奶油醬 沾起來比較好吃。\n環境算大，但桌子偏小 桌子距離過近偏擠，桌子很輕會搖晃 怕手一用力桌子就翻了\n外場服務生是外籍 滿親切的\n雖然價位偏高，但整體是會想再回訪吃其他口味，還有鯛魚、蝦、牡蠣的口味",null,[0,55]]]],[null,null,null,null,null,"https://business.google.com/local/business/12875841807872572412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLVVdFd1JsWmxiRUp3WVZack5WcHVUbnBqV0dONFYxUldWMUV6WXhBQhAA",[null,null,null,"/local/business/12875841807872572412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLVVdFd1JsWmxiRUp3WVZack5WcHVUbnBqV0dONFYxUldWMUV6WXhBQhAA"],"https://business.google.com/local/business/12875841807872572412/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLVVdFd1JsWmxiRUp3WVZack5WcHVUbnBqV0dONFYxUldWMUV6WXhBQhAA",[null,null,null,"/local/business/12875841807872572412/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLVVdFd1JsWmxiRUp3WVZack5WcHVUbnBqV0dONFYxUldWMUV6WXhBQhAA"],null,"https://business.google.com/local/business/12875841807872572412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLVVdFd1JsWmxiRUp3WVZack5WcHVUbnBqV0dONFYxUldWMUV6WXhBQhAA",[null,null,null,"/local/business/12875841807872572412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLVVdFd1JsWmxiRUp3WVZack5WcHVUbnBqV0dONFYxUldWMUV6WXhBQhAA"]],[null,null,2088,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tKUWEwRlZlbEJwYVZrNVpuTnpjWGN4V1RWV1EzYxAB!2m1!1s0x0:0x32e4a18ee13ec176!3m1!1s2@1:CAIQACodChtycF9oOkJQa0FVelBpaVk5ZnNzcXcxWTVWQ3c%7C