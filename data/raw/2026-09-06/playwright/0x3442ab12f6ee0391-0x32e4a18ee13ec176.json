Hq9f19dmWAxVDj68BHQxAHaMQ3YcHCIICKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3IcHCIECKBg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3IcHCIMCKBk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3IcHCIQCKBo",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3IcHCIUCKBs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11wj9tx_kn"],"鯛担麵",2,null,null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3YcHCIcCKAA"],[["M:/g/11ybzl5s41"],"鯛担湯麵",2,null,null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3YcHCIgCKAE"]],[1]],null,"建議的餐點",null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3IcHCIYCKBw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3YcHCIoCKAA"]]],null,"用餐人數",null,"0ahUKEwiHq9f19dmWAxVDj68BHQxAHaMQ3IcHCIkCKB0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["大阪人氣拉麵的台灣首店，2024年開幕，平日中午來蠻多位置的，主打以法餐手法呈現創新版的日式擔擔麵，還有200元內的外帶便當可選擇。\n這個鯛湯頭的風格，個人聯想到米其林主廚Craig Yang經營的SOMMÉ餐酒館的拉麵，SOMMÉ是以法式澄清湯製作拉麵，抱きしめ鯛則是以法式手法熬煮鯛魚濃湯並製作擔擔麵，有異曲同工之妙。\n這次點招牌的「鯛担湯麵」(320元)，湯頭選用高級真鯛熬製10小時，再加入魚殼、芝麻油等，確實厲害，入口濃郁滑順，介於拉麵和沾麵間的濃稠度，帶奶油香氣又不失清爽，不僅嘗得到鯛魚的鮮美，還帶點微微的煙燻山椒和花椒味，尤其山椒的加入更是畫龍點睛，層次感十足，好喝！但如果對這種偏奶味的湯頭沒愛的話，可能就比較不適合你。\n細麵條採用三河屋中捲麵，相當Q彈有勁不過軟，是我喜歡的口感；裡面叉燒和肉燥都很不錯，另外那個炸鯛魚真的是入口即化有夠好吃～\n另外推薦加點鯛魚炊飯(70元)，可以加到拉麵的湯頭裡，建議不需要加麵就改點這個飯就好，炊飯吸飽了湯汁，出乎意料的美味！",null,[0,161]]]],[null,null,null,null,null,"https://business.google.com/local/business/12875841807872572412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZUZwVVduVlhWVlYzWkVkNFRWUlZlRUpsU0d4WFUxZE9SbVJ0WXhBQhAA",[null,null,null,"/local/business/12875841807872572412/customers/reviews/r