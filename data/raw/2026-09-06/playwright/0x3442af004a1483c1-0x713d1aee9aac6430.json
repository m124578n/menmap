_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwiWz9P199mWAxX7ulYBHT2qIHQQ3YcHCOIBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiWz9P199mWAxX7ulYBHT2qIHQQ3IcHCOEBKBI",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwiWz9P199mWAxX7ulYBHT2qIHQQ3YcHCOQBKAA"]]],null,"座位類型",null,"0ahUKEwiWz9P199mWAxX7ulYBHT2qIHQQ3IcHCOMBKBM",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["·（中）辣（中）麻+香菜真的好搭配！可惜當天不能點整份的\n\n應該五訪（以上）了，有多一位助手\n·特製辣麻味噌沾麵，並加點了炒豆芽。\n麵的份量真的暴力！除了份量大，口感冰涼外，沾湯掛麵吃，爽度upup，咀嚼起來不會因冰鎮而生硬，反倒是恰到好處彈牙，又多了一點硬度。\n沾汁剛開始沾著麵吃時，還不會感覺辣度及麻，吃到後來，那個感覺就上來了！超爽的！\n角煮一樣軟爛，而且甜口。只不過這次炒豆芽雖然脆度很好，但卻有點鹹…\n\n沾汁可以加熱，真的感動。加麵份量也是暴力，下次應該說加麵的量只要三口就好😂\n\n候位時間我自己是再加上等餐時間，營業時間一到，我是第五個客人，輪到我點餐+入座等餐，差不多就快要半小時。前面幾組都是點沾麵，老闆是四組一齊出餐的，我則在下一輪的。",null,[0,46]]]],[null,1766904583000000,1766904583000000,"8 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfYUJYOXVkN1UwbWNfM3pROVBvUE9hQQ%7CCAEQrcz1_gkiMAoZQ0hfYUJYOXVkN1UwbWNfM3pROVBvUE9hQRoTQ2d3SWg2YkR5Z1lRMTU3ZnFRSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiWz9P199mWAxX7ulYBHT2qIHQQ_2MI5QEoFA"],"https://business.google.com/local/business/12710694276992505568/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGTVdWVlNYbFZTR3hyVGxoR1YxZEdjR3hpTW1SSlpHMUtjR0pWUlJBQhAA",[null,null,null,"/local/business/12710694276992505568/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGTVdWVlNYbFZTR3hyVGxoR1YxZEdjR3hpTW1SSlpHMUtjR0pWUlJBQhAA"],"https://business.google.com/local/business/12710694276992505568/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGTVdWVlNYbFZTR3hyVGxoR1YxZEdjR3hpTW1SSlpHMUtjR0pWUlJBQhAA",[null,null,null,"/local/business/12710694276992505568/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFGTVdWVlNYbFZTR3hyVGxoR1YxZEdjR3hpTW1SSlpHMUtjR0pWUlJBQhAA"],null,"https://