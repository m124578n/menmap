_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjHlqmu99mWAxV0K0QIHWbNF2sQ3YcHCNUBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjHlqmu99mWAxV0K0QIHWbNF2sQ3IcHCNQBKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjHlqmu99mWAxV0K0QIHWbNF2sQ3YcHCNcBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjHlqmu99mWAxV0K0QIHWbNF2sQ3IcHCNYBKAY",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjHlqmu99mWAxV0K0QIHWbNF2sQ3IcHCNgBKAc",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjHlqmu99mWAxV0K0QIHWbNF2sQ3IcHCNkBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjHlqmu99mWAxV0K0QIHWbNF2sQ3IcHCNoBKAk",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["先說～吃的是情懷！十多年前高中時放學後會順路吃的簡單台式拉麵，能一直營業到現在想必有其獨到秘訣吧；今天正好路經後站，買完附近波霸珍奶想說來吃個小屁吧！看起來好像只能現金支付，菜單是黑白印製的蠻古早味，入座後由胖胖阿姨遞交菜單，門口就有了但我沒注意先取；點了雪花牛豚骨拉麵，蠻快就上菜了！稱不上是多厲害的美食，雪花牛肉散散的，且因為是台式所以配料是豆芽菜和滷蛋，但份量確實能填飽肚子，湯頭嚐起來也和之前記憶中的差不多；客人可帶外食但要把垃圾帶走，店裡座位蠻多，座位還有掛勾可置放個人物品很貼心，同時播放許多日劇插曲，個人是蠻喜歡；印象深刻的是還看到5/1因為原物料成本提高即將漲價的告示，體認到長久經營的困境；除了味道不變之外，價格卻持續變高，以如此價位能都能吃到日本拉麵了，說真的以前吸引人的點最大就是售價低廉高CP值，才這麼多學生喜歡，希望店家能突破困境，懷念的味道必須在地繼續存在🙏",null,[0,240]]]],[null,null,null,null,null,"https://business.google.com/local/business/5129299439050785876/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUnZNV1p4UkdKUkVBRRAA",[null,null,null,"/local/business/5129299439050785876/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUnZNV1p4UkdKUkVBRRAA"],"https://business.google.com/local/business/5129299439050785876/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUnZNV1p4UkdKUkVBRRAA",[null,null,null,"/local/business/5129299439050785876/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUnZNV1p4UkdKUkVBRRAA"],null,"https://business