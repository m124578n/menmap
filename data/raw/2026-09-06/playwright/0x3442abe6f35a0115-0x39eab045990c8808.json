003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpNMUJEZW01QlJSQUIQAA%3D%3D",[null,null,null,"/local/business/10716982866968995871/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpNMUJEZW01QlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/10716982866968995871/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpNMUJEZW01QlJSQUIQAA%3D%3D",[null,null,null,"/local/business/10716982866968995871/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpNMUJEZW01QlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/10716982866968995871/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpNMUJEZW01QlJSQUIQAA%3D%3D",[null,null,null,"/local/business/10716982866968995871/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpNMUJEZW01QlJSQUIQAA%3D%3D"]],[null,null,2345,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURJM1BDem5BRRAB!2m1!1s0x0:0x39eab045990c8808!3m1!1s2@1:CIHM0ogKEICAgIDI3PCznAE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURJM1BDem5BRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURJM1BDem5BRRItChZDSUhNMG9nS0VJQ0FnSURJM1BDelhBEhNDZ3dJeXVPQ3JBWVFrTnJncndFGi4KF0NJSE0wb2dLRUlDQWdJREkzUEN6M0FFEhNDZ3dJeXVPQ3JBWVFrTnJncndFIhIJAAAAAAAAAAARCIgMmUWw6jkqCzBkRnBOUGF4OFpW\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjl9OfN9dmWAxXogK8BHSmuA2oQoykIvwEoEg"],null,[null,[[1,0]]]],"0ahUKEwjyq-7N9dmWAxVRxhYFHaMiM9kQ0pMFCFUoBg"],null,null,null,"0ahUKEwjl9OfN9dmWAxXogK8BHSmuA2oQ0pMFCJsBKAY"],[["ChZDSUhNMG9nS0VJQ0FnSUNYNF9xS1F3EAE",["0x0:0x39eab045990c8808",null,1729394426878023,1729394695964892,[null,null,["https://www.google.com/maps/contrib/113328690673854531809/reviews?hl\u003dzh-TW"],null,null,["芯宸","https://lh3.googleusercontent.com/a-/ALV-UjUbq4Fh_NKEQPC6qZ6QrMiZw5QOPwTMuavvKD3EjzUz7Fpgukvbaw\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/113328