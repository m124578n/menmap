s Yang"],"https://www.google.com/maps/contrib/112172226177637065507?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVn4wUNCuUzGGWMyTRG-6UcZkvHfD7hI6RupGYwKyh5vHGl3Si1\u003ds120-c-rp-mo-ba12-br100",null,null,"112172226177637065507"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,3,3,11,null,null,null,null,["6 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhCdfV9cfquoVJlMBGrmTAox\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x8f1a9dc051283158"]],1,null,null,null,null,null,null,["0","-8135016327570509480"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xGeVdIWTBibGR4TFhRd1ExQkJNRXd6Tm5acVdFRRAB"]],"CIABIhCdfV9cfquoVJlMBGrmTAox",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiA2fOE-NmWAxVogK8BHSKBBYMQ3YcHCH8oAA"]],1],null,null,"餐點類型",null,"0ahUKEwiA2fOE-NmWAxVogK8BHSKBBYMQ3IcHCH4oDQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwiA2fOE-NmWAxVogK8BHSKBBYMQ3YcHCIEBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiA2fOE-NmWAxVogK8BHSKBBYMQ3IcHCIABKA4",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiA2fOE-NmWAxVogK8BHSKBBYMQ3IcHCIIBKA8",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiA2fOE-NmWAxVogK8BHSKBBYMQ3IcHCIMBKBA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiA2fOE-NmWAxVogK8BHSKBBYMQ3IcHCIQBKBE",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["★拉麵迷請進→FB搜尋：『台灣拉麵愛好會』、IG：twramenclub\n\n▎區域／鄰近地點：台北市／捷運西湖站\n▎拉麵名稱／價格：味噌一般（天龍麵）+咖哩一般（細麵）／180\n▎配置：交給老闆處理\n\n★可以LINEPAY\n\n豚小屋西湖店，位於10號的位置又延續了西湖市場內有好吃的拉麵！\n\n豚小屋的店主，最早師承「一番星」時期的「真龍食堂」就有推出100元超划算的豚骨拉麵，當時我社團曝光分享後，是不少麵友月底的救星。\n\n後續店主離開拉麵一陣子，再回歸之後加入「豚人」體系，後續獨立開業「豚人拉麵板橋真龍店」另外再創立新品牌「豚小屋」在新北新莊輔大開業，後續兩邊都因為選址問題結束，現在回到店主最早待過的一番星所在地西湖市場再開，繞了一圈又回到起點。\n\n那天還有一個讓我意外感動的事情，外場的店員居然是真龍時期的組合，真的有種回到過去的錯覺，也很開心馬上被認出來。\n\n那天因為這個主題第一個想到的就是豚小屋，因為基本款的鹽味、醬油只要150，對比上周吃的小高系統135、145，我自己會選擇豚小屋，因為對拉麵的湯麵配料搭配都是比較在意，另外就是麵體目前有兩種選擇且可以客製化，我點完餐後就跟店主口味說幫我處理。\n\n豚小屋可以linepay，然後需自行取餐和回收餐具，一般版本外，有加價、加量的選擇，但是我自己想吃兩種口味，所以就選一般的款式。\n\n那天剛好店主弄出新口味限定，因為豚人系統我吃過鹽味和醬油過了，所以就直接點兩款近期有小調整的口味，會貴了一點，但是我吃完的滿\n\n足感，我覺得還是無敵！\n\n▎味噌一般（天龍麵）+咖哩一般（細麵）：\n\n味噌跟豚骨搭配的很好，味噌特有的風味有但是不過，且順口會一直想喝，湯冷掉後味噌發酵的味道就會明顯。\n\n咖哩很棒，是微辛香的那種，很好吃且會滿足，有飯的話可以再泡飯吃完應該會更滿足。而且湯底會撈到切塊的類似越南火腿的食材(口感感受應該不是豆腐)，也是一個亮點。\n\n最便宜的版本有叉燒的邊角比較不圓的叉燒，但是口感不打折好吃也軟嫩，還有加上半顆溏心蛋、去尾豆芽菜和蔥，我自己覺得比小高還滿意\n\n太多太多，可能我食量還好，如果考量到要吃飽的人可能會需要花費加麵的費用。\n\n月底沒辦法花太多錢，但是又想吃到一碗味道滿意的拉麵，豚小屋絕對是好選擇！",null,[0,56]]]],[null,null,null,null,null,"https://business.google.com/local/business/2208548511602298144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZVZkSVdUQmliR1I0VEZoUmQxRXhRa0pOUlhkNlRtNWFjVmRGUlJBQhAA",[null,null,null,"/local/business/2208548511602298144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZVZkSVdUQmliR1I0VEZoUmQxRXhRa0pOUlhkNlRtNWFjVmRGUlJBQhAA"],"https://business.google.com/local/business/2208548511602298144/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZVZkSVdUQmliR1I0VEZoUmQxRXhRa0pOUlhkNlRtNWFjVmRGUlJBQhAA",[null,null,null,"/local/business/2208548511602298144/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZVZkSVdUQmliR1I0VEZoUmQxRXhRa0pOUlhkNlRtNWFjVmRGUlJBQhAA"],null,"https://business.google.com/local/business/2208548511602298144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZVZkSVdUQmliR1I0VEZoUmQxRXhRa0pOUlhkNlRtNWFjVmRGUlJBQhAA",[null,null,null,"/local/business/2208548511602298144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZVZkSVdUQmliR1I0VEZoUmQxRXhRa0pOUlhkNlRtNWFjVmRGUlJBQhAA"]],[null,null,5245,["https://www.google.com/maps/rev