A"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiV_v699dmWAxXKffUHHa0OB_AQ3IcHCLABKA4",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiV_v699dmWAxXKffUHHa0OB_AQ3IcHCLIBKA8",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiV_v699dmWAxXKffUHHa0OB_AQ3IcHCLMBKBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiV_v699dmWAxXKffUHHa0OB_AQ3IcHCLQBKBE",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["小小間但卻不擁擠的店面，座位下都有小籃子可以放置包包\n初訪是8/21，二訪10/2，老闆娘忙裡忙外，但親切不怠慢，一有客人推門就會馬上出來接待\n\n札幌辛味噌拉麵$240\n拉麵價格中等，但個人覺得CP值很高，叉燒厚、嫩，湯頭香氣十足，麵體Q彈算是偏微微硬，推薦吃辣的都可以點這款辛味噌，有稍微調整成台式口味，是真的有辣喔🌶️\n\n炸雞3個$60／5個$90\n不得不提的是這家的炸雞！真的很厲害！皮薄多汁，幾乎每桌必點（來兩次都發現大家桌上都有😂）大小跟口味都超有誠意，吃過會懷念的那種！\n\n感覺許多附近家庭客很常來，聽聊天內容都很熟了\n會繼續三訪！",null,[0,71]]]],[null,1696442259000000,1696442259000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04RElVUUV1VzVsSGFlVEFBbkZMUQ%7CCAEQrcz1_gkiMAoZQ0hfQm04RElVUUV1VzVsSGFlVEFBbkZMURoTQ2d3SWs4XzJxQVlRazk2b3NRSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiV_v699dmWAxXKffUHHa0OB_AQ_2MItQEoEg"],"https://business.google.com/local/business/8967756690972946939/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmFkMk5EWkRWUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/8967756690972946939/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmFkMk5EWkRWUlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/8967756690972946939/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmFkMk5EWkRWUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/8967756690972946939/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmFkMk5EWkRWUlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/8967756690972946939/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZK