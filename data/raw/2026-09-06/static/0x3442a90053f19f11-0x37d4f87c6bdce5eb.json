ll,"服務",null,"0ahUKEwjdoJKh_dmWAxXHIzQIHRSzGVQQ3IcHCDsoBg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjdoJKh_dmWAxXHIzQIHRSzGVQQ3IcHCDwoBw",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["2026.08\n泡系、細麵（硬）、日本鹹度\n\n好喝耶！湯頭濃郁，鴨肉不厚、但口感不錯，咀嚼起來蠻香的\n細麵硬度剛好\n\n這兩年默默吃了這附近很多家有名的拉麵店（公館～東門，六間以上，有名的定義是拉麵社團會有一篇以上推薦那種）\n\n只有源山幾乎沒看到什麼推薦的，今天意外路過想試試看\n但它居然是目前這區私心覺得最好吃的，好驚喜(≧▽≦)\n喝了朋友二郎系的湯（有背脂）一樣好喝\n\n2026.08\n隔一週再訪\n念念不忘再來試試其他口味\n辣味鴨濃湯、細麵（硬）、日本鹹度\n選了自組配菜，三份鴨肉超級幸福☺️\n不知道是不是錯覺，今天的肉更厚更嫩更好吃了！\n怕肉浸在湯裡面太久過熟，一拿到就把所有肉先堆在湯匙上，要吃的時候再一片一片拿起來配湯吃，又香又嫩\n\n（忍不住把湯喝完了）\n\n目前覺得湯最濃郁的第一名是泡系\n辣味和二郎也是濃的（不膩），但自己喜歡泡系那種膠質的口感",null,[0,21]]]],[null,null,null,null,null,"https://business.google.com/local/business/16917976989888429665/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYkZKRE1XRlBTR2hJWkdwT2RGVlZNVmRqYWxKVFVsTXdORlV5WXhBQhAA",[null,null,null,"/local/business/16917976989888429665/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYkZKRE1XRlBTR2hJWkdwT2RGVlZNVmRqYWxKVFVsTXdORlV5WXhBQhAA"],"https://business.google.com/local/business/16917976989888429665/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYkZKRE1XRlBTR2hJWkdwT2RGVlZNVmRqYWxKVFVsTXdORlV5WXhBQhAA",[null,null,null,"/local/business/16917976989888429665/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYkZKRE1XRlBTR2hJWkdwT2RGVlZNVmRqYWxKVFVsTXdORlV5WXhBQhAA"],null,"https://business.google.com/local/business/16917976989888429665/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYkZKRE1XRlBTR2hJWkdwT2RGVlZNVmRqYWxKVFVsTXdORlV5WXhBQhAA",[null,null,null,"/local/business/16917976989888429665/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYkZKRE1XRlBTR2hJWkdwT2RGVlZNVmRqYWxKVFVsTXdORlV5WXhBQhAA"]],[null,null,927,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21WbFJ