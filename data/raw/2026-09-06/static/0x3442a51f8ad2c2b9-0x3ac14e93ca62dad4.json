（吃好飽）",null,[0,90]]]],[null,null,null,null,null,"https://business.google.com/local/business/12976888674773215955/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVm1WWFRuQk5WbFYwVkZkd1lWWXdTa3BsUkU1VVRrUnJlRmt4UlJBQhAA",[null,null,null,"/local/business/12976888674773215955/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVm1WWFRuQk5WbFYwVkZkd1lWWXdTa3BsUkU1VVRrUnJlRmt4UlJBQhAA"],"https://business.google.com/local/business/12976888674773215955/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVm1WWFRuQk5WbFYwVkZkd1lWWXdTa3BsUkU1VVRrUnJlRmt4UlJBQhAA",[null,null,null,"/local/business/12976888674773215955/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVm1WWFRuQk5WbFYwVkZkd1lWWXdTa3BsUkU1VVRrUnJlRmt4UlJBQhAA"],null,"https://business.google.com/local/business/12976888674773215955/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVm1WWFRuQk5WbFYwVkZkd1lWWXdTa3BsUkU1VVRrUnJlRmt4UlJBQhAA",[null,null,null,"/local/business/12976888674773215955/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVm1WWFRuQk5WbFYwVkZkd1lWWXdTa3BsUkU1VVRrUnJlRmt4UlJBQhAA"]],[null,null,16833,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xGVmVXTnBNVlV0VFdwYVYwSkplRE5UTkRreFkxRRAB!2m1!1s0x0:0x3ac14e93ca62dad4!3m1!1s2@1:CAIQACodChtycF9oOlFVeWNpMVUtTWpaV0JJeDNTNDkxY1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xGVmVXTnBNVlV0VFdwYVYwSkplRE5UTkRreFkxRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xGVmVXTnBNVlV0VFdwYVYwSkplRE5UTkRreFkxRRI-Ci9DQUlRQUNvZENodHljRjlvT2xGVmVXTnBNVlV0VFdwYVYwSkplRE5UTkRreFkxRRILMGRhZHVTM3N1UDAaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sRlZlV05wTVZVdFRXcGFWMEpKZUROVE5Ea3hZMUUSCzBkYWR1UzNzdVAwIhIJAAAAAAAAAAAR1NpiypNOwToqCzBkYWR1UzNzdVAw\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwj2mcK1-NmWAxXQdPUHHXDQNyQQoykIigEoEw