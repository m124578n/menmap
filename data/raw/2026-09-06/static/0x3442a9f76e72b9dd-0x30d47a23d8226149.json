ription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-WNL3nlfXCYc/AAAAAAAAAAI/AAAAAAAAAAA/uDaqw4eRqZI/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市中正區水源里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"6714804748944074029","101075830574632354068"],null,[[[7,[["好呷拉麵 甜品吃到飽(公館) *呷：ㄒㄧㄚˊ"],["100臺北市中正區水源里汀州路三段124號"]]],[2,[["100臺北市中正區水源里汀州路三段124號好呷拉麵 甜品吃到飽(公館) *呷：ㄒㄧㄚˊ"]]],[1,[["100臺北市中正區水源里汀州路三段124號"]]],[4,[["臺北市中正區水源里"]]]],["公館","汀州路三段124號","汀州路三段124號","水源里","100","臺北市中正區","TW"],["0ahUKEwi-1b_f-tmWAxVga_UHHfj3DFQQqtMBCAkoBg",["7QQ32G7M+HF"],["2G7M+HF 水源里 臺北市中正區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,[null,[["0ahUKEwi-1b_f-tmWAxVga_UHHfj3DFQQ_rYGCA4oCg",["業主為女性的商家"],null,"https://gstatic.com/local/placeinfo/women_led_updated_ic_24dp.png","https://gstatic.com/local/placeinfo/women_led_updated_ic_24dp.png",null,null,null,null,null,null,1]],null,[[8,["0ahUKEwi-1b_f-tmWAxVga_UHHfj3DFQQ_rYGCA0oCQ",["業主為女性的商家"],null,"https://gstatic.com/local/placeinfo/women_led_updated_ic_24dp.png","https://gstatic.com/local/placeinfo/women_led_updated_ic_24dp.png",null,null,null,null,null,null,1]]]],null,null,null,null,null,null,[[["星期日",7,[2026,9,6],[["11:30–22:30",[[11,30],[22,30]]]],0,1]],[["星期日",7,[2026,9,6],[["11:30–22:30",[[11,30],[22,30]]]],0,1],0,1,null,["營業中 · 打烊時間：22:30",[[0,3,[null,[4281040703,4285388172]]]]],["營業中 · 打烊時間：22:30",[[0,3,[null,[4281040703,4285388172]]]]],null,[21,30],["營業時間",[[0,4,[null,[4281040703,4285388172]]]]]],7,null,null,null,1],null,1,null,null,null,"ChDmi4npurUg5Y-w5YyX5biCWhMiEeaLiem6tSDlj7DljJcg5biCkgEQcmFtZW5fcmVzdGF1cmFudJoBI0NoWkRTVWhOTUc5blMwVkpRMEZuU1VSMk5XSmhNMVZCRUFF4AEA-gEECAAQDw",null,null,null,null,1,null,null,null,null,null,null,null,nul