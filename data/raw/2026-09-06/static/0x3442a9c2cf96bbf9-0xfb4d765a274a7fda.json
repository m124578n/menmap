ll,null,null,"餐點",null,"0ahUKEwi0kcvH9dmWAxVQdvUHHbUPEmYQ3IcHCFwoBg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi0kcvH9dmWAxVQdvUHHbUPEmYQ3IcHCF0oBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi0kcvH9dmWAxVQdvUHHbUPEmYQ3IcHCF4oCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwi0kcvH9dmWAxVQdvUHHbUPEmYQ3YcHCGAoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwi0kcvH9dmWAxVQdvUHHbUPEmYQ3IcHCF8oCQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi0kcvH9dmWAxVQdvUHHbUPEmYQ3YcHCGIoAA"]],1],null,null,"等待時間",null,"0ahUKEwi0kcvH9dmWAxVQdvUHHbUPEmYQ3IcHCGEoCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["來華山看展時偶然發現了一家新的口袋名單\n《千雲》\n店家主打雞白湯拉麵以及柚子鹽味拉麵\n我們點了一份雙人套餐（2份拉麵+2小菜+2飲料）\n麵的部分吃的感想是麵條軟硬適中，裡面附的雞叉燒軟嫩不柴（搭配旁邊的大蒜辣椒超級讚）湯頭的部分覺得柚子鹽味很清爽，吃到後面不會覺得很膩👍👍\n小菜點了雞肉紫蘇餃子以及唐揚雞塊，口感會有點偏硬，但配上大蒜辣椒以後覺得可以接受\n打卡評論還送了我們蛋沙拉的小菜😋\n推薦大家來逛華山時可以來用餐，我們是大約11:30左右來的，那時候不需要排隊可以直接入座，店內環境整潔，有提供洗手間，是適合假日來用餐的好選擇～",null,[0,42]]]],[null,null,null,null,null,"https://business.google.com/local/business/17984583729565501971/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBWZW1GR1FtMWlVekZxV21wbmVHSkZaRmRVYmtKVlVtcE9hRmxzUlJBQhAA",[null,null,null,"/local/business/17984583729565501971/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBWZW1GR1FtMWlVekZxV21wbmVHSkZaRmRVYmtKVlVtcE9hRmxzUlJBQhAA"],"https://business.google.com/local/business/17984583729565501971/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBWZW1GR1FtMWlVekZxV21wbmVHSkZaRmRVYmtKVlVtcE9hRmxzUlJBQhAA",[null,null,null,"/local/business/17984583729565501971/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBWZW1GR1FtMWlVekZxV21wbmVHSkZaR