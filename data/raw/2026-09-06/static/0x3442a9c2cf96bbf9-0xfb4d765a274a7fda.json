,null,null,null,null,null,null,null,["zh-Hant"],[["🍜魚介沾醬雞白湯沾麵\n沾麵的品項有先來說會等比較久\n（但結果比一般的拉麵還早來，雖然也是等了15分鐘\n沾麵的麵體是粗麵，整個很有嚼勁很喜歡\n雞白湯的底，沾醬裡還有碎豬肉塊蠻不錯的\n搭配冰的豬肉片，放到最後吃都還很嫩很不錯\n最後有要一杯清湯加入來喝，整體蠻不錯的\n\n🍜招牌塩味雞湯拉麵\n是比較清爽的口味，有加入柚子皮來提升清爽感\n（但柚子皮吃起來會有點苦😆\n選了全配的招牌，有3片嫩切雞胸肉、3顆雞肉丸子、3片豬肉叉燒，還有點綴的2小切片蘿蔔🫜\n整體份量蠻足夠的，最後也是吃光光表達尊重\n\n🥣招待小菜：香蔥醬雞肉\nIG追蹤或是Googl評論可以贈送招待小菜\n店員很熱心的解釋是哪一道且說明份量\n簡單蔥醬調味的絲狀雞肉配上滿滿的蔥絲\n做為最前面開胃的小菜來說也蠻不錯的\n\n🥟雞肉紫蘇煎餃\n拉麵店還得配上一盤煎餃\n桌上也有足夠的碟子與特別的煎餃醬油\n肯定要來吃吃看的吧！\n餃子類有分成煎餃與炸餃、口味有豬肉與雞肉\n畢竟是雞白湯主題的拉麵店，加上紫蘇的搭配也很特別\n於是就嘗試看看雞肉煎餃\n紫蘇的部分本來擔心會太搶戲，結果很剛好的出現\n讓整體的煎餃口味多了一絲紫蘇特有的香氣，昇華了煎餃\n加上一點辣油與辣醬的煎餃專用醬油搭配著也很不錯👍\n\n整體的環境、餐點、服務人員的應對都很不錯\n假日傍晚5點來剛好還不用排隊，出來後看到大排長龍\n做為週末的收尾，很不錯，開心～",null,[0,50]]]],[null,null,null,null,null,"https://business.google.com/local/business/17984583729565501971/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTVkZORlVUQlpWa3AwV0RFNVNHSldjRlJXUld4MlV6Rk9abUpIWXhBQhAA",[null,null,null,"/local/business/17984583729565501971/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTVkZORlVUQlpWa3AwV0RFNVNHSldjRlJXUld4MlV6Rk9abUpIWXhBQhAA"],"https://business.google.com/local/business/17984583729565501971/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTVkZORlVUQlpWa3AwV0RFNVNHSldjRlJXUld4MlV6Rk9abUpIWXhBQhAA",[null,null,null,"/local/business/17984583729565501971/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTVkZORlVUQlpWa3AwV0RFNVNHSldjRlJXUld4MlV6Rk9abUpIWXhBQhAA"],null,"https://business.google.com/local/business/17984583729565501971/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTVkZORlVUQlpWa3AwV0RFNVNHSldjRlJXUld4MlV6Rk9abUpIWXhBQhAA",[null,null,null,"/local/business/17984583729565501971/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTVkZORlVUQlpWa3AwV0RFNVNHSldjRlJXUld4MlV6Rk9abUpIWXhBQhAA"]],[null,null,4047,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xSVFNFUTBZVkp0WDE5SGJWcFRWRWx2UzFO