shment_poi/has_wheelchair_accessible_entrance","無障礙入口",[1,[[1,"無障礙入口"]],[1,"無障礙入口","無障礙入口","提供無障礙入口"]],null,[4],0],["/geo/type/establishment_poi/has_wheelchair_accessible_parking","無障礙停車場",[1,[[1,"無障礙停車場"]],[1,"無障礙停車場","無障礙停車場","提供無障礙停車場"]],null,[4],0]]]]],null,null,null,null,null,null,null,null,null,"zh-TW",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["一階堂IKAIDO傳承日本拉麵職人的精神，究極拉麵之美味體驗。有別於其他職人拉麵，一階堂精挑細選台灣當地的新鮮梅花豬，將食材的鮮美與日本的傳統拉麵工藝完美結合。\n\n製作一階堂叉燒的過程長達18小時，經過繁複的層層工序，新鮮的梅花肉首先以高達250度的火候炙烤，透過梅納反應將多餘的油脂慢慢化開，同時鎖住豐富的肉汁，讓每一片叉燒都充滿濃郁香氣與多層次口感。炙烤後，叉燒進行第二道工序，需要在72度進行舒肥慢煮，這一過程不僅讓肉質內部更加柔嫩多汁，還能讓風味更豐富。\n\n我們堅持選用日本原裝特級濃口醬油與刺身醬油作為基底，細緻熬煮豬大骨與雞骨，再輔以昆布與小魚乾等乾貨，每一口湯與叉燒肉完美融合，提供低鈉卻濃郁的日式拉麵口感。\n\n一階堂IKAIDO希望傳達日本傳統拉麵技藝與台灣在地食材的完美結合，從博多細麵到筍乾皆出自我們獨家研發製作，貫穿我們日本拉麵職人的精神，究極拉麵的熱愛。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-XzmG7hkroKQ/AAAAAAAAAAI/AAAAAAAAAAA/jisuD8d-2UM/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市內湖區湖元里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"1987814725024032176","115686442161432786985"],null,[[[7,[["一階堂拉麵 家樂福內湖店"],["114臺北市內湖區湖元里民善街88號"],["1樓"]]],[2,[["114臺北市內湖區湖元里民善街88號一階堂拉麵 家樂福內湖店1樓"]]],[1,[["114臺北市內湖區湖元里民善街88號1樓"]]],[4,[["臺北市內湖區湖元里"]]]],[null,"民善街88號1樓","民善街88號1樓","湖元里","114","臺北市內湖區","TW"],["0ahUKEwik6Ym9-dmWAxWana8BHQHIDf4QqtMBCAsoCA",["7QQ33H6F+3X"],["3H6F+3X 湖元里 臺北市內湖區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[["星期日",7,[2026,9,6],[["11:00–21:00",[[11],[21]]]],0,1]],[["星期日",7,[2026,9,6],[["11:00–21:0