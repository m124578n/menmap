AxU-pJUCHcAEJA0Q3YcHCGUoAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwi5i8GB-tmWAxU-pJUCHcAEJA0Q3YcHCGYoAQ"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwi5i8GB-tmWAxU-pJUCHcAEJA0Q3YcHCGcoAg"]]],null,"用餐人數",null,"0ahUKEwi5i8GB-tmWAxU-pJUCHcAEJA0Q3IcHCGQoCw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["一間非常用心的小店\n從裝潢擺設到餐點真的都是細節~\n我點的是檸柚胡椒白湯拉麵，還沒攪拌醬料前，就覺得湯頭很好喝了。攪拌之後整個香味層次蹦發，很驚艷！👏\n麵量比我想的多。\n炸蔬排也好好吃，不點會後悔。\n煎餃也不錯，但記得趁熱吃。\n沒有油煙問題（我們是第一組客人）。\n位子還可以接受，就是那種日式拉麵店吧台。\n只有現金支付，現場候位。",null,[0,75]]]],[null,null,null,null,null,"https://business.google.com/local/business/11674154883221533185/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVjJGcWFGQlRSekZvVGpOT2JrMVlXbTFWVmtweVltNWtVMWt6WXhBQhAA",[null,null,null,"/local/business/11674154883221533185/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVjJGcWFGQlRSekZvVGpOT2JrMVlXbTFWVmtweVltNWtVMWt6WXhBQhAA"],"https://business.google.com/local/business/11674154883221533185/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVjJGcWFGQlRSekZvVGpOT2JrMVlXbTFWVmtweVltNWtVMWt6WXhBQhAA",[null,null,null,"/local/business/11674154883221533185/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVjJGcWFGQlRSekZvVGpOT2JrMVlXbTFWVmtweVltNWtVMWt6WXhBQhAA"],null,"https://business.google.com/local/business/11674154883221533185/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVjJGcWFGQlRSekZvVGpOT2JrMVlXbTFWVmtweVltNWtVMWt6WXhBQhAA",[null,null,null,"/local/business/11674154883221533185/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVjJGcWFGQlRSekZvVGpOT2JrMVlXbTFWVmtweVltNWtVMWt6WXhBQhAA"]],[null,null,null,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21SV2FqaFBTRzFoTjNObk1YWm1VVkpyYm5kU1kzYxAB!2m1!1s0x0:0x3b5beb6fb929e62e!3m1!1s2@1:CAIQACodChtycF9oOmRWajhPSG1hN3NnMXZmUVJrbndSY3c%7C%7C?hl\u