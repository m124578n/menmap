",null,null,null,[[2]]],[["/m/019v4"],"珍珠奶茶",null,[null,null,null,null,83,0,86],null,"0ahUKEwjX9_Lf-NmWAxVLjK8BHeP9BGoQ1bMECM0BKCE",null,null,null,[[2]]],[["/m/07cmh2"],"糖水",null,[null,null,null,null,76,0,179],null,"0ahUKEwjX9_Lf-NmWAxVLjK8BHeP9BGoQ1bMECM4BKCI",null,null,null,[[2]]],[["/g/12208sjy"],"紅豆",null,[null,null,null,null,74,0,74],"Cg0KCy9nLzEyMjA4c2p5","0ahUKEwjX9_Lf-NmWAxVLjK8BHeP9BGoQ1bMECM8BKCM",null,null,null,[[2]]],[["/m/0j6703f"],"芋圓",null,[null,null,null,null,61,0,61],"CgwKCi9tLzBqNjcwM2Y\u003d","0ahUKEwjX9_Lf-NmWAxVLjK8BHeP9BGoQ1bMECNABKCQ",null,null,null,[[2]]],[["/m/01dctq"],"芋泥",null,[null,null,null,null,44,0,45],null,"0ahUKEwjX9_Lf-NmWAxVLjK8BHeP9BGoQ1bMECNEBKCU",null,null,null,[[2]]],[["/m/09vbsy"],"湯圓",null,[null,null,null,null,37,0,137],null,"0ahUKEwjX9_Lf-NmWAxVLjK8BHeP9BGoQ1bMECNIBKCY",null,null,null,[[2]]],[["/m/077_cx"],"燒仙草",null,[null,null,null,null,31,0,215],null,"0ahUKEwjX9_Lf-NmWAxVLjK8BHeP9BGoQ1bMECNMBKCc",null,null,null,[[2]]],[["/m/06hq_h"],"薏仁",null,[null,null,null,null,16,0,16],null,"0ahUKEwjX9_Lf-NmWAxVLjK8BHeP9BGoQ1bMECNQBKCg",null,null,null,[[2]]]]],[["🌟 湯頭全面提升\n全新雞骨豚骨湯底，融入老母雞與豬大骨的精華，經12小時慢火熬煮，湯色乳黃、濃郁綿厚，滿滿的膠原蛋白與極致鮮味，讓每一口都像在擁抱溫暖的幸福。\n\n🌟 叉燒香氣升級\n以日本職人工法製作的五花肉燒肉叉燒，搭配國產純釀醬油低溫熟成，炙燒的梅納反應更添濃郁香氣。每一片叉燒都鎖住鮮甜肉汁，入口即化，滿足每一位饕客的期待。\n\n🌟 麵條口感升級\n嚴選美澳黃金小麥，經九道揉壓工法製成的26番切細麵，硬中帶Q，完美吸附湯頭精華。每一口麵條，都是精工細作的體現。\n好呷豆花的三大堅持 |\n✅ 天然非基改大豆：手工鹽滷製作，不含石膏，口感細緻滑嫩。\n✅ 40年傳承秘糖水：嘉義糖廠老員工的獨門技法，選用純甘蔗熬煮，濃郁不膩。\n✅ 綿密配料：飽滿紅豆、古早味大麥、低糖綠豆，每一口都是回憶的味道。\n\n甜品起家的何家，保留古早味！ 愛吃甜品的朋友們，來好呷拉麵，記得留點胃給這碗 甜品吃到飽，ho-chia，好呷❤️"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-9YeiMpMbMEU/AAAAAAAAAAI/AAAAAAAAAAA/wI_qkLczP2w/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市板橋區埔墘里",null,null,null,null,null,null,null,null,[null,[null,1],0,[121,55,164,393,1466],["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,[[[[[