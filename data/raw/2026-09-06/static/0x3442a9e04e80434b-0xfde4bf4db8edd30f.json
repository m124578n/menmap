l,12,0,12],"CgsKCS9tLzAyODU5ZA\u003d\u003d","0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Q1bMECKYBKCY",null,null,null,[[2]]],[["/m/09b5t"],"雞",null,[null,null,null,null,12,0,12],"CgoKCC9tLzA5YjV0","0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Q1bMECKcBKCc",null,null,null,[[2]]],[["/m/08d_8c"],"湯麵",null,[null,null,null,null,6,79,43],"CgsKCS9tLzA4ZF84Yw\u003d\u003d","0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Q1bMECKgBKCg",null,null,null,[[2]]],[["/m/07cmh2"],"甜湯",null,[null,null,null,null,5,0,6],null,"0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Q1bMECKkBKCk",null,null,null,[[2]]],[["/g/155ph13j"],"煎餃",null,[null,null,null,null,5,0,5],null,"0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Q1bMECKoBKCo",null,null,null,[[2]]],[["/g/1213hnk6"],"高湯",null,[null,null,null,null,5,0,5],null,"0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Q1bMECKsBKCs",null,null,null,[[2]]],[["/m/01g7cg"],"溏心蛋",null,[null,null,null,null,5,0,5],null,"0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Q1bMECKwBKCw",null,null,null,[[2]]],[["/m/0b4g4t"],"口感",null,[null,null,null,null,5,0,5],null,"0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Q1bMECK0BKC0",null,null,null,[[2]]]]],[["您好，我們是來自日本東京門前仲町的「麺屋 四季 〜Shiki〜」。踏踏實實，只為喜愛拉麵的您奉上一碗真心。\n我們在東京門前仲町落腳時，思考著如何做出能溫暖人心、卻又能展現食材本質的風味。於是，我們試著將西式傳統的「Potage（法式濃湯）」概念，融入了日式傳統的雞白湯與沾麵中。\n\n這並不是為了追求特立獨行。我們只是著迷於將大量的季節性根莖類蔬菜，與雞骨一同經過長時間慢火細燉，直到它們完全化不開地融合在一起。這種做法非常費時費工，但它能讓湯頭既有如慕斯般細緻濃郁的「掛湯力」，卻又帶著蔬菜天然的甘甜與清爽，不會給身體帶來過重的負擔。\n\n不論是濃郁的沾麵，還是清澈優雅、平衡雞骨與蔬菜風味的「雞白湯拉麵」，我們都用一樣最樸實、最費時的功夫去熬煮。連同舒肥叉燒的熟成時間、麵條的齒切口感，每一個看似微不足道的細節，都是我們日復一日、在廚房裡與食材對話的成果。\n今年，我們做了一個很大的決定——「麵屋 四季 ～Shiki～」要跨出日本，來到台灣展開我們的海外第一家分店，並且正式落腳於新北市板橋。\n\n對於台灣這個充滿熱情、且同樣深深熱愛拉麵文化的地方，我們內心既期待又充滿忐忑。我們知道板橋與整個台灣有非常多優秀的拉麵前輩與嘴甜心細的饕客，因此，我們不敢說自己帶來了多麼震撼的美味，我們帶來的，只有當年在東京初次開店時，那份毫無保留的初心。\n我們已經準備好了。在接下來的日子裡，我們會一直在板橋的廚房裡守著那口湯鍋，用最謙卑的心、最專注的眼神，為每一位走進店裡的您，遞上一碗溫熱的拉麵。期待能看見您完食後，那一抹滿足的微笑。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-45hLBsFEk0c/AAAAAAAAAAI/AAAAAAAAAAA/B7-KssNSZTo/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市板橋區",null,null,null,null,null,null,null,null,[null,[null,1],0,[0,4,14,8,34],["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,[[[[["Ci9DQUlRQUNvZENodHljRjlvT25SUFJqTjJZMjVQZUhvMFJ5MU9jbWw2UWpONmMxRRAB",["0x0:0xfde4bf4db8edd30f",null,1784266359194137,1785679454119842,[null,null,["https://www.google.com/maps/contrib/100744165609255837537/reviews?hl\u003dzh-TW"],null,null,["Lopin Kuo","https://lh3.googleusercontent.com/a-/ALV-UjXxjnhv_OXhUfnyYNExYArTzvfoC-zuUAJBMgGob3rdACzhTRCNXA\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/100744165609255837537?hl\u003dzh-TW"],"100744165609255837537",null,578,2142,null,[1,8,1],130,["在地嚮導 · 578 則評論",null,null,null,null,[null,"0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Qpr8GCDwoAA"]]]],null,"上次編輯：1 個月前",null,null,null,null,null,null,["Google","https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,1],[[5],null,[["CIABIhDki20VEpEbZPplhsXT8z8q",["CIABIhDki20VEpEbZPplhsXT8z8q",10,12,null,null,null,["https://lh3.googleusercontent.com/grass-cs/ACvplmOtTsuGg1-E9lAujyIiK44ILL0Qsq8-bPP7OKfssmLm8110rO4aJuR5b8hbtYkeMnlj36_LK9RoW2BX8Lxnss7DSG9159zVeOy-srCZS4duMkdixkLfAoaW3P5_DIfxd9bYPamylHl8Y8k\u003dk-no",null,[3072,3072]],null,[[3,121.46124088702891,25.02301069516756],[0,90],[3072,3072],75],"oV2daoWaBOvG0PEPmNia-AQ","0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8QzCcIPSgB",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDki20VEpEbZPplhsXT8z8q\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xfde4bf4db8edd30f",null,null,"0ahUKEwjF7quv-9mWAxVrIzQIHRisBk8Q-y4IPigA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhDki20VEpEbZPplhsXT8z8q"],[10,3,[3072,3072]],[null,null,null,null,null,null,null,["麵屋 四季 板橋店"]],[null,[[["Lopin Kuo"],"https://www.google.com/maps/contrib/100744165609255837537?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjXxjnhv_OXhUfnyYNExYArTzvfoC-zuUAJBMgGob3rdACzhTRCNXA\u003ds120-c-rp