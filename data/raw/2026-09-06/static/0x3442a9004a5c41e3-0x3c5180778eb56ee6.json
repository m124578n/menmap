","0ahUKEwjdvdX7-9mWAxWWEzQIHZuCDnUQ3YcHCEsoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjdvdX7-9mWAxWWEzQIHZuCDnUQ3IcHCEooDA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjdvdX7-9mWAxWWEzQIHZuCDnUQ3IcHCEwoDQ",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjdvdX7-9mWAxWWEzQIHZuCDnUQ3IcHCE0oDg",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjdvdX7-9mWAxWWEzQIHZuCDnUQ3IcHCE4oDw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_MODERATE"],"有點吵雜",2,null,null,"0ahUKEwjdvdX7-9mWAxWWEzQIHZuCDnUQ3YcHCFAoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjdvdX7-9mWAxWWEzQIHZuCDnUQ3IcHCE8oEA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjdvdX7-9mWAxWWEzQIHZuCDnUQ3YcHCFIoAA"]],1],null,null,"等待時間",null,"0ahUKEwjdvdX7-9mWAxWWEzQIHZuCDnUQ3IcHCFEoEQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["排隊體驗真的差到不行。\n在門口排了很久，等到都快想離開，完全沒有人來接待或說明。後來我自己去問收銀台，結果被叫回去繼續排隊，但問題是現場根本沒有人在排隊🙄，我不知道我在跟誰排隊，空氣還是鬼？\n\n還收10%服務費，但老實說，完全感受不到任何服務。連基本的餐點介紹都很隨便，感覺店員也不太想講。\n\n餐點部分：拉麵還可以。\n但出餐節奏真的很亂，點了拉麵、青菜、煎餃，結果拉麵跟青菜都吃完、已經飽了，煎餃才上來。中間還一度以為忘記了，想說結帳直接取消，結果最後一刻才送上來，只能外帶回家吃冷掉的煎餃。\n\n補充一下：後來反映之後，店裡的幹部有堅持幫我把煎餃取消、不收費，也有在積極嘗試補救，這點值得肯定。\n\n但老實說，整體用餐體驗已經很糟糕了，不是事後補救就能彌補的那種程度。\n\n原本是打算給一顆星。\n但因為拉麵本身還可以，加上那位幹部的積極處理，最後給兩顆星。\n\n整體用餐體驗很差。\n而且很誇張的是，坐我旁邊、比我晚來的客人都比我早走。\n\n明明是連鎖拉麵店，但整個感覺更像在吃百貨公司美食街的品質跟服務。真的蠻失望",null,[0,95]]]],[null,null,null,null,null,"https://business.google.com/local/business/18114959747820070064/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRKTTFNelpHRlZWV3QwV25wU2IxcEdiR3BPVkdSUlVtMW9abFJzUlJBQhAA",[null,null,null,"/local/business/18114959747820070064/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRKTTFNelpHRlZWV3QwV25wU2I