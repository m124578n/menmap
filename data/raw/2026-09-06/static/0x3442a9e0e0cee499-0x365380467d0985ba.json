,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,[[[["/m/0ctn7g"],"麻辣",null,[null,null,null,null,201,0,201],null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKMBKCE",null,null,null,[[2]]],[["/m/0fr3wp"],"牛腱",null,[null,null,null,null,54,14,54],"CgsKCS9tLzBmcjN3cA\u003d\u003d","0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKQBKCI",null,null,null,[[2]]],[["/m/033t__"],"細麵",null,[null,null,null,null,51,0,515],null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKUBKCM",null,null,null,[[2]]],[["/m/09448n"],"拌麵",null,[null,null,null,null,50,261,200],"CgsKCS9tLzA5NDQ4bg\u003d\u003d","0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKYBKCQ",null,null,null,[[2]]],[["/g/155qth4r"],"鴨血",null,[null,null,null,null,47,0,47],null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKcBKCU",null,null,null,[[2]]],[["/m/01gmdq"],"雪花",null,[null,null,null,null,34,0,34],null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKgBKCY",null,null,null,[[2]]],[["/m/065854"],"泰式奶茶",null,[null,null,null,null,27,0,37],null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKkBKCc",null,null,null,[[2]]],[["/g/155qnw73"],"口水雞",null,[null,null,null,null,26,0,26],null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKoBKCg",null,null,null,[[2]]],[["/g/11dfskq1v6"],"烏梅",null,[null,null,null,null,24,0,24],null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKsBKCk",null,null,null,[[2]]],[["/m/0kvfv0v"],"辣子雞",null,[null,null,null,null,18,0,18],null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ1bMECKwBKCo",null,null,null,[[2]]]]],[["【吃刁鑽】好之又好，就是刁鑽。\n\n『吃麵呷氣味』好麵的基本，講求麵Q湯鮮，料豐味美\n二鬼不走前人路，不受限於常見麵點，專注創新每一碗好麵：\n麻辣鍋式牛肉麵/鹹香滑腴蛋蛋麵/清香撲鼻青麻辣/辣子雞翅麻麻麵...\n嘗試過百麵體，長扁寬細筋道口感不一，搭配各式特色底料紅油\n主椒次麻，碗底再藏蒜香，再點椒末提味；萬不能奪了主料場子，各有層次才相得益彰；\n鹹一分搶肉味，辣一分失腴甜；箇中拿捏盡刁鑽。\n吃麵不圖省事，刁鑽才有這味鮮。\n\n【吃為難】好東西，越簡單越為難。\n\n又要真材實料毫無添加，又要色香俱足實惠動人；\n走透全台訪老廠生麵，每日糰切揪醒不含糊，造就筋道不經日曬，直衝滾水，\n就是要撐得起濃厚大醬不掩麵香\n又有馬友鹹魚細細剝，不嫌氣衝味厚，細熬慢烹取其鮮；桂丁土雞燉湯底，無腥白肉煮醇濃\n直人憨做麵；因為貨真價實，更要厚工熬製，才對得起師傅們的堅持\n此中有心意，為難便也不為難。\n\n【吃有青】隨點現煮，鮮聲逼人\n\n縱使湯麵也要帶鑊氣，直火現煎才有青\n搶時間就是搶口感，爽脆酥麻嫩焦香\n接單現點水滾麵，燒雞炙牛爆油黃；\n盤盤白麵碼、上熱燙好料，蔥如星斗；椒油一淋色香味全具\n刁鑽為難出好麵，簡單從來不簡單\n來二鬼吃氣味，好麵就要有聲有色，暢快淋漓！"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-WnxVTvY0vQY/AAAAAAAAAAI/AAAAAAAAAAA/SUxjnd3AdL4/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市三重區",null,null,null,null,null,null,null,null,[null,[null,1],0,[117,72,189,480,1452],["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,[[[[["Ci9DQUlRQUNvZENodHljRjlvT2pFemNrRlZNbmhQYnpJMlNUWm5hbVpMY0RWSVlVRRAB",["0x0:0x365380467d0985ba",null,1778216627464925,1778216636185312,[null,null,["https://www.google.com/maps/contrib/113922346827659765071/reviews?hl\u003dzh-TW"],null,null,["瑞森 慢活中","https://lh3.googleusercontent.com/a-/ALV-UjVjw_IvZNceIDSIEMzdkSzTyfj-w3N54hX4nL5_C04tx-YEscQ\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/113922346827659765071?hl\u003dzh-TW"],"113922346827659765071",null,178,1171,null,[1,7,1],1,["在地嚮導 · 178 則評論",null,null,null,null,[null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQpr8GCDIoAA"]]]],null,"3 個月前",null,null,null,null,null,null,["Google","https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,1],[[5],null,[["CIABIhDMq4PvVUUC-kpLevNALJv4",["CIABIhDMq4PvVUUC-kpLevNALJv4",10,12,null,null,null,["https://lh3.googleusercontent.com/grass-cs/ACvplmP-7XMPdH9gTd-QICzsWYR5IMAQArwB_2C9bfv5LfYR6FYhw8YUHz0dXSJXDpjdHPD-Qda5U-6Z45F0wYrF979CBxjRFHuIPo4MwWffDsW_eaWOMp731fqWX196gshDEkZIlxWFyaKzW509\u003dk-no",null,[2048,1152]],null,[[3,121.49966488635893,25.062742134421306],[0,90],[2048,1152],75],"vFmdapCwN6Dn1sQPsvi2iAM","0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQzCcIMygB",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDMq4PvVUUC-kpLevNALJv4\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x365380467d0985ba",null,null,"0ahUKEwiQ_qrU99mWAxWgs5UCHTK8DTEQ-y4INCgA"],null,null,null,null,null,null,null,null,n