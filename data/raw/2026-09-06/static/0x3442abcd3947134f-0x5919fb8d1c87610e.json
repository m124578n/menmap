，拉麵店能訂位是一大特色。",null,[0,114]]]],[null,null,null,null,null,"https://business.google.com/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA",[null,null,null,"/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA"],"https://business.google.com/local/business/14538826069739229445/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA",[null,null,null,"/local/business/14538826069739229445/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA"],null,"https://business.google.com/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA",[null,null,null,"/local/business/14538826069739229445/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZWswd01IbGhWVTU1WVdwUmVsZEZSbGhOYW1oUFRucFNabU14UlJBQhAA"]],[null,null,1168,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT20xek0wMHlhVU55YWpReldFRlhNamhPTnpSZmMxRRAB!2m1!1s0x0:0x5919fb8d1c87610e!3m1!1s2@1:CAIQACodChtycF9oOm1zM00yaUNyajQzWEFXMjhONzRfc1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT20xek0wMHlhVU55YWpReldFRlhNamhPTnpSZmMxRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT20xek0wMHlhVU55YWpReldFRlhNamhPTnpSZmMxRRI-Ci9DQUlRQUNvZENodHljRjlvT20xek0wMHlhVU55YWpReldFRlhNamhPTnpSZmMxRRILMGVRV0JrVVZVY1MaPgovQ0FJUUFDb2RDaHR5Y0Y5b09tMXpNMDB5YVVOeWFqUXpXRUZYTWpoT056UmZjMUUSCzBlUVdCa1VWVWNTIhIJAAAAAAAAAAARDmGHHI37GVkqCzBlUVdCa1VWVWNT\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwikqK2Q-dmWAxVekq8BHaibDccQoy