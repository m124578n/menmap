HQoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwj99ODo_NmWAxWJJTQIHQ_IAtcQ3IcHCHMoDA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwj99ODo_NmWAxWJJTQIHQ_IAtcQ3IcHCHUoDQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwj99ODo_NmWAxWJJTQIHQ_IAtcQ3IcHCHYoDg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwj99ODo_NmWAxWJJTQIHQ_IAtcQ3IcHCHcoDw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwj99ODo_NmWAxWJJTQIHQ_IAtcQ3YcHCHkoAA"]],1],null,null,"等待時間",null,"0ahUKEwj99ODo_NmWAxWJJTQIHQ_IAtcQ3IcHCHgoEA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwj99ODo_NmWAxWJJTQIHQ_IAtcQ3YcHCHsoAA"]]],null,"座位類型",null,"0ahUKEwj99ODo_NmWAxWJJTQIHQ_IAtcQ3IcHCHooEQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["2026/06/12   內附菜單   現金支付   810\n推薦：味噌剝皮辣椒雞湯、銷魂叉燒飯、唐揚炸雞、鹽味蛤蜊雞白湯\n\n來到台北中山區的巷弄裡，這間「炊煙拉麵 錦州店」絕對是拉麵控必須朝聖的頂級隱藏版愛店！🍜 這裡的每一道料理都展現了師傅深厚的功力，完美的味覺體驗讓人一吃就徹底愛上，絕對是無可挑剔的頂尖饗宴！💯\n首推必點的絕對是創意十足的「味噌剝皮辣椒雞湯」🍲 ($300)，溫潤的味噌與剝皮辣椒的微辣回甘完美融合，湯頭層次豐富且極度順口，真的超級好吃👍！而另一款「鹽味蛤蜊雞白湯」🌊 更是將海陸精華濃縮於一碗，醇厚的雞白湯底搭配蛤蜊的極致鮮甜，湯頭表現堪稱完美，讓人忍不住一口接一口直接喝到見底。\n除了拉麵，這裡的附餐同樣令人驚豔！大推這碗香氣逼人的「銷魂叉燒飯」🍚 ($70)，炙燒過的叉燒油脂香氣四溢，拌著醬汁與白飯一起享用，美味度完全對得起它的名字👍！搭配外酥內嫩、肉汁滿溢的「唐揚炸雞」🍗 ($110)，以及酸甜爽脆、非常解膩開胃的「自製黃金泡菜」🥬 ($30)，讓整頓餐點的豐富度與爽度直接拉滿。\n整體而言，炊煙拉麵無論是在湯頭的熬製、食材的搭配，還是附餐的用心程度，都展現了極致的職人精神。這是一間讓人吃完感到無比幸福的神級美味，強烈推薦給所有熱愛日式拉麵的朋友，絕對值得特地為它造訪！🌟",null,[0,61]]]],[null,null,null,null,null,"https://business.google.com/local/business/11970940408413199006/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzY0dGRlZsVmtTRlkxWlVkNFZtRnRVVEJpUkU1NVlXcFNkMlJyUlJBQhAA",[null,null,null,"/local/business/11970940408413199006/customers/reviews/reply?p\u003dCkRDaT