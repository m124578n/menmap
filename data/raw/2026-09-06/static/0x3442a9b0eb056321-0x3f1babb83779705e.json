null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["2026/7/21二訪\n\n本次消費醬油拉麵與豪華黑蒜拉麵，個人認為勝過雞白湯。\n\n兩款的湯頭味道不錯，醬油湯底不會太死鹹，但是層次比較單調，以醬油湯底來說個人會更喜歡萬年樓下的吉天元，豪華黑蒜應該是味增湯底，味道不錯但是黑蒜的風味稍淡，若黑蒜風味再強烈些完成度會更好。\n\n叉燒的厚度比例很好，肥瘦適中，口感不錯，但是叉燒本身偏柴，加點的鴨肉叉燒味道不錯，但是厚度太薄，口感不佳。\n\n麵條屬於細麵，容易掛湯但是麵量偏少。\n\n西門一帶算是不錯的拉麵選擇，值得一試，但是價位稍高。",null,[0,39]]]],[null,null,null,null,null,"https://business.google.com/local/business/8860182100938851560/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVW1FeFNURmhWbEpYWkRGdmVWTXlaREpVTVVwNFYwaGtiVTlZWXhBQhAA",[null,null,null,"/local/business/8860182100938851560/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVW1FeFNURmhWbEpYWkRGdmVWTXlaREpVTVVwNFYwaGtiVTlZWXhBQhAA"],"https://business.google.com/local/business/8860182100938851560/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVW1FeFNURmhWbEpYWkRGdmVWTXlaREpVTVVwNFYwaGtiVTlZWXhBQhAA",[null,null,null,"/local/business/8860182100938851560/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVW1FeFNURmhWbEpYWkRGdmVWTXlaREpVTVVwNFYwaGtiVTlZWXhBQhAA"],null,"https://business.google.com/local/business/8860182100938851560/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVW1FeFNURmhWbEpYWkRGdmVWTXlaREpVTVVwNFYwaGtiVTlZWXhBQhAA",[null,null,null,"/local/business/8860182100938851560/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVW1FeFNURmhWbEpYWkRGdmVWTXlaREpVTVVwNFYwaGtiVTlZWXhBQhAA"]],[null,null,1956,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2s1UmExSTFhVlJXZDFveVMyZDJUMUp4V0hkbU9YYxAB!2m1!1s0x0:0x3f1babb83779705e!3m1!1s2@1:CAIQACodChtycF9oOk5Ra1I1aVRWd1oyS2d2T1JxWHdmOXc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2s1UmExSTFhVlJXZDFveVMyZDJUMUp4V0hkbU9YYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2s1UmExSTFhVlJXZDFveVMyZDJUMUp4V0hkbU9YYxI-Ci9DQUlRQUN