ll,"0ahUKEwjnvMHZ-tmWAxWKma8BHZpzCeEQ3IcHCFYoCQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjnvMHZ-tmWAxWKma8BHZpzCeEQ3IcHCFcoCg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjnvMHZ-tmWAxWKma8BHZpzCeEQ3IcHCFgoCw",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["20250510 [首刷]\n評價：『好吃』👍👍\n\n{超值套餐：牛拉麵+蝦拉麵 兩道小菜+兩瓶飲料} 430\n\n[蒜香豚骨雪花牛拉麵]\n湯頭不會太濃，蒜泥味沒有很濃，但也是挺香的。肉片是味道普通的五花牛肉片，麵量適中。\n\n[鮮蝦拉麵]\n味噌與蝦子混合的湯底還不錯。蝦子給了6~8隻超多，雖然是普通的蝦子但我還是撥的很累，嫌麻煩的話不要嘗試。\n\n_____________心得文______________\n雖然是連鎖店，但貴一點的品項也不會差到哪裡去，而且這個超值套餐不錯，還提供小菜和飲料，只不過蝦子是真的麻煩~",null,[0,23]]]],[null,1778916159000000,1778916159000000,"3 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfLTFVTG1oT193SWZnRU4tSWNmRjJTZw%7CCAEQrcz1_gkiLwoZQ0hfLTFVTG1oT193SWZnRU4tSWNmRjJTZxoSQ2dzSXY3YWcwQVlRM2Z1WE9n\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjnvMHZ-tmWAxWKma8BHZpzCeEQ_2MIWSgM"],"https://business.google.com/local/business/6691604879582332352/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRVkd0eU5XNTJhRGwyUkV4bkVBRRAA",[null,null,null,"/local/business/6691604879582332352/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRVkd0eU5XNTJhRGwyUkV4bkVBRRAA"],"https://business.google.com/local/business/6691604879582332352/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRVkd0eU5XNTJhRGwyUkV4bkVBRRAA",[null,null,null,"/local/business/6691604879582332352/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRVkd0eU5XNTJhRGwyUkV4bkVBRRAA"],null,"https://business.google.com/local/business/6691604879582332352/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRVkd0eU5XNTJhRGwyUkV4bkVBRRAA",[null,null,null,"/local/business/6691604879582332352/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZRVkd0eU5XNTJhRGwyUkV4bkVBRRAA"],null,["zh-Hant"],[["謝謝您的評論🥰\n雖是連鎖店但老闆很用心在食材上喔！🤗",null,[0,2