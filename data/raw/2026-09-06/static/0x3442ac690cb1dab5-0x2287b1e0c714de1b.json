2],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiI9amz99mWAxX5rlYBHZkoN7oQ3IcHCJcBKAQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiI9amz99mWAxX5rlYBHZkoN7oQ3IcHCJgBKAU",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["流淚了 跟以前差好多\n2/13 19:30 點了淡麗+叉燒飯\n淡麗擺盤一樣好看，但是湯頭卻充滿死鹹，以前喝起來湯頭是順口的，配上薄荷葉淡淡清香，融合的很好，甚至有喝仙草雞的感覺，很後悔應該點雞白湯才對\n\n叉燒飯更是失望 如今的飯入口米芯是硬的，叉燒肉跟飯分離感很重，吃幾口後就不想碰飯了。\n而且店內現在都播放女韓團快歌，更是無言，掌廚的是年輕眼睛妹\n唉 人也都不同⋯  不推了",null,[0,100]]]],[null,null,null,null,null,"https://business.google.com/local/business/18417016649273108980/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTkZZeFJrcFJXR1JOV2xSR2QxZEdiRFpTVlRGSFpHNW9NMVZyUlJBQhAA",[null,null,null,"/local/business/18417016649273108980/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTkZZeFJrcFJXR1JOV2xSR2QxZEdiRFpTVlRGSFpHNW9NMVZyUlJBQhAA"],"https://business.google.com/local/business/18417016649273108980/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTkZZeFJrcFJXR1JOV2xSR2QxZEdiRFpTVlRGSFpHNW9NMVZyUlJBQhAA",[null,null,null,"/local/business/18417016649273108980/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTkZZeFJrcFJXR1JOV2xSR2QxZEdiRFpTVlRGSFpHNW9NMVZyUlJBQhAA"],null,"https://business.google.com/local/business/18417016649273108980/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTkZZeFJrcFJXR1JOV2xSR2QxZEdiRFpTVlRGSFpHNW9NMVZyUlJBQhAA",[null,null,null,"/local/business/18417016649273108980/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTkZZeFJrcFJXR1JOV2xSR2QxZEdiRFpTVlRGSFpHNW9NMVZyUlJBQhAA"]],[null,null,13047,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xkNFYxRkpRWGRNWlRGd1dGbDZSVTFHZG5oM1VrRRAB!2m1!1s0x0:0x2287b1e0c714de1b!3m1!1s2@1:CAIQACodChtycF9oOld4V1FJQXdMZTFwWFl6RU1Gdnh3UkE%7C%7C?h