3IcHCFAoBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3YcHCFMoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCFIoBQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCFQoBg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCFUoBw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCFYoCA",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11vrk6ptgc"],"醬油拉麵",2,null,null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3YcHCFgoAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCFcoCQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["店內只有6個座位而且沒有菜單，用餐頗隨意的。其實只是剛好當天想吃拉麵而搜尋附近看到這間拉麵、沒想到第一次吃就排了將近一個多小時才入座。\n老闆會直接口頭問要吃哪個口味、以及需不需要調整鹹淡。當天點了一碗雞鹽$200跟醬油款$200，如果不調整的話，口味真的是日本當地拉麵的鹹度，但喜歡吃日本拉麵的朋友應該會很喜歡，如果平常習慣吃清淡一點就會建議要調整口味。兩碗拉麵都很有味道、價位也符合期待。唯一希望可以更好的是環境整潔，只是聽說老闆已經收攤退休其實也沒差了，趁機恭喜老闆完成了人生里程碑！",null,[0,67]]]],[null,null,null,null,null,"https://business.google.com/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXphVXR5YlVSUkVBRRAA",[null,null,null,"/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXphVXR5YlVSUkVBRRAA"],"https://business.google.com/local/business/4126853881898507599/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXphVXR5YlVSUkVBRRAA",[null,null,null,"/local/business/4126853881898507599/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXphVXR5YlVSUkVBRRAA"],null,"https://business.google.com/local/business/4126853881898507599/customers/reviews/reply