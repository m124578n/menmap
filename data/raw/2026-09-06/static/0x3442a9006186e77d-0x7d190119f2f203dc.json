:DINE_IN"],"內用",2,null,null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3YcHCIYBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCIUBKAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:BRUNCH"],"早午餐",2,null,null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3YcHCIgBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCIcBKA0",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3YcHCIoBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCIkBKA4",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCIsBKA8",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCIwBKBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCI0BKBE",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11vrk6ptgc"],"醬油拉麵",2,null,null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3YcHCI8BKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q3IcHCI4BKBI",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["★拉麵迷請進→FB搜尋：『台灣拉麵愛好會』、IG：twramenclub\n\n▎拉麵名稱／價格：醬油清湯+雞塩清湯(粗麵)／170+180\n▎配置：細麵、粗麵\n\n★營業時間已改成晚間，限定品項請參照粉專\n\n宋囍一開始是主打早午餐拉麵，也是目前台灣少有的早上能吃上一碗拉麵的店家！會有這樣規劃的營業時間，是因為老闆本身有市場的家業要幫忙然後晚上也要陪伴小孩家人。\n\n（補充：宋囍的門口暖簾、菜單都是小孩畫的）\n\n而開這間拉麵其實是老闆想圓夢，當天有稍微詢問老闆拉麵從哪裡學的。結果老闆說不能說，後續沒想到直接在鬼金棒的粉專看到推薦分享，沒想到是前鬼金棒的員工。\n\n這也是鬼金棒店主少有的再粉專推薦拉麵店，這是目前第三間（嘉義山越、高雄火山湯海）跟台灣鬼金棒有相關的推薦。\n\n後續因為營業時間特別，其實就是做身體健康的，本來是打算時間到結束營業，結果消息一出喜歡宋囍的麵友哀號，也造就後續排隊的人龍湧現。\n\n店主考量後就決定撐到一下到8月，不過要調整營業時間到晚上，也就是說台灣早午餐拉麵又沒了一間...\n\n蠻佩服且欣賞老闆追夢和照顧家庭的舉動，雖然粉專和社團上有時候會看到老闆爆氣噴人，但是實際上老闆其實現場蠻安靜且和善的；曾經在社團內看到有人批評老闆粉專態度差，我想有時候在這世代，面對網路的部分或許這是一種方式，但是凡事還是多方參考不只看表面。\n\n回到正題，店內座位數五個，真的少！然後有提供廁所。\n當時品項就是兩款鹽味和醬油，不過現在不時有新的限定品項和活動推出，詳情可以參考粉專消息。\n\n因為真的很難得來板橋，又一大早的時間，所以已經默默決定要吃兩碗連打一次收完。\n\n當天蠻有趣的事情是，老闆備料的時候發現居然有火鍋食材鈴鈴卷和海鮮，沒想到是老闆自己想吃就也一同加料了~\n\n▎醬油清湯+雞塩清湯(粗麵)：\n\n醬油本身給很大量的豆芽，旁邊還配上水蓮和玉米筍，這碗我是選擇細麵。\n\n湯頭的風味鰹節明顯，也帶出醬油銳利風味，我自己覺得味道調性有點類似鷹流蘭丸的醬油。不過配上大量的豆芽，讓原本湯頭強烈中和，一口豆芽一口麵一口湯，這樣組合我覺得是這碗默默就吃完的關鍵。\n\n雞塩這碗反而調性跟醬油不同，就有點類似網路上看發文的老闆跟現場感受本人的不同。鹽味這碗就是有點現場本人的溫和但帶有個性的呈現，而且湯的風味我很喜歡！\n\n湯本身是雞湯底但是在醬底的製作上有帶入魚介相關食材，所以湯頭風味有雞湯的香甜外還有魚介帶出的風味，很順口好喝，這碗推推~\n\n這碗麵體我選擇粗麵也覺得很搭，麵體有嚼勁好吃。\n配料有叉燒、玉米筍、水蓮，然後叉燒上有放一些乾燥的巴西里，會增添一些不同的風味。",null,[0,68]]]],[null,1724155021000000,1724155021000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04bXd4Z3VyNzVteElTTkFBZDJDZw%7CCAEQrcz1_gkiMAoZQ0hfQm04bXd4Z3VyNzVteElTTkFBZDJDZxoTQ2d3SWpZbVN0Z1lRNVlfRjRnRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiT2bG5-9mWAxWTgK8BHTeWIK8Q_2MIkAEoEw"],"https://business.google.com/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmljbDlJZWs5M0VBRRAA",[null,null,null,"/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmljbDlJZWs5M0VBRRAA"],"https://business.google.com/local/business/4126853881898507599/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmljbDlJZWs5M0VBRRAA",[null,null,null,"/local/business/4126853881898507599/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmljbDlJZWs5M0VBRRAA"],null,"https://business.google.com/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmljbDlJZWs5M0VBRRAA",[null,null,null,"/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmljbDlJZWs5M0VBRRAA"],null,["zh-Hant"],[["謝謝星大✌️",null,[0,6]]]],[null,null,8984,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNicl9Iek93EAE!2m1!1s0x0:0x7d190119f2f203dc!3m1!1s2@1:CIHM0ogKEIC