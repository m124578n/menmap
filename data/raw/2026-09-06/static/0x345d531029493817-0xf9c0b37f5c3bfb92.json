null,null,"0ahUKEwjjhYW8_dmWAxVZmq8BHQTfDsEQ3YcHCJwBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjjhYW8_dmWAxVZmq8BHQTfDsEQ3IcHCJsBKDk",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["汐止唯一排隊拉麵店\n晚上6:10開到8:00\n5:30開始登記\n大概13.4個座位左右\n超過就要第二輪\n一輪大概30分鐘\n雞白湯拉麵口味分三種\n塩味190\n醬油200\n柚子塩230\n加麵不用錢\n有人說口味跟阿夫利差不多\n我倒是覺得還好\n比起其他雞白湯名店\n少了一點點\n豬叉燒雖然有炙燒\n但是味道不足\n塩味1碗190\n看似cp值高\n但是只有1片豬叉\n和2片雞胸\n唐揚雞70\n胡麻高麗菜40\n口味不錯\n網友推薦的叉燒飯70\n這個就有點吃不懂\n跟印象中的完全不一樣\n好像是雞肉\n而且完全沒有炙燒感",null,[0,31]]]],[null,null,null,null,null,"https://business.google.com/local/business/8189832682589851145/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzYkU1VVVscGphMUpYVWtac01HSkZOVXBaYkVwRVVXdFNjRlJzUlJBQhAA",[null,null,null,"/local/business/8189832682589851145/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzYkU1VVVscGphMUpYVWtac01HSkZOVXBaYkVwRVVXdFNjRlJzUlJBQhAA"],"https://business.google.com/local/business/8189832682589851145/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzYkU1VVVscGphMUpYVWtac01HSkZOVXBaYkVwRVVXdFNjRlJzUlJBQhAA",[null,null,null,"/local/business/8189832682589851145/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzYkU1VVVscGphMUpYVWtac01HSkZOVXBaYkVwRVVXdFNjRlJzUlJBQhAA"],null,"https://business.google.com/local/business/8189832682589851145/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzYkU1VVVscGphMUpYVWtac01HSkZOVXBaYkVwRVVXdFNjRlJzUlJBQhAA",[null,null,null,"/local/business/8189832682589851145/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzYkU1VVVscGphMUpYVWtac01HSkZOVXBaYkVwRVVXdFNjRlJzUlJBQhAA"]],[null,null,4618,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tsbE5UUlpja1JXUkZsMGJFNUpZbEpEUWtScFRsRRAB!2m1!1s0x0:0xf9c0b37f5c3bfb92!3m1!1s2@1:CAIQACodChtycF9oOkllNTRZckRWRFl0bE5JYlJDQkRpTlE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u0