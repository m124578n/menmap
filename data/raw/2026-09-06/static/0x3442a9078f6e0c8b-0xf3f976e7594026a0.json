null,null,null,["zh-Hant"],[["服務態度不錯，鹹淡、軟硬都可以客製，有蒜酥可自取，每碗基本配料：雞叉燒、海苔\n\n雞白湯拉麵(鹹度正常)\n湯底雞味濃郁、不膩口，加入蒜酥後增添另一種味道；雞肉很嫩，有舒肥的口感\n\n松露雞湯拉麵(鹹度正常)\n松露與雞白湯底蠻融合的，多了股奶香，很順口，推\n\n麵條\n麵條選擇正常硬度，但覺得偏軟，沒有Q度\n\n溏心蛋\n鹹度適中，蛋黃熟度剛好，微微流心\n\n*整體CP值尚可，若要外帶，麵條硬度可能需選擇硬的才不會有偏軟的情況\n202410",null,[0,51]]]],[null,null,null,null,null,"https://business.google.com/local/business/17107883736636709447/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTlllamh1TlVwUkVBRRAA",[null,null,null,"/local/business/17107883736636709447/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTlllamh1TlVwUkVBRRAA"],"https://business.google.com/local/business/17107883736636709447/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTlllamh1TlVwUkVBRRAA",[null,null,null,"/local/business/17107883736636709447/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTlllamh1TlVwUkVBRRAA"],null,"https://business.google.com/local/business/17107883736636709447/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTlllamh1TlVwUkVBRRAA",[null,null,null,"/local/business/17107883736636709447/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTlllamh1TlVwUkVBRRAA"]],[null,null,9544,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNYejhuNUpREAE!2m1!1s0x0:0xf3f976e7594026a0!3m1!1s2@1:CIHM0ogKEICAgICXz8n5JQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUNYejhuNUpREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUNYejhuNUpREi4KF0NJSE0wb2dLRUlDQWdJQ1h6OG41cFFFEhNDZ3dJOUlyY3VBWVFvTUthcFFJGi0KFkNJSE0wb2dLRUlDQWdJQ1h6OG41WlESE0Nnd0l1SW5jdUFZUTBJMmw0QUUiEgkAAAAAAAAAABGgJkBZ53b58yoLMGI0cW5pWmhkUkY\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiPu5T699mWAxUpdPUHHeXMLokQoykIYygF"],null,[null,[[1,0]]]],"0ahUKEwj2kJr699mWAxXxeF4EHahCEVsQ0pMFCCkoAg"],null,null,null,"0ahUKEwiPu5T699mWAxUpdPUHHeXMLokQ0pMFCFkoAg"],[["ChdDSUhNMG9nS0VJQ0FnSUNwOS03YXRnRRAB",["0x0:0