,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjOx8Gb8dSWAxUngq8BHdVhAQ4Q3IcHCHMoBw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjOx8Gb8dSWAxUngq8BHdVhAQ4Q3IcHCHQoCA",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這次來到台北市立圖書館總館附近的美香拉麵屋外帶餐點。點了魚香拌麵（辣）、小二拌麵（不辣），及兩碗味增蛤蜊湯，整體感受可以說是好吃且份量足夠，但不便宜。\n魚香拌麵的酸辣度拿捏得很到位，不會過於刺激，入口是先酸後辣，層次分明，醬汁與麵條拌在一起相當順口，即使有辣度也不會搶走整體風味。小二拌麵則走溫和路線，微酸卻依然保有醬香與油香，味道不單調，對不吃辣的人來說相當友善。味增蛤蜊湯表現也不馬虎，湯頭清甜，海帶、蛤蜊、花椰菜給得不算小氣，搭配拌麵解膩又暖胃。美香拉麵屋的餐點在口味上的確有一定水準，酸辣平衡、調味成熟，是會讓人想慢慢吃完的一餐。\n雖然價格偏高，但幾次實地觀察，來客數或是回訪率不算低。寶貝兒子也相當喜歡，吃得很開心、光這一點也就顯得值得了。\n忘了拍餐點圖，下次再補上囉！",null,[0,75]]]],[null,null,null,null,null,"https://business.google.com/local/business/12920418490973326664/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWZDFwcVRucE5WelI0VTIxMGQyTklXVFZTUkdSd1ZETm9NVkZ1WXhBQhAA",[null,null,null,"/local/business/12920418490973326664/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWZDFwcVRucE5WelI0VTIxMGQyTklXVFZTUkdSd1ZETm9NVkZ1WXhBQhAA"],"https://business.google.com/local/business/12920418490973326664/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWZDFwcVRucE5WelI0VTIxMGQyTklXVFZTUkdSd1ZETm9NVkZ1WXhBQhAA",[null,null,null,"/local/business/12920418490973326664/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWZDFwcVRucE5WelI0VTIxMGQyTklXVFZTUkdSd1ZETm9NVkZ1WXhBQhAA"],null,"https://business.google.com/local/business/12920418490973326664/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWZDFwcVRucE5WelI0VTIxMGQyTklXVFZTUkdSd1ZETm9NVkZ1WXhBQhAA",[null,null,null,"/local/business/12920418490973326664/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWZDFwcVRucE5WelI0VTIxMGQyTklXVFZTUkdSd1ZETm9NVkZ1WXhBQhAA"]],[null,null,5970,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2t