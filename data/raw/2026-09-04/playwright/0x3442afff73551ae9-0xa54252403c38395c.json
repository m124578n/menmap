2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3IcHCJwBKAw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3IcHCJ0BKA0",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3IcHCJ4BKA4",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["看起來在淡水開很久了，今天第一次用餐。\n北新路上店面顯眼\n四個人點了四碗麵，重點是湯頭奶味片中。\n四碗全加麵量太大一般人無法負荷。\n麵條可以。\n其他配菜也一般。\n整體來講吃不出日式拉麵的靈魂與檔次。\n還是要老老實實的熬湯開始，不要走彎路。",null,[0,48]]]],[null,null,null,null,null,"https://business.google.com/local/business/4156714544597332575/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmtjRGt6WlRsQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4156714544597332575/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmtjRGt6WlRsQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/4156714544597332575/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmtjRGt6WlRsQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4156714544597332575/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmtjRGt6WlRsQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/4156714544597332575/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmtjRGt6WlRsQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4156714544597332575/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmtjRGt6WlRsQlJSQUIQAA%3D%3D"]],[null,null,12184,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURkcDkzZTlBRRAB!2m1!1s0x0:0xa54252403c38395c!3m1!1s2@1:CIHM0ogKEICAgIDdp93e9AE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURkcDkzZTlBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURkcDkzZTlBRRItChZDSUhNMG9nS0VJQ0FnSURkcDkzZURBEhNDZ