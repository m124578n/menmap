ll,null,null,null,[[[["/m/07s7dz"],"叉燒",null,[null,null,null,null,17,18,26],"CgsKCS9tLzA3czdkeg\u003d\u003d","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECLUCKEk",null,null,null,[[2]]],[["/g/12214sgwn"],"炒飯",null,[null,null,null,null,15,12,15],"Cg4KDC9nLzEyMjE0c2d3bg\u003d\u003d","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECLYCKEo",null,null,null,[[2]]],[["/m/029zwm"],"cp值",null,[null,null,null,null,8,0,8],null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECLcCKEs",null,null,null,[[2]]],[["/m/09777"],"鮭魚",null,[null,null,null,null,6,0,6],null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECLgCKEw",null,null,null,[[2]]],[["/m/0dxjn"],"炸",null,[null,null,null,null,6,49,34],"CgoKCC9tLzBkeGpu","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECLkCKE0",null,null,null,[[2]]],[["/m/07l8p5"],"小菜",null,[null,null,null,null,6,85,48],"CgsKCS9tLzA3bDhwNQ\u003d\u003d","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECLoCKE4",null,null,null,[[2]]],[["/m/0hr1s_w"],"咖哩",null,[null,null,null,null,6,40,33],"CgwKCi9tLzBocjFzX3c\u003d","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECLsCKE8",null,null,null,[[2]]],[["/m/014cnc"],"學生",null,[null,null,null,null,6,2,7],"CgsKCS9tLzAxNGNuYw\u003d\u003d","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECLwCKFA",null,null,null,[[2]]],[["/g/122dl_fn"],"招牌",null,[null,null,null,null,4,0,4],null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECL0CKFE",null,null,null,[[2]]],[["/g/122zq8zd"],"地獄拉麵",null,[null,null,null,null,3,0,3],null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ1bMECL4CKFI",null,null,null,[[2]]]]],[["🗻日本富士八峰拉麺的起源🍜\n日本富士山下的山梨縣，有間營業了近50年的拉麵老店，經營者是位從小定居於日本的華僑蔡桑。\n蔡桑秉持著將日本傳統美食與台灣民眾分享的精神，在台成立多間分店，並請身在台灣的親戚林桂蘭女士一同幫忙。\n拉麵好吃的重點，在於湯頭的熬製方式。日本道地拉麵風味濃郁厚重，但因個人口感不一、喜好也不同，並非所有台灣饕客都能接受，所以剛開始無法成功打入台灣市場，因此蔡桑將拉麵湯頭及叉燒熬製技術傳承給林桂蘭女士。\n林桂蘭女士本是一位熱衷於美食料理的饌研者，在不影響原本日式風味的前題下，用所學技術將日式拉麵改良成較適合台灣民眾的口味，成功的讓愛好拉麵的饕客讚賞與肯定，並擁有了越來越多愛好者。\n一直以來，老闆娘秉持著健康、養生的原則，堅持做好吃的拉麵給顧客，讓每一位顧客喝到熱騰騰的豚骨湯頭，帶著如此的理想及目標，將日本的拉麵分享給所有愛好拉麵的消費者。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-oPIgzOU9M-U/AAAAAAAAAAI/AAAAAAAAAAA/EU-jtcPWLRM/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"新北市淡水區正德里",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQhbADCMACKAA","全部",[["CIHM0ogKEICAgIDdp93eHA",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWlc6tY6PA7706QGE0asKRJYVyezV2Hdmfcaa0ubEIpFSQgRMwL5K31mP8bQ4ojpuq-i-Z26QlIaz_kUao2G51wlT2x31H_koGzOUOibq88GDYP403rzqRtv9m_PRyRVVL1dwOk\u003dw397-h298-k-no","",[4032,3024],[203,100]],null,[[3,121.44976949999999,25.179033],[0,90],[4032,3024],75],"9rKaatmcEPPS1e8Pncbs2AY","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQzCcIwQIoAA",null,null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIDdp93eHA"],[10,3,[3024,4032]],null,null,[[[2],[[null,null,25.179033,121.44976949999999]]]],[2,null,null,[2],null,[null,null,"photos:gmm_ios_review_post",[6,7,4,1,3]],null,null,[2024,2,28,5]],null,null,null,null,null,null,null,null,null,null,null,null,["UGCS_REFERENCE","CIHM0ogKEICAgIDdp93eHA||","1"]],1,null,null,null,null,null,null,["3765765750121634537","-6538573273146836644"],null,"_oVMEKYkRQI"]],null,null,null,null,null,null,0,1,null,0],["CgIYIQ\u003d\u003d","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQhbADCMICKAE","菜單",[["CIABIhAjFpudKu3geoqTXsdEX6g8",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmPCsSqqj-YkTVJFKYDdkFT0ogHzlN7dGs-QRtnnRGpy2ynO-0KxhMrFiukviud8yi2ROU_FLJE_Wvft7e5UgfWG6MP8EdeG6Npu1gzFtqHnoH5BuynXTTFvstVo0saPbXIjELtiFSGA9J2\u003dw421-h298-k-no","",[3508,2481],[203,100]],null,[[3,121.44976949999999,25.179033],[0,90],[3508,2481],75],"9rKaatmcEPPS1e8Pncbs2AY","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQzCcIwwIoAA",null,null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhAjFpudKu3geoqTXsdEX6g8"],[10,3,[2481,3508]],null,null,[[[2],[[null,null,25.179033,121.44976949999999]]]],[1,null,null,[6],null,[null,null,"bizbuilder:gmb_ios",[6,7,4,1,3]],null,null,[2026,1,1,10]],null,null