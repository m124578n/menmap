YcHCKkBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3IcHCKgBKAQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3YcHCKsBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3IcHCKoBKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3YcHCK0BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3IcHCKwBKAY",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3IcHCK4BKAc",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3IcHCK8BKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjZ7_ip8NSWAxVzafUHHR0jG2sQ3IcHCLABKAk",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["晚上下班經過看到沒什人就走進去吃看看，點了一份鮭魚炒飯跟拉麵，是我個人喜好的口味，整體來說也不會有太油膩的感覺，老闆態度超級良好，且跟客人講話感覺得到被重視 而且態度讓人蠻舒服的，拉麵喝起來湯頭不錯，拉麵軟硬適中，肉雖然不是很多塊，每口都是切小小塊，吃的不是太過癮😅...但味道不錯；鮭魚炒飯香氣四溢，炒飯粒粒分明，鮭魚肉的量以這價位還能接受，小孩也很買單吃完，小孩想多喝一碗湯，跟老闆買卻說不用，揪感心的老闆，點完餐店內就客滿了，慶倖還好早一步進來，店內看起來很乾淨且服務很棒 所以給五顆星(\u2060人\u2060*\u2060´\u2060∀\u2060｀\u2060)\u2060｡\u2060*ﾟ\u2060+\n老闆雖忙碌仍然親切招呼 是一家暖心的店家值得推薦👍，有機會再到店內嘗試別的菜單",null,[0,239]]]],[null,null,null,null,null,"https://business.google.com/local/business/4156714544597332575/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUTFiVWxNWTBaM0VBRRAA",[null,null,null,"/local/business/4156714544597332575/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUTFiVWxNWTBaM0VBRRAA"],"https://business.google.com/local/business/4156714544597332575/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUTFiVWxNWTBaM0VBRRAA",[null,null,null,"/local/business/4156714544597332575/customers/reviews/