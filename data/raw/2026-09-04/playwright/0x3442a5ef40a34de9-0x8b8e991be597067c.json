,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwih_OW78dSWAxVUh68BHf5hIrMQ3IcHCLABKAM",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["今天到八里看病，過橋時剛好看到這家 日式豚將拉麵-新北八里店，臨時決定進來吃一碗，結果意外地讓人驚喜。\n店內主打日式九州風味的極細拉麵，牆上也有介紹麵條來源與特色，強調的是博多系拉麵常見的極細麵，口感偏硬中帶彈，吸湯力很好。\n\n湯頭屬於順口型，不是那種一喝就很重鹹、很油的路線，喝起來舒服，吃到後面也不會膩。麵條煮得恰到好處，搭配湯頭剛剛好，叉燒厚薄適中，有肉香但不柴，整體搭配很平衡。\n菜單選擇算齊全，口味有基本款也有變化款，價格也算親民，屬於可以常來、不會有負擔的拉麵店。\n\n出餐速度快，店員態度也不錯，環境乾淨簡單，很適合路過、看完醫生或臨時想吃碗熱騰騰拉麵的時候來一碗。\n這次是第一次來，但整體體驗很好，下次再來八里應該還會再訪，推薦給附近的朋友。",null,[0,112]]]],[null,null,null,null,null,"https://business.google.com/local/business/3565572879703426860/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1Y0UxcVdsZFhiVGcwWXpCYWJrOVlWWHBhUnpWellVY3hSRmd5WXhBQhAA",[null,null,null,"/local/business/3565572879703426860/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1Y0UxcVdsZFhiVGcwWXpCYWJrOVlWWHBhUnpWellVY3hSRmd5WXhBQhAA"],"https://business.google.com/local/business/3565572879703426860/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1Y0UxcVdsZFhiVGcwWXpCYWJrOVlWWHBhUnpWellVY3hSRmd5WXhBQhAA",[null,null,null,"/local/business/3565572879703426860/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1Y0UxcVdsZFhiVGcwWXpCYWJrOVlWWHBhUnpWellVY3hSRmd5WXhBQhAA"],null,"https://business.google.com/local/business/3565572879703426860/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1Y0UxcVdsZFhiVGcwWXpCYWJrOVlWWHBhUnpWellVY3hSRmd5WXhBQhAA",[null,null,null,"/local/business/3565572879703426860/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1Y0UxcVdsZFhiVGcwWXpCYWJrOVlWWHBhUnpWellVY3hSRmd5WXhBQhAA"]],[null,null,1513,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2w5cE1qWldXbTg0YzBabk9YVXpaRzVzYUcxRFgyYxAB!2m1!1s0x0:0x8b8e991be597067c!3m1!1s2@1:CAIQACodChtycF9oOl9pMjZWWm84c0ZnOXUzZG5saG1DX2c%7C%7C?hl\u0