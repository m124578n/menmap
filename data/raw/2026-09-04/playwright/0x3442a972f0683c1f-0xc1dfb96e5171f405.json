8tSWAxXybPUHHbS7Cw8Q3YcHCKgBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjQkuj38tSWAxXybPUHHbS7Cw8Q3IcHCKcBKAk",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["咖哩飯等候時間非常久。另外，我想要索取番茄醬時，一位穿綠色制服的馬來西亞籍員工卻表示店內沒有番茄醬。但實際上，我看到其他點薯條的客人都有提供番茄醬。\n\n如果番茄醬僅提供給薯條餐點，應該直接告知「番茄醬僅搭配薯條提供，無法搭配其他餐點」，而不是直接說沒有番茄醬，這讓人感覺像是在欺騙顧客。\n\n這次的用餐體驗讓我非常失望，也感到很不愉快。\n\nThe curry rice took an extremely long time to be served. In addition, when I asked for ketchup, a Malaysian staff member wearing a green uniform told me that there was no ketchup available. However, I could clearly see that other customers who ordered French fries were given ketchup.\n\nIf ketchup is only provided with French fries, the staff should have explained that it cannot be served with other menu items, rather than saying there was no ketchup at all. It felt dishonest and misleading.\n\nOverall, I am very disappointed with this dining experience.",null,[0,143]]]],[null,1782110070000000,1782110070000000,"2 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfcmt1QUYyYTV5QlR4MVFUeFRIX0VzUQ%7CCAEQrcz1_gkiMAoZQ0hfcmt1QUYyYTV5QlR4MVFUeFRIX0VzURoTQ2d3STlxN2owUVlRb0kybXdnRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjQkuj38tSWAxXybPUHHbS7Cw8Q_2MIqQEoCg"],"https://business.google.com/local/business/2102257802546192492/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3ZVdFeVdrdGhia3A2WVROS00xTXdZekpYV0doU1pVTXhUMWt4UlJBQhAA",[null,null,null,"/local/business/2102257802546192492/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3ZVdFeVdrdGhia3A2WVROS00xTXdZekpYV0doU1pVTXhUMWt4UlJBQhAA"],"https://business.google.com/local/business/2102257802546192492/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3ZVdFeVdrdGhia3A2WVROS00xTXdZekpYV0doU1pVTXhUMWt4UlJBQhAA",[null,null,null,"/local/business/2102257802546192492/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3ZVdFeVdrdGhia3A2WVROS00xTXdZekpYV0doU1pVTXhUMWt4UlJBQhAA"],null,"https://business.google.com/local/business/2102257802546192492/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3ZVdFeVdrdGhia3A2WVROS00xTXdZekpYV0doU1pVTXhUMWt4UlJBQhAA",[null,null,null,"/local/business/2102257802546192492/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3ZVdFeVdrdGhia3A2WVROS00xTXdZekpYV0doU1pVTXhUMWt4UlJBQhAA"],null,["zh-Hant"],[["非常感謝您告訴我們這一次用餐體驗，我們十分重視您的聲音。\n\n讓您在現場久候餐點且在溝通過程中感到不愉快，真的很抱歉，關於您提到的蕃茄醬服務，確實是我們在內部流程與員工教育上不夠周全。由於每款餐點的標準配置不同，同仁當下可能無完全理解您的需求而沒進一步服務好您，再次抱歉造成您用餐上的困擾。\n\n我們已經針對現場出餐速度以及第一線同仁的溝通說明進行調整，確保未來的服務能更加有溫度，也謝謝您讓我們知道需要改進的地方，我們非常重視每位顧客的感受，若您願意，希望能加上我們負責人的ＬＩＮＥ ：000821(6個數字），我們負責人將會與您後續聯繫服務 。\n\n祝您順心\n太陽蕃茄拉麵團隊 敬上",null,[0,28]]]],[null,null,734,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21weWEyWkthbkp6YTNKM1MwYzJXWGhSZUMxT1kxRRAB!2m1!1s0x0:0xc1dfb96e5171f405!3m1!1s2@1:CAIQACodChtycF9oOmpya2ZKanJza3J3S0c2WXhReC1OY1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21weWEyWkthbkp6YTNKM1MwYzJXWGhSZUMxT1kxRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT21weWEyWkthbkp6YTNKM1MwYzJXWGhSZUMxT1kxRRI-Ci9DQUlRQUNvZENodHljRjlvT21weWEyWkthbkp6YTNKM1MwYzJXWGhSZUMxT1kxRRILMGVDeUFzOW5pLWIaPgovQ0FJUUFDb2RDaHR5Y0Y5b09tcHlhMlpLYW5KemEzSjNTMGMyV1hoUmVDMU9ZMUUSCzBlQ3lBczluaS1iIhIJAAAAAAAAAAARBfRxUW6538EqCzBlQ3lBczluaS1i\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjQkuj38tSWAxXybPUHHbS7Cw8QoykIqgEoCw"],null,[null,[[1,0]]]],"0ahUKEwigie738tSWAxVPeF4EHcbWOUEQ0pMFCE8oBA"],null,null,null,"0ahUKEwjQkuj38tSWAxXybPUHHbS7Cw8Q0pMFCJgBKAQ"],[["Ci9DQUlRQUNvZENodHljRjlvT21jMU5HcHFiRlpMZWxObk5XVlJWQzAxZERZMk9YYxAB",["0x0:0xc1dfb96e5171f405",null,1783877148990896,1783877148990896,[null,null,["https://www.google.com/maps/contrib/116288646333059248515/reviews?hl\u003dzh-TW"],null,null,["ancy N","https://lh3.googleusercontent.com/