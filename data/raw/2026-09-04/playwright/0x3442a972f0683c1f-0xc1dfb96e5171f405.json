,null,null,"0ahUKEwjQkuj38tSWAxXybPUHHbS7Cw8Q3YcHCJYBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjQkuj38tSWAxXybPUHHbS7Cw8Q3IcHCJUBKAg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["在中午的繁忙時段，路經台北車站，被這個青醬拉麵廣告吸引。進店時店員很親切地歡迎我們。這次是我們第一次光顧，店員為我們詳細地介紹餐牌。由於不太肚餓，店員特別推介我們他們的雞白湯和青醬拉麵。\n\n利申我是一個青醬控，當喝下第一啖湯頭的時候，當下的衝擊不枉此生。🤣 我選擇了半麵半菜，剛好適合我不太肚餓的狀態。他們還有豆腐麵的選擇，適合注重健康的人士。\n\n由於天氣相當炎熱，我們已經打開自己的手提風扇，可能由於店員看到我們覺得熱，他就將店內的風扇轉向我們，非常體貼。\n\n用餐期間店員亦會主動地查詢客人有沒有什麼需要，亦會主動問餐點是否滿意。店內的茉莉花茶也很好喝。\n\n總結會再來用餐。",null,[0,93]]]],[null,null,null,null,null,"https://business.google.com/local/business/2102257802546192492/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaZVUxWFpIcE9WMFp0VVZad1MySXlWa1pTVmtaUFpESktUMVJ0WXhBQhAA",[null,null,null,"/local/business/2102257802546192492/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaZVUxWFpIcE9WMFp0VVZad1MySXlWa1pTVmtaUFpESktUMVJ0WXhBQhAA"],"https://business.google.com/local/business/2102257802546192492/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaZVUxWFpIcE9WMFp0VVZad1MySXlWa1pTVmtaUFpESktUMVJ0WXhBQhAA",[null,null,null,"/local/business/2102257802546192492/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaZVUxWFpIcE9WMFp0VVZad1MySXlWa1pTVmtaUFpESktUMVJ0WXhBQhAA"],null,"https://business.google.com/local/business/2102257802546192492/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaZVUxWFpIcE9WMFp0VVZad1MySXlWa1pTVmtaUFpESktUMVJ0WXhBQhAA",[null,null,null,"/local/business/2102257802546192492/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaZVUxWFpIcE9WMFp0VVZad1MySXlWa1pTVmtaUFpESktUMVJ0WXhBQhAA"]],[null,null,485,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pZeU1XZHpOV0ZtUVZwS2IyVkZSVkZPZDJKT1RtYxAB!2m1!1s0x0:0xc1dfb96e5171f405!3m1!1s2@1:CAIQACodChtycF9oOjYyMWdzNWFmQVpKb2VFRVFOd2JOTmc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/conte