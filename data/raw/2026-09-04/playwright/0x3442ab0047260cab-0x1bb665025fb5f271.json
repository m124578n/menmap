",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCHcoEA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3YcHCHooAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCHkoEQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCHsoEg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCHwoEw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCH0oFA",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["（定番）吾流-鹽味雞清湯$300+雞油筍乾$60\n\n吾流 - 塩味鶏清湯ラーメンNT$300\n鶏油メンマNT$60\n\n2025/9/21晚\n\n（歡迎ig搜尋全麵啟動，探索更多拉麵和麵食！）\n\n整體評分（4.3🌟）\n\n🍜【食記】深夜限定！東區隱藏版拉麵食堂「吾流ラーメン」！週末限定！熱湯解宿醉的深夜慰藉！\n\n那天在東區跟朋友聚餐喝酒完，想說都半夜了，有點想吃個宵夜。原本想到的是東區的清粥小菜，走過去時突然想到對欸💡，最近有麵友介紹一間超特別的週末限定深夜食堂「吾流ラーメン」。\n\n這間店不只營業時間特別，還是開在「龍人拉麵」裡面，是個店中店的形式。這種型態的店已經很久沒見到了，加上想喝碗熱湯解宿醉🍻，就果斷鬼轉，前往一探！\n\n⌚️ 排隊狀況／菜單介紹\n\n抵達時間是凌晨1:05，店內只有一位客人，但吃完後店外已經排了三組人了。畢竟老闆是一人作業，所以上菜速度稍慢，但以這時間來說，人氣已經超出預期，可見這間店在拉麵圈中已有名氣。\n\n販售項目：主要拉麵分為兩種類型\n\n1. 鹽味雞清湯 $300\n2. 濃厚雞白湯 $350\n\n另有販售飲料與小菜（雞油筍乾）。\n半夜吃拉麵真的有點罪惡感，但還是想喝點熱湯安慰一下靈魂，這次決定對自己不要太狠，選擇雞清湯起手！\n\n🍲 湯底表現\n\n清雞湯湯頭底蘊乾淨，鹽味的調味拿捏得宜。湯面浮著一層雞油，上桌時就能聞到陣陣香氣，雞湯香在鼻腔中打轉，喝起來溫潤油潤，但完全沒有雜味或腥味，是那種越喝越順的清湯型，毫無負擔感，舒服極了。\n\n🍜 麵條表現\n\n麵條使用細麵，預設熟度偏軟，吸附上層雞油後變得更加滑順好吸。整體表現穩定，是合格的麵條。\n\n👉配料整體評價\n\n蔥絲、手工雞肉餛飩、舒肥叉燒、紫洋蔥、海苔\n\n🐷叉燒\n\n肉質與熟度都不錯，可惜切得偏薄，咬起來比較沒有肉感，對應價格來說，稍嫌不夠滿足。\n\n🥟 雞肉餛飩\n\n造型偏扁平、小巧精緻，與一般常見的餛飩不同，雖然個頭小，但內餡飽滿，咬下去不空虛。但若追求飽足感的話，會覺得稍嫌單薄。\n\n配料整體來說，是這碗拉麵相對弱的一環。\n\n🌶️ 店家特色佐料＆轉味要素\n\n「吾流ラーメン」提供兩種特色調味：\n\n1. 鳳梨醋\n2. 鬼椒粉\n\n這次因為是清湯，就沒有加入鳳梨醋。\n\n至於鬼椒粉，個人大概加了一小勺，差點沒噴火🔥，不只解了酒意，還解了睡意！辣度直接破表，嘴唇像打了豐唇一樣腫脹🔥，比起鬼金棒的鬼增量還辣，非常驚人！\n\n⚠️ 建議初次嘗試者，千萬少量加入，否則整碗湯可能會變成火山爆發般的刺激體驗。可惜這次辣度太猛，最後湯無法喝完。\n\n🍴額外加點：雞油筍乾 $60\n\n這款筍乾不屬於日式調味，也不是常見的塊狀筍乾，比較偏向台式滷筍絲，份量不錯。常溫上桌，口感ok，但因雞油關係和餐點溫度偏低，吃多會偏油膩，稍嫌可惜。但若是搭配拉麵交錯享用，仍屬於值得一試的小品。\n\n🧾 總結：深夜中的一碗溫暖與辣感記憶🔥\n\n這次「吾流ラーメン」的深夜拉麵體驗，口味與人潮都超乎預期，湯頭水準不俗，加上獨特的營業時間與轉味的鬼椒粉，記憶點十足。\n\n雖說價格稍微偏高，但在台北吃宵夜本就會有「宵夜稅」（比喻），以這樣的味道與體驗來說，算是可以接受的範圍。更何況這樣的深夜拉麵體驗，本來就很稀有。\n\n⚠️ 老闆提到目前在龍人拉麵的原址營業只到11/30，之後可能另覓地點開設。想吃的麵友們，記得趁現在趕快衝一波！不然錯過就要再等了！\n\n🕐 店家營業時間（僅週末限定）：\n\n* 週五：1:00 - 3:00\n* 週六/週日：1:00 - 4:30\n\n📍 地點目前位於「龍人拉麵」內，屬店中店型態\n\n#限定拉麵 #定番#台灣#日本#台灣美食#日本美食#foodie#ramen#雙北美食#拉麵\n#2025 #台北拉麵#日本拉麵#台北拉麵推薦\n#日本拉麵推薦#特色拉麵#拉麵推薦#台灣拉麵\n#台灣拉麵推薦#台灣拉麵愛好會\n#台灣拉麵金賞#限定#拉麵控#台灣拉麵地圖\n#台北美食推薦",null,[0,46]]]],[null,null,null,null,null,"https://business.google.com/local/business/14696115413282133076/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZWxOVlpFZFZSMnhGVmtjNWVWVXlXbGhoVlZvMVQxZFNWVlJHUlJBQhAA",[null,null,null,"/local/business/14696115413282133076/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZWxOVlpFZFZSMnhGVmtjNWVWVXlXbGhoVlZvMVQxZFNWVlJHUlJBQhAA"],"https://business.google.com/local/business/14696115413282133076/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZWxOVlpFZFZSMnhGVmtjNWVWVXlXbGhoVlZvMVQxZFNWVlJHUlJBQhAA",[null,null,null,"/local/business/14696115413282133076/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZWxOVlpFZFZSMnhGVmtjNWVWVXlXbGhoVlZvMVQxZFNWVlJHUlJBQhAA"],null,"https://business.google.com/local/business/14696115413282133076/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZWxOVlpFZFZSMnhGVmtjNWVWVXlXbGhoVlZvMVQxZFNWVlJHUlJBQhAA",[null,null,null,"/local/business/14696115413282133076/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZWxOVlpFZFZSMnhGVmtjNWVWVXlXbGhoVlZvMVQxZFNWVlJHUlJBQhAA"]],[null,null,8583,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xFelNVZEdVR2xFVkc5eVUyWlhhVVo1T1dSVVRGRRAB!2m1!1s0x0:0x1bb665025fb5f271!3m1!1s2@1:CAIQACodChtycF9oOlEzSUdGUGlEVG9yU2ZXaUZ5OWRUTFE%7C%7C?hl\u003dzh-TW"],["https: