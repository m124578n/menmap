ostId\u003d!1e10!2sCIABIhBfyIDvDfl094epfrO5X28x\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x1bb665025fb5f271"]],1,null,null,null,null,null,null,["0","1996894545655493233"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pCRFpVVjBURnBNYzNSNlJsVkRXRzAxWlRWUVNGRRAB"]],"CIABIhBfyIDvDfl094epfrO5X28x",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3YcHCE4oAA"]],1],null,null,"訂單類型",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCE0oBQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:OTHER"],"其他",2,null,null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3YcHCFAoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCE8oBg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3YcHCFIoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCFEoBw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCFMoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCFQoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiGy7TM8dSWAxXLhq8BHRQsBlsQ3IcHCFUoCg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這間營業時間很「職人系」，只在深夜開鍋。為了它特地熬夜卡位，00:50 抵達、01:00 準時入座成為第一組，01:20 左右全場坐滿。動線簡單，店內只有七個位子、翻桌靠老闆一人撐全場，建議提早到、或做好慢食的心理準備。\n\n本次前往兩人，各別點了兩種口味\n\n鹽味清雞湯\n底蘊乾淨，清雞湯的鹽味收斂不張揚。尾韻帶一抹近似人蔘的回甘，舌面退味乾淨、無多餘腥與雜苦。屬於耐喝型清湯，越喝越順的那種。\n湯底的部分感覺若搭配上醬油，香料油 也會是一碗很出色的醬油雞湯\n\n濃厚雞白湯\n是走清爽派的白湯，乳化度不暴衝、油水比例保守，口感滑而不糊。若拿來跟重乳化、膠質爆表的型態比，會少一點驚豔，但落點在耐吃不膩。想追求”黏唇級”衝擊的人，可能會覺得保守，喜歡乾淨線條者會覺得剛好，搭配麵體的部分使用的是中卷麵，表現中規中矩。\n\n配料的部分老闆提供了鬼椒粉與藤椒粉。\n鬼椒粉入湯後後勁明顯，辣度不是刺喉那種，而是尾段慢推，把雞湯的甜感拱出來，瞬間切換成另一種風格，好玩。建議1/4匙試試看，再決定是否追加，但藤椒粉相對印象較不明顯。\n\n整體來說\n想喝乾淨線條的雞湯，點鹽味準沒錯，想要白湯的奶滑感但不厚重，這碗濃厚雞白湯會合口，雞油筍乾的部分不推薦，雖然份量很多，但個人沒有很喜歡，溫度不夠熱的情況帶來的油膩感蠻重的，而且口感上比較像是筍絲，沒有筍乾直接來的脆口。全店由老闆一人包辦出餐與清理，節奏自然不快。請體諒單人作業的步調，若是多人同行，建議先決定好加點與客製需求。",null,[0,110]]]],[null,null,null,null,null,"https://business.google.com/local/business/14696115413282133076/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDUkZwVlZqQlVSbkJOWXpOU05sSnNWa1JYUnpBeFdsUldVVk5HUlJBQhAA",[null,null,null,"/local/business/14696115413282133076/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDUkZwVlZqQlVSbkJOWXpOU05sSnNWa1JYUnpBeFdsUldVVk5HUlJBQhAA"],"https://business.google.com/local/business/14696115413282133076/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDUkZwVlZqQlVSbkJOWXpOU05sSnNWa1JYUnpBeFdsUldVVk5HUlJBQhAA",[null,null,null,"/local/business/14696115413282133076/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDUkZwVlZqQlVSbkJOWXpOU05sSnNWa1JYUnpBeFdsUldVVk5HUlJBQhAA"],null,"https://business.google.com/local/business/14696115413282133076/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDUkZwVlZqQlVSbkJOWXpOU05sSnNWa1JYUnpBeFdsUldVVk5HUlJBQhAA",[null,null,null,"/local/business/14696115413282133076/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDUkZwVlZqQlVSbkJOWXpOU05sSnNWa1JYUnpBeFdsUldVVk5HUlJBQhAA"]],[null,null,18412,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pCRFpVVjBURnBNYzNSNlJsVkRXRzAxWlRWUVNGRRAB!2m1!1s0x0:0x1bb665025fb5f271!3m1!1s2@1:CAIQACodChtycF9oOjBDZUV0TFpMc3R6RlVDWG01ZTVQSFE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pCRFpVVjBURnBNYzNSNlJsVkRXRzAxWlRWUVNGRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pCRFpVVjBURnBNYzNSNlJsVkRXRzAxWlRWUVNGRRI-Ci9DQUlRQUNvZENodHljRjlvT2pCRFpVVjBURnBNYzNSNlJsVkRXRzAxWlRWUVNGRRILMGNuWFh