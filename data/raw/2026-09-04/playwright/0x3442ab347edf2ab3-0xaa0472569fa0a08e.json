間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi4k8Xw8dSWAxW1lK8BHamqBnwQ3YcHCFcoAA"]],1],null,null,"等待時間",null,"0ahUKEwi4k8Xw8dSWAxW1lK8BHamqBnwQ3IcHCFYoCA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["店面明亮，看起來還算乾淨。但室內大台工業電扇一直吹，聲音很大，也顯得冷氣不足。\n\n這次點了柚香雞白湯拉麵，湯頭吃起來只有吃到檸檬味，感覺不出柚香。麵體也有點太軟，整體偏台式，如果期待吃到日式拉麵而來訪的話會失望。可加麵，但口味實在吃不太下去，沒有想加的慾望。\n\n內用有提供飲料機和霜淇淋，但飲料機感覺有混味，濃縮還原感也很明顯。\n\n可行動支付\n\n整體來說不會想再訪",null,[0,39]]]],[null,null,null,null,null,"https://business.google.com/local/business/9899592516577488693/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3TkZwSVRqUk5WM2h1WkVSc2MwNUdRa05sYlVaU1kyeFNWRnBXUlJBQhAA",[null,null,null,"/local/business/9899592516577488693/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3TkZwSVRqUk5WM2h1WkVSc2MwNUdRa05sYlVaU1kyeFNWRnBXUlJBQhAA"],"https://business.google.com/local/business/9899592516577488693/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3TkZwSVRqUk5WM2h1WkVSc2MwNUdRa05sYlVaU1kyeFNWRnBXUlJBQhAA",[null,null,null,"/local/business/9899592516577488693/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3TkZwSVRqUk5WM2h1WkVSc2MwNUdRa05sYlVaU1kyeFNWRnBXUlJBQhAA"],null,"https://business.google.com/local/business/9899592516577488693/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3TkZwSVRqUk5WM2h1WkVSc2MwNUdRa05sYlVaU1kyeFNWRnBXUlJBQhAA",[null,null,null,"/local/business/9899592516577488693/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3TkZwSVRqUk5WM2h1WkVSc2MwNUdRa05sYlVaU1kyeFNWRnBXUlJBQhAA"]],[null,null,1877,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2kwNFpITjRNV3huZERsc05GQkNlbUZSY2xSVFpWRRAB!2m1!1s0x0:0xaa0472569fa0a08e!3m1!1s2@1:CAIQACodChtycF9oOi04ZHN4MWxndDlsNFBCemFRclRTZVE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2kwNFpIT