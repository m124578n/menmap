OJ8dSWAxX-dvUHHdkSK4oQ3IcHCMwCKBA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjfpbOJ8dSWAxX-dvUHHdkSK4oQ3IcHCM4CKBE",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjfpbOJ8dSWAxX-dvUHHdkSK4oQ3IcHCM8CKBI",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjfpbOJ8dSWAxX-dvUHHdkSK4oQ3IcHCNACKBM",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["點了味自慢雙人套餐，整體用餐體驗蠻不錯，份量和搭配都算完整。\n\n拉麵選了燒豚棒腿拉麵 和 炙燒雞豚拉麵。\n\n湯頭走濃厚系路線，豬骨香氣很明顯，但不會過鹹。\n\n麵條有彈性，能很好吸附湯汁。\n\n燒豚棒腿的肉質軟嫩、油脂香氣足，炙燒雞豚則多了一點炙燒的香氣，兩碗風味各有特色。\n\n套餐的小菜也有加分，翠玉芥末章魚口感清爽，微嗆的芥末味很開胃；胡麻龍鬚菜則是偏清爽路線，搭配濃厚拉麵剛好平衡味道。\n\n飲料搭配清香烏龍，吃完重口味拉麵後喝起來很解膩。",null,[0,52]]]],[],[null,null,758,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21OdVJqbGhkemczYmxsemVXWmFXV05OV0RoNldFRRAB!2m1!1s0x0:0x9122c0fa750e79ea!3m1!1s2@1:CAIQACodChtycF9oOmNuRjlhdzg3bllzeWZaWWNNWDh6WEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21OdVJqbGhkemczYmxsemVXWmFXV05OV0RoNldFRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT21OdVJqbGhkemczYmxsemVXWmFXV05OV0RoNldFRRI-Ci9DQUlRQUNvZENodHljRjlvT21OdVJqbGhkemczYmxsemVXWmFXV05OV0RoNldFRRILMGRlaWhuRG4xWE8aPgovQ0FJUUFDb2RDaHR5Y0Y5b09tTnVSamxoZHpnM2JsbHplV1phV1dOTldEaDZXRUUSCzBkZWlobkRuMVhPIhIJAAAAAAAAAAAR6nkOdfrAIpEqCzBkZWlobkRuMVhP\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjfpbOJ8dSWAxX-dvUHHdkSK4oQoykI0QIoFA"],null,[null,[[1,0]]]],"0ahUKEwiB0buJ8dSWAxVn9hYFHeryANUQ0pMFCOEBKAY"],null,null,null,"0ahUKEwjfpbOJ8dSWAxX-dvUHHdkSK4oQ0pMFCKwCKAY"],[["Ci9DQUlRQUNvZENodHljRjlvT2psdGJXMURNV1ZMVUZwTGIzbHZWM0EzUm5CdFZVRRAB",["0x0:0x9122c0fa750e79ea",null,1762660821392317,1762660821392317,[null,null,["https://www.google.com/maps/contrib/118379341785629502548/reviews?hl\u003dzh-TW"],null,null,["芋頭仔","https:/