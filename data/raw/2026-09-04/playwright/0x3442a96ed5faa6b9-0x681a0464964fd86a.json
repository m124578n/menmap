[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3YcHCFUoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3IcHCFQoBQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3IcHCFYoBg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3IcHCFcoBw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3IcHCFgoCA",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3YcHCFooAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3YcHCFsoAQ"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3YcHCFwoAg"]]],null,"用餐人數",null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3IcHCFkoCQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3YcHCF4oAA"]],1],null,null,"等待時間",null,"0ahUKEwjVxrXi8tSWAxWYbPUHHTOUMl0Q3IcHCF0oCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["如果你是老饕，【屯京】算是台灣拉麵熱潮的時代眼淚，也是少數歷經十多年競爭，依然還活得優雅的日本拉麵品牌。\n\n屯京的豚骨拉麵，品質穩定！無論你十年前來吃，還是今天來吃，那碗熟悉的豚骨醬油湯頭幾乎沒有太大變化。湯頭以豚骨為基底，加入醬油提味，濃郁卻不至於厚重到讓人有負擔。最大的特色在於帶有明顯魚介香氣，入口先是豚骨的油脂與醬油鹹香，尾韻則有柴魚與魚乾堆疊出的鮮味，層次比一般豚骨拉麵更豐富一些。\n\n近年台北陸續出現許多來自東京一線名店的品牌，無論湯頭細節、食材講究或風味創新，都把拉麵競爭拉到另一個層級。今天再吃屯京，你未必會感到驚艷，畢竟，味蕾嚐過驚艷就回不去了！",null,[0,52]]]],[],[null,null,3110,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25oMU5WTXRaVTlHWjNNdGRsVmZVbWRzT1ZWWFRHYxAB!2m1!1s0x0:0x681a0464964fd86a!3m1!1s2@1:CAIQACodChtycF9oOnh1NVMtZU9GZ3MtdlVfUmdsOVVXTGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/c