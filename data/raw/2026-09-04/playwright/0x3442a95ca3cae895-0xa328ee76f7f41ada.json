ll,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiS2YqO89SWAxVOe_UHHQIqBoAQ3IcHCPcCKBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiS2YqO89SWAxVOe_UHHQIqBoAQ3IcHCPgCKBU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiS2YqO89SWAxVOe_UHHQIqBoAQ3IcHCPkCKBY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[null,[1]],null,"建議的餐點",null,"0ahUKEwiS2YqO89SWAxVOe_UHHQIqBoAQ3IcHCPoCKBc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["2025/3/15\n限定！五郎的鶏豚高湯塩味拉麺 290$\n\"さんせりて(sanserite)\"\n很純粹的一碗鶏豚塩味拉麺\n\n註:\"さんせりて\"是取自\"孤獨的美食家\"劇中拉麵店的店名\n是法文的\"Sincerite\"誠実,真摯之意\n------------------\n2024/10/14\n芳醇鶏湯塩味拉麺\"飛鳥(asuka) 280$\n配料有:溏心蛋、3塊雞叉燒、玉米筍、豆條、馬鈴薯泥\n炙燒雞肉依舊頂中鼎，馬鈴薯泥超好吃，整體相當搭\n------------------\n2024/4/14\n微濃桃子鶏白湯塩味拉麺\"望春(miharu)\"  280$\n這次搭配著三種蜜桃，搭配著雞白湯相當順口\n------------------\n2024/2/4\n魷魚螺肉蒜鶏湯醤油拉麺\"蓬莱(horai)\" 350$\n去年也是回高雄前吃的最後一碗拉麵\n依舊好吃！\n------------------\n2024/1/28\n炙焼大腸頭味噌拉麺\"大雪(taisetsu)\"  310$\n第一次吃悠然的味增湯頭  相當濃郁不死鹹\n味增的味道也相當足，炙燒叉燒跟大腸口感香又有嚼勁!\n------------------\n2023/9/7\n蕈菇醤油鶏湯拉麺\"雨読(udoku)\"  270$\n很菇味的一碗，炙燒雞肉的上面還有松露⋆⸜(* ॑꒳ ॑* )⸝\n------------------\n2022/12/30\n蝦魚貝鶏清湯塩味拉麺 \"網走(abashiri)\"( つ•̀ω•́)つ\n今年老闆用的是鳥取縣產松葉蟹鉗\n因為有尺寸落差，所以多使用了大一號的蝦子\n跟大兩號的北寄貝，烤得很香\n海鮮跟湯頭相當搭，不會有互相搶味的情況",null,[0,48]]]],[],[null,null,41243,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUNCeGJpenF3RRAB!2m1!1s0x0:0xa328ee76f7f41ada!3m1!1s2@1:CIHM0ogKEICAgICBxbizqwE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUNCeGJpenF3RRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUNCeGJpenF3RRIsChZDSUhNMG9nS0VJQ0FnSUNCeGJpemF3EhJDZ3NJaFlMV3ZnWVFpUC1HRUEaLQoXQ0lITTBvZ0tFSUNBZ0lDQnhiaXo2d0USEkNnc0k0X3E3blFZUWtMSHFUdyISCQAAAAAAAAAAEdoa9Pd27iijKgswYnIwRURfQWFRaw\u