null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2023,5,21,12,null,null,null,null,["3 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICxubbDOg\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xa328ee76f7f41ada"]],1,null,null,null,null,null,null,["0","-6689835051725350182"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSURpMk1HVFlnEAE"]],"CIHM0ogKEICAgICxubbDOg",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiS2YqO89SWAxVOe_UHHQIqBoAQ3IcHCLgCKBU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiS2YqO89SWAxVOe_UHHQIqBoAQ3IcHCLkCKBY",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiS2YqO89SWAxVOe_UHHQIqBoAQ3IcHCLoCKBc",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["臺北拉麵的淡麗之王，我會這樣稱呼悠然。\n法式的擺盤，豐富的佐料，\n不管是鹽味還是醬油，或者是濃湯的作法，\n悠然都把湯做成能全部喝完的地步，\n因為喝起來一點也不負擔，\n店家很會用香味油，芳香甘醇，\n是會一再回訪的好味道！\n悠然每次只提供一種拉麵，\n隨著季節更迭提供不同的菜單，\n專心呈現勾人的美味。\n麵體一般為細麵，有齒切感。\n雞叉燒和雞腿叉燒不柴十分多汁，\n但有時候炙燒過頭會比較苦一些。\n店內空間十分狹窄，店員也只有老闆一人，\n進店後常常需要十多分的等待，\n但很值得，因為別家真的吃不到！\n如果吃太多油膩的拉麵，\n想見見精緻的拉麵的話，\n可以考慮看看這間。",null,[0,52]]]],[],[null,null,24544,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSURpMk1HVFlnEAE!2m1!1s0x0:0xa328ee76f7f41ada!3m1!1s2@1:CIHM0ogKEICAgIDi2MGTYg%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSURpMk1HVFlnEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSURpMk1HVFlnEi4KF0NJSE0wb2dLRUlDQWdJRGkyTUdUNGdFEhNDZ3dJOWFuel9RVVFpTmJUNXdFGi0KFkNJSE0wb2dLRUlDQWdJRGkyTUdURWcSE0Nnd0k5YW56X1FVUWlOYlQ1d0UiEgkAAAAAAAAAABHaGvT3du4ooyoLMFpQVm5JRlJUT1Y\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiS2YqO89SWAxVOe_UHHQIqBoAQoykIuwIoGA"],null,[null,[[1,13]]]],"0ahUKEwiDnZCO89SWAxXBkM