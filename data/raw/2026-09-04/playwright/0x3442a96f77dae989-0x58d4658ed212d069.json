料理？",null,[[[["M:/g/11n7bm9rw1"],"喜多方拉麵",2,null,null,"0ahUKEwjW_JyC89SWAxW6dvUHHebTGVUQ3YcHCIYBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwjW_JyC89SWAxW6dvUHHebTGVUQ3IcHCIUBKAg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:NOT_SURE"],"不確定",2,null,null,"0ahUKEwjW_JyC89SWAxW6dvUHHebTGVUQ3YcHCIgBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwjW_JyC89SWAxW6dvUHHebTGVUQ3IcHCIcBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_DIFFICULT_TO_FIND"],"停車不方便",2,null,null,"0ahUKEwjW_JyC89SWAxW6dvUHHebTGVUQ3YcHCIoBKAA"]],1],null,null,"停車位",null,"0ahUKEwjW_JyC89SWAxW6dvUHHebTGVUQ3IcHCIkBKAo",null,null,null,null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwjW_JyC89SWAxW6dvUHHebTGVUQ3YcHCIwBKAA"]]],null,null,null,"0ahUKEwjW_JyC89SWAxW6dvUHHebTGVUQ3IcHCIsBKAs",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["首次造訪，一直很想體驗何謂道地的傳統拉麵，藉北上的機會前來這家連日本人都推崇的拉麵店。點了招牌喜多方拉麵以及煎餃子，不同於現今拉麵店普遍標榜濃郁湯頭的趨勢，極其清澈的醬油湯頭卻有著豐富香氣，而自製的麵條口感也恰到好處，終於了解為何能吸引這麼多日本熟客，也似乎知道了網路評價為何如此兩極化。大部份的負評不外乎口味單調，CP值低或是服務態度不佳，平心而論，確實沒有熱情的招呼，但也不至於到態度不佳的程度，而以用餐環境來說也確實不是多麼舒適優雅，但瑕不掩瑜，今天是為了這碗拉麵而來，可以確定的是闆娘對拉麵的堅持，其他的於我而言都是其次。",null,[0,265]]]],[null,1774710371000000,1774710371000000,"5 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfMWttRFZjb3VZbVBSUnlEMG1PZ29LZw%7CCAEQrcz1_gkiLwoZQ0hfMWttRFZjb3VZbVBSUnlEMG1PZ29LZxoSQ2dzSTQ5eWZ6Z1lRNFlHTUJR\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjW_JyC89SWAxW6dvUHHebTGVUQ_2MIjQEoDA"],"https://business.google.com/local/business/7627039855374374563/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvYzJKcE1YcFphbEpLV21wV2IyVlhWWGxSYmxwV1kzcG9VMU5GUlJBQhAA",[null,null,null,"/local/business/7627039855374374563/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvYzJKcE1YcFphbEpLV21wV2IyVlhWWGxSYmxwV1kzcG9V