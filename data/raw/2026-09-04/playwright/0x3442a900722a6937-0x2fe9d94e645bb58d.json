ull,"餐點",null,"0ahUKEwihvrng8dSWAxWTdvUHHX7cCX0Q3IcHCFgoCg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwihvrng8dSWAxWTdvUHHX7cCX0Q3IcHCFkoCw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwihvrng8dSWAxWTdvUHHX7cCX0Q3IcHCFooDA",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["26/02/09 平日午餐時段\n最近開的日本名店，開門前就大排長龍\n在小巷子內車道旁，不太方便排隊\n要先找店員掃QR領號碼牌叫號入座\n\n魚雞連打\n特製真鯛濃湯拉麵 $388\n濃郁魚湯底，配小松菜葉片部分\n味道確實名副其實\n但有魚骨渣。。。\n主打日本名店，這樣呈現方式，令人無法接受\n(我知道有警語，但你去壽司店也不會吃到100%有刺的生魚片壽司吧？我就不相信日本本店敢讓客人每碗都吃到)\n\n特製鴨湯中華拉麵 $346\n鴨湯，鹹口配小松菜柄部分(兩邊剛好各取一半嗎XD)\n比預想的略鹹\n\n可免費加麵..半球\n\n裝潢部分\n以牆一分為二成兩家(同一台售票機)\n魚這邊較窄(疑惑的點又來了，重口味不是應該更寬敞嗎？)，不適合胖子。\n店員非日本人，各穿著雞/魚圖案，但好像不會只待一邊。\n現在回顧才發現當日門口菜單價格是錯的...\n要打日本招牌沒問題，但相對品質跟服務請跟上，謝謝。",null,[0,49]]]],[null,null,null,null,null,"https://business.google.com/local/business/10612618611643667663/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvVG1WdFVtNWlNVm8yVm10YVVtUnRiRTVZTUd4UFRYcENabEpHUlJBQhAA",[null,null,null,"/local/business/10612618611643667663/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvVG1WdFVtNWlNVm8yVm10YVVtUnRiRTVZTUd4UFRYcENabEpHUlJBQhAA"],"https://business.google.com/local/business/10612618611643667663/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvVG1WdFVtNWlNVm8yVm10YVVtUnRiRTVZTUd4UFRYcENabEpHUlJBQhAA",[null,null,null,"/local/business/10612618611643667663/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvVG1WdFVtNWlNVm8yVm10YVVtUnRiRTVZTUd4UFRYcENabEpHUlJBQhAA"],null,"https://business.google.com/local/business/10612618611643667663/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvVG1WdFVtNWlNVm8yVm10YVVtUnRiRTVZTUd4UFRYcENabEpHUlJBQhAA",[null,null,null,"/local/business/10612618611643667663/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvVG1WdFVtNWlNVm8yVm1