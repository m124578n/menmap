,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2tSTWVuTnpZMmRxWjJwMFUwczRjVGcxTkU4emVsRRAB"]],"CIABIhAh9ti57fbVIP4wnPbSgctw",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjP3uWk8dSWAxXEZvUHHT8bInQQ3YcHCFooAA"]],1],null,null,"餐點類型",null,"0ahUKEwjP3uWk8dSWAxXEZvUHHT8bInQQ3IcHCFkoCA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjP3uWk8dSWAxXEZvUHHT8bInQQ3IcHCFsoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjP3uWk8dSWAxXEZvUHHT8bInQQ3IcHCFwoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjP3uWk8dSWAxXEZvUHHT8bInQQ3IcHCF0oCw",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["住附近很久很久了，才第一次來吃。首先是形象，之前店在南京東路對面巷口時，以及九湯屋品牌的感受都是很名符其實的平價拉麵，所以對品質是不會抱有什麼想像的餘地，就是純粹吃價錢而已。\n\n但今天來吃了，其實改觀很多，首先店家氛圍感很努力營造了，美感雖然有限，誠意絕對十足！開在傳統市場裡的小店，也更新到自動點單結帳機，完全不輸。提供多款飲料免費暢飲，但我目前不適沒得喝喝，就不多說了，但至少老闆也誠意地備著了。\n\n麵點味道和湯頭我真的挺喜歡，絕對在水準線上，環境和座位數也很夠好夠多，以後應該會常來了，不只因為便宜，它還有很多的口味很想再吃看看！",null,[0,87]]]],[null,null,null,null,null,"https://business.google.com/local/business/17681005765356883950/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTVFdWdVRucFpNbVJ4V2pKd01GVXdjelJqVkdjeFRrVTRlbVZzUlJBQhAA",[null,null,null,"/local/business/17681005765356883950/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTVFdWdVRucFpNbVJ4V2pKd01GVXdjelJqVkdjeFRrVTRlbVZzUlJBQhAA"],"https://business.google.com/local/business/17681005765356883950/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTVFdWdVRucFpNbVJ4V2pKd01GVXdjelJqVkdjeFRrVTRlbVZzUlJBQhAA",[null,null,null,"/local/business/17681005765356883950/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTVFdWdVRucFpNbVJ4V2pKd01GVXdjelJqVkdjeFRrVTRlbVZzUlJBQhAA"],null,"https://business.google.com/loc