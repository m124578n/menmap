8tSWAxU2kq8BHd9JE2QQ3IcHCGsoEA",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:RESERVATIONS_NOT_REQUIRED"],"不需要訂位",2,null,null,"0ahUKEwiS2t-28tSWAxU2kq8BHd9JE2QQ3YcHCG0oAA"]],1],null,null,"預訂網址",null,"0ahUKEwiS2t-28tSWAxU2kq8BHd9JE2QQ3IcHCGwoEQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwiS2t-28tSWAxU2kq8BHd9JE2QQ3YcHCG8oAA"]],1],null,null,"等待時間",null,"0ahUKEwiS2t-28tSWAxU2kq8BHd9JE2QQ3IcHCG4oEg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwiS2t-28tSWAxU2kq8BHd9JE2QQ3YcHCHEoAA"]]],null,"座位類型",null,"0ahUKEwiS2t-28tSWAxU2kq8BHd9JE2QQ3IcHCHAoEw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["一風堂 中山本店\n給三顆星，算是有點可惜的那種。其實這間我不只來吃一次了，餐點本身一直都蠻穩定的，拉麵好吃、口味也有水準，價格以現在來說也不算貴，想吃日式拉麵還是會想到這間。\n\n但問題主要真的出在服務跟現場狀況。每次來幾乎都要等，而且不是因為客滿，是現場人手不足，明明還有空位，但桌子沒人收，就是卡在那邊等，會讓人有點無言。\n\n這次更誇張，入座後桌上連筷子都沒有，結果有員工直接用「丟」的方式把筷子丟進筷子桶，觀感真的不太好，會讓人感覺服務有點隨便。\n\n整體來說，東西是好吃的沒問題，但服務品質真的需要加強，不然會影響整體用餐體驗。變成那種「想吃可以來，但要有心理準備」的店。",null,[0,87]]]],[null,1777001806000000,1777001806000000,"4 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfNnVoVWZiN2JhQlNNUzRyaEFEaU16dw%7CCAEQrcz1_gkiMAoZQ0hfNnVoVWZiN2JhQlNNUzRyaEFEaU16dxoTQ2d3SXpzcXJ6d1lRd3NqdnV3SQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiS2t-28tSWAxU2kq8BHd9JE2QQ_2MIcigU"],"https://business.google.com/local/business/14193162937581622681/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzY1ZkWE9UUlRlVEZxVmtoVmRHVnROWEpXTVZaM1YxVk9ibFZ1WXhBQhAA",[null,null,null,"/local/business/14193162937581622681/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzY1ZkWE9UUlRlVEZxVmtoVmRHVnROWEpXTVZaM1YxVk9ibFZ1WXhBQhAA"],"https://business.google.com/local/business/14193162937581622681/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzY1ZkWE9UUlRlVEZxVmtoVmRHVnROWEpXTVZaM1YxVk9ibFZ1WXhBQhAA",[null,null,null,"/local/business/14193162937581622681/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzY1ZkWE9UUlRlVEZxVmtoVmRHVnROWEpXTVZaM1YxVk9ibFZ1WXhBQhAA"],null,"https://business.google.com/local/business/14193162937581622681/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzY1ZkWE9UUlRlVEZxVmtoVmRHVnROWEpXTVZaM1YxVk9ibFZ1WXhBQhAA",[null,null,null,"/local/business/14193162937581622681/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzY1ZkWE9UUlRlVEZxVmtoVmRHVnROWEpXTVZaM1YxVk9ibFZ1WXhBQhAA"],null,["zh-Hant"],[["親愛的顧客您好，\n感謝您蒞臨一風堂中山店，也很開心收到您對我們餐點的喜愛與好評。\n針對您提及因人力不足而影響服務品質的情形，我們相當重視。即使在現場人力較為吃緊的狀況下，仍應維持應有的服務水準。當日於提供餐具時未妥善擺放，確實為不應發生的情況，我們深感抱歉。\n正如您所提，即使顧客喜愛我們的餐點，若服務細節未能到位，仍可能影響整體用餐感受，這也是我們最不樂見的部分。\n感謝您提供寶貴且具體的回饋，我們將持續加強夥伴的教育訓練，並妥善進行人力安排，期許在提供美味的餐點時也能同時給予顧客最舒適的用餐體驗。\n祝日安\n台灣一風堂敬上 J",null,[0,40]]]],[null,null,1001,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pscVdXOTRTeTFqVkhVdGVtNXJWMVZ3V1VOblVuYxAB!2m1!1s0x0:0x4e536d4a45a0cbf!3m1!1s2@1:CAIQACodChtycF9oOjlqWW94Sy1jVHUtem5rV1VwWUNnUnc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pscVdXOTRTeTFqVkhVdGVtNXJWMVZ3V1VOblVuYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pscVdXOTRTeTFqVkhVdGVtNXJWMVZ3V1VOblVuYxI-Ci9DQUlRQUNvZENodHljRjlvT2pscVdXOTRTeTFqVkhVdGVtNXJWMVZ3V1VOblVuYxILMGRzVHhKUktDSlEaPgovQ0FJUUFDb2RDaHR5Y0Y5b09qbHFXVzk0U3kxalZIVXRlbTVyVjFWd1dVTm5VbmMSCzBkc1R4SlJLQ0pRIhIJAAAAAAAAAAARvwxapNQ25QQqCzBkc1R4SlJLQ0pR\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiS2t-28tSWAxU2kq8BHd9JE2QQoykIcygV"],null,[null,[[1,0]]]],"0ahUKEwjJmee28tSWAxUOkMAFHXnEEBIQ0pMFCAIoAA"],null,null,null,"0ahUKEwiS2t-28tSWAxU2kq8BHd9JE2QQ0pMFCE0oAA"],[["Ci9DQUlRQUNvZENodHljRjlvT2pOU2RGVnVYMHhzVjFVM2J6bGthMkZpV