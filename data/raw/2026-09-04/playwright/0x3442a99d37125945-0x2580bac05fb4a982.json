,null,null,null,["麵屋饗"]],[null,[[["Chunkai Huáng"],"https://www.google.com/maps/contrib/109997121560497861265?hl\u003dzh-TW","https://lh3.googleusercontent.com/a/ACg8ocJbONCeEEVBg2f-FrSkBmCebWD31DiHqUdHfMf9IG3OXq98eQ\u003ds120-c-rp-mo-ba12-br100",null,null,"109997121560497861265"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,3,22,5,null,null,null,null,["5 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDckDtyA62wWcSuj0GuglkR\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x2580bac05fb4a982"]],1,null,null,null,null,null,null,["0","2702365111824460162"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xkMGFHTnVlR2Q0YlZSWmFtcFFZV1pEYjNKMWVHYxAB"]],"CIABIhDckDtyA62wWcSuj0GuglkR",1]],null,null,null,[[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjPla328dSWAxXpm68BHYdKOhsQ3YcHCLIBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjPla328dSWAxXpm68BHYdKOhsQ3IcHCLEBKA8",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjPla328dSWAxXpm68BHYdKOhsQ3IcHCLMBKBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjPla328dSWAxXpm68BHYdKOhsQ3IcHCLQBKBE",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjPla328dSWAxXpm68BHYdKOhsQ3IcHCLUBKBI",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["隱身在裕民街夜市的小巷內，如果沒有刻意找的話還真的挺容易錯過的\n\n點餐使用點餐機，也可以選擇外帶，僅有現金付款，店內空間相較於一般拉麵店顯得相當寬敞，用餐環境相對舒適許多。\n\n因為沒有很餓，原本只想要體驗看看醬油或鹽味等比較簡單的選項，但最後還是敗給了限定的誘惑，選了限定的蝦蝦雞白湯（260元）。\n\n客製化選項還不少，個人選了高鹹度中捲麵麵硬。基本配置有海苔片、雞叉燒四片、溏心蛋一顆、兩尾甜蝦（菜單上是寫白蝦一尾）、青菜、青蔥、紫洋蔥、炸金針菇、半顆金桔。可以另外免費加麵。\n\n湯頭的部分，是超級濃郁的蝦味直拳，鹹度確實偏高，但卻不會咬舌；\n白蝦不知道為什麼變成了甜蝦，但甜蝦也好吃😋；\n青菜使用的是類似白菜類的種類，在日式拉麵中相當少見，使用清燙的方式燙熟後直接放入，可以很有效地暫時解決油膩感，這個做法還算挺有趣的；在解決味覺疲勞的部分，那半顆金桔也很棒，個人對於濃湯系的拉麵耐受度不高，往往吃到中後段就會開始膩，但金桔的酸味真的可以很有效降低這個問題；\n雞叉燒給得相當厚，份量很夠，只有簡單的調味，卻跟湯頭搭得很好；店家說我是今天第一個入座的客人，多送了兩片豬叉燒給我，豬叉燒目測油脂偏少，一樣切得很厚，但果不期然口感略偏柴，在油脂跟口感上真的很難抉擇，如果是想好好吃碗麵的肉食主義，又不希望吃得太油倒是很適合；兩種叉燒都有炙燒過，有淡淡的炙燒香氣。\n溏心蛋是個人覺得比較表現不佳的部分，不得不說蛋黃的熟度處理得相當好，但調味卻有點不足，導致入口時跟湯頭搭不起來，有突兀的感覺。\n\n整體來說以這碗拉麵的配置，價位是屬於親民等級的，店家在有空閒之餘還會多關心口味與鹹度，問我需不需要臨時調整，真的很有心。店家應該走的是社區小店路線，緊跟在我後面入店的是兩組帶小孩的家庭客，看起來是相當親子友善，甚至有提供兒童拉麵的選項。但真的不喜歡小小孩的人大概就要避開熱門用餐時段了。\n以CP值而言是真的很高，口味也沒有因為價格而隨便帶過，值得推薦，未來應該還會回訪嘗試其他口味的拉麵！",null,[0,86]]]],[null,null,null,null,null,"https://business.google.com/local/business/16389312805764677101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTUdGSFRuVmxSMlEwWWxaU1dtRnRjRkZaVjFwRVlqTktNV1ZIWXhBQhAA",[null,null,null,"/local/business/16389312805764677101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTUdGSFRuVmxSMlEwWWxaU1dtRnRjRkZaVjFwRVlqTktNV1ZIWXhBQhAA"],"https://business.google.com/local/business/16389312805764677101/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTUdGSFRuVmxSMlEwWWxaU1dtRnRjRkZaVjFwRVlqTktNV1ZIWXhBQhAA",[null,null,null,"/local/business/16389312805764677101/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTUdGSFRuVmxSMlEwWWxaU1dtRnRjRkZaVjFwRVlqTktNV1ZIWXhBQhAA"],null,"https://business.google.com/local/business/16389312805764677101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTUdGSFRuVmxSMlEwWWxaU1dtRnRjRkZaVjFwRVlqTktNV1ZIWXhBQhAA",[null,null,null,"/local/business/16389312805764677101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrTUdGSFRuVmxSMlEwWWxaU1dtRnRjRkZaVjFwRVlqTktNV1ZIWXhBQhAA"]],[null,null,4608,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xkMGFHTnVlR2Q0YlZSWmFtcFFZV1pEYjNKMWVHYxAB!2m1!1s0x0:0x2580bac05fb4a982!3m1!1s2@1:CAIQACodChtycF9oOld0aGNueGd4bVRZampQYWZDb3J1eGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRj