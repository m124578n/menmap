],"2 人",2,null,null,"0ahUKEwjPla328dSWAxXpm68BHYdKOhsQ3YcHCJEBKAE"]]],null,"用餐人數",null,"0ahUKEwjPla328dSWAxXpm68BHYdKOhsQ3IcHCI8BKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["【消費項目】\n①鹽味雞清湯拉麵-雞叉燒給很多塊也很好吃，溏心蛋意外美味\n②醬油豚白湯拉麵-豬叉燒炙燒得恰到好處，雞叉燒軟嫩好咀嚼，溏心蛋不馬虎，海苔很大片，湯頭濃郁會讓人想一口接著一口，是下次會想再吃的品項\n【服務態度】店員態度友善，從入內就親切的詢問客人用餐方式，沒有因為使用點餐機就忽略客人，用餐時也很適時地詢問餐點滿意度及是否需加麵，用餐完畢也會詢問是否有吃飽，整體感受非常棒\n【環境氣氛】\n①吧台式座位，位置不多大約有十個位置，環境乾淨，一個人入店內用也不會覺得尷尬\n②從很多地方可以看出店家很用心經營，雖座位位子不大，但另提供置物籃，座位上附髮圈、酒精，客人用餐舒適度大大提升，附設飲水機及提供茶包也很加分，品嘗完濃郁的湯頭來一杯水或茶恰到好處\n③內用當天冷氣開放，但冷氣稍微不夠冷，不僅坐在靠近門口的我們吃的汗流浹背，一旁用餐的客人也看得出來有熱到的感覺，針對這部分其實也有注意到店家有放風扇，只是涼意的感覺還是有點落差，若這部分可以改善就完美了\n【其他】位於裕民街巷弄內，餐廳使用自動點餐機點餐，僅提供現金支付\n《總結》餐點可依自身喜好調整麵條軟硬度、湯頭濃郁度及配料等，雖一份要兩百多塊但用餐後覺得整體CP值很高，餐點、服務及環境衛生都有在水準之上，是一間我會願意回訪的餐廳！",null,[0,103]]]],[null,null,null,null,null,"https://business.google.com/local/business/16389312805764677101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRPU1dOVVFrWmpNM0F5VGxab2NrOUhWbXRVUjA1Q1ZsVndiV1ZIWXhBQhAA",[null,null,null,"/local/business/16389312805764677101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRPU1dOVVFrWmpNM0F5VGxab2NrOUhWbXRVUjA1Q1ZsVndiV1ZIWXhBQhAA"],"https://business.google.com/local/business/16389312805764677101/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRPU1dOVVFrWmpNM0F5VGxab2NrOUhWbXRVUjA1Q1ZsVndiV1ZIWXhBQhAA",[null,null,null,"/local/business/16389312805764677101/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRPU1dOVVFrWmpNM0F5VGxab2NrOUhWbXRVUjA1Q1ZsVndiV1ZIWXhBQhAA"],null,"https://business.google.com/local/business/16389312805764677101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRPU1dOVVFrWmpNM0F5VGxab2NrOUhWbXRVUjA1Q1ZsVndiV1ZIWXhBQhAA",[null,null,null,"/local/business/16389312805764677101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRPU1dOVVFrWmpNM0F5VGxab2NrOUhWbXRVUjA1Q1ZsVndiV1ZIWXhBQhAA"]],[null,null,760,["https://www.