成功打入台灣市場，因此蔡桑將拉麵湯頭及叉燒熬製技術傳承給林桂蘭女士。\n林桂蘭女士本是一位熱衷於美食料理的饌研者，在不影響原本日式風味的前題下，用所學技術將日式拉麵改良成較適合台灣民眾的口味，成功的讓愛好拉麵的饕客讚賞與肯定，並擁有了越來越多愛好者。\n一直以來，老闆娘秉持著健康、養生的原則，堅持做好吃的拉麵給顧客，讓每一位顧客喝到熱騰騰的豚骨湯頭，帶著如此的理想及目標，將日本的拉麵分享給所有愛好拉麵的消費者。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-9PqoHLG6syA/AAAAAAAAAAI/AAAAAAAAAAA/51-lfhzJeLk/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"新北市淡水區民生里",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwi-4e3Y8NSWAxU2e_UHHe7OFAcQhbADCMICKAA","全部",[["CIHM0ogKEICAgICuy63cmgE",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWlvH8IANTtu2iHG2k7KRrSr2QJp0Js3XlG-dyTgf6NRSRE8EqJeAh7sZZ_QDnVy8Yo-2v4jkvUZ8TjHuvHl3KCbIT5BVY8gDP5iYSPnC5Ou7_2oaaLNCzkNOaSlHn5U6kHZcl_FdA\u003dw582-h298-k-no","",[3530,1805],[203,100]],null,[[3,121.4618838,25.1373823],[0,90],[3530,1805],75],"WLOaar7VJ7b21e8P7p3TOA","0ahUKEwi-4e3Y8NSWAxU2e_UHHe7OFAcQzCcIwwIoAA",null,null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgICuy63cmgE"],[10,3,[1805,3530]],null,null,[[[2],[[null,null,25.1373823,121.4618838]]]],[2,null,null,[2],null,[null,null,"photos:gmm_android",[6,7,4,1,3]],null,null,[2022,8,6,12]],null,null,null,null,null,null,null,null,null,null,null,null,["UGCS_REFERENCE","CIHM0ogKEICAgICuy63cmgE||","1"]],1,null,null,null,null,null,null,["3765765330768363587","5874799809343555448"],null,"nGqfp0GxMGA"]],null,null,null,null,null,null,0,1,null,0],["CgIgARICGAI\u003d","0ahUKEwi-4e3Y8NSWAxU2e_UHHe7OFAcQhbADCMQCKAE","最新",[["CIABIhCXlPVxhGdOE3yH9xCsXthC",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmIePmR0yDN-GUchwF57SkUBmaGdJ3VqyJGKUzNxyb1XlNpmiEsT4SKe-vxGkielHlpE29byuiuHKaF9SgWUPglxnU3UrbNDZOdeytY1ImjjY_Q8ZBqmli_h_GVprVxlO_InuWV\u003dw397-h298-k-no","",[4576,3432],[203,100]],null,[[3,121.4618838,25.1373823],[0,90],[4576,3432],75],"WLOaar7VJ7b21e8P7p3TOA"