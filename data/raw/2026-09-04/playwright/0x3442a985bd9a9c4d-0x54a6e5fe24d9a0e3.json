l,null,["ChdDSUhNMG9nS0VJQ0FnSUREdXZUdm53RRAB"]],"CIHM0ogKEICAgIDDuvQf",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3YcHCLkBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3IcHCLgBKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3YcHCLsBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3IcHCLoBKAY",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3YcHCL0BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3IcHCLwBKAc",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3IcHCL4BKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3IcHCL8BKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3IcHCMABKAo",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["滿分五顆星想要給他六顆的那種⭐️⭐️⭐️⭐️⭐️🌟\n\n📌醬油豚骨拉麵 加大65g 麵體硬度：普 湯頭鹹淡：普 $150\n\n店裡2.30來個位子，晚上6點晚餐時段來人非常少，我只能說不！敢！相！信！CP值這麼高的店家居然沒有客滿太可惜了😭😭在這附近非常平價，品質我覺得有到一碗200多的拉麵的程度！\n\n配料：海苔、海帶芽、叉燒2片、溏心蛋、玉米\n上餐速度超級快，我甚至來不及拿手機出來滑哈哈\n一上來醬油味道就飄出來，非常香！醬油湯頭有鹹、有濃但不膩口，喝完嘴巴不會黏黏油油的，還帶有一點甜味。各種配料和拉麵配合得當，玉米鮮甜，海帶芽也不搶風頭，融合的很好，不會像其他店家配料和拉麵、湯頭味道分開，這點我很喜歡！不過溏心蛋有一點點偏熟，不過我個人不在意。麵體不算太硬，但又保有口感，原本的份量+半球吃到很飽！今天剛好很餓哈哈哈，平時的話感覺不用加大就可以吃到七分飽，真的很實惠。湯的份量拿捏得很足夠，我是平常很喜歡喝湯的人，每一口都不用謹慎很爽快！最後剩下大概兩三口的湯，很剛好～\n\n現在有憑學生證/教師證免費升級大碗的活動喔！到2024的8月底，快來！！看評論很多人推唐揚雞、炸薯條等等，等到下次帶朋友來的時候很想嘗試看看😍😍\n\n是我一定會回訪的店！喜歡拉麵的朋友不妨來試試看！！",null,[0,59]]]],[null,1712577214000000,1712577214000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQU40b