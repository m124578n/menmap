i17--8dSWAxWpm68BHRbTFPEQ3YcHCKoBKAA"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3YcHCKsBKAE"]]],null,"用餐人數",null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ3IcHCKkBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["《湖鹽叉燒拉麵$220、濃厚豚骨豬排拉麵$220》\n一人店家，老闆很忙，生意很好需要等候。\n菜單明確，在點餐區填寫餐點號碼、麵的硬度、湯頭口味。\n麵為偏硬細麵，口感不錯。\n湖鹽湯頭較為清爽，適合口味不那麼重的人、豚骨相較之下偏鹹，但適合口味偏重的人。\n豬排剛上桌很好吃，冷掉後，外層麵皮感稍微明顯。\n叉燒經過炙燒後鋪上拉麵中，一共會有四片，大小適中。\n可能因為坐吧台，所以油煙味偏重。",null,[0,72]]]],[null,1753251590000000,1753251590000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfZ0RQZENXRDdnR19KSHNXaWNEU1QyZw%7CCAEQrcz1_gkiMAoZQ0hfZ0RQZENXRDdnR19KSHNXaWNEU1QyZxoTQ2d3SWh2NkJ4QVlRLXM3MXJRRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwii17--8dSWAxWpm68BHRbTFPEQ_2MIrAEoCw"],"https://business.google.com/local/business/4895289665058189553/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwVEUwelZubFRWMDVUWkc1V1JWZ3dhRTFsYldRd1pVVjBlbFpHUlJBQhAA",[null,null,null,"/local/business/4895289665058189553/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwVEUwelZubFRWMDVUWkc1V1JWZ3dhRTFsYldRd1pVVjBlbFpHUlJBQhAA"],"https://business.google.com/local/business/4895289665058189553/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwVEUwelZubFRWMDVUWkc1V1JWZ3dhRTFsYldRd1pVVjBlbFpHUlJBQhAA",[null,null,null,"/local/business/4895289665058189553/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwVEUwelZubFRWMDVUWkc1V1JWZ3dhRTFsYldRd1pVVjBlbFpHUlJBQhAA"],null,"https://business.google.com/local/business/4895289665058189553/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwVEUwelZubFRWMDVUWkc1V1JWZ3dhRTFsYldRd1pVVjBlbFpHUlJBQhAA",[null,null,null,"/local/business/4895289665058189553/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwVEUwelZubFRWMDVUWkc1V1JWZ3dhRTFsYldRd1pVVjBl