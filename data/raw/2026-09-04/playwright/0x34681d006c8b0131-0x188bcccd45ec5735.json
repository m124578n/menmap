,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiO3Lrh8NSWAxWCdvUHHc6dGn4Q3YcHCOYBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiO3Lrh8NSWAxWCdvUHHc6dGn4Q3IcHCOUBKAg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiO3Lrh8NSWAxWCdvUHHc6dGn4Q3IcHCOcBKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiO3Lrh8NSWAxWCdvUHHc6dGn4Q3IcHCOgBKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiO3Lrh8NSWAxWCdvUHHc6dGn4Q3IcHCOkBKAs",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["阿啾西是連鎖店，泡麵種類眾多可挑選，主打各種韓式泡麵，也有台式泡麵（例如滿漢大餐），不過來這邊還是推薦韓式麵體比較耐煮。\n\n步驟如下：\n右邊整排泡麵櫃區域，挑好泡麵直接拿取至左邊結帳機器操作，加購各式你喜歡的配料（例如雞蛋、肉品、飲料，現在五星有送豆皮），接著就直直一條動線過去：\n拆泡麵\u003e免費加料區\u003e冷凍肉品區\u003e冷藏飲料區\u003e煮麵區（蛋在上方），依次序操作即可，煮麵時記得持續攪拌，不然現場好幾位煮到操灰搭，店裡都是燒焦味😆\n煮好後鋁箔很燙，可從上方拿托盤盛裝，到座位區食用，吃完自行到水槽區倒廚餘收拾乾淨。\n\n結論：我吃的韓式泡麵加購料大約兩百，小貴但勝在24小時開放，半夜沒東西時可來覓食，當天免費料區有3種蔬菜、金針菇、蟹肉棒、玉米粒、青蔥等。",null,[0,67]]]],[null,1726297088000000,1726297088000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQkY1aV9YVU5FVmhtNVRRQUFBWnNwZw%7CCAEQrcz1_gkiMAoZQ0hfQkY1aV9YVU5FVmhtNVRRQUFBWnNwZxoTQ2d3SWdPaVV0d1lRcDdhRnhRRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiO3Lrh8NSWAxWCdvUHHc6dGn4Q_2MI6gEoDA"],"https://business.google.com/local/business/3355640829583295448/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUnlNazk2TTBOM0VBRRAA",[null,null,null,"/local/business/3355640829583295448/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUnlNazk2TTBOM0VBRRAA"],"https://business.google.com/local/business/3355640829583295448/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUnlNazk2TTBOM0VBRRAA",[null,null,null,"/local/business/3355640829583295448/cus