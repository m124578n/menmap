DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3YcHCGwoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCGsoEA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCG0oEQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCG4oEg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCG8oEw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3YcHCHEoAA"]],1],null,null,"預訂網址",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCHAoFA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_30_TO_60_MIN"],"30 到 60 分鐘",2,null,null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3YcHCHMoAA"]],1],null,null,"等待時間",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCHIoFQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["完全就是「為了吃這碗麵專程去一趟都值得」的等級！\n\n1. 地點超完美，完全是通勤族友善！\n\n搭捷運去最方便了，一出站慢步五～十分鐘內一定能抵達門口，不用在大太陽底下走到崩潰，這點我給一百分。\n\n2. 人均消費落在三百到六百元，我覺得非常合理，因為好吃。\n\n如果你點一碗拉麵，再加個叉燒飯吃得飽又吃得巧，不會覺得荷包大失血。\n\n3. 雖然是拉麵店，但它的氛圍很沉穩，你會感覺到店裡瀰漫著一種對待食材的敬重感，就是那種所謂的「職人精神」。\n\n環境乾淨整潔，大家都很專心在自己的餐點上，是很棒的用餐體驗。\n\n4. 一定要點「蛤蠣醬油清湯拉麵」！它的湯頭真的是藝術品，清澈到你以為味道會很淡，結果一入口，那個蛤蜊的鮮甜味會瞬間爆發出來，是那種很優雅、很有層次的鹹鮮味，麵條也吸飽了湯汁精華，真的超級無敵好吃！\n\n5. 點餐機可以直接刷卡，不用擔心身上現金不夠。\n\n座位區雖然坐起來蠻舒適的，但座位配置會比較緊湊一點，進出時可能要稍微禮讓一下隔壁的朋友囉！",null,[0,44]]]],[null,null,null,null,null,"https://business.google.com/local/business/1115254202044787462/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTZFdWWWNHbFhSV2hIV2xSR1JWZHRiSGRpTUhSelpFVndRbFF6WXhBQhAA",[null,null,null,"/local/business/1115254202044787462/customers/reviews/reply?p\u003dCkRDaTlEUVVsU