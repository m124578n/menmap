_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCIEBKAY",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCIIBKAc",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCIMBKAg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:NOT_SURE"],"不確定",2,null,null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3YcHCIUBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCIQBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3YcHCIcBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjxj9rz8dSWAxUee_UHHfdYIVQQ3IcHCIYBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["🐹7.2🐻7.4\n\n20:30直接walk in不需要排隊，我點的是柚香桂花拉麵，整體吃起來是清爽的湯頭，不過覺得味道融合得有點微妙，因為強調有柚香以為柚香味會很重，但吃起來很淡，桂花味也淡淡的，覺得湯的味道沒有融合得很好。溏心蛋可以再熟一點點，大部分沒有成形，醬油味道只有鹹味，不是我喜歡的。干貝和雞腿都好吃。麵的硬度剛剛好。\n\n老公的豚骨魚介肉盛，他覺得吃起來很鹹。\n\n唐揚雞剛炸好汁很多，還不錯，如果有附其他調味粉吃起來可以更有層次，不是只有鹹鹹的。",null,[0,21]]]],[null,null,null,null,null,"https://business.google.com/local/business/1115254202044787462/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4YVZwR1VtRk1Wa3BzVjBoS2RsVlhTbWxoUjBZellqRnJlbFJ0WXhBQhAA",[null,null,null,"/local/business/1115254202044787462/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4YVZwR1VtRk1Wa3BzVjBoS2RsVlhTbWxoUjBZellqRnJlbFJ0WXhBQhAA"],"https://business.google.com/local/business/1115254202044787462/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4YVZwR1VtRk1Wa3BzVjBoS2RsVlhTbWxoUjBZellqRnJlbFJ0WXhBQhAA",[null,null,null,"/local/business/1115254202044787462/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4YVZwR1VtRk1Wa3BzVjBoS2RsVlhTbWxoUjBZellqRnJlbFJ0WXhBQhAA"],null,"https://