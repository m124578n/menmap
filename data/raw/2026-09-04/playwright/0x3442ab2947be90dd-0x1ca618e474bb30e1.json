1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,7,8,14,null,null,null,null,["1 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhC45oF4f6AzxxKzULQ22vaI\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x1ca618e474bb30e1"]],1,null,null,null,null,null,null,["0","2064364848685986017"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2toMVMxWkNXbWh3VFVsclMwRllRblY2U214bmVFRRAB"]],"CIABIhC45oF4f6AzxxKzULQ22vaI",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjqo-qZ89SWAxVnnK8BHe_zIwQQ3YcHCGAoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjqo-qZ89SWAxVnnK8BHe_zIwQQ3IcHCF8oBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjqo-qZ89SWAxVnnK8BHe_zIwQQ3YcHCGIoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjqo-qZ89SWAxVnnK8BHe_zIwQQ3IcHCGEoBQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwjqo-qZ89SWAxVnnK8BHe_zIwQQ3YcHCGQoAA"]],1],null,null,"預訂網址",null,"0ahUKEwjqo-qZ89SWAxVnnK8BHe_zIwQQ3IcHCGMoBg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjqo-qZ89SWAxVnnK8BHe_zIwQQ3YcHCGYoAA"]],1],null,null,"等待時間",null,"0ahUKEwjqo-qZ89SWAxVnnK8BHe_zIwQQ3IcHCGUoBw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["先前因為是爭議比較多的店，所以一直不是特別有動力來吃，直到年初開始停業才覺得沒來吃過有些可惜，因此趁復業趕緊騰出時間來吃一波。\n\n整體來說我非常喜歡！處處感受到店家對自家商品的用心與講究，口味也深得我心，如果平日下班時段都不太需要排隊的話會想經常光顧。\n\n・濃厚煮干雞白湯：確實像店家再三強調的不適合新手及口味清淡者。我身為在日本也吃了近100間拉麵店的煮干愛好者，我得說這碗真的讓我相當喜歡！濃度雖是水泥濃，但不會有粗糙的煮干雜質影響過喉感。一入口就有直衝鼻腔的乾物鮮味，讓我想起川崎市的麺やでこ。麵條硬度保有頗強烈的麵芯口感，我想偏好硬麵的人也都會非常喜歡。海苔帶來的海味也很加分，看照片似乎和以往的片狀海苔不太一樣，但我非常喜歡這碗的版本。\n\n・和え玉：拉麵公子據說也是相對早期把和え玉的文化帶進台灣的店家，即便到現在2026年，有提供和え玉的店家仍然是少數。這碗單吃、配著湯吃都讓人欲罷不能，大推！（廚房師傅們會觀察客人吃拉麵的進度，並自動開始準備和え玉，非常的I人友善）\n\n・叉燒飯：130的高單價換來的是十足的份量，炙燒的時間蠻長，因此香氣也很強。白飯粒粒分明不會過濕，並且叉燒肉、醬汁和白飯的比例也很適中，整體味道很優，小可惜是積在碗底的油還蠻多的，建議可以把一些蔥留到最後平衡口中的油感。\n\n隨著鳳華結束營業，未來在台北想吃碗好吃的煮干濃湯就會想來拉麵公子了。\n🙏ごちそうさまでした！",null,[0,126]]]],[null,null,null,null,null,"https://business.google.com/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvTVZNeFdrTlhiV2gzVkZWc2NsTXdSbGxSYmxZMlUyMTRibVZGUlJBQhAA",[null,null,null,"/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvTVZNeFdrTlhiV2gzVkZWc2NsTXdSbGxSYmxZMlUyMTRibVZGUlJBQhAA"],"https://business.google.com/local/business/15841010331632340335/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvTVZNeFdrTlhiV2gzVkZWc2NsTXdSbGxSYmxZMlUyMTRibVZGUlJBQhAA",[null,null,null,"/local/business/15841010331632340335/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvTVZNeFdrTlhiV2gzVkZWc2NsTXdSbGxSYmxZMlUyMTRibVZGUlJBQhAA"],null,"https://business.google.com/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvTVZNeFdrTlhiV2gzVkZWc2NsTXdSbGxSYmxZMlUyMTRibVZGUlJBQhAA",[null,null,null,"/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvTVZNeFdrTlhiV2gzVkZWc2NsTXdSbGxSYmxZMlUyMTRibVZGUlJBQhAA"]],[null,null,4150,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2toMVMxWkNXbWh3VFVsclMwRllRblY2U214bmVFRRAB!2m1!1s0x0:0x1ca618e474bb30e1!3m1!1s2@1:CAIQACodChtycF9oOkh1S1ZCWmhwTUlrS0FYQnV6SmxneEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2toMVMxWkNXbWh3VFVsclMwRllRblY2U214bmVFRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2toMVMxWkNXbWh3VFVsclMwRllRblY2U214bmVFRRI-Ci9DQUlRQUNvZENodHljRjlvT2toMVMxWkNXbWh3VFVsclMwRllRblY2U214bmVFRRILMGVJX1hxQkU0dVoaPgovQ0FJUUFDb2RDaHR5Y0Y5b09raDFTMVpDV21od1RVbHJTMEZ