E_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiw3M6j8tSWAxUrZPUHHYeiChIQ3IcHCLMCKCQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiw3M6j8tSWAxUrZPUHHYeiChIQ3IcHCLQCKCU",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwiw3M6j8tSWAxUrZPUHHYeiChIQ3YcHCLYCKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiw3M6j8tSWAxUrZPUHHYeiChIQ3IcHCLUCKCY",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwiw3M6j8tSWAxUrZPUHHYeiChIQ3YcHCLgCKAA"]],1],null,null,"等待時間",null,"0ahUKEwiw3M6j8tSWAxUrZPUHHYeiChIQ3IcHCLcCKCc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["⭐ 中午實訪心得｜濃郁雞白湯派會喜歡\n\n今天中午前往 麵屋千雲 用餐，整體表現算不錯。\n\n白雞湯拉麵🍜屬於濃郁偏鹹的日式口味，湯頭厚實、有黏嘴感，走的是道地重口味路線；如果喜歡清爽型拉麵的人可能會覺得偏重。點「全部盛」份量相當足夠，女生吃也沒問題，但價格相對就偏高一些，整體CP值見仁見智。\n\n用餐前就有看到不少五顆星評論，現場也確實有「評論送小菜」活動，這點大家可以自行評估是否參與。\n\n店內環境乾淨、日式風格明亮，座位不算擁擠。服務表現不錯，但沒有特別令人驚艷的地方。\n\n整體來說，如果想吃濃郁雞白湯、重口味拉麵，這裡會是選項之一；但以價位來看，我個人覺得屬於偶爾嚐鮮型，不一定會特別再訪。",null,[0,43]]]],[null,1772952675000000,1772952675000000,"5 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfVmduODZCemRIYmd0WUpfeE1kbW1qZw%7CCAEQrcz1_gkiMAoZQ0hfVmduODZCemRIYmd0WUpfeE1kbW1qZxoTQ2d3STQ3aTB6UVlRX1BpZHlBTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiw3M6j8tSWAxUrZPUHHYeiChIQ_2MIuQIoKA"],"https://business.google.com/local/business/17984583729565501971/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhSZEdJeWNETlhWMDV3VWpGb2FsSXlOWHBqYW14UlpHMXdNVnBzUlJBQhAA",[null,null,null,"/local/business/17984583729565501971/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhSZEdJeWNETlhWMDV3VWpGb2FsSXlOWHBqYW14UlpHMXdNVnBzUlJBQhAA"],"https://business.google.com/local/business/17984583729565501971/customers/reviews/deletereply?p\u003dCkRDaTl