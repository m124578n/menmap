AA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhCw9J8tWPqx0sQKINKVUyKE"],[10,3,[4284,5712]],[null,null,null,null,null,null,null,["麵屋 千雲 林森店"]],[null,[[["歐曜瑋"],"https://www.google.com/maps/contrib/107483989733789163639?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjWrRX1dNKm-vWRm9X-bDpUhS9-H-uA_HdUQai7e2v0ZqoVB00Na\u003ds120-c-rp-mo-ba12-br100",null,null,"107483989733789163639"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,2,12,4,null,null,null,null,["6 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhCw9J8tWPqx0sQKINKVUyKE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x532d9321d5a305f0"]],1,null,null,null,null,null,null,["0","5993608452627432944"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT21Vd2QzWnBkMVpOZUZFeE5UUllSR0k0TUhWRFVWRRAB"]],"CIABIhCw9J8tWPqx0sQKINKVUyKE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["麵屋千雲最明顯的優點是雞白湯湯頭非常濃郁，風味厚實、層次感明確，喜歡重口味的人應該會很滿意。不過對部分人來說可能偏濃、偏鹹，但店家提供可自行加入清湯調整濃度的設計，我認為相當加分，能讓客人依照個人口味微調，加入清湯後整體平衡度更符合我的習慣。\n\n叉燒部分同時有雞叉燒與豬叉燒，雞叉燒表現不錯，口感嫩、味道乾淨，是這家比較有特色的亮點。豬叉燒則黑胡椒味較重，再加上蔥、蒜等配料，整體風味稍微偏複雜，若與一蘭相比，我個人仍較偏好一蘭的豬叉燒呈現。\n\n麵條口感整體水準不錯，但如果直接對比一蘭，我還是稍微偏好一蘭的麵體表現。半熟蛋這裡的表現略勝一點，但差距不算非常大。整體而言，雞白湯特色鮮明、可調整濃度的設計實用，雖然部分配料風味稍重，但仍是值得再訪的店家。",null,[0,121]]]],[null,null,null,null,null,"https://business.google.com/local/business/1585432581869657726/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFWZDJRelduQmtNVnBPWlVaRmVFNVVVbGxTUjBrMFRVaFdSRlZXUlJBQhAA",[null,null,null,"/local/business/1585432581869657726/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFWZDJRelduQmtNVnBPWlVaRmVFNVVVbGxTUjBrMFRVaFdSRlZXUlJBQhAA"],"https://business.google.com/local/business/1585432581869657726/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFWZDJRelduQmtNVnBPWlVaRmVFNVVVbGxTUjBrMFRVaFdSRlZXUlJBQhAA",[null,nul