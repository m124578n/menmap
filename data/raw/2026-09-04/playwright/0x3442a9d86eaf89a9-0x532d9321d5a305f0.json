wjq_9KH8tSWAxXmZ_UHHQBGG5gQ3IcHCKgBKAI",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjq_9KH8tSWAxXmZ_UHHQBGG5gQ3IcHCKkBKAM",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjq_9KH8tSWAxXmZ_UHHQBGG5gQ3IcHCKoBKAQ",null,null,null,[1],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這次點了沾麵完全毀了我對這家店的印象，點餐時被告知沾麵比較慢要等15分鐘，等到20分鐘時忍不住催促才在25分鐘時上來，店員說因為單子多所以會延後，問題是你在接我單的時候就該知道了不是嗎⋯？然後麵整個是冷的，不知道煮好多久，湯也不夠熱，而且不同於一般沾麵的濃湯，這裡的湯是稀的，感覺就是湯麵的湯多加了點鹽，味道的比例跟湯麵完全是兩回事，非常普通，說真的不是很懂店家為什麼要把這種敗好感的東西放在菜單上浪費大家時間金錢",null,[0,207]]]],[null,1784462386000000,1784462386000000,"1 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfMGVOd0k1Tk03eWZ4WkJKNWRHQ2YxZw%7CCAEQrcz1_gkiMAoZQ0hfMGVOd0k1Tk03eWZ4WkJKNWRHQ2YxZxoTQ2d3SXN2ankwZ1lRMnRyTnBBSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjq_9KH8tSWAxXmZ_UHHQBGG5gQ_2MIqwEoBQ"],"https://business.google.com/local/business/1585432581869657726/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFOTlZNeVVrTmtWMFYzVm01bmVWSnJNVkpoUlZVeFVqTlNkMWxWUlJBQhAA",[null,null,null,"/local/business/1585432581869657726/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFOTlZNeVVrTmtWMFYzVm01bmVWSnJNVkpoUlZVeFVqTlNkMWxWUlJBQhAA"],"https://business.google.com/local/business/1585432581869657726/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFOTlZNeVVrTmtWMFYzVm01bmVWSnJNVkpoUlZVeFVqTlNkMWxWUlJBQhAA",[null,null,null,"/local/business/1585432581869657726/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFOTlZNeVVrTmtWMFYzVm01bmVWSnJNVkpoUlZVeFVqTlNkMWxWUlJBQhAA"],null,"https://business.google.com/local/business/1585432581869657726/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFOTlZNeVVrTmtWMFYzVm01bmVWSnJNVkpoUlZVeFVqTlNkMWxWUlJBQhAA",[null,null,null,"/local/business/1585432