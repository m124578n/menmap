3,[3024,4032]],null,null,[[[2],[[null,null,25.04229618815638,121.54658915924765]]]],[2,null,null,[8],null,[null,null,"photos:gmm_ios_review_post",[6,7,4,1,3]],null,null,[2021,4,21,1]],null,null,null,null,null,null,null,[["/g/11hzhxb2wc",1,["叉燒肉 肩肉"]]],null,null,null,null,["UGCS_REFERENCE","CIHM0ogKEICAgICKh46eSw||","1"]],1,null,null,null,null,null,null,["3765761193709017321","4062972864771442104"],null,"8B2Txc1xkqY"]],null,null,null,null,null,1,0,null,"/g/11hzhxb2wc",null,8,null,null,[2,null,null,["https://www.google.com/local/place/offerings?g2lbs\u003dAEzIGDs9aTfXlu4fdiW9ZO3g1guJpwPzGY9QHhHjRx9aScH2uBqMeQFE8sDkJiexKz2gZbSsBH1o\u0026hl\u003dzh-Hant-TW\u0026gl\u003dtw\u0026oid\u003d/g/11hzhxb2wc\u0026fid\u003d0x3442abda93fa18e9:0x3862944b40c0c5b8\u0026on\u003d%E5%8F%89%E7%87%92%E8%82%89+%E8%82%A9%E8%82%89\u0026mid\u003d/g/12m956l4d"]]]]]]],null,null,null,null,[[[null,[[["拉麵 Ramen",""],[[[["蒜味海老王 Garlic Shrimp King","湯頭以「蒜味蝦仁、烘焙櫻花蝦粉、香氣濃郁的蝦油」三重組合打造獨特而濃厚的風味。 香蝦油讓貝類與甲殼類的濃郁香氣層層展開，同時凸顯白色豚骨湯、鮮紅蝦油與翠綠羽衣甘藍的視覺對比。 櫻花蝦粉帶出細緻、帶季節感的香氣；蒜味蝦仁搭配少量是拉差醬與美乃滋，讓辛香、濃郁與鮮味達到剛剛好的平衡。"],["$330.00"]],[["和牛王 Gyu King","將經典的豚叉燒，換成軟嫩多汁的和牛薄片，帶來截然不同的風味體驗。 以濃厚豚骨湯為基底，搭配鮮嫩和牛、調味炸馬鈴薯，以及以巴薩米可醋炒香的青蔥梗，組成飽滿又層次豐富的一碗。"],["$380.00"]],[["蟹王","將整隻軟殼蟹酥炸至金黃酥脆，濃郁蟹油加入招牌豚骨湯，搭配滿滿的酥脆海苔點綴，濃厚蟹香緩緩爬上味蕾，令人難以忘懷。"],["$340.00"]],[["超值雙人拉麵套餐 四大天王 Classic Kings Ramen Combo For Two","超值雙人拉麵套餐 四大天王 拉麵口味皆為主廚推薦搭配│任選2碗人氣經典四大天王拉麵，搭配雙人組合：2顆半熟蛋、1份小份炸雞及1碗叉燒飯。(豬肉產地：台灣/雞肉產地：美國）"],["$695.00"]],[["豚王 Butao King Ramen","在日本國內外獲獎無數的豚骨高湯，經長時間熬煮出濃厚香醇的風味，是ラーメン凪(Nagi)最引以為傲的湯頭。搭配每天新鮮手工自製，使用日本進口麵粉製成的麵條，其特色是能夠大量吸附湯汁，在口中散發濃郁香氣。是ラーメン凪(Nagi)最熱銷的經典口味。(豬肉產地：台灣）"],["$250.00"]],[["黑王 Black King Ramen","拉麵口味皆為主廚推薦搭配│以墨魚汁、黑芝麻及秘製黑醬製作而成的「黑王球」，搭配香濃的豚王湯頭，最後灑上蒜酥、黑芝麻與特製香料。同時品嚐到海鮮鮮甜獨特的香氣，是味道層次豐富的一品拉麵。(豬肉產地：台灣）"],["$275.00"]],[["赤王 Red King Ramen","拉麵口味皆為主廚推薦搭配│以豚王湯頭為基底，加入獨家的自製辣油、大蒜、唐辛子等香料提味，佐以熟成味噌和特製豬絞肉製成的「赤王球」，入口辣味溫而不嗆，尾韻轉為甘甜，絕妙口感讓人驚喜連連。(豬肉產地：台灣）"],["$275.00"]],[["翠王 Green King Ramen","拉麵口味皆為主廚推薦搭配│以豚王湯頭搭配新鮮羅勒、橄欖油及多種蔬菜調製而成的風味油，再灑上大量起司粉，意外融合的獨特口感，成就出這道充滿義式風味的翠王拉麵。(豬肉產地：台灣）"],["$275.00"]],[["羊肉王 Lamb King","以細緻工序熬煮的羊骨湯底，透出濃郁而鮮明的風味。 主角是以大蒜、胡椒、醬油醃製的羊腰脊肉叉燒，口感柔嫩多汁。 再加入Nagi風格的法拉費(炸鷹嘴豆餅)、咖哩洋蔥丁與香菜，讓整體香氣更能襯托羊湯的濃厚層次。"],["$325.00"]]]]],[["配菜 Side Dish",""],[[[["豬肩肉 Pork Shoulder",""],["$75.00"]],[["豬腩肉 Pork Belly","(豬肉產地：台灣）"],["$85.00"]],[["蔥 Green Onion",""],["$50.00"]],[["高麗菜 Cabbage",""],["$45.00"]],[["半熟蛋 Japanese Style Egg",""],["$38.00"]],[["海苔 Seaweed",""],["$40.00"]],[["黑木耳 Tree Mushroom",""],["$38.00"]],[["白飯 Rice",""],["$35.00"]],[["加麵底Extra Noodles【僅提供細麵Extra Noodles】",""],["$47.00"]]]]],[["配料 Side Dish Add-On",""],[[[["唐揚炸雞 Karaage","ラーメン凪唐揚炸雞登場！外層酥脆、內嫩多汁的日式唐揚炸雞，佐上獨家沾裹醬和塔塔醬，盡情享受2種吮指好滋味。(雞肉產地：美國）"],["$180.00"]],[["冰花餃 Snack Gyoza","煎至金黃香脆的冰花餃，內餡是豬絞肉與高麗菜的扎實組合，外層帶有酥脆的冰花裙邊。搭配Nagi特製的蘋果薑汁醬食用，清香微甜，讓整體風味更突出。"],["$135.00"]],[["叉燒飯 Chashu Rice","沉浸於秘傳蘋果洋蔥叉燒醬汁的豬肩肉片鋪陳於香Q米飯上，碎肉丁、青蔥絲、搭配日式薑碎，更是增添風味。(豬肉產地：台灣）"],["$70.00"]],[["枝豆 Edamame","胡椒鹽風味枝豆"],["$65.00"]]]]],[["期間限定王",""],[[[["綠咖哩王","濃郁香茅風味豚骨湯底+燉煮入味的鮮嫩雞腿，佐炸半熟蛋淋上特製炎之醬，重口味最佳首選!"],["$305.00"]],[["萬聖節王",""],["$290.00"]],[["北海道王","濃郁的赤味噌和鮮蒜蓉入豚骨湯頭，保證濃厚感十足"],["$310.00"]],[["胡椒王","濃郁的三色胡椒香氣在舌尖上跳舞，辛香鮮辣!"],["$295.00"]],[["海老王","豚骨湯底搭配海老風味油和櫻花蝦粉，飽滿蝦仁和自製蝦泥，海味十足的鮮甜滋味!"],["$320.00"]],[["元氣王","濃郁香辣咖哩豚骨湯底加上香甜炸洋蔥和甜椒 滿滿的能量來源，補充一天活力"],["$295.00"]],[["蕃茄王","以蔬果的自然酸甜，引出豚骨的醇郁甘美，打造出最簡單卻最純粹的究極湯頭！"],["$290.00"]],[["義大利王","清新羅勒、酸甜微辣番茄肉球、香濃起司滿滿南義風情，走吧!帶著味蕾旅行義大利"],["$290.00"]],[["麥笛王 湯","軟嫩慢燻牛胸肉加上特製麥笛赤王球，煙燻風味和酸甜微辣的口感，絕妙滋味讓人讚嘆! *拉麵口味皆為主廚推薦搭配"],["$320.00"]],[["麥笛王 乾","慢燻牛胸肉的煙燻香氣，黃瓜與紅洋蔥丁的酸甜滋味，微辣的醃辣椒，劃破蛋黃和麵條拌勻，超乎意外的美味! *拉麵口味皆為主廚推薦搭配"],["$320.00"]],[["泰王","豚骨湯底融入泰式椰奶，口感香醇濃郁， 甜美鮮蝦加上獨家炎之醬，酸辣解膩的南洋風情"],["$310.00"]],[["赤味噌王","赤味噌搭上特製赤王肉球，加上獨家辣椒粉、起司粉、蒜蘇，滋味濃郁不膩口"],["$290.00"]],[["起司蕃茄王","濃郁的番茄肉醬，再加上焗烤香濃起司，充滿義式風情的極致美味!"],["$295.00"]],[["山椒王","特製山椒風味豚骨湯底加入黑芝麻拌麵和朝天椒爆炒過後的洋蔥雞腿肉辣、香、麻一碗通通有"],["$310.00"]],[["蒜王","蒜油豚骨湯、炸蒜瓣球和蒜味美乃滋，溫和辛香的鮮蒜滋味!"],["$300.00"]]]]],[["Others",""],[[[["唐揚炸雞 Karaage","ラーメン凪唐揚炸雞登場！外層酥脆、內嫩多汁的日式唐揚炸雞，佐上獨家沾裹醬和塔塔醬，盡情享受2種吮指好滋味。(雞肉產地：美國）"],["$180.00"]],[["叉燒飯 Chashu Rice","沉浸於秘傳蘋果洋蔥叉燒醬汁的豬肩肉片鋪陳於香Q米飯上，碎肉丁、青蔥絲、搭配日式薑碎，更是增添風