,[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwiN7Pbl8tSWAxUtUfUHHSVCD2MQ3YcHCHUoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiN7Pbl8tSWAxUtUfUHHSVCD2MQ3IcHCHQoFQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwiN7Pbl8tSWAxUtUfUHHSVCD2MQ3YcHCHcoAA"]]],null,"用餐人數",null,"0ahUKEwiN7Pbl8tSWAxUtUfUHHSVCD2MQ3IcHCHYoFg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["源自東京池袋的豚骨醬油拉麵，這間分店在凱撒地下街，這次點魚豚海帶芽拉麵(330元)，店員有提醒魚豚湯頭會比豚骨鹹一點，所以選擇湯頭調淡且做麵硬，麵條份量可選擇中份或大份(不加價)。\n魚豚的湯頭調淡後，剛好是適合台灣人的鹹度，魚介和豚骨味大約6:4，更偏魚介一點，味道不錯，推薦吃半碗後再加入桌上的芝麻蒜泥和自製辣油更加分。\n麵條是細捲麵，選了麵硬但感覺還是稍軟，可以再硬一點。配料只有一片叉燒、半顆溏心蛋、筍干和大量海帶芽，這樣破300元確實稍貴，不過整體是碗中規中矩水準不錯的拉麵。",null,[0,242]]]],[],[null,null,4430,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tsa2VFNXhZa2RNUlc1SWRVbE5iV28wZUdwM1RYYxAB!2m1!1s0x0:0xe3d62764fb57f45c!3m1!1s2@1:CAIQACodChtycF9oOklkeE5xYkdMRW5IdUlNbWo0eGp3TXc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2tsa2VFNXhZa2RNUlc1SWRVbE5iV28wZUdwM1RYYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2tsa2VFNXhZa2RNUlc1SWRVbE5iV28wZUdwM1RYYxI-Ci9DQUlRQUNvZENodHljRjlvT2tsa2VFNXhZa2RNUlc1SWRVbE5iV28wZUdwM1RYYxILMGRqZDA4cUtjTzgaPgovQ0FJUUFDb2RDaHR5Y0Y5b09rbGtlRTV4WWtkTVJXNUlkVWxOYldvMGVHcDNUWGMSCzBkamQwOHFLY084IhIJAAAAAAAAAAARXPRX-2Qn1uMqCzBkamQwOHFLY084\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiN7Pbl8tSWAxUtUfUHHSVCD2MQoykIeCgX"],null,[null,[[1,1]]]],"0ahUKEwizwv3l8tSWAxWMeF4EHdhIJF0Q0pMFCAIoAA"],null,null,null,"0ahUKEwiN7Pbl8tSWAxUtUfUHHSVCD2MQ0pMFCE0oAA"],[["Ci9DQUlRQUNvZENodHljRjlvT2tsVldVRklhbEV3V1dWaFZFbElUbGx5TWpVMVoyYxAB",["0x0:0xe3d62764fb57f45c",null,1772369223576975,1772369223576975,[null,null,["https://www.google.com/maps/contrib/103604606306680244284/reviews?hl\u003dzh-TW"],null,null,["李明乾","https://lh3.googleusercont