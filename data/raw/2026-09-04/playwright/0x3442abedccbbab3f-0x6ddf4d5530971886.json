[7,3]],null,null,[2022,3,17,12,null,null,null,null,["4 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDWrNXnlgE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x6ddf4d5530971886"]],1,null,null,null,null,null,null,["0","7917131698223388806"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSURXckpXLTRBRRAB"]],"CIHM0ogKEICAgIDWrNXnlgE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["剛好到附近的知名麵包店購物路過恰巧看到這家拉麵店有提供給實體五倍振興卷的優惠，於是約了家人禮拜天的中午來嘗鮮。店內座位不多不過因為是中午11點半入座所以還沒有很多人。\n\n我們共三個人加一個小孩點了三碗豪華拉麵分別是-味噌及赤丸，並還贈送一盤唐楊雞。麵的硬度可以調整還有赤丸的辣度也可以。拉麵剛端上桌時感覺份量普通不過可以免費無限續麵。個人是認為赤丸有點辣味比味噌好吃且味道層次比較多。唐楊雞剛好有四塊味道也還可以不過單價不便宜如果要我單點可能會考慮很久。\n\n總共續麵了一次，不過續麵真的味道就差多了因為會淡許多。整體來說還可以不過搭配振興卷真的值得來試試。最後服務真的不是太優因為店員們都非常冷淡，好加在用振興卷是不額外收服務費的。",null,[0,83]]]],[null,null,null,null,null,"https://business.google.com/local/business/4555460974341016686/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUlhja3BYTFRSQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4555460974341016686/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUlhja3BYTFRSQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/4555460974341016686/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUlhja3BYTFRSQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4555460974341016686/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUlhja3BYTFRSQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/4555460974341016686/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUlhja3BYTFRSQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4555460974341016686/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUlhja3BYTFRSQlJSQUIQAA%3D%3D"]],[null,null,9912,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURXckpXLTRBRRAB!2m1!1s0x0:0x6ddf4d5530971886!3m1!1s2@1:CIHM0ogKEICAgIDWrJW-4AE%7C%7C?hl\u0