0IqMQ3IcHCKIBKAQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwit-eXA8tSWAxWFb_UHHdD0IqMQ3YcHCKUBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwit-eXA8tSWAxWFb_UHHdD0IqMQ3IcHCKQBKAU",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwit-eXA8tSWAxWFb_UHHdD0IqMQ3IcHCKYBKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwit-eXA8tSWAxWFb_UHHdD0IqMQ3IcHCKcBKAc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwit-eXA8tSWAxWFb_UHHdD0IqMQ3IcHCKgBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwit-eXA8tSWAxWFb_UHHdD0IqMQ3YcHCKoBKAA"]],1],null,null,"等待時間",null,"0ahUKEwit-eXA8tSWAxWFb_UHHdD0IqMQ3IcHCKkBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwit-eXA8tSWAxWFb_UHHdD0IqMQ3YcHCKwBKAA"]]],null,"座位類型",null,"0ahUKEwit-eXA8tSWAxWFb_UHHdD0IqMQ3IcHCKsBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["到店的時候其實已經蠻晚了，原本想點的幾樣人氣品項都已經售完，只好臨時改變策略。不過有時候這種「被迫改單」，反而會遇到驚喜。\n\n先說這碗牛肝菌雞貝鹽味拉麵（清湯）。麵一上桌，牛肝菌的香氣真的非常明顯，屬於那種還沒動筷子就先被香味勾住的類型。湯頭是清湯，但味道一點也不單薄，雞與貝類的鮮味把牛肝菌的香氣襯得更立體。叉燒給得很有誠意，肉片大又嫩，吃起來相當舒服。吃到大概半碗的時候，才注意到湯裡有一絲一絲咖啡色的配料，和整碗麵的味道融合得很好，一開始還以為是牛蒡絲，結果一問才知道其實是金針菇。這個搭配其實蠻有意思的，既增加口感，又不會搶走湯頭的主角地位。\n\n另一碗是濃厚魚介沾麵。第一口其實蠻讓人驚艷的。冰涼的麵條彈性很好，沾上濃厚的味噌魚介醬汁，味道相當厚實，但又不會死鹹。配料也很有記憶點，除了丸子之外，居然還搭配了橘子，一開始看起來有點意外，但實際吃起來那一點點果香，反而讓整體變得更有層次，蠻有趣的。\n\n唐揚雞也值得一提。外皮酥脆，裡面很多汁，而且不像有些炸物會有很重的油膩感。上面淋了一點蜂蜜，帶點淡淡的甜味，但不會膩，反而讓整體味道更順。\n\n這次雖然很多想吃的都沒點到，但整體其實吃得很滿足。\n下次有機會的話，還是很想補上叉燒飯，看起來也是不少人推薦的品項",null,[0,61]]]],[null,null,null,null,null,"https://business.google.com/local/business/6910255830398360059/customers/reviews/reply?p\u003dCkRDa