0","3624871706079393108"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xGQ1ptY3ROa2h0TjBOQlltcGZiWGRVV2xkV1pHYxAB"]],"CIABIhCuOF2U0v-rqu9hO_S9Bd7Q",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwj52MXQ8tSWAxU-kq8BHdpUEPQQ3YcHCGAoAA"]],1],null,null,"餐點類型",null,"0ahUKEwj52MXQ8tSWAxU-kq8BHdpUEPQQ3IcHCF8oDQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwj52MXQ8tSWAxU-kq8BHdpUEPQQ3YcHCGIoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwj52MXQ8tSWAxU-kq8BHdpUEPQQ3IcHCGEoDg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwj52MXQ8tSWAxU-kq8BHdpUEPQQ3IcHCGMoDw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwj52MXQ8tSWAxU-kq8BHdpUEPQQ3IcHCGQoEA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwj52MXQ8tSWAxU-kq8BHdpUEPQQ3IcHCGUoEQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwj52MXQ8tSWAxU-kq8BHdpUEPQQ3YcHCGcoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwj52MXQ8tSWAxU-kq8BHdpUEPQQ3IcHCGYoEg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["位於忠孝新生站附近的 丸舢拉麵，店內空間寬敞舒適，座位數相較許多拉麵店更多，用餐環境不會有擁擠壓迫感，是能夠悠閒享受一碗拉麵的好地方。\n\n極濃豚骨拉麵 是這次最讓人驚豔的品項之一。濃厚的豚骨湯底搭配醬油香氣，入口後層次豐富且香氣十足，濃郁卻不顯膩口。搭配手揉麵更是絕配，麵條富有彈性與嚼勁，能充分吸附湯汁，每一口都相當滿足。\n\n另一碗 雞貝鹽拉麵 則展現完全不同的風格。湯頭以雞湯與貝類鮮味交織，清爽卻充滿深度，鮮甜自然。雞肉處理得非常嫩口，幾乎入口即化。搭配細麵後，能更完整帶出湯頭的鮮味與層次，是喜歡清爽系拉麵的人必點的一碗。\n\n整體而言，丸舢拉麵同時兼顧濃郁與清爽兩種風格，不論是重口味的豚骨愛好者，還是偏好鮮甜湯頭的拉麵迷，都能找到自己喜歡的選擇。值得再訪。\n\nLocated near Zhongxiao Xinsheng MRT Station, 丸舢拉麵 offers a spacious and comfortable dining environment with more seating than most ramen shops, making it a relaxing place to enjoy a bowl of ramen.\n\nThe Rich Tonkotsu Ramen was one of the highlights of the meal. The intensely rich pork-bone broth is enhanced by a fragrant soy sauce aroma, creating a deep and satisfying flavor profile. Paired with the hand-kneaded noodles, which are pleasantly chewy and springy, every bite is packed with flavor as the noodles soak up the savory broth beautifully.\n\nThe Chicken \u0026 Shellfish Shio Ramen offers a completely different experience. Its clear broth combines the sweetness of chicken stock with the delicate umami of shellfish, resulting in a light yet remarkably flavorful soup. The chicken was exceptionally tender and juicy, while the thin noodles complemented the broth perfectly, allowing its freshness and complexity to shine through.\n\nOverall, Wan Shan Ramen successfully delivers both rich and light ramen styles at a high level. Whether you prefer a bold tonkotsu broth or a refined and delicate shio ramen, this is a spot well worth visiting again.",null,[0,75]]]],[null,null,null,null,null,"https://business.google.com/local/business/15747895986627320237/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHUTFwdFkzUk9hMmgwVGpCT1FsbHRjR1ppV0dSVlYyeGtWMXBIWXhBQhAA",[null,null,null,"/local/business/15747895986627320237/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHUTFwdFkzUk9hMmgwVGpCT1FsbHRjR1ppV0dSVlYyeGtWMXBIWXhBQhAA"],"https://business.google.com/local/business/15747895986627320237/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHUTFwdFkzUk9hMmgwVGpCT1FsbHRjR1ppV0dSVlYyeGtWMXBIWXhBQhAA",[null,null,null,"/local/business/15747895986627320237/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHUTFwdFkzUk9hMmgwVGpCT1FsbHRjR1ppV0dSVlYyeGtWMXBIWXhBQhAA"],null,"https://business.google.com/local/business/15747895986627320237/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHUTFwdFkzUk9hMmgwVGpCT1FsbHRjR1ppV0dSVlYyeGtWMXBIWXhBQhAA",[null,null,null,"/local/business/1574789598