w4sTD8tSWAxWYc_UHHX0gLYsQ3IcHCHkoBg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3IcHCHsoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3IcHCHwoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3IcHCH0oCQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3YcHCH8oAA"]],1],null,null,"等待時間",null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3IcHCH4oCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["2026.07.12\n一直都很想吃這家！今天經過正好想要來吃～\n還好過了午餐時間排隊人比較少，前面排了13個人左右大概等了20分鐘就進去點餐\n因為我是一個人，原本被安排在最裡面位置，我已經入座了，但後來因為要橋位置店員請我移動到前面去坐，為了補償我移位還請我吃泡菜，賺到了XD\n這次點了 雞豚叉燒雞白湯拉麵 $280\n最讓我震驚的是洋蔥絲！每次吃拉麵洋蔥我幾乎不太吃，因為味道辛辣又嗆口，沒想到這家的洋蔥吃起來像蘿蔔絲一樣又薄又脆的，超好吃！\n雞肉叉燒很嫩，豬肉叉燒就一般，之後應該只會點雞叉燒拉麵！\n麵條很細很Q，是我很愛的口味～\n再來湯頭也是讓我很驚艷～我選口味偏鹹，但不會到讓人覺得很死鹹又油膩，喝起來有股奶香味，我覺得超好喝👍🏻\n可以理解每次經過都大排長龍的原因，真的是吃不膩的味道😋",null,[0,70]]]],[null,null,null,null,null,"https://business.google.com/local/business/14571178102011730698/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVzVDFSSFJrNU9WVEZLVkcxVmQwMVlRbUZsV0VaeVRVZEthbFZ1WXhBQhAA",[null,null,null,"/local/business/14571178102011730698/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVzVDFSSFJrNU9WVEZLVkcxVmQwMVlRbUZsV0VaeVRVZEthbFZ1WXhBQhAA"],"https://business.google.com/local/business/14571178102011730698/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVzVDFSSFJrNU9WVEZLVkcxVmQwMVlRbUZsV0VaeVRVZEthbFZ1WXhBQhAA",[null,null,null,"/local/business/14571178102011730698/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVzVDFSSFJrNU9WVEZLVkcxVmQwMVlRbUZsV0VaeVRVZEthbFZ1WXhBQhAA"],null,"https://busines