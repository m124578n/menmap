cHCNoBKBg",null,null,["高腳椅"],null,null,3,null,2],[["GUIDED_DINING_ACCESSIBILITY_TIPS"],"無障礙設施",null,null,"分享無障礙空間相關資訊","無障礙設施",null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3IcHCNsBKBk",null,null,["不適合"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:VEGETARIAN_OPTIONS"],"素食餐點",2,null,null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3YcHCN0BKAA"],[["E:OTHER_DIETARY_RESTRICTIONS"],"特殊餐點",2,null,null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3YcHCN4BKAE"],[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3YcHCN8BKAI"],[["E:KID_FRIENDLINESS"],"親子友善程度",2,null,null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3YcHCOABKAM"],[["E:ACCESSIBILITY"],"無障礙設施",2,null,null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3YcHCOEBKAQ"]]],null,null,null,"0ahUKEwiw4sTD8tSWAxWYc_UHHX0gLYsQ3IcHCNwBKBo",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["今天挑了平日五點出頭來訪，運氣不錯，大約排隊等待 15 分鐘就能進場。這間店座落在漁人雞蛋糕旁的巷子中，位置低調卻很有氛圍。店內空間精緻，約有 20 個位置，最令人印象深刻的是放置包包的設計，竟然是用無印良品的購物袋結合而成，不僅有特色且意外地好用。\n點餐採點餐機自助式，目前僅支援現金付款。餐點主要有四種選擇，雖然劃分上主要是內容物多寡的差別，但能感受到店家的純粹。麵條口感非常客製化，可選適中、偏硬或偏軟，重點是還可以免費加一次麵，飽足感十足！\n細節服務也很有感：每桌都有一整壺冰水供客人飲用，非常豪爽。甚至在店門口也貼心準備了飲用水，讓排隊途中的客人也能解渴。唯一要注意的是店內沒有提供洗手間。整體來說，是一間對麵友非常友善且細節有趣的質感小店！",null,[0,125]]]],[null,null,null,null,null,"https://business.google.com/local/business/14571178102011730698/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLZFZwWVZuZGtia0pvVlVSQ2JGcHFSazFOVlZKWFpXNXNSVk13UlJBQhAA",[null,null,null,"/local/business/14571178102011730698/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLZFZwWVZuZGtia0pvVlVSQ2JGcHFSazFOVlZKWFpXNXNSVk13UlJBQhAA"],"https://business.google.com/local/business/14571178102011730698/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLZFZwWVZuZGtia0pvVlVSQ2JGcHFSazFOVlZKWFpXNXNSVk13UlJBQhAA",[null,null,null,"/local/business/14571178102011730698/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLZFZwWVZuZGtia0pvVlVSQ2JGcHFSazFOVlZKW