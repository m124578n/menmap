l,null,["0","-586295825655368793"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25JNFZ6SmllWFpGY0ZNd1drNXJiMU5xYjB3NVZuYxAB"]],"CIABIhCNSwU5sd9iK4U8Qrv3TyvF",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiShpz88dSWAxVmmK8BHcSKLX0Q3IcHCGgoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiShpz88dSWAxVmmK8BHcSKLX0Q3IcHCGkoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiShpz88dSWAxVmmK8BHcSKLX0Q3IcHCGooDA",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這間路過好幾次～每次都客滿或大排長龍\n\n最近終於有機會入座吃看看！我們點了麻辣和醬油豚骨（也只有兩種口味）這裡使用點餐機先點餐付費，然後就可入座等待餐點，其麵同種口味不同麵量價格皆相同👍不過加料要另外收費的\n\n在用餐時，店員會時不時請問要不要加麵？我覺得蠻禮貌貼心的，還會請問份量、硬度，加麵是可以“無限量的”但不可加湯，我是吃多少加多少不要浪費🤤\n\n店內還有免費綠豆湯🧊挺好喝的～麵體則是口感偏軟、湯頭兩種喝起來都濃郁且偏甜（麻辣也不會很辣👍）還有加蔥真的加超多，蠻爽的🤣🤣🤣有機會要再來吃",null,[0,18]]]],[null,null,null,null,null,"https://business.google.com/local/business/6837063209098378157/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTkZaNlNtbGxXRnBHWTBaTmQxZHJOWEppTVU1eFlqQjNOVlp1WXhBQhAA",[null,null,null,"/local/business/6837063209098378157/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTkZaNlNtbGxXRnBHWTBaTmQxZHJOWEppTVU1eFlqQjNOVlp1WXhBQhAA"],"https://business.google.com/local/business/6837063209098378157/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTkZaNlNtbGxXRnBHWTBaTmQxZHJOWEppTVU1eFlqQjNOVlp1WXhBQhAA",[null,null,null,"/local/business/6837063209098378157/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTkZaNlNtbGxXRnBHWTBaTmQxZHJOWEppTVU1eFlqQjNOVlp1WXhBQhAA"],null,"https://business.google.com/local/business/6837063209098378157/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTkZaNlNtbGxXRnBHWTBaTmQxZHJOWEppTVU1eFlqQjNOVlp1WXhBQhAA",[null,null,null,"/local/busines