l,null,"氣氛",null,"0ahUKEwjL8MWR8tSWAxVvia8BHT5kHfIQ3IcHCNQBKAs",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["1150501初訪\n本日用餐的是武士單人套餐，點用了神山拉麵+唐揚雞塊+筍乾+可爾必思，感覺這價位還蠻划算的，今日依然是豚骨與魚介的雙混合湯頭，不過感覺比例上，反而是是魚介高於豚骨，所以品嚐時就是滿滿的魚介味道，基本上湯頭極濃味重，想調整湯頭可以請店家提供，無調味高清湯加以調整，這次還是逐次添加，所以喝到最後一口，還是可接受的湯頭，今日點的是粗麵，另有細麵可選擇，但需另增加費用，初點是可選免費加大半球（事後加點需加價），寬厚的叉燒，感覺穠纖合度軟硬適中，而且Q度甚佳，或許是本日用餐較為幸運吧！另外小菜唐揚炸雞、筍乾也是符合水準，總之，感謝店家的用心，今日用餐完全無雷的感覺！",null,[0,9]]]],[null,1778037310000000,1778037310000000,"3 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfYmd2NE1kaWtlSXhpU0E3eDBoWkZ2UQ%7CCAEQrcz1_gkiMAoZQ0hfYmd2NE1kaWtlSXhpU0E3eDBoWkZ2URoTQ2d3SXZ1VHF6d1lRdGV5SnpnRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjL8MWR8tSWAxVvia8BHT5kHfIQ_2MI1QEoDA"],"https://business.google.com/local/business/4634296749281698316/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFuZVZVeVVtRmFNV3gxV210b1NsbFlVa3hTVkVwRVRWWkdVVnBXUlJBQhAA",[null,null,null,"/local/business/4634296749281698316/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFuZVZVeVVtRmFNV3gxV210b1NsbFlVa3hTVkVwRVRWWkdVVnBXUlJBQhAA"],"https://business.google.com/local/business/4634296749281698316/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFuZVZVeVVtRmFNV3gxV210b1NsbFlVa3hTVkVwRVRWWkdVVnBXUlJBQhAA",[null,null,null,"/local/business/4634296749281698316/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFuZVZVeVVtRmFNV3gxV210b1NsbFlVa3hTVkVwRVRWWkdVVnBXUlJBQhAA"],null,"https://business.google.com/local/business/4634296749281698316/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFuZVZVeVVtRmFNV3gxV210b1NsbFlVa3hTVkVwRVRWWkdVVnBXUlJBQhAA",[null,null,null,"/local/business/4634296749281698316/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFuZVZVeVVtRmFNV3gxV210b1NsbFlVa3hTVkVwRVRWWkdVVnBXUlJBQhAA"],null,["zh-Hant"],[["感謝您的支持及回饋！\n我們會持續用心做好每一份