E:DINE_IN"],"內用",2,null,null,"0ahUKEwjI963y8NSWAxVzafUHHR0jG2sQ3YcHCGMoAA"]],1],null,null,"訂單類型",null,"0ahUKEwjI963y8NSWAxVzafUHHR0jG2sQ3IcHCGIoEw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjI963y8NSWAxVzafUHHR0jG2sQ3YcHCGUoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjI963y8NSWAxVzafUHHR0jG2sQ3IcHCGQoFA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjI963y8NSWAxVzafUHHR0jG2sQ3YcHCGcoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjI963y8NSWAxVzafUHHR0jG2sQ3IcHCGYoFQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjI963y8NSWAxVzafUHHR0jG2sQ3IcHCGgoFg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjI963y8NSWAxVzafUHHR0jG2sQ3IcHCGkoFw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjI963y8NSWAxVzafUHHR0jG2sQ3IcHCGooGA",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["北大特區巷弄裡的拉麵新勢力：麵匡匡拉麵，顛覆濃重口味的清爽系首選！\n誰說拉麵一定要濃稠到化不開？這家落腳在社區樓下、做你「最親切鄰居」的麵匡匡職人拉麵，真的打破了傳統日式拉麵鹹膩的框架。下樓就能享用的平價好味道，加上極高的CP值，絕對是近期最值得推薦的口袋名單。\n\n🍜 湯頭的藝術：\n清爽與醇厚的完美平衡\n以前吃習慣了厚重的豚骨湯頭，偶爾換換口味嘗試雞白湯真的很驚艷。店家主打改良版的清淡湯頭，喝起來少了負擔、多了鮮甜，卻依舊能感受到基底的醇厚層次。\n\n這次品嚐了兩款主打：\n• 川味炙燒牛： 湯頭濃郁而不油膩，牛肉與海鮮的鮮味完美融合在湯底中。最貼心的是，碗裡的蝦子竟然是剝好殼的！完全不用沾手就能優雅享用。\n• 豚骨叉燒： 經典的風味在改良後變得更耐喝，鹹淡適中，就算把整碗湯喝完也不會覺得口渴。\n\n🥢 客製化體驗與必點小食\n這裡的點餐彈性很高，細麵可以自選軟硬度（個人推薦「硬」，吸附湯汁後口感剛好），而粗麵的熟度則是固定，嚼勁十足。\n• 唐揚炸雞： 外皮酥脆內裡多汁，是配拉麵的不二之選。\n• 煉乳糰子： 這道甜點是用「烤」的，強烈建議一定要趁熱吃，軟糯焦香伴隨煉乳甜味，超療癒！\n\n📱 聰明點餐：LINE好友福利\n作為新開幕的店家，服務流程卻意外穩健，店內五六位人手各司其職，候餐時間縮短不少。\n• 小撇步： 加入官方LINE好友，不只有註冊禮（免費一份叉燒肉），還能事先線上點餐，節省現場等待時間。\n\n🏠 用餐環境與服務\n店內裝潢簡約，雖然座位區偏少，尖峰時段可能需要排隊，但整體氛圍很溫馨。點餐採掃碼點餐、臨櫃付款的方式，店員態度親切有禮，給人一種回家的親切感。\n\n總結：\n如果你正在尋找一碗鹹淡適中、天天吃都不膩的好拉麵，麵匡匡北大店絕對值得你特地造訪。這份平價卻不平凡的滋味，正悄悄改變這座城市的拉麵地圖！\n推薦指數： ⭐⭐⭐⭐⭐\n貼心提醒： 建議離峰時段前往，或先用LINE點餐才不會久候喔！",null,[0,131]]]],[null