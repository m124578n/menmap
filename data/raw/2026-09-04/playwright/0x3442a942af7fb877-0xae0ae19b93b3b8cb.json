l,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3YcHCOYBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3IcHCOUBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3YcHCOgBKAA"],[["E:DINING_SEATING_TYPE_BAR_AREA"],"酒吧區",2,null,null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3YcHCOkBKAE"]]],null,"座位類型",null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3IcHCOcBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["第一次來吃，因為懷念以前在橫濱留學常吃的家系拉麵就衝到台北這間拉麵店。\n\n店員很親切，對初訪的客人會介紹每項餐點。我點的是醬油豚骨DX拉麵，很適合想吃到叉燒肉和溏心蛋又不想點太多肉的我😁。雖說選擇瘦肉，但其實肉的肥瘦剛好，且厚度很厚（見圖）。\n\n店員一開始會詢問湯麵稍濃稍硬O不OK，基本上應該是預設湯濃度和麵條硬度為「普通」。我覺得其實很剛好，湯都差點要喝完。有機會還想試試更濃更硬一點的口味。海苔兩大片很過癮，蔬菜給的是定番菠菜，我還單點了豆芽菜，整體很均衡，女生吃起來也不會覺得太多或油膩。\n\n環境整體不錯，空間不擠，空調剛好，下次再訪的話想嘗試辣味的拉麵。\n\nP.S. 假日約晚上六點半到訪，還不用排隊直接進入。快七點鐘人就比較多需要稍微等一下。",null,[0,35]]]],[null,null,null,null,null,"https://business.google.com/local/business/12775098029610100183/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDYjFveU5WUlZiR015VkVkV1NWUXlhR3hhTURrMVYydEtVV1JGUlJBQhAA",[null,null,null,"/local/business/12775098029610100183/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDYjFveU5WUlZiR015VkVkV1NWUXlhR3hhTURrMVYydEtVV1JGUlJBQhAA"],"https://business.google.com/local/business/12775098029610100183/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDYjFveU5WUlZiR015VkVkV1NWUXlhR3hhTURrMVYydEtVV1JGUlJBQhAA",[null,null,null,"/local/business/12775098029610100183/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDYjFveU5WUlZiR015VkVkV1NWUXlhR3hhTURrMVYydEtVV1JGUlJBQhAA"],null,"https://business.google.com/local/business/12775098029610100183/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDYjFveU5WUlZiR015VkVkV1NWUXlhR3hh