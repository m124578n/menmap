,null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3YcHCF8oAA"]],[1]],null,"建議的餐點",null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3IcHCF4oDA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_MODERATE"],"有點吵雜",2,null,null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3YcHCGEoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3IcHCGAoDQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3YcHCGMoAA"]],1],null,null,"等待時間",null,"0ahUKEwjHz6Or8tSWAxXwdfUHHTzGDDsQ3IcHCGIoDg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["一入店就能感受到店員們的熱情與禮貌，整體服務態度很好。帶位入座後會立即遞上菜單，說明也很清楚\n拉麵可以自由選擇：\n✔ 湯頭鹹淡\n✔ 麵條硬度\n✔ 叉燒肥瘦\n而且中午時段可免費加麵或加飯‼️ 很加分\n桌上備有冰水，冰塊快融化時店員還會主動更換新的一壺，細節很到位\n\n🍜 味玉豚骨醬油拉麵 $260\n湯頭非常濃郁，直接喝會偏鹹，也可以當成沾麵吃。下次回訪可能會選淡一點的調味～\n麵條不算細，我選硬度「硬」，口感有嚼勁，很不錯！\n溏心蛋🥚給一整顆未對切，熟度剛剛好\n叉燒厚實、肉香十足，燉煮得很軟嫩完全不塞牙。不過味道偏原始豬肉香，怕豬腥味的人可能會在意，我個人是很喜歡這種風味。選瘦叉燒會是梅花肉，肥的則是五花肉🐷\n配料有蔥和菠菜，沾著湯吃很好吃\n海苔給得超大片，但本身就有鹹度，泡進濃湯裡會變得非常鹹 😵\n\n整體日式氛圍濃厚，裝潢用心，服務態度一百分。拉麵風味也相當接近日本道地口味 ❤️\u200d🔥\n⚠️ 付款方式僅收現金，沒有提供載具，會直接給發票",null,[0,63]]]],[null,null,null,null,null,"https://business.google.com/local/business/12775098029610100183/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrVkZwc09YSlNla3BGVTBaU1QxTXpaSE5YYWxJMFZVUldkVTVXUlJBQhAA",[null,null,null,"/local/business/12775098029610100183/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrVkZwc09YSlNla3BGVTBaU1QxTXpaSE5YYWxJMFZVUldkVTVXUlJBQhAA"],"https://business.google.com/local/business/12775098029610100183/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrVkZwc09YSlNla3BGVTBaU1QxTXpaSE5YYWxJMFZVUldkVTVXUlJBQhAA",[null,null,null,"/local/business/12775098029610100183/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrVkZwc09YSlNla3BGVTBaU1QxTXpaSE5YYWxJMFZVUldkVTVXUlJBQhAA"],null,"https://business.googl