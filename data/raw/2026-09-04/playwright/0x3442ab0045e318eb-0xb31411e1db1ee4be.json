],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSURmNE1tN1JREAE"]],"CIHM0ogKEICAgIDf4Mm7dQ",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ3YcHCOYBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ3IcHCOUBKAs",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ3YcHCOgBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ3IcHCOcBKAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ3YcHCOoBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ3IcHCOkBKA0",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ3IcHCOsBKA4",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ3IcHCOwBKA8",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ3IcHCO0BKBA",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["平日晚上大概8點到，門口就有菜單附圖參考，剛好都沒有人就入內點餐，店內都是吧台座，只收現金，桌上菜單填寫完給店員即可，桌上餐具、飲具自取，點了特製赤味增牛骨白湯拉麵，麵粗。\n內容物：牛肉數塊、玉米筍、海苔一片、糖心蛋一顆、馬鈴薯一塊。\n湯面呈紅色油面，看起很辣的樣子，實際上卻不會，拌勻為橘紅色，口感為輕湯口感非稠狀的，口味滿濃郁的，微辣但又不會很鹹，鹹香濃郁，吃完也不會太油膩，湯裡面也有一些肉末，別有一番風味。\n粗麵條約3mm左右，硬度沒得調整，我覺得算中等，斷面看不到麵芯，咬下去還是有一定的硬度回彈，不粉爛，可以免費加一球麵，只能指定細麵，細麵粗度約2mm，細麵口感就比較好一點，彈牙的回饋感比較好，可能一煮好就吃，泡在湯裡的時間比較短，我自己偏愛吃硬的麵，覺得細麵比較優。\n牛肉還蠻多的，都有一定的厚度，起碼都一公分起跳，有牛排部位、牛肉塊、肋條。牛肉的部分都有一定的韌度，口感比較紮實有料，咬起來不太嫩，肋條口感就比較好，Q又軟嫩。\n糖心蛋蛋黃為膏狀，蛋黃附近的蛋白又呈半熟熔融狀態，整體口感軟嫩，蛋香很足。我自己是很不愛馬鈴薯等塊莖類的純澱粉的菜味，所以不太曉得馬鈴薯在這邊的定位，就單純水煮整顆只靠湯底配？擔任澱粉主食嗎？不是就有麵了嗎？會覺得馬鈴薯有點多餘。\n整體來說可能以牛肉的形式去做拉麵，既定印象會拿牛肉麵作比較，如果湯底或是肉沒有處理好，會相較覺得說我怎麼不吃牛肉麵就好了，湯底部分是有創新的部分，但牛肉就真的覺得還好，加上湯底有點微香辣，讓我覺得像吃比較濃郁紅燒的錯覺，吃下去不看畫面可能覺得就會是，撇除馬鈴薯，沒有其他都還可以。",null,[0,117]]]],[null,null,null,null,null,"https://business.google.com/local/business/11585516320168307043/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm1ORTF0TjFKUkVBRRAA",[null,null,null,"/local/business/11585516320168307043/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm1ORTF0TjFKUkVBRRAA"],"https://business.google.com/local/business/11585516320168307043/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm1ORTF0TjFKUkVBRRAA",[null,null,null,"/local/business/11585516320168307043/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm1ORTF0TjFKUkVBRRAA"],null,"https://business.google.com/local/business/11585516320168307043/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm1ORTF0TjFKUkVBRRAA",[null,null,null,"/local/business/11585516320168307043/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm1ORTF0TjFKUkVBRRAA"]],[null,null,6753,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSURmNE1tN1JREAE!2m1!1s0x0:0xb31411e1db1ee4be!3m1!1s2@1:CIHM0ogKEICAgIDf4Mm7RQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSURmNE1tN1JREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSURmNE1tN1JREi4KF0NJSE0wb2dLRUlDQWdJRGY0TW03eFFFEhNDZ3dJcUp2ZnV3WVFrSmpZdVFFGi0KFkNJSE0wb2dLRUlDQWdJRGY0TW03SlESE0Nnd0lxSnZmdXdZUWtKall1UUUiEgkAAAAAAAAAABG-5B7b4REUsyoLMGJTd3FjTUNWa0Y\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQoykI7gEoEQ"],null,[null,[[1,0]]]],"0ahUKEwjiw4jP8dSWAxVCeF4EHemyOCgQ0pMFCIIBKAc"],null,null,null,"0ahUKEwjXvP3O8dSWAxXqUvUHHbHcDeQQ0pMFCM8BKAc"]],null,null,null,"other_user_google_review_posts__and__hotel_and_vr_partner_review_posts",null,"CjEIARIpCgoAP7_LASRs____EhBeuE9ueNRlGbuLonAAAAAAGgn92RwCa9QEpjoYACIA"]],null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"11585516320