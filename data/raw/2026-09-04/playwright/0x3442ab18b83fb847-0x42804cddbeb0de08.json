"],"$200-400",2,null,"$200 到 $400","0ahUKEwi9_N-M8dSWAxWwhq8BHRxpAE4Q3YcHCHIoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi9_N-M8dSWAxWwhq8BHRxpAE4Q3IcHCHEoCg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi9_N-M8dSWAxWwhq8BHRxpAE4Q3IcHCHMoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi9_N-M8dSWAxWwhq8BHRxpAE4Q3IcHCHQoDA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi9_N-M8dSWAxWwhq8BHRxpAE4Q3IcHCHUoDQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi9_N-M8dSWAxWwhq8BHRxpAE4Q3YcHCHcoAA"]],1],null,null,"等待時間",null,"0ahUKEwi9_N-M8dSWAxWwhq8BHRxpAE4Q3IcHCHYoDg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["大約5年前就來吃過蒝山拉麵，這次恰巧來旁邊的復健治療診所復健，順便跟家人再來吃，這次點濃厚系鴨白湯拉麵（軟麵），家人分別點淡麗系鹽味拉麵及濃厚泡系拉麵，湯頭還是好吃而且濃郁，三片薄切鴨肉片口感好，倒是湯裡面的兩片雞肉吃起來口味更好吃，食量大的人還可以免費加一球麵，已經好久沒把湯喝完，唯一美中不足是老闆跟老闆娘太忙著煮好吃的麵，稍微冷淡些。很推薦喜歡吃日式拉麵的人來嚐嚐美食。",null,[0,188]]]],[null,null,null,null,null,"https://business.google.com/local/business/3699594556429945951/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyZDFnd1JYUmtlbVIxWWxkc2NXVnVaRkZOUmxadVUxVjRjbFp1WXhBQhAA",[null,null,null,"/local/business/3699594556429945951/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyZDFnd1JYUmtlbVIxWWxkc2NXVnVaRkZOUmxadVUxVjRjbFp1WXhBQhAA"],"https://business.google.com/local/business/3699594556429945951/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyZDFnd1JYUmtlbVIxWWxkc2NXVnVaRkZOUmxadVUxVjRjbFp1WXhBQhAA",[null,null,null,"/local/business/3699594556429945951/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyZDFnd1JYUmtlbVIxWWxkc2NXVnVaRkZOUmxadVUxVjRjbFp1WXhBQhAA"],null,"https://business.google.com/local/business/3699594556429945951/customers/re