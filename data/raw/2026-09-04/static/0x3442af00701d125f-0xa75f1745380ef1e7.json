/type/establishment_poi/has_wheelchair_accessible_entrance","無障礙入口",[1,[[1,"無障礙入口"]],[1,"無障礙入口","無障礙入口","提供無障礙入口"]],null,[4],0]]]]],null,null,null,null,null,null,null,null,null,"zh-TW",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,0,null,null,null,[[[["萬家福 天母店","0x3442ae912b1a6077:0xb5c1c437ec92e2d9",null,null,null,"0ahUKEwituv3l9NSWAxX-kmoFHQG4JxoQg7cGCBsoDw"]],1,1]],null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["一階堂IKAIDO傳承日本拉麵職人的精神，究極拉麵之美味體驗。有別於其他職人拉麵，一階堂精挑細選台灣當地的新鮮梅花豬，將食材的鮮美與日本的傳統拉麵工藝完美結合。\n\n製作一階堂叉燒的過程長達18小時，經過繁複的層層工序，新鮮的梅花肉首先以高達250度的火候炙烤，透過梅納反應將多餘的油脂慢慢化開，同時鎖住豐富的肉汁，讓每一片叉燒都充滿濃郁香氣與多層次口感。炙烤後，叉燒進行第二道工序，需要在72度進行舒肥慢煮，這一過程不僅讓肉質內部更加柔嫩多汁，還能讓風味更豐富。\n\n我們堅持選用日本原裝特級濃口醬油與刺身醬油作為基底，細緻熬煮豬大骨與雞骨，再輔以昆布與小魚乾等乾貨，每一口湯與叉燒肉完美融合，提供低鈉卻濃郁的日式拉麵口感。\n\n一階堂IKAIDO希望傳達日本傳統拉麵技藝與台灣在地食材的完美結合，從博多細麵到筍乾皆出自我們獨家研發製作，貫穿我們日本拉麵職人的精神，究極拉麵的熱愛。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh3.googleusercontent.com/-DSNvSL8KFtU/AAAAAAAAAAI/AAAAAAAAAAA/qCXUXlyoroQ/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市士林區蘭興里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"18285782206250339063","106842725486173035747"],null,[[[7,[["一階堂拉麵 天母店"],["111臺北市士林區蘭興里德行西路47號"]]],[2,[["111臺北市士林區蘭興里德行西路47號一階堂拉麵 天母店"]]],[1,[["111臺北市士林區蘭興里德行西路47號"]]],[4,[["臺北市士林區蘭興里"]]]],[null,"德行西路47號","德行西路47號","蘭興里","111","臺北市士林區","TW",["1 樓"]],["0ahUKEwituv3l9NSWAxX-kmoFHQG4JxoQqtMBCAkoBg",["7QQ34G4F+42"],["4G4F+42 蘭興里 臺北市士林區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[["星期五",5,[2026,9,4],[["11:00–20:30",[[11],[20,30]]]],0,1]],[["星期五",5,[2026,9,4],[["11:00–20:30",[[11],[2