],[0,"不提供無障礙座位","無障礙座位","不提供無障礙座位"]],1,[2],0],["/geo/type/establishment_poi/has_wheelchair_accessible_parking","無障礙停車場",[1,[[0,"不提供無障礙停車場"]],[0,"不提供無障礙停車場","無障礙停車場","不提供無障礙停車場"]],1,[2],0]]]]],null,null,null,null,null,null,null,null,null,"zh-TW",null,null,null,null,null,null,null,null,null,null,null,[["Hiro's らぁ麵 Kitchen Express","https://lh5.googleusercontent.com/-D4MZ3oAmxFU/AAAAAAAAAAI/AAAAAAAAAAA/NEZw8aHW2F0/s40-c-k-mo/photo.jpg"],null,1],null,null,null,null,null,null,null,0,null,null,null,[[[["Mitsui Shopping Park LaLaport 南港","0x3442ad0038e0034b:0x3ca02f9afeace511",null,null,null,"0ahUKEwi3zf7r9dSWAxXEgK8BHZluHF8Qg7cGCB4oEg"]],1,1]],null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["Hiro’s らぁ麵 Kitchen Express 位於南港 LaLaport 5F 美食街，是人氣南港拉麵推薦餐廳之一。主打正宗福岡豚骨拉麵、魚介豚骨拉麵與日式豬排定食，湯頭以 100% 天然食材長時間熬煮，濃郁不膩。隨餐附上的檸檬片建議於中段加入，能帶出令人驚喜的清爽層次。\n\n鄰近南港展覽館捷運站與電影院，方便上班族、家庭、情侶、看展或看電影後前來用餐。\n\n以「讓全家都愛吃的拉麵」為理念，Hiro’s 將福岡家鄉味原汁原味呈現，提供吃飽又吃好的幸福選擇。\n\nLocated on the 5th floor of LaLaport Nangang, Hiro’s Ramen Kitchen Express serves authentic Fukuoka-style Tonkotsu ramen and Japanese pork cutlet meals. The natural broth is rich yet refreshing — add the lemon slice halfway for a fresh twist.\n\n南港LaLaport5階にあるHiro’sらぁ麵Kitchen Expressは、本場福岡の豚骨ラーメンと日式とんかつ定食を提供。100％天然スープは濃厚で後味すっきり。途中でレモンを加えると爽やかな風味が広がります。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-D4MZ3oAmxFU/AAAAAAAAAAI/AAAAAAAAAAA/NEZw8aHW2F0/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市南港區環河里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"8201396204119197540","107375071170109412302"],null,[[[7,[["Hiro's らぁ麵 Kitchen Express"],["115臺北市南港區環河里經貿二路131號"],[