PE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjM98yC89SWAxU3SGwGHZJ6FLAQ3YcHCDwoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjM98yC89SWAxU3SGwGHZJ6FLAQ3IcHCDsoCA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjM98yC89SWAxU3SGwGHZJ6FLAQ3IcHCD0oCQ",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjM98yC89SWAxU3SGwGHZJ6FLAQ3IcHCD4oCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjM98yC89SWAxU3SGwGHZJ6FLAQ3IcHCD8oCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjM98yC89SWAxU3SGwGHZJ6FLAQ3YcHCEEoAA"]],1],null,null,"等待時間",null,"0ahUKEwjM98yC89SWAxU3SGwGHZJ6FLAQ3IcHCEAoDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["店鋪不算太大但是翻桌蠻快\n店家很貼心不用一定要一個人一碗\n再來值得稱讚的是\n就算2人共食一碗還是可以加麵\n雖然我是沒有打算加啦\n但他們還是很細心一直詢問\n\n湯頭鹹度可以調整\n麵條軟硬也可以選擇\n只有兩種口味我點了麻辣的\n\n美中不足的是並沒有很辣\n桌上的辣椒加了也還是不辣\n我把麵條撈起來加辣椒跟白醋超好吃\n應該再加點蒜泥的\n\n湯頭有點麻奶鍋的感覺\n麵條像韓式泡麵\n沒有到特別好吃也沒有難吃\n一切中規中矩\n以這個價格算可以了\n內用有綠豆湯可以喝\n\n但是吃完後胃不是太舒服\n建議胃不好的謹慎服用",null,[0,37]]]],[],[null,null,7230,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tNemVrOXJTSE5MTkVaaU1EWmFabXB3Y1ZsaGMyYxAB!2m1!1s0x0:0x827fe15ce472d8a5!3m1!1s2@1:CAIQACodChtycF9oOkMzek9rSHNLNEZiMDZaZmpwcVlhc2c%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2tNemVrOXJTSE5MTkVaaU1EWmFabXB3Y1ZsaGMyYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2tNemVrOXJTSE5MTkVaaU1EWmFabXB3Y1ZsaGMyYxI-Ci9DQUlRQUNvZENodHljRjlvT2tNemVrOXJTSE5MTkVaaU1EWmFabXB3Y1ZsaGMyYxILMGVCRnRPbDZIQ3MaPgovQ0FJUUFDb2RDaHR5Y0Y5b09rTXplazlyU0hOTE5FWmlNRFphWm1wd2NWbGhjMmMSCzBlQkZ0T2w2SENzIhIJAAAAAAAAAAARpdhy5Fzhf4IqCzBlQkZ0T2w2SENz\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjM98yC89SWAxU3SGwG