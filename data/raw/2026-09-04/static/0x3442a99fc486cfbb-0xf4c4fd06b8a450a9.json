l,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25jeU4xVTNjREZUUzBGbVlYaG9NSFpHVkZoS2VXYxAB"]],"CIABIhDoWFWEJH_97IRPAvlkXcFh",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwin25iz9tSWAxVcEkQIHV4DGHcQ3IcHCGooBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwin25iz9tSWAxVcEkQIHV4DGHcQ3IcHCGsoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwin25iz9tSWAxVcEkQIHV4DGHcQ3IcHCGwoCQ",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["鬼金棒店長獨立出來開的拉麵，品項都很有鬼金棒加勝王影子，味道口味也不會差異太多，有加入一些不同的元素，酸辣味增拉麵相較鬼金棒定番，酸又再讓辣麻的厚重負擔有了緩衝，吃到後面的油膩感不會這麼重，而不定時的限定也是有一定程度上的水準，清湯類的限定都好吃。排隊等待時間不用太長，買完券之後有椅子可以坐著等待，算是膝蓋友善店家。\n最值得一提的是，阿姨的熱情招呼實在是太加分了，很像家裡長輩在關心你的感覺，親切又不會太過負擔，算起店裡的一個特色。",null,[0,217]]]],[null,null,null,null,null,"https://business.google.com/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVqZVU0eFZUTmpSRVpVVXpCR2JWbFlhRzlOU0ZwSFZrWm9TMlZYWXhBQhAA",[null,null,null,"/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVqZVU0eFZUTmpSRVpVVXpCR2JWbFlhRzlOU0ZwSFZrWm9TMlZYWXhBQhAA"],"https://business.google.com/local/business/1071064607437623902/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVqZVU0eFZUTmpSRVpVVXpCR2JWbFlhRzlOU0ZwSFZrWm9TMlZYWXhBQhAA",[null,null,null,"/local/business/1071064607437623902/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVqZVU0eFZUTmpSRVpVVXpCR2JWbFlhRzlOU0ZwSFZrWm9TMlZYWXhBQhAA"],null,"https://business.google.com/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVqZVU0eFZUTmpSRVpVVXpCR2JWbFlhRzlOU0ZwSFZrWm9TMlZYWXhBQhAA",[null,null,null,"/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVqZVU0eFZUTmpS