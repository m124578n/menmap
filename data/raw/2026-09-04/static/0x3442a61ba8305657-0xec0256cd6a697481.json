hUKEwiiopr08tSWAxXlja8BHbdwDwMQ3IcHCDkoBQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiiopr08tSWAxXlja8BHbdwDwMQ3IcHCDooBg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_VERY_QUIET"],"非常安靜",2,null,null,"0ahUKEwiiopr08tSWAxXlja8BHbdwDwMQ3YcHCDwoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiiopr08tSWAxXlja8BHbdwDwMQ3IcHCDsoBw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiiopr08tSWAxXlja8BHbdwDwMQ3YcHCD4oAA"]],1],null,null,"等待時間",null,"0ahUKEwiiopr08tSWAxXlja8BHbdwDwMQ3IcHCD0oCA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["小小的店面，簡單明瞭，菜單還有多種口味可以選擇，加75還能升級套餐，我是沒加，我點了一碗普通的拉麵（預算有限）$149，忘了是哪款……，不過整體都很不錯，我以為湯頭會很死鹹，結果沒有，喝起來是醇厚濃郁，麵條是Q彈有咬勁的（我應該是點粗的），肉片約三片，很軟嫩，所有食材都很入味，我覺得挺適合台灣人的口味。先吃原味，再加桌上的七味粉，嗯……我還喜歡原味，七味粉下去的香料味，蓋過原本拉麵的香味，很可惜。還有辣椒粉，會辣，但不會很辣，喜歡辣的可以加，不過綜合下來，我覺得還是吃原味的比較好吃。",null,[0,244]]]],[],[null,null,1965,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xFdGR6QkdZMWhXU0ROWGMzaFhSSEo0Y0VSMmVXYxAB!2m1!1s0x0:0xec0256cd6a697481!3m1!1s2@1:CAIQACodChtycF9oOlEtdzBGY1hWSDNXc3hXRHJ4cER2eWc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xFdGR6QkdZMWhXU0ROWGMzaFhSSEo0Y0VSMmVXYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xFdGR6QkdZMWhXU0ROWGMzaFhSSEo0Y0VSMmVXYxI-Ci9DQUlRQUNvZENodHljRjlvT2xFdGR6QkdZMWhXU0ROWGMzaFhSSEo0Y0VSMmVXYxILMGRKRzh5TVROOWQaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sRXRkekJHWTFoV1NETlhjM2hYUkhKNGNFUjJlV2MSCzBkSkc4eU1UTjlkIhIJAAAAAAAAAAARgXRpas1WAuwqCzBkSkc4eU1UTjlk\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiiopr08tSWAxXlja8BHbdwDwMQoykIPygJ"],null,[null,[[1,0]]]],"0ahUKEwj-8p_08tSWAxVCeF4EHemyOCgQ0pMFCAIoAA"],null,null,null,"0ahUKEwiiopr08tSWAxXlja8BHbdwDwMQ0pMFCDAoAA"],[["ChdDSUhNMG9nS0VOU0IyWmJRM