.929515479698484],[0,90],[3004,5325],75],"Sb2aapzeJKbA0PEPjfHQkQw","0ahUKEwjcprGW-tSWAxUmIDQIHY04NMIQzCcIcygF",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICM0oOiVw\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x6247a1ea92aed6f8",null,null,"0ahUKEwjcprGW-tSWAxUmIDQIHY04NMIQ-y4IdCgA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgICM0oOiVw"],[10,3,[5325,3004]],[null,null,null,null,null,null,null,["青原 （拉麵、丼飯）"]],[null,[[["Julier Yu"],"https://www.google.com/maps/contrib/103643797585837646042?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjUkdNvGC8eJi_F6M-7n3-EpfsDu21paGGdKtJISYYcUS-ZR__LxsA\u003ds120-c-rp-mo-ba12-br100",null,null,"103643797585837646042"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2019,8,27,12,null,null,null,null,["7 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICM0oOiVw\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x6247a1ea92aed6f8"]],1,null,null,null,null,null,null,["0","7081806967918745336"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSURVaWItd2hnRRAB"]],"CIHM0ogKEICAgICM0oOiVw",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["裝潢期間經過時有看到長瀨屋的老闆娘在裡面，所以今天去用餐時特別和服務人員確認過果然算是長瀨屋的分店。\n\n但是這邊的拉麵湯頭和麵條軟硬控制不太好，所以拉麵水準還是本店比較好。不過這邊拉麵定價也比長瀨屋便宜30元就是了。品質價格對照下來也算合理。\n\n丼飯的口味上，不推勝丼，豬排感覺是工廠批發的那種，不是現醃現做的口感所以不推。\n\n親子丼很推，裡面的雞肉和長瀨屋的炸雞一樣有用酒醃過的酒香而且很嫩。不過我覺得價位應該在 120 左右，140高了點。\n\n小菜表現一般，奇怪的是菜單上所謂的炸蝦其實是炸蝦捲…… 這點實在很怪啊！\n\n整體而言味道算中等水準，但這邊特色（和長瀨屋比較）應該是可以同時享用飯麵，有多一點選擇對我來說比較重要～ 所以給4星。",null,[0,121]]]],[null,1566910600000000,1566910600000000,"7 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQUFWS0Z4NE5EdnhrY1B3YkFBOER6dw%7CCAEQrcz1_gkiMAoZQ0hfQUFWS0Z4NE5EdnhrY1B3YkFBOER6dxoTQ2d3SWlOR1U2d1VRb055ZjJ3RQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKE