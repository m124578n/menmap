5.08198247136902],[0,90],[4032,3024],75],"1r2aaprNB6-Z0PEPsY2f4Ag","0ahUKEwiakLLZ-tSWAxWvDDQIHbHGB4wQzCcIcCgG",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDmiYboyQE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xc723b594a903b1cb",null,null,"0ahUKEwiakLLZ-tSWAxWvDDQIHbHGB4wQ-y4IcSgA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIDmiYboyQE"],[10,3,[3024,4032]],[null,null,null,null,null,null,null,["一前一町拉麵"]],[null,[[["HnCatherine420"],"https://www.google.com/maps/contrib/113101472236452750307?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjUfRBYQEc4Ma5zC9v4SlRG7WTAKp-BFjMj8sF-1EZ8zdFbBCWMK\u003ds120-c-rp-mo-ba12-br100",null,null,"113101472236452750307"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2022,2,1,10,null,null,null,null,["4 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDmiYboyQE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xc723b594a903b1cb"]],1,null,null,null,null,null,null,["0","-4097231585881640501"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSURtaVlibzBRRRAB"]],"CIHM0ogKEICAgIDmiYboyQE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["十二月時第一次造訪，整天工作下來充滿對拉麵的carving，希望能夠在此得到紓解。\n入門後到離開最鮮明的印象，莫過於殷勤招呼的服務生阿姨，店內當時客人不多，但她沒有閒下來，總是用心的介紹菜單、維持座位清潔和時時查看客人們的眼光及需求，沒有絲毫不耐與倦怠，以工時長又辛苦的餐飲業來說，這樣的態度是很難能可貴的，服務上我給五顆星。\n店內用餐環境普通，是經營多年但維持整潔的感覺，牆面上貼有許多老闆對於湯頭、食材以及調味上的堅持，希望讓大家嚐嚐他的「台式」拉麵，看得出來創業上很用心。\n第一次吃覺得蠻好的，雞牛雙拼拉麵中充滿筍乾、高麗菜、豆芽、洋蔥，且份量不少，（還有肉臊搭配非常奇妙）湯底熬煮用心，溶有一勺濃郁的蒜泥，不似一般同等價位的平價拉麵，離開後總想著要再來訪試試其他口味。\n後來下班多次路過都是售罄的告示，一直到一月多才再次吃到，點了特製雞白湯牛叉燒，第二次的食用經驗卻非常失望。所有菜單上提及的野菜配料都沒有了，只剩表面上的幾絲洋蔥、蔥花和菜梗（夾完發現真的沒有半片菜葉），怕是有所誤會還詢問了服務生，但只得到配料都會更換、不一定同菜單標示的說法及抱歉的眼神。我覺得若是因為近期原物料飛漲，其實可以提前告知客人，菜單上羅列的那些（一前一町引以為傲、與其他拉麵店做出區隔的）配菜都不會有，避免讓期待再訪的客人或老客戶覺得吃了完全不同的店。特地帶同事來，對方也覺得招牌拉麵內容並無特別之處，我們只好無語的結束了晚餐。\n很遺憾第二次的飲食經驗大打折扣，雖然以後不會再訪了，但希望原料價格穩定後，一前一町能夠再次回到當時讓我感動的平價台式拉麵店：）",null,[0,163]]]],[null,null,null,null,null,"https://business.google.com/local/business/18059999130257857617/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnRhVmxpYnpCUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/18059999130257857617/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnRhVmxpYnpCUlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/18059999130257857617/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnRhVmxpYnpCUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/18059999130257857617/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnRhVmxpYnpCUlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/18059999130257857617/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnRhVmxpYnpCUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/18059999130257857617/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnRhVmxpYnpCUlJSQUIQAA%3D%3D"]],[null,null,10317,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURtaVlibzBRRRAB!2m1!1s0x0:0xc723b594a903b1cb!3m1!1s2@1:CIHM0ogKEICAgIDmiYbo0QE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURtaVlibzBRRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURtaVlibzBRRRItChZDSUhNMG9nS0VJQ0FnSURtaVlib01REhNDZ3dJMDVia2p3WVFvTm1VMlFNGi4KF0NJSE0wb2dLRUlDQWdJRG1pWWJvc1FFEhNDZ3dJeEpUa2p3WVE0TEhucFFFIhIJAAAAAAAAAAARy7EDqZS1I8cqCzBXeUZoSXY4SG1W\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiakLLZ-tSWAxWvDDQIHbHGB4wQoykIcigH"],null,[null,[[1,9]]]],"0ahUKEwiFhrbZ-tSWAxXEuYoHHY2jN8QQ0pMFCDYoAw"],null,null,null,"0ahUKEwiakLLZ-tSWAxWvDDQIHbHGB4wQ0pMFCGQoAw"],[["ChdDSUhNMG9nS0VJQ0FnSUNLNGRLTGlRRRAB",["0x0:0xc723b594a903b1cb",null,1617882661857460,1617882861489197,[null,null,["https://www.google.com/maps/contrib/117791037396863606017/reviews?hl\u003dzh-TW"],null,null,["nancy Lin","https://lh