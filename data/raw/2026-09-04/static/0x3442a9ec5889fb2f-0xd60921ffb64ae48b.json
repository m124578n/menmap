l,null,null,null,[null,[10,"CIABIhBiwIAxUI8Fy3hIrYG_EWOm"],[10,3,[4032,3024]],[null,null,null,null,null,null,null,["麵屋 豚丸"]],[null,[[["昇哥"],"https://www.google.com/maps/contrib/103071969496860515615?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVSMCrv09iKDVJfVrG7bt03VMhhcuirLj4NoZU1afVpN2GT8kTOAg\u003ds120-c-rp-mo-ba12-br100",null,null,"103071969496860515615"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,5,8,13,null,null,null,null,["3 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhBiwIAxUI8Fy3hIrYG_EWOm\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xd60921ffb64ae48b"]],1,null,null,null,null,null,null,["0","-3023848292643838837"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pkUVdIUnRYMUYyTldOdVZtOWhXbEJQYUZFMlowRRAB"]],"CIABIhBiwIAxUI8Fy3hIrYG_EWOm",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiUs57c99SWAxU_klYBHUdVGKIQ3IcHCIQBKAM",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiUs57c99SWAxU_klYBHUdVGKIQ3IcHCIUBKAQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiUs57c99SWAxU_klYBHUdVGKIQ3IcHCIYBKAU",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這次造訪位於三重三和路上的「麵屋 豚丸」，店內裝修很有日本道地拉麵店的氛圍。當天點了招牌的醬油拉麵與一碗炙燒叉燒飯。從視覺上來看，拉麵非常吸睛，厚實的叉燒搭配上一大匙誠意十足的蒜泥，攪拌開後的香氣確實非常濃郁。\n\n但在口味上，這次的用餐體驗卻讓我有些退縮。**醬油湯頭的鹹度真的非常高**，第一口下去時，強烈的鹹感瞬間蓋過了湯底原本應有的層次與鮮甜。雖然店家有提供加熱水的服務，我也嘗試加水稀釋，但不知道是否因為醬底比例太濃縮，即便稀釋過後，整體的鹹味依舊相當刺舌，喝不了幾口就覺得負擔太重，很難完整品嚐湯頭的細節。\n\n相比之下，叉燒飯的表現還算穩定，美乃滋經過炙燒後的香氣搭配肉塊相當下飯。或許是因為我自己平時的飲食習慣沒那麼重口，真的吃不太習慣這種高鹹度的風格，對於追求正統日式重鹹口味的愛好者來說，這裡可能是天堂；但如果你是偏好平衡或清爽湯頭的人，建議要慎重考慮。\n\n整體來說，食材用料與份量都對得起價格，服務也算親切，但由於湯頭鹹度實在超出個人負荷，只能遺憾給予三顆星評價。建議想來挑戰的朋友，第一口湯千萬別喝太大口。",null,[0,105]]]],[null,null,null,null,null,"https://business.google.com/local/business/18192729366704652035/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrVVZkSVVuUllNVVl5VGxkT2RWWnRPV2hYYkVKUVlVWkZNbG93UlJBQhAA",[null,null,null,"/local/business/18192729366704652035/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrVVZkSVVuUllNVVl5VGxkT2RWWnRPV2hYYkVKUVlVWkZNbG93UlJBQhAA"],"https://business.google.com/local/business/18192729366704652035/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrVVZkSVVuUllNVVl5VGxkT2RWWnRPV2hYYkVKUVlVWkZNbG93UlJBQhAA",[null,null,null,"/local/business/18192729366704652035/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrVVZkSVVuUllNVVl5VGxkT2RWWnRPV2hYYkVKUVlVWkZNbG93UlJBQhAA"],null,"https://business.google.com/local/business/18192729366704652035/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrVVZkSVVuUllNVVl5VGxkT2RWWnRPV2hYYkVKUVlVWkZNbG93UlJBQhAA",[null,null,null,"/local/business/18192729366704652035/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrVVZkSVVuUllNVVl5VGxkT2RWWnRPV2hYYkVKUVlVWkZNbG93UlJBQhAA"]],[null,null,2700,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pkUVdIUnRYMUYyTldOdVZtOWhXbEJQYUZFMlowRRAB!2m1!1s0x0:0xd60921ffb64ae48b!3m1!1s2@1:CAIQACodChtycF9oOjdQWHRtX1F2NWNuVm9hWlBPaFE2Z0E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pkUVdIUnRYMUYyTldOdVZtOWhXbEJQYUZFMlowRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pkUVdIUnRYMUYyTldOdVZtOWhXbEJQYUZFMlowRRI-Ci9DQUlRQUNvZENodHljRjlvT2pkUVdIUnRYMUYyTldOdVZtOWhXbEJQYUZFMlowRRILMGR6VEc3b0R3OHcaPgovQ0FJUUFDb2RDaHR5Y0Y5b09qZFFXSFJ0WDFGMk5XTnVWbTloV2xCUGFGRTJaMEUSCzBkelRHN29Edzh3IhIJAAAAAAAAAAARi-RKtv8hCdYqCzBkelRHN29Edzh3\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiUs57c99SWAxU_klYBHUdVGKIQoykIhwEoBg"],null,[null,[[1,0]]]],"0ahUKEwjB8KPc99SWAxXygNYIHaczM9IQ0pMFCD8oAg"],null,null,null,"0ahUKEwiUs5