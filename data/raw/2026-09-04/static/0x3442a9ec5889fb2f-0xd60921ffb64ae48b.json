null,null,null,["3 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhAb9e4HrHcT5iOAL1CEuM7A\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xd60921ffb64ae48b"]],1,null,null,null,null,null,null,["0","-3023848292643838837"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25keWVYZFVjbTlKVjNCUkxUTjBWRWR3YzFWc1JVRRAB"]],"CIABIhAb9e4HrHcT5iOAL1CEuM7A",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiUs57c99SWAxU_klYBHUdVGKIQ3IcHCIwBKAI",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiUs57c99SWAxU_klYBHUdVGKIQ3IcHCI0BKAM",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiUs57c99SWAxU_klYBHUdVGKIQ3IcHCI4BKAQ",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["點兩碗\n限定的蝦豚骨\n醬油豚骨\n\n1.桌椅高度不協調，椅矮桌高，吃麵不方便\n2.叉燒看似多，軟嫩但無味\n\n3.初期鷹老推薦，店內也擺放鷹流那張像suica 的卡與鷹流名片，但用麵不是蘭丸那款比較有嚼勁的麵，而是類似白麵，已經點麵硬卻軟爛\n\n4.屬濃湯系最後只能加熱水而非清湯，加下去就沒味道了\n\n5.醬油豚骨，湯濃但死鹹帶苦不帶醬油香氣。同口味，以該地理位置，繞一下自強路過重陽橋到士林有更好選擇，\n\n6.蝦豚骨，初入口有蝦香味，中期後無味。\n原以為會是像過去鷹流體系內小櫻的樣子。\n不談定番蝦的一x、五之o，\n捷運再坐兩站道o同樣作為限定雞白湯蝦的味道好些。\n\n7.膝蓋友善，交通方便（捷運出口就到，機車路邊停車格好找）",null,[0,15]]]],[null,null,null,null,null,"https://business.google.com/local/business/18192729366704652035/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrZVdWWVpGVmpiVGxLVmpOQ1VreFVUakJXUldSM1l6RldjMUpWUlJBQhAA",[null,null,null,"/local/business/18192729366704652035/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrZVdWWVpGVmpiVGxLVmpOQ1VreFVUakJXUldSM1l6RldjMUpWUlJBQhAA"],"https://business.google.com/local/business/18192729366704652035/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrZVdWWVpGVmpiVGxLVmpOQ1VreFVUakJXUldSM1l6RldjMUpWUlJBQhAA",[null,null,null,"/local/business/18192729366704652035/customers/reviews/deletereply?p\u003dCkRDaTl