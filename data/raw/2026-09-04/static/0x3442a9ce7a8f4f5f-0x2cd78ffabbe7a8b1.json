心挑選的麵條和配料，以及友好的服務而聞名。無論您是想品嘗傳統的拉麵還是想探索新口味，我們都能滿足您的需求。我們期待著您的光臨！"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-GzOcRCSQ428/AAAAAAAAAAI/AAAAAAAAAAA/Xzy5T4N13oM/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市萬華區西門里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,[["02 2361 0026",[["02 2361 0026",1],["+886 2 2361 0026",2]],null,"0223610026",null,["tel:0223610026",null,null,"0ahUKEwilptTr-tSWAxXIbfUHHRXVBJUQ_doBCA0oCg"]]],null,null,[null,null,null,null,null,"9673365112040388517","111141733203357777035"],null,[[[7,[["麵屋 有漁"],["108臺北市萬華區西門里內江街51號"]]],[2,[["108臺北市萬華區西門里內江街51號麵屋 有漁"]]],[1,[["108臺北市萬華區西門里內江街51號"]]],[4,[["臺北市萬華區西門里"]]]],["西門","內江街51號","內江街51號","西門里","108","臺北市萬華區","TW"],["0ahUKEwilptTr-tSWAxXIbfUHHRXVBJUQqtMBCAkoBg",["7QQ32GR4+M4"],["2GR4+M4 西門里 臺北市萬華區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[["星期五",5,[2026,9,4],[["11:30–14:00",[[11,30],[14]]],["17:00–21:00",[[17],[21]]]],0,1]],[["星期五",5,[2026,9,4],[["11:30–14:00",[[11,30],[14]]],["17:00–21:00",[[17],[21]]]],0,1],1,2,null,["即將打烊：21:00 · 開始營業時間：週六11:30",[[0,4,[null,[4288635144,4294949673]]]]],["即將打烊：21:00 · 開始營業時間：週六11:30",[[0,4,[null,[4288635144,4294949673]]]]],null,[21],["營業時間",[[0,4,[null,[4281040703,4285388172]]]]]],5,null,null,["這個商家在 11 週前更新過"],1],null,1,null,null,[[null,null,25.041673,121.505298]],"ChDmi4npurUg5Y-w5YyX5biCWhMiEeaLiem6tSDlj7DljJcg5biCkgEQcmFtZW5fcmVzdGF1cmFudJoBI0NoWkRTVWhOTUc5blMwVkpRMEZuU1VSMk5XSmhNMVZCRUFF4AEA-gEECAAQDw",null,null,null,null,1,null,null,null,null,null,null,null,null,null,null,null,null,[["0x3442a9ce7a8f4f5f:0x2cd78ffabbe7a8b1",null,null,"/g/11svg0hbp8","ChIJX0-Pes6pQjQRsajnu_qP1yw","9673365112040388517","1