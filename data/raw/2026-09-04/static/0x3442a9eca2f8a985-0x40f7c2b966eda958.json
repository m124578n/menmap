oCg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiAuoTH8tSWAxXNjq8BHeD2M5EQ3IcHCHooCw",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["一進來掃碼就直接點了雙人套餐\n裡面可以加購鮮蝦雲吞\n但是只有寫：雲吞。\n送來之後男朋友咬了一口發現裡面是蝦！！\n我男朋友是一個對蝦過敏的人….\n跟店員反應就只會一直回我菜單上都有寫\n沒錯你們是有賣鮮蝦雲吞拉麵\n但是我們沒看到也沒打算點那碗拉麵\n只是單純點別的加購的話上面就是寫：雲吞兩個字\n我覺得該店東西還不錯吃 但這種東西應該要寫清楚\n有些人過敏是會吃死人的\n我男朋友雖然吃了不會死\n但是會全身都發癢還會吐🤮\n拜託可以改善嗎 不要害到下個客人。",null,[0,35]]]],[],[null,null,9498,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tkVFpXSlBZemMyU25seWJuaFRMVmRCYjJGeWJWRRAB!2m1!1s0x0:0x40f7c2b966eda958!3m1!1s2@1:CAIQACodChtycF9oOkdTZWJPYzc2SnlybnhTLVdBb2FybVE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2tkVFpXSlBZemMyU25seWJuaFRMVmRCYjJGeWJWRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2tkVFpXSlBZemMyU25seWJuaFRMVmRCYjJGeWJWRRI-Ci9DQUlRQUNvZENodHljRjlvT2tkVFpXSlBZemMyU25seWJuaFRMVmRCYjJGeWJWRRILMGREWnRHUHV1Z24aPgovQ0FJUUFDb2RDaHR5Y0Y5b09rZFRaV0pQWXpjMlNubHlibmhUTFZkQmIyRnliVkUSCzBkRFp0R1B1dWduIhIJAAAAAAAAAAARWKntZrnC90AqCzBkRFp0R1B1dWdu\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiAuoTH8tSWAxXNjq8BHeD2M5EQoykIeygM"],null,[null,[[1,0]]]],"0ahUKEwiluInH8tSWAxV3d14EHfx-OloQ0pMFCDYoAg"],null,null,null,"0ahUKEwiAuoTH8tSWAxXNjq8BHeD2M5EQ0pMFCGYoAg"],[["Ci9DQUlRQUNvZENodHljRjlvT25CT1VHNTFObWd5Y25KMk1VcElRbFpQWTJrMVgxRRAB",["0x0:0x40f7c2b966eda958",null,1765270903587907,1765270903587907,[null,null,["https://www.google.com/maps/contrib/113175978921866535736/reviews?hl\u003dzh-TW"],null,null,["Pony Liao","https://lh3.googleusercontent.com/a/ACg8ocIos8gBuMQGlm9lICDbrK_qRS1W8sLpsoOvrufN5CxfbXZDiw\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/113175978921866535736?hl\u003dzh-TW"],"113175978921866535736",null,307,1005,null,[1,7,1],3,["在地嚮導 · 307 則評論",null,null,null,null,[null,"0ahUKEwiAuoTH8tSWAxXNjq8B