.google.com/maps/contact/14718793?url\u003dhttps://maps.google.com/maps?cid%3D0x3442ad3067d89213:0x2efd10400116b75e"],["你是業主嗎？","https://business.google.com/create?hl\u003dzh-TW\u0026getstarted\u0026authuser\u003d0\u0026fp\u003d3385880361934698334\u0026gmbsrc\u003dtw-zh-TW-et-ip-mp-s-l~mkp%7Cclaimbz_aoc_a%7Crt_intercept_u\u0026ppsrc\u003dGMBSI"]]],null,null,null,[null,[["accessibility","無障礙程度",[["/geo/type/establishment_poi/has_wheelchair_accessible_seating","無障礙座位",[1,[[0,"不提供無障礙座位"]],[0,"不提供無障礙座位","無障礙座位","不提供無障礙座位"]],1,[2],0],["/geo/type/establishment_poi/has_wheelchair_accessible_parking","無障礙停車場",[1,[[0,"不提供無障礙停車場"]],[0,"不提供無障礙停車場","無障礙停車場","不提供無障礙停車場"]],1,[2],0]]]]],null,null,null,null,null,null,null,null,null,"zh-TW",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["四不相 是一個結合〖 占卜x 解惑 | 無人拉麵 | 空間租借 | 藝術創作 〗的生活場域\n\n四不相\n不是拒絕定義，而是不被定義限制。\n\n人之所以困住\n往往不是因為選項太少\n而是太早把自己放進既定的框架裡\n角色、標籤、期待與他人的眼光\n慢慢取代了我們對生活的理解與承擔\n\n不著相\n不是什麼都不要\n而是不再被表象牽著走\n當人願意為自己的選擇負責\n生活才真正開始流動\n四不相\n陪你活得清楚，而不是活得像誰\n\n我們提供四項服務：\n『 占卜 × 解惑 』（預約制）\n以陪伴與整理為核心，協助你釐清當下狀態與方向，\n不替你做決定，只陪你看懂自己。\n\n『 無人拉麵 』\n自助式、不被打擾的用餐方式，\n讓吃飯回到簡單、安靜與剛剛好的狀態。\n\n『 空間租借 』\n提供一個安穩、自在的空間，\n適合聚會、課程、分享與各式包場活動。\n\n『 藝術創作（曼陀羅）』\n透過曼陀羅創作，讓心慢下來，\n在創作中與自己相遇。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh6.googleusercontent.com/-l4uUihJO6_g/AAAAAAAAAAI/AAAAAAAAAAA/DcsCNRgF818/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市內湖區西康里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"2804050771376822077","106672998489378013011"],null,[[[7,[["四不相（24H無人拉麵、占卜x解