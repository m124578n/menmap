,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["天母發跡的連鎖拉麵店，餐點制式化，無法依個人喜好調整；沒有冰水，僅有自助飲水機提供冷、熱跟溫水。\n\n🔸塩味拉麵 立成製麵\n塩味湯頭相當清澈，入口鮮鹹帶有淡淡的菇類氣味，一開始還算不差，但吃到後面稍嫌單調，而且莫名的會有一股煮麵的鹼水味浮現；立成細麵口感略硬，切齒感較豪億俐落許多，很不錯；炙燒豬肉香氣迷人，肉味十足，好吃；舒肥雞肉也不差，但跟炙燒豬肉比起來遜色了不少。\n\n🔸期間限定 韓國牡春 立成製麵\n湯頭色白偏黃綠，口感略沙濁，入口後在鼻腔處會有股異樣的香氣，滋味鮮甘，雖說主打牡蠣，但卻缺乏醇厚的牡蠣味，反倒是有股類似皮蛋或濃豚湯發酵的奇妙韻味，另外還有股酒嗆感；細麵條，偏硬，切齒感俐落，口感很不錯；舒肥雞肉口感軟潤偏涼，還不錯吃。\n\n🔸日本炒麵\n黏口，鹹甜帶酸氣，個人不愛這種醬油+烏醋+美乃滋的味道；豬肉好吃。\n\n🔸溏心蛋\n蛋黃偏熟，味道一般。\n\n🔸自家金黃蘿蔔\n醃蘿蔔，脆甜爽口，好吃。\n\n🔸自家黃金翡翠\n醃娃娃菜，滋味甜口；個人比較喜歡蘿蔔的口感。\n\n🔸期間限定 韓國辣拌年糕\n中小辣；年糕很Q，咀嚼起來相當紮實，黑紅醬鮮甜香辣，很不錯。",null,[0,60]]]],[null,1773623577000000,1773623577000000,"5 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfUy10WUlXNGU0MWhxMUk1aVh0WHpGdw%7CCAEQrcz1_gkiMAoZQ0hfUy10WUlXNGU0MWhxMUk1aVh0WHpGdxoTQ2d3SW1iTGR6UVlRNHFlTF9BRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjVjvKn-dSWAxX8n68BHdlGC7AQ_2MIUigI"],"https://business.google.com/local/business/8746571777135930101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVVZSR2NEVlhha1l6VmtNeFNWWXdlSEJrUmtaWlZGZGFiRmRXUlJBQhAA",[null,null,null,"/local/business/8746571777135930101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVVZSR2NEVlhha1l6VmtNeFNWWXdlSEJrUmtaWlZGZGFiRmRXUlJBQhAA"],"https://business.google.com/local/business/8746571777135930101/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVVZSR2NEVlhha1l6VmtNeFNWWXdlSEJrUmtaWlZGZGFiRmRXUlJBQhAA",[null,null,null,"/local/business/8746571777135930101/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVVZSR2NEVlhha1l6VmtNeFNWWXdlSEJrUmtaWlZGZGFiRmRXUlJBQhAA"],null,"https://business.google.com/local/business/8746571777135930101/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHVVZSR2NEVlhha1l6VmtNeFNWWXdlSEJrUmtaWlZGZGFiRmRXUlJBQhAA",[null,null,null,"/local/business/8746571777135930101/customers/reviews/reply?p\u003dCkRDaTlEUV