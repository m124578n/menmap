ll,null,"服務",null,"0ahUKEwjIm4a_-NSWAxWbEzQIHXsGFDwQ3IcHCH0oBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjIm4a_-NSWAxWbEzQIHXsGFDwQ3IcHCH4oBg",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["不知道是我剛好吃到臭的肉還是怎麼樣\n此家店的評價都很高\n但本人1/5實際用餐結果是\n點了五號的麵 麵體是台式油麵的感覺\n湯頭也還可以 偏台式\n但叉燒完全是惡夢⋯⋯\n一端過來就有聞到隱約臭油味\n原本還以為是筍子的味道 結果一吃發現肉的豬體味很重\n不知道有沒有人懂體味很重的肉是什麼味道⋯\n茶泡飯鮭魚很大片 但沒什麼味道 圖片是我加了同行者在別間的餐的湯才會黃黃的\n其他都普通沒什麼好評價\n但就是 臭的肉⋯⋯\n\n後續有跟店員反映（這天的男店員人很好 給你點讚～）但得到的回覆是主廚說這是正常的味道\n當下家人無法接受此說法 直接把麵還他了（吃過覺得不對才端著去問的）因此我也沒拍到麵的照片\n以上 大家自行斟酌😌",null,[0,41]]]],[null,null,null,null,null,"https://business.google.com/local/business/11510591223002326412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTUdSVlNqUk1Wa3BUVFZaT2JsRnFRbk5PVm1SNFlsWk9VVlJYWXhBQhAA",[null,null,null,"/local/business/11510591223002326412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTUdSVlNqUk1Wa3BUVFZaT2JsRnFRbk5PVm1SNFlsWk9VVlJYWXhBQhAA"],"https://business.google.com/local/business/11510591223002326412/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTUdSVlNqUk1Wa3BUVFZaT2JsRnFRbk5PVm1SNFlsWk9VVlJYWXhBQhAA",[null,null,null,"/local/business/11510591223002326412/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTUdSVlNqUk1Wa3BUVFZaT2JsRnFRbk5PVm1SNFlsWk9VVlJYWXhBQhAA"],null,"https://business.google.com/local/business/11510591223002326412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTUdSVlNqUk1Wa3BUVFZaT2JsRnFRbk5PVm1SNFlsWk9VVlJYWXhBQhAA",[null,null,null,"/local/business/11510591223002326412/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTUdSVlNqUk1Wa3BUVFZaT2JsRnFRbk5PVm1SNFlsWk9VVlJYWXhBQhAA"]],[null,null,2872,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pnMGRVSjRMVkpTTVZOblFqQnNOVmR4YlZOUVRXYxAB!2m1!1s0x0:0x2b4ae40a35a399a9!3m1!1s2@1: