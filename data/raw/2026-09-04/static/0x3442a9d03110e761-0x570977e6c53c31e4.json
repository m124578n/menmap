ps://lh3.googleusercontent.com/gpms-cs-s/AFP8RcPfWN6w9L_qQTR4Sx72dv2ICJGNn6gYu78OBl8kTeSdX16kdayiMHem8ypLrUFPtzksBJa1rZtTNjGviJNhnklwutdaZuA_OUhiXFp51hfp2HBjJ1VioThZt6-GP469Ng1PGwFIWztKxYE\u003dmm,hls?ibw\u003d750000",3]]],null,null,["0","6271675789125366244"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25sR2FWSjVhMEozWTJ4NGNISndjSFV5VG1wdFNGRRAB"]],"CIABIhDxtL6f12rCh9IN6I5p723Y",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3YcHCEUoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3IcHCEQoDA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3YcHCEcoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3IcHCEYoDQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3YcHCEkoAA"]],1],null,null,"等待時間",null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3IcHCEgoDg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["【麵屋倫太郎】\n\n倫太郎已經改版換菜單了，我到現在才寫🤣\n\n🐓特盛醬油雞清湯拉麵 280元\n\n湯頭屬於甜口的醬油風味，和雞湯香氣融合得還不錯，整體走清爽路線。不過層次感稍微少了一點，喝到後面會覺得味道偏平淡。蔥絲蠻解膩的，我最後直接一口吃掉。\n\n麵條麵粉感偏重，嚼勁普通，但細麵很會吸湯，掛湯效果不錯。\n\n雞叉燒給了四片，厚度夠，帶著湯一起吃風味還不錯，邊緣有點微脆。不過肉質稍微偏柴，而且四片口感還不太一樣🤣\n\n叉燒炙燒感不算明顯，表現中規中矩；反而大片的舒肥豬比較驚喜，口感軟嫩，咬下去帶點爽感，我自己更喜歡這款。\n\n溏心蛋有點過熟，蛋黃沒有流心感，比較可惜。\n\n之後有機會再去試試新版菜單的其他品項。\n\n💫喜歡就幫我按讚收藏吧！\n✨歡迎追蹤 @shanotes12 挖掘更多美食 (●°u°●)」\n\n🏷️#新北美食 #新北必吃 #新莊美食 #新北拉麵 #拉麵推薦\n———————————————————————————\n🪧：新北市新莊區中港路537號\n🈺️：12:00-13:30，17:00-21:00\n❌：週一公休\n📌：@menya_rintaro\n🎏：2024.08.24",null,[0,28]]]],[null,null,null,null,null,"https://business.google.com/local/business/17468484675233334421/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVzUjJGV1NqVmhNRW96V1RKNE5HTklTbmRqU0ZWNVZHMXdkRk5HUlJBQhA