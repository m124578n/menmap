ull,null,null,"餐點",null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3IcHCHooBg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3IcHCHsoBw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3IcHCHwoCA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3YcHCH4oAA"]],1],null,null,"等待時間",null,"0ahUKEwjHmeml99SWAxXIc_UHHakLEGoQ3IcHCH0oCQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["點了限定版的拉麵跟一碗叉燒飯總共NT$330 我是在5點半開門時進去的，這個時間剛好沒有人在排隊，雖然我也不知道平常時需不需要排隊，反正5點半進場，這個時間應該比較沒有人。\n\n進到店裡之後，門口左手邊有台點餐機，先入座之後再利用點餐機點餐以及付款，點完了之後就等餐點上桌吧。\n\n拉麵先上來，除了麵本身之外內容物有叉燒（好像有鴨肉跟雞肉的樣子）、糖心蛋跟海苔，然後可以免費加一球麵，我覺得拉麵本身的味道還挺不錯的，只不過份量有點小。還蠻建議加一球面再吃的，這樣我覺得會比較剛好，但如果有點叉燒飯的人我覺得加半球就好了，加一球有點太多。叉燒飯的部分就一般般吧，我覺得沒什麼特別的然後肉切得有點小塊。",null,[0,86]]]],[null,null,null,null,null,"https://business.google.com/local/business/17468484675233334421/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhVDJSV2FHcFVNRkpzVmxod1VsRXhhRU5XYTA1WlZqTk9UV1ZyUlJBQhAA",[null,null,null,"/local/business/17468484675233334421/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhVDJSV2FHcFVNRkpzVmxod1VsRXhhRU5XYTA1WlZqTk9UV1ZyUlJBQhAA"],"https://business.google.com/local/business/17468484675233334421/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhVDJSV2FHcFVNRkpzVmxod1VsRXhhRU5XYTA1WlZqTk9UV1ZyUlJBQhAA",[null,null,null,"/local/business/17468484675233334421/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhVDJSV2FHcFVNRkpzVmxod1VsRXhhRU5XYTA1WlZqTk9UV1ZyUlJBQhAA"],null,"https://business.google.com/local/business/17468484675233334421/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhVDJSV2FHcFVNRkpzVmxod1VsRXhhRU5XYTA1WlZqTk9UV1ZyUlJBQhA