5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwi6-riC9tSWAxXaFjQIHYDuCiQQ3YcHCJkBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwi6-riC9tSWAxXaFjQIHYDuCiQQ3IcHCJgBKAw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["位在板新捷運站斜對面的全家旁邊的巷子走進去，對捷運族很方便\n\n和景安站的藏味拉麵是姐妹店\n不過店內空間非常大，是藏味的兩倍，若說藏味是傳統和式的日式風格，那麼藏月則是典雅的日式風格\n\n味道醇厚和藏味差不多，但是老闆新作的蒜辣豚骨拉麵，多了那一球蒜和自製的辣醬，和肉非常搭！\n夾起一片五花肉，裹起辣醬，辣醬中的糯米感完全把肥肉的油膩給取代，辣與肉的融合逼得我快速吸了幾口麵，再夾起一塊梅花肉，依舊裹著辣醬放入口中，嚼著那瘦肉滿滿的肉感混合著辣醬的香與辣，吞下後再配一杯冰開水，簡直是冰火兩重天，加上麵吃到飽，不用怕沒有麵可以配肉\n當加入第二碗麵的時候，一開始的蒜末跟辣醬已跟麵湯融合，自己主動變味，稍待片刻便可繼續大快朵頤\n\n明太子叉燒飯是每日限量的，在叉燒飯原有的基礎上在鋪蓋了一層的炙燒明太子醬，一口下去鹹香微辣在口中不停交替，仔細咀嚼可以咬著明太子顆粒玩，好吃是好吃，但是量太少\n\n推薦可以吃小辣的人點蒜辣豚骨拉麵，明太子叉燒飯必點",null,[0,44]]]],[],[null,null,787,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2psb2FEZ3pZa2xQTVVSSFIwcEpNMVJWVmpkak0yYxAB!2m1!1s0x0:0x79e98b630ae17cf3!3m1!1s2@1:CAIQACodChtycF9oOjloaDgzYklPMURHR0pJM1RVVjdjM2c%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2psb2FEZ3pZa2xQTVVSSFIwcEpNMVJWVmpkak0yYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2psb2FEZ3pZa2xQTVVSSFIwcEpNMVJWVmpkak0yYxI-Ci9DQUlRQUNvZENodHljRjlvT2psb2FEZ3pZa2xQTVVSSFIwcEpNMVJWVmpkak0yYxILMGVJQnRnRDZtNDMaPgovQ0FJUUFDb2RDaHR5Y0Y5b09qbG9hRGd6WWtsUE1VUkhSMHBKTTFSVlZqZGpNMmMSCzBlSUJ0Z0Q2bTQzIhIJAAAAAAAAAAAR83zhCmOL6XkqCzBlSUJ0Z0Q2bTQz\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi6-riC9tSWAxXaFjQIHYDuCiQQoykImgEoDQ"],null,[null,[[1,0]]]],"0ahUKEwjpjr6C9tSWAxXYZ0wIHV1ZN4MQ0pMFCFgoBA"],null,null,null,"0ahUKEwi6-riC9tSWAxXaFjQIHYDuCiQQ0pMFCIMBKAQ"]],null,null,null,"other_user_google_review_posts__and__hotel_and_vr_partner_review_posts",null,"CjEIARIpCgoAP7_LACcE____EhChOj_c-E4HRrwMMT4AAAAAGgn92PUCYhyflVcYACIA"]],null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"14814920011973008507","10344153806