l,null,null,null,["1 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhBgu4BQRy1BVmWV1xGvwA-8\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x5547712cc123659b"]],1,null,null,null,null,null,null,["0","6145004653603153307"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xwdFJUSXdWRzh0V2pCV05XcFpXbWxYWkhCaVRGRRAB"]],"CIABIhBgu4BQRy1BVmWV1xGvwA-8",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3YcHCMIBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3IcHCMEBKBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3YcHCMQBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3IcHCMMBKBE",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3IcHCMUBKBI",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3IcHCMYBKBM",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3IcHCMcBKBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11j9445k_z"],"豪華豚骨拉麵",2,null,null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3YcHCMkBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3IcHCMgBKBU",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3YcHCMsBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ3IcHCMoBKBY",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["週末晚上8點到，附近不太好停車，連摩托車也是，整體店面很大，滿寬敞的，都是吧台座，我來的時候只要等一位而已。點餐是販賣機出餐券，點了豪華豚骨拉麵（麵硬味鹹）、叉燒飯，販賣機只收現金，千元、五百、百元都收，出餐券候位大概等5分鐘就帶入座了，另外有跟服務人員說叉燒飯後上。桌面有冰水壺、調味料、筷子、衛生紙，水杯在飲水桶旁自取，餐點大概等10分鐘左右上，也蠻快的。\n拉麵內容物：兩片豬肉叉燒、溏心蛋一顆、蔥末木耳絲少許、海苔兩片。\n拉麵湯體土黃色，帶點油花，口感不是稠的，像是牛奶的潤滑感，雖然點口味鹹，但不會有鹹到苦澀感，我是覺得風味比較重而已，跟蔥末攪勻，蔥辛能舒緩油膩感，能單喝入喉的。麵體是細直麵，粗度約2mm左右，斷面看得到麵心，咬下也有帶點麵香的，回彈感也很夠，不分爛，滿好吃的。肉片還蠻大片的，佔了碗面8成有，厚度約3、4mm吧，肥瘦肉比約3:7，肥肉大多環繞瘦肉連結處，肉片是全熟處理加上稍微炙燒，因為肉片切的滿薄的，所以吃起來相對嫩一些、好咬，另外炙燒的原因加上薄，味道還滿像過年吃的肉乾香，還不錯吃的，而且份量也滿大片。溏心蛋劃開蛋黃接近快熟的膏狀，沒流體的狀態，蛋香也滿夠的，整體是好吃的拉麵。\n叉燒飯的份量大概一個成年男性拳頭大，上面是蛋黃醬炙燒，他的叉燒是有點像碎肉末的那種，都為瘦肉，但吃上面一口，我是覺得稍微鹹了一點帶炙燒香，味道比拉麵還要鹹，飯粒飽滿結實，後來發現他的醬汁沉的比較下面，需要攪拌均勻一點，配起來會比較甘甜一些，攪勻整碗吃完會比較好一點。\n整體用餐環境寬敞舒適，也很乾淨，拉麵蠻好吃的份量很夠，而且能免費加一球，我是因為還有叉燒飯要吃，所以就沒有額外添加了，如果口味比較淡的話，口味選正常即可，叉燒飯記得要拌勻，整體價格真的滿親民的，划算大碗。",null,[0,180]]]],[],[null,null,10346,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xwdFJUSXdWRzh0V2pCV05XcFpXbWxYWkhCaVRGRRAB!2m1!1s0x0:0x5547712cc123659b!3m1!1s2@1:CAIQACodChtycF9oOlptRTIwVG8tWjBWNWpZWmlXZHBiTFE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xwdFJUSXdWRzh0V2pCV05XcFpXbWxYWkhCaVRGRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xwdFJUSXdWRzh0V2pCV05XcFpXbWxYWkhCaVRGRRI-Ci9DQUlRQUNvZENodHljRjlvT2xwdFJUSXdWRzh0V2pCV05XcFpXbWxYWkhCaVRGRRILMGNUbktZNXBRY3IaPgovQ0FJUUFDb2RDaHR5Y0Y5b09scHRSVEl3Vkc4dFdqQldOV3BaV21sWFpIQmlURkUSCzBjVG5LWTVwUWNyIhIJAAAAAAAAAAARm2UjwSxxR1UqCzBjVG5LWTVwUWNy\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQoykIzAEoFw"],null,[null,[[1,0]]]],"0ahUKEwi89Ijp8tSWAxWU6IsBHQBhEakQ0pMFCHMoBA"],null,null,null,"0ahUKEwiFj4Pp8tSWAxUsQ_UHHcGXBGwQ0pMFCKEBKAQ"]],null,null,null,"other_user_google_review_posts__and__hotel_and_vr_partner_review_posts",null,"CjEIARIpCgoAP7_LAHJu____EhDgoxxPy38dGcioqs8AAAAAGgn92QACY-zvmjYYACIA"]],null,null,null,[3,1,null,null,null,[2]]],null,null,[["02 2280 0335",[["02 2280 0335",1],["+886 2 2280 0335",2]],null,"0222800335",null,["tel:0222800335",null,null,"0ahUKEwiFj4Pp8tS