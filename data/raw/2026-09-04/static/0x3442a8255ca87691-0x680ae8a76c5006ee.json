這碗 甜品吃到飽，ho-chia，好呷❤️"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-9YeiMpMbMEU/AAAAAAAAAAI/AAAAAAAAAAA/wI_qkLczP2w/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市板橋區埔墘里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"16054326150218020536","110507526650508438293"],null,[[[7,[["好呷拉麵 甜品吃到飽(板橋) *呷：ㄒㄧㄚˊ"],["220新北市板橋區埔墘里三民路二段203之3號"]]],[2,[["220新北市板橋區埔墘里三民路二段203之3號好呷拉麵 甜品吃到飽(板橋) *呷：ㄒㄧㄚˊ"]]],[1,[["220新北市板橋區埔墘里三民路二段203之3號"]]],[4,[["新北市板橋區埔墘里"]]]],[null,"三民路二段203之3號","三民路二段203之3號","埔墘里","220","新北市板橋區","TW"],["0ahUKEwjw_uGz89SWAxUwjVYBHQe5F7sQqtMBCAkoBg",["7QQ32F7H+FM"],["2F7H+FM 埔墘里 新北市板橋區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,[null,[["0ahUKEwjw_uGz89SWAxUwjVYBHQe5F7sQgLcGCA8oCw",["LGBTQ+ 友善空間"],null,"https://gstatic.com/local/placeinfo/lgbtq_friendly_ic_24dp.png","https://gstatic.com/local/placeinfo/lgbtq_friendly_ic_24dp.png",null,null,null,null,null,null,1],["0ahUKEwjw_uGz89SWAxUwjVYBHQe5F7sQ_rYGCBAoDA",["業主為女性的商家"],null,"https://gstatic.com/local/placeinfo/women_led_updated_ic_24dp.png","https://gstatic.com/local/placeinfo/women_led_updated_ic_24dp.png",null,null,null,null,null,null,1]],null,[[4,["0ahUKEwjw_uGz89SWAxUwjVYBHQe5F7sQgLcGCA0oCQ",["LGBTQ+ 友善空間"],null,"https://gstatic.com/local/placeinfo/lgbtq_friendly_ic_24dp.png","https://gstatic.com/local/placeinfo/lgbtq_friendly_ic_24dp.png",null,null,null,null,null,null,1]],[8,["0ahUKEwjw_uGz89SWAxUwjVYBHQe5F7sQ_rYGCA4oCg",["業主為女性的商家"],null,"https://gstatic.com/local/placeinfo/women_led_updated_ic_24dp.png","https://gstatic.com/local/placeinfo/women_led_updated_ic_24dp.png",null,null,null,null,null,null,1]]]],null,null,null,null,null,null,[[["星期五",5