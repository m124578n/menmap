OTIxNQ%3D%3D\u0026wfs\u003d1\u0026sc\u003d1\u0026ag\u003d2\u0026ag\u003d3\u0026ag\u003d4\u0026ag\u003d5\u0026ag\u003d6\u0026ag\u003d7\u0026ag\u003d1"]],["檢舉法律問題","https://support.google.com/legal/troubleshooter/1114905#ts\u003d9723198%2C7170398"],["檢舉商業行為","https://support.google.com/maps/contact/14718793?url\u003dhttps://maps.google.com/maps?cid%3D0x3442a9b5ee1cc617:0xefbef642041b4e31"],["你是業主嗎？","https://business.google.com/create?hl\u003dzh-TW\u0026getstarted\u0026authuser\u003d0\u0026fp\u003d17275515984036974129\u0026gmbsrc\u003dtw-zh-TW-et-ip-mp-s-l~mkp%7Cclaimbz_aoc_a%7Crt_intercept_u\u0026ppsrc\u003dGMBSI"]]],null,null,null,[null,[["accessibility","無障礙程度",[["/geo/type/establishment_poi/has_wheelchair_accessible_seating","無障礙座位",[1,[[0,"不提供無障礙座位"]],[0,"不提供無障礙座位","無障礙座位","不提供無障礙座位"]],1,[2],0],["/geo/type/establishment_poi/has_wheelchair_accessible_parking","無障礙停車場",[1,[[0,"不提供無障礙停車場"]],[0,"不提供無障礙停車場","無障礙停車場","不提供無障礙停車場"]],1,[2],0]]]]],null,null,null,null,null,null,null,null,null,"zh-TW",null,null,null,null,null,null,null,null,null,null,null,[["好呷拉麵 甜品吃到飽(三重) *呷：ㄒㄧㄚˊ","https://lh5.googleusercontent.com/-T4-hSmsFf7U/AAAAAAAAAAI/AAAAAAAAAAA/IrKgbxoxyeA/s40-c-k-mo/photo.jpg"],null,1],null,null,null,null,null,null,null,0,null,null,null,[[[["首都客運(總公司)","0x3442a918ca56bf2b:0x7daa5ceae4a8e1be",null,null,null,"0ahUKEwj5lIvl8tSWAxVrklYBHYVJON0Qg7cGCCAoEw"]],1,1]],null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["🌟 湯頭全面提升\n全新雞骨豚骨湯底，融入老母雞與豬大骨的精華，經12小時慢火熬煮，湯色乳黃、濃郁綿厚，滿滿的膠原蛋白與極致鮮味，讓每一口都像在擁抱溫暖的幸福。\n\n🌟 叉燒香氣升級\n以日本職人工法製作的五花肉燒肉叉燒，搭配國產純釀醬油低溫熟成，炙燒的梅納反應更添濃郁香氣。每一片叉燒都鎖住鮮甜肉汁，入口即化，滿足每一位饕客的期待。\n\n🌟 麵條口感升級\n嚴選美澳黃金小麥，經九道揉壓工法製成的26番切細麵，硬中帶Q，完美吸附湯頭精華。每一口麵條，都是精工細作的體現。\n好呷豆花的三大堅持 |\n✅ 天然非基改大豆：手工鹽滷製作，不含石膏，口感細緻滑嫩。\n✅ 40年傳承秘糖水：嘉義糖廠老員工的獨門技法，選用純甘蔗熬煮，濃郁不膩。\n✅ 綿密配料：飽滿紅豆、古早味大麥、低糖綠豆，每一口都是回憶的味道。\n\n甜品起家的何家，保留古早味！ 愛吃甜品的朋友們，來好呷拉麵，記得留點胃給這碗 「被拉麵耽誤的豆花」！甜品吃到飽，ho-chia，好呷❤️"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-T4-hSmsFf7U/AAAAAAAAAAI/AAAAAAAAAAA/IrKgbxoxyeA/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市三重區仁德里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"18397722655821309215","102412108358147449481"],null,[[[7,[["好呷拉麵 甜品吃到飽(三重) *呷：ㄒㄧㄚˊ"],["241新北市三重區仁德里正義南路15之1號"]]],[2,[["241新北市三重區仁德里正義南路15之1號好呷拉麵 甜品吃到飽(三重) *呷：ㄒㄧㄚˊ"]]],[1,[["241新北市三重區仁德里正義南路15之1號"]]],[4,[["新北市三重區仁德里"]]]],[null,"正義南路15之1號","正義南路15之1號","仁德里","241","新北市三重區","TW"],["0ahUKEwj5lIvl8tSWAxVrklYBHYVJON0QqtMBCAkoBg",["7QQ33F6X+M3"],["3F6X+M3 仁德里 新北市三重區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,[null,[["0ahUKEwj5lIvl8tSWAxVrklYBHYVJON0QgLcGCA4oCg",["LGBTQ+ 友善空間"],null,"https://gstatic.com/local/placeinfo/lgbtq_friendly_ic_24dp.png","https://gstatic.com/local/placeinfo/lgbtq_friendly_ic_24dp.png",null,null,null,null,null,null,1]],null,[[4,["0ahUKEwj5lIvl8tSWAxVrklYBHYVJON0QgLcGCA0oCQ",["LGBTQ+ 友善空間"],null,"https://gstatic.com/local/placeinfo/lgbtq_friendly_ic_24dp.png","https://gstatic.com/local/placeinfo/lgbtq_friendly_ic_24dp.png",null,null,null,null,null,null,1]]]],null,null,null,null,null,null,[[["星期五",5,[2026,9,4],[["11:00–14:30",[[11],[14,30]]],["17:00–22:00",[[17],[22]]]],0,1]],[["星期五",5,[2026,9,4],[["11:00–14:30",[[11],[14,30]]],["17:00–22:00",[[17],[22]]]],0,1],1,1,null,["營業中 · 打烊時間：22:00",[[0,3,[null,[4281040703,4285388172]]]]],["營業中 · 打烊時間：22:00",[[0,3,[null,[4281040703,4285388172]]]]],null,[21],["營業時間",[[0,4,[null,[4281040703,4285388172]]]]]],5,null,null,["這個商家在 7 週前更新過"],1],null,1,null,null,null,"ChDmi4npurUg5Y-w5YyX5biCWhMiEeaLiem6tSDlj7DljJcg5biCkgEQcmFtZW5fcmVzdGF1cmFudJoBI0NoWkRTVWhOTUc5blMwVkpRMEZuU1VSMk5XSmhNMVZCRUFF4AEA-gEECAAQDw",null,null,null,null,1,null,null,null,null