2026,8,6,15,null,null,null,null,["4 週前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhBjQsemB_afMnIF9ZDUsWuG\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xbe47e0c022a5a737"]],1,null,null,null,null,null,null,["0","-4735569367337162953"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25Vd2RXSm9SMFF6UzI1VFJWSXhNblJMUld0c0xYYxAB"]],"CIABIhBjQsemB_afMnIF9ZDUsWuG",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["台灣一蘭拉麵的排隊環境很友善，排隊區有冷氣和風扇，即使天氣炎熱也不會覺得悶熱。快輪到時還有椅子可以坐，對帶小朋友的家庭來說相當貼心。\n\n店家也很有兒童友善，只要 12 歲以下可以使用 一蘭App就可以兌換一碗兒童拉麵。我們另外加點了一份麵和海苔，份量就更剛好了。\n\n一般拉麵一碗 310 元，湯頭依舊濃郁好喝，麵條口感也不錯。不過比較可惜的是，叉燒不是完整肉片，而是碎叉燒，吃起來會有一點「料不夠豐富」的感覺，和期待中的一蘭叉燒有些落差。\n\n整體來說，環境舒適、服務貼心，很適合親子用餐\n\n2026/08/05",null,[0,131]]]],[null,null,null,null,null,"https://business.google.com/local/business/2366897063041063437/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVWZDJSWFNtOVNNRkY2VXpJMVZGSldTWGhOYmxKTVVsZDBjMHhZWXhBQhAA",[null,null,null,"/local/business/2366897063041063437/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVWZDJSWFNtOVNNRkY2VXpJMVZGSldTWGhOYmxKTVVsZDBjMHhZWXhBQhAA"],"https://business.google.com/local/business/2366897063041063437/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVWZDJSWFNtOVNNRkY2VXpJMVZGSldTWGhOYmxKTVVsZDBjMHhZWXhBQhAA",[null,null,null,"/local/business/2366897063041063437/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVWZDJSWFNtOVNNRkY2VXpJMVZGSldTWGhOYmxKTVVsZDBjMHhZWXhBQhAA"],null,"https://business.google.com/local/business/2366897063041063437/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVWZDJSWFNtOVNNRkY2VXpJMVZGSldTWGhOYmxKTVVsZDBjMHhZWXhBQhAA",[null,null,null,"/local/business/2366897063041063437/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVWZDJSWFNtOVNNRkY2VXpJMVZGSldTWGhOYmxKTVVsZDBjMHhZWXhBQhAA"]],[null,null,