659/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM1Nzk5NzQ2OTQxOTc3MjYzNTQw",null,null,null,null,null,["5799746941977263540","CIHM0ogKENCRtfzhxvKd1QE","CgwI79qFxgYQ4J6TzgI"]]],1],null,null,null,null,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["『赤』稱之忠誠，希望顧客吃完拉麵保有忠誠的態度。\n『麵廠』是想讓顧客用名稱感受到我們的格局，也讓每個加盟業主店鋪可以像麵廠一樣源源不絕的生意。\n※賣的不只是美食，而是將消失的文化。\n日本屋台，操受嚴格控管只能傳授一等親，傳授一代將面臨消失危機，為了下一代子孫也能親身體驗當地文化，『赤麵廠』遠到日本福岡中洲將這屋台１：１帶回台灣繼續傳承。\n店內每人低消130元，可免費加麵一次!店內有販售三款拉麵:\n\n● 天神豚骨拉麵 – 天神稱之為博多、顧名思義本店採用於博多\n湯頭製作、低鈉、低油脂。搭上選用中粗面作使用、滿足男人的飽足感、女人的順口嚼進感、再加上特製香油、喝完美口湯、都會有一股香氣衝上您的味蕾上鉤了上來、這就是《赤麵廠的本店招牌》\n● 激辛豚骨拉麵 – 本店唯一一款辣味拉麵、自製特製辣醬整體吃完不會太多的負擔、激辛拉麵不會太過於辣、保有完整的豚骨香氣加上些許的辣味、是不少饕客前訪回味。\n● 藤原味噌拉麵 – 採用日本的黑味噌、比起一般白味噌來的濃厚、\n喝起來的湯頭、有多重的層次感、配上手工綁至的叉燒肉及黃金蛋、是一個完美之作。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-v_kyeoxhBK8/AAAAAAAAAAI/AAAAAAAAAAA/U4mHTYqfdDM/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市中和區福真里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,[["02 2245 9797",[["02 2245 9797",1],["+886 2 2245 9797",2]],null,"0222459797",null,["tel:0222459797",null,null,"0ahUKEwiogJGD69GWAxUAma8BHbALICMQ_doBCA0oCg"]]],null,null,[null,null,null,null,null,"7920294578172927659","105585034505968790473"],null,[[[7,[["赤麵廠レッドラーメン - 中和本場"],["235新北市中和區福真里中山路二段284號"]]],[2,[["235新北市中和區福真里中山路二段284號赤麵廠レッドラーメン - 中和本場"]]],[1,[["235新北市中和區福真里中山路二段284號"]]],[4,[["新北市中和區福真里"]]]],[null,"中山路二段284號","中山路二段284號","福真里","235","新北市中和區","TW",["1 樓"]],["0ahUKEwiogJGD69GWAxUAma8BHbALICMQqtMBCAkoBg",["7QQ32F3W+2G"],["2F3W+2G 福真里 新北市中和區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[["星期四",4,[202