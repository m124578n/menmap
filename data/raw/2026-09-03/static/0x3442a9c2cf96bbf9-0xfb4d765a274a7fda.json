sgsSh3veLxAE\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5UMGXs2bgVjumjytXBWPmPH","0ahUKEwiC5Naw59GWAxXQoK8BHSnhKssQ544CCDIoHQ",null,"2026年7月10日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u17984583729565501971/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM1NzMzMzAyODMxMDE0MjMwNzM3","https://business.google.com/mm/posts/l/u17984583729565501971/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM1NzMzMzAyODMxMDE0MjMwNzM3",null,null,null,null,null,["5733302831014230737","CIHM0ogKEL7sgsSh3veLxAE","CgwIjLK_0gYQ2MbX9AI"]],[null,[[["【夏季限定｜旨辣雞白湯拉麵】\n\n濃厚雞白湯與特製辛香完美融合。\n\n先感受到雞白湯的醇厚與鮮甜，\n接著辣油與辛香料層層堆疊，\n帶來濃郁卻不膩口的風味。\n\n🍜 旨辣雞白湯拉麵｜290元\n🍜 招牌旨辣雞白湯拉麵｜390元\n\n由日本人經營，\n將日本拉麵職人的細節與台灣顧客喜愛的風味結合，\n打造屬於千雲的夏季限定拉麵。\n\n6月22日（週一）正式開賣\n\n📍麵屋千雲 全店販售",1]]],[1782093600,1797889803],null,null,[["https://lh3.googleusercontent.com/geougc/AF1QipNME5eRbgr42Z46Fh5BXjbRObQ4Sy6VndkNN653\u003dh400-no",1,null,"","AF1QipNME5eRbgr42Z46Fh5BXjbRObQ4Sy6VndkNN653"]],"510355787471614996","17984583729565501971",["https://www.google.com/search?sca_esv\u003d4665041cdc874088\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003d%E9%BA%B5%E5%B1%8B%E5%8D%83%E9%9B%B2+%E5%85%89%E8%8F%AF%E5%BA%97\u0026ludocid\u003d18108259806304960474\u0026lpsid\u003dCIHM0ogKEOzy4ubH_MXx_gE\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEOzy4ubH_MXx_gE,ar","/gmb/local_post/accounts%2F-%2Flocations%2F17984583729565501971%2FlocalPosts%2F510355787471614996/version/1782078602937000","https://www.google.com/local/content/rap/report?postId\u003dCJToveqnvMmKBxIXQ0lITTBvZ0tFT3p5NHViSF9NWHhfZ0UaE0Nnd0lpN25oMFFZUW9NVGVuQUk\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003d%E9%BA%B5%E5%B1%8B%E5%8D%83%E9%9B%B2+%E5%85%89%E8%8F%AF%E5%BA%97\u0026ludocid\u003d18108259806304960474\u0026lpsid\u003dCIHM0ogKEOzy4ubH_MXx_gE\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5UMGXs2bgVjumjytXBWPmPH","0ahUKEwiC5Naw59GWAxXQoK8BHSnhKssQ544CCDMoHg",nu