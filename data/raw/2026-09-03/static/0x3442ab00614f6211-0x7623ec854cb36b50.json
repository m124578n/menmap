,[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjwu5iO6dGWAxU_na8BHZqZAEUQ3IcHCG8oCQ",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjwu5iO6dGWAxU_na8BHZqZAEUQ3IcHCHAoCg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjwu5iO6dGWAxU_na8BHZqZAEUQ3IcHCHEoCw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:NOT_SURE"],"不確定",2,null,null,"0ahUKEwjwu5iO6dGWAxU_na8BHZqZAEUQ3YcHCHMoAA"]],1],null,null,"預訂網址",null,"0ahUKEwjwu5iO6dGWAxU_na8BHZqZAEUQ3IcHCHIoDA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwjwu5iO6dGWAxU_na8BHZqZAEUQ3YcHCHUoAA"]],1],null,null,"等待時間",null,"0ahUKEwjwu5iO6dGWAxU_na8BHZqZAEUQ3IcHCHQoDQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["如果單純以吃粗飽來說，我覺得龍人拉麵的 CP 值真的蠻高的，份量給得很有誠意，有菜有肉，而且肉的表現我覺得相當不錯，吃得出來有用心處理。\n\n不過如果是以「傳統拉麵」的角度來看，我覺得它可能不是每個人都會喜歡的類型。它給我的感覺比較特別，很像介於拉麵跟沾麵之間，麵條吸滿了醬汁和肉燥香氣，每一口都非常入味，甚至有種在吃大滷麵的感覺，和一般印象中湯頭主導的日式拉麵不太一樣。\n\n一開始吃的時候其實有點不習慣，但越吃越能理解為什麼不少人會喜歡。整體味道偏重，不一定符合所有人的拉麵期待，但如果喜歡重口味、醬香濃郁的朋友，我覺得可以來試試看。",null,[0,68]]]],[null,null,null,null,null,"https://business.google.com/local/business/7726299136435455624/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTYUZsNlZYbGtNSEEyVXpKa1NsUXljRXhWTVdNMFQxVTVVbFJIWXhBQhAA",[null,null,null,"/local/business/7726299136435455624/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTYUZsNlZYbGtNSEEyVXpKa1NsUXljRXhWTVdNMFQxVTVVbFJIWXhBQhAA"],"https://business.google.com/local/business/7726299136435455624/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTYUZsNlZYbGtNSEEyVXpKa1NsUXljRXhWTVdNMFQxVTVVbFJIWXhBQhAA",[null,null,null,"/local/business/7726299136435455624/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTYUZsNlZYbG