l,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["【吃刁鑽】好之又好，就是刁鑽。\n\n『吃麵呷氣味』好麵的基本，講求麵Q湯鮮，料豐味美\n二鬼不走前人路，不受限於常見麵點，專注創新每一碗好麵：\n麻辣鍋式牛肉麵/鹹香滑腴蛋蛋麵/清香撲鼻青麻辣/辣子雞翅麻麻麵...\n嘗試過百麵體，長扁寬細筋道口感不一，搭配各式特色底料紅油\n主椒次麻，碗底再藏蒜香，再點椒末提味；萬不能奪了主料場子，各有層次才相得益彰；\n鹹一分搶肉味，辣一分失腴甜；箇中拿捏盡刁鑽。\n吃麵不圖省事，刁鑽才有這味鮮。\n\n【吃為難】好東西，越簡單越為難。\n\n又要真材實料毫無添加，又要色香俱足實惠動人；\n走透全台訪老廠生麵，每日糰切揪醒不含糊，造就筋道不經日曬，直衝滾水，\n就是要撐得起濃厚大醬不掩麵香\n又有馬友鹹魚細細剝，不嫌氣衝味厚，細熬慢烹取其鮮；桂丁土雞燉湯底，無腥白肉煮醇濃\n直人憨做麵；因為貨真價實，更要厚工熬製，才對得起師傅們的堅持\n此中有心意，為難便也不為難。\n\n【吃有青】隨點現煮，鮮聲逼人\n\n縱使湯麵也要帶鑊氣，直火現煎才有青\n搶時間就是搶口感，爽脆酥麻嫩焦香\n接單現點水滾麵，燒雞炙牛爆油黃；\n盤盤白麵碼、上熱燙好料，蔥如星斗；椒油一淋色香味全具\n刁鑽為難出好麵，簡單從來不簡單\n來二鬼吃氣味，好麵就要有聲有色，暢快淋漓！"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-WnxVTvY0vQY/AAAAAAAAAAI/AAAAAAAAAAA/SUxjnd3AdL4/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市三重區",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,[["02 2973 1111",[["02 2973 1111",1],["+886 2 2973 1111",2]],null,"0229731111",null,["tel:0229731111",null,null,"0ahUKEwiOktix6NGWAxWgkq8BHbVWMwUQ_doBCA8oDA"]]],null,null,[null,null,null,null,null,"12044792938329824252","112263827779124613049"],null,[[[7,[["ONI NOODLE 二鬼麵舖｜三重"],["24142新北市三重區重新路二段"],["10之一號"]]],[2,[["24142新北市三重區重新路二段10之一號ONI NOODLE 二鬼麵舖｜三重"]]],[1,[["24142新北市三重區重新路二段10之一號"]]],[4,[["新北市三重區"]]]],[null,"重新路二段10之一號","重新路二段10之一號",null,"24142","新北市三重區","TW"],["0ahUKEwiOktix6NGWAxWgkq8BHbVWMwUQqtMBCAsoCA",["7QQ33F7X+3V"],["3F7X+3V 三重區 新北市"],2]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[["星期四",4,[2026,9,3],[["11:00–20:30",[[11],[20,30]]]],0,1]],[["星期四",4,[2026,9,3],[["11:00–20:30",[[11],[20,30]]]],0,1],0,1,null,["營業中 · 打烊時間：20:30",[[0,3,[null,[4281040703,4285388172]]]]],["營業