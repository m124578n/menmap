],1],null,null,"等待時間",null,"0ahUKEwiPuPr66dGWAxUndfUHHcvXBakQ3IcHCGgoDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["一訪嚇到，必須二訪再多吃看看\n推薦貝汁雞和限定拉麵🍜\n貝汁雞清湯是個人覺得雙北拉麵前五的湯頭\n無腥無膩，清甜的雞湯味，滿滿干貝帶來湯頭口感的層次還能再店內的蒜碎也是不錯👍\n限定我忘記名字了，好吃的👍\n再從舒肥雞，叉燒，料理的很剛好\n讓加點的雞肉丸遜色不少。\n麵條推薦全麥來一組，再加麵（只有細麵）\n口感Q度都不同，都可以嘗試看看。\n蝦醬對我來說太重口味些，原本以為蝦醬是配角雞白湯才是味道主奏。整體還是不錯的\n\n價格都不貴，有開發票能刷載具。\n店員服務也很好，也認真介紹餐點。\n此寶藏店家，兩次去都沒啥人蠻特別的。\n\n推推",null,[0,46]]]],[null,1767957713000000,1767957713000000,"7 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfank3OWJRTVhQd0tnOEZ4LTg2RHFqdw%7CCAEQrcz1_gkiMAoZQ0hfank3OWJRTVhQd0tnOEZ4LTg2RHFqdxoTQ2d3STBjbUR5d1lROElLSjN3RQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiPuPr66dGWAxUndfUHHcvXBakQ_2MIaigN"],"https://business.google.com/local/business/1673217787433930251/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvZVdKc1VtcFNNMFpDVVdwS1dHRklTblpoVjJob1dqTlNhMW94UlJBQhAA",[null,null,null,"/local/business/1673217787433930251/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvZVdKc1VtcFNNMFpDVVdwS1dHRklTblpoVjJob1dqTlNhMW94UlJBQhAA"],"https://business.google.com/local/business/1673217787433930251/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvZVdKc1VtcFNNMFpDVVdwS1dHRklTblpoVjJob1dqTlNhMW94UlJBQhAA",[null,null,null,"/local/business/1673217787433930251/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvZVdKc1VtcFNNMFpDVVdwS1dHRklTblpoVjJob1dqTlNhMW94UlJBQhAA"],null,"https://business.google.com/local/business/1673217787433930251/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvZVdKc1VtcFNNMFpDVVdwS1dHRklTblpoVjJob1dqTlNhMW94UlJBQhAA",[null,null,null,"/local/business/1673217787433930251/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvZVdKc1VtcFNNMFpDVVdwS1dHRklTblpoVjJob1dqTlNhMW94UlJBQhAA"],null,["zh-Hant"],[["感謝您的肯定～\n能吃到喜歡的店家不用久候\n是最幸福的事情