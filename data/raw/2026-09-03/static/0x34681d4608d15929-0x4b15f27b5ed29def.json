er\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003dMAGiC+TOUCH%E7%82%B9%E7%88%AD%E9%AE%AE+%E6%A8%B9%E6%9E%97%E7%A7%80%E6%B3%B0%E5%BA%97\u0026ludocid\u003d5410497139041279471\u0026lpsid\u003dCIHM0ogKEKPX9teg8onPYw\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEKPX9teg8onPYw,ar","/gmb/local_post/accounts%2F-%2Flocations%2F5534425097683862525%2FlocalPosts%2F6554709159038637784/version/1783933434158000","https://www.google.com/local/content/rap/report?postId\u003dCNit_bOHqMD7WhIWQ0lITTBvZ0tFS1BYOXRlZzhvblBZdxoTQ2d3SS05UFMwZ1lRb0xTSG5BTQ\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003dMAGiC+TOUCH%E7%82%B9%E7%88%AD%E9%AE%AE+%E6%A8%B9%E6%9E%97%E7%A7%80%E6%B3%B0%E5%BA%97\u0026ludocid\u003d5410497139041279471\u0026lpsid\u003dCIHM0ogKEKPX9teg8onPYw\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5V-tjC8W9jqpIDATjqkpQjK","0ahUKEwj1md-x7NGWAxUqhq8BHa1pJU0Q544CCC8oIQ",null,"2026年7月13日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u5534425097683862525/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM2NTU0NzA5MTU5MDM4NjM3Nzg0","https://business.google.com/mm/posts/l/u5534425097683862525/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM2NTU0NzA5MTU5MDM4NjM3Nzg0",null,null,null,null,null,["6554709159038637784","CIHM0ogKEKPX9teg8onPYw","CgwI-9PS0gYQoLSHnAM"]],[null,[[["【MAGiC TOUCH 点爭鮮 × COCA 跨界聯名】\n點燃夏日「泰」Chill 浪潮🌊\n\n這夏「泰」讚了😍 MAGiC TOUCH 跨界聯名 COCA 泰式串燒酒場，將經典泰式醬料大膽入菜，從職人握壽司、澎派麵食到創意小點，每一口都能品嚐到滿滿的南洋風味，讓你立即沉浸「泰」Chill 浪潮中😎\n\n📍期間限定：5/26(二) - 7/13(一)\n✨泰Chill酸辣金絲蝦🍤\n鳳尾蝦炸至金黃酥脆，佐以COCA主廚特製泰式酸辣醬，酸甜微辣，尾韻後勁超過癮！\n✨泰泰青檸鰤魚🍣\n肉質細膩的鰤魚交疊鮮甜海灣貝，淋上COCA主廚特製清爽青檸醬，微酸果香勾勒出極致海味。\n✨泰爽海鮮沙拉🥗\nQ 彈鮮甜蝦仁與清脆小花枝鋪在蘿蔓與青木瓜絲上，淋上COCA主廚特製泰式酸辣醬，每一口都是極致清爽的南洋風味。\n✨香濃椰香海鮮麵🍜\n霸氣赤蝦與小花枝浸沐在COCA主廚特製香醇椰奶湯底中，搭配 Q 彈烏龍麵與乾燥檸檬葉點綴，譜出最奢華的南洋味覺樂章。\n✨泰鮮沙嗲雞串 / 泰Chill酸辣雞串🍢\n無論是充滿花生香的濃郁沙嗲醬，還是搭配爽脆青木瓜絲的泰式酸辣醬，火烤雞腿丁的鮮嫩肉汁，都讓你一秒瞬移到曼谷街頭。\n✨打拋一口脆 / 泰Chill打拋茶碗蒸🌮\n經典打拋豬的鹹香魅力！無論加入酥脆蝦餅，還是融入滑嫩起司蛋液中，中西泰跨界混搭，開啟茶碗蒸與小點的新視野。\n\n快到MAGiC TOUCH 一起品嚐！🤩",1]]],[1781147795,1796958995],null,null,[["https://lh3.googleusercontent.com/geougc/AF1QipNeYUTckf7NFvxSWHRD8D4IErJlZmo68nJdQS2N\u003dh400-no",1,null,"","AF1QipNeYUTckf7NFvxSWHRD8D4IErJlZmo68nJdQS2N"]],"5061962661286607295","5534425097683862525",["https://www.google.com/search?sca_esv\u003d4665041cdc874088\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003dMAGiC+TOUCH%E7%82%B9%E7%88%AD%E9%AE%AE+%E6%A8%B9%E6%9E%97%E7%A7%80%E6%B3%B0%E5%BA%97\u0026ludocid\u003d5410497139041279471\u0026lpsid\u003dCIHM0ogKEIe3pbDGtvK0Hg\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEIe3pbDGtvK0Hg,ar","/gmb/local_post/accounts%2F-%2Flocations%2F5534425097683862525%2FlocalPosts%2F5061962661286607295/version/1781147793955000","https://www.google.com/local/content/rap/report?postId\u003dCL_znaKJh-2fRhIWQ0lITTBvZ0tFSWUzcGJER3R2SzBIZxoTQ2d3SWs5R28wUVlRNEt5aHJ3RQ\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003dMAGiC+TOUCH%E7%82%B9%E7%88%AD%E9%AE%AE+%E6%A8%B9%E6%9E%97%E7%A7%80%E6%B3%B0%E5%BA%97\u0026ludocid\u003d5410497139041279471\u0026lpsid\u003dCIHM0ogKEIe3pbDGtvK0Hg\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5V-tjC8W9jqpIDATjqkpQjK","0ahUKEwj1md-x7NGWAxUqhq8BHa1pJU0Q544CCDAoIg",null,"2026年6月11日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u5534425097683862525/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM1MDYxOTYyNjYxMjg2NjA3Mjk1","https://business.google.com/mm/posts/l/u5534425097683862525/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM1MDYxOTYyNjYxMjg2NjA3Mjk1",null,null,null,null,null,["5061962661286607295","CIHM0ogKEIe3pbDGtvK0Hg","CgwIk9Go0QYQ4KyhrwE"]]],1],null,null,null,null,null,null,null,0,null,null,null,[[[["秀泰生活樹林店","0x34681d40b4644207:0xc56c9ad76de14054",null,null,null,"0ahUKEwj1md-x7NGWAxUqhq8BHa1pJU0Qg7cGCCcoGQ"]],1,1]],null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["「MAGiC TOUCH点爭鮮」是來自爭鮮集團的日式料理品牌，運用手機點餐，享受現點現做的新鮮！握壽司、