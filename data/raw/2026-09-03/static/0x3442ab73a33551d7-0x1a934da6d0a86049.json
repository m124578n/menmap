3218834",["https://www.google.com/search?sca_esv\u003d4665041cdc874088\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003d%E9%86%87%E4%B8%80%E6%8B%89%E9%BA%B5+%E7%B8%BD%E5%BA%97\u0026ludocid\u003d1914959645423198281\u0026lpsid\u003dCIHM0ogKEMulr6i0g72QZA\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEMulr6i0g72QZA,ar","/gmb/local_post/accounts%2F-%2Flocations%2F4807877109313218834%2FlocalPosts%2F3364296330406832810/version/1788251912144000","https://www.google.com/local/content/rap/report?postId\u003dCKrVsuiAtpjYLhIWQ0lITTBvZ0tFTXVscjZpMGc3MlFaQRoTQ2d3SWlKN2ExQVlRa002XzVRRQ\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003d%E9%86%87%E4%B8%80%E6%8B%89%E9%BA%B5+%E7%B8%BD%E5%BA%97\u0026ludocid\u003d1914959645423198281\u0026lpsid\u003dCIHM0ogKEMulr6i0g72QZA\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5Uaf5D6BPJhMvwB3shn6p9t","0ahUKEwiTmcvn59GWAxXtZvUHHUtxNdQQ544CCCcoGw",null,"2 天前",null,null,1,null,null,"https://business.google.com/mm/posts/l/u4807877109313218834/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChMzMzY0Mjk2MzMwNDA2ODMyODEw","https://business.google.com/mm/posts/l/u4807877109313218834/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChMzMzY0Mjk2MzMwNDA2ODMyODEw",null,null,null,null,null,["3364296330406832810","CIHM0ogKEMulr6i0g72QZA","CgwIiJ7a1AYQkM6_5QE"]],[null,[[["『六月份限定』醇一拉麵 × Fa Burger 首次聯名登場。\n\n從美式爐烤牛肉文化，到日式清湯拉麵工藝，\n把牛肉最迷人的層次濃縮進一碗湯裡\n\n一個專注於將湯頭熬到極致，\n一個執著於把牛肉做到最好。\n\n於是誕生了這碗期間限定的——\n\n\n🔥【柴燻牛旨清湯拉麵】\n\n湯底以『台灣』溫體牛骨搭配『美國』牛腿肉，\n歷經6小時慢火熬煮。\n\n不追求厚重油膩\n而是將牛骨的甘甜、肉香的深度與清湯的純淨感\n一層層熬出乾淨卻極具存在感的底蘊\n\n主角柴燻牛胸肉\u2028歷經12小時木柴低溫煙燻\n時間讓煙燻木香慢慢滲入肉質深處\u2028讓牛脂與肉汁充分融合\u2028每一片都散發著厚實而迷人的煙燻香氣\n再搭配 Fa Burger 招牌工法製作的低溫烘烤板腱牛柔嫩肉感與濃郁牛香層層堆疊\n展現牛肉最純粹的魅力\n\n炙烤蒜頭增添濃郁香氣\u2028低溫小番茄帶來微酸平衡\u2028球芽甘藍則讓整體風味更加完整\n\n\n當清甜牛骨湯遇上深沉煙燻牛肉\n\n第一口喝到的是醇一的功夫\n最後留在口中的\n是 Fa Burger 最令人著迷的煙燻牛肉香氣\n\n這不只是拉麵\n\n而是一碗結合日式湯頭工藝與美式煙燻牛肉文化的限定作品\n\n\n━━━━━━━━━━━━\n【醇一拉麵 × Fa Burger 限定聯名】\n柴燻牛旨清湯拉麵\n▪ 台灣溫體牛骨 × 美國牛腿肉熬煮6小時\u2028▪ Fa Burger 12小時木柴煙燻牛胸肉\u2028▪ Fa Burger 低溫烘烤板腱牛\u2028▪ 炙烤蒜頭・低溫小番茄・球芽甘藍\n售價｜400元\n每日限量20碗\u2028售完即止\n當日供應完畢即結束販售。\n獻給喜歡牛肉、也懂得品味湯頭的人。\n",1]]],[1780239736,1796050936],null,null,[["https://lh3.googleusercontent.com/geougc/AF1QipNnBv6uXvTN-cw8QR7xHFxoz5ID4jz3B0Y7MG9F\u003dh400-no",1,null,"","AF1QipNnBv6uXvTN-cw8QR7xHFxoz5ID4jz3B0Y7MG9F"]],"7657087930376309383","4807877109313218834",["https://www.google.com/search?sca_esv\u003d4665041cdc874088\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003d%E9%86%87%E4%B8%80%E6%8B%89%E9%BA%B5+%E7%B8%BD%E5%BA%97\u0026ludocid\u003d1914959645423198281\u0026lpsid\u003dCIHM0ogKEPuFutimhILAqAE\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEPuFutimhILAqAE,ar","/gmb/local_post/accounts%2F-%2Flocations%2F4807877109313218834%2FlocalPosts%2F7657087930376309383/version/1780239736203000","https://www.google.com/local/content/rap/report?postId\u003dCIeVi8D1nNyhahIXQ0lITTBvZ0tFUHVGdXRpbWhJTEFxQUUaE0Nnd0ktSnJ4MEFZUTRLdnlud0k\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003d%E9%86%87%E4%B8%80%E6%8B%89%E9%BA%B5+%E7%B8%BD%E5%BA%97\u0026ludocid\u003d1914959645423198281\u0026lpsid\u003dCIHM0ogKEPuFutimhILAqAE\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5Uaf5D6BPJhMvwB3shn6p9t","0ahUKEwiTmcvn59GWAxXtZvUHHUtxNdQQ544CCCgoHA",null,"2026年5月31日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u4807877109313218834/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM3NjU3MDg3OTMwMzc2MzA5Mzgz","https://business.google.com/mm/posts/l/u4807877109313218834/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM3NjU3MDg3OTMwMzc2MzA5Mzgz",null,null,null,null,null,["7657087930376309383","CIHM0ogKEPuFutimhILAqAE","CgwI-Jrx0AYQ4KvynwI"]],[null,[[["🦪燻旨牡蠣拉麵｜期間限定 NT.340\n\n春夏新品來囉\n-煙燻油封牡蠣x牡蠣魚介貝類金湯-\n\nI 以煙燻封存牡蠣的海味\n  嚴選牡蠣以昆布與清酒低溫熟成\n  再以日本山櫻花木屑細緻煙燻\n  隨後浸入義大利初榨橄欖\n  並點綴些許山椒提香\n\nI 牡蠣魚介貝類金湯\n  以魚介與蛤蜊熬製高湯\n  融合大量新鮮牡蠣打勻乳化\n  細緻過濾成就濃厚滑順的牡蠣湯底\n\n濃厚海味中帶著淡淡煙燻香氣,最後以山椒檸檬清香收