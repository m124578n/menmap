AxVbUPUHHUW4AswQ3IcHCHMoBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwic7pyo6tGWAxVbUPUHHUW4AswQ3YcHCHYoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwic7pyo6tGWAxVbUPUHHUW4AswQ3IcHCHUoBQ",null,null,null,null,null,1,[[2]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["本次享用的餐點是雞排咖喱飯，菜多料多，且味道佳！聽說也有免費加飯的服務（因為原本的就吃飽了所以不清楚是不是可以）。餐廳環境十分乾淨，老闆與服務員都十分親切有禮貌，前去用餐心情都特別好！雖然價位是100以上，不是能常吃的，但是是作為偶爾犒勞自己的好地方！照片中的炸物不小心打開錯七味粉孔，一次灑出太多😅\n這家店是位於政治大學前門一分鐘內的距離（真的十分十分近！）因此是政治大學學生午餐晚餐時常前往的餐廳之一，尖峰時段常須排隊，有時可以提早在下課前前往會比較不會遇到人潮～～",null,[0,235]]]],[null,null,null,null,null,"https://business.google.com/local/business/8227662125023943802/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmxkR0YxY0ZkUkVBRRAA",[null,null,null,"/local/business/8227662125023943802/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmxkR0YxY0ZkUkVBRRAA"],"https://business.google.com/local/business/8227662125023943802/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmxkR0YxY0ZkUkVBRRAA",[null,null,null,"/local/business/8227662125023943802/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmxkR0YxY0ZkUkVBRRAA"],null,"https://business.google.com/local/business/8227662125023943802/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmxkR0YxY0ZkUkVBRRAA",[null,null,null,"/local/business/8227662125023943802/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmxkR0YxY0ZkUkVBRRAA"]],[null,null,7847,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSURldGF1cFdREAE!2m1!1s0x0:0xd35733e458a188f9!3m1!1s2@1:CIHM0ogKEICAgIDetaupWQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSURldGF1cFdREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSURldGF1cFdREi4KF0NJSE0wb2dLRUlDQWdJRGV0YXVwMlFFEhNDZ3dJa1k2dW1nWVEwUHFyeEFFGi0KFkNJSE0wb2dLRUlDQWdJRGV0YXVwT1ESE0Nn