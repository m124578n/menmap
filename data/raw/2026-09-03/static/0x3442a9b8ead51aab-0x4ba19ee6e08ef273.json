aNswQ1bMECMYBKCE",null,null,null,[[2]]],[["/m/01dctq"],"芋泥",null,[null,null,null,null,22,0,22],null,"0ahUKEwjvtdaB6dGWAxUGjq8BHddaNswQ1bMECMcBKCI",null,null,null,[[2]]],[["/m/0132v0"],"紅豆湯",null,[null,null,null,null,22,0,147],null,"0ahUKEwjvtdaB6dGWAxUGjq8BHddaNswQ1bMECMgBKCM",null,null,null,[[2]]],[["/m/0kpqd"],"西瓜",null,[null,null,null,null,21,0,31],null,"0ahUKEwjvtdaB6dGWAxUGjq8BHddaNswQ1bMECMkBKCQ",null,null,null,[[2]]]]],[["🌟 湯頭全面提升\n全新雞骨豚骨湯底，融入老母雞與豬大骨的精華，經12小時慢火熬煮，湯色乳黃、濃郁綿厚，滿滿的膠原蛋白與極致鮮味，讓每一口都像在擁抱溫暖的幸福。\n\n🌟 叉燒香氣升級\n以日本職人工法製作的五花肉燒肉叉燒，搭配國產純釀醬油低溫熟成，炙燒的梅納反應更添濃郁香氣。每一片叉燒都鎖住鮮甜肉汁，入口即化，滿足每一位饕客的期待。\n\n🌟 麵條口感升級\n嚴選美澳黃金小麥，經九道揉壓工法製成的26番切細麵，硬中帶Q，完美吸附湯頭精華。每一口麵條，都是精工細作的體現。\n好呷豆花的三大堅持 |\n✅ 天然非基改大豆：手工鹽滷製作，不含石膏，口感細緻滑嫩。\n✅ 40年傳承秘糖水：嘉義糖廠老員工的獨門技法，選用純甘蔗熬煮，濃郁不膩。\n✅ 綿密配料：飽滿紅豆、古早味大麥、低糖綠豆，每一口都是回憶的味道。\n\n甜品起家的何家，保留古早味！ 愛吃甜品的朋友們，來好呷拉麵，記得留點胃給這碗 「被拉麵耽誤的豆花」！甜品吃到飽，ho-chia，好呷❤️"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh3.googleusercontent.com/-dP7oGOd-agI/AAAAAAAAAAI/AAAAAAAAAAA/6ZqFnz-aOts/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市永和區協和里",null,null,null,null,null,null,null,null,[null,[null,1],0,[111,45,79,208,647],["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,[[[[["Ci9DQUlRQUNvZENodHljRjlvT2swMllXaFhabEIyVUdoeFozVjRkR2RsZFZaTFIzYxAB",["0x0:0x4ba19ee6e08ef273",null,1763616275785159,1763616275785159,[null,null,["https://www.google.com/maps/contrib/107134766668900027959/reviews?hl\u003dzh-TW"],null,null,["國良游","https://lh3.googleusercontent.com/a-/ALV-UjVTNvobCsQHfqi0e-9CUivASptNWusEFVS2oJMrh0M9EuWZ7fw\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/107134766668900027959?hl\u003dzh-TW"],"107134766668900027959",null,118,146,null,[1,6,1],0,["在地嚮導 · 118 則評論",null,null,null,null,[null,"0ahUKEwjvtdaB6dGWAxUGjq8BHddaNswQpr8GCC0oAA"]]]],null,"9 個月前",null,null,null,null,null,null,["Google","https://www.gstatic.