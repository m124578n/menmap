ull,null,null,null,null,["zh-Hant"],[["先論餐點🥘有層次吃得出用心、\n但如果整體用餐體驗的話打一星、首先老闆/員工？不能說服務不好、他一人作業確實很辛苦但好幾次看到他出來抽煙也沒有管在內用餐的客人這一點我不予置評。旁邊的炸雞排店油煙很重，這一點讓外面候位的客人感受挺差的。店內的用餐環境也很狹窄、甚至吧枱最裏面的位置是靠近廁所（貼着），可以理解！但還是老話一句，只是感受不好。\n\n總結拉麵是好吃的！開到深夜也是很讚！佩服老闆一人作業、但對於整體的用餐環境，店家可以作更多的思考和改進。",null,[0,168]]]],[null,null,null,null,null,"https://business.google.com/local/business/18045730776511823031/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLVTFNd1RUQmFSMlJwWTIxR1NXSkZPWFpTYldocVdUQkpNV0ZGUlJBQhAA",[null,null,null,"/local/business/18045730776511823031/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLVTFNd1RUQmFSMlJwWTIxR1NXSkZPWFpTYldocVdUQkpNV0ZGUlJBQhAA"],"https://business.google.com/local/business/18045730776511823031/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLVTFNd1RUQmFSMlJwWTIxR1NXSkZPWFpTYldocVdUQkpNV0ZGUlJBQhAA",[null,null,null,"/local/business/18045730776511823031/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLVTFNd1RUQmFSMlJwWTIxR1NXSkZPWFpTYldocVdUQkpNV0ZGUlJBQhAA"],null,"https://business.google.com/local/business/18045730776511823031/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLVTFNd1RUQmFSMlJwWTIxR1NXSkZPWFpTYldocVdUQkpNV0ZGUlJBQhAA",[null,null,null,"/local/business/18045730776511823031/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLVTFNd1RUQmFSMlJwWTIxR1NXSkZPWFpTYldocVdUQkpNV0ZGUlJBQhAA"]],[null,null,1681,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xKU1MwTTBaR2RpY21GSWJFOXZSbWhqWTBJMWFFRRAB!2m1!1s0x0:0xf8fee8399c912826!3m1!1s2@1:CAIQACodChtycF9oOlJSS0M0ZGdicmFIbE9vRmhjY0I1aEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xKU1MwTTBaR2RpY21GSWJFOXZSbWhqWTBJMWFFRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xKU1MwTTBaR2RpY21GSWJFOXZSbWhqWTBJMWFFRRI-Ci9DQUlRQUNvZENodHljRjlvT2xKU1MwTTBaR2RpY21GSW