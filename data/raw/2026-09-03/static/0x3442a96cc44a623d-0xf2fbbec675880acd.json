",1]]],[1785860995,1801672195],null,null,[["https://lh3.googleusercontent.com/geougc/AF1QipPljnvJgRQmDGo3kw67VdzDwPKtPR7FwSe1XK6J\u003dh400-no",1,null,"","AF1QipPljnvJgRQmDGo3kw67VdzDwPKtPR7FwSe1XK6J"]],"2750437280532413065","7218070318606483481",["https://www.google.com/search?sca_esv\u003d266c98980c54f9f2\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003dYukichi+Ramen+%E8%AB%AD%E5%90%89%E6%8B%89%E9%BA%B5\u0026ludocid\u003d17508797735917587149\u0026lpsid\u003dCIHM0ogKEMjUxqub9Mug6wE\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEMjUxqub9Mug6wE,ar","/gmb/local_post/accounts%2F-%2Flocations%2F7218070318606483481%2FlocalPosts%2F2750437280532413065/version/1785860993813000","https://www.google.com/local/content/rap/report?postId\u003dCIn1gNmlhOGVJhIXQ0lITTBvZ0tFTWpVeHF1YjlNdWc2d0UaE0Nnd0lnNmZJMHdZUTBOS3JnQUk\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003dYukichi+Ramen+%E8%AB%AD%E5%90%89%E6%8B%89%E9%BA%B5\u0026ludocid\u003d17508797735917587149\u0026lpsid\u003dCIHM0ogKEMjUxqub9Mug6wE\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5VT5LRJqhAf8JbM6mCZNaPM","0ahUKEwiPvOzh09GWAxWuia8BHUJPNOUQ544CCDQoIw",null,"2026年8月5日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u7218070318606483481/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChMyNzUwNDM3MjgwNTMyNDEzMDY1","https://business.google.com/mm/posts/l/u7218070318606483481/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChMyNzUwNDM3MjgwNTMyNDEzMDY1",null,null,null,null,null,["2750437280532413065","CIHM0ogKEMjUxqub9Mug6wE","CgwIg6fI0wYQ0NKrgAI"]],[null,[[["【Yukichi Ramen 諭吉拉麵 3 週年感謝祭，感謝有你一路相伴！】\n\n感謝大家一路陪伴，諭吉拉麵 3 歲啦！🍜✨\n這三年裡，謝謝每一位走進店裡的客人。有人從開幕吃到現在，有人第一次來就成為熟客，也有人帶著朋友、家人一起來，把一碗拉麵變成一段段溫暖的回憶。近期物價不斷上漲，餐飲業的每一天都不容易。但我們仍盡力維持原本的價格，也不另外收取服務費，把每一碗拉麵都用心做好。我們也沒有以 Google 評論換贈品或優惠，因為對我們來說，真實的肯定才是最珍貴的鼓勵。\n\n所以當一則則五星好評出現時，我們真的非常感謝。那代表大家看見了我們的堅持，也給了我們繼續努力的力量。謝謝每一位支持諭吉拉麵的你。\n\n所以今年，我們想要延續這份傳統，用最直接的方式，繼續將感謝放進這次的 3 週年慶裡。\n\n🔥 三日限定｜原味博多豚骨拉麵 NT$100\n活動日期：5/22（五）、5/23（六）、5/24（日）\n營業時間：11:00 AM — 03:00 AM\n連續供餐 16 小時不限量，下午不休息。\n\n除此之外，追加活動：5/12 起至 5/31 止\n🎁 消費滿 NT$300 即贈刮刮卡乙張，張張都有獎！ 🎁\n這次也要特別感謝乾爹 CORSAIR 海盜船與乾媽 BenQ 的大力贊助，讓 3 週年感謝祭直接升級成抽獎副本，獎勵比想像中還香。🎮✨\n\n🏆 頭獎\nBenQ 量子點護眼 GOOGLE TV｜E50-760\n50 吋 UHD 4K 護眼顯示器 共 1 名\n\n🥈 二獎\nCORSAIR VANGUARD 96 DUAL TONE\n先鋒者 黑白雙色機械式鍵盤 共 1 名\n\n🥉 三獎\nCORSAIR SABRE V2 PRO ULTRALIGHT\n聖劍 超輕量無線電競滑鼠 共 1 名\n\n還有更多精彩獎項等你來刮：\n「靠臉吃飯吃麵都免單」、「爽爽吃八折券」、「博多豚骨拉麵兌換券」、「雞豚醬油／辛麻味噌／辛麻婆兌換券」、「小菜／炸物兌換券」、「飲料兌換券」等多項好禮！\n\n這三年，因為有大家，Yukichi Ramen 諭吉拉麵的每一碗拉麵才有更多溫度。\n未來我們也會繼續堅持每天新鮮備料、用心熬湯，把每一碗拉麵都做到最好。\n\n3 週年感謝祭，請讓我們用一碗熱騰騰的拉麵，向大家說一聲：\n非常感謝！ 🙇\u200d♂️🙇\u200d♀️\n5/22、5/23、5/24，百元拉麵三日限定。我們店裡見！\n\n■活動規定\n\n・「100 元原味博多豚骨拉麵」每位顧客限點一份。\n・活動期間為 2026 年 5 月 22 日（五）～ 5 月 24 日（日）三日限定。\n・活動期間內，每次入店皆適用 100 元拉麵優惠。\n・本次活動「3週年感謝祭」限店內使用。\n・本次活動恕無法提供打包、外帶、外送等服務。\n・加麵、配料以及店內菜單價格，皆以店內掃碼點單顯示為主。\n・週年慶期間用餐時間限制 40 分鐘。週年慶活動期間恕不開放預約訂位。\n・刮刮卡贈送以單張「統一發票」金額為主：NT$300 以上贈送乙張，NT$600 以上贈送兩張，以此類推。\n※所有折扣與優惠，「Yukichi Ramen 諭吉拉麵」保有變更商品及終止活動之權利，並保留最終解釋權。",1]]],[1778092812,1793904012],null,null,[["https://lh3.googleusercontent.com/geougc/AF1QipM7bbEGXT5Z2NVVA1NQWst-QzKR3xKYhvz36wkx\u003dh400-no",1,null,"","AF1QipM7bbEGXT5Z2NVVA1NQWst-QzKR3xKYhvz36wkx"]],"7591037474873783263","7218070318606483481",["https://www.google.com/search?sca_esv\u003d266c98980c54f9f2\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003dYukichi+Ramen+%E8%AB%AD%E5%90%89%E6%8B%89%E9%BA%B5\u0026ludocid\u003d17508797735917587149\u0026lpsid\u003dCIHM0ogKEJLFhs6ajYLW0QE\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEJLFhs6ajYLW0QE,ar","/gmb/local_post/accounts%2F-%2Flocations%2F7218070318606483481%2FlocalPosts%2F7591037474873783263/version/1778092811289000","https://www.google.com/local/content/rap/report?postId\u003dCN_nnrTUi7KsaRIXQ0lITTBvZ0tFSkxGaHM2YWpZTFcwUUUaE0Nnd0lqSmJ1endZUTZPdTV5QU0\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003dYukichi+Ramen+%E8%AB%AD%E5%90%89%E6%8B%89%E9%BA%B5\u0026ludocid\u003d17508797735917587149\u0026lpsid\u003dCIHM0ogKEJLFhs6ajYLW0QE\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5VT5LRJqhAf8JbM6mCZNaPM","0ahUKEwiPvOzh09GWAxWuia8BHUJPNOUQ544CCDUoJA",null,"2026年5月7日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u7218070318606483481/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM3NTkxMDM3NDc0ODczNzgzMjYz","https://business.google.com/mm/posts/l/u7218070318606483481/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM3NTkxMDM3NDc0ODczNzgzMjYz",null,null,null,null,null,["7591037474873783263","CIHM0ogKEJLFhs6ajYLW0QE","CgwIjJbuzwYQ6Ou5yAM"]]],1],null,null,null,null,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["Yukichi Ramen 諭吉拉麵 ── 堅持現場調理所有食材的日式拉麵，歡迎您前來品嚐！\n打破傳統框架，首波主打創新獨特「泡系豚骨拉麵」，有別於重鹹、重口味、油膩感十足的拉麵印象，泡系拉麵的特色就在於豚骨湯底沸騰後，從豬大骨釋放出的乳白色精華富含脂質及蛋白質，將其攪拌至產生「泡沫」便能產生獨特的乳白色湯，只有熬煮新鮮的大骨等食材才能產生的風味。\n另有使用大量豚骨及雞骨花費長時間熬煮提煉出雞\u0026豬精華的美味湯頭，淋上雞油\n搭配炙燒叉燒、舒肥叉燒與易於吸附湯汁的粗麵一起享用，味道濃郁的鶏豚醤油拉麵值得您一再品嚐。\n此外將熟成白、紅味噌充分混合為基底，加到大量豚骨及雞骨熬煮的美味湯頭裡，再搭著充滿咬勁的粗麵以及大量蔬菜，一碗風味十足的辛麻味噌拉麵就此誕生。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-GzqRj2sC19s/AAAAAAAAAAI/AAAAAAAAAAA/4pPpxQ1vIz0/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市中山區",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,[["02 2511 8333",[["02 2511 8333",1],["+886 2 2511 8333",2]],null,"0225118333",null,["tel:0225118333",null,null,"0ahUKEwiPvOzh09GWAxWuia8BHUJPNOUQ_doBCA8oDA"]]],null,null,[null,null,null,null,null,"7218070318606483481","100958297684774766393"],null,[[[7,[["Yukichi Ramen 諭吉拉麵"],["10491臺北市中山區林森北路105號"],["1樓"]]],[2,[["10491臺北市中山區林森北路105號Yukichi Ramen 諭吉拉麵1樓"]]],[1,[["10491臺北市中山區