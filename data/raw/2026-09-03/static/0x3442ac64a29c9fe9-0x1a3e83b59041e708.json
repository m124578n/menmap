ull,null,["zh-Hant"],[["當天是在星期天晚上八點多前往用餐，\n這個時間點過去不需要訂位或是等待就可直接入座。\n當天點了綜合海鮮丼、鮮魚味噌湯和胡麻時蔬，\n胡麻時蔬的部分則是以菠菜加上花枝，\n海鮮丼的用料十分足也很新鮮，沒有任何腥味，\n由於魚料上已經淋過醬油，因此只有額外附上芥末。\n鮮魚味噌湯應該是魚料的邊角料，整碗湯的用料不少。\n\n整體而言會是下次回訪的選擇之一。",null,[0,63]]]],[null,null,null,null,null,"https://business.google.com/local/business/5541923546343500426/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxYkdNelFqVlBSbEl4V214T05VMUdhRVphUlRGM1ZrWktVVkl3UlJBQhAA",[null,null,null,"/local/business/5541923546343500426/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxYkdNelFqVlBSbEl4V214T05VMUdhRVphUlRGM1ZrWktVVkl3UlJBQhAA"],"https://business.google.com/local/business/5541923546343500426/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxYkdNelFqVlBSbEl4V214T05VMUdhRVphUlRGM1ZrWktVVkl3UlJBQhAA",[null,null,null,"/local/business/5541923546343500426/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxYkdNelFqVlBSbEl4V214T05VMUdhRVphUlRGM1ZrWktVVkl3UlJBQhAA"],null,"https://business.google.com/local/business/5541923546343500426/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxYkdNelFqVlBSbEl4V214T05VMUdhRVphUlRGM1ZrWktVVkl3UlJBQhAA",[null,null,null,"/local/business/5541923546343500426/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxYkdNelFqVlBSbEl4V214T05VMUdhRVphUlRGM1ZrWktVVkl3UlJBQhAA"]],[null,null,3150,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2s1bGMzQjVPRlIxWmxONU1GaEZaRTF3VkZKUVIwRRAB!2m1!1s0x0:0x1a3e83b59041e708!3m1!1s2@1:CAIQACodChtycF9oOk5lc3B5OFR1ZlN5MFhFZE1wVFJQR0E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2s1bGMzQjVPRlIxWmxONU1GaEZaRTF3VkZKUVIwRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2s1bGMzQjVPRlIxWmxONU1GaEZaRTF3VkZKUVIwRRI-Ci9DQUlRQUNvZENodHljRjlvT2s1bGMzQjVPRlIxWmxONU1GaEZaRTF3VkZKUVIwRRILMGRVVzdVbVRaeFQaPgovQ0FJUUFDb2RDaHR5Y0Y5b09rNWx