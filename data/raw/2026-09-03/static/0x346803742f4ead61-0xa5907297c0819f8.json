,null,null,["0","745635088062487032"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT201TE5tcE9XRWh0VlZOblJVSTRaMVJ4UTFKd01sRRAB"]],"CIABIhBOnqZDInDjw4hNklCeZI3p",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwivwsWD6dGWAxUOe_UHHbSnPHMQ3YcHCEQoAA"]],1],null,null,"訂單類型",null,"0ahUKEwivwsWD6dGWAxUOe_UHHbSnPHMQ3IcHCEMoCg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwivwsWD6dGWAxUOe_UHHbSnPHMQ3IcHCEUoCw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwivwsWD6dGWAxUOe_UHHbSnPHMQ3IcHCEYoDA",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwivwsWD6dGWAxUOe_UHHbSnPHMQ3IcHCEcoDQ",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["跟很有名的小高拉麵一樣，目前都有無限加麵！\n他的麵條都是統一的細麵，麵條的軟硬度很適中，不會過於軟爛，或是太硬，我覺得時間拿捏的剛剛好。\n今天吃的是味噌、和黑蒜拉麵，這兩碗都是$180\n口味上偏清淡，但個人口味是覺得偏油，吃完，會覺得比較膩，兩片叉燒，給的很大片，蘆筍絲也還不錯吃，只是量比較少、糖心蛋是給半顆，還有豆芽菜、木耳、蔥、海苔片！\n叉燒肉片，好吃，而且不肥，有一些叉燒，肥油實在太多！幸花的叉燒，很合我胃口👍🏻\n中華餛飩拉麵 $180\n餛飩裡面有包一整隻小蝦仁，餛飩吃起來很新鮮，好吃！而且肉片，也很嫩口👍🏻但是，湯頭也是很油。\n調味料的部分，只有七味粉，蒜泥，辣油，我覺得愛吃辣的人，可能會覺得調味的部分有點無聊！\n下次要來嘗試別種口味！",null,[0,92]]]],[null,null,null,null,null,"https://business.google.com/local/business/12222328628757792999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxVEU1dGNFOVhSV2gwVmxaT2JsSlZTVFJhTVZKNFVURktkMDFzUlJBQhAA",[null,null,null,"/local/business/12222328628757792999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxVEU1dGNFOVhSV2gwVmxaT2JsSlZTVFJhTVZKNFVURktkMDFzUlJBQhAA"],"https://business.google.com/local/business/12222328628757792999/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxVEU1dGNFOVhSV2gwVmxaT2JsSlZTVFJhTVZKNFVURktkMDFzUlJBQhAA",[null,null,null,"/local/business/12222328628757792999/customers/reviews/deletereply?p\u003dCkRDaTlE