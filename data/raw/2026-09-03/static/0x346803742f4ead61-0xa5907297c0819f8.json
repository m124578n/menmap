0","745635088062487032"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2tKSVdETlhSaTFOZDFSVlgzTXlOV2s0YjBkS1NGRRAB"]],"CIABIhAPZUygpE6yEEPRrkdxrl1k",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwivwsWD6dGWAxUOe_UHHbSnPHMQ3IcHCGcoBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwivwsWD6dGWAxUOe_UHHbSnPHMQ3IcHCGgoBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwivwsWD6dGWAxUOe_UHHbSnPHMQ3IcHCGkoBg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["最近來吃幸花拉麵，點了新品「鮮蝦雲吞蝦湯拉麵」，整體表現蠻有記憶點的。\n\n湯頭是蝦湯結合招牌雞白湯，蝦香很明顯，但不會腥或過重，後段是雞白湯的圓潤口感，層次算是細緻耐喝型，不是那種喝兩口就膩的濃湯。雲吞裡真的吃得到整隻蝦，口感彈，舒肥雞叉燒也不乾柴，配料給得有誠意。\n\n另外之前也吃過黑蒜拉麵跟松露拉麵。\n黑蒜走濃郁路線，蒜香厚實但不嗆，喜歡重口味的人會喜歡；\n松露則比較優雅，香氣慢慢出來，搭雞白湯其實蠻合適。\n\n內用可以續麵這點很加分，食量大的也能吃得很滿足。\n整體價格在現在拉麵市場算平價，但湯頭是有用心熬的那種。\n\n會願意回訪。",null,[0,35]]]],[null,null,null,null,null,"https://business.google.com/local/business/12222328628757792999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLU1ZkRVRsaFNhVEZPWkRGU1ZsZ3pUWGxPVjJzMFlqQmtTMU5HUlJBQhAA",[null,null,null,"/local/business/12222328628757792999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLU1ZkRVRsaFNhVEZPWkRGU1ZsZ3pUWGxPVjJzMFlqQmtTMU5HUlJBQhAA"],"https://business.google.com/local/business/12222328628757792999/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLU1ZkRVRsaFNhVEZPWkRGU1ZsZ3pUWGxPVjJzMFlqQmtTMU5HUlJBQhAA",[null,null,null,"/local/business/12222328628757792999/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLU1ZkRVRsaFNhVEZPWkRGU1ZsZ3pUWGxPVjJzMFlqQmtTMU5HUlJBQhAA"],null,"https://business.google.com/local/business/12222328628757792999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLU1ZkRVRsaFNhVEZPWkRGU1ZsZ3pUWGxPVjJzMFlqQmtTMU5HUlJBQhAA",[null,nul