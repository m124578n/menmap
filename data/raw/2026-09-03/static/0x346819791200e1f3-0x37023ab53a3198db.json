NING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjplPuT7dGWAxUIbfUHHborL7wQ3IcHCHwoDg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjplPuT7dGWAxUIbfUHHborL7wQ3IcHCH0oDw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_PLENTY_OF_PARKING"],"很多停車位",2,null,null,"0ahUKEwjplPuT7dGWAxUIbfUHHborL7wQ3YcHCH8oAA"]],1],null,null,"停車位",null,"0ahUKEwjplPuT7dGWAxUIbfUHHborL7wQ3IcHCH4oEA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_STREET_PARKING"],"付費路邊停車",2,null,null,"0ahUKEwjplPuT7dGWAxUIbfUHHborL7wQ3YcHCIEBKAA"]]],null,"附近的停車場",null,"0ahUKEwjplPuT7dGWAxUIbfUHHborL7wQ3IcHCIABKBE",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwjplPuT7dGWAxUIbfUHHborL7wQ3IcHCIIBKBI",null,null,["有不少路邊白線收費停車格，$10/時"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwjplPuT7dGWAxUIbfUHHborL7wQ3YcHCIQBKAA"]]],null,null,null,"0ahUKEwjplPuT7dGWAxUIbfUHHborL7wQ3IcHCIMBKBM",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["先說結論：#評論五星送干貝1顆🌟\n#內用座只有一桌兩位，外帶為主\n#吃得出真材實料，整體都很出色新鮮好吃🔥\n#醬油、山葵、紅薑是配料卻讓我印象最深\n點餐時段：週二15：30\n候位時間：0！（滿座率100%）\n等餐時間：11分鐘\n可支付方式：現金\n\n以下為此次點餐的品項及價格🔻\n🔺鮭魚握壽司 $40\n醋飯沒有什麼記憶點，應該是醋味沒有很搶，但老闆功力好米飯不會散\n🔺比目魚緣側握壽司 $60👍🏼\n炙燒過把油香都逼出來，鰭邊本來就是一個無敵的存在\n🔺鮭魚生魚片 $30👍🏼\n口感恰到好處，完全沒有解凍不完全或是軟爛🔥也有一定厚度跟大小，搭配的醬油跟山葵都是店家自製，味道真的不一樣，醬油香不死鹹，芥末不會過於嗆鼻卻能增加食物層次😍\n紅薑帶甜，單吃也是超級好吃\n🔺魚骨味噌湯 $30👍🏼\n直接打趴眾多連鎖壽司店，說魚骨是老闆客氣了應該更名為魚肉味噌湯！至少有6塊鮭魚肉，而且是有煸過的特別香，肉質也不會乾柴很好吃，配料有白蘿蔔跟冬瓜（？）也都很入味，湯頭偏鹹但我覺得可以\n🔺海鱺握壽司 $40\n口感沒有什麼印象點，此魚種我本來就較陌生\n\n因為谷歌評論五星有送東西\n本來覺得評價可能參考要斟酌\n但實話實說就是真材實料又新鮮😤\n價格部分很合理，內用現吃很好吃\n若下次經過會再訪外帶看看😋\n內用桌旁還有貼食尚玩家來訪用餐的照片",null,[0,53]]]],[null,null,null,null,null,"https://business.google.com/local/business/315833997110061074/customers/reviews