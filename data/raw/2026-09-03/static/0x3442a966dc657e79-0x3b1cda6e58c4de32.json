null,null,null,[null,null,null,[7,3]],null,null,[2022,4,23,null,null,null,null,null,["4 年前"]]],["//www.google.com/local/imagery/report/?cb_client\u003dugc_photo_posts\u0026image_key\u003d!1e10!2sCIHM0ogKEICAgIC24YLI4gE\u0026fid\u003d0x0:0x3b1cda6e58c4de32"]],1,null,null,null,null,null,null,["0","4259519515056201266"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUMyNFlMSW9nRRAB"]],"CIHM0ogKEICAgIC24YLI4gE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["生薑清湯雞醬油拉麵 $250\n🤤美味指數：🦒🦒🦒🦒\n👉🏻配置：豬五花叉燒3片/水菜/生洋蔥/生薑泥/半顆溏心蛋\n\n👉🏻麵體：細麵/可加麵。\n麵湯巴付著湯頭的油脂和醬油的香氣，麵條的味道香氣相當讚，麵條又是頸鹿先生最愛的細麵，相當完美的麵條。\n\n👉🏻湯頭：\n醬油雞湯為湯底，因為請店家協助炙燒豬五花叉燒，炙燒後的油脂流入湯中，雖湯頭偏油，但是非常好吃，搭配生洋蔥非常非常清爽，吃到中途將生薑泥拌入後，湯頭的層次又再升級，是因為很適合下雨天陰涼天氣喝上一碗的湯。\n\n👉🏻配料：\n溏心蛋味道相當的濃郁，感覺好像是酒蛋的味道，蛋黃的味道醇濃好讚。豬五花叉燒可選炙燒或不炙燒，個人偏愛炙燒，肉雖然偏肥，但頸鹿先生超愛吃肥肉，這五花肉真的讚到不行，輕鬆就入口，炙燒後香氣相當足夠，很愛。",null,[0,55]]]],[null,null,null,null,null,"https://business.google.com/local/business/1618156032664939757/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXlORmxNU1c5blJSQUIQAQ%3D%3D",[null,null,null,"/local/business/1618156032664939757/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXlORmxNU1c5blJSQUIQAQ%3D%3D"],"https://business.google.com/local/business/1618156032664939757/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXlORmxNU1c5blJSQUIQAQ%3D%3D",[null,null,null,"/local/business/1618156032664939757/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXlORmxNU1c5blJSQUIQAQ%3D%3D"],null,"https://business.google.com/local/business/1618156032664939757/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXlORmxNU1c5blJSQUIQAQ%3D%3D",[null,null,null,"/local/business/1618156032664939757/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXlORmxNU1c5blJSQUIQAQ%3D%3D"]],[null,null,null,["https://www.google.com/maps/@/data\u003d!4m7!23m6!1m5!1sChdDSUhNMG9nS0VJQ0FnSUMyNFlMSW9nRRAB!2m1!1s0x0:0x3b1cda6e58c4de32!3m1!1s2@1