10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwi5yZXE6dGWAxWEoa8BHftHGjwQ3YcHCIoBKAA"]],1],null,null,"等待時間",null,"0ahUKEwi5yZXE6dGWAxWEoa8BHftHGjwQ3IcHCIkBKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這次點套餐裡頭有「漂浮紅油豆乳拉麵」和「櫻花柚子」拉麵，還有附贈串燒跟配料（都是2人份），餐後還有送冰淇淋甜點！\n\n「櫻花柚子」湯頭偏微酸清爽，柚子果香很明顯，喝起來清新順口，還帶一點淡雅的櫻花香氣，層次柔和不膩，適合想吃清爽系拉麵的時候。\n\n「漂浮紅油豆乳拉麵」則是另一種風味，豆乳湯頭綿密濃郁，搭配紅油和絞肉，多了點辛香層次，但不會過於厚重。\n\n整體口味都有水準，環境乾淨舒適，\n是會想再回訪的拉麵店。",null,[0,120]]]],[null,null,null,null,null,"https://business.google.com/local/business/9295025532956345940/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvYTAxV1ZuWlpiRTVLWW0xc2RsbFdPVVJTYkRnMVUyNW9VR0pGUlJBQhAA",[null,null,null,"/local/business/9295025532956345940/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvYTAxV1ZuWlpiRTVLWW0xc2RsbFdPVVJTYkRnMVUyNW9VR0pGUlJBQhAA"],"https://business.google.com/local/business/9295025532956345940/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvYTAxV1ZuWlpiRTVLWW0xc2RsbFdPVVJTYkRnMVUyNW9VR0pGUlJBQhAA",[null,null,null,"/local/business/9295025532956345940/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvYTAxV1ZuWlpiRTVLWW0xc2RsbFdPVVJTYkRnMVUyNW9VR0pGUlJBQhAA"],null,"https://business.google.com/local/business/9295025532956345940/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvYTAxV1ZuWlpiRTVLWW0xc2RsbFdPVVJTYkRnMVUyNW9VR0pGUlJBQhAA",[null,null,null,"/local/business/9295025532956345940/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvYTAxV1ZuWlpiRTVLWW0xc2RsbFdPVVJTYkRnMVUyNW9VR0pGUlJBQhAA"]],[null,null,14472,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21oa01WVnZZbE5KYm1sdllWOURSbDg1U25oUGJFRRAB!2m1!1s0x0:0x68164e23b078ce08!3m1!1s2@1:CAIQACodChtycF9oOmhkMVVvYlNJbmlvYV9DRl85SnhPbEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21oa01WVnZZ