321740723311591859\u0026lpsid\u003dCIHM0ogKEKDt3YLPzbj0cg\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5VG3D_1m95ZSMCJniZQocvH","0ahUKEwjklvPMudKWAxWJh68BHewuDrIQ544CCDQoHw",null,"2026年7月10日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u17294619821675850335/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM0NzM3MTE5NzA5MjE1NDE1NDk3","https://business.google.com/mm/posts/l/u17294619821675850335/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM0NzM3MTE5NzA5MjE1NDE1NDk3",null,null,null,null,null,["4737119709215415497","CIHM0ogKEKDt3YLPzbj0cg","CgsI9rG_0gYQ6JXbaw"]],[null,[[["【夏季限定｜旨辣雞白湯拉麵】\n\n濃厚雞白湯與特製辛香完美融合。\n\n先感受到雞白湯的醇厚與鮮甜，\n接著辣油與辛香料層層堆疊，\n帶來濃郁卻不膩口的風味。\n\n🍜 旨辣雞白湯拉麵｜290元\n🍜 招牌旨辣雞白湯拉麵｜390元\n\n由日本人經營，\n將日本拉麵職人的細節與台灣顧客喜愛的風味結合，\n打造屬於千雲的夏季限定拉麵。\n\n6月22日（週一）正式開賣\n\n📍麵屋千雲 全店販售",1]]],[1782093600,1797889800],null,null,[["https://lh3.googleusercontent.com/geougc/AF1QipMY8VR9rqqz6nsUTaZ4ZlmSMmig9lGVbuELPdl8\u003dh400-no",1,null,"","AF1QipMY8VR9rqqz6nsUTaZ4ZlmSMmig9lGVbuELPdl8"]],"8193700680602518692","17294619821675850335",["https://www.google.com/search?sca_esv\u003dd777865217e22ae8\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003d%E9%BA%B5%E5%B1%8B%E5%8D%83%E9%9B%B2+%E4%BF%A1%E7%BE%A9101%E5%BA%97\u0026ludocid\u003d15321740723311591859\u0026lpsid\u003dCIHM0ogKEK71g42ptKfHiAE\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEK71g42ptKfHiAE,ar","/gmb/local_post/accounts%2F-%2Flocations%2F17294619821675850335%2FlocalPosts%2F8193700680602518692/version/1782078598761000","https://www.google.com/local/content/rap/report?postId\u003dCKSJwvm16_facRIXQ0lITTBvZ0tFSzcxZzQycHRLZkhpQUUaE0Nnd0lpTG5oMFFZUWdMM0k5d0U\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003d%E9%BA%B5%E5%B1%8B%E5%8D%83%E9%9B%B2+%E4%BF%A1%E7%BE%A9101%E5%BA%97\u0026ludocid\u003d15321740723311591859\u0026lpsid\u003dCIHM0ogKEK71g42ptKfHiAE\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5VG3D_1m95ZSMCJniZQocvH","0ahUKEwjklvPMudKWAxWJh68BHewuDrIQ544CCDUoIA",null,"2026年6月22日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u17294619821675850335/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM4MTkzNzAwNjgwNjAyNTE4Njky","https://business.google.com/mm/posts/l/u17294619821675850335/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM4MTkzNzAwNjgwNjAyNTE4Njky",null,null,null,null,null,["8193700680602518692","CIHM0ogKEK71g42ptKfHiAE","CgwIiLnh0QYQgL3I9wE"]]],1],null,null,null,null,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["我們誠摯邀請您品嚐來自日本的正宗拉麵。麵屋千雲堅持呈現最道地的日式風味，主打濃厚雞白湯拉麵與清爽鹽味拉麵，湯頭以長時間熬製，口感濃郁且層次豐富。人氣品項包含招牌雞白湯拉麵、柚子鹽味拉麵與魚介沾麵，深受在地顧客與海外旅客喜愛。\n\n店內同時提供日式煎餃、炸物、小菜與丼飯，適合聚餐或宵夜時段用餐，營業至深夜，是台北宵夜推薦與拉麵名店之一。\n\n本格的な日本スタイルのラーメン専門店。濃厚な鶏白湯そばや柚子香る鶏塩そば、つけそばが人気です。\n\nAuthentic Japanese-style ramen. Known for rich chicken broth ramen (Tori Paitan), yuzu shio ramen, and tsukemen. A popular late-night ramen spot in Taipei.\n\n일본 정통 스타일 라멘 전문점. 닭백탕 라멘과 츠케멘이 인기이며 타이베이 라멘 맛집으로 알려져 있습니다."],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-MmBr-mbSoxA/AAAAAAAAAAI/AAAAAAAAAAA/drOHA-UVC3E/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市信義區西村里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"17294619821675850335","109044872033078613699"],null,[[[7,[["麵屋千雲 信義101店"],["110臺北市信義區西村里信義路五段16號"]]],[2,[["110臺北市信義區西村里信義路五段16號麵屋千雲 信義101店"]]],[1,[["110臺北市信義區西村里信義路五段16號"]]],[4,[["臺北市信義區西村里"]]]],[null,"信義路五段16號","信義路五段16號","西村里","110","臺北市信義區","TW"],["0ahUKEwjklvPMudKWAxWJh68BHewuDrIQqtMBCAkoBg",["7QQ32HM7+36"],["2HM7+36 西村里 臺北市信義區"],2]],null,null,null,null,null,null,null,n