hUKEwjk-vfV6NGWAxXKa_UHHSUIHKUQ3IcHCHEoDg",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["一直收藏很久的口袋名單，三重有很多家美味拉麵店，這家也算是有點名氣。\n當天是假日下午，很多間拉麵店都沒開，看到這間下午沒休息趕緊去吃\n低消是一人一碗拉麵，五歲女兒不用低消\n我們都點一般的拉麵-濃雞湯叉燒丁拉麵 $210元/碗\n湯頭還算濃郁，叉燒丁偏少，老闆看到有小孩說多送一顆蛋，很會做生意服務很好!\n可以免費加麵，麵體偏Q還不錯\n湯本身不多，如果要加麵，記得要留半碗湯\n整體來說吃起來有點偏膩，但是是中上的拉麵\n價格我覺得有點偏貴一點點，如果這樣一碗180~190我覺得差不多",null,[0,85]]]],[null,null,null,null,null,"https://business.google.com/local/business/3466119962359786272/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYzFORlJrVmlWVm8yWTI1T05VMVhhekZOU0VaUVlWVjBVR013UlJBQhAA",[null,null,null,"/local/business/3466119962359786272/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYzFORlJrVmlWVm8yWTI1T05VMVhhekZOU0VaUVlWVjBVR013UlJBQhAA"],"https://business.google.com/local/business/3466119962359786272/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYzFORlJrVmlWVm8yWTI1T05VMVhhekZOU0VaUVlWVjBVR013UlJBQhAA",[null,null,null,"/local/business/3466119962359786272/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYzFORlJrVmlWVm8yWTI1T05VMVhhekZOU0VaUVlWVjBVR013UlJBQhAA"],null,"https://business.google.com/local/business/3466119962359786272/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYzFORlJrVmlWVm8yWTI1T05VMVhhekZOU0VaUVlWVjBVR013UlJBQhAA",[null,null,null,"/local/business/3466119962359786272/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYzFORlJrVmlWVm8yWTI1T05VMVhhekZOU0VaUVlWVjBVR013UlJBQhAA"]],[null,null,677,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21ac1NFRkViVVo2Y25ONU1XazFNSEZQYVV0UGMwRRAB!2m1!1s0x0:0x5b1af2860646c79a!3m1!1s2@1:CAIQACodChtycF9oOmZsSEFEbUZ6cnN5MWk1MHFPaUtPc0E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21ac1NFRkViVVo2Y25ONU1XazFNSEZQYVV0UGMwRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQ