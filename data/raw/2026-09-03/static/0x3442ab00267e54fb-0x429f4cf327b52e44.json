t\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x429f4cf327b52e44"]],1,null,null,null,null,null,null,["0","4800640335027187268"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pZM1ltNHdiMEUxWTNSU2MxVnFOM2gzYlVaUlpVRRAB"]],"CIABIhDHET6MNABa7n3zOZrtMIaw",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjp06TnudKWAxVuiK8BHcIhBWsQ3YcHCGooAA"]],1],null,null,"餐點類型",null,"0ahUKEwjp06TnudKWAxVuiK8BHcIhBWsQ3IcHCGkoCg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjp06TnudKWAxVuiK8BHcIhBWsQ3YcHCGwoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjp06TnudKWAxVuiK8BHcIhBWsQ3IcHCGsoCw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjp06TnudKWAxVuiK8BHcIhBWsQ3IcHCG0oDA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjp06TnudKWAxVuiK8BHcIhBWsQ3IcHCG4oDQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjp06TnudKWAxVuiK8BHcIhBWsQ3IcHCG8oDg",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["★拉麵迷請進→FB搜尋：『台灣拉麵愛好會』、IG：twramenclub\n\n北海道拉麵 魚貝と鷄\n\n▎區域／鄰近地點：台北市／頂好名店城B1\n▎拉麵名稱／價格：濃厚牡蠣雞白湯拉麵+牡蠣炊飯／265+60\n▎配置：日本鹹度、手揉麵(粗)\n\n★採先點餐結帳再入座\n\n魚貝雞在開幕的時候有拍攝一系列的形象宣傳照，一共由三位日籍師傅共同創立的品牌，其中一位大家比較熟識就是台灣五之神目前的日籍師傅奧山先生。\n\n不過由於我自己不太敢吃牡蠣，所以導致開幕至今我拖了好久才終於鼓起勇氣去吃看看。本來剛開的時候是沒有休息日的，後續生意穩定後也是休麵荒日的星期一。\n\n採先點餐才入座，有吧台和桌區，角落還有北海道各地的介紹書籍，牆上也有請到拉麵店御用書法家SOYAMAX的題字。\n店內燈光呈現比較有氣氛的柔和且比較舒適的呈現，不過內場煮麵台那邊燈光蠻暗的，有種快摸黑煮麵的感覺。\n\n這碗吃下來我不吃牡蠣的人都蠻喜歡的，不過還是不敢嘗試有整顆牡蠣的配置，下次想再來收其他品項。\n\n▎濃厚牡蠣雞白湯拉麵+牡蠣炊飯：\n\n牡蠣雞白湯日本味，選手揉麵。\n湯頭呈現是綠色的，牡蠣湯頭只要濃度夠顏色就會是這樣的呈現。\n湯頭喝起來會有些微顆粒感且牡蠣味道帶著雞白湯的柔順，中和了我不太喜歡的牡蠣腥味風味，所以這樣的呈現讓我整碗吃光了。\n\n手揉麵順口QQ，雞肉叉燒兩片厚度不錯，豬肉口感也剛好不會難咬。搭配的配菜也可以舒緩湯頭的濃郁，這碗真的不錯，尤其我不吃牡蠣的人還能這樣碗底朝天，真的推！\n\n炊飯吃起來有一點牡蠣風味吃到碎肉會更明顯，拌入湯後雜炊也好吃順口，可以點來搭配。",null,[0,48]]]],[