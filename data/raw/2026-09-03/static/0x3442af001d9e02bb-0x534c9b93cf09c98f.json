AxVEQfUHHTZzGZwQ3IcHCEQoCA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiu1JnU6dGWAxVEQfUHHTZzGZwQ3IcHCEYoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiu1JnU6dGWAxVEQfUHHTZzGZwQ3IcHCEcoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiu1JnU6dGWAxVEQfUHHTZzGZwQ3IcHCEgoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwiu1JnU6dGWAxVEQfUHHTZzGZwQ3YcHCEooAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiu1JnU6dGWAxVEQfUHHTZzGZwQ3IcHCEkoDA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwiu1JnU6dGWAxVEQfUHHTZzGZwQ3YcHCEwoAA"]]],null,"用餐人數",null,"0ahUKEwiu1JnU6dGWAxVEQfUHHTZzGZwQ3IcHCEsoDQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["2026.3.21 初訪.\n剛吃完春酒後在路邊悠哉地閒逛邊退酒，意外地發現這裏居然悄悄開了一間拉麵店。\n\n之前在中山區有看過它的影子，格外有印象。\n即使是深夜11點多走入店內，老闆依舊充滿熱情介紹及拉麵風格，點餐後隨即入座。\n\n先喝杯冰水感受一下非常現代的日式裝潢風格，點了特盛豚骨拉麵，炙燒過後的雞腿肉非常有香氣切柔軟，雞胸叉燒則是入口即化，湯頭背脂感不會很重，旁邊有附辣椒粉(請酌量使用)，因為真的還蠻辣的⋯\n\n推薦一開始的時候先點粗麵，品嚐麵體及湯頭融合後的勁道，加麵一律都是細麵，再感受其清爽的口感，整體用餐下來非常滿足🍜\n\n希望店外面的菜單可以再調整一下，讓外國人能夠更清楚地了解拉麵特色及口味上的分類。\n這麼好吃的店實在不該被埋沒😎😎😎",null,[0,51]]]],[null,null,null,null,null,"https://business.google.com/local/business/4226915110401705650/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4VEZsVlNqTlVWekZaV0RCb1psUXllRXhSV0VwVVlVUk9hMDR4UlJBQhAA",[null,null,null,"/local/business/4226915110401705650/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4VEZsVlNqTlVWekZaV0RCb1psUXllRXhSV0VwVVlVUk9hMDR4UlJBQhAA"],"https://business.google.com/local/business/4226915110401705650/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4VEZsVlNqTlVWekZaV0RCb1psUXllRXhSV0VwVV