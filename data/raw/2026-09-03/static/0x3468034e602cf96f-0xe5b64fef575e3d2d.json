INING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjgvYr_69GWAxW_i68BHc1tNAkQ3IcHCEUoCw",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjgvYr_69GWAxW_i68BHc1tNAkQ3IcHCEYoDA",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjgvYr_69GWAxW_i68BHc1tNAkQ3IcHCEcoDQ",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjgvYr_69GWAxW_i68BHc1tNAkQ3YcHCEkoAA"]]],null,"用餐人數",null,"0ahUKEwjgvYr_69GWAxW_i68BHc1tNAkQ3IcHCEgoDg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["臨時在小碧潭捷運站附近找餐廳，路過看到網路評價不錯，決定進來嘗試。我點的是麻油雞拉麵，餐點表現算是中規中矩，但以這個價位來說，附近絕對有 CP 值更高的選擇😎\n\n真正讓人無法接受的是用餐衛生。吃到一半隔壁桌大罵一聲髒話，沒想往他碗裡看，竟然是一隻外觀非常像蜈蚣或蠍子的多足小蟲🤯沒機會進一步確認，無法判斷實際是什麼蟲，但這種東西無論如何都不應該出現在餐廳的食物裡（當下🐛緊貼在雞胸肉背面）是隔壁桌女客人翻開雞肉之後看到的😱\n\n女客人感覺沒要跟店家反映，只是默默收起手中的筷子，作罷不吃。我非常震驚，小強什麼的有看過，就從沒見過食物裡出現長得像蠍子或蜈蚣的🤯\n\n然後我開始檢查眼前的餐點。剛剛一邊滑手機一邊吃麵，沒在注意碗裡的情況，結果低頭一看立馬發現一隻果蠅（可能好幾隻已經下肚🥹）\n\n餐點表現尚可，但同一次用餐接連看到兩碗食物出現昆蟲，實在很難讓人安心。店家的食材清洗、保存方式、廚房環境跟病媒防治都非常需要檢查跟改善。在店家提出具體改善措施之前，個人非常不建議前往消費！",null,[0,79]]]],[null,null,null,null,null,"https://business.google.com/local/business/17968685291994123689/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvYldWWVZuRmhiRmt3Vlhwa1YwNVdaRkJOTTBveFRteGtORk14UlJBQhAA",[null,null,null,"/local/business/17968685291994123689/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvYldWWVZuRmhiRmt3Vlhwa1YwNVdaRkJOTTBveFRteGtORk14UlJBQhAA"],"https://business.google.com/local/business/17968685291994123689/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvYldWWVZuRmhiRmt3Vlhwa1YwNVdaRkJOTTBveFRteGtORk14UlJBQhAA",[null,null,null,"/local/business/17968685291994123689/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvYldWWVZuRmhiRmt3Vlhwa1YwNVdaRkJOTTBveFRteGtORk14UlJBQhAA"],null,"https://business.goog