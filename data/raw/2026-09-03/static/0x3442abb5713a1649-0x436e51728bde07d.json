ll,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_SOMEWHAT_DIFFICULT_TO_FIND"],"停車位有點難找",2,null,null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3YcHCG4oAA"]],1],null,null,"停車位",null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3IcHCG0oFw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_LOT"],"付費停車位",2,null,null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3YcHCHAoAA"],[["E:PARKING_OPTION_PAID_STREET_PARKING"],"付費路邊停車",2,null,null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3YcHCHEoAQ"]]],null,"附近的停車場",null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3IcHCG8oGA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_KID_FRIENDLINESS_TIPS"],"親子友善程度",null,null,"分享親子友善程度相關資訊","親子友善程度",null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3IcHCHIoGQ",null,null,["桌距較窄，建議可以先詢問店家"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:VEGETARIAN_OPTIONS"],"素食餐點",2,null,null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3YcHCHQoAA"],[["E:PARKING"],"停車場",2,null,null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3YcHCHUoAQ"],[["E:KID_FRIENDLINESS"],"親子友善程度",2,null,null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3YcHCHYoAg"]]],null,null,null,"0ahUKEwjbmfGh6tGWAxUmmq8BHRsUC80Q3IcHCHMoGg",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["嚇到…怎麼會有這麼好吃的蔬食拉麵\n星期五下班居然不用排隊\n\n菜單看起來都非常好吃有飯還有麵樣式很豐富，整體來說真的很優秀\n綠野仙蹤：看敘述真的覺得很有興趣，來了之後就是一碗非常香醇的香椿奶醬麵，上頭一撮生菜真的是畫龍點睛，第一口很像是青醬義大利麵，隨之而來的是炸開來的香氣，會讓你意識到：啊，這個是蔬食！可是很好吃，奶醬很順口會一直喝湯\n麵的部分表現也很好，下次我可能還會再請主廚煮硬一點！\n泰式酸辣麵：這碗我自己覺得相較是比較普通，可是是他的辣不會很搶戲\n炸雞排：很多多人說必點，但口味上比較不符合我的喜好可能我還是比較喜歡真正的炸雞排🤣\n限量的糯米腸:誒這個我比較吃不出來門路，有一點點貴，但支持店家是沒什麼問題的哈哈\n\n當天一進門被服務人員（不知道是不是闆娘）嚇到，因為太親切了非常活潑，看到她在招呼客人，我有一種在迪士尼的感覺，會讓人吃飯的心情也變好，明明沒有收服務費，但還是非常親切，真的很謝謝她的貼心",null,[0,28]]]],[null,null,null,null,null,"https://business.google.com/local/business/15903925380108241302/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR3Um1SSE5VOVNWMnh6Vm10c1NWcFdhSGRTUm5CUVlUSTFVbGRWUlJBQhAA",[null,null,null,"/local/busines