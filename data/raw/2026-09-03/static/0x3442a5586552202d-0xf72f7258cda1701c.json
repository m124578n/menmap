5%BA%97\u0026ludocid\u003d17811580777006198812\u0026lpsid\u003dCIHM0ogKEL3a5r2glLD60wE\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5UvHKTyBWz8d7IS0y4Nsv3-","0ahUKEwje4tKJ7dGWAxWlh68BHQKwDkQQ544CCDQoJQ",null,"2026年4月24日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u5726756183758386801/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM3ODA5NzkzOTgwMzMxMzA4MDQz","https://business.google.com/mm/posts/l/u5726756183758386801/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM3ODA5NzkzOTgwMzMxMzA4MDQz",null,null,null,null,null,["7809793980331308043","CIHM0ogKEL3a5r2glLD60wE","CgsIgYamzwYQ4I_9XA"]]],1],null,null,null,null,null,null,null,0,null,null,null,[[[["大都會廣場","0x3442a5587aee28e9:0xba9bb9eb21bef479",null,null,null,"0ahUKEwje4tKJ7dGWAxWlh68BHQKwDkQQg7cGCCooGw"]],1,1]],null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["貼心小提醒:官網訂位不接受當天訂位，如需當天訂位歡迎電話詢問，謝謝!\n\n我們堅持以天然辛香料作調理、堅持再堅持，為的是料理出給客人有如魔法夢幻般的新歐風咖哩，魔法般的咖哩醬汁，是精選甜度於14度以上的高級洋蔥，採用法式傳統手法，慢火精燉36小時如此堅持是為了提煉深褐色的自然美味高湯，加入二十餘種天然辛香料黃金比例的魔法咖哩，融合印度特有的MASALA辛香料，並加入芒果熬煮，而獨創一格的新歐風咖哩，入口回甘，馥郁馨香！並將各式主食採用各國不同料理手法，日式果香、南洋椰香、法式杏仁奶油、新疆孜然茴香、中式蒜味，將料理無國界，最好的一面呈現於客人的眼前，咖哩飯要好吃，飯是重要的主角，本店採用日本頂級新潟越光米原生種，並加入竹碳炊飯，竹碳可以濾除水中雜質！\nマホーカレーについて健康、自然、美味、これがマホーカレーの代名詞です。魔法のような、幻のような美味しいカレーをお客様に食べて頂けるよう、天然スパイスにこだわり、香り豊かなカレーを作り出しました。自家製ブラックカレーも独創的です。香辛料で装飾された店内は、木をふんだんに採用し、オレンジ色を基調として暖かみを演出。アットホームな雰囲気の中で、本格的なカレーを堪能できます。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh6.googleusercontent.com/-jhVznXblcyE/AAAAAAAAAAI/AAAAAAAAAAA/xloWL-bnpiE/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[0],"新北市淡水區長庚里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,[["02 2620 6123",[["02 2620 6123",1],["+886 2 2620 6123",2]],null,"02