",null,"0ahUKEwiVztO_6tGWAxWLbvUHHYgAOxAQ3IcHCHEoBg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiVztO_6tGWAxWLbvUHHYgAOxAQ3IcHCHIoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_LOUD"],"吵雜，但還是能交談",2,null,null,"0ahUKEwiVztO_6tGWAxWLbvUHHYgAOxAQ3YcHCHQoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiVztO_6tGWAxWLbvUHHYgAOxAQ3IcHCHMoCA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwiVztO_6tGWAxWLbvUHHYgAOxAQ3YcHCHYoAA"]],1],null,null,"等待時間",null,"0ahUKEwiVztO_6tGWAxWLbvUHHYgAOxAQ3IcHCHUoCQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["拉麵跟咖喱飯都非常好吃，整體表現讓人印象深刻。咖喱醬帶有淡淡的蕃茄香氣，比一般咖喱多了一種獨特的微酸風味，吃起來不僅開胃也相當解膩。我這次點的是辣味口味的咖喱，入口後層次非常豐富，辣度不會過於刺激，反而提升了整體的香氣與深度。搭配的歐姆蛋口感滑嫩細緻，與咖喱一起吃非常加分。\n\n唐揚雞部分稍微偏鹹了一點，但外皮炸得十分酥脆，裡面的雞肉依然多汁，整體還是很不錯。番茄起司滑蛋拉麵也值得一試，起司與番茄的組合相當濃郁，風味鮮明，不過味道稍微偏重，吃到後面會有一點點膩感，但還在可以接受的範圍內。\n\n店內提供冰水可以自取，環境整潔舒適，用餐體驗良好。服務人員態度也不錯，上餐速度適中。唯一的小缺點是需要另外支付10%的服務費，整體來說仍然是會讓人想再訪的一間店。",null,[0,137]]]],[null,null,null,null,null,"https://business.google.com/local/business/3841810469011819705/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHU0ZOdVNscGhWMVpDVlZjeFNGWlhhR3RZTWpGT1kyczViVlJGUlJBQhAA",[null,null,null,"/local/business/3841810469011819705/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHU0ZOdVNscGhWMVpDVlZjeFNGWlhhR3RZTWpGT1kyczViVlJGUlJBQhAA"],"https://business.google.com/local/business/3841810469011819705/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHU0ZOdVNscGhWMVpDVlZjeFNGWlhhR3RZTWpGT1kyczViVlJGUlJBQhAA",[null,null,null,"/local/business/3841810469011819705/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHU0ZOdVNscGhWMVpDVlZjeFNGWlhhR3RZTWpGT1kyczViVlJGUlJBQhAA"],null,"https://business.google.com/local/business/3841810469011819