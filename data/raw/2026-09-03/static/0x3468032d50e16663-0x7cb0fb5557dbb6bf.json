//lh6.googleusercontent.com/-AGK2CkC6PB4/AAAAAAAAAAI/AAAAAAAAAAA/2OYlUU7GrNg/s40-c-k-mo/photo.jpg"],null,1],null,null,null,null,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["歡迎光臨一幸拉麵中和店，我們是新北中和的拉麵首選！從最初的小小攤位起家，到如今裝上冷氣的舒適店面，一幸拉麵一直致力於為您帶來最道地的拉麵體驗。\n\n我們的特色：\n• 湯頭濃郁：我們的拉麵以獨家濃郁湯底著稱，每一口都是對味蕾的極致寵愛。\n• 價格親民：我們堅持以親民價格提供高品質拉麵，讓每位顧客都能品嚐到美味無負擔。\n• 高CP值：我們的拉麵集美味與經濟於一身，給您超乎預期的餐飲體驗。\n\n在一幸拉麵，每一碗拉麵都是我們對品質的堅持和對顧客的承諾。從選料到烹調，每一步都精心製作，只為給您最純正的日式拉麵風味。\n\n來訪資訊：\n我們位於新北中和，無論是炎熱夏季或寒冷冬天，一幸拉麵的門店內總是擁有最適宜的用餐環境，等待著每一位尋找美食的朋友。\n\n走過從無到有的旅程，一幸拉麵中和店感謝每一位顧客的支持與喜愛。來吧，我們在一幸等您，享受一碗濃郁美味的拉麵吧！"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh6.googleusercontent.com/-AGK2CkC6PB4/AAAAAAAAAAI/AAAAAAAAAAA/2OYlUU7GrNg/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市中和區德穗里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,[["02 2222 5465",[["02 2222 5465",1],["+886 2 2222 5465",2]],null,"0222225465",null,["tel:0222225465",null,null,"0ahUKEwjHj4vx6tGWAxXgdvUHHU40FfcQ_doBCA0oCg"]]],null,null,[null,null,null,null,null,"5969569317565256701","103506253346555699110"],null,[[[7,[["一幸拉麵中和店（總店）"],["235新北市中和區德穗里莒光路72號"]]],[2,[["235新北市中和區德穗里莒光路72號一幸拉麵中和店（總店）"]]],[1,[["235新北市中和區德穗里莒光路72號"]]],[4,[["新北市中和區德穗里"]]]],[null,"莒光路72號","莒光路72號","德穗里","235","新北市中和區","TW"],["0ahUKEwjHj4vx6tGWAxXgdvUHHU40FfcQqtMBCAkoBg",["7QQ32F3C+6R"],["2F3C+6R 德穗里 新北市中和區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[["星期四",4,[2026,9,3],[["11:30–14:00",[[11,30],[14]]],["17:00–21:00",[[17],[21]]]],0,1]],[["星期四",4,[2026,9,3],[["11:30–14:00",[[11,30],[14]]],["17:00–21:00",[[17],[21]]]],0,1],1,4,null,["已打烊 · 開始營業時間：17:00",[[0,3,[null,[42