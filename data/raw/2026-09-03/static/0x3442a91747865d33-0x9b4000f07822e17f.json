fUHHf1GJ-AQ3YcHCEIoAA"],[["M:/g/11pqkm9zzw"],"唐揚炸雞",2,null,null,"0ahUKEwiMgMSt6NGWAxUuQfUHHf1GJ-AQ3YcHCEMoAQ"],[["M:/g/11t4tb2q0f"],"鹽味雞白湯",2,null,null,"0ahUKEwiMgMSt6NGWAxUuQfUHHf1GJ-AQ3YcHCEQoAg"]],[1]],null,"建議的餐點",null,"0ahUKEwiMgMSt6NGWAxUuQfUHHf1GJ-AQ3IcHCEEoDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["2026/06/21晚餐\n🍜濃厚黑蒜豚骨：湯頭非常濃郁，裡面有里肌肉，還有非常特別的豬肉（口感很像五花肉），屬於重口味，如果喜歡濃郁蒜香的會喜歡，另外有蒜可自行再加\n🍜鹽味蛤蠣白湯：內含兩顆蛤蠣非常飽滿甘甜，烤過的雞腿肉，非常鮮甜，上桌時旁邊會有一坨醬可直接拌均勻食用，桌上有「椒麻粉」非常搭！喜歡吃辣的一定要加\n🐓唐揚雞：四塊，肉質一口咬下不會太硬，保有雞肉原汁，完全不柴，熱騰騰吃下非常刷嘴\n\n❓不確定是不是所有湯都可以調鹹度，有聽到櫃檯有問其中一位客人要不要調鹹度\n\n🚇在三重國小捷運站出來走大概8分鐘距離，算很方便，不過若是開車就不太好停\n\n🥲唯一缺點應該就是生意很好，要先填好名字電話末三碼，現場會叫號（所以不能離開），會需要耐心等候\n\n整體來說食物有特色且好吃，不能續湯，會有幾種醬在桌上可以依照口味自己加，麵體粗細硬軟可選，如果喜歡重口味會喜歡，反之可能會覺得太鹹～",null,[0,156]]]],[null,null,null,null,null,"https://business.google.com/local/business/13527711239222049474/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXVTA1dFZYUlNSVVpOWVVoS2ExUjZWbmxPTTA1aFdtNVpNVlJyUlJBQhAA",[null,null,null,"/local/business/13527711239222049474/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXVTA1dFZYUlNSVVpOWVVoS2ExUjZWbmxPTTA1aFdtNVpNVlJyUlJBQhAA"],"https://business.google.com/local/business/13527711239222049474/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXVTA1dFZYUlNSVVpOWVVoS2ExUjZWbmxPTTA1aFdtNVpNVlJyUlJBQhAA",[null,null,null,"/local/business/13527711239222049474/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXVTA1dFZYUlNSVVpOWVVoS2ExUjZWbmxPTTA1aFdtNVpNVlJyUlJBQhAA"],null,"https://business.google.com/local/business/13527711239222049474/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXVTA1dFZYUlNSVVpOWVVoS2ExUjZWbmxPTTA1aFdtNVpNVlJyUlJBQhAA",[null,null,null,"/local/business/13527711239222049474/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXVTA1dFZYUlNSVVpOWVVoS2ExUjZWbmxPTTA1aFdtNVpNVlJyUlJBQhAA"]],[null,null,6592,["https://www.google.com/maps/re