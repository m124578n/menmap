03d!1e10!2sCIABIhA40UpsNaWaSnkAgyijU-Nn\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x1ca618e474bb30e1"]],1,null,null,null,null,null,null,["0","2064364848685986017"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pkbllVVnBZemhUZWt4YVVWaHNjbWw2YzJGbk4xRRAB"]],"CIABIhA40UpsNaWaSnkAgyijU-Nn",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["限定！濃厚味噌醬烤燒肉拉麵+叉燒飯\n\n2/25初見 約16:50抵達\n跟據店家說明 味噌醬底上用了四種味噌\n喝起來相較於常見的味噌料理——味噌湯——來說濃厚許多\n味道上除了味噌香氣 另外微微帶有豆類發酵的酸與甜\n搭配湯裡的雞風味油 整體來說層次不錯\n燒肉部分應該是豬梅花？咬起來蠻脆的感覺\n不過看起來是一大塊肉刷醬烤完再切片\n缺少梅納反應產生的氣味和油脂焦香\n個人覺得刷醬本身味道的表現力也稍弱了些 嚐到比較多是豬肉自己的味道\n配料還有炒高麗菜 沾附滿鍋氣外 上方的蒜入湯後也有加分效果\n麵的掛湯力還行 但味噌本身不太強勢 覺得兩者搭配沒有出現新的火花\n副食的叉燒飯在味道 方面中規中矩 碎肉+美乃滋+炙燒的配置\n飯本身吃得出來用料不錯 米粒飽滿且帶彈性\n但沒有洋蔥碎讓味道上稍顯單獨外 店內也沒有提供調味料\n加上蠻大碗的 吃到後面偏膩\n覺得減量的同時降價一些 對客人的胃和錢包比較友善\n\n發現3月開始店休又剛好看到今天有限定所以來試試\n可能接下來幾天沒機會來了 希望之後有緣可以在這邊嚐到煮干類拉麵",null,[0,34]]]],[null,null,null,null,null,"https://business.google.com/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYmxsVlZuQlplbWhVWld0NFlWVldhSE5qYld3Mll6SkdiazR4UlJBQhAA",[null,null,null,"/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYmxsVlZuQlplbWhVWld0NFlWVldhSE5qYld3Mll6SkdiazR4UlJBQhAA"],"https://business.google.com/local/business/15841010331632340335/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYmxsVlZuQlplbWhVWld0NFlWVldhSE5qYld3Mll6SkdiazR4UlJBQhAA",[null,null,null,"/local/business/15841010331632340335/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYmxsVlZuQlplbWhVWld0NFlWVldhSE5qYld3Mll6SkdiazR4UlJBQhAA"],null,"https://business.google.com/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrYmxsVlZuQlplbWhVWld0NFlWVldhSE5qYld3Mll6SkdiazR4UlJBQhAA",[null,null,null,"/local/business/15841010331632340335/customers/reviews/reply?p\u