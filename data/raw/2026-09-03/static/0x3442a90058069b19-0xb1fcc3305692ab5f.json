H"],"午餐",2,null,null,"0ahUKEwi50ajouNKWAxX8hagCHTrxMVEQ3YcHCFYoAA"]],1],null,null,"餐點類型",null,"0ahUKEwi50ajouNKWAxX8hagCHTrxMVEQ3IcHCFUoFA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwi50ajouNKWAxX8hagCHTrxMVEQ3YcHCFgoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi50ajouNKWAxX8hagCHTrxMVEQ3IcHCFcoFQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwi50ajouNKWAxX8hagCHTrxMVEQ3YcHCFooAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwi50ajouNKWAxX8hagCHTrxMVEQ3YcHCFsoAQ"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwi50ajouNKWAxX8hagCHTrxMVEQ3YcHCFwoAg"]]],null,"用餐人數",null,"0ahUKEwi50ajouNKWAxX8hagCHTrxMVEQ3IcHCFkoFg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["京都連鎖拉麵名店魁力屋去年在台南插旗首店後，陸續往北展店，也是近期內討論聲量不小，但褒貶不一的新拉麵店，這家在新光三越B1。這次抱著踩雷的可能來試試，內用大約有20多個座位，平日中午大概坐半滿。\n點了最經典的「京都熟成醬油拉麵」($249)，選預設的台灣新味(鹹度較低)，覺得滿剛好的，也可以按個人口味換日本原味(比較鹹)，可以免費加麵。\n熟成醬油拉麵就是加了豬背脂和大豆熟成的醬油，背脂量偏少，其實就是可以想像得到的穩定醬油拉麵，加一點油脂口感。\n細麵選了偏硬，吃起來還是偏軟，稍微失望。偏瘦的叉燒需要咀嚼一下但不至於太硬。溏心蛋和筍干都是還OK不踩雷的味道。\n整體來說中規中矩的不錯吃，但也沒什麼特別亮點，就是連鎖醬油拉麵的水準，我給4.0分，桌上的柚子醋和蒜泥可以加一點轉味。\n\n#Lev",null,[0,169]]]],[null,null,null,null,null,"https://business.google.com/local/business/940407899973957305/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTVjJKNldtNWlibXh2WVRKS1UyUnVTa1ZOVm5CMldXNVJlVlpYWXhBQhAA",[null,null,null,"/local/business/940407899973957305/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTVjJKNldtNWlibXh2WVRKS1UyUnVTa1ZOVm5CMldXNVJlVlpYWXhBQhAA"],"https://business.google.com/local/business/940407899973957305/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTVjJKNldtNWlibXh2WVRKS1UyUnVTa1ZOVm5CMldXNVJlVlpYWXhBQhAA",[null,null,null,"/local/business/940407899973957305/customers/reviews/deletereply?p\u003dCkRDaTlEUV