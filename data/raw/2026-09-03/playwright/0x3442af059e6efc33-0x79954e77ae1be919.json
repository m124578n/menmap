,null,null,["zh-Hant"],[["那天泡完湯想說找找附近有沒有好吃的拉麵，\n就來到這家小店，看到門口的指示噗呲笑了一下，\n乖乖的在外面等候，簡單的日式裝飾，沒有音樂，\n很安靜😂後來進去點了一碗辛豚骨拉麵（小辣） 290元和蝦油鹽味拉麵330元，麵體口感偏硬，湯頭好喝，兩種肉吃起來很有層次，但辛豚骨跟我想像的不同，不夠辣所以店家提供了地獄辣粉給我，蝦油鹽味拉麵蝦味偏淡，但整體都是好吃的，咖喱可樂餅也不錯👍🏻 但整體而言覺得單價稍高，只收現金也比較不方便",null,[0,66]]]],[null,1776767416000000,1776767416000000,"4 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfd1QzTUtxOEtqQ1lBUV9MY0pZZUY2UQ%7CCAEQrcz1_gkiMAoZQ0hfd1QzTUtxOEtqQ1lBUV9MY0pZZUY2URoTQ2d3SXVLT2R6d1lRNjZEZGlRRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjI7fCCw9KWAxWln68BHXhfCN0Q_2MI8gEoEg"],"https://business.google.com/local/business/6823686894322764584/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRGZWxwdWJFcGlNbG93V210YVVsZHNXWHBSYmxKd1ZGWkdkRTlIWXhBQhAA",[null,null,null,"/local/business/6823686894322764584/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRGZWxwdWJFcGlNbG93V210YVVsZHNXWHBSYmxKd1ZGWkdkRTlIWXhBQhAA"],"https://business.google.com/local/business/6823686894322764584/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRGZWxwdWJFcGlNbG93V210YVVsZHNXWHBSYmxKd1ZGWkdkRTlIWXhBQhAA",[null,null,null,"/local/business/6823686894322764584/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRGZWxwdWJFcGlNbG93V210YVVsZHNXWHBSYmxKd1ZGWkdkRTlIWXhBQhAA"],null,"https://business.google.com/local/business/6823686894322764584/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRGZWxwdWJFcGlNbG93V210YVVsZHNXWHBSYmxKd1ZGWkdkRTlIWXhBQhAA",[null,null,null,"/local/business/6823686894322764584/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRGZWxwdWJFcGlNbG93V210YVVsZHNXWHBSYmxKd1ZGWkdkRTlIWXhBQhAA"],null,["ja","zh-Hant","日文","中文",1],[["ご来店ありがとうございました。またのお越しを心よりお待ちしております。",null,[0,35]],["感謝您的光臨。我們期待您的再次光臨。",null,[0,18]]]],[null,null,1030,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tFelpubEpi