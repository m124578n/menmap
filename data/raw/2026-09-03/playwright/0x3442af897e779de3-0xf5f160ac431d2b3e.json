型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjVsPKSzdKWAxWXma8BHdQpOzwQ3YcHCIYBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjVsPKSzdKWAxWXma8BHdQpOzwQ3IcHCIUBKBQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjVsPKSzdKWAxWXma8BHdQpOzwQ3YcHCIgBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjVsPKSzdKWAxWXma8BHdQpOzwQ3IcHCIcBKBU",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjVsPKSzdKWAxWXma8BHdQpOzwQ3IcHCIkBKBY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjVsPKSzdKWAxWXma8BHdQpOzwQ3IcHCIoBKBc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjVsPKSzdKWAxWXma8BHdQpOzwQ3IcHCIsBKBg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["醬油拉麵！超讚(*๓´╰╯`๓)♡\n與捷運站旁的雞道樂並列口袋拉麵名單\n\n照片附上：我吃了啥、店內空間如何、自助區有啥、點餐機＆菜單、店外長怎樣、\n\n＊拉麵口味3種：鹽味／醬油／味噌\n＊份量2種：一般／豪華 (主要差別在肉量、糖心蛋)\n\n。這次點豪華醬油拉麵，肉應該是煮熟後炙燒，味道很豐富！\n。湯頭濃郁不死鹹，整碗喝光很暢快 (吃過凪、豚人 但無法每次都喝完湯的我)\n。麵條軟硬度選了中間值的正常，吃起來有嚼勁又有軟，很適中 (下次試硬麵!)\n\n→ 店內冷氣足、有自取冷水、餐具\u0026調味料區、回收餐具區、空間寬敞、有廁所\n→ 老闆顯然很迷 白爛貓、鋼彈、哥吉拉，店內擺設公仔模型，牆壁貼著海報與超大海報～\n\n－－－－－以下心得短文－－－－－\n超炎熱七月的平日晚上7點到店內，雖然沒有人，但老闆仍是三台冷氣開好開滿，非常舒服的室內溫度~~\n\u003e 可能因大學生放暑假，附近店家很多都沒營業，甚至在門口牌子上寫暑期不營業 (驚\n\n空間很寬敞，走道能容下兩人路過，而不用其中一人先讓步，對比某些窄窄的拉麵店，大大加分！\n\n老闆好像原本是佐藏麵屋一員，離開一陣子後再度回歸，並改名為一平拉麵\n－－－－－－－－－－\n\n#淡水美食 #淡水餐廳 #淡江大學 #美食\n#淡水拉麵 #淡江拉麵\n#拉麵 #拉麵店\n#推薦",null,[0,35]]]],[null,null,null,null,null,"https://business.google.com/local/business/5184011821026993477/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnlNVTVmU2xabkVBRRAA",[null,null,null,"/local/business/5184011821026993477/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnlNVTVmU2xabkVBRRAA"],"https://business.google.com/local/business/5184011821026993477/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnlNVTVmU