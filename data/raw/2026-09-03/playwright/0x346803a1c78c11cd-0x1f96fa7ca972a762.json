,null,null,"氣氛",null,"0ahUKEwjA3tGCv9KWAxXGdfUHHbRlLPUQ3IcHCFIoBw",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["十年前從還在我家樓下，McD旁邊就開始吃小高了，有朋友要來中和找吃的也都會推薦小高拉麵。\n\n一直追隨小高到今天再去吃，原本的老闆不在，店裡的員工都很年輕。\n最後麵端上來的時候：\n1.湯灑一圈在外碗，店員有看一下也沒多說什麼\n2.湯的溫度基本上跟溫水差不多\n3.兩球麵加肉加蛋加筍乾，基本上很滿了，湯還灑出來，結果吃沒幾口沒湯了也不給加\n記得之前在怎麼樣也都可以加清高湯，吃拉麵也絕對不會有湯不夠燙的問題，今天很失望。\n\n希望未來有機會變成原本的程度，那種CP值高的小高拉麵，也希望另外一間都還在水準之上，有機會再去探探",null,[0,77]]]],[null,null,null,null,null,"https://business.google.com/local/business/16107387692899060807/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQzZVZNeVVuUlJNbVIwVGpKb2NGTnFRWGxPTURWdVZrZEtlVkpyUlJBQhAA",[null,null,null,"/local/business/16107387692899060807/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQzZVZNeVVuUlJNbVIwVGpKb2NGTnFRWGxPTURWdVZrZEtlVkpyUlJBQhAA"],"https://business.google.com/local/business/16107387692899060807/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQzZVZNeVVuUlJNbVIwVGpKb2NGTnFRWGxPTURWdVZrZEtlVkpyUlJBQhAA",[null,null,null,"/local/business/16107387692899060807/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQzZVZNeVVuUlJNbVIwVGpKb2NGTnFRWGxPTURWdVZrZEtlVkpyUlJBQhAA"],null,"https://business.google.com/local/business/16107387692899060807/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQzZVZNeVVuUlJNbVIwVGpKb2NGTnFRWGxPTURWdVZrZEtlVkpyUlJBQhAA",[null,null,null,"/local/business/16107387692899060807/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQzZVZNeVVuUlJNbVIwVGpKb2NGTnFRWGxPTURWdVZrZEtlVkpyUlJBQhAA"]],[null,null,1340,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2t3eVMyUnRRMmR0TjJocFNqQXlOMDVuVkdKeVJrRRAB!2m1!1s0x0:0x1f96fa7ca972a762!3m1!1s2@1:CAIQACodChtycF9oOkwyS2RtQ2dtN2hpSjAyN05nVGJyRkE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2t3eVMyUnRRMmR0TjJocFNqQXlOMDVuVkdKe