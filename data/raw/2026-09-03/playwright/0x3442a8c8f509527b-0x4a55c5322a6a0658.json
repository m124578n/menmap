ll,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwid58bMzNKWAxV4fPUHHcm_IIcQ3IcHCGUoDw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwid58bMzNKWAxV4fPUHHcm_IIcQ3IcHCGYoEA",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwid58bMzNKWAxV4fPUHHcm_IIcQ3YcHCGgoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwid58bMzNKWAxV4fPUHHcm_IIcQ3IcHCGcoEQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwid58bMzNKWAxV4fPUHHcm_IIcQ3YcHCGooAA"]],1],null,null,"等待時間",null,"0ahUKEwid58bMzNKWAxV4fPUHHcm_IIcQ3IcHCGkoEg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["因傷在附近看骨科，想說看診前先來吃個晚餐，行動不便挑近的用餐，看這家評價不錯決定來用餐；進店後很親切的招呼，拿著菜單和筆就座畫單，要交菜單前先問是不是要先付款，以免行動不便的我多跑一趟拿錢包🤣付完款後坐回位子上等餐，首先來了拉麵，此時招呼說‘’餐具在前面再拿一下喔～‘’，當下聽到傻眼🤣平常的我當然無所謂，但這種時候反而才注意到這種小細節，為什麼這家的餐具是集中在前面櫃檯，於是跛腳的我艱難站起來移動到櫃檯那拿了雙筷子.....（當下的我多希望一直看著跛腳的我的店員和老闆娘...能幫我拿一下🥲）\n\n言歸正傳～\n🍜博多豚骨拉麵，使用的是細麵，軟硬適中，湯頭可以，配料有筍干，豆芽，半顆糖心蛋，以上都還行，但叉燒部分，我個人覺得中下，主要是叉燒有個細微的豬酸味，但還在能接受範圍，這點有點可惜\n\n🐷特製炸豬排（+生菜）\n一上桌我注意到的不是豬排，而是生菜，因為菜單上有特別給出選項要生菜還是不要生菜，那既然我勾要生菜了，怎麼少的可憐😅讓客人挑要不要，是不是就是怕不吃浪費，那既然客人要生菜了，在麼給這麼小一搓.....我在吃一塊豬排時，下意識去夾生菜，但我瞬間停了一下，原因居然是我怕一次夾太多來配，直接沒了🤣於是我一塊豬排，只能配上兩三根生菜 絲～🥲  豬排的部分是滿好吃的啦😂外酥內嫩，還不錯\n\n📦酥皮豆腐\n上桌時覺得蠻特別的，用筷子去滑去戳，真的蠻酥的，用的是嫩豆腐，口味清爽，只是擺久了皮會軟是一定的\n\n🎈整體而言，拉麵的價位和整體味道是算高CP值，算是平價滿不錯的店",null,[0,240]]]],[null,null,null,null,null,"https://business.google.com/local/business/11089211807260762878/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR3Y2xneVpGaE5WVGx1V2xjd2VGRjVNVE5VTVRnMFZHcFNSbE5zUlJBQhAA",[null,null,null,"/local/business/11089211807260762878/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR3Y2xneVpGaE5WVGx1V2xjd2VGRjVNVE5VTVRnMFZHcFNSbE5zUlJBQhAA"],"https://business.google.com/local/business/11089211807260762878/c