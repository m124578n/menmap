,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["點給兒子吃的，看照片感覺很可口，加上兒子愛吃拉麵。\n拿餐的時候愣了一下，想說是不是還有東西沒有齊全，店員說餐點已經好了。 內容物少到可憐，整碗拉麵只有空虛能形容，10歲小孩都說吃不飽。 湯頭不行、麵體不行、叉燒肉小又不可口….\n人生中最低分拉麵。\n\n菜單照片真的是照騙。\n建議 ，很建議 ，非常建議 避雷",null,[0,113]]]],[null,1788318135000000,1788318135000000,"1 天前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfS2E5eG56ZFJLalZTOEhHQm9iV0hSdw%7CCAEQrcz1_gkiMAoZQ0hfS2E5eG56ZFJLalZTOEhHQm9iV0hSdxoTQ2d3SXQ2UGUxQVlRNTgyWmp3RQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwj1hramy9KWAxUwnK8BHftbOwYQ_2MIeCgH"],"https://business.google.com/local/business/5280228949005255287/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUZwc1pFZFJNa1kxVGtaa2FVMVlUVFJXVlZKTlpWZGtOR05GUlJBQhAA",[null,null,null,"/local/business/5280228949005255287/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUZwc1pFZFJNa1kxVGtaa2FVMVlUVFJXVlZKTlpWZGtOR05GUlJBQhAA"],"https://business.google.com/local/business/5280228949005255287/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUZwc1pFZFJNa1kxVGtaa2FVMVlUVFJXVlZKTlpWZGtOR05GUlJBQhAA",[null,null,null,"/local/business/5280228949005255287/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUZwc1pFZFJNa1kxVGtaa2FVMVlUVFJXVlZKTlpWZGtOR05GUlJBQhAA"],null,"https://business.google.com/local/business/5280228949005255287/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUZwc1pFZFJNa1kxVGtaa2FVMVlUVFJXVlZKTlpWZGtOR05GUlJBQhAA",[null,null,null,"/local/business/5280228949005255287/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUZwc1pFZFJNa1kxVGtaa2FVMVlUVFJXVlZKTlpWZGtOR05GUlJBQhAA"],null,["zh-Hant"],[["您好，很抱歉這次的用餐體驗讓您如此失望，也很遺憾原本是想讓孩子吃喜歡的拉麵，最後卻讓您留下不好的印象。\n\n您提到餐點份量、湯頭、麵體及叉燒的問題，我們都會認真檢視。尤其實際餐點與菜單照片呈現有所落差，讓您產生「期待很高、實際卻失望」的感受，這部分確實是我們需要改善的地方。\n\n我們會將您的意見回饋給內部團隊，重新檢視餐點內容、份量及品質，希望實際提供給客人的餐點，能與照片及我們想呈現的品質更加一致。\n\n很抱歉這次沒有帶給您滿意的用餐體驗，也謝謝您願意留下詳細的意見，讓我們有機會檢討與改進。\n",null,[0,51]]]],[null,null,null,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT20weFpsZEdRMkY1TkZkaU1YTTRWVVJNZVdkNGNFRRAB!2m1!1s0x0:0x7e9d3842c6dbc9d!3m1!1s2@1:CAIQACodChtycF9oOm0xZldGQ2F5NFdiMXM4VURMeWd4cEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT20weFpsZEdRMkY1TkZkaU1YTTRWVVJNZVdkNGNFRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT20weFpsZEdRMkY1TkZkaU1YTTRWVVJNZVdkNGNFRRI-Ci9DQUlRQUNvZENodHljRjlvT20weFpsZEdRMkY1TkZkaU1YTTRWVVJNZVdkNGNFRRILMGVaS05NQTFKcWgaPgovQ0FJUUFDb2RDaHR5Y0Y5b09tMHhabGRHUTJGNU5GZGlNWE00VlVSTWVXZDRjRUUSCzBlWktOTUExSnFoIhIJAAAAAAAAAAARnbxtLITT6QcqCzBlWktOTUExSnFo\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwj1hramy9KWAxUwnK8BHftbOwYQoykIeSgI"],null,[null,[[1,0]]]],"0ahUKEwjBtbumy9KWAxWveV4EHehtLSYQ0pMFCDsoBQ"],null,null,null,"0ahUKEwj1hramy9KWAxUwnK8BHftbOwYQ0pMFCG0oBQ"],[["Ci9DQUlRQUNvZENodHljRjlvT2xKTVJuTXdOalZmT0dST056bFBYMDlyYWpCM2QzYxAB",["0x0:0x7e9d3842c6dbc9d",null,1787740776071020,1787740776071020,[null,null,["https://www.google.com/maps/contrib/106077078022779994177/reviews?hl\u003dzh-TW"],null,null,["李小葵","https://lh3.googleusercontent.com/a-/ALV-UjWj0e2NYn7OyOkftNID3IHX_IcUde-HImyjsr940GrGZsDaeuGR\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/106077078022779994177?hl\u003dzh-TW"],"106077078022779994177",null,18,2,null,[1,4,1],4,["在地嚮導 · 18 則評論",null,null,null,null,[null,"0ahUKEwj1hramy9KWAxUwnK8BHftbOwYQpr8GCHsoAA"]]]],null,"1 週前",null,null,null,null,null,null,["Google","https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,1],[[1],null,[["CIABIhBiZHTZFzxBj3A-3BcnidSh",["CIABIhBiZHTZFzxBj3A-3BcnidSh",10,12,null,null,null,["https://lh3.googleusercontent.com/grass-cs/ACvplmPXq8-LVJg16TaNdjDqXNmHnsqoSl1aHztznbhBuBm6N6DnlHxs8SEFAdAMzOQj-IQpswLi-viQN_91iFb8alIbHhp_TSK9quHhpYTWapFdtu0NUX2lDexkUAL3g-A7JWQL9OC-a36-VH4\u003dk-