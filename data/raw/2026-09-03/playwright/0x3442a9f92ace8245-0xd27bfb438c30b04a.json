ercontent.com/gpms-cs-s/AFP8RcNNX3bc0YnAB2TH20h6f4gX61okbvMN0oFExiw0lUvP_BGfAIJi2SphXbH87QZoW5BfxBQM-UNXwtcQkuFV1c_ns_xkJMmfUduEroEjCYzxXtNzUOk8szrPqjoTRSpFiv1ILq1AfOLmbw8\u003dm18",1],[22,720,1280,"https://lh3.googleusercontent.com/gpms-cs-s/AFP8RcNNX3bc0YnAB2TH20h6f4gX61okbvMN0oFExiw0lUvP_BGfAIJi2SphXbH87QZoW5BfxBQM-UNXwtcQkuFV1c_ns_xkJMmfUduEroEjCYzxXtNzUOk8szrPqjoTRSpFiv1ILq1AfOLmbw8\u003dm22",1],[0,720,1280,"https://lh3.googleusercontent.com/gpms-cs-s/AFP8RcNNX3bc0YnAB2TH20h6f4gX61okbvMN0oFExiw0lUvP_BGfAIJi2SphXbH87QZoW5BfxBQM-UNXwtcQkuFV1c_ns_xkJMmfUduEroEjCYzxXtNzUOk8szrPqjoTRSpFiv1ILq1AfOLmbw8\u003dmm,dash",2],[0,720,1280,"https://lh3.googleusercontent.com/gpms-cs-s/AFP8RcNNX3bc0YnAB2TH20h6f4gX61okbvMN0oFExiw0lUvP_BGfAIJi2SphXbH87QZoW5BfxBQM-UNXwtcQkuFV1c_ns_xkJMmfUduEroEjCYzxXtNzUOk8szrPqjoTRSpFiv1ILq1AfOLmbw8\u003dmm,hls?ibw\u003d750000",3]]],null,null,["0","-3279751636075892662"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xkSlkxRmlUMFZpTTJaNVgwYzBWeTEwVlhkb09HYxAB"]],"CIABIhALiwCB1Ostiur312E5oKkY",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjhvv704tGWAxVQj68BHT5RDAAQ3IcHCFMoBQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjhvv704tGWAxVQj68BHT5RDAAQ3IcHCFQoBg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjhvv704tGWAxVQj68BHT5RDAAQ3IcHCFUoBw",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["好吃，但食材可能不夠乾淨。\n\n［排隊］\n18:52到門口排購票機\n19:08買到票\n店員會一次喊4、5個快到的號碼讓他們排隊在草地邊，沒自己問的人很容易就跟排購票機的隊伍搞混\n19:50入店\n桌子黏黏的小扣分\n19:56着丼\n20:14把麵以外的料都吃完先放下筷子喝水，不到10秒店員就上來要收碗了😅\n\n［風味］特製黑白松露都點換著吃\n很喜歡松露所以黑白兩口味上桌的氣味都很滿意\n第一口湯也非常驚喜\n特別是白湯底的海鮮風味跟松露融合得很圓潤\n旨香濃郁厚重、衝擊極強\n搭配的細麵也留有口感，很巴汁\n碎洋蔥份量不大但默默有平衡回來一點清爽度\n雞叉燒舒肥得剛好/但豬叉燒2種中泡在湯裡的太柴又有筋/捲成玫瑰型的除了嫩還有炙燒過好吃許多\n溏心蛋熟度很剛好，心也有入味\n肉紙取代海苔也很聰明，這東西就算單吃都好吃啊\n\n但比較有問題的可能是海瓜子肉，有點腥味\n我後來出店後持續反胃、嘔吐反應（但在商圈所以沒真的吐掉），大概1小時後才平靜下來，懷疑是這個食材有狀況\n\n［價位］\n360-370在台灣還算是微高\n考量到有高價食材干貝松露肉紙等等就變正常範圍\n就不拿去跟日幣1800的比較了😂\n\n整體來說，等候時間雖長但不用苦站所以體驗還行，料理風味可圈可點。\n沒證據問題是不是食材不想扣太多分，但食安真的很重要還是麻煩再正視一下吧！",null,[0,19]]]],[null,null,null,null,null,"https://business.google.com/local/business/6280102188131553471/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrU2xreFJtbFVNRlpwVFRKYU5WZ3dZekJXZVRFd1ZsaGtiMDlIWXhBQhAA",[null,null,null,"/local/business/6280102188131553471/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrU2xreFJtbFVNRlpwVFRKYU5WZ3dZekJXZVRFd1ZsaGtiMDlIWXhBQhAA"],"https://business.google.com/local/business/6280102188131553471/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrU2xreFJtbFVNRlpwVFRKYU5WZ3dZekJXZVRFd1ZsaGtiMDlIWXhBQhAA",[null,null,null,"/local/business/6280102188131553471/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrU2xreFJtbFVNRlpwVFRKYU5WZ3dZekJXZVRFd1ZsaGtiMDlIWXhBQhAA"],null,"https://business.google.com/local/business/6280102188131553471/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrU2xreFJtbFVNRlpwVFRKYU5WZ3dZekJXZVRFd1ZsaGtiMDlIWXhBQhAA",[null,null,null,"/local/business/6280102188131553471/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrU2xreFJtbFVNRlpwVFRKYU5WZ3dZekJXZVRFd1ZsaGtiMDlIWXhBQhAA"]],[null,null,5947,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xkSlkxRmlUMFZpTTJaNVgwYzBWeTEwVlhkb09HYxAB!2m1!1s0x0:0xd27bfb438c30b04a!3m1!1s2@1:CAIQACodChtycF9oOldJY1FiT0ViM2Z5X0c0Vy10VXdoOGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xkSlkxRmlUMFZpTTJaNVgwYzBWeTEwVlhkb09HYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xkSlkxRmlUMFZpTTJaNVgwYzBWeTEwVlhkb09HYxI-Ci9DQUlRQUNvZENodHljRjlvT2xkSlkxRmlUMFZpTTJaNVgwYzBWeTEwVlhkb09HYxILMGVKNFM0bXVzVjYaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sZEpZMUZpVDBWaU0yWjVYMGMwVnkxMFZYZG9