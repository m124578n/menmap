冰水\n桌上有蒜泥和七味粉可以使用",null,[0,28]]]],[null,null,null,null,null,"https://business.google.com/local/business/15253880160485935246/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YUdFeFNuaGlWWEF3VDFaUk1VNUlaekpWTWxwbVVqTnNWazVIWXhBQhAA",[null,null,null,"/local/business/15253880160485935246/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YUdFeFNuaGlWWEF3VDFaUk1VNUlaekpWTWxwbVVqTnNWazVIWXhBQhAA"],"https://business.google.com/local/business/15253880160485935246/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YUdFeFNuaGlWWEF3VDFaUk1VNUlaekpWTWxwbVVqTnNWazVIWXhBQhAA",[null,null,null,"/local/business/15253880160485935246/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YUdFeFNuaGlWWEF3VDFaUk1VNUlaekpWTWxwbVVqTnNWazVIWXhBQhAA"],null,"https://business.google.com/local/business/15253880160485935246/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YUdFeFNuaGlWWEF3VDFaUk1VNUlaekpWTWxwbVVqTnNWazVIWXhBQhAA",[null,null,null,"/local/business/15253880160485935246/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YUdFeFNuaGlWWEF3VDFaUk1VNUlaekpWTWxwbVVqTnNWazVIWXhBQhAA"]],[null,null,1868,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25waGExSnhiVXAwT1ZRMU5IZzJVMlpmUjNsVk5HYxAB!2m1!1s0x0:0xa4ed603fe7a4194!3m1!1s2@1:CAIQACodChtycF9oOnpha1JxbUp0OVQ1NHg2U2ZfR3lVNGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25waGExSnhiVXAwT1ZRMU5IZzJVMlpmUjNsVk5HYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25waGExSnhiVXAwT1ZRMU5IZzJVMlpmUjNsVk5HYxI-Ci9DQUlRQUNvZENodHljRjlvT25waGExSnhiVXAwT1ZRMU5IZzJVMlpmUjNsVk5HYxILMGUxTjU3ZGc2TngaPgovQ0FJUUFDb2RDaHR5Y0Y5b09ucGhhMUp4YlVwME9WUTFOSGcyVTJaZlIzbFZOR2MSCzBlMU41N2RnNk54IhIJAAAAAAAAAAARlEF6_gPWTgoqCzBlMU41N2RnNk54\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiEi93MwtKWAxUQdvUHHaNlH0wQ