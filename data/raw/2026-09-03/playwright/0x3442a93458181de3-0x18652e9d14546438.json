ull,null,"氣氛",null,"0ahUKEwiV57P-v9KWAxWDcfUHHbCLHXMQ3IcHCOABKAw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11vf1tjzf9"],"招牌豚骨拉麵",2,null,null,"0ahUKEwiV57P-v9KWAxWDcfUHHbCLHXMQ3YcHCOIBKAA"],[["M:/g/11vprvsxmg"],"牛奶白醬",2,null,null,"0ahUKEwiV57P-v9KWAxWDcfUHHbCLHXMQ3YcHCOMBKAE"]],[1]],null,"建議的餐點",null,"0ahUKEwiV57P-v9KWAxWDcfUHHbCLHXMQ3IcHCOEBKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["因為小孩喜歡吃拉麵，加上上次在桃園店的體驗不錯，很驚喜在住家附近開了一家，連續兩天假日都去享用，禮拜六中午12：30過去，店裡還蠻忙的，但店員服務態度很好，整個帶位流程也很流暢；禮拜日下午4:20過去，當時只有吧檯有幾位客人，後面的座位並沒有人，我們是3個人進去，店員有說要等10分多鐘，但排在我們後面的1個人卻不用等，直接帶位，即使因吧檯座位不夠，只能供1個人，也應該先跟我們說一下，加上點餐臺旁公布的假日營業時間，並沒有說中間有休息時間，也沒有說只開放一半的座位，雖然等待時間真的就如店員所說的10幾分鐘，但她最後還是帶我們到後面的座位坐，那為什麼不一開始就先帶客人入座呢？而且等待的時間並沒有其他客人，加上請我們入座的椅子上還有菜，沒清潔乾淨。另外，上菜時，該名店員放菜都很不高興的‘’用力‘’放在桌上，我是不知道她在不開心什麼，從頭到尾我們都沒有擺臭臉或凶店員或跟店員反應任何的問題，不知道該店員為什麼要這樣，先生說餐點是好吃的（點了招牌豚骨、牛奶白湯和牛肉蛤蜊，推前兩樣），但服務態度這樣，會讓人望而卻步。禮拜六有5顆星，禮拜日只剩1顆星，綜合3顆星，希望時晴時雨的服務態度能有所改善，不然讓愛吃拉麵的我們少一間店去，覺得很可惜。",null,[0,240]]]],[null,null,null,null,null,"https://business.google.com/local/business/18389778852401911248/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUXpkRmx0VlVGbkVBRRAA",[null,null,null,"/local/business/18389778852401911248/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUXpkRmx0VlVGbkVBRRAA"],"https://business.google.com/local/business/18389778852401911248/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUXpkRmx0VlVGbkVBRRAA",[null,null,null,"/local/business/18389778852401911248/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUXpkRmx0VlVGbkVBRRAA"],null,"https://business.google.com/local/business/18389778852401911248/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUXpkRmx0VlVGbkVBRRAA",[null,null,null,"/local/business/18389778852401911248/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUXpkRmx0VlVGbkVBRRAA"]],[null,null,8642,["https://www.google.com/maps/reviews/da