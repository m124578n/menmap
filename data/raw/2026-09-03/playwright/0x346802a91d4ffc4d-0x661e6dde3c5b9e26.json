l,"訂單類型",null,"0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3IcHCEEoAg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3YcHCEQoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3IcHCEMoAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3YcHCEYoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3IcHCEUoBA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3IcHCEcoBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3IcHCEgoBg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3IcHCEkoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11v0yc8l4n"],"味噌拉麵",2,null,null,"0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3YcHCEsoAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiN_JD2xtKWAxVmm68BHYlaDgwQ3IcHCEooCA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["在地住了10年，這次是第二次到店內用餐，我點了豚骨叉燒拉麵，還有酥炸魚排。\n\n跟第一次品嚐的時候一樣美味，拉麵的湯頭意外的是可以直接喝並喝完的那種，酥炸魚排則因為太好吃了，所以沒有拍照就吃下了。\n\n熱騰騰炸的咔茲咔茲的魚排，一口咬下又充滿魚肉的柔軟與肥美的油脂，沾上附贈的塔塔醬，又讓原先可能稍嫌油膩的魚排變得清爽起來。\n\n是很搭配的醬料，嘗試看看一口魚排，一口沾醬的版本，你會獲得非常有趣的體驗。\n\n我真該幫魚排拍照才對。",null,[0,97]]]],[null,null,null,null,null,"https://business.google.com/local/business/6913453235160961839/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFOZUZaSFRrTmpTRnBFWVZoR2NsVkdXVEZqYTFJMFdWUlpOV05XUlJBQhAA",[null,null,null,"/local/business/6913453235160961839/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFOZUZaSFRrTmpTRnBFWVZoR2NsVkdXVEZqYTFJMFdWUlpOV05XUlJBQhAA"],"https://business.google.com/local/business/69134