,null,["ChZDSUhNMG9nS0VJQ0FnTUNvOExxMlZBEAE"]],"CIHM0ogKEICAgMCo8Lq2NA",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["這真的太好笑了，第一次遇到這麼差的服務！他們完全沒看清楚我的訂單細節，我點的是辣度8的拉麵，結果廚師完全沒加辣，還忘了放肉，真是太糟糕了。有沒有給客人之間看一下檢查一下 ， 我不是很容易生氣的人 但是去餐廳要好好吃的，這種錯誤也很誇張 而且不是只有一個\n1. 不放辣\n2. 辣度放的不標準\n3. 沒有肉 XD！非常好笑\n4. 建議如果炸雞還少一塊就晚一點上吧 ， 這樣做也不是看起來餐廳沒有好好的SOP\n～ 人做錯很正常但是錯了很多而且態度不是很好 ， 遇到這樣的狀況誰還有食慾要吃。好吃的東西也變不好吃👎\n\n我們還點了炸雞，結果竟然少了一塊！笑死。\n\n到底這裡的流程和員工是怎麼運作的？\n今天也不是平日，只是普通的一天，他們應該能好好應對才對。\n\n我以前點過這家店的辣拉麵，我知道它該有多辣，所以我很確定今天這碗完全沒達標！我不想再來這裡吃了。",null,[0,133]]]],[null,null,null,null,null,"https://business.google.com/local/business/3388713312440332435/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTnZPRXh4TWxaQkVBRRAB",[null,null,null,"/local/business/3388713312440332435/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTnZPRXh4TWxaQkVBRRAB"],"https://business.google.com/local/business/3388713312440332435/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTnZPRXh4TWxaQkVBRRAB",[null,null,null,"/local/business/3388713312440332435/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTnZPRXh4TWxaQkVBRRAB"],null,"https://business.google.com/local/business/3388713312440332435/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTnZPRXh4TWxaQkVBRRAB",[null,null,null,"/local/business/3388713312440332435/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTnZPRXh4TWxaQkVBRRAB"]],[null,null,null,["https://www.google.com/maps/@/data\u003d!4m7!23m6!1m5!1sChZDSUhNMG9nS0VJQ0FnTUNvOExxMlZBEAE!2m1!1s0x0:0x10d848775316cc7b!3m1!1s2@1:CIHM0ogKEICAgMCo8Lq2VA%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnTUNvOExxMlZBEAE\u0026t\u003d3\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnTUNvOExxMlZBEi4KF0NJSE0wb2dLRUlDQWdNQ284THEyMUFFEhNDZ3dJdmJuMHZ3WVE0UDdYZ3dJIhIJAAAAAAAAAAARe8wWU3dI2BAqCzBiekdteFZTVXhW\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjBgdbr4tGWAxWtdvUHHX_