_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3YcHCHcoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3IcHCHYoFQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3IcHCHgoFg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3IcHCHkoFw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3IcHCHooGA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3YcHCHwoAA"]],1],null,null,"等待時間",null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3IcHCHsoGQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3YcHCH4oAA"]]],null,"座位類型",null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3IcHCH0oGg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["最讓我們印象深刻的是店家的服務。\n\n當天因為下雨，店裡一直都是客滿狀態。我只是看了一眼剛空出的四人桌，店員就主動詢問要不要幫我們換位子，整個用餐過程也都會關心餐點是否合口味，讓人感受到他們是真的很重視客人的用餐感受。\n\n我們點的是雙人套餐，前菜的雙色法棍（香蒜／明太子）醬料很足，麵包外酥內軟，非常好吃；冰漬番茄鮮奶油更是必點，番茄冰涼香甜，搭配鮮奶油意外地清爽又開胃。\n\n主餐方面，野菜旬菜咖哩色彩豐富、蔬菜種類很多；拿坡里義大利麵則屬於中規中矩。甜點推薦奶酪，奶香濃郁、口感滑順，讓人印象很好。\n\n整體來說，餐點大約有 8 分的水準，但店員溫暖又貼心的服務，讓整體用餐體驗直接加分許多，也讓我們願意為了這份舒服的氛圍再次回訪。",null,[0,16]]]],[null,null,null,null,null,"https://business.google.com/local/business/17270342454048563654/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBSTUdKc2NHNWtWbVJJWkVVNE5GRnRSa2ROVkZJMFdrVkdVRkZzUlJBQhAA",[null,null,null,"/local/business/17270342454048563654/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBSTUdKc2NHNWtWbVJJWkVVNE5GRnRSa2ROVkZJMFdrVkdVRkZzUlJBQhAA"],"https://business.google.com/local/business/1727034245404856365