null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3YcHCPgBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3IcHCPcBKBU",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3YcHCPoBKAA"]],1],null,null,"等待時間",null,"0ahUKEwi18_-Fw9KWAxXqa_UHHfUkOnMQ3IcHCPkBKBY",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["第一次來到日向洋食，外觀就已經很吸引我了，很復古的日式建築，男朋友的愛店！\n進去到裡面一樓已經沒有位置了，所以請我上二樓的位置，樓梯很窄要小心走。\n我點了＜多蜜醬純牛漢堡排＞男朋友點＜拿坡里義大利麵＞\n還有飲品＜漂浮哈密瓜蘇打＞跟＜天堂鳥冰茶＞\n餐點都看起來很美味精緻\n多蜜純牛肉漢堡排～很紮實，味道也很濃郁，很好吃哦\n拿坡里義大利麵～男友吃的我只有吃一口沒辦法仔細說出味道🤭\n漂浮哈密瓜蘇打～真的是很特別的飲品，只是對我來說太甜了，但是是很特別的風味哦！\n天堂鳥冰茶～是錫蘭紅茶，有附上奶油，像奶茶囉！男友說可以淋下去，結果沒有往下流營造出美美的樣子！🤣\n店長人也很好，還來陪我們聊天😊\n明治布丁～也很好吃哦，不會太甜，入口即化很軟嫩！\n有機會再來吃其他的餐點♥️",null,[0,100]]]],[null,null,null,null,null,"https://business.google.com/local/business/17270342454048563654/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1VlZrd1pGSldSM016VVZkb1JsZEZjRFpWUlRRMFpXMWFWRTFZWXhBQhAA",[null,null,null,"/local/business/17270342454048563654/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1VlZrd1pGSldSM016VVZkb1JsZEZjRFpWUlRRMFpXMWFWRTFZWXhBQhAA"],"https://business.google.com/local/business/17270342454048563654/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1VlZrd1pGSldSM016VVZkb1JsZEZjRFpWUlRRMFpXMWFWRTFZWXhBQhAA",[null,null,null,"/local/business/17270342454048563654/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1VlZrd1pGSldSM016VVZkb1JsZEZjRFpWUlRRMFpXMWFWRTFZWXhBQhAA"],null,"https://business.google.com/local/business/17270342454048563654/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1VlZrd1pGSldSM016VVZkb1JsZEZjRFpWUlRRMFpXMWFWRTFZWXhBQhAA",[null,null,null,"/local/business/17270342454048563654/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1VlZrd1pGSldSM016VVZkb1JsZEZjRFpWUlRRMFpXMWFWRTFZWXhBQhAA"]],