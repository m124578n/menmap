],"CIHM0ogKEICAgMCQl6LyzwE",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwiszs6QwtKWAxWvd_UHHVdkFs4Q3YcHCG8oAA"]],1],null,null,"訂單類型",null,"0ahUKEwiszs6QwtKWAxWvd_UHHVdkFs4Q3IcHCG4oBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiszs6QwtKWAxWvd_UHHVdkFs4Q3YcHCHEoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiszs6QwtKWAxWvd_UHHVdkFs4Q3IcHCHAoBQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwiszs6QwtKWAxWvd_UHHVdkFs4Q3YcHCHMoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiszs6QwtKWAxWvd_UHHVdkFs4Q3IcHCHIoBg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiszs6QwtKWAxWvd_UHHVdkFs4Q3IcHCHQoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiszs6QwtKWAxWvd_UHHVdkFs4Q3IcHCHUoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiszs6QwtKWAxWvd_UHHVdkFs4Q3IcHCHYoCQ",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["聽朋友說是內湖捷運站旁的巷弄美食，今天終於有機會來嚐嚐。\n剛進來店內有一種巷弄的寧靜感，簡單道地的日本風格，老闆親自在廚房準備餐點，外場由可愛親切的工讀妹妹招呼就座，一看到菜單就驚呼台北竟然還有這樣佛心的價錢，便宜的讓人懷疑老闆是在做公益嗎！？\n跟太太點了一碗叉燒拉麵、炸蝦天婦羅定食、炒水耕Ａ菜、香草厚切豬排、炸蝦手捲及炙燒鮭魚手捲（點好點滿）。\n當餐點一樣一樣上桌時，有如一場味覺的旅程，拉麵湯頭濃郁、叉燒彈韌不肥膩、炸蝦天婦羅金黃酥脆，輕盈不油膩，蝦肉鮮甜彈口、香草豬排及手捲也都很好吃，驚喜連連。\n再過一會兒進來的客人就需要等30分鐘到一小時才能享受到餐點，感受到老闆的職人精神，一道一道為客人準備最美味的餐點，寧願失去等不及的客人也不匆促出餐，值得一再造訪的好餐廳。",null,[0,122]]]],[null,null,null,null,null,"https://business.google.com/local/business/15297181902870937870/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTlJiQzE2WWtwUkVBRRAA",[null,null,null,"/local/business/15297181902870937870/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTlJiQzE2WWtwUkVBRRAA"],"https://business.google.com/local/business/15297181902870937870/customers/re