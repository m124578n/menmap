Tsai"],"https://www.google.com/maps/contrib/111149397020237640004?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjXSj3w5o26CjRTNE73V2dPoWyN7HdGEX0ZqJskFkDrHjhVsb_RE\u003ds120-c-rp-mo-ba12-br100",null,null,"111149397020237640004"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2018,9,19,3,null,null,null,null,["7 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDEhfudFw\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x196450e3f96e9911"]],1,null,null,null,null,null,null,["0","1829676288691837201"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUNnXzhYVThBRRAB"]],"CIHM0ogKEICAgIDEhfudFw",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["可以想像一下就像買了鹹酥雞跟啤酒在家的感覺，很放鬆，東西不貴，有炸的、魯味還有主食，魯味的大腸不錯吃，雞軟骨也不賴，是新莊啤酒暢飲的爽店。\n很像是外面便當地的雞腿便當，灑上的許多胡椒鹽，讓味道更香，一口咬下，會有「考考」的酥脆感聲音，接著還有雞腿肉的肉汁，軟嫩多汁的肉質再加上脆皮，很讓人想豪邁的直接用手拿起雞腿，一邊啃肉一邊喝酒。對了喜歡再重一點口味的，可以沾一點店家自製的辣椒醬，吃上一眼就會讓人直呼，酒來酒來。\n蔥花蛋炒的很威，在熟與不熟之間取到一個平衡點，吃起來滑嫩好入口，還帶有蔥香味，很容易讓人一口接著一口吃下，只能說這廚房的火候功夫了得，極力推薦蔥花蛋炒。",null,[0,285]]]],[null,null,null,null,null,"https://business.google.com/local/business/4334073311914186757/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTm5YemhZVlRoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4334073311914186757/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTm5YemhZVlRoQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/4334073311914186757/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTm5YemhZVlRoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4334073311914186757/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTm5YemhZVlRoQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/4334073311914186757/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTm5YemhZVlRoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/4334073311914186757/customers