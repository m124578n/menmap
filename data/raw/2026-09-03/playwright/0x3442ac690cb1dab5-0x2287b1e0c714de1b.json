l,null,"停車位",null,"0ahUKEwiyz4e-vtKWAxXmla8BHW4KFpMQ3IcHCG4oFQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_KID_FRIENDLINESS_TIPS"],"親子友善程度",null,null,"分享親子友善程度相關資訊","親子友善程度",null,"0ahUKEwiyz4e-vtKWAxXmla8BHW4KFpMQ3IcHCHAoFg",null,null,["沒有兒童椅，建議國小以上再去"],null,null,3,null,2],[["GUIDED_DINING_ACCESSIBILITY_TIPS"],"無障礙設施",null,null,"分享無障礙空間相關資訊","無障礙設施",null,"0ahUKEwiyz4e-vtKWAxXmla8BHW4KFpMQ3IcHCHEoFw",null,null,["無，空間不大"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:VEGETARIAN_OPTIONS"],"素食餐點",2,null,null,"0ahUKEwiyz4e-vtKWAxXmla8BHW4KFpMQ3YcHCHMoAA"],[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiyz4e-vtKWAxXmla8BHW4KFpMQ3YcHCHQoAQ"],[["E:KID_FRIENDLINESS"],"親子友善程度",2,null,null,"0ahUKEwiyz4e-vtKWAxXmla8BHW4KFpMQ3YcHCHUoAg"],[["E:ACCESSIBILITY"],"無障礙設施",2,null,null,"0ahUKEwiyz4e-vtKWAxXmla8BHW4KFpMQ3YcHCHYoAw"]]],null,null,null,"0ahUKEwiyz4e-vtKWAxXmla8BHW4KFpMQ3IcHCHIoGA",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["內湖有名的雞湯拉麵\n通常排隊15分鐘起跳\n大概有四到五種可選\n有較淡湯頭或塩味\n還有重口味的辣味\n這裡的拉麵我都喜歡\n尤其剩些湯的時候\n加白飯做雜炊粥也不錯\n\n除了拉麵也有叉燒飯\n也可加點三款叉燒\n及一款豚軟骨角煮\n（燉豬五花+燉蘿蔔）\n\n整體而言\n美味且品質穩定\n但沒有太特別的驚喜\n（雖牆上有些限定口味\n但還未在點餐機上見過）\n不算平價但確實值得一吃",null,[0,30]]]],[null,null,null,null,null,"https://business.google.com/local/business/18417016649273108980/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4ZGxOcmFISk9Semw1VTJ4Vk1FOVhPVnBOVlZaYVUxZEZlRmx1WXhBQhAA",[null,null,null,"/local/business/18417016649273108980/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4ZGxOcmFISk9Semw1VTJ4Vk1FOVhPVnBOVlZaYVUxZEZlRmx1WXhBQhAA"],"https://business.google.com/local/business/18417016649273108980/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4ZGxOcmFISk9Semw1VTJ4Vk1FOVhPVnBOVlZaYVUxZEZlRmx1WXhBQhAA",[null,null,null,"/local/business/18417016649273108980/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4ZGxOcmFISk9Semw1VTJ4Vk1FOVhPVnBOVlZaYVUx