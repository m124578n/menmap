,null,null,["長生塩人 蘆洲"]],[null,[[["Ink"],"https://www.google.com/maps/contrib/100736544647745372295?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjW75uZO_stCmWqTdzsTVJHKF8Y5CO2BhUUhyWnfHewxq6Dlr6g\u003ds120-c-rp-mo-ba12-br100",null,null,"100736544647745372295"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,3,15,18,null,null,null,null,["5 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhCAM_G78Atdayt5ZvN_5YZh\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x40d311cf2fb1e237"]],1,null,null,null,null,null,null,["0","4671096820069425719"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xGUVRGcDVXakYzVkMxSVYweHBkRkZZVFdabFdWRRAB"]],"CIABIhCAM_G78Atdayt5ZvN_5YZh",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiT-tW0zNKWAxUPm68BHW8kJ_QQ3IcHCGooBw",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["天母發跡的連鎖拉麵店，餐點制式化，無法依個人喜好調整；沒有冰水，僅有自助飲水機提供冷、熱跟溫水。\n\n🔸塩味拉麵 立成製麵\n塩味湯頭相當清澈，入口鮮鹹帶有淡淡的菇類氣味，一開始還算不差，但吃到後面稍嫌單調，而且莫名的會有一股煮麵的鹼水味浮現；立成細麵口感略硬，切齒感較豪億俐落許多，很不錯；炙燒豬肉香氣迷人，肉味十足，好吃；舒肥雞肉也不差，但跟炙燒豬肉比起來遜色了不少。\n\n🔸期間限定 韓國牡春 立成製麵\n湯頭色白偏黃綠，口感略沙濁，入口後在鼻腔處會有股異樣的香氣，滋味鮮甘，雖說主打牡蠣，但卻缺乏醇厚的牡蠣味，反倒是有股類似皮蛋或濃豚湯發酵的奇妙韻味，另外還有股酒嗆感；細麵條，偏硬，切齒感俐落，口感很不錯；舒肥雞肉口感軟潤偏涼，還不錯吃。\n\n🔸日本炒麵\n黏口，鹹甜帶酸氣，個人不愛這種醬油+烏醋+美乃滋的味道；豬肉好吃。\n\n🔸溏心蛋\n蛋黃偏熟，味道一般。\n\n🔸自家金黃蘿蔔\n醃蘿蔔，脆甜爽口，好吃。\n\n🔸自家黃金翡翠\n醃娃娃菜，滋味甜口；個人比較喜歡蘿蔔的口感。\n\n🔸期間限定 韓國辣拌年糕\n中小辣；年糕很Q，咀嚼起來相當紮實，黑紅醬鮮甜香辣，很不錯。",null,[0,60]]]],[null,1773623577000000,1773623577000000,"5 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfUy10WUlXNGU0MWhxMUk1aVh0WHpGdw%7CCAEQrcz1_gkiMAoZQ0hfUy10WUlXNGU0MWhxMUk1aVh0WHpGdxoTQ2d3SW1iTGR6UVlRNHFlTF9BRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiT-tW0zNKWAxUPm68BHW8kJ_QQ_2MIaygI"],"https://business.google.com/local/business/8746571777135930101/customers/reviews/reply?p\u