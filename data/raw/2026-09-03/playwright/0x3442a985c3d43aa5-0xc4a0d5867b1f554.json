WAxWKiX0EHfx_G7sQ3IcHCFooBA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjv2u35vtKWAxWKiX0EHfx_G7sQ3IcHCFsoBQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjv2u35vtKWAxWKiX0EHfx_G7sQ3IcHCFwoBg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwjv2u35vtKWAxWKiX0EHfx_G7sQ3YcHCF4oAA"]],1],null,null,"預訂網址",null,"0ahUKEwjv2u35vtKWAxWKiX0EHfx_G7sQ3IcHCF0oBw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_30_TO_60_MIN"],"30 到 60 分鐘",2,null,null,"0ahUKEwjv2u35vtKWAxWKiX0EHfx_G7sQ3YcHCGAoAA"]],1],null,null,"等待時間",null,"0ahUKEwjv2u35vtKWAxWKiX0EHfx_G7sQ3IcHCF8oCA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwjv2u35vtKWAxWKiX0EHfx_G7sQ3YcHCGIoAA"],[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwjv2u35vtKWAxWKiX0EHfx_G7sQ3YcHCGMoAQ"]]],null,"座位類型",null,"0ahUKEwjv2u35vtKWAxWKiX0EHfx_G7sQ3IcHCGEoCQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["連來吃兩天，但不知道怎樣剛好連兩次用餐，旁邊坐的客人都超鬼😐用餐體驗大打折扣…進而影響到餐點美味度…\n但男女店員都蠻熱情的，店家本身服務態度都沒問題，就是排隊問題可以優化。\n\n比起隔壁條路的拉麵店，這邊排隊進度快些，加上開店時間是錯開的，白天如果想吃另外一家沒吃到，可以晚上來吃這家。\n\n餐點部分，泡系雞湯比較濃郁，喜歡清爽者可略過，個人不愛，喝起來像飯店的熬雞湯，醬油湯頭不會過鹹，是可以喝完的。\n叉燒飯調味不錯，但飯很軟爛不太喜。\n最重要的一點是，拉麵沒有溏心蛋🥲蛋是靈魂，所以它沒辦法是心目中滿分拉麵，但很適合對蛋過敏者。\n\n另排隊方式確實可以參考一下別人，要讓客人提早排隊卻又要站著等，又是轉角人行道，另家拉麵店也是要提早排隊，但老闆娘都會知道開店前的候位順序！也減少一些不必要的紛爭，強烈建議店家把點餐機外移吧，先到的就先點，開店後按照點餐號碼叫號。\n\n剛好那天大家都沒站在門口等，結果遇到不要臉的兩位女生，看到店家準備開門馬上衝到門口去😐當其他在那邊等的客人都是傻子嗎…店家好像也無法控管，體感很差。（而且很吵從排隊就講話很大聲，吃飯也是，有夠吵！）",null,[0,86]]]],[null,null,null,null,null,"https://business.google.com/local/business/2270775935772479147/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDUzJSNlRtaGhNVVpEVlZkd1RWbFhhM2xhTTBwdVRVZGFhMkV3UlJBQhAA