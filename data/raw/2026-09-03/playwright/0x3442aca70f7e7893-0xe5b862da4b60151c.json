]]]],null,"8 個月前",null,null,null,null,null,null,["Google","https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,1],[[3],null,null,null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["OSHO 拉麵是南港軟體園區極具實用性的午餐選擇，其核心價值在於高 CP 值，而非精緻美味。\n\u200b【最大優勢】\n\u200b無敵 CP 值： 售價僅約 NT$180，並提供免費加麵、加湯的服務。這使它成為預算有限，但想吃飽、吃熱食的上班族首選。\n\u200b【口味與不足】\n\u200b口味普通： 湯頭屬於清爽大眾化的豚骨風味，味道合格，但缺乏特色或記憶點。整體而言，口味僅為一般水準。\n\u200b叉燒不佳： （根據您的回饋） 叉燒肉是主要的扣分項，口感或風味不理想，未能為拉麵加分。\n\u200b選擇少： 菜單僅有原味和微辣兩種選擇。",null,[0,116]]]],[null,null,null,null,null,"https://business.google.com/local/business/7562778038056767542/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTYm1FeVNrUlNNR3hDVEZZNVlVNUlhM2RXYmtJMlZVVm9UbHBWUlJBQhAA",[null,null,null,"/local/business/7562778038056767542/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTYm1FeVNrUlNNR3hDVEZZNVlVNUlhM2RXYmtJMlZVVm9UbHBWUlJBQhAA"],"https://business.google.com/local/business/7562778038056767542/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTYm1FeVNrUlNNR3hDVEZZNVlVNUlhM2RXYmtJMlZVVm9UbHBWUlJBQhAA",[null,null,null,"/local/business/7562778038056767542/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTYm1FeVNrUlNNR3hDVEZZNVlVNUlhM2RXYmtJMlZVVm9UbHBWUlJBQhAA"],null,"https://business.google.com/local/business/7562778038056767542/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTYm1FeVNrUlNNR3hDVEZZNVlVNUlhM2RXYmtJMlZVVm9UbHBWUlJBQhAA",[null,null,null,"/local/business/7562778038056767542/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTYm1FeVNrUlNNR3hDVEZZNVlVNUlhM2RXYmtJMlZVVm9UbHBWUlJBQhAA"]],[null,null,6202,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pSbmEySkRSMGxCTFY5YU5Ia3dWbkI2VUVoTlpVRRAB!2m1!1s0x0:0xe5b862da4b60151c!3m1!1s2@1:CAIQACodChtycF9oOjRna2JDR0lBLV9aNHkwVnB6UEhNZUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/cont