7xNKWAxURc_UHHfdhMW4Q3IcHCEYoBQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi7yLv7xNKWAxURc_UHHfdhMW4Q3IcHCEgoBg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi7yLv7xNKWAxURc_UHHfdhMW4Q3IcHCEkoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi7yLv7xNKWAxURc_UHHfdhMW4Q3IcHCEooCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwi7yLv7xNKWAxURc_UHHfdhMW4Q3YcHCEwoAA"]]],null,"用餐人數",null,"0ahUKEwi7yLv7xNKWAxURc_UHHfdhMW4Q3IcHCEsoCQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi7yLv7xNKWAxURc_UHHfdhMW4Q3YcHCE4oAA"]],1],null,null,"等待時間",null,"0ahUKEwi7yLv7xNKWAxURc_UHHfdhMW4Q3IcHCE0oCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["1.菜單只有原味豚骨或微辣豚骨2種選擇，同樣為$180。周四18：50左右造訪不用等待可直接入座。老闆一人作業，不過上菜速度很快，態度也很親切。\n2.本次享用微辣版本，應該是加入辣味肉燥，比預期中辣，湯頭口味不會太鹹。麵條是細麵，口感偏硬很有嚼勁，搭配隨餐附的半顆溏心蛋、叉燒肉、些許豆芽菜及海苔還不錯吃。\n3.內用可以無限加麵與加一次湯，CP值非常高。本次加湯時選擇原味湯頭，口味乾淨，呈現出單純豚骨高湯的滋味。\n4.內用環境乾淨舒適，搭配柔和的輕音樂，靜靜地品嚐一碗拉麵的靜謐時光，很是放鬆。",null,[0,153]]]],[null,null,null,null,null,"https://business.google.com/local/business/7562778038056767542/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyTWxOWGNHNWFhemxSWVVSV1VGWnNUbXRPTVdRMFVtMTBRbUpJWXhBQhAA",[null,null,null,"/local/business/7562778038056767542/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyTWxOWGNHNWFhemxSWVVSV1VGWnNUbXRPTVdRMFVtMTBRbUpJWXhBQhAA"],"https://business.google.com/local/business/7562778038056767542/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyTWxOWGNHNWFhemxSWVVSV1VGWnNUbXRPTVdRMFVtMTBRbUpJWXhBQhAA",[null,null,null,"/local/business/7562778038056767542/customers/reviews/deletereply?p\u0