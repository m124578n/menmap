G_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwjMm4mWzNKWAxXAePUHHRJFLdcQ3YcHCKwBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjMm4mWzNKWAxXAePUHHRJFLdcQ3IcHCKsBKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["43 私廚\n中午時間人不算太多，環境乾淨，且餐點還滿快的。\n這次和朋友點了鮮蝦味噌拉麵及鮮蝦豚骨拉麵，小菜是煙燻豬頭皮和豆乾，還有兩杯冰紅茶。\n不管是味噌的口味或是豚骨的口味，我們兩個都還算喜歡，不會偏鹹，是個可以把湯喝完的鹹度，而且蝦子還蠻新鮮的，也蠻多隻，所以我們覺得CP值還蠻高的。\n小菜也好吃紅茶也不會偏甜，整體而言如果在這附近出差的話，是會在回訪的店。\n\n兩人點了兩碗麵，兩個小菜和兩杯紅茶 NTD 58",null,[0,71]]]],[null,1774107129000000,1774107129000000,"5 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfSy1nUjNCdC1qNFpYS0FvTEJQRjlDQQ%7CCAEQrcz1_gkiMAoZQ0hfSy1nUjNCdC1qNFpYS0FvTEJQRjlDQRoTQ2d3SS1mUDZ6UVlRM3RUcjZ3SQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjMm4mWzNKWAxXAePUHHRJFLdcQ_2MIrQEoEA"],"https://business.google.com/local/business/3883731542078944564/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4U21OSFZtRmxWbXN5VVZoQ2FtRXpiRlppVlc5MFZqSjRVazR5WXhBQhAA",[null,null,null,"/local/business/3883731542078944564/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4U21OSFZtRmxWbXN5VVZoQ2FtRXpiRlppVlc5MFZqSjRVazR5WXhBQhAA"],"https://business.google.com/local/business/3883731542078944564/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4U21OSFZtRmxWbXN5VVZoQ2FtRXpiRlppVlc5MFZqSjRVazR5WXhBQhAA",[null,null,null,"/local/business/3883731542078944564/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4U21OSFZtRmxWbXN5VVZoQ2FtRXpiRlppVlc5MFZqSjRVazR5WXhBQhAA"],null,"https://business.google.com/local/business/3883731542078944564/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4U21OSFZtRmxWbXN5VVZoQ2FtRXpiRlppVlc5MFZqSjRVazR5WXhBQhAA",[null,null,null,"/local/business/3883731542078944564/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4U21OSFZtRmxWbXN5VVZoQ2FtRXpiRlppVlc5MFZqSjRVazR5WXhBQhAA"],null,["zh-Han