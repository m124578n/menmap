"吵雜程度",null,"0ahUKEwjbqPCZwtKWAxXsVPUHHa31LAoQ3IcHCIYBKBU",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjbqPCZwtKWAxXsVPUHHa31LAoQ3YcHCIkBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjbqPCZwtKWAxXsVPUHHa31LAoQ3IcHCIgBKBY",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["位於馬階醫院對面，民生西路上的雞湯桑，是台北超夯火鍋品牌＜雞湯大叔＞跨足拉麵市場，推出全新拉麵品牌，有別於傳統日式拉麵那種湯底重油重鹹的口味，雞湯桑提供風味濃郁，卻又保持清爽不膩口的新體驗！\n店內裝潢風格與色調很別緻舒服，增加食慾。\n雞湯桑的餐點品項挺豐富多樣化，不論是麵控還是飯控都不用擔心，此外，還有兒童餐可供選擇，主餐外可再加點招牌燒鳥品項也不少喔。\n玄米茶與餐前開胃柚子冰沙都不馬虎，今日選擇＜東京雞白湯＞，湯頭濃郁不過膩，麵條口感又嚼勁，挺棒的，兩種雞肉各有特色，烤的香味不錯，肉質都是鮮嫩好吃，餐後冰淇淋不會過甜，搭配得挺好的。\n雞湯桑加入會員後的優惠挺大方的，很推。\n各分店也有推出不同的特色餐點，可以看店內廣告螢幕。",null,[0,116]]]],[null,null,null,null,null,"https://business.google.com/local/business/9295025532956345940/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZEdKV1NqVmtNMnhhWWpCd1VVNHhiSGxQUmxKd1QwVk9hbFpZWXhBQhAA",[null,null,null,"/local/business/9295025532956345940/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZEdKV1NqVmtNMnhhWWpCd1VVNHhiSGxQUmxKd1QwVk9hbFpZWXhBQhAA"],"https://business.google.com/local/business/9295025532956345940/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZEdKV1NqVmtNMnhhWWpCd1VVNHhiSGxQUmxKd1QwVk9hbFpZWXhBQhAA",[null,null,null,"/local/business/9295025532956345940/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZEdKV1NqVmtNMnhhWWpCd1VVNHhiSGxQUmxKd1QwVk9hbFpZWXhBQhAA"],null,"https://business.google.com/local/business/9295025532956345940/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZEdKV1NqVmtNMnhhWWpCd1VVNHhiSGxQUmxKd1QwVk9hbFpZWXhBQhAA",[null,null,null,"/local/business/9295025532956345940/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZEdKV1NqVmtNMnhhWWpCd1VVNHhiSGxQUmxKd1QwVk9hbFpZWXhBQhAA"]],[null,null,17992,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUN