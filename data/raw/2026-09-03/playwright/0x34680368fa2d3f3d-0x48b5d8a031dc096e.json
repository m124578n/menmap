,"晚餐",2,null,null,"0ahUKEwjT0OeVx9KWAxVLe_UHHdkSMqMQ3YcHCIEBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjT0OeVx9KWAxVLe_UHHdkSMqMQ3IcHCIABKA8",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjT0OeVx9KWAxVLe_UHHdkSMqMQ3YcHCIMBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjT0OeVx9KWAxVLe_UHHdkSMqMQ3IcHCIIBKBA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjT0OeVx9KWAxVLe_UHHdkSMqMQ3IcHCIQBKBE",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjT0OeVx9KWAxVLe_UHHdkSMqMQ3IcHCIUBKBI",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjT0OeVx9KWAxVLe_UHHdkSMqMQ3IcHCIYBKBM",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["2025/2/4 點餐順序：先於點餐機前排隊點餐，店家很佛心，可以免費加麵，機器上顯示最多可以加到兩坨麵，對於大食量的人來說，真的是福音，目前機器只有收現金，但機器不是很好按。拉麵只有兩種選擇：$135 醬油豚骨還有$145 麻辣豚骨，湯頭的部分建議選淡，湯頭不會過於濃稠，醬油豚骨沒有醬油的死鹹，應該只是用來調味，搭配筍乾、溫泉蛋、還有大推薦的炙燒叉燒，筍乾不會過鹹，微甜很解膩，溫泉蛋正常發揮，炙燒叉燒後，肉更香，而且肉質很柔軟，桌邊還有辣油跟蒜泥可以添加，推薦加一點蒜泥，直接把醬油豚骨的湯頭提上另一種風味，麻辣豚骨的部分，就是偏花椒麻味，不會過辣，味道其實跟桌上的辣油蠻像，麵條的部分，應該是曲麵，選擇正常硬度，也不會太硬，吃的時候可以直接巴上醬汁，店內位置不多，還有附贈綠豆湯供自取。\n2025/3/4 二訪，這次麵條嘗試軟，跟正常麵條硬度差一點，但正常硬度的麵條，保有Q度較有口感，湯頭選正常，搭配曲麵，吃到後面口味偏鹹。還是推薦，湯頭淡，麵條正常。\n2025/6/23 三訪，叉燒不要太早泡到湯裡面，才能保有叉燒炙燒香氣，還是推薦：湯頭淡，但麵條下次想嘗試再硬一點。\n2026/04/23 點了蔥多，結果蔥爆炸多，但相對湯也變少了。",null,[0,112]]]],[null,null,null,null,null,"https://business.google.com/local/business/17719046827084503600/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmZiM0pNTURGQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/17719046827084503600/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmZiM0pNTURGQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/17719046827084503600/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmZiM0pNTURGQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/177190468270