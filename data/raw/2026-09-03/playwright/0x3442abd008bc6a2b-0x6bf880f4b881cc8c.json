2sCIABIhD_9fL1x5B3AFlocYPXM0AA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x6bf880f4b881cc8c"]],1,null,null,null,null,null,null,["0","7780110144838421644"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25abVNVbGxibnBGUlhjd1ltSkdRemxUZW1sNWJFRRAB"]],"CIABIhD_9fL1x5B3AFlocYPXM0AA",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwiQk4qLvNKWAxXBgK8BHVBfFjUQ3YcHCGcoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiQk4qLvNKWAxXBgK8BHVBfFjUQ3IcHCGYoCg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwiQk4qLvNKWAxXBgK8BHVBfFjUQ3YcHCGkoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiQk4qLvNKWAxXBgK8BHVBfFjUQ3IcHCGgoCw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiQk4qLvNKWAxXBgK8BHVBfFjUQ3IcHCGooDA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiQk4qLvNKWAxXBgK8BHVBfFjUQ3IcHCGsoDQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiQk4qLvNKWAxXBgK8BHVBfFjUQ3IcHCGwoDg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["「油拌麵」是一種採乾拌吃法的拉麵，較後期進入台灣日式拉麵市場，對多數台灣人來說還是蠻新奇的。自己近年已不常吃日式拉麵，或許是覺得各店配菜千篇一律，但這間主打「油拌麵」的拉麵店提供的菜色有些不一樣，能吸引喜歡求新求變的顧客。\n\n平日下午入店，顧客加我才3人，店裡氣氛蠻悠閒的，只有一位廚師在兼顧內、外場；這回遇見的廚師感覺是不苟言笑，其實對日本拉麵店的廚師來說「服務並非他們的本務」，所以最好別太要求親切，基本互動即可。\n\n這一訪點的菜色較有多樣性。\n辣味噌拉麵（並盛）－甫上桌時賣相含蓄，配置是醬汁隱藏在麵底下，自行拌勻。麵體比起一般湯式拉麵軟、口感Q彈，很適合乾式吃法！辣味噌不論色澤還是口味，都很難跟一般味噌聯結；辣度很到位、是種著重後勁的辣，而且辣味蘊含在醬裡、絕非額外添加的辣油辣粉，這辣味噌醬用料真是實在！另外我加點了佐料「柚子胡椒」，微辣帶酸很清爽，但少許添加即可。\n※並盛是日語「基本份量」之意。因為有點叉燒飯才選並盛，否則對我來說並盛是吃不飽的……\n\n月見叉燒飯，在拌有特製醬汁的叉燒飯上方，有顆可生食蛋黃，蛋汁的香濃滑順結合肉香、醬汁香，增添了味覺的豐富。儘管這吃法對我來說已不稀奇，但對我來說是萬年不敗的組合。\n祕製辛皮蛋（一品料理組合）和整份香菜，是我佐餐用的小菜，意外發現是近年爆紅組合，其中一整份香菜尤其令愛好者趨之若鶩！這兩樣小菜搭配飯、麵一起享用，真是絕佳享受～最後，抹茶冰淇淋吃起來就還可以，純粹視為點心即可。\n\n這回已是二訪，就是為了評論而來。其實《東京油組》在此展店已久，但人氣始終不減；在同性質餐廳裡餐點變化性高，但屬中高價位（可能地段因素），適合偶而來吃，但有吃過的話是真的令人很想回訪呢～～",null,[0,111]]]],[null,null,null,null,null,"https://business.google.com/local/business/6866629666675535714/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYlZOVmJHeGlibkJHVWxoamQxbHRTa2RSZW14VVpXMXNOV0pGUlJBQhAA",[null,null,null,"/local/business/6866629666675535714/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYlZOVmJHeGlibkJHVWxoamQxbHRTa2RSZW14VVpXMXNOV0pGUlJBQhAA"],"https://business.google.com/local/business/6866629666675535714/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYlZOVmJHeGlibkJHVWxoamQxbHRTa2RSZW14VVpXMXNOV0pGUlJBQhAA",[null,null,null,"/local/business/6866629666675535714/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYlZOVmJHeGlibkJHVWxoamQxbHRTa2RSZW14VVpXMXNOV0pGUlJBQhAA"],null,"https://business.google.com/local/business/6866629666675535714/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYlZOVmJHeGlibkJHVWxoamQxbHRTa2RSZW14VVpXMXNOV0pGUlJBQhAA",[null,null,null,"/local/business/6866629666675535714/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYlZOVmJHeGlibkJHVWxoamQxbHRTa2RSZW14VVpXMXNOV0pGUlJBQhAA"]],[null,null,7365,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25abVNVbGxibnBGUlhjd1ltSkdRemxUZW1sNWJFRRAB!2m1!1s0x0:0x6bf880f4b881cc8c!3m1!1s2@1:CAIQACodChtycF9oOnZmSUllbnpFRXcwYmJGQzlTeml5bEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25abVNVbGxibnBGUlhjd1ltSkdRemxUZW1sNWJFRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25abVNVbGxibnBGUlhjd1ltSkdRemxUZW1sNWJFRRI-Ci9DQUlRQUNvZENodHljRjlvT25abVNVbGxibnBGUlhjd1ltSkdRemxUZW1sNWJFRRILMGRpWXctNFBxbTAaPgovQ0FJUUFDb2RDaHR5Y0Y5b09uWm1TVWxsYm5wRlJYY3dZbUpHUXpsVGVtbDViRUUSCzBkaVl3LTRQcW0wIhIJAAAAAAAAAAARjMyBuPSA-GsqCzBkaVl3LTRQcW0w\u0026wv\u003d1\u0026d\u003d286732