,null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3YcHCMABKAA"]]],null,null,null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3IcHCL8BKAw",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["這間拉麵店藏在市場裡，已經營業很多年，是我反覆回訪的老店，也承載了不少回憶。環境或許樸實，但味道始終穩定，這點最難得。拉麵湯頭濃郁順口，不會過鹹，麵條口感彈牙，內用加麵的份量吃完也很有飽足感。\n\n除了拉麵，關東煮也值得一提，食材入味不死鹹，搭配店家提供的醬料與芥末特別提味，讓整體層次更鮮明。多年來水準維持得很好，沒有因時間而走樣。對我來說，這不只是市場裡的一碗拉麵，而是一間會讓人想持續支持、偶爾就想回來吃一碗的店。",null,[0,96]]]],[null,null,null,null,null,"https://business.google.com/local/business/14324259327917661378/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXZDFwV1NuWlZSVzk2WlZSc2FGcFlVa1pTU0doNFZFZFpOVlJ0WXhBQhAA",[null,null,null,"/local/business/14324259327917661378/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXZDFwV1NuWlZSVzk2WlZSc2FGcFlVa1pTU0doNFZFZFpOVlJ0WXhBQhAA"],"https://business.google.com/local/business/14324259327917661378/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXZDFwV1NuWlZSVzk2WlZSc2FGcFlVa1pTU0doNFZFZFpOVlJ0WXhBQhAA",[null,null,null,"/local/business/14324259327917661378/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXZDFwV1NuWlZSVzk2WlZSc2FGcFlVa1pTU0doNFZFZFpOVlJ0WXhBQhAA"],null,"https://business.google.com/local/business/14324259327917661378/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXZDFwV1NuWlZSVzk2WlZSc2FGcFlVa1pTU0doNFZFZFpOVlJ0WXhBQhAA",[null,null,null,"/local/business/14324259327917661378/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXZDFwV1NuWlZSVzk2WlZSc2FGcFlVa1pTU0doNFZFZFpOVlJ0WXhBQhAA"]],[null,null,4373,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tWd1pWSnZVRW96ZVRsaFpYUkZSSGh4VEdZNVRtYxAB!2m1!1s0x0:0xda55827bc208b58f!3m1!1s2@1:CAIQACodChtycF9oOkVwZVJvUEozeTlhZXRFRHhxTGY5Tmc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2tWd1pWSnZVRW96ZVRsaFpYUkZSSGh4VEdZNVRtY