ull,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3IcHCHooBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3IcHCHsoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3IcHCHwoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3YcHCH4oAA"]],1],null,null,"吵雜程度",null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3IcHCH0oCg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3YcHCIABKAA"]]],null,"用餐人數",null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3IcHCH8oCw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3YcHCIIBKAA"]],1],null,null,"等待時間",null,"0ahUKEwil0ICkyNKWAxWaoK8BHV4TM7IQ3IcHCIEBKAw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["位於新莊四維路巷弄間的「赤麵廠」，以獨特的**屋台文化**在傳統市場周邊脫穎而出。這裡不只是拉麵店，更像是一處深夜心靈與味蕾的避風港，木質調的攤車設計在夜色中散發溫暖微光，營造出濃厚的日本街頭氛圍。\n### 味覺核心：博多豚骨與關東煮\n其靈魂在於**博多豚骨拉麵**。湯頭經長時間熬煮，質地濃郁卻不顯油膩，入喉後帶有淡淡奶香與膠質感，完美包裹著細硬麵體。叉燒經過炙燒處理，焦香與油脂交織出層次感。更具特色的是，店內同步販售高品質的**關東煮**，食材吸飽了清甜的高湯，沾上店家秘製的高湯沾醬，是拉麵之餘最完美的點綴。\n### 空間與體驗\n儘管空間不大，但赤麵廠巧妙運用吧檯位置，縮短了主廚與食客間的距離。在喧囂的新莊四維路中，這裡提供了一種**慢節奏的儀式感**。無論是想獨自享用一碗熱騰騰的麵，還是與友人在攤車旁小酌，這裡的性價比與服務溫度，都讓赤麵廠成為當地極具代表性的特色食肆。\n**店家亮點：** 營業至深夜，是新莊人心中不折不扣的靈魂宵夜首選。",null,[0,117]]]],[null,null,null,null,null,"https://business.google.com/local/business/14324259327917661378/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzVldGR09USk9hekZ4VmxWYVJXTXpUbEpSYkZKeldERldZVTVWUlJBQhAA",[null,null,null,"/local/business/14324259327917661378/customers/r