["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3IcHCFYoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3IcHCFcoCA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_MODERATE"],"有點吵雜",2,null,null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3YcHCFkoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3IcHCFgoCQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3YcHCFsoAA"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3YcHCFwoAQ"]]],null,"用餐人數",null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3IcHCFooCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["點了黑蒜油石斑魚拉麵、卡布奇諾蝦湯拉麵跟炸餃子\n\n黑蒜油石斑魚拉麵像是濃郁版的魚湯，蒜香很順口提味，鹹度適中，石斑魚肉軟嫩，細麵吸附滿滿湯汁，上桌的湯量只有大概六分滿，經跟老闆反應後補充了大半碗的魚湯，店家非常的有誠意，雖然是魚湯的清湯，但是還是飄著濃郁的魚香\n\n卡布奇諾蝦湯拉麵，濃厚的蝦味充斥每一口蝦湯，雖然喝多了偏膩口一點，但是因為老闆提供免費的加湯服務，蝦湯的湯頭也是另外提供的，充滿蝦香味的清湯，桌子的旁邊提供炸過的蒜酥，可以為膩口的蝦湯提供一個轉味的因素，麵條是使用比較有嚼勁的Q麵\n\n炸餃子本身正常不雷，但是搭配松露香味的沾醬，口味層次提升很多\n\n整體來說每一碗都各具特色，也都有凸顯出該呈現的味道，很不錯的拉麵餐廳",null,[0,23]]]],[null,null,null,null,null,"https://business.google.com/local/business/10772877134792138708/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFzVWxZeVZuTlhWVXBQWlZkT2IxRXhRVEJXV0dSSlZUSlJOR016WXhBQhAA",[null,null,null,"/local/business/10772877134792138708/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFzVWxZeVZuTlhWVXBQWlZkT2IxRXhRVEJXV0dSSlZUSlJOR016WXhBQhAA"],"https://business.google.com/local/business/10772877134792138708/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFzVWxZeVZuTlhWVXBQWlZkT2IxRXhRVEJXV0dSSlZUSlJOR016WXhBQhAA",[null,null,null,"/local/business/10772877134792138708/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVT