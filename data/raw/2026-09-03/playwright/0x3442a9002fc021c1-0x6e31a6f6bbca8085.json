ED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3IcHCNIBKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3IcHCNMBKAw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3IcHCNQBKA0",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11vyrtp47l"],"原味石斑魚白湯拉麵",2,null,null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3YcHCNYBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3IcHCNUBKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3YcHCNgBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3YcHCNkBKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3YcHCNoBKAI"]]],null,"用餐人數",null,"0ahUKEwi9jrGex9KWAxXMcfUHHc2EO3AQ3IcHCNcBKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["藏身小巷內的溫馨拉麵店，跟流行同步地在店門外使用了點餐機，品項的選擇不多，但有著比較不常見的石斑魚拉麵。她除了拉麵外，也有飯類，所以也點了一個蝦仁飯吃看看。\n店外裝飾著日式燈籠，很有氣氛；店內空間不很大，但裝潢挺有特色，掛著幾幅圓形的鯉魚圖，呼應著她的店名「麵屋有漁」。\n自助的涼水壺裡裝的是檸檬水，拉麵的麵可以選軟硬度，而且還可以加麵，誠意十足。蝦仁飯看似一般的歐姆蛋飯，但吃下去每一口都有濃濃的蝦味，很讚。",null,[0,205]]]],[null,null,null,null,null,"https://business.google.com/local/business/10772877134792138708/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXZFUxWFZtcGtWM1EyVFVkM2VtSXdOWEZOYkZaNVpHNUpkRlV5WXhBQhAA",[null,null,null,"/local/business/10772877134792138708/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXZFUxWFZtcGtWM1EyVFVkM2VtSXdOWEZOYkZaNVpHNUpkRlV5WXhBQhAA"],"https://business.google.com/local/business/10772877134792138708/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXZFUxWFZtcGtWM1EyVFVkM2VtSXdOWEZOYkZaNVpHNUp