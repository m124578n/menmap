],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjTvL_Nw9KWAxUsQ_UHHSDXNq4Q3IcHCHwoBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjTvL_Nw9KWAxUsQ_UHHSDXNq4Q3IcHCH0oBg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["開幕許久～終於有機會來踩點\n我點的是松露雞白湯拉麵\n另外和朋友share燒燒飯（限內用）\n以整體湯頭來說，算濃郁好喝\n但可能我吃過別家，加松露的湯頭更明顯\n所以這次點的，就相對有比較值\n打算下次吃其他口味試試\n\n燒燒飯帶有一點炙燒味的清香\n會在整個口腔中充溢這個香味\n蠻有特色的\n但女生吃，拉麵以外再多碗飯\n真的是會太飽\n有朋友同行，有想嚐鮮的人\n可以共同點一碗品嚐",null,[0,44]]]],[null,null,null,null,null,"https://business.google.com/local/business/17677782501837217589/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZwclJsTlpiV3hoVVZjMVdHSnRNV3hQVlRsU1ZteGpORmt3UlJBQhAA",[null,null,null,"/local/business/17677782501837217589/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZwclJsTlpiV3hoVVZjMVdHSnRNV3hQVlRsU1ZteGpORmt3UlJBQhAA"],"https://business.google.com/local/business/17677782501837217589/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZwclJsTlpiV3hoVVZjMVdHSnRNV3hQVlRsU1ZteGpORmt3UlJBQhAA",[null,null,null,"/local/business/17677782501837217589/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZwclJsTlpiV3hoVVZjMVdHSnRNV3hQVlRsU1ZteGpORmt3UlJBQhAA"],null,"https://business.google.com/local/business/17677782501837217589/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZwclJsTlpiV3hoVVZjMVdHSnRNV3hQVlRsU1ZteGpORmt3UlJBQhAA",[null,null,null,"/local/business/17677782501837217589/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZwclJsTlpiV3hoVVZjMVdHSnRNV3hQVlRsU1ZteGpORmt3UlJBQhAA"]],[null,null,1498,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT204eVprRlNZbWxhUVc1WGJtMWxPVTlSVmxjNFkwRRAB!2m1!1s0x0:0x41e96e9c05d7b272!3m1!1s2@1:CAIQACodChtycF9oOm8yZkFSYmlaQW5Xbm1lOU9RVlc4Y0E%7C%7C?hl\