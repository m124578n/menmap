1615300434407893966"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,4,5,15,null,null,null,null,["4 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhBybhzd5SgrIKCB40qROMgp\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x244dec8cfe4a5790"]],1,null,null,null,null,null,null,["0","2616007048877987728"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25FNU0xUlJhblp0VFhSRU5tVnNZa1JPTFdSME9WRRAB"]],"CIABIhBybhzd5SgrIKCB40qROMgp",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjspPipwNKWAxX7YPUHHU_EAWUQ3IcHCFwoCA",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["蕃茄拉麵\n拉麵麵條口感有彈性，湯底清甜，配料種類豐富。其實更像蔬菜湯麵。馬鈴薯不算過爛，還沒有化進湯裡。蕃茄口味適中，不過酸。肉片有一定厚度，吃起來有嚼勁。品質還算不錯，不過我個人還是偏愛湯頭濃郁的拉麵。\n\n花干\n走的不是加熱滷味方式，所以口感偏硬了些。雖然花干內含的滷汁不多，但滷的很入味。搭配的醬油普通，就是一般的鹹醬油，吃起來不差。\n\n地瓜葉\n莖沒有過老的問題，老闆有用心在撿。醬油是油蔥醬，不是肉燥，吃起來還算普通。",null,[0,102]]]],[null,1776750188000000,1776750188000000,"4 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfV19MZXNtRHJYbmtVdW9aS2U3R2JMQQ%7CCAEQrcz1_gkiLwoZQ0hfV19MZXNtRHJYbmtVdW9aS2U3R2JMQRoSQ2dzSTdKeWN6d1lRbHVtUkln\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjspPipwNKWAxX7YPUHHU_EAWUQ_2MIXSgJ"],"https://business.google.com/local/business/13614283292183389820/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVGTlUweFVsSmhibHAwVkZoU1JVNXRWbk5aYTFKUFRGZFNNRTlXUlJBQhAA",[null,null,null,"/local/business/13614283292183389820/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVGTlUweFVsSmhibHAwVkZoU1JVNXRWbk5aYTFKUFRGZFNNRTlXUlJBQhAA"],"https://business.google.com/local/business/13614283292183389820/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVGTlUweFVsSmhibHAwVkZoU1JVNXRWbk5aYTFKUFRGZFNNRTlXUlJBQhAA",[null,null,null,"/local/business/136142832921