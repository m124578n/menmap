[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjFj9Xqu9KWAxXzia8BHUCdO5IQ3YcHCKEBKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwjFj9Xqu9KWAxXzia8BHUCdO5IQ3YcHCKIBKAI"],[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwjFj9Xqu9KWAxXzia8BHUCdO5IQ3YcHCKMBKAM"]]],null,"用餐人數",null,"0ahUKEwjFj9Xqu9KWAxXzia8BHUCdO5IQ3IcHCJ8BKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjFj9Xqu9KWAxXzia8BHUCdO5IQ3YcHCKUBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjFj9Xqu9KWAxXzia8BHUCdO5IQ3IcHCKQBKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["存超久的日式沾麵店，店內空間剛好但座位都有點擁擠，有提供冰水及常溫水可以自由取用，飯後結帳僅能現金付款，店員很熱情。\n\n這是我第一次吃沾麵，整體來說很新奇也覺得還不錯。\n\n🥢濃厚豚骨蝦沾麵（中）超值豪華版：升級為超值豪華版才有溏心蛋跟自製叉燒，麵本身偏粗偏硬很有嚼勁，筍子很脆很好吃，叉燒也蠻大片的（一共三片），其他料就基本水準，然後沾麵的醬汁超級超級蝦味，裡面還有幾塊肉，只是有幾塊全是肥肉吃起來會很油膩，醬汁很香但也很鹹，吃完麵後還可以加高湯變成湯，但湯我個人是沒有很喜歡，沾麵本身還不錯，吃完蠻飽的，但覺得有點偏鹹。",null,[0,84]]]],[null,null,null,null,null,"https://business.google.com/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTTkdScWJGWldlbEkwVjBST1FsUXpaRXhWTVZwVlZXeEthbEV3UlJBQhAA",[null,null,null,"/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTTkdScWJGWldlbEkwVjBST1FsUXpaRXhWTVZwVlZXeEthbEV3UlJBQhAA"],"https://business.google.com/local/business/12138693963750328653/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTTkdScWJGWldlbEkwVjBST1FsUXpaRXhWTVZwVlZXeEthbEV3UlJBQhAA",[null,null,null,"/local/business/12138693963750328653/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTTkdScWJGWldlbEkwVjBST1FsUXpaRXhWTVZwVlZXeEthbEV3UlJBQhAA"],null,"https://business.google.com/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTTkdScWJGWldlbEkwVjBST1FsUXpaRXhWTVZwVlZXeEthbEV3UlJBQhAA",[null