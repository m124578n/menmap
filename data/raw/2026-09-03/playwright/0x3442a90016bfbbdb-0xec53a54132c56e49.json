",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ3YcHCGcoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ3IcHCGYoCg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ3YcHCGkoAA"]],1],null,null,"等待時間",null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ3IcHCGgoCw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["今天來吃茶悟拉麵🍜一上桌就被整體的擺盤吸引，木質托盤、茶壺、小點心，每個細節都很有質感。\n\n拉麵的湯頭清澈卻很有深度，喝起來溫潤順口，不是重鹹的那種，而是越喝越舒服的味道。麵條Q彈，叉燒粉嫩又軟嫩，搭配玉米和青菜，味道清爽又平衡。\n\n最喜歡的是整體用餐的氛圍，牆上的書法搭配簡約風格，讓人有種靜靜吃一碗麵的療癒感。最後再配上小甜點和熱茶，整個用餐過程很完整。強推五星滿分，必吃推薦！❤️\n是一家會想再回訪的拉麵店✨",null,[0,115]]]],[null,null,null,null,null,"https://business.google.com/local/business/8830331577529642338/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhU0ZWck9EVmlNV2hTV2xSYVYxTXdPVVZpUmxVMFkyNUpNMk5YWXhBQhAA",[null,null,null,"/local/business/8830331577529642338/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhU0ZWck9EVmlNV2hTV2xSYVYxTXdPVVZpUmxVMFkyNUpNMk5YWXhBQhAA"],"https://business.google.com/local/business/8830331577529642338/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhU0ZWck9EVmlNV2hTV2xSYVYxTXdPVVZpUmxVMFkyNUpNMk5YWXhBQhAA",[null,null,null,"/local/business/8830331577529642338/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhU0ZWck9EVmlNV2hTV2xSYVYxTXdPVVZpUmxVMFkyNUpNMk5YWXhBQhAA"],null,"https://business.google.com/local/business/8830331577529642338/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhU0ZWck9EVmlNV2hTV2xSYVYxTXdPVVZpUmxVMFkyNUpNMk5YWXhBQhAA",[null,null,null,"/local/business/8830331577529642338/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhU0ZWck9EVmlNV2hTV2xSYVYxTXdPVVZpUmxVMFkyNUpNMk5YWXhBQhAA"]],[null,null,5922,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQ