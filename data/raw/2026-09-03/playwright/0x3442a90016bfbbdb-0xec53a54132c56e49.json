JZItIQ3IcHCLgBKAQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ3YcHCLsBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ3IcHCLoBKAU",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ3IcHCLwBKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ3IcHCL0BKAc",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ3IcHCL4BKAg",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["昨天傍晚 5點多來這吃了拉麵，湯頭與麵條確實非常美味、符合水準。然而，餛飩內餡居然完全沒有熟，我已經吞下一顆，友人咬一口就發現不對勁，我也撥開另一顆發現真的沒熟，當下有立即向店員反應，但店員連道歉都沒有僅更換了兩顆餛飩，並未做進一步的食安確認或關切，換來的兩顆撥開後看起來跟剛剛那兩顆不一樣，所以確定我已經吃下一顆生餛飩😭 我有陰影後來補的餛飩我也不敢吃給我朋友吃….\n\n結果現在半夜3點多開始出現嚴重的急性腸胃炎反應，持續拉肚子並伴隨強烈嘔吐感。雖然餐點很好吃，但未熟肉品帶有嚴重的細菌風險，希望店家能痛定思痛，嚴格重新檢視內餡的烹煮時間與出餐流程，不希望再有下一位顧客因此受害。 未熟透的餛飩極易帶有沙門氏菌與空腸彎曲菌，肉品沒煮熟出餐就是嚴重的食安疏失🥲明天還要上班現在都半夜四點多了🥲",null,[0,184]]]],[null,null,null,null,null,"https://business.google.com/local/business/8830331577529642338/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVTJORk5ESmtiVVpTVjFac1lWb3hhRXBqYmtWNlYyeFdaazFHUlJBQhAA",[null,null,null,"/local/business/8830331577529642338/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVTJORk5ESmtiVVpTVjFac1lWb3hhRXBqYmtWNlYyeFdaazFHUlJBQhAA"],"https://business.google.com/local/business/8830331577529642338/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVTJORk5ESmtiVVpTVjFac1lWb3hhRXBqYmtWNlYyeFdaazFHUlJBQhAA",[null,null,null,"/local/business/8830331577529642338/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTVTJORk5ESmtiVVpTVjFac1lWb3hhRXBqYmtWNlYyeFdaazFHUlJBQhAA"],null,"https://business.google.com/local/bus