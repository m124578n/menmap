ll,null,null,null,null,null,null,null,["zh-Hant"],[["很幸運的是沒有等候太久，大約15分鐘就入場了。\n食用焙茶口味拉麵，和伯爵泡系拉麵。\n使用細麵，麵本身幾乎沒有味道，也沒有吸附湯汁，和湯汁完全分開，建議麵體應該要有點味道，例如加鹽巴煮麵，或是選可以吸附湯汁的麵體，不然吃起來麵是麵，湯是湯，完全沒關。\n焙茶湯頭蠻有趣的，真的很像在喝鹹鹹的焙茶，伯爵泡系湯頭稍淡，有伯爵茶的味道。\n佐料部分都很好吃，烤過的厚豬肉是裡面唯一比較重口味的，很好吃。\n炸蝦還蠻好吃的，建議炸蝦一上來就先吃，不然麵衣很快會軟掉。",null,[0,41]]]],[null,null,null,null,null,"https://business.google.com/local/business/8830331577529642338/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpOa3hpVG14QlJSQUIQAQ%3D%3D",[null,null,null,"/local/business/8830331577529642338/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpOa3hpVG14QlJSQUIQAQ%3D%3D"],"https://business.google.com/local/business/8830331577529642338/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpOa3hpVG14QlJSQUIQAQ%3D%3D",[null,null,null,"/local/business/8830331577529642338/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpOa3hpVG14QlJSQUIQAQ%3D%3D"],null,"https://business.google.com/local/business/8830331577529642338/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpOa3hpVG14QlJSQUIQAQ%3D%3D",[null,null,null,"/local/business/8830331577529642338/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpOa3hpVG14QlJSQUIQAQ%3D%3D"]],[null,null,null,["https://www.google.com/maps/@/data\u003d!4m7!23m6!1m5!1sChdDSUhNMG9nS0VJQ0FnSUMzNkxiTmxBRRAB!2m1!1s0x0:0xec53a54132c56e49!3m1!1s2@1:CIHM0ogKEICAgIC36LbNlAE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUMzNkxiTmxBRRAB\u0026t\u003d3\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUMzNkxiTmxBRRItChZDSUhNMG9nS0VJQ0FnSUMzNkxiTlZBEhNDZ3dJNHFxWXVRWVFpSW5uMkFJIhIJAAAAAAAAAAARSW7FMkGlU-wqCzBiOFdLWGY1Ukg3\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQoykI8QEoBQ"],null,[null,[[1,0]]]],"0ahUKEwjgwLGeu9KWAxXDgNYIHWOWJG0Q0pMFCKMBKAg"],null,null,null,"0ahUKEwjMiqqeu9KWAxVxg68BHbJZItIQ0pMFCOcBKAA"],[["ChZDSUhNMG9nS0VJQ0FnSUNueWFPeFd3EAE",["0x0:0x