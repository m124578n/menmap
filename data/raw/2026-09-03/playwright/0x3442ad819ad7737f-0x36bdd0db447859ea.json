l,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSURtNDVlNkxREAE"]],"CIHM0ogKEICAgIDm45e6nQE",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwiLouu6wtKWAxVvdPUHHZsLJegQ3YcHCMsBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwiLouu6wtKWAxVvdPUHHZsLJegQ3IcHCMoBKAQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiLouu6wtKWAxVvdPUHHZsLJegQ3YcHCM0BKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiLouu6wtKWAxVvdPUHHZsLJegQ3IcHCMwBKAU",null,null,null,null,null,1,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["應該是金湖路上cp值最高的餐廳了吧！\n今天點了1.蒜味拉麵、2.豚骨拉麵、3.炸豬排、4.可樂餅、5.薯條、6.叉燒飯\n\n整體來說就是cp值高、吃得飽！\n1.拉麵：湯頭偏淡沒什麼味道，是很台式的拉麵。會一直有在美食街吃拉麵的錯覺（以前美麗華樓下那家。\n2.炸物：（1）可樂餅是現成炸的不是手捏有點可惜、口味是咖喱口味。\n（2）薯條：中規中矩的薯條，不會過油有瀝乾，不錯。\n（3）豬排✨本次最推薦的餐點✨\n炸得恰到好處，份量也很不錯。每一口都有汁，到最後有點涼了也很好吃！只要90元而已！\n3.叉燒飯：這一碗單點絕對不會飽，但是配上一碗拉麵，份量十分剛好。\n上面應該是加了日式美乃滋醬所以吃起來是酸酸的，配上叉燒看白飯後，中和了叉燒的膩感。我覺得有畫龍點睛的效果，真的很好吃。\n肉量佔了碗一半的高度，店家沒在手軟的。\n\n總分為四顆星是因為\n在這個地段能這樣的價格實在實惠，店內環境氣氛給人寧靜、簡約的日式氛圍。上菜速度也蠻快的。\n扣一顆星原因：\n整體上來說住這附近的居民都是經濟上蠻ok的，如果再鑽研一下拉麵的湯頭以及其他費用單點食物的做法，個人覺得一碗麵300也沒問題（在這個地段），前提是要夠好吃。\n建議：\n1.可樂餅可以試試看手作。因為是手作2個80元也可以，這邊的居民一定買單。內科那邊許多日式小店家可樂餅會用手做的，麵衣用吐司烤過後打碎很好吃（以前在那邊打工過）。\n2.薯條可以再精緻一些，例如上面撒海苔粉，醬可以給蛋黃醬、番茄雙拼。（我相信這個品項是很賺錢的，但再加一個醬、海苔粉的成本可以精緻許多）\n3.豬排醬或許可以加白芝麻粉更有日式感或是學杏子豬排給塔塔醬加檸檬片，絕對升級還可以賣更高價格。\n\n以上 謝謝店家提供美好的一餐 感恩",null,[0,59]]]],[null,1644382177000000,1644382177000000,"4 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQ3NsYlQ5d0F3NTFrVlh6UEFBMGx4UQ%7CCAEQrcz1_gkiLwoZQ0hfQ3NsYlQ5d0F3NTFrVlh6UEFBMGx4URoSQ2dzSTRZLU5rQVlRc01mSUNB\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiLouu6wtKWAxVvdPUHHZsLJegQ_2MIzgEoBg"],"https://business.google.com/local/business/14189880072314631662/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUnRORFZsTmt4UkVBRRAA",[null,null,null,"/local/business/14189880072314631662/customers/reviews/reply?p\u003dCiNDaFpEU1