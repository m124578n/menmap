ll,[2160,2160]],null,[[3,121.59705752100584,25.082202428853115],[0,90],[2160,2160],75],"bnaZaouzC-_o1e8Pm5eUwQ4","0ahUKEwiLouu6wtKWAxVvdPUHHZsLJegQzCcIjAEoAw",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDK4svIyAE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x36bdd0db447859ea",null,null,"0ahUKEwiLouu6wtKWAxVvdPUHHZsLJegQ-y4IjQEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIDK4svIyAE"],[10,3,[2160,2160]],[null,null,null,null,null,["唐揚雞"],null,["竜亭食事処 龍亭拉麵 （金湖店）"]],[null,[[["Charles"],"https://www.google.com/maps/contrib/113250246979892731747?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVrySnpnDmTQNB3PeMSRWTJNAlek_GT6aZX2g9UTYbBI2O0hjYJ\u003ds120-c-rp-mo-ba12-br100",null,null,"113250246979892731747"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2021,5,5,17,null,null,null,null,["5 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDK4svIyAE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x36bdd0db447859ea"]],1,null,null,null,null,null,null,["0","3944538488811575786"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSURLNHN2SWNBEAE"]],"CIHM0ogKEICAgIDK4svIyAE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["三星以上🉑️\n\n店很新也很乾淨，裝潢感覺也很俐落，剛好想吃拉麵也就心血來潮的試試看了。整體來說是不錯吃的，點了豚骨跟味增拉麵各一，麵口感蠻好，也可調整硬度；湯頭也不錯但就可惜個人更喜歡濃郁的路線，如果相對喜歡台式風味拉麵的話，相信這家應該是可以讓人滿足的；叉燒真的覺得有點可惜，如果可以再軟嫩一點就更好了。\n\n另外也試了唐揚雞，也是在水準之上的不錯吃。下次如果有機會要來試試大家推薦的地獄拉麵，畢竟這家還是算蠻親民的，住附近覺得能走路來吃拉麵還是不錯的🙆🏻\u200d♂️",null,[0,6]]]],[null,null,null,null,null,"https://business.google.com/local/business/14189880072314631662/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkxOSE4yU1dOQkVBRRAA",[null,null,null,"/local/business/14189880072314631662/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkxOSE4yU1dOQkVBRRAA"],"https://business.google.com/local