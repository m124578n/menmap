lsRRAB"]],"CIABIhC1wsPPLyDQfYjCP8qurvqI",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwij_fugytKWAxV6a_UHHc9tL8EQ3YcHCFUoAA"]],1],null,null,"餐點類型",null,"0ahUKEwij_fugytKWAxV6a_UHHc9tL8EQ3IcHCFQoBQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwij_fugytKWAxV6a_UHHc9tL8EQ3YcHCFcoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwij_fugytKWAxV6a_UHHc9tL8EQ3IcHCFYoBg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwij_fugytKWAxV6a_UHHc9tL8EQ3IcHCFgoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwij_fugytKWAxV6a_UHHc9tL8EQ3IcHCFkoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwij_fugytKWAxV6a_UHHc9tL8EQ3IcHCFooCQ",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這家店看很久，今天第一次去，很多東西都覺得很稀奇，泡麵種類很多，也有很少看到的韓國泡麵，用紙錫碗要加錢，店家有韓國那個金色小鍋（不用加錢也環保）然後免費配料區很多料，也有蔬菜，裡面有冷氣，座位區當下去很乾淨，自助結帳機付錢方式很多種類，也有現金信用卡linepay ，可是現金紙鈔錢一直投不進去，後面來的人紙鈔也是投不進去，最後我跟後來來的客人都只能用信用卡結帳。（選泡麵有碰到店家小姐姐，人可愛又親切很主動幫忙我們）\n然後煮麵機，就算時間到你想再煮都可以按一個加30秒（不用費用）因為高麗菜不容易軟，我有多煮，最後吃完很神奇的是店家有廚餘機器，倒水槽那個廚餘機就會分解食物下去（好神奇）然後鍋子要自己洗乾淨（有洗碗精）\n整體來說我覺得這家店很棒，以後會再去。\n////老闆，謝謝您告知，那我下次可以用看看錫碗XD，我跟我妹都對這家店感受都很好",null,[0,209]]]],[null,1751220196000000,1751220196000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfelVsVGVmMzNHSU5yTWJIa1ppYWp3dw%7CCAEQrcz1_gkiMAoZQ0hfelVsVGVmMzNHSU5yTWJIa1ppYWp3dxoTQ2d3STVQLUZ3d1lRMTlydC13SQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwij_fugytKWAxV6a_UHHc9tL8EQ_2MIWygK"],"https://business.google.com/local/business/13087071705186712377/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTY0dKdVJrbGxWMHBPVEZaVk5FMVdhM2hqTTNCTlkwZHNVMWxzUlJBQhAA",[null,null,null,"/local/business/13087