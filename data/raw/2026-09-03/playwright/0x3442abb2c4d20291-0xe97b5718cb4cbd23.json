,25.02215159010171],[0,90],[4284,5712],75],"y3SZatM2hJS-vQ-CkP-YCw","0ahUKEwiTyPrywNKWAxUEiq8BHQLIH7MQzCcIfSgB",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhCqD_yYWRO9nHWLJfB4Zc3N\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xe97b5718cb4cbd23",null,null,"0ahUKEwiTyPrywNKWAxUEiq8BHQLIH7MQ-y4IfigA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhCqD_yYWRO9nHWLJfB4Zc3N"],[10,3,[5712,4284]],[null,null,null,null,null,null,null,["壹之穴沾麵專門店"]],[null,[[["廖建凱"],"https://www.google.com/maps/contrib/101106918090893659748?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjXp6ioBHt1D6oq5Q3-gmU4vsNuWHy_XqVhWBoAVNvRidp8mfRZ4bA\u003ds120-c-rp-mo-ba12-br100",null,null,"101106918090893659748"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,2,26,17,null,null,null,null,["6 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhCqD_yYWRO9nHWLJfB4Zc3N\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xe97b5718cb4cbd23"]],1,null,null,null,null,null,null,["0","-1622607476735296221"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pOTGVWQmhlR0k1TjJkd09UWTBaRTFxUW1kWGJtYxAB"]],"CIABIhCqD_yYWRO9nHWLJfB4Zc3N",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiTyPrywNKWAxUEiq8BHQLIH7MQ3IcHCH8oAg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiTyPrywNKWAxUEiq8BHQLIH7MQ3IcHCIABKAM",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiTyPrywNKWAxUEiq8BHQLIH7MQ3IcHCIEBKAQ",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["聽同學推薦來嚐鮮，味道尚可偏清爽\n豬叉燒處理的不錯，不過男生建議點大麵量。\n\n不過餐點異物處理的SOP還有可以更好的空間可以改善，首先我可以肯定店家對於客人手部消毒的重視，用餐環境與內場看起來都算整潔。\n\n即使如此2/26晚上用餐時仍發現餐點中有異物，目測是褐色長度約0.8公分的蟻型帶翅的活體昆蟲，從海葡萄竄出並鑽入蘿蔔絲內，發現當下我只是想讓店員確認是否真的有異物，希望他們可以確認一下其他食材是否也受到污染，店員也熱心的幫我更換一份餐點，因此我默認他們確實看到了那隻昆蟲。\n\n吃到一半另一位店員過來說，他們並沒有看到昆蟲並解釋可能是香料或胡椒的黑色顆粒。不確定此言是否是為了讓其他吧台區的客人安心，但我並不喜歡被質疑的感覺，明明是提出貴店可以改善的地方卻不被信任讓我整個用餐體驗都非常不好。\n\n這讓我意識到身為消費者，在反應任何意見前都需要拍照留存證據，以免與店家的溝通產生誤會。誠心建議貴店可以改善整體流程，並且在當下確認是否有異物與客人達成共識後再提出解決方案。\n\n我十分敬佩餐飲從業人員，即便出現頭髮或螞蟻等我其實都不在意，也不會給予低評價。但這次是出現活體的昆蟲，難免會讓人想到食材是否有受到污染，希望以後也能更注重這類食品安全問題。",null,[0,37]]]],[null,null,null,null,null,"https://business.google.com/local/business/11227828546023699830/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVEdWV1FtaGxSMGsxVGpKa2QwOVVXVEJhUlRGeFVXMWtXR0p0WXhBQhAA",[null,null,null,"/local/business/11227828546023699830/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVEdWV1FtaGxSMGsxVGpKa2QwOVVXVEJhUlRGeFVXMWtXR0p0WXhBQhAA"],"https://business.google.com/local/business/11227828546023699830/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVEdWV1FtaGxSMGsxVGpKa2QwOVVXVEJhUlRGeFVXMWtXR0p0WXhBQhAA",[null,null,null,"/local/business/11227828546023699830/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVEdWV1FtaGxSMGsxVGpKa2QwOVVXVEJhUlRGeFVXMWtXR0p0WXhBQhAA"],null,"https://business.google.com/local/business/11227828546023699830/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVEdWV1FtaGxSMGsxVGpKa2QwOVVXVEJhUlRGeFVXMWtXR0p0WXhBQhAA",[null,null,null,"/local/business/11227828546023699830/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVEdWV1FtaGxSMGsxVGpKa2QwOVVXVEJhUlRGeFVXMWtXR0p0WXhBQhAA"]],[null,null,8636,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pOTGVWQmhlR0k1TjJkd09UWTBaRTFxUW1kWGJtYxAB!2m1!1s0x0:0xe97b5718cb4cbd23!3m1!1s2@1:CAIQACodChtycF9oOjNLeVBheGI5N2dwOTY0ZE1qQmdXbmc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pOTGVWQmhlR0k1TjJkd09UWTBaRTFxUW1kWGJtYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT