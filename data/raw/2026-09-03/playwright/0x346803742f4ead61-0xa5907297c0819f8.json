hUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3IcHCK8BKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3IcHCLEBKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3IcHCLIBKAc",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3IcHCLMBKAg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_LOUD"],"吵雜，但還是能交談",2,null,null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3YcHCLUBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3IcHCLQBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3YcHCLcBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3YcHCLgBKAE"]]],null,"用餐人數",null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3IcHCLYBKAo",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3YcHCLoBKAA"]]],null,"座位類型",null,"0ahUKEwiuqrXQwNKWAxW8evUHHW8VBd4Q3IcHCLkBKAs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["一家隱身在夜市裡的拉麵店，門店不大，位子不多，但還算乾淨，老闆只有一個人，所以這是採半自助式的(吃完要自己回收餐盤)，我們點的是黑蒜口味跟松露口味，有豪華版跟一般，豪華版的肉跟菜有增量，店裡的麵是可以無限加的，口味適合台灣人吃，肉質很軟嫩沒有誇張的入口即化但也很鮮美，湯頭不會清淡到沒有味道，但也不是屬於重口味，唯一可能就是蔥多了點，糖心蛋也非常的好吃，我們還額外點了一個日式牛蒡絲，口味有點偏甜喜歡吃鹹鹹甜甜的人應該會蠻愛的!",null,[0,214]]]],[null,null,null,null,null,"https://business.google.com/local/business/12222328628757792999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLUkU5V2FGSlphMXBLWVVWR1UxUllZM2RUYTA1VFRWWnNVRk5zUlJBQhAA",[null,null,null,"/local/business/12222328628757792999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJ