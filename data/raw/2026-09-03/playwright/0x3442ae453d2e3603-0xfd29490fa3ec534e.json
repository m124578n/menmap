],null,null,"平均每人消費金額",null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3IcHCO4BKAc",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3IcHCPABKAg",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3IcHCPEBKAk",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3IcHCPIBKAo",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11fknb69zs"],"可樂餅",2,null,null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3YcHCPQBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3IcHCPMBKAs",null,null,null,null,null,3,null,2],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_MODERATE"],"有點吵雜",2,null,null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3YcHCPYBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3IcHCPUBKAw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3YcHCPgBKAA"]],1],null,null,"等待時間",null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3IcHCPcBKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["吃到有點生氣，第一次遇到管客人要怎麼吃的店家...我是平日去的當時有外國人同時間一起用餐，因當日下午還有其他安排，想說點味增叉燒拉麵跟溫泉蛋，外帶可樂餅速吃速解決\n\n拉麵上餐速度還可以，想說等溫泉蛋來一起吃，然後店家不知道發什麼神經，開始催拉麵趁熱吃唷，溫泉蛋沒這麼快，我想說第一次是好心提醒還蠻貼心，結果沒隔多久開始催你那個拉麵會冷掉唷，要不要先吃，我當下說沒關係我可以等，第二次又來說會冷掉芸芸，一直強調溫泉蛋沒這麼快，我點溫泉蛋就是想要配著吃，我也不在意麵冷不冷，因對方一直表示溫泉蛋沒這麼快，大約第二次告知時我詢問對方溫泉蛋大概還需要多久，他說三分鐘，結果十分鐘過後隔壁桌溫泉蛋先來了-_-\n這不是讓我最傻眼的，等麵都快吃完了後續問了好幾次蛋什麼時後好，才慢吞吞的把溫泉蛋上上來，實在有夠蝦，就這樣還好意思收服務費，也是蠻厲害的，然後一直跟我說溫泉蛋不是加在裡面的有另外調味，我就知道-_-想開發新吃法不行嗎，真的很莫名其妙\n\n會給兩顆星給的可樂餅，除了可樂餅好吃之外沒有其他優點了\n點可樂餅的時候口誤講成可麗餅，店家也超沒禮貌直接說沒賣可麗餅,反正給人感覺超不好,不會再來第二次，麵很普通我在其他地方同價位可以吃更好的服務,更好的氛圍,更好的食材\n因為看到說被山寨才來這家，可以一起黑名單了，鬼知道是不是行銷手法",null,[0,81]]]],[null,null,null,null,null,"https://business.google.com/