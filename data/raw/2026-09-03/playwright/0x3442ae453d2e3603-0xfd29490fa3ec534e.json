ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3IcHCL4BKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_LOUD"],"吵雜，但還是能交談",2,null,null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3YcHCMABKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwizmrncw9KWAxWIZ_UHHRvPF_MQ3IcHCL8BKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["很久沒來吃了，今天剛好到北投來健行，逛完地熱谷與北投溫泉博物館，第一個午餐選項就決定吃拉麵。\n不過，一開始跑到舊的店面，看到澄清公告，有點混亂，於是上樓準備用餐，但是感覺實在不對勁，不知道是老闆還是店員，沒有那種招待客人的熱情感...看了看陌生的菜單及評論後，立刻起身離開了店面，在樓下又仔細看了公告，才發現原來的店家真的搬家了...\n來到滿來新店跟正在準備工作的老闆聊了一下確認...嗯，這次沒有走錯了😂\n進店後看到熟悉的菜單，點了四碗拉麵、招牌炸豆腐、麻糬、溫泉蛋，叉燒很厚入口即化，湯頭好喝，拉麵Q彈，配菜是有點台式感但不衝突，還是這個懷念味道，不管是在半山腰的老店，或是北投公園旁的分店，再搬到現在的新店，依舊維持這份好滋味😋",null,[0,167]]]],[null,null,null,null,null,"https://business.google.com/local/business/8894208471700630640/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUkdFemJGbGlNREV6VDBSR00xUXlOVkZUUjNRMVdYcEtNbGx1WXhBQhAA",[null,null,null,"/local/business/8894208471700630640/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUkdFemJGbGlNREV6VDBSR00xUXlOVkZUUjNRMVdYcEtNbGx1WXhBQhAA"],"https://business.google.com/local/business/8894208471700630640/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUkdFemJGbGlNREV6VDBSR00xUXlOVkZUUjNRMVdYcEtNbGx1WXhBQhAA",[null,null,null,"/local/business/8894208471700630640/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUkdFemJGbGlNREV6VDBSR00xUXlOVkZUUjNRMVdYcEtNbGx1WXhBQhAA"],null,"https://business.google.com/local/business/8894208471700630640/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUkdFemJGbGlNREV6VDBSR00xUXlOVkZUUjNRMVdYcEtNbGx1WXhBQhAA",[null,null,null,"/local/business/8894208471700630640/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUkdFemJGbGlNREV6VDBSR00xUXlOVkZUUjNRMVdYcEtNbGx1WXhBQhAA"]],[null,null,2150,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHl