の味日式拉麵·"]],[null,[[["Young Egg (雞蛋)"],"https://www.google.com/maps/contrib/116794846773497696641?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVKZ1xyEJx-j_c-TbMCyRE16EtZweqEYMd5TNCoEjDbuFo9Cumu\u003ds120-c-rp-mo-ba12-br100",null,null,"116794846773497696641"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2021,11,14,19,null,null,null,null,["4 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDGgIPSlAE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x2f0b89510d06e64d"]],1,null,null,null,null,null,null,["0","3389954125730342477"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSURHZ0lQU0dBEAE"]],"CIHM0ogKEICAgIDGgIPSlAE",1],["CIHM0ogKEICAgIDGgIPSVA",["CIHM0ogKEICAgIDGgIPSVA",10,12,null,null,null,["https://lh3.googleusercontent.com/grass-cs/ACvplmNpAwjhNdafs_3kxpKhYdrxGP6n7lmRTkDbhWH3GPxcgJRq--Ha5Vjf9_VrQc_J9JHxGVG00IqxEu9GiS5zKqK-n5JezUxQ3ugj4qaAnhe069AK907sKOUrr4nS4x0p4tH_xqE\u003dk-no",null,[4032,2268]],null,[[3,121.46938000990696,24.988771526219452],[0,90],[4032,2268],75],"dYCZapuTB53s1e8Pio-O8A8","0ahUKEwjboeyCzNKWAxUddvUHHYqHA_4QzCcI9wEoEA",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDGgIPSVA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x2f0b89510d06e64d",null,null,"0ahUKEwjboeyCzNKWAxUddvUHHYqHA_4Q-y4I-AEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIDGgIPSVA"],[10,3,[2268,4032]],[null,null,null,null,null,null,null,["·家の味日式拉麵·"]],[null,[[["Young Egg (雞蛋)"],"https://www.google.com/maps/contrib/116794846773497696641?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVKZ1xyEJx-j_c-TbMCyRE16EtZweqEYMd5TNCoEjDbuFo9Cumu\u003ds120-c-rp-mo-ba12-br100",null,null,"116794846773497696641"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2021,11,14,19,null,null,null,null,["4 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDGgIPSVA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x2f0b89510d06e64d"]],1,null,null,null,null,null,null,["0","3389954125730342477"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSURHZ0lQU0dBEAE"]],"CIHM0ogKEICAgIDGgIPSVA",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["總而言之，會再訪，但不是拉麵吸引我再訪，單點部分才是會讓我想回訪的主因!\n\n回來這家吃，主要是因為老婆想吃拉麵，而Gomaji剛好有卷可以用，就來試試看~\n\n這次聽從老闆的建議點了推薦餐點\n\n博多豚骨湯-海苔豚骨\n北海道味噌-味噌豚骨\n濃厚香蒜豚骨-香蒜豚骨\n升級套餐(薯條+冬瓜茶)\n炸豆腐.唐揚炸雞.雪花燒餃子\n\n拉麵的部分，麵體偏硬，吃起來是有點台式拉麵的Fu ，雖然可以免費加麵，但我覺得不會特別想加(也可能是點兩碗麵的關係?)\n\n配料的部分，叉燒肉片一碗麵只有一片，個人覺得略少，但因為還蠻好吃的，所以特別紀錄一下\n\n湯頭的部分，個人覺得不推濃厚香蒜，豚骨和味噌還行，整體而言就是湯頭層次不夠明顯，讓整碗麵吃起來不算出色，但物有所值\n\n純粹想吃拉麵不挑食這家很不錯，但想吃日本味的拉麵就不會考慮這家\n\n薯條\n一般般，冷掉有點油膩，要趁熱吃。\n\n冬瓜茶\n能喝到冬瓜殘渣個人覺得很天然，濃郁好喝，有留下印象，也蠻加分的~\n\n雪花燒餃子\n內餡有韭菜，有點像是煎餃，但煎的外酥內嫩，咬下去還會噴汁，真的讓我相當驚訝，因為拉麵點能吃到這麼好吃的餃子真的不簡單，而且外觀很有特色，個人很愛這一味~\n\n唐揚炸雞\n基本上就是鮮嫩多汁，趁熱吃非常美味，打包回家，即使冷掉了，還是充滿炸雞的香味，個人覺得不會輸給其他拉麵名店太多，但人家名店通常一份賣100~150就是了...\n\n炸豆腐\n外酥內嫩，搭配醬油真的會讓人感到意猶未盡，個人覺得炸的很好，完全沒有油耗味或是奇怪的焦味，十分推薦!\n\n現場可以支援街口.LinePay.台灣Pay，基本上不用帶錢也能吃爽爽，外面機車停車格也很多，但開車可能就不太方便了。\n\n如果有機會，也許會再回訪試試其他品項的東西，像是丼飯之類的~",null,[0,77]]]],[null,1636935062000000,1636935062000000,"4 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQ3NsRGl5Y0JaamxrY0NsT0FBZ2tGdw%7CCAEQrcz1_gkiLwoZQ0hfQ3NsRGl5Y0JaamxrY0NsT0FBZ2tGdxoSQ2dzSWxzdkdqQVlRLU1mb1Rn\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjboeyCzNKWAxUddvUHHYqHA_4Q_2MI-QEoEQ"],"https://business.google.com/local/business/11231739645298955202/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkhaMGxRVTBkQkVBRRAA",[null,null,null,"/local/business/11231739645298955202/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkhaMGxRVTBkQkVBRRAA"],"https://business.google.com/local/business/11231739645298955202/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMF