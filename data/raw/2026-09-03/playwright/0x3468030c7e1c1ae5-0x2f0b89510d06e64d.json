l,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSURpMkx2aHNnRRAB"]],"CIHM0ogKEICAgIDi2Nex1QE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-TW"],[["🍽今日餐點🍽\n🥦前菜🥦\n@涼拌蟹肉棒：濃郁的香油搭配清涼的蟹肉棒，口齒留香。\n@碳燒吉古啦：有嚼勁的竹輪搭配特調的醬汁，十分有自家風味。\n🍜主餐🍜\n@地獄特盛叉燒拉麵（湯淡，麵適中）：濃郁的湯頭，配上極香辣油，麻香而不死辣。有嚼勁的叉燒，不油不膩。吃完令人還想再來一碗。\n@博多豚骨海苔拉麵：整碗滿滿的大海苔。喝下湯頭，先是撲鼻的蒜香，到喉頭又轉換為濃郁的海苔味，令人睜大眼的驚艷程度。\n\n整體來說是我在土城吃過最好吃的拉麵。老闆人很客氣，隨麵還附贈2碗毛豆（吃完還想再點的好吃阿），內用還可加麵。\n下次一定要在週末再來品嚐，試試看菜單上的雪花餃子。",null,[0,38]]]],[null,1634444191000000,1634444191000000,"4 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQ3NsSUJtUUtWSzVrY0RUUkFBZm9xdw%7CCAEQrcz1_gkiLwoZQ0hfQ3NsSUJtUUtWSzVrY0RUUkFBZm9xdxoSQ2dzSW44ZXVpd1lRa05fckVn\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjboeyCzNKWAxUddvUHHYqHA_4Q_2MIvwEoCQ"],"https://business.google.com/local/business/11231739645298955202/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnBNa3gyYUhOblJSQUIQAA%3D%3D",[null,null,null,"/local/business/11231739645298955202/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnBNa3gyYUhOblJSQUIQAA%3D%3D"],"https://business.google.com/local/business/11231739645298955202/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnBNa3gyYUhOblJSQUIQAA%3D%3D",[null,null,null,"/local/business/11231739645298955202/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnBNa3gyYUhOblJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/11231739645298955202/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnBNa3gyYUhOblJSQUIQAA%3D%3D",[null,null,null,"/local/business/11231739645298955202/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnBNa3gyYUhOblJSQUIQAA%3D%3D"],null,["zh-Hant"],[["謝謝你的好評😊歡迎下次再來",null,[0,13]]]],[null,null,4647,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURpMkx2aHNnRRAB!2m1!1s0x0:0x2f0b89510d06e64d!3m1!1s2@1:CIHM0ogKEICAgIDi2LvhsgE%7C%7C?