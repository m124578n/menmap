時，也能感受到清新、溫暖與健康。\n\n這就是我與拉麵的故事。\n一碗麵，不只是味道，\n更是一段旅程、一份心意。\n希望大家也能喜歡我用心打造的這碗拉麵 🍜✨"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-S0XC1_cTwAY/AAAAAAAAAAI/AAAAAAAAAAA/6YoOFMPHZb4/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"臺北市大同區永樂里",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQhbADCLACKAA","全部",[["CIABIhAGbzaqChiQ-2fzHgMABt-E",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWlvpf0aER7X9UekYJ7qBiQSr-9Nd8AEFbPnQct3Xtt6cMSA_I18RXjWz0E3grxdq9MuwhkS3fWNpQRJiLgLp6Kem2x8oGsCEpXP32veNkB3fODMzujrwrsJwCsSH73Rr4y4m7KObw8oEURF\u003dw404-h298-k-no","",[1284,947],[203,100]],null,[[3,121.5099209,25.056212499999997],[0,90],[1284,947],75],"0nSZatfxA_Dr1e8PxJ2nsQc","0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQzCcIsQIoAA",null,null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhAGbzaqChiQ-2fzHgMABt-E"],[10,3,[947,1284]],null,null,[[[2],[[null,null,25.056212499999997,121.5099209]]]],[1,null,null,null,null,[null,null,"bizbuilder:gmb_on_local_universal_desktop",[6,7,4,1,3]],null,null,[2025,4,7,0]],null,null,null,null,null,null,null,null,null,null,null,null,["UGCS_REFERENCE","CIABIhAGbzaqChiQ-2fzHgMABt-E||","1"]],1,null,null,null,null,null,null,["3765758601074472581","6790775583011295407"],null,"R9VYaCVQDsg"]],null,null,null,null,null,null,0,1,null,0],["CgIgARICGAI\u003d","0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQhbADCLICKAE","最新",[["CIABIhCpBUYE5Qrv9MUBH0ao_qy6",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmxSmN10WScSpa-Y-CjCpt5uRSpd0P1V4It4kJvXlQXoEupk8OWFlGHcEH4QbggbJ4vNV9wS3ZyPdS6oFR2EaL5iy96WzCBKVf9r3VSm8Xr_iWHXX3m7Reu6mnZ4Nplf2-uEIKSmDgXtMQ\u003dw224-h298-k-no","",[3024,4032],[203,100]],null,[[3,121.5099209,25.056212499999997],[0,90],[3024,4032],75],"0nSZatfxA_Dr1e8PxJ2nsQc","0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQzCcIswIoAA",null,n