_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQ3IcHCL0BKAQ",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQ3IcHCL4BKAU",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQ3IcHCL8BKAY",null,null,null,[1],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["好難吃，真的好難吃，到底為啥這麼難吃。\n\n今天剛好來大稻埕，想說在這附近吃個東西。滑了Google評論，看到這間店有4.7顆星的評價，而且不是靠送東西得來的。想必是蠻好吃的吧？\n\n殊不知，湯頭彷彿公館旁邊可以一直免費加麵的學生拉麵；麵大概四口就吃完了，說有什麼特別的，也說不出來；肉難咬到一個不行，第一次吃到需要我與其拉扯的叉燒；溏心蛋一整個非常之不溏心；唯一的優點只有七味粉的罐子是可以轉開的，但那也是建立在我會轉開加七味粉的情況下。\n\n留下這篇評論，救一個是一個。",null,[0,88]]]],[null,1777989663000000,1777989663000000,"3 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfTjhTYjRRSXoyRVotUEs5TmZoX2pldw%7CCAEQrcz1_gkiLwoZQ0hfTjhTYjRRSXoyRVotUEs5TmZoX2pldxoSQ2dzSW5fRG56d1lRbjhPcEZR\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQ_2MIwAEoBw"],"https://business.google.com/local/business/8270955745292171165/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzWmxsdVZrZGhXRlpxV210b1VsSnJkRlZXYkZwTllVWktOV1ZWUlJBQhAA",[null,null,null,"/local/business/8270955745292171165/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzWmxsdVZrZGhXRlpxV210b1VsSnJkRlZXYkZwTllVWktOV1ZWUlJBQhAA"],"https://business.google.com/local/business/8270955745292171165/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzWmxsdVZrZGhXRlpxV210b1VsSnJkRlZXYkZwTllVWktOV1ZWUlJBQhAA",[null,null,null,"/local/business/8270955745292171165/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzWmxsdVZrZGhXRlpxV210b1VsSnJkRlZXYkZwTllVWktOV1ZWUlJBQhAA"],null,"https://business.google.com/local/business/8270955745292171165/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzWmxsdVZrZGhXRlpxV210b1VsSnJkRlZXYkZwTllVWktOV1ZWUlJBQhAA",[null,null,null,"/local/business/8270955745292171165/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzWmxsdVZrZGhXRlpxV210b1VsSnJkRlZXYkZwTllVWktOV1ZWUlJBQhAA"],null,["zh-Hant"],[["感謝您這麼直接的回饋，也很抱歉這次的用餐體驗沒有達到您的期待。\n關於您提到的湯頭、麵體、叉燒與溏心蛋的部分，我們都已經記錄下來，會再進一步檢視當天的出餐狀況與製作細節。\n我們的風味確實有一定的風格取向，但如果讓您有這樣的感受，代表在呈現上還有需要調整與進步的地方。\n也謝謝您願意留下這樣具體的意見，對我們來說是很重要的參考。\n如果您願意，也歡迎再次來訪或與我們聯繫，讓我們有機會提供更好的體驗。",null,[0,132]]]],[null,null,1061,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tsZlluVkdhWFZqWmtoUlJrdFVWbFpNYUZKNWVVRRAB!2m1!1s0x0:0x5e3dae69e6c8d0af!3m1!1s2@1:CAIQACodChtycF9oOklfYnVGaXVjZkhRRktUVlZMaFJ5eUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2tsZlluVkdhWFZqWmtoUlJrdFVWbFpNYUZKNWVVRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2tsZlluVkdhWFZqWmtoUlJrdFVWbFpNYUZKNWVVRRI-Ci9DQUlRQUNvZENodHljRjlvT2tsZlluVkdhWFZqWmtoUlJrdFVWbFpNYUZKNWVVRRILMGR5TjliVFRMUVYaPgovQ0FJUUFDb2RDaHR5Y0Y5b09rbGZZblZHYVhWalpraFJSa3RVVmxaTWFGSjVlVUUSCzBkeU45YlRUTFFWIhIJAAAAAAAAAAARr9DI5mmuPV4qCzBkeU45YlRUTFFW\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQoykIwQEoCA"],null,[null,[[1,0]]]],"0ahUKEwiX9a72wNKWAxVseF4EHQunE2MQ0pMFCG0oBw"],null,null,null,"0ahUKEwjXoqn2wNKWAxXwdfUHHcTOKXYQ0pMFCLUBKAc"]],null,null,null,"other_user_google_review_posts__and__hotel_and_vr_partner_review_posts",null,"CjEIARIpCgoAP7_LADt7____EhCu_yikYcVGIMVhJiUAAAAAGgn92PgCYglZoagYACIA"]],null,null,null,[3,1,null,null,null,[2]],["顧客表示這家拉麵店的湯頭濃郁夠味，尤其黑蒜和辣味選項更是受到好評，厚切軟嫩的叉燒也令人印象深刻。他們特別提到新鮮的海鮮、搭配塔塔醬酥脆的炸雞，以及獨特迷人的用餐氛圍。評論提到店員親切又細心，熱麥茶的供應也很方便。",null,"https://www.google.com/local/content/rap/report?postId\u003d5%401:CAIQACodChtyc19oOlIxaUhBMEtoZ0ZjczVhcFhqUUlJZFE%7CCAIQACorChtyc19oOlIxaUhBMEtoZ0ZjczVhcFhqUUlJZFESDAip4OHTBhDQn_PEAQ\u0026d\u003d286732321\u0026t\u003d8",298,null,[["https://lh3.googleusercontent.com/a/ACg8ocJT4-No