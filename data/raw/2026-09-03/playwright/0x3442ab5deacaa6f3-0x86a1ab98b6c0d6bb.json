ps://lh3.googleusercontent.com/a/ACg8ocKg3AHdEhuuJ3tvAjAo2Pra9ReZ8VXSME3FvNglVX9AfyQqMA\u003ds120-c-rp-mo-ba12-br100",null,null,"108083319705184183598"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2018,1,1,11,null,null,null,null,["8 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICkhL7ASw\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x86a1ab98b6c0d6bb"]],1,null,null,null,null,null,null,["0","-8745520328987322693"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUNnNHRpaVlBEAE"]],"CIHM0ogKEICAgICkhL7ASw",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["美食街很擠所以繞了很久，意外發現像是個世外桃源的地方，一開始因為沒什麼客人所以觀望了一陣子，後來看google上的評價不錯，就進來點了一碗帆立貝鹽味拉麵。本來覺得店員和內場都是台灣人，不抱太大期待，但喝了一口湯之後覺得完全小看了！湯頭就像其他網友說的，有大海的味道（笑），麵條我有請他做硬一點和加量（菜單上有寫可以調整，但店員沒問），口感很像以前在林森北路吃的札幌拉麵。帆立貝不常吃，但我很喜歡，有點像奶油味的甜味。叉燒屬於比較硬的，但醃製調味的很好。整體來說非常好吃，也不會太鹹。地點難找是缺點，但也因此人很少（我蠻擔心他們的生意⋯）",null,[0,268]]]],[],[null,null,1222,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNnNHRpaVlBEAE!2m1!1s0x0:0x86a1ab98b6c0d6bb!3m1!1s2@1:CIHM0ogKEICAgICg4tiiYA%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUNnNHRpaVlBEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUNnNHRpaVlBEi0KF0NJSE0wb2dLRUlDQWdJQ2c0dGlpNEFFEhJDZ3NJa3NDbzBnVVFnTVNxSWcaLAoWQ0lITTBvZ0tFSUNBZ0lDZzR0aWlFQRISQ2dzSWtzQ28wZ1VRZ01TcUlnIhIJAAAAAAAAAAARu9bAtpiroYYqCzBQSFgtSDNIZTct\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjB0fnFxdKWAxVUdfUHHd0hJmQQoykIRygF"],null,[null,[[1,1]]]],"0ahUKEwj1tILGxdKWAxU8icAFHe5ZMtYQ0pMFCAIoAA"],null,null,null,"0ahUKEwjB0fnFxdKWAxVUdfUHHd0hJmQQ0pMFCD0oAA"],[["ChZDSUhNMG9nS0VJQ0FnSURRcnRhOVN3EAE",["0x0:0x86a1ab98b6c0d6bb",null,1513434071636000,1513438420418000,[null,null,["https://www.google.com/maps/contrib/102853201852117407996/reviews?hl\u003dzh-TW"],null,null,["張筑鈞