l,null,["0","7026711484570653914"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUNtOUxQTE5nEAE"]],"CIHM0ogKEICAgID9xPnI8gE",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjmpY6ZwNKWAxWmma8BHa4hEDIQ3YcHCJIBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjmpY6ZwNKWAxWmma8BHa4hEDIQ3IcHCJEBKAY",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjmpY6ZwNKWAxWmma8BHa4hEDIQ3YcHCJQBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjmpY6ZwNKWAxWmma8BHa4hEDIQ3IcHCJMBKAc",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjmpY6ZwNKWAxWmma8BHa4hEDIQ3IcHCJUBKAg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjmpY6ZwNKWAxWmma8BHa4hEDIQ3IcHCJYBKAk",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjmpY6ZwNKWAxWmma8BHa4hEDIQ3IcHCJcBKAo",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["今天的目的地是九湯屋日式拉麵，到的時候剛過午餐時間，環境跟桌面看起來剛整理過，乾凈且燈光明亮!餐具需自取，重點是飲料喝到飽.\n菜單上的選擇很多，也會把各種湯頭的原物料跟風味註明在菜單的右側，方便客人選擇.麵條的種類有兩種細麵跟捲麵，最後選擇了海鮮霸王濃口細麵，加點溏心蛋.麵上桌後，稍微看了一下內容物有蝦子，扇貝以及小九孔各2，但是這個擺盤，真的是讓人覺得浪費了如此豐盛的海鮮.蝦子放整齊一點，集中一點，整個視覺感官就舒服很多!蝦子的味道很鮮甜，只可惜沙腸沒有去掉，些微影響口感.湯頭味道偏淡，麵的口感比較軟，但是溏心蛋很入味，蛋黃也不會過熟.\n整體來說，在這個價格區間內，算是便宜又大碗，不雷可以推！\n再訪：蒙古白湯拉麵，加了孜然粉的湯頭，味道很不習慣，讓人沒辦法吃完它！！！",null,[0,62]]]],[null,null,null,null,null,"https://business.google.com/local/business/11928682128005732819/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnRPVXhRVEU1bkVBRRAA",[null,null,null,"/local/business/11928682128005732819/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnRPVXhRVEU1bkVBRRAA"],"https://business.google.com/local/business/11928682128005732819/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnRPVXhRVEU1bkVBRRAA",[nul