[10,3,[4032,3024]],[null,null,null,null,null,null,null,["韓金湯匙 無人拉麵 24 Hours (輔大店）"]],[null,[[["Miyu Lee"],"https://www.google.com/maps/contrib/108132427287079546819?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjUe2k5FrAwntjLZtjEkNeBxv-bqyzrxWbQ2ZobLTKaR5vLpe1tw\u003ds120-c-rp-mo-ba12-br100",null,null,"108132427287079546819"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2025,11,26,6,null,null,null,null,["9 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhAQ6PtEwmqB23sZVv8VUCW3\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xba9dbc46d66721c1"]],1,null,null,null,null,null,null,["0","-4999632998880566847"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT21SRVlqVlViakZQYURnMWIzYzRlRjl1ZUROUVgyYxAB"]],"CIABIhAQ6PtEwmqB23sZVv8VUCW3",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiowt2gyNKWAxU-oK8BHY6nEK8Q3IcHCIABKAM",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiowt2gyNKWAxU-oK8BHY6nEK8Q3IcHCIEBKAQ",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiowt2gyNKWAxU-oK8BHY6nEK8Q3IcHCIIBKAU",null,null,null,[1],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這間無人拉麵店自開幕以來，我光顧了許多次，一直很喜歡它的便利性與口味。然而，近期再訪時卻有些失望。\n\n首先，店內整潔度明顯下降，地板邊角處都有明顯髒污，與以往乾淨明亮的印象相差甚遠。其次，自助吧的備料狀況也不如過去，不確定是否為了應付午餐時段而提前補滿所有食材，但許多盒子蓋不上、取用不便，甚至有些菜色看起來凌亂。海帶芽成片的很少多為碎碎的，高麗菜也有不少應該要挑除的醜葉。此外，過去最期待的韓式泡菜這次也沒有提供，讓人頗為失望。\n\n環境與食材品質本是這間店吸引我反覆前來的原因，但這次的體驗讓我感到驚訝且有些遺憾。如果店家未來能重新重視環境維護與備料品質，我才會考慮再次光臨。",null,[0,49]]]],[null,null,null,null,null,"https://business.google.com/local/business/4867147221782570921/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTUlZscVZsVmlha1pRWVVSbk1XSXpZelJsUmpsMVpVUk9VVmd5WXhBQhAA",[null,null,null,"/local/business/4867147221782570921/customers/revie