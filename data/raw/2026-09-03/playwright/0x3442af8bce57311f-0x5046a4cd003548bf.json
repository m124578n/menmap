q6",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3YcHCHcoAA"]],1],null,null,"訂單類型",null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3IcHCHYoBw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3YcHCHkoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3IcHCHgoCA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3IcHCHooCQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3IcHCHsoCg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3IcHCHwoCw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3YcHCH4oAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3IcHCH0oDA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3YcHCIABKAA"]]],null,"座位類型",null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQ3IcHCH8oDQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["△ 不收一成服務費\n▲ 禁帶外食\n△ 低消 一碗麵\n▲ 無公休日\n△ 下午時段有休息\n▲ 麵 有兩種可以選\n△ 提供洗手間\n▲ 提供飲料、開水（自取）\n△ 附近自找停車場 / 格\n▲ 餐點現做需稍候\n△ 有販售小菜\n\n附近有路邊停車格跟停車場，算是很方便，如果要搭乘捷運，也可以坐到石牌站再走過來。不過建議就是騎車最方便的。\n\n「九湯屋拉麵」有非常多分店，口味上我覺得就是偏台式，每一家店都有一些差異。實際體驗，我覺得整體還不錯，這家分店的店內很乾淨、很舒適，而且還有提供飲品內無限享用。\n\n麵的感覺，我覺得湯頭比較像符合台灣口味，吃起來不會太油太膩，也不會太鹹，不過就是跟一般日本傳統拉麵有很多差異，如果是想著吃日本拉麵，可能會失望。\n\n但是我覺得就當成接近日本拉麵的台式拉麵，或是改良後的日本拉麵這樣吃起來可能會比較好一點，而且價格上也沒正宗拉麵那麼貴，價格都在一百多塊而已，而且內用也沒有收服務費。\n\n除了霸王海鮮麵，湯頭真的蒜味過於濃厚外，東京白湯跟蒙古白湯，表現都還不錯，如果以這個價格來看，我覺得算是可以的。\n\n上述內容大概是體驗的感想，如果有興趣的人還是可以來用餐試試，提供給大家參考。",null,[0,25]]]],[null,null,null,null,null,"https://business.google.com/local/business/8276752766218816999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPY1ZveFZrSmtWbVJWV2xaU2QxZ3dNVFJTUnpseVdsVjNlRTlYWXhBQhAA",[null,null,null,"/local/business/8276752766218816999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPY1ZveFZrSmtWbVJWV2xaU2QxZ3dNVFJTUnpseVdsVjNlRTlYWXhBQhAA"],"https://business.google.com/local/business/8276752766218816999/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPY1ZveFZrSmtWbVJWV2xaU2QxZ3dNVFJTUnpseVdsVjNlRTlYWXhBQhAA",[null,null,null,"/local/business/8276752766218816999/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPY1ZveFZrSmtWbVJWV2xaU2QxZ3dNVFJTUnpseVdsVjNlRTlYWXhBQhAA"],null,"https://business.google.com/local/business/8276752766218816999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPY1ZveFZrSmtWbVJWV2xaU2QxZ3dNVFJTUnpseVdsVjNlRTlYWXhBQhAA",[null,null,null,"/local/business/8276752766218816999/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPY1ZveFZrSmtWbVJWV2xaU2QxZ3dNVFJTUnpseVdsVjNlRTlYWXhBQhAA"]],[null,null,5395,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21OcVoxVkJkVmRVWlZSd1gwMTRSRzlyWlV3eE9XYxAB!2m1!1s0x0:0x5046a4cd003548bf!3m1!1s2@1:CAIQACodChtycF9oOmNqZ1VBdVdUZVRwX014RG9rZUwxOWc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21OcVoxVkJkVmRVWlZSd1gwMTRSRzlyWlV3eE9XYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT21OcVoxVkJkVmRVWlZSd1gwMTRSRzlyWlV3eE9XYxI-Ci9DQUlRQUNvZENodHljRjlvT21OcVoxVkJkVmRVWlZSd1gwMTRSRzlyWlV3eE9XYxILMGQ0NUYyVEQtNVMaPgovQ0FJUUFDb2RDaHR5Y0Y5b09tTnFaMVZCZFZkVVpWUndYMDE0Ukc5clpVd3hPV2MSCzBkNDVGMlRELTVTIhIJAAAAAAAAAAARv0g1AM2kRlAqCzBkNDVGMlRELTVT\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiAnqf0w9KWAxVsj68BHQcJGSMQoykIgQEoDg"],nu