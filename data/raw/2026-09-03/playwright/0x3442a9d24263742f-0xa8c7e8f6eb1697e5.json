ll,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwikq7K1xtKWAxWknK8BHf5JIScQ3IcHCPEBKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwikq7K1xtKWAxWknK8BHf5JIScQ3IcHCPIBKAc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwikq7K1xtKWAxWknK8BHf5JIScQ3IcHCPMBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwikq7K1xtKWAxWknK8BHf5JIScQ3YcHCPUBKAA"]]],null,"座位類型",null,"0ahUKEwikq7K1xtKWAxWknK8BHf5JIScQ3IcHCPQBKAk",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["空間不大，比隔壁小高乾淨，價格雖然比小高貴，但是對拉麵來說依然是算平價，選擇種類比較多。\n\n叉燒雞白湯，叉燒炙燒過多了一個香氣，吃起來嫩，好吃；湯頭帶有一點奶味，偏清爽不膩，但不會沒有味道。\n\n嫩胸雞白湯，使用的是雞胸肉，但今天吃到的雞胸肉有點柴，蠻卡牙的，小可惜，但是整體上還是蠻好吃的。\n\n明太子叉燒飯，份量不大，但是口味鹹甜鹹甜的，好吃😋雖然寫微辣，但對於我不吃辣的人來說，這樣的微辣可以，有提味的效果，或許是明太子、醬汁跟白飯拌在一起中和了辣，所以吃起來不覺得辣口，這道可以嚐嚐，還不錯，但小貴。",null,[0,95]]]],[null,null,null,null,null,"https://business.google.com/local/business/1753265596411391634/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYjJOdVZURmtSMnhDVVRObk1rMUdPVWxNVlZJMFRWVkZlRk15WXhBQhAA",[null,null,null,"/local/business/1753265596411391634/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYjJOdVZURmtSMnhDVVRObk1rMUdPVWxNVlZJMFRWVkZlRk15WXhBQhAA"],"https://business.google.com/local/business/1753265596411391634/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYjJOdVZURmtSMnhDVVRObk1rMUdPVWxNVlZJMFRWVkZlRk15WXhBQhAA",[null,null,null,"/local/business/1753265596411391634/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYjJOdVZURmtSMnhDVVRObk1rMUdPVWxNVlZJMFRWVkZlRk15WXhBQhAA"],null,"https://business.google.com/local/business/1753265596411391634/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhYjJOdVZURmtSMnhDVVROb