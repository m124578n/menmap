ll,[[["萵苣"],"https://www.google.com/maps/contrib/115232034435190792012?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVmxVj_gwiwjNB0DF16TW70-hyt2iV_YseGZ1JHr-_16rvY51v5\u003ds120-c-rp-mo-ba12-br100",null,null,"115232034435190792012"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,6,2,11,null,null,null,null,["3 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhC5ZzZ9hfxxd3sT43X7InZf\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x9378d895b198092f"]],1,null,null,null,null,null,null,["0","-7820262615487608529"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2s1Q05IZG1RbUptVEdWTk5XdHJPRVl0WmxoeVoyYxAB"]],"CIABIhC5ZzZ9hfxxd3sT43X7InZf",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjKubChxNKWAxUycvUHHeRrIIYQ3YcHCKUBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjKubChxNKWAxUycvUHHeRrIIYQ3IcHCKQBKAI",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjKubChxNKWAxUycvUHHeRrIIYQ3YcHCKcBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjKubChxNKWAxUycvUHHeRrIIYQ3IcHCKYBKAM",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjKubChxNKWAxUycvUHHeRrIIYQ3IcHCKgBKAQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjKubChxNKWAxUycvUHHeRrIIYQ3IcHCKkBKAU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjKubChxNKWAxUycvUHHeRrIIYQ3IcHCKoBKAY",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["第二次吃長生鹽人。\n\n這家店有擺放柴犬公仔，在飲水機旁邊的吧台桌上。\n我仔細端詳時，店員便主動靠近，熱情訴說著那是他的收藏，而且自己家裡也養柴犬，過程中眼神帶光。\n語畢，還不忘上手戳一下最左邊那軟軟的法鬥公仔…\n在拉麵店能遇到熱情親切的店員，然後發生這種可愛的小小互動，讓這一趟用餐的主觀體驗大幅上升！\n有這種店員，相信客人用餐的氛圍，或是廚房內部工作氛圍，都能因此大幅提升？\n（#上壓力）\n\n這一次是點醬油拉麵。\n沒記錯的話，醬油拉麵應該是在鹽味高湯的基礎上，加上醬油。\n在醬油的加持之下，整體湯頭喝起來有一種「下沉、厚重」的感覺。不是很清楚，但我猜醬油的選用上，大概是對岸口語所稱的老抽？\n\n————————————\n\n其實平常都是吃鷹流那種濃厚膩口的豬背脂豚骨拉麵，或是隱家蝦味厚醇的海老沾麵…就是口味比較重的那一種。\n\n想說嚐嚐看口味清淡、新手友善的鹽味拉麵，就踏入「民生店」。\n當時是吃基礎款的鹽味拉麵+日式炒麵。\n\n湯頭味道只能用典雅形容…不重口，也不致於索然無味，整體感覺就比較中庸。\n有特色的是那+15元的立成麵。\n鑒於極細麵條咬湯汁的特性，筷子拉起來漱上一口，能感受Q彈麵體和鹽味高湯在嘴巴發生「共融」。\n兩者相輔相成之下，產生一定層次的口感，供品嚐者玩味。\n如果麵吃完還有湯汁剩下，就點一碗白飯，蓋上去當湯泡飯吃！\n\n至於炒麵…\n剛炒出來的熱氣，夾帶在每一筷子的麵條、高麗菜、肉塊上，搭配鹹甜鹹甜的日式醬汁。\n我個人覺得，它就是主打第一口吃進去，那一入口的味道夠搶眼，進而讓你覺得好吃那樣。\n而且剛好這一盤炒麵，可能老闆的炒功給力，顏色和味道都有好好的咬在麵體上，也完全沒有醬汁加多或水分沒炒乾，導致麵體濕濕黏黏ㄍㄡˊ在一起的感覺。\n整體口味鮮明且不膩口，我個人大推，且網路上也不少網友推薦，建議點來吃吃看。\n（但可能看廚師功力，不是每一家、每一盤都這麼完美）",null,[0,34]]]],[null,1780450698000000,1780450698000000,"3 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfcTNzVXFxa3RPYkxCZGI2Wm1FRzFwQQ%7CCAEQrcz1_gkiMAoZQ0hfcTNzVXFxa3RPYkxCZGI2Wm1FRzFwQRoTQ2d3SWlvdi0wQVlRcjdxY3pBRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjKubChxNKWAxUycvUHHeRrIIYQ_2MIqwEoBw"],"https://business.google.com/local/business/8339519429077637702/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxUTA1SVpHMVJiVXB0VkVkV1RrNVhkSEpQUlZsMFdteG9lVm95WXhBQhAA",[null,null,null,"/local/business/8339519429077637702/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxUTA1SVpHMVJiVXB0VkVkV1RrNVhkSEpQUlZsMFdteG9lVm95WXhBQhAA"],"https://business.google.com/local/business/8339519429077637702/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxUTA1SVpHMVJiVXB0VkVkV1RrNVhkSEpQUlZsMFdteG9lVm95WXhBQhAA",[null,null,null,"/local/business/8339519429077637702/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxUTA1SVpHMVJiVXB0VkVkV1RrNVhkSEpQUlZsMFdteG9lVm95WXhBQhAA"],null,"https://business.google.com/local/business/8339519429077637702/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxUTA1SVpHMVJiVXB0VkVkV1RrNVhkSEpQUlZsMFdteG9lVm95WXhBQhAA",[null,null,null,"/local/business/833951942907763