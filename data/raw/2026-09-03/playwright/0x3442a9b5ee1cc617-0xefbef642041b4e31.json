IMz4a8",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3YcHCF4oAA"]],1],null,null,"訂單類型",null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3IcHCF0oBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3YcHCGAoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3IcHCF8oBQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3IcHCGEoBg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3IcHCGIoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3IcHCGMoCA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3YcHCGUoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3IcHCGQoCQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3YcHCGcoAA"]],1],null,null,"等待時間",null,"0ahUKEwjGu-_Mv9KWAxVkYvUHHXwzEt4Q3IcHCGYoCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["結論：如果鄰近這店家，是個值得一訪再訪的店家，但不需要千里迢迢來吃。\n\n開了有一段時間了，去全聯買東西時常常經過，今天第一次來吃，因為鄰近文化北路跟三合夜市，很少會跑來正義南路這吃飯。\n\n拉麵種類不多大概就四五樣，有時會推出隱藏版，忘了拍菜單，有內用低消印象中一人150元吧？！\n\n點了辣味跟咖哩豚骨都好吃！\n麵可以挑軟硬度，可以一直續麵，但只續一球麵也就飽了，溏心蛋好吃，叉燒有兩片，厚度適中，有筍乾跟豆芽菜等等配料，這樣一碗印象中是160元，個人覺得CP值超高。\n水餃好像有兩三種口味可以選擇，因為有低消，所以幫女兒點了一份皮蛋什麼的5顆70元，點水餃不是很划算…\n甜品我沒點，老婆有加購，她表示很普通，這我個人沒吃不予置評。",null,[0,92]]]],[null,null,null,null,null,"https://business.google.com/local/business/18397722655821309215/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhVjFkVmVGZFNNV1JNWVd0a