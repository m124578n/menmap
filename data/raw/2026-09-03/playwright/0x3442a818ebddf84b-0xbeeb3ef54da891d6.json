nq8BHfDRJTAQ3YcHCPYBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwjZrP--xtKWAxWnnq8BHfDRJTAQ3IcHCPUBKAw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjZrP--xtKWAxWnnq8BHfDRJTAQ3YcHCPgBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjZrP--xtKWAxWnnq8BHfDRJTAQ3IcHCPcBKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["如果想吃日式天婦羅丼飯，天吉屋一直以來都是品質穩定且價格合宜的優質選擇。這次點了經典的「天幕御膳」，可以先單獨品嚐剛炸好、口感酥脆的天婦羅，接著再依照喜好自行製作成丼飯或湯泡飯；一套餐點能享受三種不同的吃法，口味豐富且份量非常有誠意。\n\n店員的服務相當親切且周到，席間會主動巡視並即時補充茶水、整理餐盤，用餐感受很好。\n\n若是常在板橋生活圈活動的人，非常推薦辦理「三澧集團」的會員。雖然入會需收取 300 元，但會贈送三張200元沒有使用期限且無消費門檻的折價券，平時也會不定期發送其他優惠。旗下品牌如 BELLINI Pasta Pasta、MO MO PARADISE，在板橋車站環球與大遠百皆有分店，大約用餐兩次就能回本。且因折價券沒有最低消費門檻，對喜歡獨食的人來說非常實用且划算。",null,[0,117]]]],[null,1776507343000000,1777129387000000,"上次編輯：4 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfdWpfZXJjZVAxRDAteFBFSi1RZ05RQQ%7CCAEQrcz1_gkiMAoZQ0hfdWpfZXJjZVAxRDAteFBFSi1RZ05RQRoTQ2d3SXE2LXp6d1lRLXV2SzlBSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjZrP--xtKWAxWnnq8BHfDRJTAQ_2MI-QEoDg"],"https://business.google.com/local/business/14407407580468397270/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFqZVV4VlZrVlRXRUUwVTJwQ1dWVkdhRXRYYlVweFRua3hObFp1WXhBQhAA",[null,null,null,"/local/business/14407407580468397270/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFqZVV4VlZrVlRXRUUwVTJwQ1dWVkdhRXRYYlVweFRua3hObFp1WXhBQhAA"],"https://business.google.com/local/business/14407407580468397270/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFqZVV4VlZrVlRXRUUwVTJwQ1dWVkdhRXRYYlVweFRua3hObFp1WXhBQhAA",[null,null,null,"/local/business/14407407580468397270/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFqZVV4VlZrVlRXRUUwVTJwQ1dWVkdhRXRYYlVweFRua3hObFp1WXhBQhAA"],null,"https://business.google.com/local/business/14407407580468397270/cu