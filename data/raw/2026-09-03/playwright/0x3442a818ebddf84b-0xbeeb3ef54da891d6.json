ll,null,"0ahUKEwjZrP--xtKWAxWnnq8BHfDRJTAQ3YcHCJsCKAA"]],1],null,null,"等待時間",null,"0ahUKEwjZrP--xtKWAxWnnq8BHfDRJTAQ3IcHCJoCKBE",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["個人在日本最喜歡的料理就是海老天婦羅，\n對於正宗日式天婦羅也有一定的標準。\n聽說天吉屋源自新宿的本店，因此特地前來朝聖。\n\n第一次來點了「天幕御膳」，據說有三種吃法。\n餐點上桌的第一眼，發現海老天婦羅和想像中有些不同，\n整體外觀與口感都比較接近台式炸蝦，尺寸也偏小。\n\n整體用餐感想：\n味道不錯，但整體風味仍以台式為主，\n與日本當地那種輕盈爽口的天婦羅相比，仍有些差距。\n或許是因應台灣食材與口味的調整，\n因此少了日本天婦羅那種清爽細緻的層次，略顯可惜。\n看來想吃到真正道地的海老天婦羅，\n還是得再飛一趟日本了。",null,[0,60]]]],[null,1761391164000000,1761391164000000,"10 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfSXo4aHNDNmlvcG1BblZMcC1RdnhTZw%7CCAEQrcz1_gkiMAoZQ0hfSXo4aHNDNmlvcG1BblZMcC1RdnhTZxoTQ2d3SXZPVHl4d1lRbTZUVW9nTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjZrP--xtKWAxWnnq8BHfDRJTAQ_2MInAIoEg"],"https://business.google.com/local/business/14407407580468397270/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhVmxZelNqUlhSbFV3Vlc1Q2MxVkdXbTVYYlhSQ1VURmFXV1ZGUlJBQhAA",[null,null,null,"/local/business/14407407580468397270/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhVmxZelNqUlhSbFV3Vlc1Q2MxVkdXbTVYYlhSQ1VURmFXV1ZGUlJBQhAA"],"https://business.google.com/local/business/14407407580468397270/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhVmxZelNqUlhSbFV3Vlc1Q2MxVkdXbTVYYlhSQ1VURmFXV1ZGUlJBQhAA",[null,null,null,"/local/business/14407407580468397270/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhVmxZelNqUlhSbFV3Vlc1Q2MxVkdXbTVYYlhSQ1VURmFXV1ZGUlJBQhAA"],null,"https://business.google.com/local/business/14407407580468397270/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhVmxZelNqUlhSbFV3Vlc1Q2MxVkdXbTVYYlhSQ1VURmFXV1ZGUlJBQhAA",[null,null,null,"/local/business/14407407580468397270/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhVmxZelNqUlhSbFV3Vlc1Q2MxVkdXbTVYYlhSQ1VURmFXV1ZGUl