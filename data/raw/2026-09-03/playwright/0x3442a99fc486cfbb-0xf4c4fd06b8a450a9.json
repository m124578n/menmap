覺沒有那麼強",null,[0,53]]]],[null,null,null,null,null,"https://business.google.com/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYmxOSFdUSldWbFV5Wlc1d2RVMHlOVEpPUlZvMVlqQndjRlJ0WXhBQhAA",[null,null,null,"/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYmxOSFdUSldWbFV5Wlc1d2RVMHlOVEpPUlZvMVlqQndjRlJ0WXhBQhAA"],"https://business.google.com/local/business/1071064607437623902/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYmxOSFdUSldWbFV5Wlc1d2RVMHlOVEpPUlZvMVlqQndjRlJ0WXhBQhAA",[null,null,null,"/local/business/1071064607437623902/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYmxOSFdUSldWbFV5Wlc1d2RVMHlOVEpPUlZvMVlqQndjRlJ0WXhBQhAA"],null,"https://business.google.com/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYmxOSFdUSldWbFV5Wlc1d2RVMHlOVEpPUlZvMVlqQndjRlJ0WXhBQhAA",[null,null,null,"/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYmxOSFdUSldWbFV5Wlc1d2RVMHlOVEpPUlZvMVlqQndjRlJ0WXhBQhAA"]],[null,null,3101,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25KblNHWTJWVlUyZW5wdU0yNTJORVo1YjBwcFRtYxAB!2m1!1s0x0:0xf4c4fd06b8a450a9!3m1!1s2@1:CAIQACodChtycF9oOnJnSGY2VVU2enpuM252NEZ5b0ppTmc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25KblNHWTJWVlUyZW5wdU0yNTJORVo1YjBwcFRtYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25KblNHWTJWVlUyZW5wdU0yNTJORVo1YjBwcFRtYxI-Ci9DQUlRQUNvZENodHljRjlvT25KblNHWTJWVlUyZW5wdU0yNTJORVo1YjBwcFRtYxILMGVDd1hTUDBLek4aPgovQ0FJUUFDb2RDaHR5Y0Y5b09uSm5TR1kyVlZVMmVucHVNMjUyTkVaNWIwcHBUbWMSCzBlQ3dYU1AwS3pOIhIJAAAAAAAAAAARqVCkuAb9xPQqCzBlQ3dYU1AwS3pO\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjNi_mWxtKWAxUVi68BHTRqK4oQoykIvAEoCQ"],nul