0ahUKEwjNi_mWxtKWAxUVi68BHTRqK4oQ3IcHCFUoCQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_1_HOUR_UP"],"1 小時以上",2,null,null,"0ahUKEwjNi_mWxtKWAxUVi68BHTRqK4oQ3YcHCFgoAA"]],1],null,null,"等待時間",null,"0ahUKEwjNi_mWxtKWAxUVi68BHTRqK4oQ3IcHCFcoCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這次點了酸辣味噌拉麵，跟中山鬼金棒那種直球對決的辣味噌有些不同。這裡的湯頭帶點酸味，中和了辣度，層次感很夠。\n店家的角煮（控肉）表現非常優秀！厚實卻燉煮得相當入味軟嫩，肥瘦比例拿捏得剛剛好，是會讓人想要單點的靈魂配料，而且一塊很大塊吃得很過癮。\n\n目前全都是吧台座位只有12個座位，而且只有老闆一人在煮出餐速度有限，所以大排長龍，我們不到11:30到，大概12:50才吃到拉麵，等待得蠻辛苦的。\n若未來能規劃部分的桌位，增加點人手加速出餐，減少炎炎夏日及肚子餓的等待，對於用餐的體驗應該會更棒。",null,[0,122]]]],[null,null,null,null,null,"https://business.google.com/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxY1ZKRmJIUmFNMmMwVGpKMGMxRlhSbmRPUjNoT1VXNVNlRTVHUlJBQhAA",[null,null,null,"/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxY1ZKRmJIUmFNMmMwVGpKMGMxRlhSbmRPUjNoT1VXNVNlRTVHUlJBQhAA"],"https://business.google.com/local/business/1071064607437623902/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxY1ZKRmJIUmFNMmMwVGpKMGMxRlhSbmRPUjNoT1VXNVNlRTVHUlJBQhAA",[null,null,null,"/local/business/1071064607437623902/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxY1ZKRmJIUmFNMmMwVGpKMGMxRlhSbmRPUjNoT1VXNVNlRTVHUlJBQhAA"],null,"https://business.google.com/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxY1ZKRmJIUmFNMmMwVGpKMGMxRlhSbmRPUjNoT1VXNVNlRTVHUlJBQhAA",[null,null,null,"/local/business/1071064607437623902/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxY1ZKRmJIUmFNMmMwVGpKMGMxRlhSbmRPUjNoT1VXNVNlRTVHUlJBQhAA"]],[null,null,18847,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2s1cVJFbHRaM2c0TjJ0c1FXRndOR3hOUW5SeE5GRRAB!2m1!1s0x0:0xf4c4fd06b8a4