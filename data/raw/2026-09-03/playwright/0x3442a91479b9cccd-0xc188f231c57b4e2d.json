]],1],null,null,"訂單類型",null,"0ahUKEwjG7vbcxtKWAxWJoK8BHRftDyUQ3IcHCOABKAc",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjG7vbcxtKWAxWJoK8BHRftDyUQ3YcHCOMBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjG7vbcxtKWAxWJoK8BHRftDyUQ3IcHCOIBKAg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjG7vbcxtKWAxWJoK8BHRftDyUQ3YcHCOUBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjG7vbcxtKWAxWJoK8BHRftDyUQ3IcHCOQBKAk",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjG7vbcxtKWAxWJoK8BHRftDyUQ3IcHCOYBKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjG7vbcxtKWAxWJoK8BHRftDyUQ3IcHCOcBKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjG7vbcxtKWAxWJoK8BHRftDyUQ3IcHCOgBKAw",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["🔸蝦蝦餛飩+鮮蝦醬油雞清湯拉麵$320\n🔸叉燒飯$60\n醬油跟雞湯融合得很好，鮮蝦跟餛飩也好吃，整體非常喜歡～叉燒飯也還不賴，但偏小碗，可以跟拉麵一起預約。\n\n🔹玫瑰奶蓋高山茶雞湯$300\n清爽高雅的味道，內外兼具的一碗麵。\n個人偏好湯再濃郁一點的。\n\n🔸蟹蟹大家螃蟹雞湯拉麵$400\n🔸蜂蜜茶凍$50\n山茶的海鮮類湯頭都做的很厲害！強烈建議看到臉書公告海鮮類拉麵先卡位就對了🤣。\n吃完拉麵來份茶凍很解膩，想吃可以點。\n\n🔹聖誕香料紅酒雞牛醬油清湯拉麵$420\n這碗比較不對個人口味，朋友非常喜歡！和牛看起來有點可怕但很嫩很好入口！\n\n🔸水雞系-返璞歸真雞清湯拉麵$300\n湯頭很純粹，舒服～\n\n9/2(六)19:50到，前面有9位4組客人，大約等了50分鐘吃到麵～\n9/9(六)18:30到，前面有16位客人，大約等一個小時。不想久候可以開店前來等第一輪，或一個人來，比較容易提早入坐吧臺單人的空位。\n11/5(日)17:55到，也是等一小時，可能是有整隻螃蟹要嗑，翻桌率很慢的關係。\n\n之後兩次來都在開店前約半小時就來等，都是第一輪的前一兩名～\n\n近期吃最多次/最喜歡的拉麵店，希望離下次再吃到山茶的拉麵的日子不會太久🍜。",null,[0,78]]]],[null,null,null,null,null,"https://business.google.com/local/business/14952979066860684193/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmFNRTFsU0MxM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/14952979066860684193/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmFNRTFsU0MxM1JSQUIQAA%3D%3D"],"https://business.google.com