9srt5WXbkdv--4l1JRiaC9KqrxiBwWp2BvCflLqw\u003ds120-c-rp-mo-ba12-br100",null,null,"109212238178493474691"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2020,5,12,14,null,null,null,null,["6 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDcoOPy-wE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xc188f231c57b4e2d"]],1,null,null,null,null,null,null,["0","-4501081531976298963"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSURjb09PS0hBEAE"]],"CIHM0ogKEICAgIDcoOPy-wE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["初訪～看拉麵社團說要預約就乖乖預約，平日19:00到現場免排隊剛好滿，後面大概要等1-2組，環境裝潢屬於比較現代風，座位只有十個人（4個吧檯跟3張雙人小桌）環境是舒服的，不過水需要統一去洗手間旁取（但是這不是很需要喝水的拉麵）\n\n想要一次多嘗試不同的口味，點了阿里山茶香雞清湯拉麵、茶香奶油雞叉燒飯、厚雞柳叉燒、名古屋手羽先唐揚。\n\n拉麵部分：個人很少吃清雞湯口味，一開始喝覺得還不錯，但是如果每一口習慣湯頭+麵一起吃感覺湯會不太夠；湯頭是這次特色湯頭會有一個隱隱的茶香味不會澀，雞湯部分可能比較清淡不鹹吃到最後有一點點膩。但是麵條煮的很好是我喜歡的偏硬細麵！裡面的蘿蔔也很入味好吃～還帶湯圓是有點意外的部分\n\n叉燒飯：將茶香奶油攪和開後，配上醬汁跟白飯很好吃！是優秀等級！不過我趴兩口飯覺得不妙回來吃麵覺得變很淡...建議飯可以稍後上等客人麵吃完！會是個貼心舉動～\n\n雞叉燒：跟拉麵附上的不同，比較厚一咪咪而且塗醬後用炙燒多一個香氣也還不錯\n\n手羽唐揚：覺得中規中矩，可能覺得不夠多汁吧，因為用兩節翅不是用三節翅\n\n整體算還可以，偶爾換換淡麗係口味也行！不過喜歡濃厚系重鹹的真的就不推薦了",null,[0,113]]]],[null,null,null,null,null,"https://business.google.com/local/business/14952979066860684193/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmpiMDlQUzBoQkVBRRAA",[null,null,null,"/local/business/14952979066860684193/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmpiMDlQUzBoQkVBRRAA"],"https://business.google.com/local/business/14952979066860684193/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmpiMDlQUzBoQkVBRRAA",[null,null,null,"/local/business/14952979066860684193/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmpiMDlQUzBoQkVBRRAA"],null,"https://business.google.com/local/business/14952979066860684193/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmpiMDlQUzBoQkVBRRAA",[null,nul