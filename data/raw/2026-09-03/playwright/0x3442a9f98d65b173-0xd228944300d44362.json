w",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwittMaOw9KWAxU5c_UHHckaJeMQ3IcHCG8oFA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwittMaOw9KWAxU5c_UHHckaJeMQ3IcHCHAoFQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwittMaOw9KWAxU5c_UHHckaJeMQ3YcHCHIoAA"]],1],null,null,"等待時間",null,"0ahUKEwittMaOw9KWAxU5c_UHHckaJeMQ3IcHCHEoFg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["北車商圈終於也吃得到隱家了，平日中午不需排隊，直接點餐機點完入座，男店員服務非常好，耐心解說及引導。今天沒有點隱家招牌的雞湯拉麵，來試試當店限定的鴨白湯拉麵，也是蠻好吃的，值得推薦！\n鴨白湯拉麵(310元)是和附近旨燕類似的泡系白湯，上面有一層慕斯泡沫，湯頭熬得非常濃郁無腥味，滿滿雞鴨香味大爆擊，桌上的唐辛子和蒜泥建議都不要加，會破壞鴨湯鮮美的風味，個人覺得表現比旨燕好，想吃泡系鴨白湯直接來這吃就好！\n麵條選了細麵偏硬，硬度很不錯，鴨肉叉燒偏瘦，入口軟嫩，表現還OK，沒特別亮點但就穩定的不錯。加點的溏心蛋(40元)也是穩定輸出，想吃可以點。\n不過挑個小缺點，坐吧檯區的話，包包掛鉤居然是掛在靠近後面廁所的牆上，而不是在桌下，距離有點遠，吃麵時還要分心顧。\n\n#Lev",null,[0,91]]]],[null,null,null,null,null,"https://business.google.com/local/business/5839430049941233482/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFzTVU1NlVtdE9hbXd3WW0xMFJXVllaR2xWVlZab1dWUldNazlIWXhBQhAA",[null,null,null,"/local/business/5839430049941233482/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFzTVU1NlVtdE9hbXd3WW0xMFJXVllaR2xWVlZab1dWUldNazlIWXhBQhAA"],"https://business.google.com/local/business/5839430049941233482/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFzTVU1NlVtdE9hbXd3WW0xMFJXVllaR2xWVlZab1dWUldNazlIWXhBQhAA",[null,null,null,"/local/business/5839430049941233482/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFzTVU1NlVtdE9hbXd3WW0xMFJXVllaR2xWVlZab1dWUldNazlIWXhBQhAA"],null,"https://business.google.com/local/business/5839430049941233482/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFzTVU1NlVtdE9hbXd3WW0xMFJXVllaR2xWVlZab1dWUldNazlIWXhBQhAA",[null,null,null,"/local/busin