eMQ3IcHCKwBKAU",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwittMaOw9KWAxU5c_UHHckaJeMQ3IcHCK0BKAY",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["位於南陽街上的隱家拉麵分店。\n本店主打的柚香干貝拉麵（280元）兩次來訪皆已售罄，若想品嚐建議提早前往。以下為餐點的簡短心得：\n・豚骨醬油拉麵（250元） — 經典濃豚骨湯頭融合淡淡醬油香氣，搭配一塊炙燒雞叉燒。味道穩定中帶厚度，整體表現紮實；不過如果食量較大，一片叉燒實在吃不太飽，建議再加點叉燒。\n・TKG 飯（80元） — 炙燒叉燒飯搭配美乃滋、溫泉蛋與柴魚片，香氣四溢，滑順濃郁，是食量較大時的好選擇。\n平日16:20左右抵達時店內人潮還不會太多，不過17:00離開時已經幾乎客滿了，用餐時段可能會需要等候一會兒。\n以拉麵的水準與份量而言，價格合理；雖不提供免費加麵，但可於點餐時加價選擇。\n整體用餐體驗佳，值得二訪的拉麵店。\n\n餐點：★★★★★\n擺盤：★★★★☆\n份量：★★★★★\n環境：★★★★☆\n服務：★★★★☆\n排隊難度：★★☆☆☆\n性價比：★★★★★",null,[0,79]]]],[null,null,null,null,null,"https://business.google.com/local/business/5839430049941233482/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLV0dJeVdrVlZiR3hHVlVoT2IyTnRXazlaTVdReVRUTkNUMDB4UlJBQhAA",[null,null,null,"/local/business/5839430049941233482/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLV0dJeVdrVlZiR3hHVlVoT2IyTnRXazlaTVdReVRUTkNUMDB4UlJBQhAA"],"https://business.google.com/local/business/5839430049941233482/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLV0dJeVdrVlZiR3hHVlVoT2IyTnRXazlaTVdReVRUTkNUMDB4UlJBQhAA",[null,null,null,"/local/business/5839430049941233482/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLV0dJeVdrVlZiR3hHVlVoT2IyTnRXazlaTVdReVRUTkNUMDB4UlJBQhAA"],null,"https://business.google.com/local/business/5839430049941233482/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLV0dJeVdrVlZiR3hHVlVoT2IyTnRXazlaTVdReVRUTkNUMDB4UlJBQhAA",[null,null,null,"/local/business/5839430049941233482/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLV0dJeVdrVlZiR3hHVlVoT2IyTnRXazlaTVdReVRUTkNUMDB4UlJBQhAA"]],[null,null,1350,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pKWGIyWkVVbGxGVUhOb2NtWk9ZMWQyTTNCT00xRRAB!2m1!1s0x0:0