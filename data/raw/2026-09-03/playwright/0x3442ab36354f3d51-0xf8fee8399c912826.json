",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi9yO3ku9KWAxVhZ_UHHc0yFH8Q3YcHCK8BKAA"]],1],null,null,"等待時間",null,"0ahUKEwi9yO3ku9KWAxVhZ_UHHc0yFH8Q3IcHCK4BKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["細麵麵體煮的還不錯，兩百多塊的拉麵還配有三塊叉燒，炙燒過的口感也還ok，算是划得來的。醬油味的湯頭是認真蠻鹹的，豚骨鹽味就中規中矩，價格便宜跟營業時間到深夜這兩項算是比較獨有的優勢。\n只有一個員工運作的店頭，雖然拉麵這種餐食不需要多親切的服務，但是在自動點餐機點餐完全沒有圖片可以參考，客人看半天店員也就一句話都不說在那看著，這點真的是還蠻妙的，感覺客人離開店裡沒有賺錢他也沒差。",null,[0,91]]]],[null,null,null,null,null,"https://business.google.com/local/business/18045730776511823031/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHYkdSdE5YaFZWWFJ2WVVod05sWnRhSEJWYkZaclpHMXNiVlJ0WXhBQhAA",[null,null,null,"/local/business/18045730776511823031/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHYkdSdE5YaFZWWFJ2WVVod05sWnRhSEJWYkZaclpHMXNiVlJ0WXhBQhAA"],"https://business.google.com/local/business/18045730776511823031/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHYkdSdE5YaFZWWFJ2WVVod05sWnRhSEJWYkZaclpHMXNiVlJ0WXhBQhAA",[null,null,null,"/local/business/18045730776511823031/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHYkdSdE5YaFZWWFJ2WVVod05sWnRhSEJWYkZaclpHMXNiVlJ0WXhBQhAA"],null,"https://business.google.com/local/business/18045730776511823031/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHYkdSdE5YaFZWWFJ2WVVod05sWnRhSEJWYkZaclpHMXNiVlJ0WXhBQhAA",[null,null,null,"/local/business/18045730776511823031/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHYkdSdE5YaFZWWFJ2WVVod05sWnRhSEJWYkZaclpHMXNiVlJ0WXhBQhAA"]],[null,null,18756,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21GbGRtNXhVVXRvYUhwNlZtaHBVbFZrZG1sbVRtYxAB!2m1!1s0x0:0xf8fee8399c912826!3m1!1s2@1:CAIQACodChtycF9oOmFldm5xUUtoaHp6VmhpUlVkdmlmTmc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21