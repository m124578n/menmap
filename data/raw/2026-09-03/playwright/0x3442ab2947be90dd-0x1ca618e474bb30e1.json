,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["濃厚雞白湯拉麵320\n\n採自助點餐機下單.結帳\n有給到完整一顆蛋還不錯\n但肉量感覺可以再多一兩片\n或是洋蔥.水蓮的份量再多一些 增加口感或是不要讓人覺得一碗300多塊沒什麼料\n\n麵體和湯頭沒辦法調整軟硬跟濃淡\n我很少會把湯喝完 有喝完代表口味不會太死鹹\n\n店內很安靜 適合單獨吃飯\n如果要跟旁人邊吃邊聊天會感覺有點尷尬\n店員也滿冷漠的\n整體感覺下來\n如果不是點特殊口味的拉麵\n感覺不太需要特地大老遠跑過來吃",null,[0,23]]]],[null,null,null,null,null,"https://business.google.com/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvU2xGVE1VUldia3ByVjFSV2FrMXRXVFJOVlZFeVZXeENNMDVZWXhBQhAA",[null,null,null,"/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvU2xGVE1VUldia3ByVjFSV2FrMXRXVFJOVlZFeVZXeENNMDVZWXhBQhAA"],"https://business.google.com/local/business/15841010331632340335/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvU2xGVE1VUldia3ByVjFSV2FrMXRXVFJOVlZFeVZXeENNMDVZWXhBQhAA",[null,null,null,"/local/business/15841010331632340335/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvU2xGVE1VUldia3ByVjFSV2FrMXRXVFJOVlZFeVZXeENNMDVZWXhBQhAA"],null,"https://business.google.com/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvU2xGVE1VUldia3ByVjFSV2FrMXRXVFJOVlZFeVZXeENNMDVZWXhBQhAA",[null,null,null,"/local/business/15841010331632340335/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvU2xGVE1VUldia3ByVjFSV2FrMXRXVFJOVlZFeVZXeENNMDVZWXhBQhAA"]],[null,null,15114,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25oSlFTMURWbkprV1RWak1tWTRNVVEyVWxCM05YYxAB!2m1!1s0x0:0x1ca618e474bb30e1!3m1!1s2@1:CAIQACodChtycF9oOnhJQS1DVnJkWTVjMmY4MUQ2UlB3NXc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25oSlFTMURWbkprV1RWak1tWTRNVVEyVWxCM05YYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25oSlFTMURWbkprV1RWak1tWTRNVVEyVWxCM05YYxI-Ci9DQUlRQUNvZENodHlj