26t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xd3cc46494ee678f0",null,null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQ-y4IYigA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhA9jxYOPJU8aCaN17nZmyyf"],[10,3,[4080,3072]],[null,null,null,null,null,null,null,["麵匡匡拉麵食堂 台北萬隆店"]],[null,[[["henry yang"],"https://www.google.com/maps/contrib/101281142662510883589?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjUPbmHy5vrlnpavRgLmj3HmsTPBR0YatO6prSVsVCZziO-eiR3bYQ\u003ds120-c-rp-mo-ba12-br100",null,null,"101281142662510883589"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,2,22,14,null,null,null,null,["6 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhA9jxYOPJU8aCaN17nZmyyf\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xd3cc46494ee678f0"]],1,null,null,null,null,null,null,["0","-3185093555787499280"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xsVGJrdFdaR2RGUWw5WlNubHJTak5OT0ZSUFpFRRAB"]],"CIABIhA9jxYOPJU8aCaN17nZmyyf",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQ3YcHCGQoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQ3IcHCGMoAg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQ3IcHCGUoAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQ3IcHCGYoBA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQ3IcHCGcoBQ",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這次我們來到這家店，本來是衝著龍鬚菜來的。因為上一次我們家來吃的時候覺得很好吃，所以今天就想再來點一次。\n\n但是很可惜，在進入點餐介面的時候，就發現這個品項不能點了（反白了），我們推測可能是因為缺貨吧。\n\n好吧，我們點了一個柑橘拉麵，因為上一次來的時候有吃過，也覺得蠻好吃的，而且會附一片柑橘，小孩很喜歡。結果到了上菜的時候，碗裡什麼料都有，就是沒有那片柑橘。\n\n我心想好吧，那也就算了，一片柑橘也不是什麼大不了的事，但是孩子覺得很失望，還請我去問問看店員是不是漏放。\n\n如果是我自己吃，我是絕對不會為了這點小事去問的，但看到小孩覺得很失望，所以我還是去問了。\n\n我以為店員會說聲不好意思然後補給我們。沒想到店員不卑不亢的回覆說，因為柑橘沒有了所以沒有放。我聽了有點傻眼。\n\n海報照片上照了那麼大一片柑橘，而且名字就叫「柑橘拉麵」，結果居然沒有柑橘。\n\n而且點餐的時候也不講一下，上餐的時候也不講一下，直到被客人問了才回答說沒有了。\n\n早點告訴我們，我們就不會抱持錯誤的期待了😭\n\n不過看到店員理所當然的回應態度，我突然覺得好像是我錯了。我猜一定是在某個地方有寫一行小字，就像泡麵包裝上寫的「圖片僅供參考」之類的吧。\n\n只是我沒有找到這個小字，我也沒有再仔細去找，因為我們是來用餐的，不是來爭個輸贏的。\n\n就算我找到了那行小字又怎麼樣呢？它能夠幫我生出柑橘來嗎？或是它能夠讓店家拿出同等價值的替代品給我嗎？或是它能夠跟店員跟我們說聲不好意思讓孩子失望了嗎？\n\n都不可能嘛，所以也就這樣了吧。\n\n店員並非沒有禮貌，餐點也並非不好吃，只是我們有一種失望和被騙的感覺而已。\n\n不過我也能理解，上一次來的時候很滿意，不代表每一次都能夠很開心。\n\n店家供餐品質是會隨著食材和原物料波動的，這我是可以理解的。店家應該也不是存心欺騙，只不過就真的剛好食材真的沒有了。\n\n道理我都懂，我也能解釋給孩子聽。\n\n只是孩子也真的很失望就是了。\n\n---\n\n為什麼我還是給了評論五顆星？\n\n因為這家店其他部分也都還是很不錯，我相信店家也不是蓄意欺瞞。\n\n也許是我們不該有錯誤的期待。\n\n下次點餐前我們一定會問清楚的！",null,[0,101]]]],[null,1771773189000000,1771773189000000,"6 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfcnE4ZC1lZkpkWnpUSGdmS2wwVkxEZw%7CCAEQrcz1_gkiMAoZQ0hfcnE4ZC1lZkpkWnpUSGdmS2wwVkxEZxoTQ2d3SWhicnN6QVlRMl9XUXFBSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQ_2MIaCgG"],"https://business.google.com/local/business/12339503790484123117/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhzVkdKcmRGZGFSMlJHVVd3NVdsTnViSEpUYWs1T1QwWlNVRnBGUlJBQhAA",[null,null,null,"/local/business/12339503790484123117/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhzVkdKcmRGZGFSMlJHVVd3NVdsTnViSEpUYWs1T1QwWlNVRnBGUlJBQhAA"],"https://business.google.com/local/business/12339503790484123117/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhzVkdKcmRGZGFSMlJHVVd3NVdsTnViSEpUYWs1T1QwWlNVRnBGUlJBQhAA",[null,null,null,"/local/business/12339503790484123117/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhzVkdKcmRGZGFSMlJHVVd3NVdsTnViSEpUYWs1T1QwWlNVRnBGUlJBQhAA"],null,"https://business.google.com/local/business/12339503790484123117/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhzVkdKcmRGZGFSMlJHVVd3NVdsTnViSEpUYWs1T1QwWlNVRnBGUlJBQhAA",[null,null,null,"/local/business/12339503790484123117/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhzVkdKcmRGZGFSMlJHVVd3NVdsTnViSEpUYWs1T1QwWlNVRnBGUlJBQhAA"],null,["zh-Hant"],[["不好意思，柑橘鹽味拉麵確實本來會附上兩片柑橘，但因為缺貨問題導致用餐體驗不佳，我們深感歉意。\n至於沒有事先說明的部分，我們會再加強員工訓練。\n我們已經準備好補償方案，並且廠商會在2/24（二）恢復供應，柑橘鹽味拉麵將恢復正常，我們誠摯邀請您再次蒞臨！",null,[0,125]]]],[null,null,2231,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xsVGJrdFdaR2RGUWw5WlNubHJTak5OT0ZSUFpFRRAB!2m1!1s0x0:0xd3cc46494ee678f0!3m1!1s2@1:CAIQACodChtycF9oOllTbktWZGdFQl9ZSnlrSjNNOFRPZEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xsVGJrdFdaR2RGUWw5WlNubHJTak5OT0ZSUFpFRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xsVGJrdFdaR2RGUWw5WlNubHJTak5OT0ZSUFpFRRI-Ci9DQUlRQUNvZENodHljRjlvT2xsVGJrdFdaR2RGUWw5WlNubHJTak5OT0ZSUFpFRRILMGRha3VjZVg5UTQaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sbFRia3RXWkdkRlFsOVpTbmxyU2pOTk9GUlBaRUUSCzBkYWt1Y2VYOVE0IhIJAAAAAAAAAAAR8HjmTklGzNMqCzBkYWt1Y2VYOVE0\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQoykIaSgH"],null,[null,[[1,1]]]],"0ahUKEwjYk8iyxNKWAxWUd14EHc-jOuMQ0pMFCBsoAQ"],null,null,null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQ0pMFCF8oAQ"],[["Ci9DQUlRQUNvZENodHljRjlvT2tSR1gzaFdkVXBNV1ZWWWJGOVViMDh5ZW5nNFNYYxAB",["0x0:0xd3cc46494ee678f0",null,1753146904033462,1753146904033462,[null,null,["https://www.google.com/maps/contrib/116056760987263018973/reviews?hl\u003dzh-TW"],null,null,["Nell Liao","https://lh3.googleusercontent.com/a/ACg8ocKqjiaY_l0AuG-R-o5zohVRM6oFmJ7UFPcGLLkjlt3_9BOt5g\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/116056760987263018973?hl\u003dzh-TW"],"116056760987263018973",null,679,4212,null,[1,9,1],37,["在地嚮導 · 679 則評論",null,null,null,null,[null,"0ahUKEwiyrsCyxNKWAxXdcvUHHYCYFFgQpr8GCGsoAA