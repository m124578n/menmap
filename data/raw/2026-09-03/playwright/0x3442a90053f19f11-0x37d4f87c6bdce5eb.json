AA"]],1],null,null,"餐點類型",null,"0ahUKEwju4N2yytKWAxUnla8BHdmOGnEQ3IcHCHwoBQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwju4N2yytKWAxUnla8BHdmOGnEQ3YcHCH8oAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwju4N2yytKWAxUnla8BHdmOGnEQ3IcHCH4oBg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwju4N2yytKWAxUnla8BHdmOGnEQ3IcHCIABKAc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwju4N2yytKWAxUnla8BHdmOGnEQ3IcHCIEBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwju4N2yytKWAxUnla8BHdmOGnEQ3IcHCIIBKAk",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:RESERVATIONS_NOT_REQUIRED"],"不需要訂位",2,null,null,"0ahUKEwju4N2yytKWAxUnla8BHdmOGnEQ3YcHCIQBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwju4N2yytKWAxUnla8BHdmOGnEQ3IcHCIMBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["20260205[二刷]\n本次評價『不錯、美味』👍👍👍\n\n[限量 究極鴨二郎] 390\n二郎主打量多管飽，不管是豆芽菜、蔥花、洋蔥、蒜泥也不嫌多，讓整碗濃雞湯湯底相當刺激味蕾~\n三種肉片中，舒肥雞最好吃，舒肥鴨味道較獨特，叉燒肉片較為普通但也是最大片。\n麵量可以選擇1球~3球，我這碗點的是3球較硬的麵，鋪上肉片都快堆起一座小山丘了。這碗是不能加麵的，所以下單之前就要考慮好要吃多少分量，吃不飽就QQ了。\n\n_____________心得文______________\n上次沒吃到覺得很可惜，這次早點來就點到啦~ 味道也很不錯，不過位置有點偏僻沒多少客人。\n不愧是二郎系列，吃了很久才吃完，3球麵的份量讓我非常過癮，尤其是蒜泥和洋蔥等等的調味料也非常提味。\n只不過老闆不知道為何不會關店門，所以天氣冷的時候坐在門口會很難受，這次則是小強從門外衝進來，只差沒有飛起來往我撲過來。😨\n\n20260110 [首刷]\n本次評價『不錯、美味』👍👍👍\n\n[唐揚雞二郎拉麵] 290\n雞湯非常純粹且濃郁，蒜泥、洋蔥和蔥花三者不僅增添香氣，也不斷刺激我的味蕾。\n唐揚雞家在湯裡不太好，酥酥的外皮都濕掉了，不過還是好吃啦。\n二郎系拉麵不能加麵，所以我點了兩球麵，加上非常多的洋蔥，所以份量非常多。\n另外旁邊還附上茶凍，很解膩。\n\n_____________心得文______________\n公館又不知不覺地開了一家拉麵店，最近無意間發現趕緊來嘗鮮。結果還不錯，味道和分量讓人滿意，但可惜沒吃到菜單上的限量拉麵~",null,[0,27]]]],[null,null,null,null,null,"https://business.google.com/local/business/16917976989888429665/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLY1ZSR2JGSmlhekYyWTFkR1dXSXdVVE5sYlZwYVlrZG9