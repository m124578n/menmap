],1],null,null,"餐點類型",null,"0ahUKEwiUutrhv9KWAxVBna8BHVbaLVYQ3IcHCPABKBE",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiUutrhv9KWAxVBna8BHVbaLVYQ3YcHCPMBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiUutrhv9KWAxVBna8BHVbaLVYQ3IcHCPIBKBI",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiUutrhv9KWAxVBna8BHVbaLVYQ3IcHCPQBKBM",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiUutrhv9KWAxVBna8BHVbaLVYQ3IcHCPUBKBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiUutrhv9KWAxVBna8BHVbaLVYQ3IcHCPYBKBU",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11n6623wv0"],"味噌豚骨拉麵",2,null,null,"0ahUKEwiUutrhv9KWAxVBna8BHVbaLVYQ3YcHCPgBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiUutrhv9KWAxVBna8BHVbaLVYQ3IcHCPcBKBY",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["印象中在之前有吃過這家初原麵場，只是沒評論。\n店門口左側有機器可以點餐，付款完會有紙張落下，上面有號碼，進去後找座位，等叫號去餐，吃完有回收台需要自助回收座位比其他三重日式拉麵寬敞多。\n這次點味增豚骨拉麵。\n叉燒我覺得不錯，湯頭就感覺不到味增，但是滿濃郁，若有吃辣的在放飲料的冰箱有辣椒罐，加上去味道會增色不少，加的麵有比較硬一些。\n總之中規中矩，難怪客人也不少。",null,[0,103]]]],[null,1723518984000000,1723518984000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04bXcyUTlyMXBtdXRBSUFBZnJWZw%7CCAEQrcz1_gkiMAoZQ0hfQm04bXcyUTlyMXBtdXRBSUFBZnJWZxoTQ2d3SWlLRHJ0UVlRNk5fVzhBRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiUutrhv9KWAxVBna8BHVbaLVYQ_2MI-QEoFw"],"https://business.google.com/local/business/1754047210059248725/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmlNbTlIUTFwbkVBRRAA",[null,null,null,"/local/business/1754047210059248725/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUmlNbTlIUTFwbkVBRRAA"],"https://business.google.com/local/business/1