,[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwi57PqmxtKWAxV-VPUHHasqB3kQ3YcHCH0oAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi57PqmxtKWAxV-VPUHHasqB3kQ3IcHCHwoBw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi57PqmxtKWAxV-VPUHHasqB3kQ3IcHCH4oCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi57PqmxtKWAxV-VPUHHasqB3kQ3IcHCH8oCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi57PqmxtKWAxV-VPUHHasqB3kQ3IcHCIABKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwi57PqmxtKWAxV-VPUHHasqB3kQ3YcHCIIBKAA"]]],null,"用餐人數",null,"0ahUKEwi57PqmxtKWAxV-VPUHHasqB3kQ3IcHCIEBKAs",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwi57PqmxtKWAxV-VPUHHasqB3kQ3YcHCIQBKAA"]]],null,"座位類型",null,"0ahUKEwi57PqmxtKWAxV-VPUHHasqB3kQ3IcHCIMBKAw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["今晚又加班到半夜🌧️，外頭還下著大雨。\n腦袋滿是未解的程式碼🧠，但肚子誠實得很😩\n老規矩🛵，騎車轉進熟悉的巷口，\n那塊「初原麵場」的溫暖招牌✨，總像在對我說——\n「歡迎回來。」🙌🍜\n\n🏠 環境整潔明亮🧼，料理區一目了然\n廚師俐落地擺碗、起湯、炙燒叉燒🔥🍖\n每一碗麵都不是速成⏳，而是用時間與專注，慢慢堆疊出來的溫度🫶\n深夜的炙燒聲，對我這種爆肝工程師來說🧑\u200d💻\n是最暖的慰問🫂\n\n⸻\n\n🍲 雞白湯拉麵\n雞骨🐔＋雞爪🐾＋蔬果🥕🥬 長時間熬煮💧\n乳白湯頭濃而不膩🤍 滑順黏唇又回甘✨\n✅ 滿滿膠原蛋白，喝完皮膚都在微笑😊💧\n\n⸻\n\n🍜 醬油豚骨拉麵\n日式醬油🧂× 豚骨湯🐷 溫潤甘醇\n入口清爽又不失濃郁，剛剛好😋\n炙燒叉燒香氣四溢🔥 每口都在說「再來一碗！」\n\n⸻\n\n🌶️ 激辛味噌豚骨拉麵\n使用日本赤味噌🍜 香氣濃厚🥵\n入口先辣後甘，香氣撲鼻🌶️🌬️\n越吃越開胃，爆肝也值得！\n\n⸻\n\n🍖 炙燒叉燒必吃！\n表面焦香、油脂閃爍✨\n一入口，外酥內嫩、脂香四溢🔥\n油花在嘴裡化開的那一刻，\n真的會閉眼微笑——這就是療癒💕\n\n⸻\n\n✨整體份量十足🍽️ 每碗都有誠意👍\n無論你想補膠原、來點清爽、還是吃辣爆汗💦\n初原麵場 都能完美對應🍥🎯\n\n🧼 用餐後還可自助回收餐盤♻️\n乾淨又不失儀式感🫧🪑\n\n⸻\n\n💬 工程師雖然爆肝💻，\n但宵夜，真的不能隨便❗😤\n\n🏠地址：\n220新北市板橋區合宜一路135號\n⏰營業時間：\n週四到週一11:30-14:00，17:00-24:00\n\n#工程師宵夜選 #初原麵場 #雞白湯拉麵 #初原麵場 #焙煎雞白湯 #醬油豚骨 #激辛味