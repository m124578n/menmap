ull,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCGgoDg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCGkoDw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCGooEA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3YcHCGwoAA"]]],null,"用餐人數",null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCGsoEQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3YcHCG4oAA"]],1],null,null,"等待時間",null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCG0oEg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_PLENTY_OF_PARKING"],"很多停車位",2,null,null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3YcHCHAoAA"]],1],null,null,"停車位",null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCG8oEw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_GARAGE"],"付費室內停車場",2,null,null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3YcHCHIoAA"]]],null,"附近的停車場",null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCHEoFA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCHMoFQ",null,null,["消費可折抵"],null,null,3,null,2],[["GUIDED_DINING_KID_FRIENDLINESS_TIPS"],"親子友善程度",null,null,"分享親子友善程度相關資訊","親子友善程度",null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCHQoFg",null,null,["很友善"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3YcHCHYoAA"],[["E:KID_FRIENDLINESS"],"親子友善程度",2,null,null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3YcHCHcoAQ"]]],null,null,null,"0ahUKEwinh42XwtKWAxXTb_UHHWVxG1sQ3IcHCHUoFw",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["如果你帶一家老小來內湖逛萬家福，正在找一間能讓一家大小都找到自己想吃什麼的餐廳，那 Joyfull 絕對是安全牌。菜單從漢堡排、壽喜燒、炸物、咖哩到甜點、飲料一應俱全，多元到有點像在翻一本日式洋食百科，同行的人幾乎不用擔心沒有選擇。\n\n這次的 雙人套餐（NT$669） 包含關西壽喜燒、牛肉漢堡排＆炸白身魚定食、唐揚雞四塊，以及兩支霜淇淋，整體份量相當有誠意。\n\n其中最推薦的是牛肉漢堡排。肉汁飽滿、口感紮實，調味恰到好處，比不少主打「挽肉」的專賣店還令人驚喜，是這套餐裡最值得回點的主角。白身魚炸得也很出色，外皮酥脆、魚肉細嫩，沒有油耗味，炸功相當到位。\n\n相較之下，關西壽喜燒就比較可惜，整體醬汁偏鹹，建議搭配白飯一起享用，才能平衡風味。不過幸好這裡的白飯與味噌湯都可以無限續用，對食量大的人來說相當友善，也讓偏重口味的壽喜燒多了一點補救空間。\n\n飯後的霜淇淋，這個季節供應的是芒果口味，帶著清爽果香，正好替整餐畫下舒服的句點。\n\n除了主餐之外，Joyfull 最大的優勢是飲料吧無限暢飲、白飯與味噌湯吃到飽，加上寬敞明亮的用餐空間，非常適合家庭聚餐、小朋友放電後補充能量，或朋友聚會慢慢聊天。\n\n當然，也不是沒有可以改進的地方，霜淇淋甜筒有點朝軟了，點餐採 QR Code 線上點餐、櫃檯結帳 的模式，流程稍嫌繁瑣。如果未來能直接串接線上付款，吃完就能離席，相信用餐體驗會更流暢。另外，餐點需另加 10% 服務費，也別忘了先算進預算。",null,[0,116]]]],[null,null,null,null,null,"https://business.google.com/local/business/13970589945505576530/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaZDJGdGJ6RmxXRkpwVEZod2EyVkdaRnBaYlZaRlpFVndXR0Z0WXhBQhAA",[null,null,null,"/local/business/13970589945505576530/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaZDJGdGJ6RmxXRkpwVEZod2EyVkdaRnBaYlZaRlpFVndXR0Z0WXhBQhAA"],"https://business.google.com/local/business/13970589945505576530/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaZDJGdGJ6RmxXRkpwVEZod2EyVkdaRnBaYlZaRlpFVndXR0Z0WXhBQhAA",[null,null,null,"/local/business/13970589945505576530/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaZDJGdGJ6RmxXRkpwVEZod2EyVkdaRnBaYlZaRlpFVndXR0Z0WXhBQhAA"],null,"https://business.google.com/local/business/13970589945505576530/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaZDJGdGJ6RmxXRkpwVEZod2EyVkdaRnBaYlZaRlpFVndXR0Z0WXhBQhAA",[null,null,null,"/local/business/13970589945505576530/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaZDJGdGJ6R