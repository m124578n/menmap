ahUKEwjZ1fauzNKWAxV-dPUHHWREJnsQ3IcHCHsoBA",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjZ1fauzNKWAxV-dPUHHWREJnsQ3IcHCHwoBQ",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjZ1fauzNKWAxV-dPUHHWREJnsQ3IcHCH0oBg",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["看了評價來的，應該要點進來看評論。\n可能點了不是招牌….\n番茄拉麵，湯頭不太喜歡，同桌點豚骨相比之下比較好一點！\n\n配料-燒肉很香是好吃的燒肉、筍片沒有入味…麵條是好吃的麵條\n\n整體來說，比較是台式拉麵🍜\n\n套餐+20（有兩盤小菜+味增湯）\n蓮藕 酸鹹酸鹹（口味特別），但他的口感不是脆口的，跟有吃過口味、口感都不一樣….\n味增湯有點味增、水分離感\n\n飲料…綠茶、水蜜桃有點水感…\n\n以上是個人口味，每個人喜好不同，覺得喜歡日式的可能會比較不合，喜歡台式的、份量多的、有飲料冰品的～歡迎試試看。\n\n另外小朋友110公分以上有低消、QRC掃碼點餐後請自行去櫃檯付錢喔！\n以上小提醒。",null,[0,56]]]],[null,null,null,null,null,"https://business.google.com/local/business/11239442051442886388/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRrYUdSdWJIbFphbVIzVlVad2NVMXNiSFpoYTNSSVZESnZlbG93UlJBQhAA",[null,null,null,"/local/business/11239442051442886388/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRrYUdSdWJIbFphbVIzVlVad2NVMXNiSFpoYTNSSVZESnZlbG93UlJBQhAA"],"https://business.google.com/local/business/11239442051442886388/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRrYUdSdWJIbFphbVIzVlVad2NVMXNiSFpoYTNSSVZESnZlbG93UlJBQhAA",[null,null,null,"/local/business/11239442051442886388/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRrYUdSdWJIbFphbVIzVlVad2NVMXNiSFpoYTNSSVZESnZlbG93UlJBQhAA"],null,"https://business.google.com/local/business/11239442051442886388/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRrYUdSdWJIbFphbVIzVlVad2NVMXNiSFpoYTNSSVZESnZlbG93UlJBQhAA",[null,null,null,"/local/business/11239442051442886388/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRrYUdSdWJIbFphbVIzVlVad2NVMXNiSFpoYTNSSVZESnZlbG93UlJBQhAA"]],[null,null,3865,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!