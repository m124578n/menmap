訂單類型",null,"0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQ3IcHCLcBKAo",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:OTHER"],"其他",2,null,null,"0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQ3YcHCLoBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQ3IcHCLkBKAs",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQ3YcHCLwBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQ3IcHCLsBKAw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQ3IcHCL0BKA0",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQ3IcHCL4BKA4",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQ3IcHCL8BKA8",null,null,null,[1],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["▲ 有洗五星評論\n△ 位於聚食光\n▲ 價格偏高、份量偏少\n△ 自行用點餐機點餐\n▲ 餐點味道偏台式\n△ 停車自行找停車場 / 位\n▲ 味道有點偏鹹\n△ 個人不推薦\n\n每次來這邊，都看到生意好像普普通通，因為有次下午來，剛好旁邊的韓式休息，想說試試看拉麵好了... 沒想到.. 真是一次就下課\n\n光看份量... 這個價格真的太高，配料也是很普通。實際試了味道後，我覺得有點偏鹹，而且跟一般日本拉麵味道有很大差異，根本就是台式拉麵，這樣竟然要賣到 300多？？！ 真的是太坑人了，直接用日本價格賣\n\n實際試就知道為何沒有人來吃，不知道其他家分店是不是也這個品質？但是我真的沒有勇氣再去嘗試其他分店，個人是不推薦這家拉麵，如喜歡拉麵或是熱愛品嘗拉麵的人，這家就可以直接略過....\n\n說好吃的，一定是員工或朋友刷的五星好評，絕對不要相信...這邊（聚食光）雖然餐廳選項不多，但是拉麵真的可以不用選，其他的是可以試試，不過也不用抱太高的期待。\n\n拉麵真的不是放上叉燒肉、筍乾、木耳，加上海苔就可以稱為拉麵....如果以這個價格論，個人覺得乾脆隨便一碗牛肉麵、餛飩麵之類的...都還比較划算",null,[0,28]]]],[null,null,null,null,null,"https://business.google.com/local/business/7446612955199769638/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNNVkEzY21wQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/7446612955199769638/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNNVkEzY21wQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/7446612955199769638/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNNVkEzY21wQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/7446612955199769638/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNNVkEzY21wQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/7446612955199769638/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNNVkEzY21wQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/7446612955199769638/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNNVkEzY21wQlJSQUIQAA%3D%3D"]],[null,null,6909,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUM3MVA3cmpBRRAB!2m1!1s0x0:0x9c04cfb654dfe761!3m1!1s2@1:CIHM0ogKEICAgIC71P7rjAE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUM3MVA3cmpBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUM3MVA3cmpBRRItChZDSUhNMG9nS0VJQ0FnSUM3MVA3clRBEhNDZ3dJM3FicXRRWVFvTWVtMndFGi4KF0NJSE0wb2dLRUlDQWdJQzcxUDdyekFFEhNDZ3dJM3FicXRRWVFvTWVtMndFIhIJAAAAAAAAAAARYeffVLbPBJwqCzBhaWRDVFFQUERW\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQoykIwAEoEA"],null,[null,[[1,3]]]],"0ahUKEwix4oSRw9KWAxW2m8AFHd19GXwQ0pMFCHMoBw"],null,null,null,"0ahUKEwi1h_mQw9KWAxUwU_UHHcQgJLUQ0pMFCKMBKAc"]],null,null,null,"other_user_google_review_posts__and__hotel_and_vr_partner_review_posts",null,"CjEIARIpCgoAP7_LALEl____EhBbE3zbMyzp9ZfzkRQAAAAAGgn92QoCbrcwVwQYACIA"]],null,null,null,[3,1,null,null,null,[2]],["顧客表示這家拉麵店的拉麵很美味，特別喜歡風味十足的叉燒、筍乾和木耳，也稱讚自助點餐機讓點餐過程更快速。\n\n部分評論則提到，拉麵有時候會是冷的，而且餐具可能有點油膩。",null,"https://www.google.com/local/content/rap/report?postId\u003d5%401:CAIQACodChtyc19oOkhOdGNDM1JSRlRwdmdTd09ONDhfX2c%7CCAIQACorChtyc19oOkhOdGNDM1JSRlRwdmdTd09ONDhfX2cSDAip4OHTBhDQn_PEAQ\u0026d\u003d286732321\u0026t\u003d8",59,null,[["https://lh3.googleusercontent.com/a/ACg8ocIzVE9pwm3Gkc5VVUeK1uRgQ1sy7c2emSIqmc_UrV3gpr2lEQ\u003ds120-c-rp-mo-ba12-br100"],["https://lh3.googleuserconten