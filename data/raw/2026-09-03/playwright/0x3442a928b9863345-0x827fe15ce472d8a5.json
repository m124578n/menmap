IDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjE-Mf1v9KWAxUtc_UHHbFuJBIQ3IcHCFQoCQ",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjE-Mf1v9KWAxUtc_UHHbFuJBIQ3IcHCFUoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjE-Mf1v9KWAxUtc_UHHbFuJBIQ3IcHCFYoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjE-Mf1v9KWAxUtc_UHHbFuJBIQ3YcHCFgoAA"]],1],null,null,"等待時間",null,"0ahUKEwjE-Mf1v9KWAxUtc_UHHbFuJBIQ3IcHCFcoDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["店鋪不算太大但是翻桌蠻快\n店家很貼心不用一定要一個人一碗\n再來值得稱讚的是\n就算2人共食一碗還是可以加麵\n雖然我是沒有打算加啦\n但他們還是很細心一直詢問\n\n湯頭鹹度可以調整\n麵條軟硬也可以選擇\n只有兩種口味我點了麻辣的\n\n美中不足的是並沒有很辣\n桌上的辣椒加了也還是不辣\n我把麵條撈起來加辣椒跟白醋超好吃\n應該再加點蒜泥的\n\n湯頭有點麻奶鍋的感覺\n麵條像韓式泡麵\n沒有到特別好吃也沒有難吃\n一切中規中矩\n以這個價格算可以了\n內用有綠豆湯可以喝\n\n但是吃完後胃不是太舒服\n建議胃不好的謹慎服用",null,[0,37]]]],[null,null,null,null,null,"https://business.google.com/local/business/7164384572847881560/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnROZW1Wck9YSlRTRTVNVGtWYWFVMUVXbUZhYlhCM1kxWnNhR015WXhBQhAA",[null,null,null,"/local/business/7164384572847881560/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnROZW1Wck9YSlRTRTVNVGtWYWFVMUVXbUZhYlhCM1kxWnNhR015WXhBQhAA"],"https://business.google.com/local/business/7164384572847881560/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnROZW1Wck9YSlRTRTVNVGtWYWFVMUVXbUZhYlhCM1kxWnNhR015WXhBQhAA",[null,null,null,"/local/business/7164384572847881560/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnROZW1Wck9YSlRTRTVNVGtWYWFVMUVXbUZhYlhCM1kxWnNhR015WXhBQhAA"],null,"https://business.google.com/local/business/7164384572847881560/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnROZW1Wck9YSlRTRTVNVGtWYWFVMUVXbUZhYlhCM1kxWnNhR015WXhBQhAA",[n