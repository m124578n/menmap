ll,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCMYBKAs",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCMcBKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCMgBKA0",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3YcHCMoBKAA"]]],null,"用餐人數",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCMkBKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3YcHCMwBKAA"]]],null,"座位類型",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCMsBKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["📌台北車站靠近Z6或Z8出口\n\n📌星期六下午1:30左右抵達，不需要排隊。\n\n📌店內有眾多火影元素，菜單也是捲軸樣式，推薦喜歡火影的人來品嚐。\n\n📌上餐速度很快。\n\n📌點了火遁爆辛拉麵，平常會吃辣點中辣覺得還好，叉燒的部分很不錯，麵點偏硬不過感覺普普。\n\n📌另外點了一個招牌豚骨拉麵，溫泉蛋的部分加分，簡單來說就是好吃的拉麵，不會到特別驚艷。\n\n📌額外點了一杯千鳥，是奶油蘇打氣泡飲，奶油不論單吃還是混入都很好喝，上面還有放跳跳糖，增加了一個口感。\n\n📌以食物來看稍稍貴，不過還有整體的裝潢及氣氛，還是可以來嘗試看看。\n\n📌要收一成服務費，可以刷卡支持多元支付。",null,[0,37]]]],[null,null,null,null,null,"https://business.google.com/local/business/14776259047347401515/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhVlZkdWNIWlVWV2h1WVVaYWJsUXdXbEZpUjNSU1dETkdNVk51WXhBQhAA",[null,null,null,"/local/business/14776259047347401515/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhVlZkdWNIWlVWV2h1WVVaYWJsUXdXbEZpUjNSU1dETkdNVk51WXhBQhAA"],"https://business.google.com/local/business/14776259047347401515/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhVlZkdWNIWlVWV2h1WVVaYWJsUXdXbEZpUjNSU1dETkdNVk51WXhBQhAA",[null,null,null,"/local/business/14776259047347401515/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbH