84476241512"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25wbWRrVTJWMDUzUTJSTFJXbDZha3MyUTNGQlNIYxAB"]],"CIABIhAnoiUaAXaL1ILw1u00YW-P",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3YcHCFgoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCFcoBg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3YcHCFooAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCFkoBw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCFsoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCFwoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCF0oCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_LOUD"],"吵雜，但還是能交談",2,null,null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3YcHCF8oAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCF4oCw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3YcHCGEoAA"]],1],null,null,"等待時間",null,"0ahUKEwiWj4uVu9KWAxXGbfUHHfDeEFoQ3IcHCGAoDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["（歡迎ig搜尋全麵啟動探索更多拉麵和麵食！）\n\n（定番）一樂招牌豚骨拉麵$260+千鳥$99（當時價格）➡️（現在價格$270+$120）\n\n一楽おすすめ豚骨ラーメンNT$270\n千鳥NT$ 120\n\n2022/11\n\n整體評分（火影迷體驗感4.5🌟）（口味2.0🌟）\n\n🍜【食記】一樂拉麵｜火影迷必朝聖！還原度超高！木葉忍者村！\n\n⌚️【新企画】アーカイブから蘇る、思い出の定番・限定ラーメン(Day1)\n\n【🍜 新系列公告：那些年，我們一起追的拉麵回憶錄】\n\n這個系列會著重在分享我以往「吃過的拉麵與麵食」！這些都是以前吃、沒做食記前，沒好好完整記錄下來的寶藏照片，所以這次打算用回憶的視角，重新整理給大家。\n\n關於這個系列的「真心話告白」：\n\n📌 關於店家資訊： 只要我還查得到或還記得，就會標註！如果店家不幸歇業，或品項已經停售，我也會特別註記，當然，如果資訊有誤，超級歡迎各位麵友在留言區指正與補充！\n\n📌 關於口味細節： 那些排隊時間、湯頭鹹度、麵條硬度等細節……實不相瞞，我大概率已經忘光了（😅）。\n\n如果我還沒失憶，我會憑著最後的殘存記憶大概寫一下；如果真的不小心忘記了，就先跟各位麵友說聲抱歉啦！🙏\n\n💡 最後\n\n希望這個回憶系列大家能看得輕鬆，或許在這些照片裡，也能激起你曾經吃到那碗麵的回憶！\n\n不論是哪一碗讓你念念不忘、或是聽說過卻沒吃到的「限定神作」而感到惋惜的，又或者是比較新入坑的麵友，在這裡看到開啟你拉麵世界的「啟蒙入坑作」……\n\n都很歡迎在留言區一起閒聊、討論，留下你的看法！來跟我聊聊你記憶中的那碗麵吧！👇\n\n📒店家介紹\n\n這家全台唯一由日本官方正式授權的《火影忍者》主題拉麵店，當初2021年8月10日進駐台北信義威秀影城 2 樓時以超高還原度，吸引大批火影迷朝聖，轟動一時，但後續因為價格與口味和房租的關係，於2023 年 10 月 31 日吹熄燈號並結束營業，現已成為燒肉店。\n\n但後續2025「一樂拉麵」已在台北強勢回歸！\n\n目前開設「西門店」、「城中店」，兩間！\n\n餐點口味來說…..ㄜˊ🫠，千鳥不錯喝啦😅\n\n拉麵就…🤔🤔🤔\n\n也或許改天個人也再重新朝聖一下，說不定餐點已有所改變優化！\n\n但論整體還原度推薦火影迷一定要至少去一次！",null,[0,69]]]],[null,null,null,null,null,"https://business.google.com/local/business/14776259047347401515/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YldSclZUSldNRFV6VVRKU1RGSlhiRFpoYTNNeVVUTkdRbE5JWXhBQhAA",[null,null,null,"/local/business/14776259047347401515/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YldSclZUSldNRFV6VVRKU1RGSlhiRFpoYTNNeVVUTkdRbE5JWXhBQhAA"],"https://business.google.com/local/business/14776259047347401515/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YldSclZUSldNRFV6VVRKU1RGSlhiRFpoYTNNeVVUTkdRbE5JWXhBQhAA",[null,null,null,"/local/business/14776259047347401515/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YldSclZUSldNRFV6VVRKU1RGSlhiRFpoYTNNeVVUTkdRbE5JWXhBQhAA"],null,"https://business.google.com/local/business/14776259047347401515/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YldSclZUSldNRFV6VVRKU1RGSlhiRFpoYTNNeVVUTkdRbE5JWXhBQhAA",[null,null,null,"/local/business/14776259047347401515/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3YldSclZUSldNRFV6VVRKU1RGSlhiRFpoYTNNeVVUTkdRbE5JWXhBQhAA"]],[null,null,2811,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25wbWRrVTJWMDUzUTJSTFJ