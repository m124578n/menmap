,null,null,null,null,["3 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICpke3y9QE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xa328ee76f7f41ada"]],1,null,null,null,null,null,null,["0","-6689835051725350182"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUR5am9HYXhnRRAB"]],"CIHM0ogKEICAgICpke3y9QE",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ3YcHCNMBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ3IcHCNIBKDM",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ3YcHCNUBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ3IcHCNQBKDQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ3YcHCNcBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ3IcHCNYBKDU",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ3IcHCNgBKDY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ3IcHCNkBKDc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ3IcHCNoBKDg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-TW"],[["2023/08/05\n柑橘奶油雞湯鹽味拉麵\"夏至(geshi)\"\n\n由柑橘、柳橙、金桔、檸檬、萊姆、鳳梨、芒果的新鮮水果，來搭配濃郁的奶油鹽味湯頭，呈現多個層次的味道，建議金桔可以一半加入，會有不同的風味，芒果的甜意外的合，令人驚喜。\n\n舒肥的雞肉很嫩，火烤後的雞皮特別香，搭配麵條一下子就忽然吃完了。\n\n記得要來瓶精釀可樂，吃到一半喝一口，實在是很療癒。\n\n-------------------------------------------\n\n虱目魚雞湯鹽味拉麺\"銀波(ginpa)\"\n\n聽說是之前大受好評的銀波，老闆的第一碗麵，就試著預約看看。\n\n清澈的湯頭內，看得到虱目魚肚不斷分化至湯頭內，肆意的增加風味，一入口會先有虱目魚的味道，後來會有淡淡的鹽味，再來尾韻會有檸檬加九層塔的香氣。\n\n魚肚灼燒後的香味，以及看得到的油質奪目，入口會吃得到魚肉的細緻，灼燒舒肥雞肉也很軟嫩，但魚肚還是比較搶眼，若是怕魚味，可以搭配一小片嫩薑入口，虱目魚丸也甜有彈。\n\n算是很台日混合的一碗拉麵。\n\n-----------------------------------\n中秋限定。\n\n成吉思汗烤肉雞湯醬油拉麵\"望(nozomi)\"\n\n看到職人老闆的介紹：\n「澳洲羊梅花肉以自製醬料醃製一夜\n搭配爽口蔬菜與悠然的雞豚醬油清湯\n一樣會有溏心蛋\n倒影如同滿月般地在湯裡搖曳」\n\n忍不住就搶著預定，一到店門口，烤肉的香氣超濃厚，在外面等待無窮的想像。\n\n擺盤一樣綺麗，羊肉烤的外皮微焦，香味更是濃郁，隨著時間變長，烤肉的醬汁會讓清湯的味道產生變化。\n\n由於是烤肉主題，老闆使用烤肉、紅椒/黃椒、南瓜，營造烤肉的感覺，不得不說還蠻成功的，而且每樣都很好吃。\n\n最後清爽的豆芽菜、玉米筍、雞豚湯底用來解膩。湯頭扶著軟硬適中的拉麵入口，兩者搭配十分完善。\n\n說到烤肉當然要搭配酒類，檸檬堂微酸的口感加上氣泡，很適合搭配烤肉主題。\n\n悠然每次都讓人驚艷。\n\n-------------------\n\n悠然創作拉麵-鳳梨雞湯塩味拉麵\n\"楽園(rakuen)”\n\n第一次吃拉麵需要前一晚在時鐘前守候。\n\n鹽味的湯底搭配雞湯雅致的香味。\n隨著時間都運轉，鳳梨的味道會越來越多，\n夾起一塊多汁又甜的鳳梨，配合麵體與雞湯入口，又是不同的風味。\n\n再搭配小塊的醃漬鳳梨，另一種甜美的味道又不同。\n\n雞肉叉燒是使用舒肥加炙燒的方式，所以又軟香氣又足。\n\n蔬菜類清脆又爽口，溏心蛋帶點甜味，軟嫩入口。\n\n麵體屬於細麵，卻帶點麵心，對我而言是適中的，易帶湯汁的特性，十分合宜。\n\n吃到一半左右可搭配老闆建議的鳳梨醋，建議先倒入湯匙中試味道，一加入整碗湯頭又是不同風味，多點酸感。\n\n一碗麵搭配不同的食材就有多層次的風味。\n\n建議可以搭配桂花氣淬茶，桂花味很香又順口。\n\n老闆只有一個人，確實會等待較久的時間，但由食材、製作過程、擺盤、風味的展現等等都可以看出老闆的堅持與用心，我覺得這就是職人的堅持。\n\n前一晚的守候，確實值得。",null,[0,32]]]],[],[null,null,57705,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUR5am9HYXhnRRAB!2m1!1s0x0:0xa328ee76f7f41ada!3m1!1s2@1:CIHM0ogKEICAgIDyjoGaxgE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUR5am9HYXhnRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUR5am9HYXhnRRIsChZDSUhNMG9nS0VJQ0FnSUR5am9HYUpnEhJDZ3NJdXFTNXBnWVFpS2U0RncaLgoXQ0lITTBvZ0tFSUNBZ0lEeWpvR2FwZ0USE0Nnd0l5YW1UZ2dZUWtMUGNpd0UiEgkAAAAAAAAAABHaGvT3du4ooyoLMFpuXzd1MXZXRDc\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQoykI2wEoOQ"],null,[null,[[1,23]]]],"0ahUKEwidveusu9KWAxWTdV4EHbtuA5MQ0pMFCDAoAg"],null,null,null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ0pMFCGwoAg"],[["ChZDSUhNMG9nS0VJQ0FnSUN3LTgzdmZBEAE",["0x0:0xa328ee76f7f41ada",null,1515326519463000,1611190925662074,[null,null,["https://www.google.com/maps/contrib/112172226177637065507/reviews?hl\u003dzh-TW"],null,null,["Stars Yang","https://lh3.googleusercontent