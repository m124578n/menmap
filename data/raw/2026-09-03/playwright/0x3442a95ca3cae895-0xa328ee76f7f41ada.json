,null,["https://lh3.googleusercontent.com/grass-cs/ACvplmNOHFDbUYbYeNrzAo7ZmuyfcKqmtVionDGHaGvvg7HzeEcoW4aJI_oJJ_HR3RshBKEaErxne7TU_3UMYiCXt50WvFSwrZOVaDZqomqQTnz0qzEfXa-M5NHhy-Cdh4CJkOk5oa8\u003dk-no",null,[1440,1440]],null,[[3,121.52690108798748,25.061288878837757],[0,90],[1440,1440],75],"-W6ZarPoDa6qvr0P9YHaqQo","0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQzCcIywIoCA",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIC8ga3RNw\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xa328ee76f7f41ada",null,null,"0ahUKEwjzyMmsu9KWAxUula8BHfWANqUQ-y4IzAIoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIC8ga3RNw"],[10,3,[1440,1440]],[null,null,null,null,null,null,null,["創作拉麵 悠然"]],[null,[[["Terry Liao"],"https://www.google.com/maps/contrib/105157163024107151357?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjWb5GWGQYlfAiGk2TTf8l-6ottSd-pTDkYrs-jtZuAHjhJJ7Y9Kaw\u003ds120-c-rp-mo-ba12-br100",null,null,"105157163024107151357"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2020,7,8,18,null,null,null,null,["6 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIC8ga3RNw\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xa328ee76f7f41ada"]],1,null,null,null,null,null,null,["0","-6689835051725350182"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUM4Z2RYX05nEAE"]],"CIHM0ogKEICAgIC8ga3RNw",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["每週造訪都能遇到各式各樣不同口感的創意拉麵，與刻板印象的拉麵不太相同，沒有過濃的口味和大塊的叉燒，取而代之的是融入在地多元食材(有時候是水果、有時候是茶…)配合節慶(像是端午、中秋...)的清爽系拉麵，而且擺盤都像藝術品一樣～尤其是每碗都有的溏心蛋，我真的可以吃個3顆也不會膩！(喜歡吃一般拉麵的朋友可能會覺得比較清淡，但我非常喜歡)\n\n自從我去年發現這間店以來，已經造訪過近20次，雖然現在人越來越多，可是看到粉絲團上公布新口味還是超級無敵想嘗試～\n\n很喜歡老闆的堅持，每一款拉麵都有不一樣的名字與故事，也因為老闆是一人作業，再加上店內只有6個位置，常常需要等比較久，但是老闆親手料理絕對是品質保証！每週店內只有一款拉麵很隨機很酷！",null,[0,167]]]],[],[null,null,16476,["https://www.google.com/maps/reviews/data\u003d!4m8!