d\u003d0x0:0x8b4dd2938fc329fb",null,null,"0ahUKEwiGt--JxNKWAxWwbfUHHUGwMg8Q-y4I9wEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgICNpanmcA"],[10,3,[3024,3024]],[null,null,null,null,null,null,null,["らあめん花月嵐 北投石牌店"]],[null,[[["Ji yong Kwon"],"https://www.google.com/maps/contrib/111908689563941911986?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjWHcdiDD_ZUE-Tu7RXSZXNKfYg_62jxzkDMH9t449vevgrTrGo\u003ds120-c-rp-mo-ba12-br100",null,null,"111908689563941911986"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2024,1,16,8,null,null,null,null,["2 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICNpanmcA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x8b4dd2938fc329fb"]],1,null,null,null,null,null,null,["0","-8408833398016890373"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUNOcGFubVlBEAE"]],"CIHM0ogKEICAgICNpanmcA",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiGt--JxNKWAxWwbfUHHUGwMg8Q3IcHCPgBKAc",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiGt--JxNKWAxWwbfUHHUGwMg8Q3IcHCPkBKAg",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiGt--JxNKWAxWwbfUHHUGwMg8Q3IcHCPoBKAk",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["我說了如果不是太糟，我通常都給五顆星\n因為餐飲業在勞動的部分很辛苦～我很體諒\n\n如果想吃非常道地的日本拉麵\n或是想免費加麵加湯不要服務費\n那我不建議花月嵐\n\n但如果是跟我一樣，超級超級喜歡大蒜🧄\n也喜歡正宗日本拉麵鹹死的濃郁風味\n那就會跟我一樣，三不五時就會晃來吃一碗😆\n\n花月嵐很神奇，有夠久以前剛在台灣展店的時候\n還相當正宗日式～吃著吃著，好像被台灣略為同化了一些，變得有一點點台式；\n\n具體是哪邊其實説不上來，\n也許是為了因地制宜而調整了口味\n也許是我吃習慣了😅\n\n在台灣展店的形形色色拉麵品牌裡\n很少有特地以🧄大蒜🧄作為號召的拉麵店\n想當然爾～\n我來就是只會點大蒜拳骨拉麵原湯拉麵😆\n\n今天吃的是商業午餐套餐（雞塊飲料組合）\n📌雞塊是小份的，兩塊，加上爽口高麗菜絲\n其實對女生來說，這樣份量蠻剛好的\n\n📌辣韭菜是必加神奇！\n會讓拉麵從70分變成88分的神器！\n\n以前都是放在桌上讓客人隨意夾取，\n可能是因應台灣人民有時候不太優的貪小便宜習慣、也可能是店家基於成本或保鮮的考量，現在要跟服務人員索取，份量也不多\n\n不過話說回來，辣韭菜很鹹！！！\n別加到過多也是好啦😆哈哈哈\n\n📌蒜頭🧄🧄🧄也是要請服務人員送過來，\n自行用器具壓擠成蒜泥\n（是說我也曾經嘗試過大腸包小腸吃法，整顆啃～高興怎麼吃就怎麼吃😆）\n\n這家分店的美中不足在於\n服務人員可能比較疲憊⋯\n遇到親切的服務機會比較少⋯\n所以服務費這項會有一點⋯那個⋯你懂的\n\n不過我還是三不五時回來吃就是了！\n\n喔對了.花月嵐出名的鹹！跟在日本吃的拉麵一樣，\n有一種吃完洗腰子的錯覺～吃完多喝水！\n\n愛心小叮嚀❤️",null,[0,38]]]],[null,null,null,null,null,"https://business.google.com/local/business/17446489764088722626/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTk9jR0Z1YlZsQkVBRRAA",[null,null,null,"/local/business/17446489764088722626/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTk9jR0Z1YlZsQkVBRRAA"],"https://business.google.com/local/business/17446489764088722626/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTk9jR0Z1YlZsQkVBRRAA",[null,null,null,"/local/business/17446489764088722626/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTk9jR0Z1YlZsQkVBRRAA"],null,"https://business.google.com/local/business/17446489764088722626/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTk9jR0Z1YlZsQkVBRRAA",[null,null,null,"/local/business/17446489764088722626/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTk9jR0Z1YlZsQkVBRRAA"]],[null,null,9343,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNOcGFubVlBEAE!2m1!1s0x0:0x8b4dd2938fc329fb!3m1!1s2@1:CIHM0ogKEICAgICNpanmYA%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUNOcGFubVlBEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUNOcGFubVlBEi4KF0NJSE0wb2dLRUlDQWdJQ05wYW5tNEFFEhNDZ3dJb3FtZHJRWVE2UGFOa3dJGi0KFkNJSE0wb2dLRUlDQWdJQ05wYW5tRUESE0Nnd0k5X1dZclFZUS1PZVR4UUkiEgkAAAAAAAAAABH7KcOPk9JNiyoLMF9kcEhYWE5yaGM\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiGt--JxNKWAxWwbfUHHUGwMg8QoykI-wEoCg"],null,[null,[[1,4]]]],"0ahUKEwjNvvaJxNKWAxXNb14EHYsfFaYQ0pMFCKIBKAc"],null,null,null,"0ahUKEwiGt--JxNKWAxWwbfUHHUGwMg8Q0pMFCOoBKAc"]],null,null,null,"other_user_google_review_posts__and_