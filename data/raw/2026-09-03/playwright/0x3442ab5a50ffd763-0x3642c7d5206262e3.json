！會再來吃…",null,[0,45]]]],[null,null,null,null,null,"https://business.google.com/local/business/14474523854904174152/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXpOV0poWVZOQkVBRRAA",[null,null,null,"/local/business/14474523854904174152/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXpOV0poWVZOQkVBRRAA"],"https://business.google.com/local/business/14474523854904174152/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXpOV0poWVZOQkVBRRAA",[null,null,null,"/local/business/14474523854904174152/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXpOV0poWVZOQkVBRRAA"],null,"https://business.google.com/local/business/14474523854904174152/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXpOV0poWVZOQkVBRRAA",[null,null,null,"/local/business/14474523854904174152/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTXpOV0poWVZOQkVBRRAA"]],[null,null,7822,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUMzNWJhYVNBEAE!2m1!1s0x0:0x3642c7d5206262e3!3m1!1s2@1:CIHM0ogKEICAgIC35baaSA%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUMzNWJhYVNBEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUMzNWJhYVNBEi0KF0NJSE0wb2dLRUlDQWdJQzM1YmFheUFFEhJDZ3NJbjUyenVRWVEtSktORVEaLAoWQ0lITTBvZ0tFSUNBZ0lDMzViYWFLQRISQ2dzSW41Mnp1UVlRLUpLTkVRIhIJAAAAAAAAAAAR42JiINXHQjYqCzBiQUJ1VTE3b19z\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwj0mc2pxNKWAxVlkq8BHdqPBWcQoykIyQEoEA"],null,[null,[[1,0]]]],"0ahUKEwiHl9apxNKWAxWN_4sBHYjvBzwQ0pMFCGUoBg"],null,null,null,"0ahUKEwj0mc2pxNKWAxVlkq8BHdqPBWcQ0pMFCKwBKAY"],[["ChZDSUhNMG9nS0VJQ0FnSUNobG9YR1NnEAE",["0x0:0x3642c7d5206262e3",null,1676185769164707,1676198425163269,[null,null,["https://www.google.com/maps/contrib/104333168666053672254/reviews?hl\u003dzh-TW"],null,null,["拳四郎","https://lh3.googleusercontent.com/a-/ALV-UjUolf9yXoEHdsDPCkekrt2zByF79wkjofRmnU2cm-