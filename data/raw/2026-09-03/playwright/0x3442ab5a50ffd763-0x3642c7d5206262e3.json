ile\u0026fid\u003d0x0:0x3642c7d5206262e3"]],1,null,null,null,null,null,null,["0","3909907144696292067"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2tVMExWTlJVMGRhVkZRNVlXRlVPSGh1YjFCMlgwRRAB"]],"CIABIhDf4bIW7woLq9m__ZZ5rxc9",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwj0mc2pxNKWAxVlkq8BHdqPBWcQ3IcHCFcoBw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwj0mc2pxNKWAxVlkq8BHdqPBWcQ3IcHCFgoCA",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwj0mc2pxNKWAxVlkq8BHdqPBWcQ3IcHCFkoCQ",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["女店員聲音都很像幼幼台姐姐🤣~只能說老闆懂的請人\n【舊評】「麵匡匡」是「吾蜂美味集團」旗下的拉麵品牌，該集團旗下還有「老先覺功夫窯燒鍋」和「潮味決湯滷專門店」等其他餐飲品牌。\n桌面不夠整潔，酒精擦抹下去就是髒的，但旁邊有洗手台可以洗手洗餐具這點有加分。【外帶飲料它也不另外裝袋子更別提給杯架了，已經外帶兩次了每次都是邊走邊灑出來，就算要求封口也是一樣，這點真的很不OK】\n\n不錯：炙燒培根牛香蒜蛤蜊拉麵（湯頭不錯，肉沒吃到這部份無法評論），唐揚雞\n\n可：明太子叉燒飯,苺果茶（微甜不酸）\n一般：胡麻龍鬚,玉米筍（不要炙燒比較好），嫩雞胸白湯拉麵（味道清淡平實）",null,[0,87]]]],[null,null,null,null,null,"https://business.google.com/local/business/14474523854904174152/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWTUV4V1RsSlZNR1JoVmtaUk5WbFhSbFZQU0doMVlqRkNNbGd3UlJBQhAA",[null,null,null,"/local/business/14474523854904174152/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWTUV4V1RsSlZNR1JoVmtaUk5WbFhSbFZQU0doMVlqRkNNbGd3UlJBQhAA"],"https://business.google.com/local/business/14474523854904174152/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWTUV4V1RsSlZNR1JoVmtaUk5WbFhSbFZQU0doMVlqRkNNbGd3UlJBQhAA",[null,null,null,"/local/business/14474523854904174152/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRWTUV4V1RsSlZNR1JoVmtaUk5WbFhSbFZQU0doMVlqRkNNbGd3UlJBQhAA"],null,"https://business.google.com/local/business/14474523854904174152/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZa