,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUR0LTZIczVBRRAB"]],"CIHM0ogKEICAgIDT76WJ1AE",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi27uO3y9KWAxXFi68BHSCJEqMQ3IcHCIkCKBE",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi27uO3y9KWAxXFi68BHSCJEqMQ3IcHCIoCKBI",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi27uO3y9KWAxXFi68BHSCJEqMQ3IcHCIsCKBM",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這家店開了許久，孩子小時候超愛蛤蜊麵，但是這次回訪卻消失了。\n\n說明的菜單內有許多都消失了，雖然也多了許多飯類選擇，只是少了些本來很喜歡的餐點，還是覺得很可惜（可樂餅、炸飯糰）。\n\n此次點了醬油拉麵，平常日還有免費加麵服務，好吃的細麵條，原本小鳥胃的我都忍不住多加一份來吃。\n\n20240529回訪，可樂餅無敵好吃。\n\n老公選了豬排飯，炸豬排也是讚：外酥內部非常軟嫩，喜歡飯類的可以考慮。\n\n兒子選了特濃豚骨拉麵，覺得湯濃郁但是不會太鹹。其實正統的日本拉麵湯是非常鹹的，此間則是改良過的口味，湯都是可以喝光光的。另外單點的醬燒雞腿非常讚，入味多汁且有去骨。單點的青菜就比較普通，份量沒很足，醬汁也普通，不是很推薦。\n\n孩子愛吃拉麵，會考慮回訪。",null,[0,89]]]],[null,1711939883000000,1711939883000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQ0RkQlRsc0FCQUZtQ2lFckFBejRVQQ%7CCAEQrcz1_gkiMAoZQ0hfQ0RkQlRsc0FCQUZtQ2lFckFBejRVQRoTQ2d3SXE4S29zQVlROS03RmtnTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi27uO3y9KWAxXFi68BHSCJEqMQ_2MIjAIoFA"],"https://business.google.com/local/business/9735856844840864899/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUjBMVFpJY3pWQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/9735856844840864899/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUjBMVFpJY3pWQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/9735856844840864899/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUjBMVFpJY3pWQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/9735856844840864899/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUjBMVFpJY3pWQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/9735856844840864899/customers/review