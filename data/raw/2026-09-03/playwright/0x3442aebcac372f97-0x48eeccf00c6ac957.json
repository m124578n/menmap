gICrwrvH6AE",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjYw_yiw9KWAxXnoK8BHZS9BzwQ3YcHCOgBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjYw_yiw9KWAxXnoK8BHZS9BzwQ3IcHCOcBKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjYw_yiw9KWAxXnoK8BHZS9BzwQ3YcHCOoBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjYw_yiw9KWAxXnoK8BHZS9BzwQ3IcHCOkBKAY",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwjYw_yiw9KWAxXnoK8BHZS9BzwQ3YcHCOwBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjYw_yiw9KWAxXnoK8BHZS9BzwQ3IcHCOsBKAc",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjYw_yiw9KWAxXnoK8BHZS9BzwQ3IcHCO0BKAg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjYw_yiw9KWAxXnoK8BHZS9BzwQ3IcHCO4BKAk",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjYw_yiw9KWAxXnoK8BHZS9BzwQ3IcHCO8BKAo",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["2024/7月平日晚上訂位6：30，實際進來後大概坐半滿，這個時間點在士林站這裡還只有半滿，加上評分只有4.0本來令人有點擔心，但實際上並不差，就跟外送平台上差不多價位的台式日本料理便當品質相當，用餐環境也不錯，當然內用來講還是比其他平價日本料理稍貴。本次點了\n雞腿套餐$250：配菜有白飯，味噌湯，地瓜泥，台式泡菜與醃海帶，味噌湯是在台北喝過最甜的，很像在嘉義會喝到的味噌湯，泡菜就是標準的台式罐頭泡菜，在很多便當店都吃過，地瓜泥還不錯，不會太甜，適合夏天吃，雞腿本身烤的很好，很大塊，不會太水太軟，有焦香味皮也脆，咬下去沒有腥味，如果不愛吃海鮮的話是不錯的選擇。\n日式炸豆腐$50：蠻大份，炸的也很好，推薦。烤雞軟骨串$80：份量來講稍貴，和豆腐一樣，都是炸到焦脆偏乾，個人蠻喜歡這種稍微火力過猛的風格（順帶一提本來要點番茄牛肉串$100，不過店員說廠商今天沒送，看來更受歡迎）。\n魚蛋沙拉$180：我不懂市場價所以無法評斷CP值，不過味道不錯沒什麼腥味，很久沒吃魚蛋了覺得還不錯。\n整體而言就是台式日本料理，在同類型的平價店中稍貴，炸物烤物偏硬偏焦，炸的技術不錯。",null,[0,130]]]],[null,null,null,null,null,"https://business.google.com/local/business/11902887710582547036/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTnlkM0oyU0dsQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/11902887710582547036/customers/revi