KMBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCKIBKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3YcHCKUBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCKQBKAY",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCKYBKAc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCKcBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCKgBKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3YcHCKoBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCKkBKAo",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3YcHCKwBKAA"],[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3YcHCK0BKAE"]]],null,"座位類型",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCKsBKAs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["店家位在新埔站與新埔民生站切換的必經道路上。\n店內座位不算少，位置之間不會過於擁擠。\n進入店內店員會很親切的詢問是否為初次到訪，並為初訪的顧客做快速、清楚的介紹；從湯頭，肉品、麵條、軟硬度，甚至肉品的種類肥瘦都會仔細的說明過。\n當天湯頭點了口味最重的赤蝦味噌，搭配五花叉燒，麵條選了偏硬的九州細麵，還加點了唐揚雞。\n整體來說湯頭非常濃郁好喝，口味重而不油膩，比較奇怪的是為什麼湯底有吃到柚子的果肉，那應該是柚雞白肉的配料才對吧。\n肉品方面肥瘦相間，軟嫩不油膩，很好吃。\n麵條部分比較可惜，介紹時說偏硬的可以吃到麵芯的口感，但實際入口感覺有些微軟，沒有吃到麵芯的口感。\n唐揚雞肉嫩皮薄多汁，沾胡椒鹽更好吃了。\n整體來說口味很不錯，店員態度也很好，位置也是接近捷運站很方便，值得再訪。",null,[0,113]]]],[null,null,null,null,null,"https://business.google.com/local/business/4639299691065376168/customers/reviews/reply?p\u003dCkRDaTlEUVVsUl