D_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3YcHCHUoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCHQoCg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCHYoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCHcoDA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCHgoDQ",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["首先是一個或許很重要或許不重要的問題：這間是不是臺拉？個人判斷是，但在很多連正常拉麵不會顧及的地方下功夫。一間有多種吃肉選擇的拉麵店。柚雞白湯肋眼叉燒中太麵，肋眼大推，拉麵少見的吃肉體驗；麵無法調整軟硬但相當軟，個人很喜歡但喜歡偏硬的要注意；泡系的泡只有上面那層，雖然滿厚一層的，湯的柚子香氣也來自於此因此第一口最濃郁，生洋蔥不少，有口感很好，但也有一點點柚子味的混分之嫌；麵偏少。櫃檯點餐時會確認各種小配料要不要加，很讚。店裡氣氛很好，雖然人一多會有一點混亂，有不少營業用的東西直接擺在顯眼之處。餐具是隨麵附上。油煙味很重，是一進去就會聞到的程度。有充電插座，和神奇半戶外座位。",null,[0,290]]]],[null,null,null,null,null,"https://business.google.com/local/business/4639299691065376168/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhVjJSdVRteFBSMDV2VkdwT1RGcFhWbmhTVkVKWVlraEdVR0ZHUlJBQhAA",[null,null,null,"/local/business/4639299691065376168/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhVjJSdVRteFBSMDV2VkdwT1RGcFhWbmhTVkVKWVlraEdVR0ZHUlJBQhAA"],"https://business.google.com/local/business/4639299691065376168/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhVjJSdVRteFBSMDV2VkdwT1RGcFhWbmhTVkVKWVlraEdVR0ZHUlJBQhAA",[null,null,null,"/local/business/4639299691065376168/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhVjJSdVRteFBSMDV2VkdwT1RGcFhWbmhTVkVKWVlraEdVR0ZHUlJBQhAA"],null,"https://business.google.com/local/business/4639299691065376168/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhVjJSdVRteFBSMDV2VkdwT1RGcFhWbmhTVkVKWVlraEdVR0ZHUlJBQhAA",[null,null,null