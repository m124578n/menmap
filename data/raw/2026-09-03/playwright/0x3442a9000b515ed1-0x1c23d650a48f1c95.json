lient\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x1c23d650a48f1c95"]],1,null,null,null,null,null,null,["0","2027699899093425301"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2tWVGJGazVkM2hpYzJocFJVZDJUMkptZGpoSVRrRRAB"]],"CIABIhCmEG2aOC-00GpTQsLaMA7E",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3YcHCFooAA"]],1],null,null,"餐點類型",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCFkoCA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3YcHCFwoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCFsoCQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3YcHCF4oAA"]],1],null,null,"等待時間",null,"0ahUKEwiG1s3exdKWAxVEna8BHcAiGqYQ3IcHCF0oCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["🍜\u200b【捷運新埔旁的個人系職人拉麵】滝禾製麵所板橋民生店：湯頭濃郁的溫馨選擇\n🍜\u200b位於板橋民生路三段、鄰近捷運新埔站與新埔民生站的「滝禾製麵所-板橋民生店」，在繁忙的板橋幹道旁，以其日式木質調的溫馨裝潢，為過往的上班族與在地居民提供了一個舒適、愜意的用餐空間。\n🍜\u200b滝禾製麵所最大的特色在於其高度客製化的點餐模式。從湯頭、主食肉品到麵條種類（九州細麵或中太麵）都可以依個人喜好自由搭配。店內的原味豚骨與黑蒜豚骨湯頭深受好評，大火熬煮的豚骨湯底濃郁飽滿、膠質豐富，黑蒜風味則多了一股厚實的焦香與層次感；如果不習慣太厚重的口味，微辣帶點中藥香氣的鬼椒或是清爽的鹽味雞湯也是絕佳選擇。主食部分，不論是肥美柔嫩的肋眼叉燒，還是外酥內嫩的炸豬排，表現都在水準之上。\n🍜\u200b最貼心的是，這裡的價格定位相當平實，卻能享受到不輸給排隊名店的精緻度。細麵的吸湯力極佳，麵條硬度適中，搭配溏心蛋與爽脆的木耳絲，每一口都讓人感到滿足。店內環境乾淨明亮，服務人員態度親切且上菜迅速。不論是下班後想獨自享受一碗熱騰騰的拉麵安慰心靈，還是與三五好友簡單聚餐，這裡都是板橋地區兼具高CP值與好味道的拉麵優選！",null,[0,129]]]],[null,null,null,null,null,"https://business.google.com/local/business/4639299691065376168/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXVkdKR2F6VmtNMmhwWXpKb2NGSlZaREpVTWtwdFpHcG9TVlJyUlJBQhAA",[null,null,null,"/local/business/4639299691065376168/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXVkdKR2F6VmtNMmhwWXpKb2NGSl