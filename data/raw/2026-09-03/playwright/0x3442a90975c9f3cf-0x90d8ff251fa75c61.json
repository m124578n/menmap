KWAxUBma8BHYMVGeAQ3IcHCH8oFA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwizy9PGxtKWAxUBma8BHYMVGeAQ3IcHCIABKBU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwizy9PGxtKWAxUBma8BHYMVGeAQ3IcHCIEBKBY",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["🍜 鍋燒意麵\n油麵份量給很滿，吃完是很撐的飽足感。麻油薑母口味 很可以，湯頭有薑母鴨那種麻油香氣，暖暖的。裡面配蔬菜、燒肉、叉燒，整碗吃下來很滿足。\n\n🍜 麻辣牛奶湯頭拉麵\n辣度溫順，奶香跟辣感平衡得不錯，不會膩。一樣是份量給很多，拉麵口感OK，適合想吃重口味一點的人。\n\n🥢 小菜推薦\n炸黑輪必點，外酥內軟。\n豬耳朵也不錯，可以配泡菜一起吃，比較解膩。",null,[0,74]]]],[null,null,null,null,null,"https://business.google.com/local/business/7610333975394863176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvVlZOWFZuQlNNMFpLWXpKT2JFNXFVa0ppTVZJeldXeG9lbFl6WXhBQhAA",[null,null,null,"/local/business/7610333975394863176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvVlZOWFZuQlNNMFpLWXpKT2JFNXFVa0ppTVZJeldXeG9lbFl6WXhBQhAA"],"https://business.google.com/local/business/7610333975394863176/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvVlZOWFZuQlNNMFpLWXpKT2JFNXFVa0ppTVZJeldXeG9lbFl6WXhBQhAA",[null,null,null,"/local/business/7610333975394863176/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvVlZOWFZuQlNNMFpLWXpKT2JFNXFVa0ppTVZJeldXeG9lbFl6WXhBQhAA"],null,"https://business.google.com/local/business/7610333975394863176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvVlZOWFZuQlNNMFpLWXpKT2JFNXFVa0ppTVZJeldXeG9lbFl6WXhBQhAA",[null,null,null,"/local/business/7610333975394863176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRvVlZOWFZuQlNNMFpLWXpKT2JFNXFVa0ppTVZJeldXeG9lbFl6WXhBQhAA"]],[null,null,10599,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2toVVNXVnBSM0ZKYzJObE5qUkJiMVIzWWxoelYzYxAB!2m1!1s0x0:0x90d8ff251fa75c61!3m1!1s2@1:CAIQACodChtycF9oOkhUSWVpR