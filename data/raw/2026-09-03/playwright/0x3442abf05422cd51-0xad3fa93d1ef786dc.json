E_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwiShuSkvdKWAxUunq8BHTTpCEIQ3YcHCIQCKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiShuSkvdKWAxUunq8BHTTpCEIQ3IcHCIMCKBI",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiShuSkvdKWAxUunq8BHTTpCEIQ3IcHCIUCKBM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiShuSkvdKWAxUunq8BHTTpCEIQ3IcHCIYCKBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiShuSkvdKWAxUunq8BHTTpCEIQ3IcHCIcCKBU",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這是一間位在地下室的高cp值拉麵店，雖然我不是拉麵宅（請拉麵宅們不要攻擊我的不專業），但是他們的拉麵在這萬物齊長又充滿競爭的忠孝地段能有如此物美價廉的品質，實在是值得稱讚，只要消費任何一碗拉麵（180$以上）便能享受咖哩飯吃到飽。\n拉麵部分：（再次強調我不是拉麵宅請不要攻擊我）麵體舒服，不是特別帶勁的那種，但是也不至於扣分，湯頭建議可以客製蒜的量，豚骨給的蒜有一點多。\n咖哩飯：質地偏水但是味道偏濃，微微的辛辣恰到好處，確實值得180的低消，有家裡煮的感覺。\n然後是服務員：雖然這間店沒有服務費，但是有點口音的服務員非常積極的主動服務，讓我明明是在吃cp值卻有國王般的享受。\n最後，雖然這間店有五星送沙拉的活動，但是認識我的朋友就會知道：我不會被沙拉收買，以上評論絕對屬實，我跟我被免費咖哩飯填滿的胃一同保證。\n以上，我是Sam，一位追求與食物真正貼近距離的美食家。",null,[0,185]]]],[null,null,null,null,null,"https://business.google.com/local/business/468689860204350965/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZVZwSE9ESlhiR3hFWVZaU1IxSldVbEJhYTNoUVZEQmpNRTFyUlJBQhAA",[null,null,null,"/local/business/468689860204350965/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZVZwSE9ESlhiR3hFWVZaU1IxSldVbEJhYTNoUVZEQmpNRTFyUlJBQhAA"],"https://business.google.com/local/business/468689860204350965/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZVZwSE9ESlhiR3hFWVZaU1IxSldVbEJhYTNoUVZEQmpNRTFyUlJBQhAA",[null,null,null,"/local/business/468689860204350965/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZVZwSE9ESlhiR3hFWVZaU1IxSldVbEJhYTNoUVZEQmpNRTFyUlJBQhAA"],null,"https://business.google.com/local/business/468689860204350965/customers/reviews/r