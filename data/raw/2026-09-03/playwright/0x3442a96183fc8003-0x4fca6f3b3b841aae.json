ull,null,[null,null,null,[7,3]],null,null,[2025,12,17,4,null,null,null,null,["8 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhASjU4zugCp_Y_hTk15KAi_\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x4fca6f3b3b841aae"]],1,null,null,null,null,null,null,["0","5749530174484126382"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2tSaFNXdGtMWEJPVTJRMmJuWkdlRVpNTjJGbVlVRRAB"]],"CIABIhASjU4zugCp_Y_hTk15KAi_",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjOv5-ku9KWAxUnla8BHZJiDGkQ3YcHCNcBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjOv5-ku9KWAxUnla8BHZJiDGkQ3IcHCNYBKBE",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjOv5-ku9KWAxUnla8BHZJiDGkQ3IcHCNgBKBI",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjOv5-ku9KWAxUnla8BHZJiDGkQ3IcHCNkBKBM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjOv5-ku9KWAxUnla8BHZJiDGkQ3IcHCNoBKBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwjOv5-ku9KWAxUnla8BHZJiDGkQ3YcHCNwBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjOv5-ku9KWAxUnla8BHZJiDGkQ3IcHCNsBKBU",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["(限定）香菜拌麵$300+美乃滋$20+叉燒$70+午間優惠(唐揚雞）$50\n\n香菜まぜそばNT$300\nマヨネーズNT$20\nチャーシューNT$70\nランチ限定（唐揚げ）NT$50\n\n（歡迎ig搜尋全麵啟動，探索更多拉麵和麵食！）\n\n🍜【食記】麵屋輝｜綠油油的冬日限定！12月拌麵限定？！麵屋輝 香菜拌麵🍃\n\n這間店叫做 「麵屋輝」，來自大阪，是一家以魚介豚骨拉麵與沾麵聞名的老字號拉麵品牌。主打自家手工製作的Q彈麵條，及無化學添加、濃厚卻不死鹹的湯頭。早在 2012 年，就將第一家海外分店開在台北松江南京。\n\n這次繼上次推出吸睛度滿滿、湯頭「黑嚕嚕」的 墨魚冷麵之後，又再度端出視覺反差極大的 「綠油油香菜拌麵」 🌿。\n雖然本人不到香菜控，但也不排斥，下班後就決定來收收這碗話題感滿滿的限定拌麵。\n\n🧍\u200d♂️ 排隊狀況\n\n13:15 到達，店內約三組客人，整體人潮普通，不需要久等，掃碼點餐，流程順暢。\n\n🥣 醬汁表現\n\n拌麵一上桌，份量比個人預期還要大很多。\n整體醬汁應該是 醬油為基底，混合微微檸香的清爽型醬汁，走的是輕盈路線。不過以拌麵來說，個人覺得醬底風味稍微偏淡。\n\n但沒關係，因為我有 加點加價美乃滋（$20） \u2028而且給的量真的超多！\n美乃滋的奶香、酸甜與鹹香拌入後，整體風味立刻升級，罪惡感瞬間爆表 ，卻又和底下原本的清爽醬汁形成一個個人覺得蠻平衡的搭配。\n\n⚠️個人小建議：\n👉 不要一次把美乃滋 all in，會有點蓋過香菜的氣息。\n👉 建議「分段式加入」，吃起來層次更好，也更美味。\n👉 吃到後段味道稍微單一時，非常推薦加點 蒜泥 和 桌上辣油 🌶️，會是另一種味覺被喚醒的感覺 😚。\n\n🌾麵條表現\n\n麵條一直是 「麵屋輝」引以為傲的招牌。\n店門口就能看到製麵機，主打自家製麵，這次使用的麵條和定番沾麵相同，都是Q彈粗麵。\n\n這次拌麵是以 熱麵 供應，不確定是否能更換冷麵，現場也沒有看到客製化選項。\n整體口感非常帶勁，個人覺得比不少外面的沾麵店還要 Q、有彈性，延續麵屋輝一貫的高水準。\n\n比較可惜的是，因為香菜與肉燥的味道較為強烈，麵條本身的麥香被稍微壓掉了。\n不過單就口感來說，真的還是很棒 👍。\n\n🐷🍃 🦐配料一覽\n\n大量香菜、溫泉蛋、絞肉、碎叉燒、蝦仁、花生碎、辣椒絲、（額外加點：叉燒 $70）\n\n🌿 香菜\n\n給的量不少，也可加價升級更多。\u2028但以個人可以接受香菜的程度來說，香菜風味其實沒有想像中那麼強烈。\n\n🐷叉燒 / 叉燒碎\n\n原本附的 叉燒碎口感偏硬、調味不會過鹹，和麵屋輝的叉燒飯一樣，整體偏乾一點，稍稍可惜。\n\n額外加點 叉燒 $70以份量來說，個人覺得有點小小偏貴，但口感明顯比碎塊好咬許多，也比較有肉汁，表現還不錯。\n\n🍲 附湯\n\n附的是 豆腐湯。\n整體湯頭偏淡口，個人覺得如果能再鹹一點會更好。不過作為附湯，解拌麵的乾燥感，還算 OK 啦。\n\n🍗額外加點 午間優惠 $50（唐揚雞）\n\n唐揚雞 兩大塊，尺寸比一般常見的還要大一些。\n整體風味上跟 「特濃屋」的唐揚雞很像，外皮都是那種有點市場炸雞感的炸皮，一咬下去會流出肉汁，雞肉本身也很嫩 🤤。\n可惜沒有附檸檬，不過沾上剛剛加點的美乃滋，真的又肥又好吃或是直接丟進拌麵裡當配料，也非常加分。\n\n如果有點這碗香菜拌麵，個人蠻推薦一定要搭配炸雞一起吃 🍗✨。\n\n📌 總結\n\n光是品名 「香菜拌麵」 就已經夠獨特了，而且在 12 月、氣溫驟降的時候，還推出拌麵限定，本身就蠻有話題性。\n\n整體呈現完全符合品名，就是一碗穩定、不錯吃的限定拌麵，沒有太多讓人意想不到的驚喜，但也不會踩雷，以 $300 元 的價格來說，這個份量再加上一碗豆腐湯，算是可以嚐鮮的價位。\n另外 非常推薦加購美乃滋 $20，拌起來風味會豐富許多，也比較不單一、味道更足。\n\n如果想補充蛋白質，或是 午間時段前往，真的務必一定要再來一份 唐揚雞，整體滿足感會直接拉滿 😋。\n\n#限定拉麵 #定番#台灣#日本#台灣美食#日本美食#foodie#ramen#雙北美食#拉麵\n#2025 #台北拉麵#日本拉麵#台北拉麵推薦\n#日本拉麵推薦#特色拉麵#拉麵推薦#台灣拉麵\n#台灣拉麵推薦#台灣拉麵愛好會\n#台灣拉麵金賞#限定#拉麵控#台灣拉麵地圖\n#台北美食推薦",null,[0,52]]]],[null,null,null,null,null,"https://business.google.com/local/business/17775874222010594326/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTYUZOWGRHdE1XRUpQVlRKUk1tSnVXa2RsUlZwTlRqSkdiVmxWUlJBQhAA",[null,null,null,"/local/business/17775874222010594326/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTYUZOWGRHdE1XRUpQVlRKUk1tSnVXa2RsUlZwTlRqSkdiVmxWUlJBQhAA"],"https://business.google.com/local/business/17775874222010594326/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTYUZOWGRHdE1XRUpQVlRKUk1tSnVXa2RsUlZwTlRqSkdiVmxWUlJBQhAA",[null,null,null,