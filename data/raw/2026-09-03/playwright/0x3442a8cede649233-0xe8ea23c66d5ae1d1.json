rt?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfSGNzdnlReUNxamlRM2cwY044MVdtQQ%7CCAEQrcz1_gkiLwoZQ0hfSGNzdnlReUNxamlRM2cwY044MVdtQRoSQ2dzSTZyckt6QVlRdGNHeFpR\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ_2MI0QEoBw"],"https://business.google.com/local/business/15044688044154004129/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTVZkRk5YSlZTRXBJWVZaa1NtUXlXbWxSTTJ4NVRXcFdkbU16WXhBQhAA",[null,null,null,"/local/business/15044688044154004129/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTVZkRk5YSlZTRXBJWVZaa1NtUXlXbWxSTTJ4NVRXcFdkbU16WXhBQhAA"],"https://business.google.com/local/business/15044688044154004129/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTVZkRk5YSlZTRXBJWVZaa1NtUXlXbWxSTTJ4NVRXcFdkbU16WXhBQhAA",[null,null,null,"/local/business/15044688044154004129/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTVZkRk5YSlZTRXBJWVZaa1NtUXlXbWxSTTJ4NVRXcFdkbU16WXhBQhAA"],null,"https://business.google.com/local/business/15044688044154004129/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTVZkRk5YSlZTRXBJWVZaa1NtUXlXbWxSTTJ4NVRXcFdkbU16WXhBQhAA",[null,null,null,"/local/business/15044688044154004129/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLTVZkRk5YSlZTRXBJWVZaa1NtUXlXbWxSTTJ4NVRXcFdkbU16WXhBQhAA"],null,["zh-Hant"],[["林咩咩感謝分享評論，\n我們會持續努力，\n為每位顧客提供最優質的日式壽喜燒鍋物，\n並致力於提供道地的桌邊服務和舒適的用餐環境，\n期待您再次光臨。",null,[0,39]]]],[null,null,6658,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xKMVdFNXJVSEpIYVZkSmQyWmlRM2x5TWpWdmMzYxAB!2m1!1s0x0:0xe8ea23c66d5ae1d1!3m1!1s2@1:CAIQACodChtycF9oOlJ1WE5rUHJHaVdJd2ZiQ3lyMjVvc3c%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xKMVdFNXJVSEpIYVZkSmQyWmlRM2x5TWpWdmMzYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xKMVdFNXJVSEpIYVZkSmQyWmlRM