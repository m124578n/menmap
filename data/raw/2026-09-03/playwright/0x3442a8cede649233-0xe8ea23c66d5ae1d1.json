DED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ3YcHCH0oAA"]],1],null,null,"餐點類型",null,"0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ3IcHCHwoFw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_600_TO_800"],"$600-800",2,null,"$600 到 $800","0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ3YcHCH8oAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ3IcHCH4oGA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ3IcHCIABKBk",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ3IcHCIEBKBo",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ3IcHCIIBKBs",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ3YcHCIQBKAA"]]],null,"用餐人數",null,"0ahUKEwiS0PPkzNKWAxUngq8BHbqnLEkQ3IcHCIMBKBw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["2025/09/28到訪，都是連鎖的沒什麼差異性，\n\n🍴美食部分：假日一個人599另+10%。MOMO壽喜燒的調味是永遠的愛，味道足不死鹹，但肉品只愛一款，以下就吃到的餐點做主觀評論：\n➊肉品🥩：有澳洲低脂牛肩胛肉、美國上選牛胸肉🐮、國產梅花豬肉、國產里肌豬肉🐷、雞胸肉🐔。其中最愛❤的肉是美國上選牛胸肉，肉質軟嫩油香足；其他肉油脂比教少，需要咀嚼比較久。\n➋菜品🥬：推薦波菜、高麗菜、腐皮、蒟蒻、海帶芽也不錯，不過加進去後味道會變重，請依個人口味嘗試。大推年糕！年糕經過湯底的浸泡，飽滿又Q彈，超愛！\n➌主食🍚：有白飯、胚芽米飯、烏龍麵，烏龍麵吸滿醬汁後香氣100分，不要煮太久，否則會失去麵條的彈性~\n➍甜點☕(晚上/假日限定)：紅豆紫米粥，超級好喝，甜而不膩，可以清口腔的肉味。建議自己加冰塊，才不會燙舌頭。\n\n📣晚上/假日才有甜點\n📣用餐限制90分鐘，需另+10%服務費\n📣熱冷飲料機自助\n\n🏡環境：桌子不黏擦得很乾淨，光線明亮，桌與桌距離是令人舒適的，兩人坐4人位剛好。\n💁服務：詢問/索取東西時給得很快，菜車/菜盤來得很勤，巡場人員看到空盤會馬上進行清理，讓桌面空間維持，遇到的人員態度都很親切，辛苦了。\n\n結論：永遠愛壽喜燒",null,[0,92]]]],[null,1769585917000000,1769585917000000,"7 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQ2thQU5vaTAwMjZjaGVNYUxoZTFMUQ%7CCAEQrcz1_gkiMAoZQ0hfQ2thQU5vaTAwMjZjaGVNYUxoZTFMURoTQ2d3S