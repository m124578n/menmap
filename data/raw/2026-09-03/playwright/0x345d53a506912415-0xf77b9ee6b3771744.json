ull,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjIs8may9KWAxWdkq8BHbI2MOgQ3IcHCLABKBU",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjIs8may9KWAxWdkq8BHbI2MOgQ3IcHCLEBKBY",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["先說結論：#店內裝潢日式風格，許多可愛招財貓😺\n#拉麵看起來不錯，吃起來還好\n#座位區主要在二樓↗️\n點餐時段：週四12：00\n候位時間：0！（滿座率30%）\n等餐時間：8分鐘\n可支付方式：現金\n\n以下為此次點餐的品項及價格🔻\n🔺豚骨拉麵+唐揚雞 $180\n一般口味的豚骨湯頭不濃郁，唐揚雞炸的外酥內軟還不錯吃\n🔺濃口豚骨拉麵 $160\n其實也沒有很濃郁只是比較油，叉燒*2+海帶芽+玉米+大片海苔+半顆糖心蛋，糖心蛋是很好吃的那種💛，配料都滿台式的，叉燒偏薄偏小片，麵體偏軟爛可惜了，份量夠吃得很飽！\n🔺辛口豚骨拉麵 $140\n不會很辣，辣沒有融入在湯頭感覺是後來才加的，偏泡麵湯味\n🔺煙燻豬耳朵 $35\n肥油居多，味道說不出來的怪\n🔺蔬菜可樂餅 $50👍🏼\n薯泥味道濃郁口感綿密，內有三色豆我很喜歡🤩，炸的剛好酥脆\n🔺渡月橋酥皮炸豆腐 $50\n一份5塊炸雞蛋豆腐，味道一般\n\n自助區有水、餐具、面紙自取，但那個水杯是用不會破的那種橡膠，喝起來有股沒洗乾淨的味道😧",null,[0,50]]]],[null,null,null,null,null,"https://business.google.com/local/business/13462699633211354516/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldhRnBtZFdKUkVBRRAA",[null,null,null,"/local/business/13462699633211354516/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldhRnBtZFdKUkVBRRAA"],"https://business.google.com/local/business/13462699633211354516/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldhRnBtZFdKUkVBRRAA",[null,null,null,"/local/business/13462699633211354516/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldhRnBtZFdKUkVBRRAA"],null,"https://business.google.com/local/business/13462699633211354516/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldhRnBtZFdKUkVBRRAA",[null,null,null,"/local/business/13462699633211354516/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUldhRnBtZFdKUkVBRRAA"]],[null,null,15204,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSURWaFpmdWJREAE!2m1!1s0x0:0xf77b9ee6b3771744!3m1!1s2@1:CIHM0ogKEICAgIDVhZfubQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap