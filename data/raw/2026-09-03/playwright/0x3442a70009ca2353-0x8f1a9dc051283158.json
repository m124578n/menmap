],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:RESERVATIONS_NOT_REQUIRED"],"不需要訂位",2,null,null,"0ahUKEwjHuN3CwdKWAxVfk68BHX07Fs4Q3YcHCJABKAA"]],1],null,null,"預訂網址",null,"0ahUKEwjHuN3CwdKWAxVfk68BHX07Fs4Q3IcHCI8BKAY",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwjHuN3CwdKWAxVfk68BHX07Fs4Q3YcHCJIBKAA"]]],null,"用餐人數",null,"0ahUKEwjHuN3CwdKWAxVfk68BHX07Fs4Q3IcHCJEBKAc",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjHuN3CwdKWAxVfk68BHX07Fs4Q3YcHCJQBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjHuN3CwdKWAxVfk68BHX07Fs4Q3IcHCJMBKAg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["看了好評好像都是之前的豚骨湯頭，應該也跟店名貼合，但是今天來的時候，本月限定是雞白湯200$、雞清湯180$。\n\n店員介紹非常清楚，先選湯頭、口味可選鹽味、醬油、麻辣、咖喱和味增；再來可選三種麵條，我選中間細麵，配置就沒有增加先吃看看。\n\n原本只是吃個午餐沒想評論，但是吃完感想不太好，也油也空虛。\n\n叉燒肉一分為二，兩個半片沒有比較好，沒有肉香。\n\n麵條普通，湯頭已經是雞清湯了還是偏油、鹹，喝了卡喉嚨，讓我想起熊O岳不愉快的體驗，吃完沒多久也因為太油想拉肚子。\n\n湯頭沒調整鹹淡，但是吃完麵條之後就不會想多喝，其他配置溏心蛋普通，紫洋蔥沒什麼好評，高麗菜、豆芽菜香氣不錯。\n\n整體吃完非常空虛，兩小時之後就餓了，去吃別的安慰一下。",null,[0,118]]]],[null,null,null,null,null,"https://business.google.com/local/business/2208548511602298144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVZveWREVk5NV2hMVXpOU01tTXdNVTVoVjFWMFRVUmFTR05yUlJBQhAA",[null,null,null,"/local/business/2208548511602298144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVZveWREVk5NV2hMVXpOU01tTXdNVTVoVjFWMFRVUmFTR05yUlJBQhAA"],"https://business.google.com/local/business/2208548511602298144/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVZveWREVk5NV2hMVXpOU01tTXdNVTVoVjFWMFRVUmFTR05yUlJBQhAA",[null,null,null,"/local/business/2208548511602298144/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVZveWREVk5NV2hMVXpOU01tTXdNVTVoVjFWMFRVUmFTR05yUlJBQhAA"],null,"https://business.google.com/local/business/220854851160229