IT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi1rfCdvdKWAxXIavUHHVqHA3wQ3YcHCH0oAA"]],1],null,null,"等待時間",null,"0ahUKEwi1rfCdvdKWAxXIavUHHVqHA3wQ3IcHCHwoCw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwi1rfCdvdKWAxXIavUHHVqHA3wQ3YcHCH8oAA"]]],null,"座位類型",null,"0ahUKEwi1rfCdvdKWAxXIavUHHVqHA3wQ3IcHCH4oDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["來朝聖小有名氣的辣麻味增拉麵，辣度、麻度都可以選擇，不喜歡吃太辣的建議選少麻少辣。\n\n第一口湯喝下去覺得口味超重，但有股莫名的魔力讓人忍不住一口接著一口，吃到後來湯也被我喝到見底。\n\n從麵條、湯頭、爌肉、蛋、配菜的組合，是碗很暴力重口味的拉麵，吃完後會有大大的滿足感。",null,[0,90]]]],[],[null,null,9839,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2prNVJHczVkMjlpVEhwVVNqRjFXSE5uT0dWc1JsRRAB!2m1!1s0x0:0xa2c54424c7bf3e82!3m1!1s2@1:CAIQACodChtycF9oOjk5RGs5d29iTHpUSjF1WHNnOGVsRlE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2prNVJHczVkMjlpVEhwVVNqRjFXSE5uT0dWc1JsRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2prNVJHczVkMjlpVEhwVVNqRjFXSE5uT0dWc1JsRRI-Ci9DQUlRQUNvZENodHljRjlvT2prNVJHczVkMjlpVEhwVVNqRjFXSE5uT0dWc1JsRRILMGRkakFQTHpkdWQaPgovQ0FJUUFDb2RDaHR5Y0Y5b09qazVSR3M1ZDI5aVRIcFVTakYxV0hObk9HVnNSbEUSCzBkZGpBUEx6ZHVkIhIJAAAAAAAAAAARgj6_xyRExaIqCzBkZGpBUEx6ZHVk\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi1rfCdvdKWAxXIavUHHVqHA3wQoykIgAEoDQ"],null,[null,[[1,0]]]],"0ahUKEwjAwvudvdKWAxWyeV4EHV0vPP8Q0pMFCCYoAg"],null,null,null,"0ahUKEwi1rfCdvdKWAxXIavUHHVqHA3wQ0pMFCGkoAg"],[["Ci9DQUlRQUNvZENodHljRjlvT2w5V1RUWnZSV05hTmxKaVZFeFlXWE5aYldjd1MzYxAB",["0x0:0xa2c54424c7bf3e82",null,1774048171269690,1774048171269690,[null,null,["https://www.google.com/maps/contrib/113169214245516436674/reviews?hl\u003dzh-TW"],null,null,["How","https://lh3.googleusercontent.com/a-/ALV-UjWTnCoJH-HdOR10yjxLtxOo0Hur4mN302tqROXBMcNq9qxOb3ZezA\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps