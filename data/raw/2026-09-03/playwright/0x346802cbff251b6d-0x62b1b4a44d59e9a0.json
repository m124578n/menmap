_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3IcHCOoBKAw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3IcHCOsBKA0",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11fk5flk65"],"特濃招牌豚骨拉麵",2,null,null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3YcHCO0BKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3IcHCOwBKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_SOMEWHAT_DIFFICULT_TO_FIND"],"停車位有點難找",2,null,null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3YcHCO8BKAA"]],1],null,null,"停車位",null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3IcHCO4BKA8",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_FREE_STREET_PARKING"],"免費路邊停車",2,null,null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3YcHCPEBKAA"]]],null,"附近的停車場",null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3IcHCPABKBA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3IcHCPIBKBE",null,null,["路邊不算好停，要找一下（騎車比較方便）"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3YcHCPQBKAA"]]],null,null,null,"0ahUKEwi346iPzNKWAxXDnq8BHRAFIEgQ3IcHCPMBKBI",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["想念日本拉麵，初次造訪～\n\n豚將這裡提供的湯頭蠻濃郁、好喝！！\n而且重點用餐還有提供續麵耶～ 難怪生意這麼好\n（注意⚠️假日是沒有提供續麵的服務唷～ 要另外收費）\n\n一碗拉麵的份量，算是剛好～\n但是男生來說，可以續2-3球麵（覺得算是正常的）\n\n店裡另外有提供開水、冬瓜茶（很棒）\n\n咖喱可樂餅～咖喱很夠味，可樂餅炸的夠酥\n（是我吃過少數真的好吃、推薦的可樂餅）\n\n酥皮豆腐～這個酥皮真的是夠酥，這樣口感的酥皮豆腐也是第一次吃（一份六塊）\n\n這裡生意這麼好，真的完全不意外～ 好吃😋",null,[0,31]]]],[null,1729213980000000,1729213980000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQkY1WHA4NGduVGhuRWJZY0FBd3JuQQ%7CCAEQrcz1_