null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT213MVIweEhUalJZYzJSVFlrVmphSE5xU1c1clNFRRAB"]],"CIABIhBM_RXtwDz2ZVVSNLkPYQ41",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjykYS6vdKWAxXOgK8BHWJ6C0wQ3IcHCPMBKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjykYS6vdKWAxXOgK8BHWJ6C0wQ3IcHCPQBKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjykYS6vdKWAxXOgK8BHWJ6C0wQ3IcHCPUBKAs",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這間拉麵店是離我住家走路可到的位置，不過附近車位比較難找尋，需要找路邊停車位，或者Times收費停車場。\n先說說裝潢，我覺得很有日本小店的感覺，位置不多，但面對窗台、吧檯的座位滿溫馨的。店家引入機器購票算是方便，不用經手現金也算節省人力跟乾淨。工作人員非常親切，我們是最後一組客人，快休息時間我們才到，也不會催促我們，感覺非常舒服！\n他們家的湯頭可以依照不同喜好，能選擇清淡或較鹹，不管是喜歡偏或偏淡口味的老饕都很適合，我個人認為麵條偏Q彈，不過另外也可以選擇偏硬、適中及偏軟。\n再來是燒肉，我認為燒肉很道地入味，無論是拉麵的燒肉或燒肉飯的燒肉角，都很柔軟、入味。我很喜歡他們家的燒肉，推薦大家一定要來試試。每碗附上的水蓮菜份量不少，而且意外的有味道，不是燙一燙充數的哪種，我覺得很加分！\n值得一提的是，每碗拉麵可以免費加一球麵條，我真的吃得很飽!",null,[0,166]]]],[null,null,null,null,null,"https://business.google.com/local/business/5385427298167968262/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEzTVZJd2VFaFVhbEpaWXpKU1ZGbHJWbXBoU0U1eFUxYzFjbE5GUlJBQhAA",[null,null,null,"/local/business/5385427298167968262/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEzTVZJd2VFaFVhbEpaWXpKU1ZGbHJWbXBoU0U1eFUxYzFjbE5GUlJBQhAA"],"https://business.google.com/local/business/5385427298167968262/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEzTVZJd2VFaFVhbEpaWXpKU1ZGbHJWbXBoU0U1eFUxYzFjbE5GUlJBQhAA",[null,null,null,"/local/business/5385427298167968262/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEzTVZJd2VFaFVhbEpaWXpKU1ZGbHJWbXBoU0U1eFUxYzFjbE5GUlJBQhAA"],null,"https://business.google.com/local/business/5385427298167968262/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEzTVZJd2VFaFVhbEpaWX