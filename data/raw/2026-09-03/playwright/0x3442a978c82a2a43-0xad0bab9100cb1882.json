[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjKzqGPu9KWAxV7nK8BHXJtEi8Q3IcHCMQBKAM",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjKzqGPu9KWAxV7nK8BHXJtEi8Q3IcHCMUBKAQ",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjKzqGPu9KWAxV7nK8BHXJtEi8Q3IcHCMYBKAU",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["5/4 晚上用餐，\n想吃很久了！餐點還不錯，除了拉麵，還點了飯和肉片拼盤的加點\n以下兩件事情\n1. 協助入座/點餐的小姐態度超差，\n2個人點了2碗一樣口味的麵，還在看要加點什麼，結果那位員工用一個非常差的態度（很像我欠他錢一樣）說：一個人低消一碗麵喔！\n當下傻住，想說上面不是寫著「2」嗎？\n\n2. 人員衛生習慣待加強，在用餐的時候，眼睜睜看著煮麵區與櫃檯兩位，直接徒手捏著一碗不知道是啥的東西在吃，吃完也不洗手，繼續做餐和服務客人，要聊天口罩也不戴好",null,[0,46]]]],[null,null,null,null,null,"https://business.google.com/local/business/8315208008286576307/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRKTW1KR09VOVphMUpoVW01V1ZVeFhjRzFrVkVKbVUxZE9hMDV1WXhBQhAA",[null,null,null,"/local/business/8315208008286576307/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRKTW1KR09VOVphMUpoVW01V1ZVeFhjRzFrVkVKbVUxZE9hMDV1WXhBQhAA"],"https://business.google.com/local/business/8315208008286576307/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRKTW1KR09VOVphMUpoVW01V1ZVeFhjRzFrVkVKbVUxZE9hMDV1WXhBQhAA",[null,null,null,"/local/business/8315208008286576307/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRKTW1KR09VOVphMUpoVW01V1ZVeFhjRzFrVkVKbVUxZE9hMDV1WXhBQhAA"],null,"https://business.google.com/local/business/8315208008286576307/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRKTW1KR09VOVphMUpoVW01V1ZVeFhjRzFrVkVKbVUxZE9hMDV1WXhBQhAA",[null,null,null,"/local/business/8315208008286576307/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRKTW1KR09VOVphMUpoVW01V1ZVeFhjRzFrVkVKbVUxZE9hMDV1WXhBQhAA"]],[null,null,2399,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUl