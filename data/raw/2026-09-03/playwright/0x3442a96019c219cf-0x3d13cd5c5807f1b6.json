消費金額",null,"0ahUKEwievcGhvdKWAxVjm68BHfx3OGAQ3IcHCIYCKAg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwievcGhvdKWAxVjm68BHfx3OGAQ3IcHCIgCKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwievcGhvdKWAxVjm68BHfx3OGAQ3IcHCIkCKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwievcGhvdKWAxVjm68BHfx3OGAQ3IcHCIoCKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwievcGhvdKWAxVjm68BHfx3OGAQ3YcHCIwCKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwievcGhvdKWAxVjm68BHfx3OGAQ3YcHCI0CKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwievcGhvdKWAxVjm68BHfx3OGAQ3YcHCI4CKAI"]]],null,"用餐人數",null,"0ahUKEwievcGhvdKWAxVjm68BHfx3OGAQ3IcHCIsCKAw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["沒想到有那麼好吃的素食拉麵，愛了😍\n用餐環境很舒適，很有日本拉麵店的氣氛。\n店員很友善也很熱心地詢問是否需要介紹餐點、看我第一次來還確認口味是否習慣（因為湯頭濃度可以做調整），距離也抓得剛好不會太頻繁打擾。\n\n可以用QR點餐、線上支付，非常方便。\n出餐很快速。\n點了招牌的番茄拉麵，湯頭真的很濃郁，喝起來是用蔬菜慢慢熬煮的喝完不會口乾舌燥。\n麵條是細麵，點餐時可以客製調整軟硬度（以及蔥、蛋、菇類等是否要調整）選了硬的口感，實際吃了也是我喜歡的，煮得很剛好～\n配料很豐盛，有溏心蛋、好吃的脆脆木耳、一小塊可愛的紅蘿蔔、杏包菇、香菇、青江菜、豆腐、海苔。\n\n是美味又健康的一餐，會想回訪嘗試其他口味。\n謝謝你們經營這麼美味的素食餐廳。",null,[0,103]]]],[null,null,null,null,null,"https://business.google.com/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1Y1dSc1ZsTlhSVGg0V2xST1lXSnRjSE5pYWtaVlVrWlNhMkpWUlJBQhAA",[null,null,null,"/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1Y1dSc1ZsTlhSVGg0V2xST1lXSnRjSE5pYWtaVlVrWlNhMkpWUlJBQhAA"],"https://business.google.com/local/business/15943577517523358854/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1Y1dSc1ZsTlhSVGg0V2xST1lXSnRjSE5pYWtaVlVrWlNhMkpWUlJBQhAA",[null,null,null,"/lo