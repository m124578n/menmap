,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjG--mBwtKWAxVAkq8BHRlVILIQ3IcHCJkBKAY",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjG--mBwtKWAxVAkq8BHRlVILIQ3IcHCJoBKAc",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjG--mBwtKWAxVAkq8BHRlVILIQ3IcHCJsBKAg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjG--mBwtKWAxVAkq8BHRlVILIQ3YcHCJ0BKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjG--mBwtKWAxVAkq8BHRlVILIQ3IcHCJwBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwjG--mBwtKWAxVAkq8BHRlVILIQ3YcHCJ8BKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjG--mBwtKWAxVAkq8BHRlVILIQ3YcHCKABKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwjG--mBwtKWAxVAkq8BHRlVILIQ3YcHCKEBKAI"]]],null,"用餐人數",null,"0ahUKEwjG--mBwtKWAxVAkq8BHRlVILIQ3IcHCJ4BKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["唐揚雞拉麵 180\n假設沒有套餐價，唐揚雞 95、拉麵 85\n\n[拉麵]\n湯頭：明顯不是花時間熬的，只是弄得白濁白濁的，但本身根本沒啥味道\n麵體：普通至極，沒什麼嚼勁或吸附力\n配料：只有溏心蛋。沒有豆芽、木耳絲、筍乾、海苔片、叉燒，空無一物。\n\n簡單來說就是湯、麵、蛋，然後收85元🤷\u200d♂️\n1分，非常糟\n\n[唐揚雞]\n還行，調味沒問題，只是炸到黑了\n但這個品質絕對不值95元\n2.5分\n\n[調料]\n絕對是批發品。那個辣椒醬我在全聯買過\n\n[環境]\n開放式廚房，廚具本身是相當乾淨的，但可以發現壁癌和後面生鏽的鐵窗\n餐具要自己回收，廚餘要自己倒但又沒加蓋，所以有點噁\n內外場動線非常不順，基本上外場沒有服務人員\n\n[人員]\n態度沒問題\n裡面有兩位長輩在協助，但似乎沒有受過培訓，好像沒有很熟工作的樣子（畢竟是開放式廚房，所以場內的互動其實都聽得到）\n\n[結論]\n就算是以台式拉麵來講也是偏爛，其他台式拉麵還會努力加青菜加麵，營造出一種俗又大碗的氣氛。\n這間嘛⋯CP值太糟了🙂",null,[0,30]]]],[],[null,null,5162,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2toc1NEbE5OVXQwWnpWRk9FczJhM0ZXUVRVMU5GRRAB!2m1!1s0x0:0x8a949f044b004f88!3m1!1s2@1:CAIQACodChtycF9oOkhsSDlNNUt0ZzVFOEs2a3FWQTU1NFE%7C%7C?hl\u003dzh-TW"],["https://www.google.