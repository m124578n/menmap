CP4BKBU",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3YcHCIECKAA"]],1],null,null,"等待時間",null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3IcHCIACKBY",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["在商場裡能找到一間這麼穩定水準的日式餐廳真的很不錯。YAYOI彌生軒的用餐環境一貫的整潔明亮，木質裝潢與柔和燈光讓人感覺很放鬆。服務人員態度親切、上菜速度也快。\n\n這次點了味增豬排定食，配上熱騰騰的白飯和味噌湯剛剛好。小菜份量不多但精緻，整體味道清爽不膩。值得一提的是他們的白飯及湯可以續碗，對食量大的人來說非常加分。\n\n不管是看電影前後來用餐，或是假日想簡單吃一頓有品質的日式料理，這裡都是很不錯的選擇。價格雖略高但對得起食材與服務，推薦給喜歡日式定食的朋友。",null,[0,80]]]],[null,null,null,null,null,"https://business.google.com/local/business/18390197419965141574/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwY1ZrelJtbE1WemxwVm5wYVEyTllhSEJaYTNoSVYxYzVWV0pWUlJBQhAA",[null,null,null,"/local/business/18390197419965141574/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwY1ZrelJtbE1WemxwVm5wYVEyTllhSEJaYTNoSVYxYzVWV0pWUlJBQhAA"],"https://business.google.com/local/business/18390197419965141574/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwY1ZrelJtbE1WemxwVm5wYVEyTllhSEJaYTNoSVYxYzVWV0pWUlJBQhAA",[null,null,null,"/local/business/18390197419965141574/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwY1ZrelJtbE1WemxwVm5wYVEyTllhSEJaYTNoSVYxYzVWV0pWUlJBQhAA"],null,"https://business.google.com/local/business/18390197419965141574/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwY1ZrelJtbE1WemxwVm5wYVEyTllhSEJaYTNoSVYxYzVWV0pWUlJBQhAA",[null,null,null,"/local/business/18390197419965141574/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwY1ZrelJtbE1WemxwVm5wYVEyTllhSEJaYTNoSVYxYzVWV0pWUlJBQhAA"]],[null,null,8120,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT210cVkzRmlMVzlpVnpaQ2NYaHBZa3hIV1c5VWJVRRAB!2m1!1s0x0:0x68d7fc7947553eb9!3m1!1s2@1:CAIQACodChtycF9oOmtqY3FiLW