yxtDmsPS7qNfWEOvpwNYYigGE0zUj5glXvYyLEnQiXwOQhzxWp5oodQrynVw"]]],[["鮮鮭玉子雜炊和壽喜豆腐牛定食","和風鰹魚高湯加入雞蛋、鮭魚、米飯烹煮而成，搭配醬燒五花牛及豆腐。※牛肉為美國、紐西蘭、澳洲產。※加收10%服務費。※實際餐點內容可能依食材供應狀況有所變更，敬請見諒。"],["$420.00"],null,null,null,[["https://lh3.googleusercontent.com/geofoodgmb/ABR6o-FMBh0TgJaHYjsSfy8Xl2NouUFVofrCftceJZrqECsSBzXifexZV97VzmfXiVVNoAapRoxX5QeXpzHR5FyFXiPXZQ"]]],[["南蠻炸雞定食","源自日本九州宮崎縣的特色料理。現炸多汁雞腿肉、淋上酸甜南蠻醬與特調塔塔醬，滋味豐富。※雞肉為台灣產。※實際餐點內容可能依食材供應狀況有所變更，敬請見諒。"],["$340.00"],null,null,null,[["https://lh3.googleusercontent.com/geofoodgmb/ABR6o-FxMCseO7kqRLPS8M0ZAvjN-534tKEy8p0_KLdGnK5vJUxfeIkHLHCckCswrx2psJ-_ztzCkZa36rpGjfTTj6nIxw"]]],[["和風寄世養身鍋定食","溫潤鰹魚昆布湯頭搭配豐富食材，療癒鍋物首選。※豬肉為臺灣、荷蘭產、雞肉為臺灣產※實際餐點內容可能依食材供應狀況有所變更，敬請見諒。"],["$470.00"],null,null,null,[["https://lh3.googleusercontent.com/geofoodgmb/ABR6o-F7IobgMcmSpa0hZQ-JhWuaNV9DrmD9Zr2wmLOjCEV-6aVjYGbhTPfZJmlkqsg_4ypPCj7J4ag4gCkEPJ0JctNgNg"]]]]]]],[1],["菜單",""],1]]],null,null,null,null,0,null,null,null,[[[["秀泰生活樹林店","0x34681d40b4644207:0xc56c9ad76de14054",null,null,null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQg7cGCPgCKDQ"]],1,1]],null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,[[[["/m/0bh9flk"],"平板",null,[null,null,null,null,22,65,62],"CgwKCi9tLzBiaDlmbGs\u003d","0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ1bMECJwDKD8",null,null,null,[[2]]],[["/m/0c1kfk"],"鰻魚",null,[null,null,null,null,18,0,70],null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ1bMECJ0DKEA",null,null,null,[[2]]],[["/m/05hc9_"],"豬排",null,[null,null,null,null,16,0,16],"CgsKCS9tLzA1aGM5Xw\u003d\u003d","0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ1bMECJ4DKEE",null,null,null,[[2]]],[["/m/08fyx1"],"茶碗蒸",null,[null,null,null,null,16,33,38],"CgsKCS9tLzA4Znl4MQ\u003d\u003d","0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ1bMECJ8DKEI",null,null,null,[[2]]],[["/m/0b4rl8"],"炸蝦",null,[null,null,null,null,13,43,41],"CgsKCS9tLzBiNHJsOA\u003d\u003d","0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ1bMECKADKEM",null,null,null,[[2]]],[["/g/11dxb1582b"],"醃蘿蔔",null,[null,null,null,null,9,0,9],null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ1bME