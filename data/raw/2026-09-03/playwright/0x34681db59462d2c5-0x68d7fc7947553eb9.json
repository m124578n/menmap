ll,null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3YcHCGQoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3IcHCGMoDQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3YcHCGYoAA"]],1],null,null,"等待時間",null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3IcHCGUoDg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_PLENTY_OF_PARKING"],"很多停車位",2,null,null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3YcHCGgoAA"]],1],null,null,"停車位",null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3IcHCGcoDw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_GARAGE"],"付費室內停車場",2,null,null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3YcHCGooAA"]]],null,"附近的停車場",null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3IcHCGkoEA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3YcHCGwoAA"]]],null,null,null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ3IcHCGsoEQ",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["今天陪家裡的長輩到樹林秀泰逛逛，午餐選擇了位於 6 樓的彌生軒。這裡的用餐空間寬敞、採光明亮，對於行動較慢或重視環境舒適度的長輩來說非常友善。\n餐點選擇相當多樣化，很適合口味不一的家人。長輩對鮭魚雜炊讚不絕口，口感軟糯好消化，湯頭鮮甜且暖胃，非常適合消化系統較弱的老人家。我自己點的鰻魚重飯表現也很有水準，鰻魚肉質肥美且無細刺負擔，鹹甜的醬汁非常下飯。另外，茶碗蒸滑嫩細緻，配料如魚卵與蝦仁提升了整體層次，讓長輩吃得十分開心。\n服務效率高，店員在安排座位時相當貼心，注意到長輩的需求。雖然是假日人潮眾多的影城商場，但店內氛圍維持得不錯，不會過於擁擠。整體而言，彌生軒的定食均衡且食材新鮮，是帶長輩出遊時非常安心、不會踩雷的優質餐廳選擇。",null,[0,213]]]],[null,1778752403000000,1778752403000000,"3 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfUmVoUHd1eVlhSkJJXzFqQzdhU3k2Zw%7CCAEQrcz1_gkiMAoZQ0hfUmVoUHd1eVlhSkJJXzFqQzdhU3k2ZxoTQ2d3SWs3ZVcwQVlRN3BuWDhnRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwikkaPNy9KWAxVedfUHHWQbEaYQ_2MIbSgS"],"https://business.google.com/local/business/18390197419965141574/c