null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xaMldTMTJWVlJaYUVFMk1pMVJObTlvUjNSNGMwRRAB"]],"CIABIhBw4z_DeWN859c9gjHsS_Am",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjH7a3ux9KWAxUXYvUHHZ-DDCIQ3IcHCGgoBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjH7a3ux9KWAxUXYvUHHZ-DDCIQ3IcHCGkoBg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjH7a3ux9KWAxUXYvUHHZ-DDCIQ3IcHCGooBw",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這間店我從還在基隆工作的時候就吃了，那時候是在中永和，要特別過橋，現在才開分店來台大校區的。目前個人累計用餐次數4次，其他家人加總起來可能有5次，大家都是大推。\n.\n麻辣豚骨拉麵145，大碗、蔥多、一倍鹹。\n.\n麵體是類似超市便宜拉麵、那種黃色發光拉麵的加強版，對我來說比細麵粗一點，大概算中粗麵嗎？不是我個人熱愛的尺寸，但麵體Q彈好吃，沒有甚麼奇怪的味道，我是滿意的。\n.\n口味上，叉燒以瘦肉為主，但不會柴，是有肌理口感的，好吃；筍子脆，好吃；糖心蛋給一整顆，裡面也沒有沙沙的，味道是能感受到的醬香，好吃。整碗就是好吃，不是頂尖，但絕對好吃。\n.\nCP值來說，蔥多是免費的，還給很多；大蒜免費的，要加多少都可以；辣椒不錯，也是愛加多少都隨便；可以免費加麵（但要記得留湯）；有免費綠豆湯喝到飽──CP值根本就炸開。\n.\n空間比較狹小，也不能久坐，就跟所有拉麵店一樣，不適合約會或是多人聚餐。\n.\n但我絕對推爆他。",null,[0,82]]]],[null,null,null,null,null,"https://business.google.com/local/business/12825760889380639732/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhTWxkVE1USldWbEphWVVWRk1rMXBNVkpPYlRsdlVqTlNOR013UlJBQhAA",[null,null,null,"/local/business/12825760889380639732/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhTWxkVE1USldWbEphWVVWRk1rMXBNVkpPYlRsdlVqTlNOR013UlJBQhAA"],"https://business.google.com/local/business/12825760889380639732/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhTWxkVE1USldWbEphWVVWRk1rMXBNVkpPYlRsdlVqTlNOR013UlJBQhAA",[null,null,null,"/local/business/12825760889380639732/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhTWxkVE1USldWbEphWVVWRk1rMXBNVkpPYlRsdlVqTlNOR013UlJBQhAA"],null,"https://business.google.com/local/business/12825760889380639732/customers/reviews/reply?p\u003dCkRD