G_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjH7a3ux9KWAxUXYvUHHZ-DDCIQ3IcHCLEBKAU",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjH7a3ux9KWAxUXYvUHHZ-DDCIQ3IcHCLIBKAY",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwjH7a3ux9KWAxUXYvUHHZ-DDCIQ3YcHCLQBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjH7a3ux9KWAxUXYvUHHZ-DDCIQ3IcHCLMBKAc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["記得這邊原本是賣燒臘的店吧，之後倒了開這間小高拉麵。\n\n其實從一段時間就有在IG上看過小高拉麵的推薦短影片，那個時候想去吃，但店好像都開在新北，想到距離就有點卻步，因此小高開了一間在公館我也是頗期待。\n\n今天練完阿卡有一些時間，想說來吃吃看。流程是在外面用點餐機點餐，付現或是台灣PAY，之後會出一張號碼牌，接下來就等店員叫號碼。我是在8:15左右到的，排隊排了20分鐘左右。平常練球練到9點多經過也是很多人在排隊，所以20分鐘應該不算久？\n\n我點了135元的豚骨拉麵。麵本身偏軟，湯頭不會太鹹，有一點點甜味？筍乾個人覺得不怎麼好吃，跟拉麵不搭，麵的份量對我來說剛剛好，吃不飽也可以跟店員要求免費加麵，不用怕吃不飽。吃完後可以自助盛綠豆湯來喝，算是飯後甜品。\n\n個人認為以填飽肚子來說這間算OK，135塊錢吃到飽，澱粉滿肚子。但覺得有些過譽，不值得排太久的店，麵本身沒有什麼記憶點，不會為了口味回頭，但如果只是想吃飽，沒人排隊的話是可以來吃。CP值普普，不算高，食物也沒什麼特別的。拉麵品項也不多，個人認為何家拉麵略勝。",null,[0,100]]]],[null,null,null,null,null,"https://business.google.com/local/business/12825760889380639732/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVms5WFNsUlhWVXB0WVRBNU5WZ3hRbXBVTWtaTFpFWndTMkZzUlJBQhAA",[null,null,null,"/local/business/12825760889380639732/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVms5WFNsUlhWVXB0WVRBNU5WZ3hRbXBVTWtaTFpFWndTMkZzUlJBQhAA"],"https://business.google.com/local/business/12825760889380639732/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVms5WFNsUlhWVXB0WVRBNU5WZ3hRbXBVTWtaTFpFWndTMkZzUlJBQhAA",[null,null,null,"/local/business/12825760889380639732/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBPVms5WFNsUlhWVXB0WVRBNU5WZ3hRbXBVTWtaTFpFWndTMkZzUlJBQhAA"],null,"https://business.google.com/local/business/12825760889380639732/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJ