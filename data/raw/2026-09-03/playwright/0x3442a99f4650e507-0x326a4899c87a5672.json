iK8BHav2IwIQ3YcHCMIBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3IcHCMEBKAo",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3YcHCMQBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3IcHCMMBKAs",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3IcHCMUBKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3IcHCMYBKA0",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3IcHCMcBKA4",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_SOMEWHAT_DIFFICULT_TO_FIND"],"停車位有點難找",2,null,null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3YcHCMkBKAA"]],1],null,null,"停車位",null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3IcHCMgBKA8",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_NO_PARKING"],"不提供停車位",2,null,null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3YcHCMsBKAA"]]],null,"附近的停車場",null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3IcHCMoBKBA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3YcHCM0BKAA"]]],null,null,null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQ3IcHCMwBKBE",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["繼續開發新餐廳，用Google找到這家拉麵店，共點了三碗拉麵，還有些配菜、炸物，先找到座位，拿到門口點餐，先付款的形式，餐廳內有供應水及麥茶，茶不會很清淡，甜度適中，上菜速度非常快，中間店家有來說正在換水會稍慢，但其實沒超過10分鐘內，菜就上齊了，第一次來其中一碗有特別升級炙燒，吃起來有微焦的焦香味，肉片也會加大，跟正常比感覺麵也有變多，如果喜歡微焦口味，多加肉片可以試試，不過更推薦點正常版即可，本身拉麵的叉燒就非常不錯，適中的切片厚度，用筷子就可以輕鬆把肉分開，但咬在嘴裡不會覺得太爛，保有部分嚼勁，我覺得叉燒就是要做到這樣，再來湯頭我們選正常，平時我們家算是重口味，正常湯頭對我來說剛剛好，但國小小朋友們反應會稍微鹹，店家都可以做湯頭的調整，如果平時在外面正常都覺得鹹，那在這裡就建議選清淡，因為這裡的湯頭比路邊常見，如：豚x拉麵、博X拉麵等店家都濃郁許多，如花X嵐、X蘭那種有熬煮過的濃郁感，而重點就是價位，平時吃這些拉麵都要至少260起跳到300多都有，這裡還是200以下，實在太佛心了，家人則愛醬油拉麵的清爽感，小孩則是愛炸物，可樂餅很紮實，外皮炸的很酥，這次只有豬排覺得炸的久了一些，外皮有些許焦味，但因為調味的很好，所以就蓋過焦味了。\n\n打完才發現，這家我可能真的蠻喜歡，寫的特別長，喜歡濃郁型的拉麵，卻是平價拉麵的收費，看著老闆努力在外面煮麵，有感受到那種匠人精神，已經收藏愛店之一，會再來訪，推薦大家試試看！",null,[0,240]]]],[null,null,null,null,null,"https://business.google.com/local/business/12378313072880843881/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUktjVGwxT1hoblJSQUIQAA%3D%3D",[null,null,null,"/local/business/12378313072880843881/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUktjVGwxT1hoblJSQUIQAA%3D%3D"],"https://business.google.com/local/business/12378313072880843881/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUktjVGwxT1hoblJSQUIQAA%3D%3D",[null,null,null,"/local/business/12378313072880843881/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUktjVGwxT1hoblJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/12378313072880843881/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUktjVGwxT1hoblJSQUIQAA%3D%3D",[null,null,null,"/local/business/12378313072880843881/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUktjVGwxT1hoblJSQUIQAA%3D%3D"]],[null,null,13763,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURKcTl1OXhnRRAB!2m1!1s0x0:0x326a4899c87a5672!3m1!1s2@1:CIHM0ogKEICAgIDJq9u9xgE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURKcTl1OXhnRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURKcTl1OXhnRRItChZDSUhNMG9nS0VJQ0FnSURKcTl1OUpnEhNDZ3dJcHJueXBRWVFzSWZmdkFFGi4KF0NJSE0wb2dLRUlDQWdJREpxOXU5cGdFEhNDZ3dJcHJueXBRWVFzSWZmdkFFIhIJAAAAAAAAAAARclZ6yJlIajIqCzBaajhtYU1fd0Rr\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjcj_Dzy9KWAxUviK8BHav2IwIQoykIzgEoEg"],null,[null,[[1,1]]]],"0ahUKEwju9vbzy9KWAxWUd14EHc-jOuMQ0pMFCGYoBg"],null,null,null,"0ahUKEwjcj_Dzy9KW