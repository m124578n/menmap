[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwjO2qHzwtKWAxXbUPUHHfqmJAMQ3YcHCG0oAA"]]],null,null,null,"0ahUKEwjO2qHzwtKWAxXbUPUHHfqmJAMQ3IcHCGwoEw",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["這家位於士林的拉麵店，出餐速度很快，點完餐後沒多久，熱騰騰的麵條就已端上桌，非常適合不想久候或趕時間的族群。口味方面，這裡的拉麵表現相當穩健，湯頭與麵條的質感與一般日式拉麵店差不多，維持了標準的風味水平，是那種預期之內的踏實滋味。內用還有一項貼心的服務，就是提供免費飲料供顧客使用，在享用完濃郁的湯頭後，來上一杯清爽的飲品剛好可以解膩。交通上的便利性也是一大亮點，餐廳旁邊緊鄰著付費停車場，讓開車族不必在擁擠的街區繞圈找位子，停車非常方便。雖然味道走的是中規中矩的路線，但憑藉著極速的出餐與完善的配套設施，這裡依然是個省時又省心的日常用餐好選擇。",null,[0,273]]]],[null,null,null,null,null,"https://business.google.com/local/business/9629300509776979370/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR3VW1Kc1JrcFRhbEpQVEZWd1QxTkhWblJTVkVaeVlXdHNhV1JYWXhBQhAA",[null,null,null,"/local/business/9629300509776979370/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR3VW1Kc1JrcFRhbEpQVEZWd1QxTkhWblJTVkVaeVlXdHNhV1JYWXhBQhAA"],"https://business.google.com/local/business/9629300509776979370/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR3VW1Kc1JrcFRhbEpQVEZWd1QxTkhWblJTVkVaeVlXdHNhV1JYWXhBQhAA",[null,null,null,"/local/business/9629300509776979370/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR3VW1Kc1JrcFRhbEpQVEZWd1QxTkhWblJTVkVaeVlXdHNhV1JYWXhBQhAA"],null,"https://business.google.com/local/business/9629300509776979370/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR3VW1Kc1JrcFRhbEpQVEZWd1QxTkhWblJTVkVaeVlXdHNhV1JYWXhBQhAA",[null,null,null,"/local/business/9629300509776979370/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR3VW1Kc1JrcFRhbEpQVEZWd1QxTkhWblJTVkVaeVlXdHNhV1JYWXhBQhAA"]],[null,null,3232,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2twUmJsRkpTalJPTFVwT1NHVnRSVEZyYWtsaWRXYxAB!2m1!1s0x0:0xc372731d0bdf8718!3m1!1s2@1:CAIQACodChtycF9oOkpRblFJSjROLUpOSGVtRTFraklidWc%7C%7C?hl\u