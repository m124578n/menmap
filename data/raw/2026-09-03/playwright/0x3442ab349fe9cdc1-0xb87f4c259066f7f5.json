ull,null,null,"餐點",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCI8BKBU",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCJABKBY",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCJEBKBc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3YcHCJMBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3YcHCJQBKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3YcHCJUBKAI"],[["E:NOT_SURE"],"不確定",2,null,null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3YcHCJYBKAM"]]],null,"用餐人數",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCJIBKBg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["看人家去吃，好像還不錯，列入口袋名單後就忘記了。\n心血來潮，趁還沒有到真正夏天，跑這一趟，但也是很熱，沒想到中午陸陸續續來的人也是蠻多的。\n自己本身沒有很喜歡用點餐機，因為感覺很麻煩，好家在選擇沒有太多，才不會有選擇障礙。\n點了一碗比較重口味的，麵條自己是選擇軟，湯頭選擇中等，辣椒另外付，家人的麵條是選擇中等，相較之下選擇軟好像比較適合我們的口感，豆芽菜附超多，蒜頭也可以選擇是否要加，其他配菜像是糖心蛋，還是海苔片，需要的話就要另外自己加價，當時自己沒注意到以為裡面有附，肉類的份量給的還算蠻多的，湯頭濃郁，只是有點鹹，有看到應該是熟門熟路的，自己拿了一壺高湯，後來自己也去拿來加就比較沒那麼鹹了\n小叉燒是還不錯吃，這樣吃下來也挺飽的，晚上都不覺得餓",null,[0,111]]]],[null,null,null,null,null,"https://business.google.com/local/business/3656353916023747638/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhUzFkWVRUTk9WVm95WTFkU2VWTXdOVkpQUjJjeVUyNUNRMk5ZWXhBQhAA",[null,null,null,"/local/business/3656353916023747638/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhUzFkWVRUTk9WVm95WTFkU2VWTXdOVkpQUjJjeVUyNUNRMk5ZWXhBQhAA"],"https://business.google.com/local/business/3656353916023747638/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhUzFkWVRUTk9WVm95WTFkU2VWTXdOVkpQUjJjeVUyNUNRMk5ZWXhBQhAA",[null,null,null,"/local/business/3656353916023747638/customers/revie