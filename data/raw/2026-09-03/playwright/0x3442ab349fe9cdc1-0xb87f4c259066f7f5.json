ll,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCF4oDQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCF8oDg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11wfg_wzxv"],"溏心蛋",2,null,null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3YcHCGEoAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCGAoDw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3YcHCGMoAA"]],1],null,null,"預訂網址",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCGIoEA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["位於市政府捷運站1號出口外，走路不用2分鐘就到了。\n本次到店時間約晚上8點多，距離收店時間滿近的，人潮不會太多，不用排隊。\n現在室外用點餐機點餐後，即可入座。\n本次進店遇到的服務夥伴應該是新手(後來有看到其他夥伴在教學)，在應對上比較不那麼熟練，但其他資深夥伴的服務就很不錯，詢問加麵硬度很熱情。\n水與餐具都放在旁邊自己拿取，沒有人告知所以一開始有點措手不及，希望這方面的服務可以再加強。\n\n本次餐點：\n$330特製極濃豚骨拉麵 (手打麵)\n$60蘋果西打+糖心蛋 套餐\n\n最讓我驚艷的是特製版有多加的「炙燒豬五花」，真的超級好吃！完全出乎我的意料之外，原本以為炙燒過後，會讓整個燒肉變的比較乾硬不好咬，相反地，豬皮在炙燒過後保留了爽脆的口感，但卻不會太硬反而一咬就開，緊接著是豬五花肉的鬆軟油脂，包裹著脆皮出來，真的非常優秀！\n\n手打麵滿有趣的，很平常印象中的拉麵不太一樣，比較接近刀削麵的感覺。\n加麵部分，雖然僅能夠加細麵，但可以無限加麵真的很不錯！\n我選偏硬的細麵，搭配湯頭，讓我一連加了兩次。",null,[0,79]]]],[null,null,null,null,null,"https://business.google.com/local/business/3656353916023747638/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXZWxwRmVHdFJiVTVLVWtkc1lVNUdPSGRPVjBvMlRqTkdkVlJGUlJBQhAA",[null,null,null,"/local/business/3656353916023747638/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXZWxwRmVHdFJiVTVLVWtkc1lVNUdPSGRPVjBvMlRqTkdkVlJGUlJBQhAA"],"https://business.google.com/local/business/3656353916023747638/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXZWxwRmVHdFJiVTVLVWtkc1lVNUdPSGRPVjBvMlRqTkdkVlJGUlJBQhAA",[null,null,null,"/local/business/3656353916023747638/customers/reviews/deletereply?p\