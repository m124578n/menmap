TjVA6AQ3IcHCKABKAQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCKIBKAU",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCKMBKAY",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCKQBKAc",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3YcHCKYBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCKUBKAg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3YcHCKgBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiKm9zsvdKWAxX5a_UHHTjVA6AQ3IcHCKcBKAk",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["丸舢拉麵主打兩種風格完全不同的拉麵，一款是清爽鮮甜的雞貝鹽拉麵，另一款則是濃郁豪邁的二郎系豚骨，最加分的是還有免費替玉，食量大的人一定會很滿足。\n\n店內採現場候位，先登記姓名、人數與手機末三碼，再到販賣機購買餐券，等候叫號入座，流程簡單明瞭。\n\n叉燒軟嫩不乾柴，鹹香適中，搭配湯頭很剛好；溏心蛋熟度漂亮，微微流心，讓整碗拉麵更加順口。\n\n雞貝鹽拉麵湯頭清爽甘甜，雞骨的鮮香融合蛤蜊的海味，尾韻還帶點海苔香氣，喝起來很舒服，搭配細麵更能吸附湯汁，每一口都很涮嘴。\n\n喜歡重口味的話，推薦特製極濃豚骨拉麵。湯頭濃厚香醇、油脂感十足，粗麵Q彈有嚼勁，整體份量也很有誠意，吃完真的超有飽足感。",null,[0,121]]]],[null,null,null,null,null,"https://business.google.com/local/business/3656353916023747638/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRPVUZsWVFURmtSR3gyVlZkU1JXSXdkSFZsUkVJMFpVVkdVVlZIWXhBQhAA",[null,null,null,"/local/business/3656353916023747638/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRPVUZsWVFURmtSR3gyVlZkU1JXSXdkSFZsUkVJMFpVVkdVVlZIWXhBQhAA"],"https://business.google.com/local/business/3656353916023747638/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRPVUZsWVFURmtSR3gyVlZkU1JXSXdkSFZsUkVJMFpVVkdVVlZIWXhBQhAA",[null,null,null,"/local/bu