,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT21ZNVMzcEhkalkxZVdjM2IycEZVbkl4TFRrek1rRRAB"]],"CIABIhDTFE7vb4TXSCN0bj-E2dgd",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["位在中山北路巷子內的「不二家」是一間隱藏版的日式家庭料理。店內沒有特別佈置成日式氛圍，而是自然而然的一秒到大阪的感覺。\n\n這裡提供的餐食是日式帶台味的流派，台味不是貶義而是店家自成一格的味道。今天點的是不二家拉麵（博多細麵店、干貝雲吞），湯頭是清湯帶著某種鮮香，很像某種日本杯麵湯頭，跟偏硬帶嚼勁的博多細麵，極為搭配。配料我挑選的干貝雲吞，雲吞內餡是豬肉包著鮮干貝，一口咬下有驚艷感😋。另外點的日式炸雞跟北海道男爵馬鈴薯使用的奶油可樂餅，兩樣都中規中矩，有該有的美味。\n\n虱目魚定食，煎虱目魚和配菜也剛好的好吃，比較有趣的是擠檸檬夾子，展現店主人的貼心👍，\n\n今天還點了一份煎餃，我認為是今天的亮點，我一向對日本煎餃沒有期待，今天本來也預計是去吃附近一間名店的煎餃，由於排隊人數眾多所以放棄。而這裡的煎餃，一口咬下酥脆的外皮讓口感完美，結實的豬肉內餡帶著酒香，美味讓我驚呼，不能說這裡的煎餃是日式的，因為日式煎餃內餡多不紮實含水量高，這裡的內餡是台式水餃的內餡般的紮實，帶著料酒香氣把美味提升很多層次，美味🤤。\n\n這裡是一間值得推薦的寶藏食堂，\n如果想念日本時，來這裡坐坐喝個小酒點幾道美食，一定很幸福😊。",null,[0,59]]]],[null,null,null,null,null,"https://business.google.com/local/business/15659007395945041493/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaTlZNemNFaGthbGt4WlZkak0ySXljRVpWYmtsNFRGUnJlazFyUlJBQhAA",[null,null,null,"/local/business/15659007395945041493/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaTlZNemNFaGthbGt4WlZkak0ySXljRVpWYmtsNFRGUnJlazFyUlJBQhAA"],"https://business.google.com/local/business/15659007395945041493/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaTlZNemNFaGthbGt4WlZkak0ySXljRVpWYmtsNFRGUnJlazFyUlJBQhAA",[null,null,null,"/local/business/15659007395945041493/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaTlZNemNFaGthbGt4WlZkak0ySXljRVpWYmtsNFRGUnJlazFyUlJBQhAA"],null,"https://business.google.com/local/business/15659007395945041493/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaTlZNemNFaGthbGt4WlZkak0ySXljRVpWYmtsNFRGUnJlazFyUlJBQhAA",[null,null,null,"/local/business/15659007395945041493/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaTlZNemNFaGthbGt4WlZkak0ySXljRVpWYmtsNFRGUnJlazFyUlJBQhAA"]],[null,null,24524,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6