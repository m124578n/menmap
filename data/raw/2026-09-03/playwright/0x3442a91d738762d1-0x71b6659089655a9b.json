xXgk68BHTGjJAcQ3IcHCIkBKAU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjauqqxydKWAxXgk68BHTGjJAcQ3IcHCIoBKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjauqqxydKWAxXgk68BHTGjJAcQ3IcHCIsBKAc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11jt8h06xy"],"羊肉湯麵",2,null,null,"0ahUKEwjauqqxydKWAxXgk68BHTGjJAcQ3YcHCI0BKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwjauqqxydKWAxXgk68BHTGjJAcQ3IcHCIwBKAg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["午餐挑了這家傳統麵館，晚上17:00開門，16:55就陸續有人到達，生意很好，點了一碗清燉羊肉麵配上一盤經典滷味，紅色的桌面襯托出滿滿的台式煙火氣。\n清燉羊肉麵\n• 湯頭與配料：湯頭看似澄清，實則濃郁清甜。最吸睛的是那兩大塊厚實的白蘿蔔，燉得半透明、徹底入味，吸飽了牛肉湯汁，入口即化。\n• 羊肉：肉量給得很大方！薄片狀，帶點油花與嫩筋，口感軟嫩。\n• 麵條：選用微粗的拉麵麵體，極具彈性與嚼勁，裹著湯汁與滿滿的青蔥一起吸入口中，非常過癮。\n經典台式滷味\n吃牛肉麵怎麼能少了黑白切？點了滷蛋、海帶和豆乾。\n• 豆乾不鹹、海帶軟硬適中，再配上滷蛋，沾點盤底的滷汁，完美組合。",null,[0,143]]]],[null,null,null,null,null,"https://business.google.com/local/business/6147926054488957811/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTUTJGSVZsWlNNblJIVWxoU1ptRnNhRzlsV0ZKd1pETlNSbGxyUlJBQhAA",[null,null,null,"/local/business/6147926054488957811/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTUTJGSVZsWlNNblJIVWxoU1ptRnNhRzlsV0ZKd1pETlNSbGxyUlJBQhAA"],"https://business.google.com/local/business/6147926054488957811/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTUTJGSVZsWlNNblJIVWxoU1ptRnNhRzlsV0ZKd1pETlNSbGxyUlJBQhAA",[null,null,null,"/local/business/6147926054488957811/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTUTJGSVZsWlNNblJIVWxoU1ptRnNhRzlsV0ZKd1pETlNSbGxyUlJBQhAA"],null,"https://business.google.com/local/business/6147926054488957811/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTUTJGSVZsWlNNblJIVWxoU1ptRnNhRzlsV0ZKd1pETlNSbGxyUlJBQhAA",[null,null,null,"/local/business/61479260544