TION_PAID_STREET_PARKING"],"付費路邊停車",2,null,null,"0ahUKEwjopNT5y9KWAxXMi68BHYCUOD4Q3YcHCIwBKAE"]]],null,"附近的停車場",null,"0ahUKEwjopNT5y9KWAxXMi68BHYCUOD4Q3IcHCIoBKA8",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwjopNT5y9KWAxXMi68BHYCUOD4Q3IcHCI0BKBA",null,null,["我個人不愛炙燒（包含燒焦）\n點餐完，可以跟店員說不要燒！"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:OTHER_DIETARY_RESTRICTIONS"],"特殊餐點",2,null,null,"0ahUKEwjopNT5y9KWAxXMi68BHYCUOD4Q3YcHCI8BKAA"],[["E:PARKING"],"停車場",2,null,null,"0ahUKEwjopNT5y9KWAxXMi68BHYCUOD4Q3YcHCJABKAE"]]],null,null,null,"0ahUKEwjopNT5y9KWAxXMi68BHYCUOD4Q3IcHCI4BKBE",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["現在很多名店拉麵，一碗動不動就是 2～300 起跳，但只吃一碗想要吃飽，說真的很難。\n\n你吃的是品牌、湯頭、排隊人潮跟名店光環，可是對吃飽派來說，真正現實的問題是，吃完離開時到底有沒有真的飽。\n\n沒想到這家店真的太狠，不靠名店光環，光是「續麵」這一招，就直接打中拉麵店最尷尬的痛點，不是不好吃，而是很多時候真的吃不飽。\n\n想知道這家拉麵店到底狠在哪裡，記得把影片看完，也留言告訴我，你吃拉麵最在意的是名氣，還是能不能真的吃飽。\n\n#Lion哥美食領航者\n#探店\n#吃到飽\n#拉麵\n#小高拉麵",null,[0,96]]]],[null,null,null,null,null,"https://business.google.com/local/business/3195967003082240654/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3VGxSc1RqRk5SRlpKVDFWb1JGTldWbEZTVlRnMFRWUmFjbFJZWXhBQhAA",[null,null,null,"/local/business/3195967003082240654/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3VGxSc1RqRk5SRlpKVDFWb1JGTldWbEZTVlRnMFRWUmFjbFJZWXhBQhAA"],"https://business.google.com/local/business/3195967003082240654/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3VGxSc1RqRk5SRlpKVDFWb1JGTldWbEZTVlRnMFRWUmFjbFJZWXhBQhAA",[null,null,null,"/local/business/3195967003082240654/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3VGxSc1RqRk5SRlpKVDFWb1JGTldWbEZTVlRnMFRWUmFjbFJZWXhBQhAA"],null,"https://business.google.com/local/business/3195967003082240654/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjV3VGxSc1RqRk5S