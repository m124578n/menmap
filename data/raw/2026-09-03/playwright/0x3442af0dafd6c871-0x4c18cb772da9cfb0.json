ll,null,null,"氣氛",null,"0ahUKEwjH_aPvw9KWAxVOla8BHQUkED0Q3IcHCI0BKAc",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["*\n啤酒有球冰超用心\n\n*\n老闆一人作業，叫個小菜，耐心等待，值得\n\n*\n朋友點雞白湯叉燒\n叉燒很好吃，雞湯不會太鹹，很喜歡這樣的乾淨味道，湯可以一直一直喝不會口渴。\n\n*\n我點的雞白湯配雞腿\n雞腿很嫩很嫩，湯我另外加了辣油和更多藤椒油，喝到一個爽，因為不會太鹹，真的很滿意，我還加了半碗湯。\n\n*統一配料方面的溏心蛋處理得很剛好，給一整顆也很大方，桂竹筍超好吃超嫩也一大支，也很喜歡木耳，這個價格真的太佛了\n\n*\n麵條如果喜歡偏硬可以提前告知\n\n*\n雖然夏天會有點熱，但這個價格，乾乾淨淨的我覺得已經很舒服。\n\n*\n老闆一個人很忙\n客人有時候會很多\n估狗評論有一些問題\n經了解老闆都已虛心改善\n\n*\n特地從新店區公所來吃非常值得",null,[0,10]]]],[null,null,null,null,null,"https://business.google.com/local/business/5647750713981679971/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMTW5Jek9IVjNNSFJwTlZWbkVBRRAA",[null,null,null,"/local/business/5647750713981679971/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMTW5Jek9IVjNNSFJwTlZWbkVBRRAA"],"https://business.google.com/local/business/5647750713981679971/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMTW5Jek9IVjNNSFJwTlZWbkVBRRAA",[null,null,null,"/local/business/5647750713981679971/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMTW5Jek9IVjNNSFJwTlZWbkVBRRAA"],null,"https://business.google.com/local/business/5647750713981679971/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMTW5Jek9IVjNNSFJwTlZWbkVBRRAA",[null,null,null,"/local/business/5647750713981679971/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMTW5Jek9IVjNNSFJwTlZWbkVBRRAA"]],[null,null,9437,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VLMnIzOHV3MHRpNVVnEAE!2m1!1s0x0:0x4c18cb772da9cfb0!3m1!1s2@1:CIHM0ogKEK2r38uw0ti5Ug%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VLMnIzOHV3MHRpNVVnEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VLMnIzOHV3MHRpNVVnEi0KFkNJSE0wb2dLRU5DS200M3l4YXZBRlESE0Nnd0l3UHI3d1FZUWlKemNwUUUaLQoWQ0lITTBvZ0tFTDdzbTczZnFJdUNadxITQ2d3SXdQcjd3UVlRaUp6Y3BRRSISCQAAAAAAAAAAEbDPqS13yxhMKgswY0VqcC1KaGtzNw\u0026wv\u003d1\u0026d\u003d286732320",