l,null,null,null,null,null,null,["zh-Hant"],[["在日本吃了本店跟鎌倉店，因為很喜歡，回台北特別來訪。\n吃了覺得很難過，蔬菜太乾，沒有本店保留的水分跟甜度。\n雞肉切很薄，吃起來很柴，調味不佳，提供的辣椒沾醬很像台灣小吃麵攤\n沒有賣沾麵，生蛋乾拌麵，麵體不夠Q彈，調味也像台灣的乾拌麵。\n提供的冰水，完全不冰，冰塊都已經融掉了，我去的時間是平日中午，沒有什麼客人。\n我很喜歡銀座篝，台灣分店跟日本差的十萬八千里，價格沒什麼差，希望能改善，不然還是買張機票去日本吃吧。",null,[0,86]]]],[null,null,null,null,null,"https://business.google.com/local/business/10507699573977237357/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLUmxONlFscE5NRTVKWkVSUk5GRXhjRVpOYW1jMVRVZHpNRkZZWXhBQhAA",[null,null,null,"/local/business/10507699573977237357/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLUmxONlFscE5NRTVKWkVSUk5GRXhjRVpOYW1jMVRVZHpNRkZZWXhBQhAA"],"https://business.google.com/local/business/10507699573977237357/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLUmxONlFscE5NRTVKWkVSUk5GRXhjRVpOYW1jMVRVZHpNRkZZWXhBQhAA",[null,null,null,"/local/business/10507699573977237357/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLUmxONlFscE5NRTVKWkVSUk5GRXhjRVpOYW1jMVRVZHpNRkZZWXhBQhAA"],null,"https://business.google.com/local/business/10507699573977237357/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLUmxONlFscE5NRTVKWkVSUk5GRXhjRVpOYW1jMVRVZHpNRkZZWXhBQhAA",[null,null,null,"/local/business/10507699573977237357/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBLUmxONlFscE5NRTVKWkVSUk5GRXhjRVpOYW1jMVRVZHpNRkZZWXhBQhAA"]],[null,null,1879,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pKRlN6QlpNME5JZERRNFExcEZNamc1TUdzMFFYYxAB!2m1!1s0x0:0xbb7f26a3baba013e!3m1!1s2@1:CAIQACodChtycF9oOjJFSzBZM0NIdDQ4Q1pFMjg5MGs0QXc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pKRlN6QlpNME5JZERRNFExcEZNamc1TUdzMFFYYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pKRlN6QlpNME5JZERRNFExcEZNamc1TUdzMFFYYxI-Ci9DQUlRQUNvZENodHljRjlvT2pKRlN6QlpNME5JZERRNFExcEZN