l,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3YcHCGEoAA"]]],null,"用餐人數",null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3IcHCGAoDQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3YcHCGMoAA"]],1],null,null,"等待時間",null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3IcHCGIoDg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["看起來平凡的一碗麵\n吸了一口麵，才發現這一碗吃的不只是麵，而是料理人滿滿的熱情。\n\n#長生塩人\n記得是當初我還在醫院服務長時，就有人推薦我必需去員林品嚐的美味拉麵🍜\n\n麵條有分2款，皆是細麵：\n🔖立成製麵（Q彈滑順，可久放不爛的麵條）\n🔖麗珠製麵（麵條偏硬，吃得到麵心的口感）\n\n我選了招牌的鹽味拉麵🍜，搭配店員推薦的立成製麵，升級雙倍肉（叉燒、舒肥雞肉），加了溏心蛋。\n\n一上桌，先吸了一口麵，麵條巴著清爽帶點油脂卻不膩的湯頭～嗯！豪好吃～🤤\n炙燒過的叉燒帶著炙燒過的香氣，卻不會油膩（叉燒絕對是我吃過的前三名🥉），舒肥雞也鮮嫩美味，和拉麵搭起來毫無違和感。\n\n推薦大家可以去嚐嚐",null,[0,40]]]],[null,1770686728000000,1770686728000000,"6 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfcXBoRmVtYnZyYWtHMnNadXhwZF9WQQ%7CCAEQrcz1_gkiMAoZQ0hfcXBoRmVtYnZyYWtHMnNadXhwZF9WQRoTQ2d3SWlKS3F6QVlROEltXzFnTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ_2MIZCgP"],"https://business.google.com/local/business/758582071928944475/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVDFacVFqUlphMWt3VGpGS05tRlZTVFJqYTFaNVYwWnNORlV6WXhBQhAA",[null,null,null,"/local/business/758582071928944475/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVDFacVFqUlphMWt3VGpGS05tRlZTVFJqYTFaNVYwWnNORlV6WXhBQhAA"],"https://business.google.com/local/business/758582071928944475/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVDFacVFqUlphMWt3VGpGS05tRlZTVFJqYTFaNVYwWnNORlV6WXhBQhAA",[null,null,null,"/local/business/758582071928944475/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVDFacVFqUlphMWt3VGpGS05tRlZTVFJqYTFaNVYwWnNORlV6WXhBQhAA"],null,"ht