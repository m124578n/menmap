CO4BKBI",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3IcHCO8BKBM",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11p0hg19_b"],"鹽味拉麵 雙倍肉 糖心蛋",2,null,null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3YcHCPEBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3IcHCPABKBQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3YcHCPMBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3YcHCPQBKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3YcHCPUBKAI"]]],null,"用餐人數",null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3IcHCPIBKBU",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3YcHCPcBKAA"]],1],null,null,"等待時間",null,"0ahUKEwi7lpPIw9KWAxVXh68BHZaqLhsQ3IcHCPYBKBY",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["發跡自天母的長生塩人，在捷運北投站前開的分店，簡約樸素的木質日式風格，掛著書寫店名的白色燈籠，配上開店初期誇張的排隊人龍，讓人一出捷運站就能看到。店家營業時間從傍晚到半夜，也算是體貼值晚班的上班族與夜貓子。\n\n小小的店面，提供10位吧檯式座位，剛開始僅以現場排隊為順序，後來調整成在店門口提供排隊登記表，店員依登記順序呼喚入座，這一改變多了些人性。\n\n餐點品項為4款口味的拉麵，另有其他日式拉麵店少有的日本炒麵及單點配菜。\n\n主打的塩味拉麵，算是淡麗系流派，湯頭以豬骨、雞骨、雞腳、洋蔥、蘿蔔、蔥薑等熬煮，看起來金黃剔透，入口不會淡而無味且不膩口，非常清爽。也沒有豚骨、雞白湯類的腥味。蠻適合長夏炎熱的天氣享用。\n配菜有：舒肥雞胸肉、炙燒梅花豬各2片、紫洋蔥丁、蔥花、娃娃菜半顆、海苔一片。\n麵體則有2款可選擇：豪億製麵(直細麵)-屬於生麵，剛上桌時麵心有點硬，到後來吸收較多湯頭，會稍微軟些(後來供應商改為 麗珠製麵 了)。另一款則是立成製麵(極細麵)，需另外加價。一進店門吧檯案頭， 放上傳統木盒，刻有大大的「立成製麵」字樣，展現出店家的信心。立成的極細麵，從頭到尾口感較一致，不會因為在湯中泡久了而有變化。\n\n日本炒麵(微辣)：這道是一般拉麵店看不到的品項，同樣強調清爽不油膩的口感，也不會湯湯水水的。擺盤的造型，頗有富士山的既視感。旁邊點綴著一併翻炒的豬肉、雞肉與高麗菜。並灑上不少七味粉，所以有微辣感。雖然造型與口感不錯，但個人覺得鹹度略高，要搭配店家的白開水喝。\n\n溏心蛋：表現一般，沒有出眾亮點。",null,[0,103]]]],[null,1759977392000000,1759977392000000,"10 個月前",["https://www.google.com/local/content/rap/report?postI