喜歡濃厚系湯頭的人應該會覺得不錯。",null,[0,50]]]],[null,null,null,null,null,"https://business.google.com/local/business/6004055306566183285/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA",[null,null,null,"/local/business/6004055306566183285/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA"],"https://business.google.com/local/business/6004055306566183285/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA",[null,null,null,"/local/business/6004055306566183285/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA"],null,"https://business.google.com/local/business/6004055306566183285/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA",[null,null,null,"/local/business/6004055306566183285/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA"]],[null,null,3067,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25Zd1VqUk9ZV1ZTZUhCMWFISkphWE5yUkhsc1RHYxAB!2m1!1s0x0:0x5eaecb2146e7a213!3m1!1s2@1:CAIQACodChtycF9oOnYwUjROYWVSeHB1aHJJaXNrRHlsTGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25Zd1VqUk9ZV1ZTZUhCMWFISkphWE5yUkhsc1RHYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25Zd1VqUk9ZV1ZTZUhCMWFISkphWE5yUkhsc1RHYxI-Ci9DQUlRQUNvZENodHljRjlvT25Zd1VqUk9ZV1ZTZUhCMWFISkphWE5yUkhsc1RHYxILMGRkdDRPQUU5Z3AaPgovQ0FJUUFDb2RDaHR5Y0Y5b09uWXdValJPWVdWU2VIQjFhSEpKYVhOclJIbHNUR2MSCzBkZHQ0T0FFOWdwIhIJAAAAAAAAAAARE6LnRiHLrl4qCzBkZHQ0T0FFOWdw\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjDqdj7vdKWAxXZcfUHHQO2CW0QoykI6