le.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICkr6GCZQ\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x12971d343a057476"]],1,null,null,null,null,null,null,["0","1339571524314952822"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUNvdVl1dVdREAE"]],"CIHM0ogKEICAgICkr6GCZQ",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["不是道地的日本拉麵，但是以台式口味而言是好吃的，口味不鹹膩，吃起來很爽口\n本次吃的是唐揚雞腿地獄拉麵，雞腿真的是非常好吃，外衣香脆不油膩之外，咬下去居然有肉汁，比之前吃的唐揚炸雞好吃太多了(唐揚香香雞吃起來就覺得有點老，不是很喜歡)，令人有驚艷的感覺\n以此價格來說，是個實惠的中餐去處，中午常常都需要排隊，建議要12：30之後再去就比較不需要等待",null,[0,125]]]],[null,null,null,null,null,"https://business.google.com/local/business/17463435873577036106/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnZkVmwxZFZkUkVBRRAA",[null,null,null,"/local/business/17463435873577036106/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnZkVmwxZFZkUkVBRRAA"],"https://business.google.com/local/business/17463435873577036106/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnZkVmwxZFZkUkVBRRAA",[null,null,null,"/local/business/17463435873577036106/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnZkVmwxZFZkUkVBRRAA"],null,"https://business.google.com/local/business/17463435873577036106/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnZkVmwxZFZkUkVBRRAA",[null,null,null,"/local/business/17463435873577036106/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnZkVmwxZFZkUkVBRRAA"]],[null,null,9128,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNvdVl1dVdREAE!2m1!1s0x0:0x12971d343a057476!3m1!1s2@1:CIHM0ogKEICAgICouYuuWQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUNvdVl1dVdREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUNvdVl1dVdREi4KF0NJSE0wb2dLRUlDQWdJQ291WXV1MlFFEhNDZ3dJNGNfNDN3VVFtS1BEMFFFGi0KFkNJSE0wb2dLRUlDQWdJQ29