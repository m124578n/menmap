ull,null,null,["2 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhBupVOA9svAVQZrylL92VOp\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xae7b691578df9f2d"]],1,null,null,null,null,null,null,["0","-5873985748031529171"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25CMk4zRjJlRUo0VlUwM1ZqWnFiVzVJZW1ORVIwRRAB"]],"CIABIhBupVOA9svAVQZrylL92VOp",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjj24nDzNKWAxV7ja8BHRnnElYQ3IcHCNkBKAM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjj24nDzNKWAxV7ja8BHRnnElYQ3IcHCNoBKAQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjj24nDzNKWAxV7ja8BHRnnElYQ3IcHCNsBKAU",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["運動完，經過的一間新店，裝潢很美很乾淨，原本以為是很貴的餐廳，結果看了菜單，意外平價！\n這次兩人點了鮭魚丼飯、唐揚雞、玉子燒、豆皮壽司，每個都很好吃！\n鮭魚丼飯的生魚片都有一定厚度！份量也很足夠，剛開始看起來小小一份，但實際超有飽足感，我們吃很飽、很滿足😌\n唐揚雞的皮也很薄，很有肉汁；玉子燒跟豆皮壽司中規中矩，我都很喜歡，份量剛剛好！\n\n最後又加點兩個布丁，一個才25，真的很好吃😋\nCP值很高，未來會持續想吃的店，下次想來吃拉麵！\n\n然後店員們隨時都會很細心的注意到客人，我覺得很棒！\n\n補留：看了留言，原來不是新開的店！整體環境超乾淨！",null,[0,128]]]],[null,null,null,null,null,"https://business.google.com/local/business/8128215387388975742/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDTWs0elJqSmxSVW8wVmxVd00xWnFXbkZpVnpWSlpXMU9SVkl3UlJBQhAA",[null,null,null,"/local/business/8128215387388975742/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDTWs0elJqSmxSVW8wVmxVd00xWnFXbkZpVnpWSlpXMU9SVkl3UlJBQhAA"],"https://business.google.com/local/business/8128215387388975742/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDTWs0elJqSmxSVW8wVmxVd00xWnFXbkZpVnpWSlpXMU9SVkl3UlJBQhAA",[null,null,null,"/local/business/8128215387388975742/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDTWs0elJqSmxSVW8wVmx