灑下海苔絲點綴，是丸亀製麵熱門商品之一。"],["$139.00"]],[["牛肉蛋拌烏龍麵 M","為釜揚系列的商品，因手作烏龍麵條沒有經過手洗的過程，故可以品嚐到麵條的原味及小麥香！拌入半熟蛋的Ｑ彈烏龍麵條，加上鮮嫩牛肉，滿足你想吃乾麵的需求。"],["$129.00"]],[["牛肉蛋拌烏龍麵 L","為釜揚系列的商品，因手作烏龍麵條沒有經過手洗的過程，故可以品嚐到麵條的原味及小麥香！拌入半熟蛋的Ｑ彈烏龍麵條，加上鮮嫩牛肉，滿足你想吃乾麵的需求。"],["$159.00"]],[["溫玉濃湯烏龍麵 M","特調濃湯底、口味香濃不死鹹，加上新鮮溫泉蛋，使手工烏龍麵條更加順口，商品可選擇要熱湯或是冷湯喔！"],["$99.00"]],[["溫玉濃湯烏龍麵 L","特調濃湯底、口味香濃不死鹹，加上新鮮溫泉蛋，使手工烏龍麵條更加順口，商品可選擇要熱湯或是冷湯喔！"],["$129.00"]]]]],[["天婦羅/丼飯",""],[[[["天丼飯","選用頂級白米，米粒飽滿、口感Q彈美味，淋上獨家特製天丼醬汁，鹹香濃郁又開胃。"],["$35.00"]],[["炸物天婦羅","每日現炸酥脆天婦羅，多種品項自由挑選，炸物招牌如炸蝦、炸雞、炸白身魚等，每間店舖供應品項略有不同，請依照門市現場供應品項為主。"]]]]],[["素食/關東煮",""],[[[["素湯烏龍麵(M)","經過手洗的烏龍麵條變得更加Q彈，Q彈的烏龍麵條配上特製昆布湯頭，簡單的美味。"],["$74.00"]],[["素湯烏龍麵 (L)","經過手洗的烏龍麵條變得更加Q彈，Q彈的烏龍麵條配上特製昆布湯頭，簡單的美味。"],["$104.00"]],[["素食關東煮","由特製昆布湯頭熬煮，品項豐富CP值高，提供板豆腐、玉米筍、白蘿蔔、香菇等素食關東煮選擇，每間店舖供應品項略有不同，請依照門市現場供應品項為主。"],["$32.00"]]]]]],[3],["メニュー",""],1]]],null,null,null,null,0,null,null,null,[[[["裕隆城","0x346801fa860c1f15:0xb8aa441a4ab53bf5",null,null,null,"0ahUKEwjd2ovTytKWAxWdjK8BHZjRCb0Qg7cGCJEDKDo"]],1,1]],null,null,null,null,null,null,null,null,null,null,["規劃行程"],[9],null,null,null,null,null,null,[[[["/m/0dxjn"],"炸",null,[null,null,null,null,64,180,115],"CgoKCC9tLzBkeGpu","0ahUKEwjd2ovTytKWAxWdjK8BHZjRCb0Q1bMECKkDKEM",null,null,null,[[2]]],[["/m/01z1m1x"],"湯",null,[null,null,null,null,34,148,103],"CgwKCi9tLzAxejFtMXg\u003d","0ahUKEwjd2ovTytKWAxWdjK8BHZjRCb0Q1bMECKoDKEQ",null,null,null,[[2]]],[["/m/05vgdn"],"豆皮",null,[null,null,null,null,19,0,36],null,"0ahUKEwjd2ovTytKWAxWdjK8BHZjRCb0Q1bMECKsDKEU",null,null,null,[[2]]],[["/m/04kkgm"],"碗",null,[null,null,null,null,16,305,124],"CgsKCS9tLzA0a2tnbQ\u003d\u003d","0ahUKEwjd2ovTytKWAxWdjK8BHZjRCb0Q1bMECKwDKEY",null,null,null,[[2]]],[["/m/042lv8"],"蔥",null,[null,null,null,null,10,20,23],"CgsKCS9tLzA0Mmx2OA\u003d\u003d","0ahUKEwjd2ovTytKWAxWdjK8BHZjRCb0Q1bMECK0DKEc",null,null,null,[[2]]],[["/m/0cj23"],"白身魚",null,[null,null,null,null,9,3,9],"CgoKCC9tLzBjajIz","0ahUKEwjd2ovTytKWAxWdjK8BHZjRCb0Q1bMECK4DKEg",null,null,null,[[2]]],[["/g/121z6kjj"],"豚骨",nu