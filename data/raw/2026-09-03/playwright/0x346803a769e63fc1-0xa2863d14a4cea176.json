,dash",2],[0,1080,1920,"https://lh3.googleusercontent.com/gpms-cs-s/AFP8RcMibvPVcDNbds7zenSv2feQ7c9J26rr5qoqkC0pUm7qKHB1LPPI-e6Ja5GFZ6OPQ99rKq4CECrtgMmt7HmpBK5QenbUelbfZYyuO9DqyviUdPUlVcj04n_-ilbQs0PiEVZQ07aVIg\u003dmm,hls?ibw\u003d750000",3]]],null,null,["0","-6735629033812352650"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnTUNBeE1mOExREAE"]],"CIHM0ogKEICAgMCAxMeW2wE",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwiE7MGLxtKWAxU6UPUHHfDPPLIQ3YcHCLQBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwiE7MGLxtKWAxU6UPUHHfDPPLIQ3IcHCLMBKA4",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:OTHER"],"其他",2,null,null,"0ahUKEwiE7MGLxtKWAxU6UPUHHfDPPLIQ3YcHCLYBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiE7MGLxtKWAxU6UPUHHfDPPLIQ3IcHCLUBKA8",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwiE7MGLxtKWAxU6UPUHHfDPPLIQ3YcHCLgBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiE7MGLxtKWAxU6UPUHHfDPPLIQ3IcHCLcBKBA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiE7MGLxtKWAxU6UPUHHfDPPLIQ3IcHCLkBKBE",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiE7MGLxtKWAxU6UPUHHfDPPLIQ3IcHCLoBKBI",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiE7MGLxtKWAxU6UPUHHfDPPLIQ3IcHCLsBKBM",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["無人拉麵這家位於板橋台藝大旁邊的店，讓我完全改觀了對於“無人店”的印象。起初我還以為會和我大學旁邊的那家類似，環境雜亂、氣氛不太好，沒想到一進去就驚訝於店裡的乾淨與舒適。最大的驚喜是，這裡居然有一位熱心的阿姨24小時幫忙打理店鋪。她即使不會操作機器，還是會熱心幫忙收拾，處理速度相當快，整體氛圍讓人感覺很有溫度。\n\n無人拉麵店提供的是韓國風味的即食麵，基本上以農心和不倒翁的麵為主，甚至還有韓國人氣的火雞麵。支付方式也很方便，可以選擇LINE PAY或者現金付款，這樣對於不太喜歡現金交易的客人來說，是個不錯的選擇。\n\n值得一提的是，這裡的麵條硬度控制得恰到好處。我個人偏好吃比較有嚼勁的麵條，這裡的麵煮起來剛好不軟爛，吃起來口感非常好。如果你像我一樣喜歡硬一點的麵，那就可以放心點餐了。當然，如果你喜歡麵條更軟一點，可以多煮一會兒，這也非常靈活。\n\n除了基本的韓式即食麵外，這裡的自助區域也是一大亮點。蔬菜部分有高麗菜和玉米，還有各種韓式小配菜可供選擇，像是泡菜、韓國魚板、熱狗、丸子、蟹肉棒等，品項相當豐富。即使是一碗簡單的拉麵，因為這些小菜的加持，味道也會更加層次豐富。\n\n不過要注意的是，這裡的店內環境相對較悶熱，特別是如果你選擇的是火雞麵這類辣味較重的麵，可能會覺得有些燥熱，所以如果不太能吃辣，建議可以選擇其他口味的拉麵，或者避免點過辣的選擇。總體來說，這裡的辣味麵食雖然夠勁，但並不會讓你感到過於刺激，還算可以接受。\n\n除了拉麵，這裡還提供了各式飲料，包括果汁、汽水，以及最近很受歡迎的泰式奶茶。泰式奶茶的味道也相當不錯，值得一試。如果想要更多的選擇，還可以加購披薩，披薩的口味也讓人驚艷，沒有過多的油膩感，吃起來相當清爽，跟拉麵搭配在一起是一個不錯的組合。\n\n總的來說，這家無人拉麵提供了一個非常新鮮的用餐體驗，不僅食物味道不錯，環境也很乾淨舒適，而且服務雖然是無人操作，但由於有阿姨幫忙維護，整體用餐體驗非常順暢。對於喜歡簡單、快捷又能品嚐到正宗韓式拉麵的人來說，這裡確實是個值得推薦的好地方。",null,[0,156]]]],[null,null,null,null,null,"https://business.google.com/local/business/9321482078617859872/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTkJlRTFtT0V4UkVBRRAA",[null,null,null,"/local/business/9321482078617859872/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTkJlRTFtT0V4UkVBRRAA"],"https://business.google.com/local/business/9321482078617859872/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTkJlRTFtT0V4UkVBRRAA",[null,null,null,"/local/business/9321482078617859872/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTkJlRTFtT0V4UkVBRRAA"],null,"https://business.google.com/local/business/9321482078617859872/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTkJlRTFtT0V4UkVBRRAA",[null,null,null,"/local/business/9321482078617859872/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTkJlRTFtT0V4UkVBRRAA"]],[null,null,9255,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnTUNBeE1mOExREAE!2m1!1s0x0:0xa2863d14a4cea176!3m1!1s2@1:CIHM0ogKEICAgMCAxMf8LQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnTUNBeE1mOExREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnTUNBeE1mOExREi4KF0NJSE0wb2dLRUlDQWdNQ0F4TWY4clFFEhNDZ3dJeGJEcHZBWVE0SnJsd1FJGi0KFkNJSE0wb2dLRUlDQWdNQ0F4TWY4YlESE0Nnd0l4YkRwdkFZUTRKcmx3UUkiEgkAAAAAAAAAABF2oc6kFD2GoioLMGJhX1c0Y0RKcFY\u0026wv\u003d1\u0026d\u003