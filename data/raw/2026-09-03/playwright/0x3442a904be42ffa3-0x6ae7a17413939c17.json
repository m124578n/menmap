ll,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["店面不大，不過吃拉麵也不會太久，如果遇到客滿的情況可以稍微等一下就好~\n滿多拉麵口味可以選擇，今天吃蒜味蛤蜊牛跟牛奶起司拉麵，都很不錯！叉燒口味跟以前吃過的別家拉麵店不太一樣，比較厚一點口感很好。\n明太子叉燒飯好好吃，不會太膩，口味很豐富~\n小菜的部分，唐揚雞我個人覺得還好，雞肉的部分比較小塊吃起來稍微空虛。胡麻龍鬚菜新鮮好吃！\n店員服務態度都非常親切，謝謝麵匡匡給我很棒的晚餐體驗！\n口味皆為個人主觀感受，僅供參考唷~",null,[0,120]]]],[null,null,null,null,null,"https://business.google.com/local/business/16014187859129971838/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpiSFpwVW5WblJSQUIQAA%3D%3D",[null,null,null,"/local/business/16014187859129971838/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpiSFpwVW5WblJSQUIQAA%3D%3D"],"https://business.google.com/local/business/16014187859129971838/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpiSFpwVW5WblJSQUIQAA%3D%3D",[null,null,null,"/local/business/16014187859129971838/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpiSFpwVW5WblJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/16014187859129971838/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpiSFpwVW5WblJSQUIQAA%3D%3D",[null,null,null,"/local/business/16014187859129971838/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpiSFpwVW5WblJSQUIQAA%3D%3D"]],[null,null,5465,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnTURJbHZpUnVnRRAB!2m1!1s0x0:0x6ae7a17413939c17!3m1!1s2@1:CIHM0ogKEICAgMDIlviRugE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnTURJbHZpUnVnRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnTURJbHZpUnVnRRItChZDSUhNMG9nS0VJQ0FnTURJbHZpUmVnEhNDZ3dJNHN6WnZ3WVFrSXF5NHdFGi4KF0NJSE0wb2dLRUlDQWdNRElsdmlSLWdFEhNDZ3dJNHN6WnZ3WVFrSXF5NHdFIhIJAAAAAAAAAAARF5yTE3Sh52oqCzBieGFPWFJRN0pG\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjU8uWtyNKWAxXHjq8BHXMqN3IQoykIkwEoCw"],null,[null,[[1,0]]]],"0ahUKEwjvyOytyNKWAxWyeV4EHV0vPP8Q0pMFCDgoAg"],null,null,null,"0ahUKEwjU8uWtyNKWA