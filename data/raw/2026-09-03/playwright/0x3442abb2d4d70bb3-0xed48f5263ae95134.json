ll,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:VEGETARIAN_OPTIONS"],"素食餐點",2,null,null,"0ahUKEwigrsbyxNKWAxUYdfUHHSJ3EWUQ3YcHCIQCKAA"],[["E:OTHER_DIETARY_RESTRICTIONS"],"特殊餐點",2,null,null,"0ahUKEwigrsbyxNKWAxUYdfUHHSJ3EWUQ3YcHCIUCKAE"],[["E:PARKING"],"停車場",2,null,null,"0ahUKEwigrsbyxNKWAxUYdfUHHSJ3EWUQ3YcHCIYCKAI"]]],null,null,null,"0ahUKEwigrsbyxNKWAxUYdfUHHSJ3EWUQ3IcHCIMCKBk",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["今天2025年4月9日（星期三）初訪想吃拉麵南港店～～～\n\n整體而言，家常好吃，有順路路過可以嚐嚐，但不用特別過來XD\n\n【餐點部分】\n本次點的餐點：原味豚骨拉麵\n餐點味道不錯，湯頭算濃郁，整體口感不錯～\n\n麵條滑順，搭湯頭剛剛好。叉燒也還不錯\n，溏心蛋滑嫩香濃，有筍乾脆口感爽脆、去油解膩。可以加點辣油提味～\n\n【環境部分】\n桌椅乾淨，餐具整齊乾淨。\n\n【服務部分】\n服務人員人很中規中矩，感受上普普通通～\n\n《支付方式》現金\n《點餐方式》自助點餐機台點餐\n《服務費》無收服務費\n\n《設備或服務》\n#有冷氣\n#有提供水",null,[0,59]]]],[null,null,null,null,null,"https://business.google.com/local/business/15828016297063619545/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpNVzgzTm5WblJSQUIQAA%3D%3D",[null,null,null,"/local/business/15828016297063619545/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpNVzgzTm5WblJSQUIQAA%3D%3D"],"https://business.google.com/local/business/15828016297063619545/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpNVzgzTm5WblJSQUIQAA%3D%3D",[null,null,null,"/local/business/15828016297063619545/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpNVzgzTm5WblJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/15828016297063619545/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpNVzgzTm5WblJSQUIQAA%3D%3D",[null,null,null,"/local/business/15828016297063619545/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVUkpNVzgzTm5WblJSQUIQAA%3D%3D"]],[null,null,11163,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnTURJMW83NnVnRRAB!2m1!1s0x0:0xed48f5263ae95134!3m1!1s2@1:CIHM0ogKEICAgMDI1o76ugE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap