ull,null,null,[7,3]],null,null,[2019,1,19,5,null,null,null,null,["7 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICks-bvjAE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x83da2961476178a4"]],1,null,null,null,null,null,null,["0","-8945792212031932252"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSURJbzhEX3dnRRAB"]],"CIHM0ogKEICAgICks-bvjAE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["這家拉麵店開好久了，十幾年了吧，就算是門前蓋捷運被圍起來又挖的亂七八糟，還是一臉不屹立不搖，可見生意不錯。不過招牌雖是日式拉麵，其實我覺得是台式拉麵，有豚、牛、羊、海鮮等口味及各色小菜，價位130到150元，小菜一碟50元，算是中低價位，麵體粗稍硬，湯頭甚淡，不像日本拉麵一樣的濃厚，這就是我稱它為台式拉麵的原因。如果你追求的不是要正宗日本拉麵的話，其實這種平價的拉麵也不錯吃。",null,[0,189]]]],[null,null,null,null,null,"https://business.google.com/local/business/4576938983226645281/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpiemhFWDNkblJSQUIQAA%3D%3D",[null,null,null,"/local/business/4576938983226645281/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpiemhFWDNkblJSQUIQAA%3D%3D"],"https://business.google.com/local/business/4576938983226645281/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpiemhFWDNkblJSQUIQAA%3D%3D",[null,null,null,"/local/business/4576938983226645281/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpiemhFWDNkblJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/4576938983226645281/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpiemhFWDNkblJSQUIQAA%3D%3D",[null,null,null,"/local/business/4576938983226645281/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkpiemhFWDNkblJSQUIQAA%3D%3D"]],[null,null,5623,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURJbzhEX3dnRRAB!2m1!1s0x0:0x83da2961476178a4!3m1!1s2@1:CIHM0ogKEICAgIDIo8D_wgE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURJbzhEX3dnRRAB\u0026t