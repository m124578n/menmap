ull,null,null,null,null,null,["zh-Hant"],[["一直以來都很喜歡吃辛拉麵，這間店從開幕至今，我每週都會去一次，可以添加青菜雞蛋是我最喜歡的組合，但對於滿玻璃的便利貼，還是希望業者偶爾清一下，或是集中管理，要不飛下來掉到泡麵裡，這樣吃的人也太倒霉了，而且這也意味你們不會清潔玻璃，貼越高的地方就越代表那些人是踩著椅子桌子上去的，當前幾乎玻璃都沒有視野可言，麻煩修正一下，要不中間沒位置坐，窗邊位置坐著越吃越有壓力，好怕飄下來，看見上面有的還有被噴濺的痕跡，更是覺得可怕呀！",null,[0,211]]]],[null,null,null,null,null,"https://business.google.com/local/business/15829066980967673601/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnVNM1JmWlhaM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/15829066980967673601/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnVNM1JmWlhaM1JSQUIQAA%3D%3D"],"https://business.google.com/local/business/15829066980967673601/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnVNM1JmWlhaM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/15829066980967673601/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnVNM1JmWlhaM1JSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/15829066980967673601/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnVNM1JmWlhaM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/15829066980967673601/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnVNM1JmWlhaM1JSQUIQAA%3D%3D"]],[null,null,14194,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURuM3RfZXZ3RRAB!2m1!1s0x0:0x7f1557d12fa9e33e!3m1!1s2@1:CIHM0ogKEICAgIDn3t_evwE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURuM3RfZXZ3RRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURuM3RfZXZ3RRItChZDSUhNMG9nS0VJQ0FnSURuM3RfZWZ3EhNDZ3dJbVpXSnVBWVF5UDNJakFFGi4KF0NJSE0wb2dLRUlDQWdJRG4zdF9lX3dFEhNDZ3dJbVpXSnVBWVF5UDNJakFFIhIJAAAAAAAAAAARPuOpL9FXFX8qCzBiLVplT0daWXY3\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiE68KsxtKWAxWqm68BHXEcM1IQoykIvgEoGw"],null,[null,[[1,0]]]],"0ahUKEwjhhsmsxtKWAxUgeF4EHd5_HfIQ0pMFCEUoAw"],null,null,null,"0ahUKEwiE68KsxtKWAxWqm68BHXEcM1IQ0pMFCIsBK