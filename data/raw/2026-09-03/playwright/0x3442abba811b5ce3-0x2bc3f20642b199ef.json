DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwjFsbHLu9KWAxUiiq8BHQaPJXMQ3YcHCM8BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjFsbHLu9KWAxUiiq8BHQaPJXMQ3IcHCM4BKAQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjFsbHLu9KWAxUiiq8BHQaPJXMQ3IcHCNABKAU",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjFsbHLu9KWAxUiiq8BHQaPJXMQ3IcHCNEBKAY",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjFsbHLu9KWAxUiiq8BHQaPJXMQ3IcHCNIBKAc",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwjFsbHLu9KWAxUiiq8BHQaPJXMQ3YcHCNQBKAA"]]],null,"用餐人數",null,"0ahUKEwjFsbHLu9KWAxUiiq8BHQaPJXMQ3IcHCNMBKAg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjFsbHLu9KWAxUiiq8BHQaPJXMQ3YcHCNYBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjFsbHLu9KWAxUiiq8BHQaPJXMQ3IcHCNUBKAk",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["已經知道這間店非常久了，只聽說需要排隊排很久，所以一直沒有過來吃，就連上一次去日本也都沒吃過，剛好前幾天的中午來到這附近看到沒什麼人排隊就決定試試看了。\n\n一樣會先在外面先畫單，畫完了之後先進去裡面結帳結完帳之後會有人帶位到位置上。\n\n入座之後裡面的內場人員會先跟你要餐點單，如果有點加面的會再給你一個小盤子需要加麵的時候，按桌上的服務裡麵就會送上來了。\n\n那一天去的時候點了一碗麵以及配料，然後加一球麵，總共NT$512，說真的，我覺得不算便宜啊。但吃完之後只覺得好像也就這樣，沒有什麼特別好吃的感覺，有點小空虛，覺得有來體驗過就好。",null,[0,116]]]],[null,null,null,null,null,"https://business.google.com/local/business/11162025794482265594/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhzUWxSNldURmtSV3hZVWtWT1RWSXdVbkJsYldzelRqQTVibUl3UlJBQhAA",[null,null,null,"/local/business/11162025794482265594/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhzUWxSNldURmtSV3hZVWtWT1RWSXdVbkJsYldzelRqQTVibUl3UlJBQhAA"],"https://business.google.com/local/business/1116202