ull,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjvg43vydKWAxV7nK8BHdkBJBEQ3IcHCMUBKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjvg43vydKWAxV7nK8BHdkBJBEQ3IcHCMYBKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjvg43vydKWAxV7nK8BHdkBJBEQ3IcHCMcBKA0",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwjvg43vydKWAxV7nK8BHdkBJBEQ3YcHCMkBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwjvg43vydKWAxV7nK8BHdkBJBEQ3IcHCMgBKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjvg43vydKWAxV7nK8BHdkBJBEQ3YcHCMsBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjvg43vydKWAxV7nK8BHdkBJBEQ3IcHCMoBKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["更新-\n對於這個每次來吃都會感受到他又更好的老闆真的是太敬佩了 好好吃 不確定豬叉燒有沒有多一小片 不論如何一碗200真的太佛心 這次還去掉我不太敢吃的綠色蔬菜和較爲嗆辣的蔥絲換成蔥綠 真正晉升爲我心目中的超完美拉麵\n\n第四次來訪更新-\n這次來跟前幾次比隔了許久\n一般來說不要走味就覺得很開心了\n這家店居然在湯頭上進步那麼多 可見老闆有多用心！之前來比較偏向淡麗系 這次來湯頭多了許多層次 味道也比以前重一些 但我覺得是很好的改變 除了湯頭 肉也比之前好吃超級多 軟嫩肉味足 還多了粗麵可以選擇 不錯吃 細麵直接選擇偏硬比較符合我的口味  而且製作時間感覺也比之前來快上許多 會影響湯頭的筍絲也消失了 現在 無可挑剔🥹 但沒吃到叉燒飯鬱卒\n\n初訪-\n店內位置不多 有時候需要稍作等候 但我覺得蠻值得的喔～上次看到幾個客人看到要排隊就不吃了有點替努力的老闆傷心😢\n老闆製作拉麵乾淨 也很用心 比較喜歡醬油拉麵多一些 不過也許下次我會跟老闆說不用加筍絲（對我來說有點不合且會蓋過原本湯頭的清新）麵體我更喜歡偏硬的！餛飩我覺得普通有多一個味道說不太上來 叉燒飯不錯吃\n拉麵店的位置不是那麼吃香 希望老闆可以撐下去！！！",null,[0,108]]]],[null,null,null,null,null,"https://business.google.com/local/business/11768579949588658584/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZRUjFkclRVOU9iVGhYVERSQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/11768579949588658584/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZRUjFkclRVOU9iVGhYVERSQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/11768579949588658584/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZRUjFkclRVOU9