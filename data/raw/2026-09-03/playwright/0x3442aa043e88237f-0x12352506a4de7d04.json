Q3IcHCIEBKAQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwikrJ7WxNKWAxVfbPUHHXGjLL0Q3IcHCIMBKAU",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwikrJ7WxNKWAxVfbPUHHXGjLL0Q3IcHCIQBKAY",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwikrJ7WxNKWAxVfbPUHHXGjLL0Q3IcHCIUBKAc",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這是第三次來到貴店消費。\n烤鯖魚沒什麼問題，也很難有問題。\n\n重點是炙燒鮭魚毛毛蟲這道料理非常有問題。\n\n1. 上面的起司極少，比細蔥還要少\n2. 壽司卷細的跟什麼一樣，快要跟細卷一樣\n3. 這樣的品質內容要300元\n\n該商品完全不值得這樣的價格，推出這道跟敲詐消費者差不多。\n\n不要跟我說物料上漲的鬼話，有賣毛毛蟲系列的日料大有人在，但是你們的毛毛蟲根本沒有飽足感，吃了個寂寞也很空虛。\n\n建議老闆可以改名\n\n炙燒鮭魚空虛小蝌蚪\n\n這樣的東西好意思堆出來叫毛毛蟲？\n\n我只能說景美人辛苦了這麼不挑。\n\n老闆娘全程臉超臭，忙碌忘了笑容可以理解，但是跟客人互動時臉完全不看客人，話語也很冷漠。\n外場加老闆娘有三個人，啊臉是在臭什麼？\n嫌客人太多嗎？\n\n這樣的店家已經不是之前我聽過那個很厲害的石川了。\n\n今天接待我的一位年輕女員工很好，謝謝她\n但是老闆娘對待客人的態度冷淡又明顯不悅。",null,[0,29]]]],[null,1775867924000000,1775867924000000,"4 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfMFlQcHJaMWFfS19fcEJ0UFJjUlFHUQ%7CCAEQrcz1_gkiMAoZQ0hfMFlQcHJaMWFfS19fcEJ0UFJjUlFHURoTQ2d3SWxMRG16Z1lRdmIydjN3SQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwikrJ7WxNKWAxVfbPUHHXGjLL0Q_2MIhgEoCA"],"https://business.google.com/local/business/16463537660357008373/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrZUZNeVNsQlhWVlpPVWtSV2FWa3dVVEZXV0ZWM1YxWk9UVmx1WXhBQhAA",[null,null,null,"/local/business/16463537660357008373/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrZUZNeVNsQlhWVlpPVWtSV2FWa3dVVEZXV0ZWM1YxWk9UVmx1WXhBQhAA"],"https://business.google.com/local/business/16463537660357008373/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrZUZNeVNsQlhWVlpPVWtSV2FWa3dVVEZXV0ZWM1YxWk9UVmx1WXhBQhAA",[null,null,null,"/local/business/16463537660357008373/customers/reviews/deletereply?p\u003dCkRD