null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3IcHCJgBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3YcHCJoBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3IcHCJkBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_OTHER_DIETARY_RESTRICTIONS_TIPS"],"特殊餐點",null,null,"分享特殊餐點相關資訊","特殊餐點",null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3IcHCJsBKAo",null,null,["免費加麵\n\n有豚骨原味或豚骨辣味。"],null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_GARAGE"],"付費室內停車場",2,null,null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3YcHCJ0BKAA"]]],null,"附近的停車場",null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3IcHCJwBKAs",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3IcHCJ4BKAw",null,null,["景華公園停車場，步行約5分鐘。\n\n近景美捷運站（景美國中出口，上來左邊＇康是美後，繼續往下走不到5分鐘）"],null,null,3,null,2],[["GUIDED_DINING_KID_FRIENDLINESS_TIPS"],"親子友善程度",null,null,"分享親子友善程度相關資訊","親子友善程度",null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3IcHCJ8BKA0",null,null,["非常友善😁😁😁"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:OTHER_DIETARY_RESTRICTIONS"],"特殊餐點",2,null,null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3YcHCKEBKAA"],[["E:PARKING"],"停車場",2,null,null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3YcHCKIBKAE"],[["E:KID_FRIENDLINESS"],"親子友善程度",2,null,null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3YcHCKMBKAI"]]],null,null,null,"0ahUKEwju8r6exNKWAxVcefUHHSBENggQ3IcHCKABKA4",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["赤子拉麵是我最近的心頭好，一試成主顧。\n\n老闆及店員的親切有禮熱情招呼令人印象深刻，\n\n而且進而再與我們娓娓道來他在食材上的堅持，\n\n除了收店後，\n\n仍堅持把控火候用心熬製的靈魂湯頭（絕不添加大骨粉，即使省時省力，但卻不健康）\n\n醬料、味琳、七味辣椒🌶️皆是日本製，只為力求原汁原味。\n\n日本麵粉所製的麵條🍝即使成本高漲，仍不妥協⋯⋯\n\n燉煮入味的叉燒、恰到好處的溏心蛋、不可或缺的祕製筍乾、還有不怕你喝的正宗紅茶。\n\n以上總總⋯⋯成就一碗保有初心，絕不妥協的溫暖美食。\n\n最後，老闆還和我們分享⋯即使熬煮湯頭、配料等等都很辛苦⋯⋯\n\n但只要看到大家吃的開心，\n\n大人小朋友吃的健康，\n\n他就覺得一切都值得，\n\n平價的背後，只是希望大家喜歡這份美味。\n\n最重要的是！！可以免費加麵，讓大家吃飽吃好，但前提是不要浪費，\n\n面對如此有佛心的老闆真的值得讓人好好珍惜及尊重🫡。\n\n期待大家親自造訪，感受一碗有溫度的拉麵🍜 溫暖心也溫暖胃，\n\n當然～也可以和老闆聊天哦😁😁😁",null,[0,42]]]],[null,null,null,null,null,"https://business.google.com/local/business/8865540421718721865/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1V1ZkdFpEWllNbHBYWWxoamVVeFRNRE5WTVZreVdtMW9OazVyUlJBQhAA",[null,null,null,"/local/business/8865540421718721865/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1V1ZkdFpEWllNbHBYWWxoamVVeFRNRE5WTVZreVdtMW9OazVyUlJBQhAA"],"https://business.google.com/local/business/8865540421718721865/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1V1ZkdFpEWllNbHBYWWxoamVVeFRNRE5WTVZreVdtMW9OazVyUlJBQhAA",[null,null,null,"/local/business/8865540421718721865/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1V1ZkdFpEWllNbHBYWWxoamVVeFRNRE5WTVZreVdtMW9OazVyUlJBQhAA"],null,"https://business.google.com/local/business/8865540421718721865/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1V1ZkdFpEWllNbHBYWWxoamVVeFRNRE5WTVZreVdtMW9OazVyUlJBQhAA",[null,null,null,"/local/business/8865540421718721865/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnc1V1ZkdFpEWllNbHBYWWxoamVVeFRNRE5WTVZreVdtMW9OazVyUlJBQhAA"]],[null,null,538,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2w5WVdtZDZYMlpXYlhjeUxTMDNVMVkyWm1oNk5rRRAB!2m1!1s0x0:0x705c905d74060e0c!3m1!1s2@1:CAIQACodChtycF9oOl9YWmd6X2ZWbXcyLS03U1Y2Zmh6NkE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2w5WVdtZDZYMlpXYlhjeUxTMDNVMVkyWm1oNk5rRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2w5WVdtZDZYMlpXYlhjeUxTMDNVMVkyWm1oNk5rRRI-Ci9DQUlRQUNvZENodHljRjlvT2w5WVdtZDZYMlpXYlhjeUxTMDNVMVkyWm1oNk5rRRILMGVBRV9HLXFWcEoaPgo