NG_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwim-43dwdKWAxWagq8BHVKlNl4Q3YcHCGkoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwim-43dwdKWAxWagq8BHVKlNl4Q3IcHCGgoCA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwim-43dwdKWAxWagq8BHVKlNl4Q3IcHCGooCQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwim-43dwdKWAxWagq8BHVKlNl4Q3IcHCGsoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwim-43dwdKWAxWagq8BHVKlNl4Q3IcHCGwoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwim-43dwdKWAxWagq8BHVKlNl4Q3YcHCG4oAA"]],1],null,null,"等待時間",null,"0ahUKEwim-43dwdKWAxWagq8BHVKlNl4Q3IcHCG0oDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["店內空間不算大，但座位安排得很寬敞，整體環境舒適，每到用餐時段幾乎都是客滿狀態，建議早點來或避開尖峰時段。\n\n🍜 正宗豚骨拉麵 $198\n湯頭熱騰騰，豚骨香氣濃郁，麵條充分吸附湯汁，整體口感很不錯，不過個人覺得湯頭稍微偏鹹一些。\n叉燒是偏瘦肉的部分，但口感不柴❤️\n拉麵可以更換成粗麵，也能調整麵條硬度，還提供免費加湯、加麵，對食量大的人來說很加分 😆\n\n除了拉麵本身，最讓我印象深刻的是店員親切又熱情的招呼，一進門就能感受到滿滿的活力，讓人有種回到家的溫暖感覺。整體用餐體驗很不錯，會讓人想再訪☺️",null,[0,68]]]],[null,null,null,null,null,"https://business.google.com/local/business/13779380624614280929/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEzZEZOWE5VdFBWWFJ0VVZoV1dGTkZVbXBOVkZadFlURmFVMWd4UlJBQhAA",[null,null,null,"/local/business/13779380624614280929/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEzZEZOWE5VdFBWWFJ0VVZoV1dGTkZVbXBOVkZadFlURmFVMWd4UlJBQhAA"],"https://business.google.com/local/business/13779380624614280929/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEzZEZOWE5VdFBWWFJ0VVZoV1dGTkZVbXBOVkZadFlURmFVMWd4UlJBQhAA",[null,null,null,"/local/business/13779380624614280929/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEzZEZOWE5VdFBWWFJ0VVZoV1d