HaXMOO0Q3IcHCNMBKAI",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q3YcHCNYBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q3IcHCNUBKAM",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q3IcHCNcBKAQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q3IcHCNgBKAU",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q3IcHCNkBKAY",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q3YcHCNsBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q3IcHCNoBKAc",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q3YcHCN0BKAA"]],1],null,null,"等待時間",null,"0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q3IcHCNwBKAg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["整體用餐體驗尚可。\n餐廳環境維持得算乾淨，用餐空間整潔，飲料吧的選擇也算充足，包含咖啡、蘇打汽水等基本品項，日常用餐需求沒有問題。\n味噌湯的口味屬於中規中矩，但配料相對偏少，如果能增加豆腐或其他配料，整體會更有誠意一些。\n比較可惜的是白飯的補充速度偏慢，實際用餐時曾遇到吃完後一段時間都沒有即時補飯的情況，這點在流程上仍有改善空間。\n餐點種類算是這家店的優勢之一，選擇多元，像是大阪燒、漢堡排等都有提供，對於臨時找不到其他用餐地點時，是一個不錯、相對穩定的選擇。\n整體來說，若以便利性與品項多樣性來看，仍是可以考慮回訪的餐廳。",null,[0,110]]]],[null,1768134079000000,1768134079000000,"7 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfSFR2a1ZYQ05qdGNiR1VORkpUT09FZw%7CCAEQrcz1_gkiMAoZQ0hfSFR2a1ZYQ05qdGNiR1VORkpUT09FZxoTQ2d3SXY2dU95d1lRdC1xemlnTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi75OCSzNKWAxWJUPUHHaXMOO0Q_2MI3gEoCQ"],"https://business.google.com/local/business/29142948