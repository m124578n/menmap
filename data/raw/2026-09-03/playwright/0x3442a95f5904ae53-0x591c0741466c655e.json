INING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjYhZD54tGWAxWpm68BHbhZFEUQ3IcHCK4BKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjYhZD54tGWAxWpm68BHbhZFEUQ3YcHCLABKAA"]],1],null,null,"等待時間",null,"0ahUKEwjYhZD54tGWAxWpm68BHbhZFEUQ3IcHCK8BKAc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["肉跟麵都很有水準，特別是像控肉的那塊，很優秀。麵是細麵，咬感也很好。如果吃不夠，可以免費加麵。我自己加一碗，份量有比我預期還大。\n湯由於是點日式，所以本來就預期比較偏鹹（店家有台式可以選，應該就比較不鹹）。但加麵後，湯有點被稀釋後，味道反而剛剛好。\n可能由於我晚餐時間比較早點的時間到，店員氣氛整體比較輕鬆。喜歡東京醬油拉麵的話，可以來嘗試",null,[0,170]]]],[null,null,null,null,null,"https://business.google.com/local/business/13711334202085843347/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDVG1GSWNGSlRNMHBSVEZaU2RXTlZOV0ZpUkdRMVpVWmFTMUpyUlJBQhAA",[null,null,null,"/local/business/13711334202085843347/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDVG1GSWNGSlRNMHBSVEZaU2RXTlZOV0ZpUkdRMVpVWmFTMUpyUlJBQhAA"],"https://business.google.com/local/business/13711334202085843347/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDVG1GSWNGSlRNMHBSVEZaU2RXTlZOV0ZpUkdRMVpVWmFTMUpyUlJBQhAA",[null,null,null,"/local/business/13711334202085843347/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDVG1GSWNGSlRNMHBSVEZaU2RXTlZOV0ZpUkdRMVpVWmFTMUpyUlJBQhAA"],null,"https://business.google.com/local/business/13711334202085843347/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDVG1GSWNGSlRNMHBSVEZaU2RXTlZOV0ZpUkdRMVpVWmFTMUpyUlJBQhAA",[null,null,null,"/local/business/13711334202085843347/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDVG1GSWNGSlRNMHBSVEZaU2RXTlZOV0ZpUkdRMVpVWmFTMUpyUlJBQhAA"]],[null,null,5748,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pCTmFIcFJTM0pRTFZSdWNVNWFiRGQ1ZUZaS1JrRRAB!2m1!1s0x0:0x591c0741466c655e!3m1!1s2@1:CAIQ