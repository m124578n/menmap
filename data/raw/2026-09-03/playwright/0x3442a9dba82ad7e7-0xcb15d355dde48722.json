類型",null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3IcHCFkoCA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3YcHCFwoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3IcHCFsoCQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3IcHCF0oCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3IcHCF4oCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3IcHCF8oDA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11h0w3fthc"],"炙燒叉燒飯",2,null,null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3YcHCGEoAA"],[["M:/g/11pf5_h7nk"],"豚骨叉燒拉麵",2,null,null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3YcHCGIoAQ"],[["M:/g/11x0n84p3s"],"豚骨系 金沢拉麵",2,null,null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3YcHCGMoAg"]],[1]],null,"建議的餐點",null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3IcHCGAoDQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3YcHCGUoAA"]],1],null,null,"等待時間",null,"0ahUKEwjO2P6pu9KWAxXbffUHHX-NJp8Q3IcHCGQoDg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["（歡迎ig搜尋全麵啟動，探索更多拉麵和麵食！）\n\n（定番）豚骨系 金沢拉麵+叉燒飯（當時價格$210+$50）➡️（現在價格$250+60）\n\n豚骨系金沢ラーメンNT$250\nチャーシュー丼NT$60\n\n2023/5晚\n\n整體評分（4.2🌟）\n\n🍜【食記】金沢拉麵｜中山區平價拉麵代表之一！無限加麵！\n\n沒有低消一碗麵的規則！\n沒有低消一碗麵的規則！\n沒有抵銷一碗麵店的規則！\n\n可以單獨點叉燒飯！但不能共食！\n\n（當時造訪時是這樣，但目前不確定是否已更改規則！）\n\n⌚️【新企画】アーカイブから蘇る、思い出の定番・限定ラーメン(Day1)\n\n【🍜 新系列公告：那些年，我們一起追的拉麵回憶錄】\n\n這個系列會著重在分享我以往「吃過的拉麵與麵食」！這些都是以前吃、沒做食記前，沒好好完整記錄下來的寶藏照片，所以這次打算用回憶的視角，重新整理給大家。\n\n關於這個系列的「真心話告白」：\n\n📌 關於店家資訊： 只要我還查得到或還記得，就會標註！如果店家不幸歇業，或品項已經停售，我也會特別註記，當然，如果資訊有誤，超級歡迎各位麵友在留言區指正與補充！\n\n📌 關於口味細節： 那些排隊時間、湯頭鹹度、麵條硬度等細節……實不相瞞，我大概率已經忘光了（😅）。\n\n如果我還沒失憶，我會憑著最後的殘存記憶大概寫一下；如果真的不小心忘記了，就先跟各位麵友說聲抱歉啦！🙏\n\n💡 最後\n\n希望這個回憶系列大家能看得輕鬆，或許在這些照片裡，也能激起你曾經吃到那碗麵的回憶！\n\n不論是哪一碗讓你念念不忘、或是聽說過卻沒吃到的「限定神作」而感到惋惜的，又或者是比較新入坑的麵友，在這裡看到開啟你拉麵世界的「啟蒙入坑作」……\n\n都很歡迎在留言區一起閒聊、討論，留下你的看法！來跟我聊聊你記憶中的那碗麵吧！👇\n\n📒店家介紹/個人記憶中的味道\n\n位於台北晴光商圈附近的 金沢拉麵，以高 CP 值、客製化湯頭以及免費加麵加飯吃到飽聞名的日式拉麵店，主打日本風味與貼心的飽足服務，在中山區拉麵一級戰區中擁有極高的人氣與網路好評，且Google 評價高達4.5🌟（2088）！\n\n拉麵風味個人印象中就是偏單薄的豚骨湯，就是偏向平價拉麵的風味（非貶義），就是那種偶爾想解拉麵饞又不想花太多錢的好所在，也非常推薦學生或是大食量的食客來大快朵頤！\n\n整體論口味個人較喜歡「叉燒飯」！就是一碗標準好吃的炙燒美乃滋風格叉燒飯！\n\n且店家因為沒有抵銷一碗麵的規則，所以之後個人也有來光顧幾次，單獨品嚐叉燒飯😁\n\n【拉麵考古日誌】Day6",null,[0,70]]]],[null,null,null,null,null,"https://business.google.com/local/business/7893380568511255014/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTVZreWNHdFNlbFpDWkd4d1dHUnRhSGRZTVdoR1pHMW9NRlJYWXhBQhAA",[null,null,null,"/local/business/7893380568511255014/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTVZreWNHdFNlbFpDWkd4d1dHUnRhSGRZTVdoR1pHMW9NRlJYWXhBQhAA"],"https://business.google.com/local/business/7893380568511255014/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTVZreWNHdFNlbFpDWkd4d1dHUnRhSGRZTVdoR1pHMW9NRlJYWXhBQhAA",[null,null,null,"/local/business/7893380568511255014/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTVZreWNHdFNlbFpDWkd4d1dHUnRhSGRZTVdoR1pHMW9NRlJYWXhBQhAA"],null,"https://business.google.com/local/business/7893380568511255014/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTVZreWNHdFNlbFpDWkd4d1dHUnRhSGRZTVdoR1pHMW9NRlJYWXhBQhAA",[null,null,null,"/local/business/7893380568511255014/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTVZreWNHdFNlbFpDWkd4d1dHUnRhSGRZTVdoR1pHMW9NRlJYWXhBQhAA"]],[null,null,2416,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tZMVkycGtSelZCZGxwWGRtaHdYMWhGZG1oMFRXYxAB!2m1!1s0x0:0xcb15d355dde48722!3m1!1s2@1:CAIQACo