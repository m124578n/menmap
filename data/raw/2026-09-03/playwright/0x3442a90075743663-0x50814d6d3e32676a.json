,["11 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhB8yAeRo11ON3zydFKW1Pii\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x50814d6d3e32676a"]],1,null,null,null,null,null,null,["0","5801002926620174186"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT205RlgwNUxibkJrTjB0cWVUQXRWa2QzWWxOTlluYxAB"]],"CIABIhB8yAeRo11ON3zydFKW1Pii",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiI3MauydKWAxVyVPUHHd5HC5sQ3IcHCNACKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiI3MauydKWAxVyVPUHHd5HC5sQ3IcHCNECKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiI3MauydKWAxVyVPUHHd5HC5sQ3IcHCNICKAw",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["價格：合理\n口味：不錯\n推薦👍\n\n點餐：一人一張單，填寫桌號點餐\n付費：現金（餐後付，無服務費）\n廁所：有提供\n\n熟成酥炸腰內肉，口感很嫩不油膩不乾柴，外皮酥脆跟內肉對比，咬下去會驚艷\n\n黑金豬排很像是食用級炭粉製作，不太確定（？），外表滿吸睛，但還是更推推腰內，肉口感更佳\n\n昭和烤布丁也很推，雞蛋、牛奶、細砂，簡單的原料，調味出完美比例，口感綿密到不行～好吃\n\n好吃的豬排一定要有好吃的飯，飯很粒粒分明，加上嫩蛋真的好吃，很容易讓人默默把飯扒完。\n\n起士在鐵盤上滋滋作響，料理時就會一陣香味撲鼻而來，端上桌還在跳舞。黑咖喱則是很香很濃郁，是特別的咖喱，各有特色。\n\n但不管是豬排、咖喱、起司，整體都有稍稍鹹，所以不太吃很重口味的可能不會愛這家豬排，但愛的人反而會覺得每一道都很夠味！\n\n出餐速度蠻快的，店內位子不多，所以客滿需要店內或者店外候位（店內只有四張候位椅子），對面的姐妹拉麵店也很熱門，通常比豬排更排，幸運對面沒有太排，可以考慮吃拉麵，宵夜時段豬排這也會有拉麵可以點～",null,[0,15]]]],[null,1759824548000000,1759824548000000,"10 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQmNHMlBGZnR3ZzVHQnotTUluSEdjQQ%7CCAEQrcz1_gkiMAoZQ0hfQmNHMlBGZnR3ZzVHQnotTUluSEdjQRoTQ2d3SXBKV1R4d1lReU9lZjF3TQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiI3MauydKWAxVyVPUHHd5HC5sQ_2MI0wIoDQ"],"https://business.google.com/local/business/2352181450637619959/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1Umxnd05VeGlia0pyVGpCMGNXVlVRWFJXYTJReldXeE9UbGx1WXhBQhAA",[null,null,null,"/local/business/23