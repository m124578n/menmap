G_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3YcHCPQBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3IcHCPMBKBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3YcHCPYBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3IcHCPUBKBE",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3YcHCPgBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3IcHCPcBKBI",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3IcHCPkBKBM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3IcHCPoBKBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3IcHCPsBKBU",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["隱身在靜巷裡面，店家門口外面種植很多鹿角蕨，直覺鹿角蕨種植的非常好，也蠻有特色的，認真的看著植栽，而沒有注意到店家到了，差一點錯過了....\n一進門老闆親切的招呼找位置坐，菜單在桌上，菜色選擇性也是很多，挑好喜歡吃的拉麵，再到櫃檯跟老闆點餐，完食之後，再到櫃檯買單就可以了。\n\n今天想吃泡菜叉燒麵，餐點很快就送上來了，熱呼呼的湯頭，先喝一口暖暖胃，口感濃郁好喝喔！\n叉燒也是入口即化 ，半顆溏心蛋，口感軟嫩，好吃！\n點餐時老闆問要不要加點一份燙青菜，是皇宮菜，但裡面有多了一些高麗菜，一樣是蔬菜，都好吃～",null,[0,137]]]],[null,1729068526000000,1729068526000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQkY1Y0VRSUVlblZuRDMzdUFBREhEdw%7CCAEQrcz1_gkiLwoZQ0hfQkY1Y0VRSUVlblZuRDMzdUFBREhEdxoSQ2dzSTd2dTl1QVlRa3FfdEZB\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ_2MI_AEoFg"],"https://business.google.com/local/business/716550025998383581/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTllNVzlNTUZsbkVBRRAA",[null,null,null,"/local/business/716550