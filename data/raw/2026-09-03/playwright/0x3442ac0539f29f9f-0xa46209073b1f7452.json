],null,null,[2023,2,27,6,null,null,null,null,["3 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDh4J_KOQ\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xa46209073b1f7452"]],1,null,null,null,null,null,null,["0","-6601704177110387630"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSURoNEpfS2FREAE"]],"CIHM0ogKEICAgIDh4J_KOQ",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3YcHCMwBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3IcHCMsBKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3YcHCM4BKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3IcHCM0BKAY",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3YcHCNABKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ3IcHCM8BKAc",null,null,null,null,null,1,[[2]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["店面小小的，但裝飾跟餐點不馬虎！\n豚骨正油叉燒拉麵有四片叉燒，叉燒雖然不大但肥瘦比例剛好，入口即化😋\n溏心蛋是我喜歡的熟度，而且蠻大顆的！\n湯頭應該有配合台灣人口味調整，不是那種油脂濃厚的湯\n擔擔麵辣度夠，湯算好入口，如果覺得不夠辣還可以自己加辣粉、辣油等\n冰水、置物籃、掛衣勾也都有提供\n食量大的可以點水餃套餐，韭菜水餃（有5顆）餡料蠻鮮美，不知道是不是有包蝦皮之類的，但皮是偏軟的\n麥乳紅茶是特別從雲林運上來賣的，是老闆的童年回憶，喝起來是清爽微甜的決明子紅茶，吃完擔擔麵來一杯超絕配！\n店家服務態度很好，親切介紹，價格又親民，放的日文歌也好聽，我們13:40才到店家還是讓我們內用，會再來吃的！",null,[0,69]]]],[null,1680510392000000,1680510392000000,"3 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQ3NsSGp4OExQRFZrY1VyQkFBZUlxUQ%7CCAEQrcz1_gkiMAoZQ0hfQ3NsSGp4OExQRFZrY1VyQkFBZUlxURoTQ2d3SXVKdXFvUVlRcUxhdzBBRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ_2MI0QEoCA"],"https://business.google.com/local/business/716550025998383581/customers/reviews/reply?p\u003dCiNDaFpEU1V