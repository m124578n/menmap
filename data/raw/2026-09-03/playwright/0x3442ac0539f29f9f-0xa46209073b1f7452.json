ull,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["拉麵價格便宜\n門口種滿了鹿角蕨等綠色植栽，一走近就有種療癒的感覺\n店內裝潢帶有濃厚日式風格，窗邊還擺滿了許多袖珍小物，整體氛圍溫馨又有趣。\n\n🔸鐵絲麵是我喜歡的那種超硬口感，咬起來很有勁\n🔸湯頭鹹味恰到好處，配料有海帶芽跟筍乾，但我個人不太喜歡筍乾的味道，稍微蓋過了湯的風味。\n🔸叉燒偏肥，但肉質軟嫩，喜歡油脂豐富口感的話應該會很滿足。",null,[0,69]]]],[null,1748215708000000,1748215708000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfb0pFN042eXZKNWFRMXNTM0QwZnpTZw%7CCAEQrcz1_gkiMAoZQ0hfb0pFN042eXZKNWFRMXNTM0QwZnpTZxoTQ2d3SW5NX093UVlRc0phb3JBTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjAmu-owtKWAxVQhq8BHS0uBFMQ_2MIpgEoFw"],"https://business.google.com/local/business/716550025998383581/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZLWm1WNmMycFFiRGRUWTNCblJSQUIQAA%3D%3D",[null,null,null,"/local/business/716550025998383581/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZLWm1WNmMycFFiRGRUWTNCblJSQUIQAA%3D%3D"],"https://business.google.com/local/business/716550025998383581/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZLWm1WNmMycFFiRGRUWTNCblJSQUIQAA%3D%3D",[null,null,null,"/local/business/716550025998383581/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZLWm1WNmMycFFiRGRUWTNCblJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/716550025998383581/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZLWm1WNmMycFFiRGRUWTNCblJSQUIQAA%3D%3D",[null,null,null,"/local/business/716550025998383581/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZLWm1WNmMycFFiRGRUWTNCblJSQUIQAA%3D%3D"],null,["zh-Hant"],[["你說了這麼多好處 結果才三顆星…",null,[0,16]]]],[null,null,7479,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VKZmV6c2pQbDdTY3BnRRAB!2m1!1s0x0:0xa46209073b1f7452!3m1!1s2@1:CIHM0ogKEJfezsjPl7ScpgE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VKZmV6c2pQbDdTY3BnRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VKZmV6c2pQbDdTY3BnRRIuChdDSUhNMG9nS0VMbkY0XzJvNU5YaTh3RRITQ2d3S