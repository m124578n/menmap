ww.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfbjRaT0gtNzNXOHNNVlhRVWFTeHJvdw%7CCAEQrcz1_gkiMAoZQ0hfbjRaT0gtNzNXOHNNVlhRVWFTeHJvdxoTQ2d3STJhTEIwd1lRdW9YYnVRRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ_2MIWigJ"],"https://business.google.com/local/business/4301875029726507551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhWmsxRVNqWmlhMVYzWlZob01WVklRbmhWTVRnMVpIcEdZVTB3UlJBQhAA",[null,null,null,"/local/business/4301875029726507551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhWmsxRVNqWmlhMVYzWlZob01WVklRbmhWTVRnMVpIcEdZVTB3UlJBQhAA"],"https://business.google.com/local/business/4301875029726507551/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhWmsxRVNqWmlhMVYzWlZob01WVklRbmhWTVRnMVpIcEdZVTB3UlJBQhAA",[null,null,null,"/local/business/4301875029726507551/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhWmsxRVNqWmlhMVYzWlZob01WVklRbmhWTVRnMVpIcEdZVTB3UlJBQhAA"],null,"https://business.google.com/local/business/4301875029726507551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhWmsxRVNqWmlhMVYzWlZob01WVklRbmhWTVRnMVpIcEdZVTB3UlJBQhAA",[null,null,null,"/local/business/4301875029726507551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhWmsxRVNqWmlhMVYzWlZob01WVklRbmhWTVRnMVpIcEdZVTB3UlJBQhAA"],null,["zh-Hant"],[["親愛的顧客您好，\n感謝您蒞臨一風堂板橋環球店，為嚴守一風堂道地的經典口味，拉麵豚骨湯頭堅持長時間熬煮12-14小時，且麵條皆是自家製麵，每樣餐點皆是來自在地的安心食材，以提供良好的品質予我們的顧客，在成本與售價是經過審慎地衡量後設定，謝謝您與我們分享您的用餐心得。我們會秉持提供優質的用餐環境與美味的餐點，持續以此不斷精進自我，以款待的心服務每位顧客。\n祝日安\n台灣一風堂敬上 J",null,[0,8]]]],[null,null,434,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21aZk1ESjZia1V3ZVhoMVVIQnhVMTg1ZHpGYU0wRRAB!2m1!1s0x0:0xecc9f1197a3e2e28!3m1!1s2@1:CAIQACodChtycF9oOmZfMDJ6bkUweXh1UHBxU185dzFaM0E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQ