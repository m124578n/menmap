BKAg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3YcHCMgBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3YcHCMkBKAE"]]],null,"用餐人數",null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3IcHCMcBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_LOT"],"付費停車位",2,null,null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3YcHCMsBKAA"]]],null,"附近的停車場",null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3IcHCMoBKAo",null,null,null,null,null,3,null,2],[["GUIDED_DINING_KID_FRIENDLINESS_TIPS"],"親子友善程度",null,null,"分享親子友善程度相關資訊","親子友善程度",null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3IcHCMwBKAs",null,null,["不適合。"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3YcHCM4BKAA"],[["E:KID_FRIENDLINESS"],"親子友善程度",2,null,null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3YcHCM8BKAE"]]],null,null,null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3IcHCM0BKAw",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["特製辣肉味噌拉麵非常美味。\n煎餃🥟也很不錯。\n\n隸屬於板橋車站內的拉麵店，當中不乏在交通上轉乘的旅客，這邊的步調比較快，不是親子餐廳可以悠閒享受天倫之樂。\n\n店員非常賣力工作，看得出店內人手不足，收桌、結帳、送餐、帶位，還要解決突發狀況，分身乏術。\n\n若想和朋友好好吃個拉麵，建議避開尖峰時段前往。非要週末晚上這種超尖峰時段用餐，再來靠北出餐太慢，那根本是必然的、自找的，而且相較於中山部分拉麵名店動輒排上一小時，這是非常快速有效率了。",null,[0,22]]]],[null,null,null,null,null,"https://business.google.com/local/business/4301875029726507551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4TldSdGJHRlRNMEl3WkRJeGVXSlhPVFZqVnpGNFRraG9VR1JHUlJBQhAA",[null,null,null,"/local/business/4301875029726507551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4TldSdGJHRlRNMEl3WkRJeGVXSlhPVFZqVnpGNFRraG9VR1JHUlJBQhAA"],"https://business.google.com/local/business/4301875029726507551/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4TldSdGJHRlRNM