l,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_600_TO_800"],"$600-800",2,null,"$600 到 $800","0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3YcHCJkBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3IcHCJgBKBk",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3IcHCJoBKBo",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3IcHCJsBKBs",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3IcHCJwBKBw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3YcHCJ4BKAA"]],1],null,null,"等待時間",null,"0ahUKEwj2t9KvxtKWAxVLiK8BHa8sKzMQ3IcHCJ0BKB0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["Between Ippudo and Raku Ramen, it’s honestly not even the same level. Ippudo clearly wins on flavor — richer, deeper broth, and you can tell there’s real effort behind it.\n\nBut the table setup is a mess. With condiments, menus, water jugs, cups, and free bean sprouts all crammed together, the space feels way too tight — noticeably smaller than Raku Ramen’s.\n\nYou basically have to eat carefully the whole time, or you’ll end up knocking a cup or jug off the table.\n\n一風堂 跟 樂麵屋 之間，其實老實說根本不太算同一個等級的比較。一風堂在味道上還是明顯勝出，湯頭更濃郁、有層次，至少吃得出來是有在認真做的。\n\n不過他們的桌面配置真的讓人有點頭痛。小菜、菜單、水壺、杯子，還有免費豆芽菜全部擠在桌上，空間非常狹小，明顯比樂麵屋能放餐點的桌面還要小很多。吃個拉麵還要時時刻刻注意手的動作，不然一個不小心就很容易把杯子或水壺掃到地上。\n\n只能說，一風堂是味道贏，但用餐體驗有時候真的讓人有點壓力。",null,[0,171]]]],[null,1777446221000000,1777446221000000,"4 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfRVRuM2hDMFNzUEZnZmV0ajBoUG1rUQ%7CCAEQrcz1_gkiMAoZQ0hfRVRuM2hDMFNzUEZnZmV0ajBoUG1rURoTQ2d3SXpkckd6d1lRcjR2OG1nRQ\u0026t\u003d7\u0026wv\u003d1\u