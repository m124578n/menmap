UKEwiL0r_VytKWAxVHevUHHYxxK_AQ3YcHCF4oAQ"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3YcHCF8oAg"]]],null,"用餐人數",null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3IcHCFwoCw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3YcHCGEoAA"]],1],null,null,"等待時間",null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3IcHCGAoDA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_PLENTY_OF_PARKING"],"很多停車位",2,null,null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3YcHCGMoAA"]],1],null,null,"停車位",null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3IcHCGIoDQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_LOT"],"付費停車位",2,null,null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3YcHCGUoAA"],[["E:PARKING_OPTION_NO_PARKING"],"不提供停車位",2,null,null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3YcHCGYoAQ"]]],null,"附近的停車場",null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3IcHCGQoDg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3IcHCGcoDw",null,null,["隔壁小碧潭站京站時尚廣場（Ikea共用）一樓側門出來走路一分鐘可達"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3YcHCGkoAA"]]],null,null,null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3IcHCGgoEA",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["每天都有不同的主題餐，今天輪到想吃鯖魚飯，就一如往常的搜尋孤狗map結果找到這間五公里遠的，評論相片看起來不錯，因為要去IKEA剛好可以停在京站停車場，下到一樓打開側門（對的，需要打開-因為是關著的）依照導航走一分鐘就到啦，這樣最快。也可以從山東餃子館（N年沒吃了，人一樣多到爆）巷子往前走一分鐘。\n\n1.服務及氣氛\n氣氛尚可，沒有聽到放音樂，可能因為已經一點了。一桌都沒有，老闆娘還是熱情招呼。小缺點因為沒有紗窗，有一隻蒼蠅飛進來有點討厭。\n\n2.鯖魚定食（上面是寫鯖魚丼飯）$230\n強烈建議點大份的，非常大隻啊！而且真的烤得非常好👍香度跟脆度都是極品，一半台灣餐廳烤的不冷不熱的而且不夠焦真的就不好吃。飯的配菜還蠻多，雖偏重台式風味，無妨。另外附湯也非常熱而且不馬虎。\n\n3.日式豆腐$40\n冷豆腐加上醬汁，讓人一口接一口不知不覺就吃完了，意猶未盡。\n\n後來發現他還有賣我最愛的烤香魚$150 沒發現，下次一定會再來品嚐看看。如果硬要說缺點，那可能就是沒有附冰開水、建議可以補充一下。而且椒鹽粉建議多一點呀（畢竟鯖魚很大）。總之，是還會再來的店。",null,[0,149]]]],[null,null,null,null,null,"https://business.google.com/local/business/13296167366594652368/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVGZWxWNlp6RlZlVEZ3VG0wNWNGVkRNWGxUUjFKMlpVaEdWMDFGUlJBQhAA",[null,null,null,"/local/business/13296167366594652368/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVGZWxWNlp6RlZlVEZ3VG0wNWNGVkRNWGxUUjFKMlpVaEdWMDFGUlJBQhAA"],"https://business.google.com/local/business/13296167366594652368/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVGZWxWNlp6RlZlVEZ3VG0wNWNGVkRNWGxUUjFKMlpVaEdWMDFGUlJBQhAA",[null,null,null,"/local/business/13296167366594652368/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVGZWxWNlp6RlZlVEZ3VG0wNWNGVkRNWGxUUjFKMlpVaEdWMDFGUlJBQhAA"],null,"https://business.google.com/local/business/13296167366594652368/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVGZWxWNlp6RlZlVEZ3VG0wNWNGVkRNWGxUUjFKMlpVaEdWMDFGUlJBQhAA",[null,null,null,"/local/business/13296167366594652368/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVGZWxWNlp6RlZlVEZ3VG0wNWNGVkRNWGxUUjFKMlpVaEdWMDFGUlJBQhAA"]],[null,null,3082,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25FelV6ZzFVeTFwTm05cFVDMXlTR1J2ZUhGV01FRRAB!2m1!1s0x0:0xb341d0012b0cae78!3m1!1s2@1:CAIQACodChtycF9oOnEzUzg1Uy1pNm9pUC1ySGRveHFWMEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25FelV6ZzFVeTFwTm05cFVDMXlTR1J2ZUhGV01FRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25FelV6ZzFVeTFwTm05cFVDMXlTR1J2ZUhGV01FRRI-Ci9DQUlRQUNvZENodHljRjlvT25FelV6ZzFVeTFwTm05cFVDMXlTR1J2ZUhGV01FRRILMGRjUkhJN1ZkY1EaPgovQ0FJUUFDb2RDaHR5Y0Y5b09uRXpVemcxVXkxcE5tOXBVQzF5U0dSdmVIRldNRUUSCzBkY1JISTdWZGNRIhIJAAAAAAAAAAAReK4MKwHQQbMqCzBkY1JIST