ull,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["花生豆腐的口味吃起來有點像中華豆花\n牛肉丼飯跟親子丼如果沒加七味粉會覺得味道有點平淡\n因為是屬於濕式的丼飯\n海鮮烏龍麵湯好喝不過也是中規中矩沒特別感覺\n杏鮑菇正常好吃份量也蠻多的\n總統來說沒有留下記憶點\n不過人潮不斷已經經過很多次常常吃不到\n算是那一帶很熱門的店家\n\n給兩顆星是因為自己的評分標準是不會回訪的給兩顆\n但是不會不好吃\n廁所非常乾淨不過充滿不天然香味\n然後冷氣有點不給力吃得好熱",null,[0,53]]]],[null,null,null,null,null,"https://business.google.com/local/business/13296167366594652368/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUndMWE5VUVd4blJSQUIQAA%3D%3D",[null,null,null,"/local/business/13296167366594652368/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUndMWE5VUVd4blJSQUIQAA%3D%3D"],"https://business.google.com/local/business/13296167366594652368/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUndMWE5VUVd4blJSQUIQAA%3D%3D",[null,null,null,"/local/business/13296167366594652368/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUndMWE5VUVd4blJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/13296167366594652368/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUndMWE5VUVd4blJSQUIQAA%3D%3D",[null,null,null,"/local/business/13296167366594652368/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUndMWE5VUVd4blJSQUIQAA%3D%3D"]],[null,null,14798,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURwLXNUQWxnRRAB!2m1!1s0x0:0xb341d0012b0cae78!3m1!1s2@1:CIHM0ogKEICAgIDp-sTAlgE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURwLXNUQWxnRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURwLXNUQWxnRRIsChZDSUhNMG9nS0VJQ0FnSURwLXNUQVZnEhJDZ3NJeHZTSXB3WVFvT1B3WGcaLgoXQ0lITTBvZ0tFSUNBZ0lEcC1zVEExZ0USE0Nnd0lsZk9JcHdZUTJPeVhtUUUiEgkAAAAAAAAAABF4rgwrAdBBsyoLMFpzWWQ1QXIyNVY\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQoykI-AEoDA"],null,[null,[[1,1]]]],"0ahUKEwi92MbVytKWAxWN_4sBHYjvBzwQ0pMFCJwBKAY"],null,null,null,"0ahUKEwiL0r_VytKW