0ahUKEwiL0r_VytKWAxVHevUHHYxxK_AQ3IcHCNwBKBQ",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["今天約了下午來安裝牙科工作台，中午就近Google…想著吃拉麵還是美式漢堡，評價都很讚，走著走著Michael喊一聲丼飯丼飯、我要吃丼飯…於是決定吃丼飯🙂\n\n落地玻璃窗格大門，需要研究一下方才得其門而入…\n\n小店佈置得雅緻簡單、日式風格妝點…有個很大的廚房\n\n二人不約而同點了鹽烤松阪丼飯，先上了胡麻醬涼拌龍鬚菜和墨魚香腸…這個微熱的天氣，龍鬚菜好吃，淋上胡麻醬就更美味，再加上柴魚片…所謂和風大概就是這個風味吧…挺開胃的；墨魚香腸看起來有些怪怪，吃起來倒是讓人眼睛一亮，不油膩膩嚼到墨魚肉時還有脆脆的口感，好吃的配菜👍\n\n主食很清爽健康，配菜大多都是經過簡單烹飪松阪豬肉體貼地切了小片，片片大小適口，全瘦彈牙潤口不柴，熟度剛好就簡單薄鹽提味…\n\n人均310元，大概是平日的二倍預算…比較困惑的是覺得台味蠻重🤔",null,[0,102]]]],[null,null,null,null,null,"https://business.google.com/local/business/13296167366594652368/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMWWkxb2NGUnZjblpRWldOUkVBRRAA",[null,null,null,"/local/business/13296167366594652368/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMWWkxb2NGUnZjblpRWldOUkVBRRAA"],"https://business.google.com/local/business/13296167366594652368/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMWWkxb2NGUnZjblpRWldOUkVBRRAA",[null,null,null,"/local/business/13296167366594652368/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMWWkxb2NGUnZjblpRWldOUkVBRRAA"],null,"https://business.google.com/local/business/13296167366594652368/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMWWkxb2NGUnZjblpRWldOUkVBRRAA",[null,null,null,"/local/business/13296167366594652368/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZMWWkxb2NGUnZjblpRWldOUkVBRRAA"]],[null,null,7319,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VLYi1ocFRvcnZQZWNREAE!2m1!1s0x0:0xb341d0012b0cae78!3m1!1s2@1:CIHM0ogKEKb-hpTorvPecQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VLYi1ocFRvcnZQZWNREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VLYi1ocFRvcnZQZWNREi4KF0NJSE0wb2dLRUwtS3ZwWFFsc1RMb1FFEhNDZ3dJNHU2WHdRWVEyTi1WcGdJGi0KFkNJSE0wb2dLRUpQTXpPeXFfOF96Y2cSE0Nnd0k0dTZYd1FZUTJOLVZwZ0kiEgkAAAAAAAAAABF4rgwrAdBBsyoLMGM4VVNYWmxMek4\u0026wv\u003d1\u0026d\u003d2867