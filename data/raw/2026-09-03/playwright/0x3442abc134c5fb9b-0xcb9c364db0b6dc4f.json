,[2025,5,27,1,null,null,null,null,["1 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKELPvkt3esbjHQQ\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xcb9c364db0b6dc4f"]],1,null,null,null,null,null,null,["0","-3775082680338162609"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJNnB1NkxtMEltRTN3RRAB"]],"CIHM0ogKELPvkt3esbjHQQ",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjPwfXhu9KWAxVfafUHHYAsMw8Q3IcHCLsBKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjPwfXhu9KWAxVfafUHHYAsMw8Q3IcHCLwBKA0",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjPwfXhu9KWAxVfafUHHYAsMw8Q3IcHCL0BKA4",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["味道濃郁、麵體硬度掌握熟練的拉麵店\n個人很喜歡蒜末\n所以點了蒜味豚骨$270\n另外看評論跟著點了叉燒飯$80\n\n非常喜歡湯頭，是濃郁但不膩口的類型\n個人喜歡硬麵、粗麵\n老闆對火候掌握不錯，有達到標準\n配上糖心蛋攪著麵吃是絕配\n海苔、叉燒肉、筍乾的挑選\n有非常均衡的融成一體👍\n\n叉燒飯是加了起司，用噴燈加熱\n上桌不要碰碗！會被燙到\n（老闆馬上提醒，但下意識耍白痴還是伸手想去拿碗w)\n叉燒切成小塊很好入口\n飯不會乾柴，反而濕潤度剛好\n配上噴燈烤出的微焦\n吃起來很香很滿足👍\n\n呼籲吃完半碗\n再考慮要不要加麵\n因為真的很飽！\n女生就不用想了  份量真的足夠\n推薦愛濃郁、能吃較重鹹湯頭的拉麵愛好者",null,[0,38]]]],[null,1748357893000000,1748357919000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfSTRDUzgxTGZTOWtPQkJKYVRqM0NQQQ%7CCAEQrcz1_gkiMAoZQ0hfSTRDUzgxTGZTOWtPQkJKYVRqM0NQQRoTQ2d3SW42Ylh3UVlRakktSnlBSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjPwfXhu9KWAxVfafUHHYAsMw8Q_2MIvgEoDw"],"https://business.google.com/local/business/16590333653993244686/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKTm5CMU5reHRNRWx0UlROM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/16590333653993244686/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKTm5CMU5reHRNRWx0UlROM1JSQUIQAA%3D%3D"],"https://business.google.com/local/business/16590333653993244686/customers/r