766,24.980366523940877],[0,90],[2268,4032],75],"GICZat6pFrnb1e8PgJuo6QE","0ahUKEwjelc_Wy9KWAxW5bfUHHYANKh0QzCcIogEoFQ",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIC38LzzeQ\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xc16bb7dac332b73e",null,null,"0ahUKEwjelc_Wy9KWAxW5bfUHHYANKh0Q-y4IowEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIC38LzzeQ"],[10,3,[4032,2268]],[null,null,null,null,null,null,null,["麵匡匡拉麵食堂 樹林中華店"]],[null,[[["kiki chen"],"https://www.google.com/maps/contrib/109609015933240873838?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjXH8FK3E5lu-71hUPppDo76rR97n0EjrCSHZzdGqL2tIHrK9JkWzw\u003ds120-c-rp-mo-ba12-br100",null,null,"109609015933240873838"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2024,11,2,5,null,null,null,null,["1 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIC38LzzeQ\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xc16bb7dac332b73e"]],1,null,null,null,null,null,null,["0","-4509308451675785410"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUMzOEx6ejRRRRAB"]],"CIHM0ogKEICAgIC38LzzeQ",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjelc_Wy9KWAxW5bfUHHYANKh0Q3IcHCKQBKBY",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjelc_Wy9KWAxW5bfUHHYANKh0Q3IcHCKUBKBc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjelc_Wy9KWAxW5bfUHHYANKh0Q3IcHCKYBKBg",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["又是尷尬的時間點，剛好家裡附近看了一家麵框框，來去嚐鮮看看，裝潢很有日式風格，現場位置也是日式方式，位置不多有一排單人櫃檯，3桌2-4人位置。還蠻容易客滿的因為位置不多很有可能會在外面叫號等位置。\n今天點了川味炙燒牛拉麵、明太子叉燒飯、櫛瓜玉米筍、胡麻龍鬚菜、糖心蛋、紅茶…似乎點很多，感覺會吃很飽，其實剛剛好而已…\n原本被濃濃的炙燒味吸引，但麵一來我有點驚訝（因為太小碗，對於胃口小的女孩可能剛好，我一定不夠吃），炙燒很香但是我覺得有點空虛，是炙燒牛肉片（牛肉片很薄，可能我自己想成日式叉燒那樣厚一點），湯頭因為是川味很鹹不辣（我個人覺得，整體吃下來讓我想起“豚將”的單人版，只是麵無法加麵，口味來說很類似），明太子叉燒飯（一上桌我還是傻眼，因為吃過真正日式的叉燒飯，雖然一樣很小碗，但叉燒是塊狀吃的出塊狀叉燒濃郁口腔的感受）叉燒飯也是片狀，加上明太子整體偏鹹（我個人不愛）但喜歡吃叉燒飯也是可以點，糖心蛋沒有太多問題很真心的糖心蛋，櫛瓜玉米筍（我個人認為可以自己在家做，不用點太少了）、胡麻龍鬚菜（也是量少，喜歡菜類的朋友可以點）、桂花紅茶（裡面是放茶包，桂花味很假，感覺是放香精），今天點的所有餐點，總共435元，以樹林地理位置來說開在住宅區，一定有固定客人回流，對於美食有相對的要求的人可能就比較不適合嚐鮮了。但這家店離家近，或許還有機會在二訪。",null,[0,158]]]],[null,null,null,null,null,"https://business.google.com/local/business/10618930180798938918/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpPRXg2ZWpSUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/10618930180798938918/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpPRXg2ZWpSUlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/10618930180798938918/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpPRXg2ZWpSUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/10618930180798938918/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpPRXg2ZWpSUlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/10618930180798938918/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpPRXg2ZWpSUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/10618930180798938918/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXpPRXg2ZWpSUlJSQUIQAA%3D%3D"]],[null,null,10532,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUMzOEx6ejRRRRAB!2m1!1s0x0:0xc16bb7dac332b73e!3m1!1s2@1:CIHM0ogKEICAgIC38Lzz4QE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUMzOEx6ejRRRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUMzOEx6ejRRRRItChZDSUhNMG9nS0VJQ0FnSUMzOEx6ekVREhNDZ3dJaHVXV3VRWVF3SXpQaEFFGi4KF0NJSE0wb2dLRUlDQWdJQzM4THp6a1FFEhNDZ3dJaHVXV3VRWVF3SXpQaEFFIhIJAAAAAAAAAAARPrcyw9q3a8EqCzBkS1EyRVViOEVL\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjelc_Wy9KWAxW5bfUHHYANKh0QoykIpwEoGQ"],null,[null,[[1,1]]]]