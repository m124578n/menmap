,null,null,1,[[2]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["份量還行，但他用小而細緻的碗裝，所以看上去很少~\n拉麵裡，意外的有花椰菜、玉米筍\n\n唐洋雞軟嫩多汁，單吃就很好吃❤️\n美乃滋酸口味，有點膩,或不想吃了，可以吃一口美乃滋哈哈哈哈哈哈\n\n不過他們家的麻辣是真的不麻辣，可能是想配合自己家的辣醬做搭配吧🤔\n我加了超多七味\u0026辣醬🤣辣得很溫和🙂\u200d↕️\n\n如果是和我一樣想把自己辣醒、重振精神的話，不建議來吃~\n\n給我的感覺就像暖男/女溫和地微笑著，說：「辣嗎？不夠辣的話我再幫你加。好吃嗎？」\n\n玄米茶很好喝，本身就有點甜味（微甜）\n非常建議在吃食物前喝一口！\n\n細麵點標準，微硬，下次點軟的試試看\n\n櫃檯人員很好,很溫柔❤️",null,[0,40]]]],[null,null,null,null,null,"https://business.google.com/local/business/10618930180798938918/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhY0ZGdWIzUmxSV2hXVVhwU2ExcFhVbGRVYXpGTFlqTk9XbGxZWXhBQhAA",[null,null,null,"/local/business/10618930180798938918/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhY0ZGdWIzUmxSV2hXVVhwU2ExcFhVbGRVYXpGTFlqTk9XbGxZWXhBQhAA"],"https://business.google.com/local/business/10618930180798938918/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhY0ZGdWIzUmxSV2hXVVhwU2ExcFhVbGRVYXpGTFlqTk9XbGxZWXhBQhAA",[null,null,null,"/local/business/10618930180798938918/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhY0ZGdWIzUmxSV2hXVVhwU2ExcFhVbGRVYXpGTFlqTk9XbGxZWXhBQhAA"],null,"https://business.google.com/local/business/10618930180798938918/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhY0ZGdWIzUmxSV2hXVVhwU2ExcFhVbGRVYXpGTFlqTk9XbGxZWXhBQhAA",[null,null,null,"/local/business/10618930180798938918/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhY0ZGdWIzUmxSV2hXVVhwU2ExcFhVbGRVYXpGTFlqTk9XbGxZWXhBQhAA"]],[null,null,2324,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xacFFub3RlRWhWUXpSa1pXUldUazFLYjNOWllYYxAB!2m1!1s0x0:0xc16bb7dac332b73e!3m1!1s2@1:CAIQACodChtycF9oOlZpQnoteEhVQzRkZWRWTk1Kb3NZYXc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xacFFub3RlRWhWUXpSa1pXUldUazFLYjNOWllYYxAB\u0026t\u003d1\u0026entityid\