3qH3\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x2c4793e8e345c09f"]],1,null,null,null,null,null,null,["0","3190681489469980831"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xaa09UTmZTVEJ3TUVoeFptTTFkMVJxYzNWYVFrRRAB"]],"CIABIhAUCyi0u9EUYgdOmzvf3qH3",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjHr9imwdKWAxXIavUHHVqHA3wQ3YcHCIQBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjHr9imwdKWAxXIavUHHVqHA3wQ3IcHCIMBKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwjHr9imwdKWAxXIavUHHVqHA3wQ3YcHCIYBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjHr9imwdKWAxXIavUHHVqHA3wQ3IcHCIUBKAY",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjHr9imwdKWAxXIavUHHVqHA3wQ3IcHCIcBKAc",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjHr9imwdKWAxXIavUHHVqHA3wQ3IcHCIgBKAg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjHr9imwdKWAxXIavUHHVqHA3wQ3IcHCIkBKAk",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwjHr9imwdKWAxXIavUHHVqHA3wQ3YcHCIsBKAA"]]],null,"用餐人數",null,"0ahUKEwjHr9imwdKWAxXIavUHHVqHA3wQ3IcHCIoBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["期待與現實之間的一碗拉麵\n\n昨晚在阪急百貨樓下的美食街用餐，剛走進 評一燈拉麵，桌上就看到一張「聖誕節限量拉麵」的照騙，看起來豐盛又有節慶感，於是毫不猶豫點了一碗，另外加點了涼菜「龍鬚菜澆麻醬」。\n\n出餐速度 OK，但視覺落差有點大\n大約等了 10 分鐘上桌，老實說，這一碗跟照片上的成品落差真的蠻明顯的，不論是配料份量或整體視覺，都讓人有點困惑：「是不是我點錯版本？」（但確實是同一款）。如果是限量款，或許可以在圖片或點餐時多一點實際說明，避免期待落空。\n\n涼菜表現穩定，是加分項\n龍鬚菜澆麻醬本身表現不錯，口感清爽、麻醬香氣也到位，是這餐中比較安心的一道。\n\n會員冰淇淋＋服務態度，意外拉回好感\n看到「加入會員送一球冰淇淋」就順手加入，詢問後才知道因為台北市一次性餐具政策，冰淇淋只能到外面的長椅享用。雖然有點小不便，但冰淇淋本身好吃，服務人員態度也很親切，還主動幫忙處理空杯，這點真的加分。\n\n總結\n餐點表現有高有低，照片與實物落差是這次比較可惜的地方；但服務態度與部分品項仍讓人感受到用心。希望之後在限定餐點呈現上能更貼近實際，會讓整體體驗更完整。\n\n如果你是「看照片點餐派」，建議先有心理準備；如果重視服務互動，這裡還是有可取之處。",null,[0,33]]]],[null,null,null,null,null,"https://business.google.com/local/business/7472768851453659966/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhYTA5VVRtWlRWRUozVFVWb2VGcHRUVEZrTVZKeFl6TldZVkZyUlJBQhAA",[null,null,null,"/local/business/7472768851453659966/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhYTA5VVRtWlRWRUozVFVWb2VGcHRUVEZrTVZKeFl6TldZVkZyUlJBQhAA"],"https://business.google.com/local/business/7472768851453659966/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhYTA5VVRtWlRWRUozVFVWb2VGcHRUVEZrTVZKeFl6TldZVkZyUlJBQhAA",[null,null,null,"/local/business/7472768851453659966/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhYTA5VVRtWlRWRUozVFVWb2VGcHRUVEZrTVZKeFl6TldZVkZyUlJBQhAA"],null,"https://business.google.com/local/business/7472768851453659966/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhYTA5VVRtWlRWRUozVFVWb2VGcHRUVEZrTVZKeFl6TldZVkZyUlJBQhAA",[null,null,null,"/local/business/7472768851453659966/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhYTA5VVRtWlRWRUozVFVWb2VGcHRUVEZrTVZKeFl6TldZVkZyUlJBQhAA"]],[null,null,7406,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xaa09UTmZTVEJ3TUVoeFptTTFkMVJxYzNWYVFrRRAB!2m1!1s0x0:0x2c4793e8e345c09f!3m1!1s2@1:CAIQACodChtycF9oOlZkOTNfSTBwMEhxZmM1d1Rqc3VaQkE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xaa09UTmZTVEJ3TUVoeFptTTFkMVJxYzNWYVFrRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xaa09UTmZTVEJ3TUVoeFptTTFkMVJxYzNWYVFrRRI-Ci9DQUlRQUNvZENodHljRjlvT2xaa09UTmZTVEJ3TUVoeFptTTFkMVJxYzNWYVFrRRILMGRMVXZ6MFg5YkUaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sWmtPVE5mU1RCd01FaHhabU0xZDFScWMzVmFRa0USCzBkTFV2ejBYOWJFIhIJAAAAAAAAAAARn8BF4-iTRywqCzBkTFV2ejBYO