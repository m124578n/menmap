_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjJuraizNKWAxWnnq8BHfDRJTAQ3IcHCKYBKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwjJuraizNKWAxWnnq8BHfDRJTAQ3YcHCKgBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjJuraizNKWAxWnnq8BHfDRJTAQ3YcHCKkBKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwjJuraizNKWAxWnnq8BHfDRJTAQ3YcHCKoBKAI"]]],null,"用餐人數",null,"0ahUKEwjJuraizNKWAxWnnq8BHfDRJTAQ3IcHCKcBKAc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["環境很有日本的感覺，氣氛不錯，老闆的態度也很好，點了鱻拉麵，湯頭有十足的鮮甜感，用料也不錯，拉麵個人覺得偏軟（但我喜歡軟一點的），不像日式拉麵的部分應該是不夠鹹，但這樣也可以輕鬆把湯汁喝完，整體味道都不錯！覺得一球拉麵有點少，但多加一球是免費的，所以也還可以。\n有四人桌和吧台桌，相較一般小拉麵店更有舒適感，可以2~4人用餐聊天，價位合理，是會讓人想回訪的餐廳。",null,[0,181]]]],[null,1777738917000000,1777738917000000,"4 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfX0xZREJka3FlLV9MaEhqZUFJWWZLQQ%7CCAEQrcz1_gkiMAoZQ0hfX0xZREJka3FlLV9MaEhqZUFJWWZLQRoTQ2d3SXBjbll6d1lReS1ubHNRRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjJuraizNKWAxWnnq8BHfDRJTAQ_2MIqwEoCA"],"https://business.google.com/local/business/17986105921470228985/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZFdKRVozaE9Na3B0WWtSTmVWcHNSbE5hTVZaWVVtMXNSbUpIWXhBQhAA",[null,null,null,"/local/business/17986105921470228985/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZFdKRVozaE9Na3B0WWtSTmVWcHNSbE5hTVZaWVVtMXNSbUpIWXhBQhAA"],"https://business.google.com/local/business/17986105921470228985/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZFdKRVozaE9Na3B0WWtSTmVWcHNSbE5hTVZaWVVtMXNSbUpIWXhBQhAA",[null,null,null,"/local/business/17986105921470228985/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhHZFdKRVozaE9Na3B0WWtSTmVWcHNSbE5hTVZaWVVtMXNSbUpIWXhBQhAA"],null,"https://business.google.com/local/bus