ll,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjJuraizNKWAxWnnq8BHfDRJTAQ3IcHCJkBKA4",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjJuraizNKWAxWnnq8BHfDRJTAQ3IcHCJoBKA8",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["週末在土城區繞來繞去，網路上查到這家拉麵店，只有一位店員也許是老闆？！包括點餐和煮拉麵都是一人包辦，生意不錯服務態度很好👍\n\n點了鱻拉麵湯頭鮮到不行，醬油湯底裡面竟然有星鰻、生食炙燒干貝、海帶芽，一整顆溏心蛋不是半顆喔！！海味滿滿的滿口鮮香，一定花很多時間熬煮湯頭，非常驚艷！！\n\n我吃辛蒜鑫拉麵是辣的口味，點了大辣對我來說大概是小辣，有告示說明湯頭濃淡辣度都可以調整，我沒有特別調整因為也好吃，筍乾的香氣覺得拉麵蠻有台味，可以把湯喝光的好吃。\n\n明太子鮪魚飯也很推，飯量很多加了一顆溫泉蛋，拌下去口感又不同了👍都想嚐鮮點了這些好飽足，下次還想吃炸物，值得推薦的拉麵店🍜",null,[0,139]]]],[null,null,null,null,null,"https://business.google.com/local/business/17986105921470228985/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYkZJd2VFUlNXR1J3V2toVk0xSjZWbVpTTWxKTVQxWlNjbGxYWXhBQhAA",[null,null,null,"/local/business/17986105921470228985/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYkZJd2VFUlNXR1J3V2toVk0xSjZWbVpTTWxKTVQxWlNjbGxYWXhBQhAA"],"https://business.google.com/local/business/17986105921470228985/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYkZJd2VFUlNXR1J3V2toVk0xSjZWbVpTTWxKTVQxWlNjbGxYWXhBQhAA",[null,null,null,"/local/business/17986105921470228985/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYkZJd2VFUlNXR1J3V2toVk0xSjZWbVpTTWxKTVQxWlNjbGxYWXhBQhAA"],null,"https://business.google.com/local/business/17986105921470228985/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYkZJd2VFUlNXR1J3V2toVk0xSjZWbVpTTWxKTVQxWlNjbGxYWXhBQhAA",[null,null,null,"/local/business/17986105921470228985/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYkZJd2VFUlNXR1J3V2toVk0xSjZWbVpTTWxKTVQxWlNjbGxYWXhBQhAA"]],[null,null,7513,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25KbFIweERSWGRwWkhVM1J6VmZSMlJMT1ZScllXYxAB!2m1!1s0x0: