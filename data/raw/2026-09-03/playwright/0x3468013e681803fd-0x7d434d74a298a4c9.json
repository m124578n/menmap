ll,null,[[2]]],[["/m/01195fxr"],"半球",null,[null,null,null,null,6,0,6],null,"0ahUKEwir2sfmydKWAxX9afUHHUBbIkUQ1bMECOICKEs",null,null,null,[[2]]]]],[["Hiro's らぁ麵kitchen 新店店是一間融合日本福岡傳統與台灣在地情感的高評價日式餐廳。選址於新店交通樞紐，緊鄰北新路三段與文化路，交通便利性極高，方便從大坪林捷運站或七張捷運站前來的食客尋找好吃的日本料理。周邊地標包含裕隆城與家樂福，是假日家庭聚餐與平日技嘉科技同仁下班後，找尋值得推薦的日式午晚餐絕佳去處。\n\n對於食材的龜毛態度成就了每一碗高品質的拉麵與咖哩飯，讓每一位來訪的顧客都能感受到食在安心的承諾。\n\n店內招牌豚骨拉麵與魚介豚骨拉麵，搭配嚴選的好吃雞排咖哩飯，是每日午晚餐的推薦熱銷項目。\n\n為了讓新店的夜晚更加精彩，晚餐限定時段推出市面罕見的卡布奇諾拉麵、極具層次感的喜必辛拉麵，以及飽足感十足的厚實豬排咖哩飯。透過台日友好合作，確保每一份餐點都符合日本料理精益求精的精神。\n\n來到新店北新路三段和文化路口，由最講究的豚骨湯頭與日式咖哩，呈現一場精采的味覺交響曲。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh3.googleusercontent.com/-8pdvye7IU2w/AAAAAAAAAAI/AAAAAAAAAAA/sO8ReJ6GfMM/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"新北市新店區寶安里",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwir2sfmydKWAxX9afUHHUBbIkUQhbADCOQCKAA","全部",[["CIABIhDDlvzrQfnaafEroQQbna7c",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWlG48z6XhFfQfmZILBUqx5ngEPVQCU_7YZH1BG-hEGGPzcwOqcQe-OaIPDnv0-_shiLSqYP7dJmwY5GF9A_QW5IJ-A16Przye9gH6ZkgAmiAEIaJDUP8JBeGGQEbIeKf0GGu3voB6tHprmU\u003dw447-h298-k-no","",[6000,4000],[203,100]],null,[[3,121.54287550000001,24.979255499999997],[0,90],[6000,4000],75],"IH6ZaqvKOP3T1e8PwLaJqQQ","0ahUKEwir2sfmydKWAxX9afUHHUBbIkUQzCcI5QIoAA",null,null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhDDlvzrQfnaafEroQQbna7c"],[10,3,[4000,6000]],null,null,[[[2],[[null,null,24.979255499999997,121.54287550000001]]]],[1,null,null,[2],null,[null,null,"bizbuilder:gmb_on_local_universal_desktop",[6,7,4,1,3]],null,null,[2025,11,3,13]],null,null,null,null,null,null,null,null,null,null,null,null,["UGCS_REFERENCE","CIABIhDDlvzrQfnaafEroQQbna7c||","1"]],1,null,null,null,null,null,null,["3776269655096165373","9026143241520063689"],null,"8r_oO8m6pQ4"]],null,null,null,null,null,null,0,1,null,0],["CgIgARICGAI\u003d",