gICd97SUWA"],[10,3,[2048,1536]],[null,null,null,null,null,null,null,["譓心的店"]],[null,[[["洪家章"],"https://www.google.com/maps/contrib/106145768551293276335?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjUGnQvX-NUEN1iT6ish0QrGpY79JeHlFIQjIoFXX1pAEwVKKpjN\u003ds120-c-rp-mo-ba12-br100",null,null,"106145768551293276335"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2024,2,19,9,null,null,null,null,["2 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICd97SUWA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x7d190119f2f203dc"]],1,null,null,null,null,null,null,["0","9014237340120515548"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUNkOTlTRUNnEAE"]],"CIHM0ogKEICAgICd97SUWA",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwj_tu6ZxtKWAxUKdvUHHY0RDU8Q3YcHCLIBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwj_tu6ZxtKWAxUKdvUHHY0RDU8Q3IcHCLEBKAs",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:BREAKFAST"],"早餐",2,null,null,"0ahUKEwj_tu6ZxtKWAxUKdvUHHY0RDU8Q3YcHCLQBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwj_tu6ZxtKWAxUKdvUHHY0RDU8Q3IcHCLMBKAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwj_tu6ZxtKWAxUKdvUHHY0RDU8Q3YcHCLYBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwj_tu6ZxtKWAxUKdvUHHY0RDU8Q3IcHCLUBKA0",null,null,null,null,null,1,[[2]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["板橋區介壽街上的宋囍拉麵 らーめん，是台灣少見的「朝ラーメン（亦叫：朝ラー）」，意指早上就能吃到拉麵的店，早上九點開始販售（如果再更早一點就更棒了），賣到下午兩點，因為老闆仍有其他規劃，所以平日晚上跟假日不營業，想吃拉麵的朋友把握平日早上的時間。\n\n拉麵有醬油清湯跟雞鹽清湯兩種，湯頭可選擇日本味或清淡，麵條也能客製化硬度，早上十一點前來吃麵還能免費續麵一次。\n\n醬油清湯拉麵，湯頭帶有魚介味，柴魚味，微苦甘，梅花叉燒、炙燒玉米筍、豆芽菜、溏心蛋、海苔片，梅花叉燒嫩彈不柴，其中豆芽菜份量十足，脆口無腥味，溏心蛋看似無色，但已有鹹味，連蛋白都入味，蛋黃液狀，好吃，整碗拉麵鹹韻有層次，以早餐來說味道夠又不會太負擔，麵量跟豆芽菜量足，再加一球麵定能飽足，170元非常划算\n\n雞鹽清湯拉麵，雖無醬油拉麵濃郁，雞味明顯，梅花叉燒、美白菇、紫洋蔥丁、炙燒玉米筍、溏心蛋、海苔片，比較特別的是灑上紅胡椒（不是七味粉），讓原本的淡韻湯頭更加豐富。宋囍之前這兩款用的都是細麵條，麵硬口感剛好，醬油拉麵最近麵條改成粗麵，勁道滑Q更好吃，我更喜歡了\n\n老闆身上刺青無表情看起來很兇，但其實人很親切，還有點害羞（笑），門口寫的菜單還有畫圖案，是小朋友畫的，很有趣，櫃檯上有份菜單餐點不準，以現場供應為準，入口層架有個簽名碗，有點眼熟，是2018年「麵屋一燈」來台初展店時社長坂本幸彥的簽名碗，老闆特地跑去排隊拿的，真棒，然後門口停放一台帥氣的機車，也請不要忘記欣賞一下，因為這是老闆的愛車（笑）",null,[0,123]]]],[null,1708708162000000,1708708162000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04MGxGUURKRmxsMk5GQ0FBUkVsdw%7CCAEQrcz1_gkiMAoZQ0hfQm04MGxGUURKRmxsMk5GQ0FBUkVsdxoTQ2d3SXdxTGpyZ1lRdWVhUGdnRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwj_tu6ZxtKWAxUKdvUHHY0RDU8Q_2MItwEoDg"],"https://business.google.com/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtPVGxUUlVObkVBRRAA",[null,null,null,"/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtPVGxUUlVObkVBRRAA"],"https://business.google.com/local/business/4126853881898507599/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtPVGxUUlVObkVBRRAA",[null,null,null,"/local/business/4126853881898507599/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtPVGxUUlVObkVBRRAA"],null,"https://business.google.com/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtPVGxUUlVObkVBRRAA",[null,null,null,"/local/business/4126853881898507599/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtPVGxUUlVObkVBRRAA"],null,["zh-Hant"],[["謝謝章魚哥 我快回我的舒適圈了",null,[0,15]]]],[null,null,12482,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNkOTlTRUNnEAE!2m1!1s0x0:0x7d190119f2f203dc!3m1!1s2@1:CIHM0ogKEICAgICd99SECg%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUNkOTlTRUNnEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUNkOTlTRUNnEi4KF0NJSE0wb2dLRUlDQWdJQ2Q5OVNFaWdFEhNDZ3dJMzdITXJnWVF