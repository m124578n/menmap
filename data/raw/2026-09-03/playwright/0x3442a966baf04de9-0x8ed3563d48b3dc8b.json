D_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjG4qG9zNKWAxXynK8BHZB6CQMQ3IcHCFcoAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjG4qG9zNKWAxXynK8BHZB6CQMQ3IcHCFgoBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjG4qG9zNKWAxXynK8BHZB6CQMQ3IcHCFkoBQ",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["經過發現新開了一間拉麵店\n一直放在口袋名單裡\n但遲遲沒有沒機會來吃🫣🫣🫣～\n\n最近滑 Threads發現只要蘆洲美食文幾乎都會看到老闆出沒🤣\n看老闆這麼認真幫自己打廣告\n就決定來嚐鮮看看👀\n\n店內使用點餐機，操作方便\n但只能現金支付～\n\n🍜 經典雞白湯拉麵\n湯頭濃郁順口 上面的泡沫超像奶泡\n看起來很療癒🤣\n下次會想再點 好吃～～\n\n🍜 柚子胡椒雞白湯拉麵（微辣）\n柚子香氣自然 不會有香精感\n覺得偏小辣但吃起來蠻順口\n但感覺會越吃越辣\n\n開水還加入薄荷、檸檬、蘋果\n很好喝 而且蠻解辣的哈哈哈哈哈\n\n🥢酥炸嫩豆腐\n中規中矩 搭配醬油還不錯\n\n整體價格以 CP 值來說可以接受\n是一間會推薦朋友\n也會再回訪的拉麵店🍜",null,[0,37]]]],[null,1784118919000000,1784118919000000,"1 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfeGV6WGNhakh5cmxSZ3RJMHpVVUU2Zw%7CCAEQrcz1_gkiMAoZQ0hfeGV6WGNhakh5cmxSZ3RJMHpVVUU2ZxoTQ2d3SWhfM2QwZ1lRMGJiMm13RQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjG4qG9zNKWAxXynK8BHZB6CQMQ_2MIWigG"],"https://business.google.com/local/business/13549372400190475174/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLZVdKSVdtbGFiRnB4VG0xU1IwMXRXbTFXUkVrMVdsWkdTRk16WXhBQhAA",[null,null,null,"/local/business/13549372400190475174/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLZVdKSVdtbGFiRnB4VG0xU1IwMXRXbTFXUkVrMVdsWkdTRk16WXhBQhAA"],"https://business.google.com/local/business/13549372400190475174/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLZVdKSVdtbGFiRnB4VG0xU1IwMXRXbTFXUkVrMVdsWkdTRk16WXhBQhAA",[null,null,null,"/local/business/13549372400190475174/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLZVdKSVdtbGFiRnB4VG0xU1IwMXRXbTFXUkVrMVdsWkdTRk16WXhBQhAA"],null,"https://business.google.com/local/business/1354937240019