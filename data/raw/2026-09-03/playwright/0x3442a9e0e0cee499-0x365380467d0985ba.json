0026fid\u003d0x0:0x365380467d0985ba"]],1,null,null,null,null,null,null,["0","3914613541348935098"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT21OM2NHdFRaMjlYZEZKRFZGcEZPV3RvWVZCSGNIYxAB"]],"CIABIhB3rx6QVgM1CN8QFazuSX-n",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiAhc78vtKWAxUxhq8BHX--BWsQ3IcHCMEBKAI",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["我很喜歡這裡的食物，小時候常吃炙燒 PR 黑牛拌麵，可惜現在已經沒有了，只剩雪花牛，真的有點懷念。\n\n星星是給食物的，不過這次還是扣了一些分，主要是因為雪花牛裡面有一塊肉是生的。\n\n雖然牛肉本身可以生食，但在火鍋店或燒肉店吃到生牛肉，和在麵店期待吃到的狀況還是完全不同。當下我有向店家反映，店家也有過來確認情況，處理態度是好的。\n\n不過我認為出餐流程仍有改善空間，建議出餐前再確認餐點狀態。如果店家認為部分牛肉保留較生的熟度是正常的，也應該事先在菜單或餐點上標示，讓客人有所預期，避免造成誤會。",null,[0,89]]]],[null,null,null,null,null,"https://business.google.com/local/business/12044792938329824252/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPTTJOSGRGUmFNamxZWkVaS1JGWkdjRVpQVjNSdldWWkNTR05JWXhBQhAA",[null,null,null,"/local/business/12044792938329824252/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPTTJOSGRGUmFNamxZWkVaS1JGWkdjRVpQVjNSdldWWkNTR05JWXhBQhAA"],"https://business.google.com/local/business/12044792938329824252/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPTTJOSGRGUmFNamxZWkVaS1JGWkdjRVpQVjNSdldWWkNTR05JWXhBQhAA",[null,null,null,"/local/business/12044792938329824252/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPTTJOSGRGUmFNamxZWkVaS1JGWkdjRVpQVjNSdldWWkNTR05JWXhBQhAA"],null,"https://business.google.com/local/business/12044792938329824252/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPTTJOSGRGUmFNamxZWkVaS1JGWkdjRVpQVjNSdldWWkNTR05JWXhBQhAA",[null,null,null,"/local/business/12044792938329824252/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPTTJOSGRGUmFNamxZWkVaS1JGWkdjRVpQVjNSdldWWkNTR05JWXhBQhAA"]],[null,null,1918,["https://www.google.com/maps/reviews/data\u003d!4