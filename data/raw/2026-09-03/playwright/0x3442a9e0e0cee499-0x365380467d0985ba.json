ll,[0,175]]]],[null,null,null,null,null,"https://business.google.com/local/business/12044792938329824252/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZW1OclJsWk5ibWhRWW5wSk1sTlVXbTVoYlZwTVkwUldTVmxWUlJBQhAA",[null,null,null,"/local/business/12044792938329824252/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZW1OclJsWk5ibWhRWW5wSk1sTlVXbTVoYlZwTVkwUldTVmxWUlJBQhAA"],"https://business.google.com/local/business/12044792938329824252/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZW1OclJsWk5ibWhRWW5wSk1sTlVXbTVoYlZwTVkwUldTVmxWUlJBQhAA",[null,null,null,"/local/business/12044792938329824252/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZW1OclJsWk5ibWhRWW5wSk1sTlVXbTVoYlZwTVkwUldTVmxWUlJBQhAA"],null,"https://business.google.com/local/business/12044792938329824252/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZW1OclJsWk5ibWhRWW5wSk1sTlVXbTVoYlZwTVkwUldTVmxWUlJBQhAA",[null,null,null,"/local/business/12044792938329824252/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZW1OclJsWk5ibWhRWW5wSk1sTlVXbTVoYlZwTVkwUldTVmxWUlJBQhAA"]],[null,null,11051,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pFemNrRlZNbmhQYnpJMlNUWm5hbVpMY0RWSVlVRRAB!2m1!1s0x0:0x365380467d0985ba!3m1!1s2@1:CAIQACodChtycF9oOjEzckFVMnhPbzI2STZnamZLcDVIYUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pFemNrRlZNbmhQYnpJMlNUWm5hbVpMY0RWSVlVRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pFemNrRlZNbmhQYnpJMlNUWm5hbVpMY0RWSVlVRRI-Ci9DQUlRQUNvZENodHljRjlvT2pFemNrRlZNbmhQYnpJMlNUWm5hbVpMY0RWSVlVRRILMGR6THV3QTF1RUEaPgovQ0FJUUFDb2RDaHR5Y0Y5b09qRXpja0ZWTW5oUGJ6STJTVFpuYW1aTGNEVklZVUUSCzBkekx1d0ExdUVBIhIJAAAAAAAAAAARuoUJfUaAUzYqCzBkekx1d0ExdUVB\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiAhc78vtKWAxUxhq8BHX--BWsQoykIZigP"],null,[n