null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjTzPqcxtKWAxVhe_UHHbwCKUQQ3IcHCJMBKAQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjTzPqcxtKWAxVhe_UHHbwCKUQQ3IcHCJQBKAU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjTzPqcxtKWAxVhe_UHHbwCKUQQ3IcHCJUBKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwjTzPqcxtKWAxVhe_UHHbwCKUQQ3YcHCJcBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjTzPqcxtKWAxVhe_UHHbwCKUQQ3YcHCJgBKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwjTzPqcxtKWAxVhe_UHHbwCKUQQ3YcHCJkBKAI"]]],null,"用餐人數",null,"0ahUKEwjTzPqcxtKWAxVhe_UHHbwCKUQQ3IcHCJYBKAc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["每個人都有每個人的看法，我個人的看法是。\n拉麵很好吃，尤其是 地獄拉麵 不會到很辣，但喜歡吃辣的可以嘗試，桌上也有一些 七味粉\n（按照自己所需的量添加）\n飲料有少糖的紅茶跟豆漿，按照自己喜歡的裝填（限內用）\n環境見仁見智\n個人認為滿乾淨的，音樂可能有些人不習慣，此店播放的日漫音樂較多。\n\n每次休假至少找一天去店內吃 地獄拉麵 超過一定金額可以免費+1球或半球麵\n（對於食量稍大的人-物超所值）\n\n服務：老闆人都很好，第一次來都會介紹店內特色。多次來都不用說老闆就知到您要點什麼。\n\n如果多人來店內用餐請需預約，因為是現點現做，\n多人客人時出餐速度會比較慢，請見諒店家。\n\n至少呈現出來的是美味的佳餚。\n\n最後附上近期去吃的地獄拉麵+一球麵",null,[0,76]]]],[null,null,null,null,null,"https://business.google.com/local/business/16651085486245597797/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4TVdOWGMzUk5WVkUwVTBSR2JGVXhjRFZXYm1jMFlrVk5lR1JGUlJBQhAA",[null,null,null,"/local/business/16651085486245597797/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4TVdOWGMzUk5WVkUwVTBSR2JGVXhjRFZXYm1jMFlrVk5lR1JGUlJBQhAA"],"https://business.google.com/local/business/16651085486245597797/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4TVdOWGMzUk5WVkUwVTBSR2JGVXhjRFZXYm1jMFlrVk5lR1JGUlJBQhAA",[null,null,null,"/local/business/16651085486245597797/customers/reviews/de