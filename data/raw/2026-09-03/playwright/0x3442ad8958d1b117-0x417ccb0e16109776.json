gEoBg",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDurpa2FQ\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x417ccb0e16109776",null,null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ-y4IkwEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIDurpa2FQ"],[10,3,[6936,9248]],[null,null,null,null,null,null,null,["疆美味 新疆手工涼皮 手工拉麵"]],[null,[[["U P"],"https://www.google.com/maps/contrib/101566861840544254661?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjV3J84IRwXxYWn49C8hBup0DGBKPR11Xz6YuT3jxopp-sDNqFEv\u003ds120-c-rp-mo-ba12-br100",null,null,"101566861840544254661"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2022,8,21,6,null,null,null,null,["4 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDurpa2FQ\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x417ccb0e16109776"]],1,null,null,null,null,null,null,["0","4718869770937603958"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUR1cnZyVUdnEAE"]],"CIHM0ogKEICAgIDurpa2FQ",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["樣樣好吃，新疆的手工拉條子，口感真的很好。😊\n酸辣湯頭，辣度剛好，酸味真的很適合開胃。😊\n番茄蛋湯頭，感覺蛋是先煎好再放入番茄湯頭，整體層次很棒，很清爽，很想再吃下去，如果有大碗我應該會點大碗，哈哈哈🤤🤤🤤🤤🤤🤤🤤🤤。\n另外，炒土豆絲真是一絕，我也吃過很多間炒土豆絲，但這老闆炒的口味口感及脆度真的恰到好處，尤其乾辣椒新鮮辣椒及酸度讓整體質感提升，希望也有一點花生這樣應該更棒🤤🤤🤤\n涼皮本身口感比粄條還厚一點，口感上也是軟中帶著一點點彈性，有點像蒟蒻不過又沒有這麼滑溜！\n推薦大家可以嘗試👍👍👍👍👍\n疆美味 新疆手工涼皮 手工拉麵 是位于 Taipei 的一个 熟食店。 實體的註冊地址為111台北市士林區菁山路8號。",null,[0,109]]]],[null,1661251427000000,1661251427000000,"4 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQUFWQmgtNEtVNHhrY2tMcUFBRk5Rdw%7CCAEQrcz1_gkiMAoZQ0hfQUFWQmgtNEtVNHhrY2tMcUFBRk5RdxoTQ2d3STQ5NlNtQVlRNElUNXBBRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ_2MIlAEoBw"],"https://business.google.com/local/business/15625081704786562943/customers/reviews