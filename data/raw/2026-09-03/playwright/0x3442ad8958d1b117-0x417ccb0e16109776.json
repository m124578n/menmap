ull,null,[3],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11tc4rzv35"],"蕃茄蛋花麵",2,null,null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3YcHCMUBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3IcHCMQBKBA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3YcHCMcBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3IcHCMYBKBE",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_DIFFICULT_TO_FIND"],"停車不方便",2,null,null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3YcHCMkBKAA"]],1],null,null,"停車位",null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3IcHCMgBKBI",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_FREE_STREET_PARKING"],"免費路邊停車",2,null,null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3YcHCMsBKAA"],[["E:PARKING_OPTION_NO_PARKING"],"不提供停車位",2,null,null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3YcHCMwBKAE"]]],null,"附近的停車場",null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3IcHCMoBKBM",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3IcHCM0BKBQ",null,null,["附近很難停車，且會有警察來開單。往前走一小段路，兩旁黃線區域就OK了。"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3YcHCM8BKAA"]]],null,null,null,"0ahUKEwiy6qa7w9KWAxUena8BHYBvEUUQ3IcHCM4BKBU",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["二：上山三號店 疆美味新疆手工涼皮手工拉麵 士林\n已經吃了牛肉拌麵和肉絲拌麵，還喝了三碗湯，接著還吃了個煎餅果子與喝杯檸檬紅茶。位於「彭城煎餅果子」隔壁的這家「疆美味」，也有真美味的拉條子和涼皮，但是確實無法當下再塞進肚內。畢竟年紀大了，戰力大減，只能選擇打包幾個上回沒買的窩窩饢。\n\n這簡直就是小號的饢餅，但外型更像猶太人的貝果（這是中間凹陷下去，而非貝果有個中空洞，尺寸上略小一點），或是繼光餅（大小與繼光餅差不多，厚度也是，就是後者中間沒有凹陷形狀。）\n\n反正都沒吃過，每個口味都買個嘗嘗。跟店家所賣的饢口感很像，應該是同樣的麵團？只是這個外圈本身比較厚實，饢本身比較薄一點，單嚼上是有點差別的，用牙拽扯是饢比較過癮些。糖皮口味比較突出，因為外層有著明顯的白糖。鹹口味的就像一般的饢，其實沒啥特別鹹口，略略帶著鹹味而已。這樣簡單口味的麵食，實在是像我這樣愛啃麵食的福音，只是這真的太遠了，去一趟路都覺得懶。哈哈哈～但我比較喜歡原本的饢，更有啃餅的感覺，好像也可以拿來變成泡饃？\n\n一：你就說意不意外？\n在等待煎餅菓子的時候，一瞅就發現隔壁居然是賣饢與拉條子的店！讓我大感驚喜，二話不說，趕緊去把車停好，因為警察來趕人了。原本坐在車上的，還可以晃悠警察一下，這下看到不遠處的警車在轉角處鳴笛亮燈，驅離紅線違停的車輛，我也趕緊滾蛋才是。\n\n這家的麵條都是新疆的作法，拉條子，從頭到尾全都是手工製作（老闆娘是新疆伊犁的漢人，眼神與說話給我種邊疆地區人民的樸質實誠感，特像在Youtube上看到的新疆本地人的感受。）點了大碗的番茄煎蛋麵，不得不說，那手工的拉條子就是沒話說的筋道與韌性，跟一般麵條完全是兩回事。當下只有感到很慶幸地是點了大碗！心想，下回肯定要吃兩碗大碗的才過癮。番茄煎蛋的湯頭很清甜，沒有過度調味，就是煎蛋後有的油蛋味與番茄的清香酸味的綜合。\n\n涼皮的筋道也很好，只選了小辣，那辣椒（油潑）香氣很夠，但沒啥辣度，反而很適合所有人的接受程度。整個蘸汁的口味是酸甜辣混合的口味，但不會過酸（跟西安的麻醬口味大有不同）。涼皮和麵筋都是老闆娘手工製作，是別的地方吃不到的口感。這家絕對值得專門再訪，也算是今天意外的彩蛋。碰巧開的盲盒，結果是開出個彩蛋來。\n\n下回來到陽明山時，除了去吃吃回憶的味道「牛肉拌麵」之外，還多了兩家選擇，來之前必要清空腸胃，來個門清一摸三，連吃三家才甘願。\n\n更多食記搜尋南河雜俎。",null,[0,141]]]],[null,null,null,null,null,"https://business.google.com/local/business/15625081704786562943/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm9NazgyWmtwUkVBRRAA",[null,null,null,"/local/business/15625081704786562943/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm9NazgyWmtwUkVBRRAA"],"https://business.google.com/local/business/15625081704786562943/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm9NazgyWmtwUkVBRRAA",[null,null,null,"/local/business/15625081704786562943/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm9NazgyWmtwUkVBRRAA"],null,"https://business.google.com/local/business/15625081704786562943/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm9NazgyWmtwUkVBRRAA",[null,null,null,"/local/business/15625081704786562943/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUm9NazgyWmtwUkVBRRAA"]],[null,null,1340,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSURoMk82ZkpREAE!2m1!1s0x0:0x417ccb0e16109776!3m1!1s2@1:CIHM0ogKEICAgIDh2O6fJQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSURoMk82ZkpREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSURoMk82ZkpREi4KF0NJSE0wb2dL