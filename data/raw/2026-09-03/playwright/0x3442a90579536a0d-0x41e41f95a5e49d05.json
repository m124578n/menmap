,null,[0,76]]]],[null,null,null,null,null,"https://business.google.com/local/business/17455544373315382200/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVGxWNmF6UmxTR1JRVkZkV1NGRnNjRTFUZWxaV1RtMVplVmd4UlJBQhAA",[null,null,null,"/local/business/17455544373315382200/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVGxWNmF6UmxTR1JRVkZkV1NGRnNjRTFUZWxaV1RtMVplVmd4UlJBQhAA"],"https://business.google.com/local/business/17455544373315382200/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVGxWNmF6UmxTR1JRVkZkV1NGRnNjRTFUZWxaV1RtMVplVmd4UlJBQhAA",[null,null,null,"/local/business/17455544373315382200/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVGxWNmF6UmxTR1JRVkZkV1NGRnNjRTFUZWxaV1RtMVplVmd4UlJBQhAA"],null,"https://business.google.com/local/business/17455544373315382200/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVGxWNmF6UmxTR1JRVkZkV1NGRnNjRTFUZWxaV1RtMVplVmd4UlJBQhAA",[null,null,null,"/local/business/17455544373315382200/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxVGxWNmF6UmxTR1JRVkZkV1NGRnNjRTFUZWxaV1RtMVplVmd4UlJBQhAA"]],[null,null,1978,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2s1TlV6azRlSGRQVFdWSFFscE1TelZWTm1ZeVgxRRAB!2m1!1s0x0:0x41e41f95a5e49d05!3m1!1s2@1:CAIQACodChtycF9oOk5NUzk4eHdPTWVHQlpMSzVVNmYyX1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2s1TlV6azRlSGRQVFdWSFFscE1TelZWTm1ZeVgxRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2s1TlV6azRlSGRQVFdWSFFscE1TelZWTm1ZeVgxRRI-Ci9DQUlRQUNvZENodHljRjlvT2s1TlV6azRlSGRQVFdWSFFscE1TelZWTm1ZeVgxRRILMGRocGtHb0hFMnkaPgovQ0FJUUFDb2RDaHR5Y0Y5b09rNU5Vems0ZUhkUFRXVkhRbHBNU3pWVk5tWXlYMUUSCzBkaHBrR29IRTJ5IhIJAAAAAAAAAAARBZ3kpZUf5EEqCzBkaHBrR29IRTJ5\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjyucGmutKWAxUEdPUHHTdTIsoQoykIvgEoCg"],null