UIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjWgY7axtKWAxU6kq8BHWs2ADcQ3IcHCIwBKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjWgY7axtKWAxU6kq8BHWs2ADcQ3IcHCI0BKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11j2ylwp3c"],"鮭魚卵手卷",2,null,null,"0ahUKEwjWgY7axtKWAxU6kq8BHWs2ADcQ3YcHCI8BKAA"],[["M:/g/11s3dp1tzq"],"鮭魚套餐",2,null,null,"0ahUKEwjWgY7axtKWAxU6kq8BHWs2ADcQ3YcHCJABKAE"]],[1]],null,"建議的餐點",null,"0ahUKEwjWgY7axtKWAxU6kq8BHWs2ADcQ3IcHCI4BKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["一言以蔽之：餐點絕對超乎你以為的美味。\n\n雖然餐廳外觀不是特別起眼，但走進店內，你會馬上被親切溫暖的氛圍吸引。等餐點上桌，你會發現別有用心，等餐點入口，你也會發現絕非一般。\n\n推薦給希望飽餐之際，胃暖心也暖的顧客。\n\n餐點推薦：白燒鰻魚，海膽手卷。\n\n每次來即使點的餐相似，都還是能從擺盤感受到師傅對做菜與料理的用心。真心推薦給不只是吃飯，而是希望享受美、美食的客人。",null,[0,86]]]],[null,null,null,null,null,"https://business.google.com/local/business/17793548862153959409/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkVaelpEZERoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/17793548862153959409/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkVaelpEZERoQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/17793548862153959409/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkVaelpEZERoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/17793548862153959409/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkVaelpEZERoQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/17793548862153959409/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkVaelpEZERoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/17793548862153959409/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUkVaelpEZERoQlJSQUIQAA%3D%3D"]],[null,null,14605,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUREZzZDdDhBRRAB!2m1!1s0x0:0x484d0546e866f4e