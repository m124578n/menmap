ull,null,["zh-Hant"],[["每一道都好吃，烤一夜干，皮脆，肉嫩多汁。牛肉烏龍麵，看似很油，其實不會，牛肉片鮮嫩，湯頭濃郁，當時即使已吃不少，跟同事分食仍一再續碗。炸蝦頭脆而不乾，適合配啤酒。擺盤裝飾也有用心，紫蘇紅豆糕甜而不膩，好吃。\n\n老闆跟闆娘客氣有理，牆上裝飾各區不同風格，有動漫手繪，有日本風情，有文青手繪貓咪，整體是個溫暖的家庭風日本料理餐廳。",null,[0,103]]]],[null,null,null,null,null,"https://business.google.com/local/business/17793548862153959409/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnRaMlJRUTA5M0VBRRAA",[null,null,null,"/local/business/17793548862153959409/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnRaMlJRUTA5M0VBRRAA"],"https://business.google.com/local/business/17793548862153959409/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnRaMlJRUTA5M0VBRRAA",[null,null,null,"/local/business/17793548862153959409/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnRaMlJRUTA5M0VBRRAA"],null,"https://business.google.com/local/business/17793548862153959409/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnRaMlJRUTA5M0VBRRAA",[null,null,null,"/local/business/17793548862153959409/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTnRaMlJRUTA5M0VBRRAA"]],[null,null,11490,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNtZ2RQQ093EAE!2m1!1s0x0:0x484d0546e866f4ee!3m1!1s2@1:CIHM0ogKEICAgICmgdPCOw%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUNtZ2RQQ093EAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUNtZ2RQQ093Ei0KF0NJSE0wb2dLRUlDQWdJQ21nZFBDdXdFEhJDZ3NJMmZxMmpnWVF5SWZLVXcaLAoWQ0lITTBvZ0tFSUNBZ0lDbWdkUENldxISQ2dzSTJmcTJqZ1lReUlmS1V3IhIJAAAAAAAAAAAR7vRm6EYFTUgqCzBXblFwTzlSY0U3\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjWgY7axtKWAxU6kq8BHWs2ADcQoykI6gEoCw"],null,[null,[[1,5]]]],"0ahUKEwiDkZfaxtKWAxWrdF4EHR4bIDEQ0pMFCIsBKAU"],null,null,null,"0ahUKEwjWgY7axtKWAxU6kq8BHWs2ADcQ0pMFCNQBKAU"],[["Ci9DQUlRQUNvZENodHljRjlvT2pOSVZtWmpSRWQ1TkVRdFgwSnRRVVZEV0c1a1NXYxAB",["0x0:0x484d0546e866f4ee",null,17782470055