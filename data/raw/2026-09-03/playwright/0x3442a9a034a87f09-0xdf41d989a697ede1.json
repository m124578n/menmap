1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xkR1VGUmpUSGxKUnpaSFdqYzFiblpxWlVwMk5HYxAB"]],"CIABIhARNXVFZ9anLm9SLDdUMjz3",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3YcHCN8BKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3IcHCN4BKAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3YcHCOEBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3IcHCOABKA0",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3IcHCOIBKA4",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3IcHCOMBKA8",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3IcHCOQBKBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_MODERATE"],"有點吵雜",2,null,null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3YcHCOYBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3IcHCOUBKBE",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3YcHCOgBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjG35aOxdKWAxWiZ_UHHZ0BE0gQ3IcHCOcBKBI",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["太陽番茄麵南港店是一間以番茄為核心靈魂的義大利麵餐廳，整體風格輕鬆愉快，特別適合喜歡清爽口味、又想吃得健康的朋友。店內裝潢明亮，用餐氛圍不會太緊繃，座位舒適，即使是單人用餐也很自在。服務人員簡單又親切，上菜速度算快，點餐時也會簡單介紹特色推薦，很適合初訪者。\n\n主打的番茄義大利麵果然是亮點，番茄湯底酸甜適中，有自然番茄的鮮味和蔬菜的清香，不會太膩也不過酸，喝完後口腔留下舒服的清爽感。麵條煮得恰到好處，軟硬適中，能吸附番茄醬汁的香氣。配料如雞肉、海鮮或蔬菜都很新鮮，搭配番茄基底很合拍。特別推薦他們的番茄海鮮麵，每一口海味與番茄香彼此交融，層次感十足，是一盤讓人有滿足感的主餐。\n\n除了義大利麵外，沙拉、湯品與甜點也不錯，整體的餐點品質相當一致。價格部分屬中等偏親民，以南港地區餐廳來說 CP 值不差。整體而言，太陽番茄麵南港店是一間適合每天都能吃又不太容易膩的餐廳，無論是午餐、晚餐或假日聚餐都挺不錯，很值得再訪。",null,[0,129]]]],[null,null,null,null,null,"https://business.google.com/local/business/3841810469011819705/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrUjFWR1VtcFVTR3hLVW5wYVNGZHFZekZpYmxweFdsVndNazVIWXhBQhAA",[null,null,null,"/local/business/3841810469011819705/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrUjFWR1VtcFVTR3hLVW5wYVNGZHFZekZpYmxweFdsVndNazVIWXhBQhAA"],"https://business.google.com/local/business/3841810469011819705/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrUjFWR1VtcFVTR3hLVW5wYVNGZHFZekZpYmxweFdsVndNazVIWXhBQhAA",[null,null,null,"/local/business/3841810469011819705/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrUjFWR1VtcFVTR3hLVW5wYVNGZHFZekZpYmxweFdsVndNazVIWXhBQhAA"],null,"https://business.google.com/local/business/3841810469011819705/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrUjFWR1VtcFVTR3hLVW5wYVNGZHFZekZpYmxweFdsVndNazVIWXhBQhAA",[null,null,null,"/local/business/3841810469011819705/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrUjFWR1VtcFVTR3hLVW5wYVNGZHFZekZpYmxweFdsVndNazVIWXhBQhAA"]],[null,null,4179,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xkR1VGUmpUSGxKUnpaSFdqYzFiblpxWlVwMk5HYxAB!2m1!1s0x0:0xdf41d989a697ede1!3m1!1s2@1:CAIQACodChtycF9oOldGUFRjTHlJRzZHWjc1bnZqZUp2NGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xkR1VGUmpUSGxKUnpaSFdqYzFiblpxWlVwMk5HYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xkR1VGUmpUSGxKUnpaSFdqYzFiblpxWlVwMk5HYxI-Ci9DQUlRQUNvZENodHljRjlvT2xkR1VGUmpUSGxKUnpaSFdqYzFiblpxWlVwMk5HYxILMGRKem11V1JKS0oaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sZEdVRlJqVEhsSlJ6WkhXamMxYm5acVpVcDJOR2MSCzBkSnptdVdSSktKIhIJAAAAAAAAAAAR4e2XponZQd8qCzBkSnptdVdSSktK\u0026wv\u003d1\u0026d\u003d2867