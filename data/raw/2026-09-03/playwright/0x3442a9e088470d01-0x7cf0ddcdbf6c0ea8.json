tqY8zawhl1Te2UkYPr7",1]],null,null,null,[[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwiB2oTkxdKWAxVaffUHHXz3Mz4Q3YcHCJgBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiB2oTkxdKWAxVaffUHHXz3Mz4Q3IcHCJcBKAU",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiB2oTkxdKWAxVaffUHHXz3Mz4Q3IcHCJkBKAY",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiB2oTkxdKWAxVaffUHHXz3Mz4Q3IcHCJoBKAc",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiB2oTkxdKWAxVaffUHHXz3Mz4Q3IcHCJsBKAg",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["28號來吃的忘記來寫評論，整體環境乾淨整潔，麵的味道不錯就是少了點，服務也可以。櫃檯有水可以自行取用。接著我看到了驚人的一幕，有位太太看來沒有在店消費，拿了個水壺去裝水，結果喝了一口之後瓶口又貼著裝水，真的是有夠噁爛，怎麼會有這麼低劣的新北人，沒消費還來裝水還把瓶口貼著大家會裝水的地方。這當然不是店家的問題，但是絕對要嚴厲指責這樣的消費者。當時傻眼了沒有拍攝照片影片，不過可以去調監視器，11:30左右。希望大家都做個有素質的客人，不要為了一時的方便影響其他人，真的太自私了。",null,[0,239]]]],[null,null,null,null,null,"https://business.google.com/local/business/13357520999559345894/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTWm1SSVNqRmlNMFkyVkd4Qk1sVkZhREJrVjNoMFpHdDRVMVV5WXhBQhAA",[null,null,null,"/local/business/13357520999559345894/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTWm1SSVNqRmlNMFkyVkd4Qk1sVkZhREJrVjNoMFpHdDRVMVV5WXhBQhAA"],"https://business.google.com/local/business/13357520999559345894/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTWm1SSVNqRmlNMFkyVkd4Qk1sVkZhREJrVjNoMFpHdDRVMVV5WXhBQhAA",[null,null,null,"/local/business/13357520999559345894/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTWm1SSVNqRmlNMFkyVkd4Qk1sVkZhREJrVjNoMFpHdDRVMVV5WXhBQhAA"],null,"https://business.google.com/local/business/13357520999559345894/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRTWm1SSVNqRmlNMFkyVkd4Qk1sVk