ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi1-dr3x9KWAxUmcPUHHQf-GcwQ3IcHCGIoBg",null,null,null,[1],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["超猛，軟殼蟹整盤都濕的\n不是單純沒擦乾的盤子\n是真的整盤水跟軟殼蟹一起來\n炸雞跟牡蠣也是濕的但沒有沾到炸物就算了\n大過年的服務業真的很辛苦\n\n結果跟店員反應換一盤\n不到5分鐘新一盤就到桌了\n當我笨蛋嗎？\n以為我不知道是換一個盤子而已是不是\n你知道軟殼蟹底部整個都是被水泡爛的嗎\n真的很生氣\n生氣的是我沒有拍軟殼蟹那盤有多精彩就收走了\n只怪我太相信你們會誠心換一盤\n早知道牡蠣跟炸雞跟著一起客訴給你們\n人太好被你們糟蹋\n\n誰知道那是什麼水\n洗碗水還是自來水\n未知水碰到食物送上桌就算了\n還不換新的一盤真的活該被留負評\n這真的太誇張\n內場欠衛生局稽查一下\n\n還有晚班內場那女的一直大喊要離職\n趕快離拜託，整場客人都在聽你大叫超級吵\n鈴鐺還一直按，躁鬱症去看醫生好不好\n\n另外外場很辛苦\n謝謝那個外場正職女生\n服務真的很好",null,[0,36]]]],[null,null,null,null,null,"https://business.google.com/local/business/18303890721411518176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF6TkdOclVtWk9iWEI2VDFad2VGUkhTWHBTUlVwSldUQjRSbEpzUlJBQhAA",[null,null,null,"/local/business/18303890721411518176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF6TkdOclVtWk9iWEI2VDFad2VGUkhTWHBTUlVwSldUQjRSbEpzUlJBQhAA"],"https://business.google.com/local/business/18303890721411518176/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF6TkdOclVtWk9iWEI2VDFad2VGUkhTWHBTUlVwSldUQjRSbEpzUlJBQhAA",[null,null,null,"/local/business/18303890721411518176/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF6TkdOclVtWk9iWEI2VDFad2VGUkhTWHBTUlVwSldUQjRSbEpzUlJBQhAA"],null,"https://business.google.com/local/business/18303890721411518176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF6TkdOclVtWk9iWEI2VDFad2VGUkhTWHBTUlVwSldUQjRSbEpzUlJBQhAA",[null,null,null,"/local/business/18303890721411518176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF6TkdOclVtWk9iWEI2VDFad2VGUkhTWHBTUlVwSldUQjRSbEpzUlJBQhAA"]],[null,null,5238,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21zNGNrUmZObXB6T1ZweFRHSXpSRUpJWTB4RlJsRRAB!2m1!1s0x0:0xb2d8518662894eb0!3m1!1s2@1:CAIQACodChtycF9oOms4ckRfNmpzOVpxTGIzREJIY0xFRlE%7C%7C?h