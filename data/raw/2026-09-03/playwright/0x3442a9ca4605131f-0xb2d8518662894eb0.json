有肉眼都能明顯看到的髒污和不明物⋯真的超噁\n連最基本的味噌湯也有奇怪的味道\n吃不到兩口直接吃不下去🤮\n\n跟店家反應，得到的答案是因為連假忙碌所以人員沒有留意到這些細節，以及店長事後電話致歉保證會加強人員訓練，但也並未再提及到會再確認今晚出狀況的原因，不過後來爬了一下一条通的相關貼文，看起來總公司可能也沒有很在乎大家的反應\n\n對於客人來說\n這些都已無法挽回今晚極差的用餐體驗",null,[0,43]]]],[null,null,null,null,null,"https://business.google.com/local/business/18303890721411518176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBqZWxSRVNreGlNbWd5VTFSb1JHTXlUbGhPV0VFMVZVZGtNbFpWUlJBQhAA",[null,null,null,"/local/business/18303890721411518176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBqZWxSRVNreGlNbWd5VTFSb1JHTXlUbGhPV0VFMVZVZGtNbFpWUlJBQhAA"],"https://business.google.com/local/business/18303890721411518176/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBqZWxSRVNreGlNbWd5VTFSb1JHTXlUbGhPV0VFMVZVZGtNbFpWUlJBQhAA",[null,null,null,"/local/business/18303890721411518176/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBqZWxSRVNreGlNbWd5VTFSb1JHTXlUbGhPV0VFMVZVZGtNbFpWUlJBQhAA"],null,"https://business.google.com/local/business/18303890721411518176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBqZWxSRVNreGlNbWd5VTFSb1JHTXlUbGhPV0VFMVZVZGtNbFpWUlJBQhAA",[null,null,null,"/local/business/18303890721411518176/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBqZWxSRVNreGlNbWd5VTFSb1JHTXlUbGhPV0VFMVZVZGtNbFpWUlJBQhAA"]],[null,null,1045,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pjelRESkxiMmgyU1RoRGMyTlhOWEE1VUdkMlZVRRAB!2m1!1s0x0:0xb2d8518662894eb0!3m1!1s2@1:CAIQACodChtycF9oOjczTDJLb2h2SThDc2NXNXA5UGd2VUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pjelRESkxiMmgyU1RoRGMyTlhOWEE1VUdkMlZVRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pjelRESkxiMmgyU1RoRGMyTlhOWEE1VUdkMlZVRRI-Ci9DQUlRQUNvZENodHljRjlvT2pjelRESkxiMmgyU1RoRGMyTlhOWEE1VUdkMlZVRRILMGRwSlBtV3ZsVDIaPgovQ0FJUUFDb2RDaHR5Y0Y5b09qY3pUR