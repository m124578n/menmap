dvUHHX5LBJcQ3IcHCMUBKAw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiRv5L-w9KWAxWTdvUHHX5LBJcQ3IcHCMcBKA0",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiRv5L-w9KWAxWTdvUHHX5LBJcQ3IcHCMgBKA4",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiRv5L-w9KWAxWTdvUHHX5LBJcQ3IcHCMkBKA8",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11vztpsw2g"],"招牌豚骨拉麵",2,null,null,"0ahUKEwiRv5L-w9KWAxWTdvUHHX5LBJcQ3YcHCMsBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiRv5L-w9KWAxWTdvUHHX5LBJcQ3IcHCMoBKBA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["一間小小的店面，位置也不多，入口處比較小，餐具、水、冰箱擺放在門口，人潮多一點就很容易塞住\n這次點了豚骨、麻辣炙燒牛、鹹蛋黃，麵體都選擇粗麵，份量都無加大，皆標準的份量\n粗麵沒有很粗，很像一般的細拉麵\n鹹蛋黃很鹹香，炙燒牛的味道很棒，豚骨是好喝的，都不會太鹹\n可以加入店家的辣醬，很好吃、有香氣，但是量很少都被使用完畢，希望店家能注意及即時補充（當天去的時候，店內的罐子全部使用完畢）\n份量小小的，很符合小資族的胃口，但是對於一般男性就太少了，會有吃不飽的問題\n店內湯可以自助加\n可以去嚐嚐鮮",null,[0,100]]]],[null,null,null,null,null,"https://business.google.com/local/business/4086887399942550068/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmliVXRsWlRCM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/4086887399942550068/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmliVXRsWlRCM1JSQUIQAA%3D%3D"],"https://business.google.com/local/business/4086887399942550068/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmliVXRsWlRCM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/4086887399942550068/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmliVXRsWlRCM1JSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/4086887399942550068/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmliVXRsWlRCM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/4086887399942550068/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmliV