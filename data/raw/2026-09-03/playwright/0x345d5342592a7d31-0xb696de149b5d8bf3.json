61]]]],[null,1768306613000000,1768306613000000,"7 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfdVMzTEhrWHNHNVhYbVVmYmpaLWxQdw%7CCAEQrcz1_gkiLwoZQ0hfdVMzTEhrWHNHNVhYbVVmYmpaLWxQdxoSQ2dzSXRlLVl5d1lRbUl2X0JR\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwidx6ury9KWAxWkcPUHHZRhGRcQ_2MIYigV"],"https://business.google.com/local/business/16255860950027627868/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTYzJOVVZscE5NVnBLVlZkR1YwNUViRTFXYlZKaFdIcFpkMDR5WXhBQhAA",[null,null,null,"/local/business/16255860950027627868/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTYzJOVVZscE5NVnBLVlZkR1YwNUViRTFXYlZKaFdIcFpkMDR5WXhBQhAA"],"https://business.google.com/local/business/16255860950027627868/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTYzJOVVZscE5NVnBLVlZkR1YwNUViRTFXYlZKaFdIcFpkMDR5WXhBQhAA",[null,null,null,"/local/business/16255860950027627868/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTYzJOVVZscE5NVnBLVlZkR1YwNUViRTFXYlZKaFdIcFpkMDR5WXhBQhAA"],null,"https://business.google.com/local/business/16255860950027627868/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTYzJOVVZscE5NVnBLVlZkR1YwNUViRTFXYlZKaFdIcFpkMDR5WXhBQhAA",[null,null,null,"/local/business/16255860950027627868/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTYzJOVVZscE5NVnBLVlZkR1YwNUViRTFXYlZKaFdIcFpkMDR5WXhBQhAA"],null,["zh-Hant"],[["謝謝妳的喜愛❤️內場廚師們擁有多年餐飲經驗，外場人員也很盡心維護環境整潔，妳的鼓勵是給與我們最大肯定，我們會繼續保持下去，歡迎您再度光臨🙏",null,[0,69]]]],[null,null,1167,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xSc2NUVlpNMVpKVVdGV05EbE1WbVJhWHpZd04yYxAB!2m1!1s0x0:0xb696de149b5d8bf3!3m1!1s2@1:CAIQACodChtycF9oOlRscTVZM1ZJUWFWNDlMVmRaXzYwN2c%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xSc2NUVlpNMVpKVVdGV05EbE1WbVJhWHpZd