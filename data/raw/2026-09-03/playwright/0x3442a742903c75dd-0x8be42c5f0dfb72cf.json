,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUNkbDRhWF93RRAB"]],"CIHM0ogKEICAgICdl4bXoAE",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3YcHCGsoAA"]],1],null,null,"訂單類型",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCGooBQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3YcHCG0oAA"]],1],null,null,"餐點類型",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCGwoBg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3YcHCG8oAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCG4oBw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCHAoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCHEoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCHIoCg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["時段：中午11點左右\n環境：備餐區明亮整潔、用餐區桌面乾淨\n感受：舒適放鬆 聽著音樂等待餐點\n用餐：點了一份豚骨175升級豪華套餐+85（附40元冷飲可四擇一）我選桂花紅茶\n再單點一顆溏心蛋+25、再麵量加倍+25\n總共310元\n店家特製的高碗頗具特色，湯頭初嚐濃郁\n粗麵有Q度，筍干、玉米筍清脆，第一口雞嫩肉有一種吃雞肉飯的錯覺 喂～😆鮮甜沒異味是好吃的！叉燒肉的厚度和油脂分佈均勻，整體肉的調味及口感還算不錯。\n飲料杯蓋的開口不太容易固定住，在飲用過程比較不方便。然後加麵的部分是另外盛，不能直接加入碗裡，所以麵的Q度有跑掉 比較硬一點點🤏。由於碗是特製的，再加入唐辛子酌料後它會沉下去，在湯頭上的口感變化表現就沒那麼明顯。旁邊有檸檬水可以飲用過濾口腔味蕾，再次品嘗豚骨湯頭就沒那麼驚艷喉韻了，但整碗湯喝完喉嚨不會覺得乾渴不適。用餐過程良好 生意很好👍",null,[0,46]]]],[null,null,null,null,null,"https://business.google.com/local/business/7436494959505460452/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmtiRFJoV0Y5M1JSQUIQAA%3D%3D",[null,null,null,"/local/business/7436494959505460452/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBG