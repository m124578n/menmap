HHa6ACVoQ3IcHCFYoBg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3YcHCFkoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCFgoBw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCFooCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCFsoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCFwoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11y2kkc4gm"],"叉燒鷄白湯拉麵",2,null,null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3YcHCF4oAA"]],[1]],null,"建議的餐點",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCF0oCw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["天啊～我怎麼會這麼晚才發現這家店！！日式風格店面，除了有四人座位區還有可愛的吧台區，乾淨明亮，非常精緻的小店。\n位於熱鬧的大街上停車肯定不好停，機車還可以，客群設定應該就是附近的群眾了！\n餐點部分點了牛奶白醬拉麵及川味炙燒牛拉麵，兩種湯頭都非常濃郁，麵部分客製化的細節很多，可以滿足各個族群對於口感的要求，另外必須說，拉麵內的叉燒肉也太好吃，口齒留碳香的那種，好喜歡！\n另外看了評價跟著點了大受好評的唐揚雞，我個人覺得有點偏硬，但女兒覺得非常好吃。\n\n總觀來說是一個可以納入經常光顧的小店名單，期待二訪不一樣的餐點 😍\n\n阿～目前有line加好友活動，新好友送飲料哦！",null,[0,93]]]],[null,null,null,null,null,"https://business.google.com/local/business/7436494959505460452/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklYM05pVlZCQkVBRRAA",[null,null,null,"/local/business/7436494959505460452/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklYM05pVlZCQkVBRRAA"],"https://business.google.com/local/business/7436494959505460452/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklYM05pVlZCQkVBRRAA",[null,null,null,"/local/business/7436494959505460452/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklYM05pVlZCQkVBRRAA"],null,"https://business.google.com/