CAgICD8M63Zw",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3YcHCKMBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCKIBKAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3YcHCKUBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCKQBKA0",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCKYBKA4",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCKcBKA8",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjBtaC9yNKWAxViZvUHHa6ACVoQ3IcHCKgBKBA",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["探店，開了好一陣子的拉麵店經過都沒有吃，\n午餐跟兒子來個約會！\n兒子想吃辣辣麵，點了\n紅火火超過癮麻辣拉麵+85（+2片豬叉燒+4片雞叉燒，40元冷飲可選櫻花無糖煎茶、四季春茶、陳阿滿桂花紅茶 可四擇一）\n再單點一顆溏心蛋+25、再麵量加倍+25\n總共315元\n麵有Q度，筍干、玉米筍好吃😋\n雞嫩肉部位好像是雞胸肉，不柴超好吃，叉燒肉的厚度和油脂分佈均勻，肉都還很不錯。\n飲料我點繽紛野莓果茶，酸酸甜甜少女滋味，\n內用有檸檬水可以喝！\n我點的是粗麵，然後加麵的部分可以選擇另外一種麵條（細麵），因為沒有在湯裡面，所以有一點乾乾的！\n\n湯頭不錯吃完麵，喉嚨不會覺得乾渴不適。\n如果湯頭的味道不習慣，店內還有豚骨湯和雞骨湯可以自己調整鹹度！\n調味料部分有七味粉和麻辣醬可以加，\n在家附近很不錯，兒子一個人可以吃完一碗最大份量套餐，是可以再度光顧的好店！\n#麵匡匡拉麵店食堂（富國店）\n新北市新莊區富國路186號",null,[0,42]]]],[null,null,null,null,null,"https://business.google.com/local/business/7436494959505460452/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkVPRTAyTTIxM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/7436494959505460452/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkVPRTAyTTIxM1JSQUIQAA%3D%3D"],"https://business.google.com/local/business/7436494959505460452/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkVPRTAyTTIxM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/7436494959505460452/customers