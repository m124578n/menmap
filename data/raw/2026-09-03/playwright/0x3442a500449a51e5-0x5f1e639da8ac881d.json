",null,"0ahUKEwjA1p2QzdKWAxVnma8BHf8FKxoQ3IcHCFgoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjA1p2QzdKWAxVnma8BHf8FKxoQ3IcHCFkoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjA1p2QzdKWAxVnma8BHf8FKxoQ3YcHCFsoAA"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwjA1p2QzdKWAxVnma8BHf8FKxoQ3YcHCFwoAQ"]]],null,"用餐人數",null,"0ahUKEwjA1p2QzdKWAxVnma8BHf8FKxoQ3IcHCFooCQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["淡水少數品質不錯味道佳的拉麵！\n湯頭不是深沈濃厚的日式風味，但依然很有味，加了紅油整體風味更提升。細的麵條是份量很足的蕎麥麵（看起來像但也可能不是），搭配的舒肥雞肉跟豬肉片口感軟嫩表面還有再炙燒過的香味。另外還附有豆芽菜、滷筍、一整顆溏心蛋。\n一碗雞肉拉麵的蛋白質含量不錯、鈉含量也不算太高，整體滿符合健身人想吃拉麵又想補充蛋白質的需求。\n其他細節很加分，比如看似是魚板但其實是杏包菇的小燙印真的很可愛。外帶小菜跟麵條是分層隔開的，湯另外放也給得很足。店內裝潢很簡約時髦，規格融合日式拉麵店跟台灣人需求，除了1人快速用餐的吧台座位，也有高度較低的1-2人用餐桌座位，很適合好好享受一碗拉麵然後跟朋友看看裝潢。\n價格還算可以，也有低於200的餐點。下次還會想再來吃👍",null,[0,121]]]],[null,null,null,null,null,"https://business.google.com/local/business/490834887059193707/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDYzJORVVrMVRNbG93VmpGQ1ZVNUZWbWhVVmxsM1kyMXdXbGt5WXhBQhAA",[null,null,null,"/local/business/490834887059193707/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDYzJORVVrMVRNbG93VmpGQ1ZVNUZWbWhVVmxsM1kyMXdXbGt5WXhBQhAA"],"https://business.google.com/local/business/490834887059193707/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDYzJORVVrMVRNbG93VmpGQ1ZVNUZWbWhVVmxsM1kyMXdXbGt5WXhBQhAA",[null,null,null,"/local/business/490834887059193707/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDYzJORVVrMVRNbG93VmpGQ1ZVNUZWbWhVVmxsM1kyMXdXbGt5WXhBQhAA"],null,"https://business.google.com/local/business/490834887059193707/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDYzJORVVrMVRNbG93VmpGQ1ZVNUZWbWhVVmxsM1kyMXdXbGt5WXhBQhAA",[null,null,null,"/local/b