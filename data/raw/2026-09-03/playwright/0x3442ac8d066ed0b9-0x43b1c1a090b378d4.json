DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwidp8SuwtKWAxUXYvUHHZ-DDCIQ3IcHCHYoBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwidp8SuwtKWAxUXYvUHHZ-DDCIQ3IcHCHcoBg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["身為內湖人最喜歡的店！\n暖心的氛圍 真的很適合在被社會摧殘一整天之後 來這邊吃一碗熱呼呼的拉麵😭\n因為胃口不好點了半麵 還被老闆娘關心這樣吃不吃得飽😭😭😭\n誰懂在心情不好的時候被別人最純粹的關心有多感動😭😭😭😭😭\n\n跟闆娘聊天才知道原來這家店開八、九年了\n自己默默的從小吃了好幾年 也記不清到底吃過幾次了\n只知道價格一直都沒什麼漲 不知道店家到底有沒有賺 還招待溏心蛋 超佛心🫠\n\n店面的狀態也被老闆跟闆娘維持得非常好\n看得出來很用心在打理 沒有什麼歲月的痕跡\n一對老夫妻努力撐起來的一間溫馨小店❤️\n如果等待得比較久 大家也都很體諒\n這種雙向的溫暖真的很感動人🫶",null,[0,77]]]],[null,null,null,null,null,"https://business.google.com/local/business/9648130347008406551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhY1U5VlZucFViVVpTVjFoU1RsZFdUbTVoUjBreFpXcGtlbFJzUlJBQhAA",[null,null,null,"/local/business/9648130347008406551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhY1U5VlZucFViVVpTVjFoU1RsZFdUbTVoUjBreFpXcGtlbFJzUlJBQhAA"],"https://business.google.com/local/business/9648130347008406551/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhY1U5VlZucFViVVpTVjFoU1RsZFdUbTVoUjBreFpXcGtlbFJzUlJBQhAA",[null,null,null,"/local/business/9648130347008406551/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhY1U5VlZucFViVVpTVjFoU1RsZFdUbTVoUjBreFpXcGtlbFJzUlJBQhAA"],null,"https://business.google.com/local/business/9648130347008406551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhY1U5VlZucFViVVpTVjFoU1RsZFdUbTVoUjBreFpXcGtlbFJzUlJBQhAA",[null,null,null,"/local/business/9648130347008406551/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBhY1U5VlZucFViVVpTVjFoU1RsZFdUbTVoUjBreFpXcGtlbFJzUlJBQhAA"]],[null,null,236,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pacU9VVnpUbUZSV1hSTldWTm5hR0kxZWpkelRsRRAB!2m1!1s0x0:0x43b1c1a090b378d4!3m1