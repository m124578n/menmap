KEwig_br4xNKWAxWghq8BHY8pLkYQ3IcHCHgoDg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwig_br4xNKWAxWghq8BHY8pLkYQ3YcHCHsoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwig_br4xNKWAxWghq8BHY8pLkYQ3IcHCHooDw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwig_br4xNKWAxWghq8BHY8pLkYQ3IcHCHwoEA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwig_br4xNKWAxWghq8BHY8pLkYQ3IcHCH0oEQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwig_br4xNKWAxWghq8BHY8pLkYQ3IcHCH4oEg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwig_br4xNKWAxWghq8BHY8pLkYQ3YcHCIABKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwig_br4xNKWAxWghq8BHY8pLkYQ3IcHCH8oEw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["位玉成街與同德路交接馬路旁的拉麵店家\n店面空間裝潢典雅、乾淨、明亮、舒爽\n內用座位不多\n因此用餐高峰時段很需要耐心等候\n\n採掃QR Code線上點餐方式\n有雞/豬/牛肉蛤蜊拉麵類、叉燒飯、小菜...可選擇\n而麵體有分粗麵、細麵(再分硬、軟、適中口感)\n門口櫃台處前更備有檸檬冰水可自助使用\n\n點完餐後須先至櫃台結帳\n可現金、Line pay付款\n但沒開發票\n\n點了~豚骨拉麵、叉燒雞白湯拉麵、嫩胸雞白湯拉麵...皆為粗麵體\n與胡麻龍鬚涼菜、金翠腐乳泡菜、唐揚杏鮑菇\n\n出餐速度快\n料中食材新鮮味美(有糖心蛋、玉米筍、花椰菜、筍片)\n湯頭濃郁、鹹度適中\n麵體Q彈有嚼勁\n肉片與嫩胸雞肉口感軟嫩清香\n整體風味道地、份量合適\n\n而桌上有店家提供的特製辣醬\n絕對要試試、品嚐品嚐\n濃郁的獨特香氣\n加在拉麵中更添增風味與層次感\n著實讓人很著迷\n\n真是一處想吃拉麵、喜好吃拉麵的人之一個好選擇",null,[0,43]]]],[null,null,null,null,null,"https://business.google.com/local/business/15693216781761288417/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZGxKc1pFSlBSVlpMVXpCemQxUnVTalJSTUhoUlpEQTVVbE5GUlJBQhAA",[null,null,null,"/local/business/15693216781761288417/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB4ZGxKc1pFSlBSVlpMVXpCemQxUnVTalJSTUhoUlpEQTVVbE5GUlJBQhAA"],"https://business.google.com/local/business/15693216781761288417/customers/reviews/del