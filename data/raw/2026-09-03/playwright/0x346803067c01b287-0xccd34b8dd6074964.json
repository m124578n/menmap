l,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUNsd196RW1nRRAB"]],"CIHM0ogKEICAgIClw_zEZg",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjRmbvsxtKWAxUug68BHWxtCCsQ3IcHCHsoDA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjRmbvsxtKWAxUug68BHWxtCCsQ3IcHCHwoDQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjRmbvsxtKWAxUug68BHWxtCCsQ3IcHCH0oDg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["價位親民\n點的是招牌豚骨拉麵🍜\n叉燒🐔白湯拉麵🍜\n叉燒肉有點肥喔\n🐔白湯就是像淡淡的雞湯味\n\n湯頭剛剛好不算太鹹\n拉麵建議吃細的 這裡的比較粗\n吃起來偏硬 但口感也算不錯\n整體是好的 服務很好 ！👍\n\n還有小孩可以吃的 寶寶拉麵（8歲以下）\n唐揚雞 一吃打開我的味覺饗宴😋😋😋\n炸的居然可以炸這樣微微酥酥的\n非常的剛好 雞肉很嫩\n我本身沒有特別喜歡吃炸的\n但是他的皮好薄 而且搭配美乃滋\n真是絕配啊 ！\n\n還有明太子叉燒飯 偏重口味 偏鹹\n但是我的愛 並不感覺他的明太子是讓人會膩的\n一般明太子好吃 但是過多就感覺膩 它是非常適中的\n但對於清淡的人可能吃不慣\n給小朋友吃也不建議吃到太多醬\n\n還有檸檬水可以喝\n室內雖然空間不大\n可是很舒適 然後外觀明亮 文青風\n\n為了寫美食文特地點了好幾道\n我覺得滿意👍\n小菜部分-腐乳泡菜\n有別於以往吃的泡菜口感\n我以為是黃金泡菜\n但不太會形容\n一點點🤏豆腐乳味道👅\n然後吃起來像脆瓜 不是泡菜的口感\n會開胃 開啟我的味蕾 想一吃再吃\n有點清爽的口感 脆脆的",null,[0,24]]]],[null,1702640828000000,1702640828000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04eWQ5RUJ5d1JsZkR5OEFBeUJUQQ%7CCAEQrcz1_gkiMAoZQ0hfQm04eWQ5RUJ5d1JsZkR5OEFBeUJUQRoTQ2d3SXZQbndxd1lRd1pYa2hnTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjRmbvsxtKWAxUug68BHWxtCCsQ_2MIfigP"],"https://business.google.com/local/business/5122498884662866014/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTnNkMTk2UlcxblJSQUIQAA%3D%3D",[null,null,null,"/local/business/5122498884662866014/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTnNkMTk2UlcxblJSQUIQAA%3D%3D"],"https://business.google.com/local/business/5122498884662866014/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTnNkMTk2UlcxblJSQUIQAA%3D%3D",[null,null,null,"/local/business/5122498884662866014/customers/reviews/d