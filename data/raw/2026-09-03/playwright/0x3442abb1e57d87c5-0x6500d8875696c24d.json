KWAxWNoK8BHRt-EdwQ3YcHCJ8BKAA"]],1],null,null,"等待時間",null,"0ahUKEwiqotGbxdKWAxWNoK8BHRt-EdwQ3IcHCJ4BKAo",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_PLENTY_OF_PARKING"],"很多停車位",2,null,null,"0ahUKEwiqotGbxdKWAxWNoK8BHRt-EdwQ3YcHCKEBKAA"]],1],null,null,"停車位",null,"0ahUKEwiqotGbxdKWAxWNoK8BHRt-EdwQ3IcHCKABKAs",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_LOT"],"付費停車位",2,null,null,"0ahUKEwiqotGbxdKWAxWNoK8BHRt-EdwQ3YcHCKMBKAA"]]],null,"附近的停車場",null,"0ahUKEwiqotGbxdKWAxWNoK8BHRt-EdwQ3IcHCKIBKAw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiqotGbxdKWAxWNoK8BHRt-EdwQ3YcHCKUBKAA"]]],null,null,null,"0ahUKEwiqotGbxdKWAxWNoK8BHRt-EdwQ3IcHCKQBKA0",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["木島村給人的感覺有點像家庭式的日式料理店，除了拉麵之外，還有各式丼飯、炸物等品項。雖然主打日式拉麵，但在細節中又融合了些許台式風味，讓人感覺特別親切。\n\n我自己很喜歡他們的博多濃厚豚骨拉麵（380元），選了Q彈有勁的粗麵搭配濃郁湯頭，味道很有層次，卻一點也不油膩。麵量雖不算多，但貼心的是可以自由選擇麵條的粗細與口感的軟硬，整碗吃完還是很有飽足感。\n\n另外超推薦他們的炸豬排，外皮酥脆、口感紮實，吃起來相當過癮。整體來說是家價格中等、品質不錯的拉麵店，而且附近就有停車場，開車來也很方便！",null,[0,75]]]],[null,null,null,null,null,"https://business.google.com/local/business/6264139069284812686/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTlpNblZoVmpoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/6264139069284812686/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTlpNblZoVmpoQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/6264139069284812686/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTlpNblZoVmpoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/6264139069284812686/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTlpNblZoVmpoQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/6264139069284812686/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMF