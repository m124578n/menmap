0!2sCIHM0ogKEICAgICdz-302gE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x6500d8875696c24d"]],1,null,null,null,null,null,null,["0","7278055073615626829"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUNkei0yQUVREAE"]],"CIHM0ogKEICAgICdz-302gE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["員工感覺有老有少，可能是家庭經營，整體來說 CP 值還蠻高的，多個品項都落在 $200 以下👍 應該是附近居民常來的店家\n\n😊醬油濃股骨鋪滿叉燒拉麵 $335：友人點的品項，個人嚐了幾口覺得還不錯，原來湯頭除了醬油湯頭，還搭了豚雞湯頭，然後碗上還有滿滿澎湃的豬肉片🥩\n\n🌚博多拉麵 $265：以博多風味特濃雞湯為底，配料有筍子、蕈菇、豆子、海苔、番茄，跟預期的博多拉麵有點落差，個人覺得這個品項比較不合我胃口，有點不像之前吃過的博多拉麵 or 日式拉麵🍜\n\n✅唐揚炸雞 $80：原本以為這種家庭式風格的經營方式會不會炸出台式口感。還好沒有~ 我多慮了，這口味跟口感都真的是唐揚炸雞🍗\n\n☑️雖然是家庭式經營的感覺，但竟然敬業的備有自助點餐機可以調整口味：粗/細麵、麵硬/軟、折扣加炸蝦/豬排/竹筴魚\n\n☑️下次想來試試雞豚背脂拉麵",null,[0,133]]]],[null,null,null,null,null,"https://business.google.com/local/business/6264139069284812686/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtlaTB5UVVWUkVBRRAA",[null,null,null,"/local/business/6264139069284812686/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtlaTB5UVVWUkVBRRAA"],"https://business.google.com/local/business/6264139069284812686/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtlaTB5UVVWUkVBRRAA",[null,null,null,"/local/business/6264139069284812686/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtlaTB5UVVWUkVBRRAA"],null,"https://business.google.com/local/business/6264139069284812686/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtlaTB5UVVWUkVBRRAA",[null,null,null,"/local/business/6264139069284812686/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmtlaTB5UVVWUkVBRRAA"]],[null,null,10586,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNkei0yQUVREAE!2m1!1s0x0:0x6500d8875696c24d!3m1!1s2@1:CIHM0ogKEICAgICdz-2AEQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUNkei0yQUVREAE\u0026t\