l,"0ahUKEwik9cvpxdKWAxU2afUHHXdrAwIQ3IcHCHEoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwik9cvpxdKWAxU2afUHHXdrAwIQ3IcHCHIoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwik9cvpxdKWAxU2afUHHXdrAwIQ3IcHCHMoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwik9cvpxdKWAxU2afUHHXdrAwIQ3YcHCHUoAA"]]],null,"用餐人數",null,"0ahUKEwik9cvpxdKWAxU2afUHHXdrAwIQ3IcHCHQoCg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwik9cvpxdKWAxU2afUHHXdrAwIQ3YcHCHcoAA"]],1],null,null,"等待時間",null,"0ahUKEwik9cvpxdKWAxU2afUHHXdrAwIQ3IcHCHYoCw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["湯頭濃郁、服務細膩的誠意拉麵店\n初次造訪就被店員的親切打動，介紹非常詳盡，從湯頭特色到麵條軟硬度都能依個人喜好調整。\n這次點了清香黑蒜與鬼椒激辛，湯底都是超濃郁的豬骨風味。肉品部分是兩塊厚實的肋排肉（不帶骨），口感極佳。個人極推細麵選偏硬，完全達到我想要的嚼勁！\n小菜部分，炸水餃令人驚艷，外皮酥脆且肉質多汁鮮嫩，絕對是必點。燙青菜與炸豬排表現也都在水準之上。雖然湯頭口味較重，吃完稍有渴感，但現場備有檸檬水，下次會想再來挑戰清淡系列。",null,[0,218]]]],[null,null,null,null,null,"https://business.google.com/local/business/7894327743799417960/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrTkdWWFpFOVplVEZ4VlVaS2QyRjZZek5qVldONVkwWm9lRTlIWXhBQhAA",[null,null,null,"/local/business/7894327743799417960/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrTkdWWFpFOVplVEZ4VlVaS2QyRjZZek5qVldONVkwWm9lRTlIWXhBQhAA"],"https://business.google.com/local/business/7894327743799417960/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrTkdWWFpFOVplVEZ4VlVaS2QyRjZZek5qVldONVkwWm9lRTlIWXhBQhAA",[null,null,null,"/local/business/7894327743799417960/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVrTkdWWFpFOVplVEZ4VlVaS2QyRjZZek5qVldONVkwWm9lRTlIWXhBQhAA"],null,"https://business.google.com