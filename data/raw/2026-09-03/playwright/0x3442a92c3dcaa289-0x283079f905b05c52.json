"]],1],null,null,"等待時間",null,"0ahUKEwik9cvpxdKWAxU2afUHHXdrAwIQ3IcHCIwBKAs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["週六大約6點左右到拉麵店，不需等候，櫃檯點餐結帳後會送上拉麵，我今天點的湯頭是鮮蝦味增湯頭+肋眼叉燒（限量），一上來就有濃厚蝦味湯，湯頭醇厚跟味增max的很好，本來還擔心味增會拉走蝦味，第一口湯就蠻滿意的，我點細麵正常軟度，能吸附湯汁很滿意，女生吃份量很足夠，男生或食量大可能要多一球才會飽，肋眼叉燒很夠味，很軟嫩，肥而不膩，入口即化，整體而言很推薦大家來吃😍\n副餐點了一個炸餃子，普通，皮有點油，內餡是韭菜肉，皮太厚像是把煮水餃的拿來炸，沒有很推，可以pass。",null,[0,180]]]],[null,null,null,null,null,"https://business.google.com/local/business/7894327743799417960/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZSclRrZGlSRXBtWWtSbmVGWXdNWFpQUldocllVWkNlRlp0WXhBQhAA",[null,null,null,"/local/business/7894327743799417960/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZSclRrZGlSRXBtWWtSbmVGWXdNWFpQUldocllVWkNlRlp0WXhBQhAA"],"https://business.google.com/local/business/7894327743799417960/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZSclRrZGlSRXBtWWtSbmVGWXdNWFpQUldocllVWkNlRlp0WXhBQhAA",[null,null,null,"/local/business/7894327743799417960/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZSclRrZGlSRXBtWWtSbmVGWXdNWFpQUldocllVWkNlRlp0WXhBQhAA"],null,"https://business.google.com/local/business/7894327743799417960/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZSclRrZGlSRXBtWWtSbmVGWXdNWFpQUldocllVWkNlRlp0WXhBQhAA",[null,null,null,"/local/business/7894327743799417960/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZVZSclRrZGlSRXBtWWtSbmVGWXdNWFpQUldocllVWkNlRlp0WXhBQhAA"]],[null,null,2610,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT204eVRrTkdiREpmYkRneFYwMXZPRWhrYUZCeFZtYxAB!2m1!1s0x0:0x283079f905b05c52!3m1!1s2@1:CAIQACodChtycF9oOm8yTkNGbDJfbDgxV01vOEhkaFBxVmc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT204eVRrTkdiREpmYkRneFYwMXZPRWhrYUZCeFZtYxAB\u0026t\u003d1\u0026ent