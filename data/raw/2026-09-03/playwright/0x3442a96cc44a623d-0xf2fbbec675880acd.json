"],"髮圈",null,[null,null,null,null,8,0,8],null,"0ahUKEwjulpqgutKWAxX8jq8BHcI4A10Q1bMECL0DKEo",null,null,null,[[2]]],[["/m/0466pm8"],"碼點",null,[null,null,null,null,7,0,7],null,"0ahUKEwjulpqgutKWAxX8jq8BHcI4A10Q1bMECL4DKEs",null,null,null,[[2]]]]],[["Yukichi Ramen 諭吉拉麵 ── 堅持現場調理所有食材的日式拉麵，歡迎您前來品嚐！\n打破傳統框架，首波主打創新獨特「泡系豚骨拉麵」，有別於重鹹、重口味、油膩感十足的拉麵印象，泡系拉麵的特色就在於豚骨湯底沸騰後，從豬大骨釋放出的乳白色精華富含脂質及蛋白質，將其攪拌至產生「泡沫」便能產生獨特的乳白色湯，只有熬煮新鮮的大骨等食材才能產生的風味。\n另有使用大量豚骨及雞骨花費長時間熬煮提煉出雞\u0026豬精華的美味湯頭，淋上雞油\n搭配炙燒叉燒、舒肥叉燒與易於吸附湯汁的粗麵一起享用，味道濃郁的鶏豚醤油拉麵值得您一再品嚐。\n此外將熟成白、紅味噌充分混合為基底，加到大量豚骨及雞骨熬煮的美味湯頭裡，再搭著充滿咬勁的粗麵以及大量蔬菜，一碗風味十足的辛麻味噌拉麵就此誕生。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-GzqRj2sC19s/AAAAAAAAAAI/AAAAAAAAAAA/4pPpxQ1vIz0/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"臺北市中山區",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwjulpqgutKWAxX8jq8BHcI4A10QhbADCMADKAA","全部",[["CIHM0ogKEICAgICV9u3Z4QE",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkPiEzTYyx1U3GwRwjo-0I0VkTfQlPAJnVQbPbEOb0G6Wo6DHURNXNbPT8ndw1nO1k09kH2FfcSTgye5AenaIQTHnGEyB6Dpr4unY2tjm0hAtHcilgSpzSW-zC6fe7xYpRC6fsi\u003dw529-h298-k-no","",[1280,720],[203,100]],null,[[3,121.52492369999999,25.0502775],[0,90],[1280,720],75],"0m2Zau7lM_ydvr0PwvGM6AU","0ahUKEwjulpqgutKWAxX8jq8BHcI4A10QzCcIwQMoAA",null,null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgICV9u3Z4QE"],[10,3,[720,1280]],null,null,[[[2],[[null,null,25.0502775,121.52492369999999]]]],[1,null,null,[2,5],null,[null,null,"bizbuilder:gmb_api",[6,7,4,1,3]],null,null,[2023,12,7,4]],null,null,null,null,null,null,null,null,null,null,null,null,["UGCS_REFERENCE","CIHM0ogKEICAgICV9u3Z4QE||","1"]],1,null,null,null,null,null,null,["3765758523049927229","-937946337791964467"],null,"fh384w03taU"]],null,null,null,null,null,null,0,1,null,0],["CgIgARICGAI\u003d","0ahUKEwjulpqgutKWAxX8jq8BHcI4