business/7218070318606483481/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhUW1GVVRYZGtXR3hWWVc1c1IyUjZTbGhrV0doNldXdHNabEZzUlJBQhAA",[null,null,null,"/local/business/7218070318606483481/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhUW1GVVRYZGtXR3hWWVc1c1IyUjZTbGhrV0doNldXdHNabEZzUlJBQhAA"],"https://business.google.com/local/business/7218070318606483481/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhUW1GVVRYZGtXR3hWWVc1c1IyUjZTbGhrV0doNldXdHNabEZzUlJBQhAA",[null,null,null,"/local/business/7218070318606483481/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhUW1GVVRYZGtXR3hWWVc1c1IyUjZTbGhrV0doNldXdHNabEZzUlJBQhAA"],null,"https://business.google.com/local/business/7218070318606483481/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhUW1GVVRYZGtXR3hWWVc1c1IyUjZTbGhrV0doNldXdHNabEZzUlJBQhAA",[null,null,null,"/local/business/7218070318606483481/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhUW1GVVRYZGtXR3hWWVc1c1IyUjZTbGhrV0doNldXdHNabEZzUlJBQhAA"],null,["zh-Hant"],[["感謝 Tyler 這麼專業的分享！連交通和營業時間都寫得超詳細，太夠朋友了。\n\n很高興黑蒜拉麵有對你的味，至於煎餃若是喜歡更酥脆的口感，歡迎在點單的時候在備註欄位寫一下讓我們知道！另外，推薦將煎餃整個泡在隨附的醬汁裡，接著一口吃掉！味道會很棒喔！",null,[0,38]]]],[null,null,16643,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25aQmFUTXdkWGxVYW5sR2R6SlhkWGh6WWtsZlFsRRAB!2m1!1s0x0:0xf2fbbec675880acd!3m1!1s2@1:CAIQACodChtycF9oOnZBaTMwdXlUanlGdzJXdXhzYklfQlE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25aQmFUTXdkWGxVYW5sR2R6SlhkWGh6WWtsZlFsRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25aQmFUTXdkWGxVYW5sR2R6SlhkWGh6WWtsZlFsRRI-Ci9DQUlRQUNvZENodHljRjlvT25aQmFUTXdkWGxVYW5sR2R6SlhkWGh6WWtsZlFsRRILMGRHeHNhcVIxblcaPgovQ0FJUUFDb2RDaHR5Y0Y5b09uWkJhVE13ZFhsVWFubEdkekpYZFhoellrbGZRbEUSCzBkR3hzYXFSMW5XIhIJAAAAAAAAAAARzQqIdca--_IqCzBkR3hzYXFSMW5X\u0026wv\u003d1\u0026