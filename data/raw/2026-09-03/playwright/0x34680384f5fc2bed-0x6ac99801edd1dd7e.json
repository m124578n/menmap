null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["身為拉麵愛好者 家裡附近開拉麵店當然不能錯過\n\n小柑橘 主打柑橘系列的拉麵\n算是普遍接受度蠻高的種類 不會太鹹 湯又順口\n\n柑橘淡麗蟹出汁清湯拉麵\n喝下第一口湯 蟹的味道非常的重 讓人很驚艷\n但是多吃了幾口之後 反而會覺得有點膩\n蟹味跑去搶了湯頭的風采\n\n柑橘濃厚雞白湯拉麵\n雖然菜單上面寫了 雷 可是是我最喜歡的口味\n不管是大安的柑橘 還是這裡的小柑橘\n我都喜歡點這一道\n湯頭真的是沒話說 如果可以接受鹹一點的拉麵\n那我真的很推薦！！\n\n雞叉燒跟豬叉燒都還不錯吃 可以加點\n因為太晚去了 沒有吃到叉燒飯 有一點可惜\n下次再去跑叉燒飯點回來吃\n\n最後 用完餐後 店員才跟隔壁剛入座的人說\n第一球加麵 免費\n卻在我們入座時 沒有告知我們\n都把湯喝完了 根本沒機會享受免費的加麵",null,[0,37]]]],[null,1777652694000000,1777652694000000,"4 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfeWRSWE02bEhGOHN3SDMwYjM0MVNDQQ%7CCAEQrcz1_gkiMAoZQ0hfeWRSWE02bEhGOHN3SDMwYjM0MVNDQRoTQ2d3STFxZlR6d1lRd3NYUjd3RQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiRpsP_y9KWAxVegK8BHYMoLboQ_2MIZygM"],"https://business.google.com/local/business/2748350095992708428/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPUTJFelRqUmxRekUyWXpGb1JFOVRNVXBpUnpsVFZqSTFlRlJ0WXhBQhAA",[null,null,null,"/local/business/2748350095992708428/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPUTJFelRqUmxRekUyWXpGb1JFOVRNVXBpUnpsVFZqSTFlRlJ0WXhBQhAA"],"https://business.google.com/local/business/2748350095992708428/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPUTJFelRqUmxRekUyWXpGb1JFOVRNVXBpUnpsVFZqSTFlRlJ0WXhBQhAA",[null,null,null,"/local/business/2748350095992708428/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPUTJFelRqUmxRekUyWXpGb1JFOVRNVXBpUnpsVFZqSTFlRlJ0WXhBQhAA"],null,"https://business.google.com/local/business/2748350095992708428/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPUTJFelRqUmxRekUyWXpGb1JFOVRNVXBpUnpsVFZqSTFlRlJ0WXhBQhAA",[null,null,null,"/local/business/2748350095992708428/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPUTJFelRqUmxRekUyWXpGb1JFOVRNVXBpUnpsVFZqSTFlRlJ0WXhBQhAA"],null,["zh-Hant"],[["您好，非常感謝您留下這麼詳細且真實的用餐心得 