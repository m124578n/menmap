l,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjD7fzmxNKWAxVxdPUHHfvSJyUQ3IcHCIEBKBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjD7fzmxNKWAxVxdPUHHfvSJyUQ3YcHCIMBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjD7fzmxNKWAxVxdPUHHfvSJyUQ3IcHCIIBKB0",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwjD7fzmxNKWAxVxdPUHHfvSJyUQ3YcHCIUBKAA"]]],null,"用餐人數",null,"0ahUKEwjD7fzmxNKWAxVxdPUHHfvSJyUQ3IcHCIQBKB4",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["物有所值的日料家常餐廳，老闆個性爽朗親切，店面有分兩個一個是比較大桌的用餐區，另外一個是吧台加料理區，中間剛好隔了一間洗衣店！\n點餐是拿門口上的點菜單點好餐到廚房那裡跟老闆點餐，然後餐點做好老闆會幫你送過來。從餐店裡面食材的品質還有擺盤的狀態，你就可以看得出來老闆的用心，所以出餐會需要一點時間是可以被接受的。\n今天點的鱈魚肝調味非常好，食材也很新鮮，吃的出鮮甜的食材滋味！另外炙燒叉燒飯，還有肌肉肉親子丼也都非常香氣逼人，忍不住一口接一口，加點$60的套餐，送上來的是有很多鮭魚肉的味噌湯還有小菜，一點都不馬虎,而且真的都非常好吃!\n店裡面用餐的音樂很舒服，冷氣溫度也剛剛好雖然店面不大，但乾淨得宜,確實有在維護,整個用餐過程氛圍都很舒服!\n這裡大概是木柵最難停的地區之一，所以建議可以散散步走過來或者騎YouBike店面就在路邊很好找!\n老闆也有接受包場，可以幫你客制化無菜單料理，有需要也可以直接找老闆洽談。",null,[0,155]]]],[null,null,null,null,null,"https://business.google.com/local/business/699415876248596367/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwY1ZJd1ZrSmlWRXBDVjFNeFNGcHRPVVJPYm1jeFVYcFNVVTR6WXhBQhAA",[null,null,null,"/local/business/699415876248596367/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwY1ZJd1ZrSmlWRXBDVjFNeFNGcHRPVVJPYm1jeFVYcFNVVTR6WXhBQhAA"],"https://business.google.com/local/business/699415876248596367/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwY1ZJd1ZrSmlWRXBDVjFNeFNGcHRPVVJPYm1jeFVYcFNVVTR6WXhBQhAA",[null,null,null,"/local/business/699415876248596367/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwY1ZJd1ZrSmlWRXBDVjFNeFNGcHRPVVJPYm1jeFVYcFNVVTR6WXhBQhAA"],null,"https://business.google.com/l