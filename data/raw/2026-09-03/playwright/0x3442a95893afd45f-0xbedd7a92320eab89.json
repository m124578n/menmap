,null,"氣氛",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCJQCKAw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCJYCKAA"]],1],null,null,"等待時間",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCJUCKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["平日中午開店前15分鐘過去排隊，還可以在第一波就進去吃。首先，我也是參考了一下評論，褒貶不一，但都蠻值得參考的，因為我自己也很猶豫該不該給出好評的評價。我在吃完的1-2個小時後就拉肚子，顯然是真的這款拉麵真的太濃郁了，湯頭也都是滿滿精華，所以整碗要完食，可能後續會承受一些痛苦。再來是，我覺得他真的是蠻有特色的拉麵，有別於豚骨或白雞湯拉麵，是牡蠣🦪拉麵，所以偶爾吃一次或許可以。裡面最安全絕對是叉燒飯，焦香味很棒！",null,[0,207]]]],[null,null,null,null,null,"https://business.google.com/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VGxOdE9ERk5iRUpRVFVoWk5WRnFVbWhXTWprd1ZraENVMlZHUlJBQhAA",[null,null,null,"/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VGxOdE9ERk5iRUpRVFVoWk5WRnFVbWhXTWprd1ZraENVMlZHUlJBQhAA"],"https://business.google.com/local/business/2779703208744082773/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VGxOdE9ERk5iRUpRVFVoWk5WRnFVbWhXTWprd1ZraENVMlZHUlJBQhAA",[null,null,null,"/local/business/2779703208744082773/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VGxOdE9ERk5iRUpRVFVoWk5WRnFVbWhXTWprd1ZraENVMlZHUlJBQhAA"],null,"https://business.google.com/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VGxOdE9ERk5iRUpRVFVoWk5WRnFVbWhXTWprd1ZraENVMlZHUlJBQhAA",[null,null,null,"/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VGxOdE9ERk5iRUpRVFVoWk5WRnFVbWhXTWprd1ZraENVMlZHUlJBQhAA"]],[null,null,1728,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21wTlNtODFNbEJQTUhZNVFqUmhWMjkwVkhCU2VGRRAB!2m1!1s0x0:0xbedd7a92320eab89!3m1!1s2@1:CAIQAC