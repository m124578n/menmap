C8_Keb5X4\u0026fid\u003d0x0:0xbedd7a92320eab89"]],1,null,null,null,null,null,null,["0","-4693460468326552695"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT21ZNGFFNHRjV2t0YUdwa1ZFczNhRGcyWkVkMFVWRRAB"]],"CIABIhB8Bp7nw-n-bTFC8_Keb5X4",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCFQoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCFMoBw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCFYoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCFUoCA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCFcoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCFgoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCFkoCw",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["#二屋牡蠣拉麵\n拉麵浪人來拍過的好評拉麵店，平日晚上6點多其實也不用排隊等很久，第一次來不要亂加料先點最頂的340元的就好。\n牡蠣真的很大，肉.洋蔥.也都好吃無雷，湯頭雖然很濃郁不輸我在東京吃過的幾間濃郁系的，但鹹度還是有小降到台灣人能接受的程度，所以我也難得會把濃郁系的湯也喝完（當然還是要邊喝邊配冰水就是），這間還有一個很少有的優點就是可以無限加麵，不過我也只加了一球就8.9分飽了。\n最近已經吃了很多間海鮮系的拉麵，所以這次沒有再加干貝，下次二訪會想加來試試。\n然後我自己也發現海鮮系的其實不太需要像豚骨或純鹽.純醬油系的需要加蛋中和，原本的味道就很完美。",null,[0,62]]]],[null,null,null,null,null,"https://business.google.com/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaTkdGRk5IUmpWMnQwWVVkd2ExWkZjek5oUkdjeVdrVmtNRlZXUlJBQhAA",[null,null,null,"/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFaTkdGRk5IUmpWMnQwWVVkd2ExWkZjek5oUkdjeVdrVmtNRlZXUlJBQhAA"],"https://business.googl