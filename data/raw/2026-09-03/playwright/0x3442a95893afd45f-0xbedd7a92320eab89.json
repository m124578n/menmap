TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCM4BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCM0BKAg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCM8BKAk",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCNABKAo",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCNEBKAs",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCNMBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCNQBKAE"]]],null,"用餐人數",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCNIBKAw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_30_TO_60_MIN"],"30 到 60 分鐘",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCNYBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCNUBKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["［🔍完整食記歡迎追蹤 IG：yy.eating］\n［用餐日期：2026.02.28］\n-\n以牡蠣為主軸，在拉麵的選擇裡走出一條相對少見的路線。而且店家提供無限加麵的服務，對於食量大的人來說，真的可以吃得很滿足。\n-\n🌟 推薦餐點 🌟\n👉🏻 濃厚牡蠣拉麵／中太麵 ᴛᴡᴅ 𝟯𝟰𝟬／溏心蛋蛋 +ᴛᴡᴅ 𝟯𝟬\n這碗拉麵一入口，就能感受到湯體的厚度，帶著近乎醬感的濃稠質地，讓每一條麵都能被湯汁緊緊裹覆，是很有存在感的湯頭。\n整體風味富有鮮明的海味基底，喝得出用心堆疊的層次。不過作為「濃厚牡蠣拉麵」，反而覺得牡蠣的鮮味只是輕輕帶過，這與原本的期待確實有些落差。\n\n👉🏻 雞貝鹽味清湯拉麵／手揉麵 ᴛᴡᴅ 𝟮𝟴𝟬／溏心蛋蛋 +ᴛᴡᴅ 𝟯𝟬\n這碗拉麵則是明確的雞湯風味，溫潤、乾淨，沒有多餘的厚重感。細細去喝，才會慢慢浮出一絲淡淡的海味，像是輕輕疊上的尾韻，讓湯體多了一點層次，但不會搶戲。",null,[0,44]]]],[null,null,null,null,null,"https://business.google.com/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFzTVUxSE5IUlVia0pSVkVWd1VsVnFZelZUVjNCRVYxWndabUV4UlJBQhAA",[null,null,null,"/local/business/2779703208744082773/customers/rev