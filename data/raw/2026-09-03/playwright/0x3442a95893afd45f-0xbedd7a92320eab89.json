3YcHCO0BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCOwBKAo",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCO8BKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCO4BKAs",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCPEBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCPABKAw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_OTHER_DIETARY_RESTRICTIONS_TIPS"],"特殊餐點",null,null,"分享特殊餐點相關資訊","特殊餐點",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCPIBKA0",null,null,["牡蠣的湯底。"],null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_DIFFICULT_TO_FIND"],"停車不方便",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCPQBKAA"]],1],null,null,"停車位",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCPMBKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_GARAGE"],"付費室內停車場",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCPYBKAA"]]],null,"附近的停車場",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCPUBKA8",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCPcBKBA",null,null,["附近停車場最大的大概是捷運公司大樓前面的平面停車場，以及中山運動中心地下停車場，例假日應該都是一位難求。另外是新光三越百貨的地下停車場，更是要排隊。再來就是更遠的建成國中地下停車場及京站停車場和台北車站停車場，走路要一個捷運站的距離。"],null,null,3,null,2],[["GUIDED_DINING_KID_FRIENDLINESS_TIPS"],"親子友善程度",null,null,"分享親子友善程度相關資訊","親子友善程度",null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCPgBKBE",null,null,["室內狹窄有限，嬰兒推車應該不大方便。"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:OTHER_DIETARY_RESTRICTIONS"],"特殊餐點",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCPoBKAA"],[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCPsBKAE"],[["E:KID_FRIENDLINESS"],"親子友善程度",2,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3YcHCPwBKAI"]]],null,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ3IcHCPkBKBI",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["星期六在巷弄間尋找午餐，看到了這個顯眼的燈籠。好像剛好遇到了下午客人較少的時間，等待不到五分鐘就可以點餐，簡直太幸運了！\n點餐機為觸控螢幕，點餐基本上很簡單又易懂，而且居然可以刷載具真不錯。但是既然可以刷載具卻不能刷Linepay真是太可惜了，還好皮夾裡面還有現金，不然就尷尬了。\n除了拉麵，還有京都啤酒，就點瓶來試試看吧！結果啤酒先上，附上的杯子還是銅杯，真特別。啤酒的固形物應該蠻豐富的，泡沫細緻且持久，喝起來啤酒花苦香略重，有特殊到，但是180還是當作嚐新就好。\n我點的是清湯雞貝拉麵，應該是鹽味，湯真的清澈見底，搭配上我習慣的細硬麵真的是好吃到想拍手了。溏心蛋是另外加購的，還好有加購，不然蛋白質還真的覺得不大夠。不過溏心蛋就像照片裡的一樣，好吃入味，但是我真希望它再溏心一點更完美。\n另外一碗是濃厚牡蠣拉麵，有試喝了一口湯，真的是濃厚到口腔黏膜增厚的感覺，應該是豚骨加上也許是蠔乾之類的原料去熬煮的吧？難怪櫃檯上有附上自己可倒冰水的水壺和水杯。\n很棒的是店家也在櫃檯上貼了可以無限加麵和加清湯的選項，加麵顯然今天是不行，吃不下了，不然有這麼好的高湯還真的可以多吃一點。而加清湯顯然是對於濃厚湯底可以調節的措施，對顧客來說也是不錯的選擇，算是店家的貼心。\n下次還是在人潮比較少的時候再來試試看多加一球吧！",null,[0,140]]]],[null,null,null,null,null,"https://business.google.com/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHVUZVd2R6SlBSbEpJWld0MGExbHFXa3hSTVhCUFdERlNUVkV4UlJBQhAA",[null,null,null,"/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHVUZVd2R6SlBSbEpJWld0MGExbHFXa3hSTVhCUFdERlNUVkV4UlJBQhAA"],"https://business.google.com/local/business/2779703208744082773/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHVUZVd2R6SlBSbEpJWld0MGExbHFXa3hSTVhCUFdERlNUVkV4UlJBQhAA",[null,null,null,"/local/business/2779703208744082773/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHVUZVd2R6SlBSbEpJWld0MGExbHFXa3hSTVhCUFdERlNUVkV4UlJBQhAA"],null,"https://business.google.com/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHVUZVd2R6SlBSbEpJWld0MGExbHFXa3hSTVhCUFdERlNUVkV4UlJBQhAA",[null,null,null,"/local/business/2779703208744082773/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEh