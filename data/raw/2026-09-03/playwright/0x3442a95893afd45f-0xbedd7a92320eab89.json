ic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,2],[null,null,[["CIHM0ogKEICAgIDVzK3O_QE",["CIHM0ogKEICAgIDVzK3O_QE",10,12,null,null,null,["https://lh3.googleusercontent.com/grass-cs/ACvplmORhRUJUr6K7r643r7L9PxCHh1Aq_BWWBbwzkONjvFrdYsplp0R8LYY4o7MJZLDG9bT_ozJJLLp9QwuijkjPPdken7X-ZdXmTknUpODwjea4K4Y1i_0T2rBJarczVT9cLKglJT73Q\u003dk-no",null,[4000,2250]],null,[[3,121.52021740997093,25.054586885173418],[0,90],[4000,2250],75],"iRKZau-MKLaYvr0P3NefwQk","0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQzCcI9AIoAQ",["//www.google.com/local/imagery/report/?cb_client\u003dugc_photo_posts\u0026image_key\u003d!1e10!2sCIHM0ogKEICAgIDVzK3O_QE\u0026fid\u003d0x0:0xbedd7a92320eab89",null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ-y4I9QIoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIDVzK3O_QE"],[10,3,[2250,4000]],[null,null,null,null,null,null,null,["二屋牡蠣拉麵"]],[null,[[["Chrono Huang"],"https://www.google.com/maps/contrib/102485338815416250624?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjU1C_rexSWITolEgWqCcssFHAfiHqWYpoVsDiaAr7fhw83zP6E\u003ds120-c-rp-mo-ba12-br100",null,null,"102485338815416250624"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2023,12,11,11,null,null,null,null,["2 年前"]]],["//www.google.com/local/imagery/report/?cb_client\u003dugc_photo_posts\u0026image_key\u003d!1e10!2sCIHM0ogKEICAgIDVzK3O_QE\u0026fid\u003d0x0:0xbedd7a92320eab89"]],1,null,null,null,null,null,null,["0","-4693460468326552695"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSURWekszT3ZRRRAB"]],"CIHM0ogKEICAgIDVzK3O_QE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["用餐日期：2023.12.10\n這次來吃是第二次，上次吃已經是一年前的事了，過了一年排隊人潮依然不減，約11點左右到前面已經十多人，得等到第二輪，還有拉行李箱過來的，看來似乎有外國人慕名前來，想來吃的人得有排隊的心理準備。\n這次吃的是鹽味的牡蠣牡蠣拉麵，湯頭依然是水準之上，鮮味十足又不會死鹹，麵的話比較沒什麼亮點，也沒什麽大缺點，加的麵是細麵，如果吃的下，可以嘗試一下，感受細麵帶來的差異；配料方面，蛋要另點，這點要稍微注意一下，我是不討厭這種做法，畢竟還是有人不愛糖心蛋的；整體來說配料豐富但略少，雖然可以加點，但這樣價錢相對很感人。",null,[0,111]]]],[null,null,null,null,null,"https://business.google.com/local/business/2779703208744082773/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUldla3N6VDNaUlJSQUIQAQ%3D%3D",[null,null,null,"/local/business/2779703208744082773/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUldla3N6VDNaUlJSQUIQAQ%3D%3D"],"https://business.google.com/local/business/2779703208744082773/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUldla3N6VDNaUlJSQUIQAQ%3D%3D",[null,null,null,"/local/business/2779703208744082773/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUldla3N6VDNaUlJSQUIQAQ%3D%3D"],null,"https://business.google.com/local/business/2779703208744082773/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUldla3N6VDNaUlJSQUIQAQ%3D%3D",[null,null,null,"/local/business/2779703208744082773/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUldla3N6VDNaUlJSQUIQAQ%3D%3D"]],[null,null,null,["https://www.google.com/maps/@/data\u003d!4m7!23m6!1m5!1sChdDSUhNMG9nS0VJQ0FnSURWekszT3ZRRRAB!2m1!1s0x0:0xbedd7a92320eab89!3m1!1s2@1:CIHM0ogKEICAgIDVzK3OvQE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURWekszT3ZRRRAB\u0026t\u003d3\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURWekszT3ZRRRIsChZDSUhNMG9nS0VJQ0FnSURWekszT2ZREhJDZ3NJcGVUYnF3WVFvTnZQWEEiEgkAAAAAAAAAABGJqw4yknrdvioLMF9TajdfQVp5cVY\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQoykI9gIoAg"],null,[null,[[1,0]]]],"0ahUKEwiHxfuY49GWAxU9eV4EHRTeLX4Q0pMFCK4CKA8"],null,null,null,"0ahUKEwiv9fOY49GWAxU2jK8BHdzrJ5gQ0pMFCPICKAc"]],null,null,null,null,null,"Ci8IARInCgoAP72HOnXh61__EhCYmhmgzo-yQQPGgtsAAAAAGgf_AnOnXh61GAAiAA"],null,[[[[["Ci9DQUlRQUNvZENodHljRjlvT21ZNGFFNHRjV2t0YUdwa1ZFczNhRGcyWkVkMFVWRRAB",["0x0:0xbedd7a92320eab89",null,1781258406835160,1781258406835160,[null,null,["https://www.google.com/maps/contrib/101403818698751047363/reviews?hl\u003dzh-TW"],nul