14?hl\u003dzh-TW","https://lh3.googleusercontent.com/a/ACg8ocKYnpxdYmSO2mnuGEpqhd4MCj8VGygMlI3SSOS9z9hGrDp_0w\u003ds120-c-rp-mo-br100",null,null,"109530064000756741714"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,3,30,12,null,null,null,null,["5 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhCF_Gp_OltdEXaLueJUKtXa\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xbd74a4c50cdc786c"]],1,null,null,null,null,null,null,["0","-4795026537011447700"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xGRlkyMTJVbU5JUjJOWVNYcDZjMk5mVFU5aldHYxAB"]],"CIABIhCF_Gp_OltdEXaLueJUKtXa",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiY9tL5wNKWAxUyna8BHd_nNY0Q3IcHCJQBKAM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiY9tL5wNKWAxUyna8BHd_nNY0Q3IcHCJUBKAQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiY9tL5wNKWAxUyna8BHd_nNY0Q3IcHCJYBKAU",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["我覺得田冶的醬油拉麵超級好吃的，我喝到湯的第一個反應覺得相當驚艷，因為他們的醬油拉麵有別於一般口味，湯頭是用烏骨雞下去熬煮的，一入口可以感受到很溫順的雞湯香氣，再加上三河屋製麵的麵體，相當的有口感，光是這樣我就已經覺得很厲害了👍\n\n而麵裡三種不同的叉燒，讓每次吃的時候都有新的感受，不會過於無聊，溏心蛋的熟度也是我個人很喜歡的膏狀，入口充滿著濃郁的蛋香。搭配上水菜、海苔和筍乾，一碗麵裡有著這麼多的配料相當滿足。\n\n他們的唐揚雞跟牡蠣也是必點，雞肉是採用雞腿肉，肉非常軟嫩，即使放一段時間再吃，外皮還是相當酥脆。炸牡蠣麵衣緊緊的巴著牡蠣本身，脆脆的外皮，裡面是鮮甜的牡蠣，而且重點是牡蠣本身就是這麼大顆飽滿，必點！\n\n在台北吃過這麼多拉麵，如果想吃到最正宗的日式拉麵我真心推薦田冶，尤其他們有日本主廚嚴格把關，絕對是可以放心不踩雷的。",null,[0,114]]]],[null,1776493537000000,1776493537000000,"4 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfNVh3VkhZalNhMjUxTXdBZklyOFpXQQ%7CCAEQrcz1_gkiMAoZQ0hfNVh3VkhZalNhMjUxTXdBZklyOFpXQRoTQ2d3STRjZU16d1lRd3Q2Yl9nRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiY9tL5wNKWAxUyna8BHd_nNY0Q_2MIlwEoBg"],"https://business.goo