1bMECL8CKFE",null,null,null,[[2]]],[["/g/11bc58g7z3"],"蕓薹亞種日本",null,[null,null,null,null,10,0,10],null,"0ahUKEwiY9tL5wNKWAxUyna8BHd_nNY0Q1bMECMACKFI",null,null,null,[[2]]]]],[["從忠孝敦化站步行3分鐘即可抵達。\n這是位於台北市大安區的拉麵店「麵處田冶」。\n\n本店提供使用台灣產烏骨雞精心熬製的醬油拉麵與鹽味拉麵。\n從風味濃郁的烏骨雞中細心熬製出的湯頭，口感清爽卻又深具層次，令人忍不住想喝到最後一口，非常推薦。\n\n醬油拉麵香氣馥郁且層次豐富，鹽味拉麵則以溫和的風味襯托食材原有的鮮美，讓您能品嚐到截然不同的美味。\n\n歡迎蒞臨東區216巷（東區珍珠奶茶街內），品嚐正宗的雞清湯與講究的拉麵。\n\n若您正在台北市大安區／忠孝敦化站一帶尋找拉麵店，請務必前來光臨。\n我們誠摯期待您的到訪。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh3.googleusercontent.com/-WM1nwns2MhQ/AAAAAAAAAAI/AAAAAAAAAAA/r6hsd88Ko8s/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"臺北市大安區建倫里",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwiY9tL5wNKWAxUyna8BHd_nNY0QhbADCMICKAA","全部",[["CIHM0ogKEICAgIC61OjKBg",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmRZLhDkkIgm54G5f9gWAmlMh2ZdbcHeQuDppkFsiy5C4DTSGZ18mTolcQOJOgB8s5IDBwjBvNRCqVfwm8SbcCIqyCO-8cOyEu35onUYkDVx1rn23ZaMbSoU4okiXvINJBTHJfU\u003dw298-h298-k-no","",[400,400],[203,100]],null,[[3,121.5523114,25.039461799999998],[0,90],[400,400],75],"2XSZatilArK6vr0P38_X6Qg","0ahUKEwiY9tL5wNKWAxUyna8BHd_nNY0QzCcIwwIoAA",null,null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIC61OjKBg"],[10,3,[400,400]],null,null,[[[2],[[null,null,25.039461799999998,121.5523114]]]],[1,null,null,[2,5],null,[null,null,"bizbuilder:gmb_web",[6,7,4,1,3]],null,null,[2021,2,8,1]],null,null,null,null,null,null,null,null,null,null,null,null,["UGCS_REFERENCE","CIHM0ogKEICAgIC61OjKBg||","1"]],1,null,null,null,null,null,null,["3765761266997135353","-4795026537011447700"],null,"EKlU-yPFzHk"]],null,null,null,null,null,null,0,1,null,0],["CgIgARICGAI\u003d","0ahUKEwiY9tL5wNKWAxUyna8BHd_nNY0QhbADCMQCKAE","最新",[["CIABIhC7cYRPJ-5GabZTEdjVGzDZ",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkEC70s5SAqP3p1qZ9xtNQj