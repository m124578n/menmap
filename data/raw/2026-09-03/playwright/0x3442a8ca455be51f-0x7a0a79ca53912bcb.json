KBU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjppcWCzdKWAxWodvUHHVJvDewQ3IcHCJIBKBY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjppcWCzdKWAxWodvUHHVJvDewQ3IcHCJMBKBc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_OTHER_DIETARY_RESTRICTIONS_TIPS"],"特殊餐點",null,null,"分享特殊餐點相關資訊","特殊餐點",null,"0ahUKEwjppcWCzdKWAxWodvUHHVJvDewQ3IcHCJQBKBg",null,null,["鯖魚定食"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:OTHER_DIETARY_RESTRICTIONS"],"特殊餐點",2,null,null,"0ahUKEwjppcWCzdKWAxWodvUHHVJvDewQ3YcHCJYBKAA"]]],null,null,null,"0ahUKEwjppcWCzdKWAxWodvUHHVJvDewQ3IcHCJUBKBk",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["在地經營很久的日式料理店，從小到大偶爾家庭聚餐的好餐廳。\n環境舒適、平價乾淨。\n\n1.炸蝦定食，$280，兩條大炸蝦還有其他蔬食天麩羅，搭配醬料好吃。\n2.鯖魚定食，$220，因為現烤上菜速度較慢，不柴非常好吃，搭配檸檬跟胡椒鹽更清爽。\n3.鮭魚炒飯，$100，一大盤，粒粒分明。\n4.花壽司（8粒），$240，每個內餡飽滿看著就很有食慾，附的薑片很薄也很溫和。\n5.定食都會有 小菜*2、白飯*1、茶碗蒸*1、味噌湯*1\n6.有飯後甜點，綠豆湯，料很多，有點小可惜是天冷綠豆甜湯也是冷的。\n\n有二樓和廁所，整體好吃，非常滿足，超適合聚餐享用。",null,[0,39]]]],[],[null,null,11538,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUNfNk1QRTNBRRAB!2m1!1s0x0:0x7a0a79ca53912bcb!3m1!1s2@1:CIHM0ogKEICAgIC_6MPE3AE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUNfNk1QRTNBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUNfNk1QRTNBRRItChZDSUhNMG9nS0VJQ0FnSUNfNk1QRVBBEhNDZ3dJclBhT3ZBWVEtT3kyblFJGi4KF0NJSE0wb2dLRUlDQWdJQ182TVBFdkFFEhNDZ3dJclBhT3ZBWVEtT3kyblFJIhIJAAAAAAAAAAARyyuRU8p5CnoqCzBiVnZnZ1lmUU9z\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjppcWCzdKWAxWodvUHHVJvDewQoykIlwEoGg"],null,[null,[[1,1]]]],"0ahUKEwjR7c-CzdKWAxUodV4EHXq4JwYQ0pMFCB0oAQ"],null,null,null,"0ahUKEwjppcWCzdKWAxWodvUHHVJvDewQ0pMFCGcoAQ"],[["Ci9DQUlRQUNvZENodHljRjlvT2tKelZFMVVjbEZ6VG5ScWVXTkdhRkI0UTB4SFEwRRAB",["0x0:0x7a0a79ca53912bcb",null,17641