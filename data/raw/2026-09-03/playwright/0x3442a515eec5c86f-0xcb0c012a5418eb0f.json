"https://www.google.com/maps/contrib/106998238822307299508?hl\u003dzh-TW","https://lh3.googleusercontent.com/a/ACg8ocJnNdJ4qreng_B_nHuMJqpG73UKlkYaU3r4X-DpG0THeAPveA\u003ds120-c-rp-mo-ba12-br100",null,null,"106998238822307299508"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,6,13,11,null,null,null,null,["2 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhA6rPyaMaVgOoiRSJddaTRw\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xcb0c012a5418eb0f"]],1,null,null,null,null,null,null,["0","-3815673502978479345"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25KeVIwZG9kVGx1VjJSNFNtdzVRakZYT0U5SVVGRRAB"]],"CIABIhA6rPyaMaVgOoiRSJddaTRw",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwirlPCNzdKWAxXuj68BHcErGA4Q3IcHCFAoBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwirlPCNzdKWAxXuj68BHcErGA4Q3IcHCFEoBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwirlPCNzdKWAxXuj68BHcErGA4Q3IcHCFIoBg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這次到淡水品嚐「長生塩人」，整體用餐體驗相當不錯，難怪在網路上擁有不少好評。店面雖然不大，但充滿濃濃的日式風格，暖黃色燈光搭配簡約裝潢，讓人一走進去就有種來到日本街邊拉麵店的感覺，氛圍十分舒適。\n\n這次點了招牌的塩味拉麵以及辛味拉麵。塩味拉麵的湯頭清澈甘甜，喝起來相當順口，不會有過重的鹹膩感，能品嚐到食材熬煮後自然的鮮甜。麵條口感彈牙，吸附湯汁後更能帶出整體風味。叉燒肉則是肥瘦比例恰到好處，入口軟嫩不柴，每一口都能感受到肉香與油脂的層次感。\n\n辛味拉麵則是另一種享受，紅潤的湯頭看起來相當有氣勢，但辣度並不會過於刺激，而是在濃郁湯底中增添香辣風味，讓人忍不住一口接一口。搭配海苔、青江菜以及溏心蛋，更增添豐富層次。\n\n店家提供的小菜也相當加分，泡菜及醃蘿蔔清爽開胃，與拉麵搭配十分對味，能適時平衡湯頭的濃郁感。\n\n如果來到淡水，除了老街美食之外，很推薦安排一餐來長生塩人品嚐拉麵。無論是喜歡清爽系湯頭，還是偏愛帶點辣度的重口味拉麵，都能找到適合自己的選擇。店內環境乾淨舒適、餐點用心，是一間會讓人想再回訪的拉麵店，推薦給喜歡日式拉麵的朋友們！🍜✨",null,[0,97]]]],[null,1781486415000000,1781486415000000,"2 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfMlBSRlpTTEx3Z1paWGVIdTVJTHEtdw%7CCAEQrcz1_gkiMAoZQ0hfMlBSRlpTTEx3Z1paWGVIdT