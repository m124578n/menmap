3dfUHHRx9MLAQ3IcHCKQBKBk",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["門口有點餐付費機，介面不麻煩也會有工作人員協助使用，也會建議加入line會有優惠。但每組人點餐還是需要花點時間在這機器上，個人是不太喜歡就是了。\n\n拉麵有麵軟硬，湯頭鹹淡等喜好選項可選，整體表現持平，溏心蛋是完整一顆，吃不飽還可以加麵。\n\n甜點是足以獨立的品項，非廉價加購品，加購吃到飽不會後悔。\n\nPS:目前有商業午餐套組優惠價 真心覺得很划。",null,[0,118]]]],[null,null,null,null,null,"https://business.google.com/local/business/4694982192475151116/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPVldKdWJIbGhSamxNVWtjMGVrNVhWVEpOYTNSUVQwUkdXRlpGUlJBQhAA",[null,null,null,"/local/business/4694982192475151116/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPVldKdWJIbGhSamxNVWtjMGVrNVhWVEpOYTNSUVQwUkdXRlpGUlJBQhAA"],"https://business.google.com/local/business/4694982192475151116/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPVldKdWJIbGhSamxNVWtjMGVrNVhWVEpOYTNSUVQwUkdXRlpGUlJBQhAA",[null,null,null,"/local/business/4694982192475151116/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPVldKdWJIbGhSamxNVWtjMGVrNVhWVEpOYTNSUVQwUkdXRlpGUlJBQhAA"],null,"https://business.google.com/local/business/4694982192475151116/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPVldKdWJIbGhSamxNVWtjMGVrNVhWVEpOYTNSUVQwUkdXRlpGUlJBQhAA",[null,null,null,"/local/business/4694982192475151116/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFPVldKdWJIbGhSamxNVWtjMGVrNVhWVEpOYTNSUVQwUkdXRlpGUlJBQhAA"]],[null,null,953,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21OVWJubHlhRjlMUkc0ek5XVTJNa3RQT0RGWFZFRRAB!2m1!1s0x0:0x4ba19ee6e08ef273!3m1!1s2@1:CAIQACodChtycF9oOmNUbnlyaF9LRG4zNWU2MktPODFXVEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21OVWJubHlhRjlMUkc0ek5XVTJNa3RQT0RGWFZFRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT21OVWJubHlhRjlMUkc0ek5XVTJNa3RQT0RGWFZFRRI-Ci9DQUlRQUNvZENodHljRjlvT