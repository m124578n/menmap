KEwi4taLLwNKWAxV3dfUHHRx9MLAQ3YcHCGwoAA"]],1],null,null,"餐點類型",null,"0ahUKEwi4taLLwNKWAxV3dfUHHRx9MLAQ3IcHCGsoCQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi4taLLwNKWAxV3dfUHHRx9MLAQ3IcHCG0oCg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi4taLLwNKWAxV3dfUHHRx9MLAQ3IcHCG4oCw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi4taLLwNKWAxV3dfUHHRx9MLAQ3IcHCG8oDA",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwi4taLLwNKWAxV3dfUHHRx9MLAQ3YcHCHEoAA"]],1],null,null,"等待時間",null,"0ahUKEwi4taLLwNKWAxV3dfUHHRx9MLAQ3IcHCHAoDQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["豆花，是要加$30，然後店家會給一個豆花小碗，自己裝！\n不過去的這一天，可能是生意太好，豆花全空了⋯⋯而且就只有兩種料紅豆、麥角⋯⋯如果吃完拉麵的油膩感，不想跑，是可以點，但別忘了！！這間店在樂華夜市😆🤣\n店內是有提供免費的水，和古早味紅茶可以喝。\n今天點的是雞白豚骨拉麵、醬油豚骨拉麵 $175，多$10 ，是因為把肉換成雞肉！！\n首先，糖心蛋，是給一顆，這一點很有誠意👍🏻雞肉4片，不柴很嫩好吃！滷筍絲也很入味，也很好吃！再來是湯頭，不管是白糖、或是醬油的湯頭，比起一般的拉麵店，他的湯頭算是非常的不油，這點，不喜歡吃太油太膩的，這一點真的很加分！！\n整體也不會太鹹，是一碗中規中矩的拉麵！\n目前內用，都可以+1次的麵，第一次點的時候，是可以選麵條的軟硬度，二次加麵則無法選擇麵條的軟硬度！\n喜歡吃辣的人，千萬別錯過他的辣椒，不辣，卻提升了整碗麵的香氣，一定要加！",null,[0,124]]]],[null,null,null,null,null,"https://business.google.com/local/business/4694982192475151116/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDU1dGWVZteE9SemxwVlcxMFYxUnRSa1ppUlZKVVpEQkdkbU51WXhBQhAA",[null,null,null,"/local/business/4694982192475151116/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDU1dGWVZteE9SemxwVlcxMFYxUnRSa1ppUlZKVVpEQkdkbU51WXhBQhAA"],"https://business.google.com/local/business/4694982192475151116/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDU1dGWVZteE9SemxwVlcxMFYxUnRSa1ppUlZKVVpEQkdkbU51WXhBQhAA",[null,null,null,"/local/business/4694982192475151116/customers/reviews/deletereply?p\u003dCkRDaTlEUVV