AL_TYPE"],"用餐類型為何？",[[[["E:OTHER"],"其他",2,null,null,"0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3YcHCMIBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3IcHCMEBKAo",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3YcHCMQBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3IcHCMMBKAs",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3IcHCMUBKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3IcHCMYBKA0",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3IcHCMcBKA4",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["店不會很大間但裝潢的很有拉麵風格\n服務人員態度親切，上菜速度很快。\n\n鹹蛋黃金沙拉麵真的很不錯，味道很鹹蛋黃卻又不會讓人覺得濃郁的很噁。整個適中剛剛好\n川味炙燒牛湯頭也很讚，大概是因為肉烤過的關係？有一股烤味搭配在一起非常好喝，完全無違和真的很推。\n\n唐揚雞真的好吃到爆，肉超嫩。\n\n送餐的時候不小心送錯了，我吃了兩口後來發現。之後店員說要裝起來給我外帶回家我實在是很不好意思，最後臨走前想說要付這一碗吃錯的麵錢。畢竟不是單方問題雙方都有錯，我自己也沒注意，不希望店員賠錢。\n結果他們人超好的說沒關係真的沒關係希望我們常常去吃就好🥺\n讓我真的很拍謝的說，但不得不說服務態度真的好好值得五星。",null,[0,33]]]],[null,null,null,null,null,"https://business.google.com/local/business/11949232167681125317/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNaM1p1UkhwblJSQUIQAA%3D%3D",[null,null,null,"/local/business/11949232167681125317/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNaM1p1UkhwblJSQUIQAA%3D%3D"],"https://business.google.com/local/business/11949232167681125317/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNaM1p1UkhwblJSQUIQAA%3D%3D",[null,null,null,"/local/business/11949232167681125317/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTTNaM1p1UkhwblJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/11949232167681125317/cus