午餐",2,null,null,"0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3YcHCPABKAA"]],1],null,null,"餐點類型",null,"0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3IcHCO8BKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3YcHCPIBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwidxLe6yNKWAxVLe_UHHdkSMqMQ3IcHCPEBKAY",null,null,null,null,null,1,[[2]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["來用餐三次，真的受不了了。\n先說；服務人員態度很好，用餐環境也舒服。\n拉麵整體也不錯，唯獨⋯⋯⋯⋯⋯⋯唐揚雞點三次驚嘆三次，第一次抱著期待，第二次抱著再給一次機會，直到今天原本沒點，點完所有餐點之後，看到隔壁桌的唐揚雞跟圖片上的很像，想說有改善了，上才之後，與老婆互看了十秒左右⋯\n首先身為客人的我們一定是看圖片參考，個人覺得端上來的唐揚雞跟圖片是不一樣的東西，你們這個比較像是唐揚碎肉⋯把碎肉黏在一起，筷子一撥就散掉了，寧可你們炸大塊紮實寫數量，客人能接受就接受，而不是為了省錢端上這樣的東西，事不過三，之後不會再點唐揚雞了，身為一個拉麵食堂想附加炸雞，品質應該顧好，給其他人參考看看「唐揚雞」的實體照，可惜上次沒拍到，上次更小更碎。\n望改進⋯⋯⋯",null,[0,34]]]],[null,null,null,null,null,"https://business.google.com/local/business/11949232167681125317/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklOelpwWDBkbkVBRRAA",[null,null,null,"/local/business/11949232167681125317/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklOelpwWDBkbkVBRRAA"],"https://business.google.com/local/business/11949232167681125317/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklOelpwWDBkbkVBRRAA",[null,null,null,"/local/business/11949232167681125317/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklOelpwWDBkbkVBRRAA"],null,"https://business.google.com/local/business/11949232167681125317/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklOelpwWDBkbkVBRRAA",[null,null,null,"/local/business/11949232167681125317/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUklOelpwWDBkbkVBRRAA"]],[null,null,6588,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSURINzZpX0dnEAE!2m1!1s0x0:0x87bdcc55a6b26df3!3m1!1s2@1:CIHM0ogKEICAgIDH76i_Gg%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?po