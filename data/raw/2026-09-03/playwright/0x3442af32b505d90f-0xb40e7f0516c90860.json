UIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwiw06DZzNKWAxUPna8BHdITLM0Q3YcHCIIBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiw06DZzNKWAxUPna8BHdITLM0Q3IcHCIEBKAw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiw06DZzNKWAxUPna8BHdITLM0Q3IcHCIMBKA0",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiw06DZzNKWAxUPna8BHdITLM0Q3IcHCIQBKA4",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiw06DZzNKWAxUPna8BHdITLM0Q3IcHCIUBKA8",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiw06DZzNKWAxUPna8BHdITLM0Q3YcHCIcBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiw06DZzNKWAxUPna8BHdITLM0Q3IcHCIYBKBA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["看地圖評價4.2好像不錯，但看來地圖評價洗的不錯，行銷很厲害。\n\n首先這是日式拉麵店，那就以拉麵來評論，麵上的速度很快，一上來先喝了一口醬油拉麵的湯，一喝就覺得慘了，因為醬油拉麵是最基本中的基本，果然這碗麵雷到爆炸。\n\n醬油拉麵非常的清淡，比泡麵淡4倍左右，意思是泡麵用400cc泡的話，改用1600cc來泡的感覺。\n\n再來是招牌豚骨，也是一樣的狀況，豚骨的特色是濃郁，但湯上面完全沒有浮油，不如去吃泡麵。\n\n價格上來說，比一般日式拉麵便宜6-7成，但比擔仔麵貴2倍，但我覺得擔仔麵比較好吃。\n\n豬排的部分，海苔鹽下太重，有點死鹹，不如讓客人自己灑，豬排本身炸的算爽口，口感略硬沒有敲打。\n\n炸餃的表現跟在日本吃的差不多，日式炸餃目前沒吃過好吃的，所以表現算正常。\n\n另外這邊好像可以無限加麵，但假日沒有，對想吃粗飽的人來說很佛心。",null,[0,108]]]],[null,null,null,null,null,"https://business.google.com/local/business/17244137404899371141/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPTm1SSVFsRlhSWE0xV0RCR2NGcHVRbXhrYmxKbVdrWndWazB3UlJBQhAA",[null,null,null,"/local/business/17244137404899371141/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPTm1SSVFsRlhSWE0xV0RCR2NGcHVRbXhrYmxKbVdrWndWazB3UlJBQhAA"],"https://business.google.com/local/business/17244137404899371141/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPTm1SSVFsRlhSWE0xV0RCR2NGcHVRbXhrYmxKbVdrWndWazB3UlJBQhAA",[null,null,nu