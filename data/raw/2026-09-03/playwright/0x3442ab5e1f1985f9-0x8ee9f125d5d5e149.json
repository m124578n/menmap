ll,null,null,"餐點",null,"0ahUKEwj0usiExdKWAxXphq8BHWjRNGoQ3IcHCF0oCg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwj0usiExdKWAxXphq8BHWjRNGoQ3IcHCF4oCw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwj0usiExdKWAxXphq8BHWjRNGoQ3IcHCF8oDA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwj0usiExdKWAxXphq8BHWjRNGoQ3YcHCGEoAA"]],1],null,null,"等待時間",null,"0ahUKEwj0usiExdKWAxXphq8BHWjRNGoQ3IcHCGAoDQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["2026/03/22來用餐，點了一碗東京豚骨拉麵、單點肉、單點糖心蛋共205元，以日式拉麵來說應該算平價，朋友有抱怨過口味上不夠“日式”，但我對拉麵的味道沒甚麼研究跟追求，所以就不予置評了，我個人是覺得沒甚麼問題。\n\n拉麵跟叉燒肉我覺得還不錯，叉燒肉炙燒的味道很香，拉麵的品項很多，可以根據喜好選擇。東京豚骨拉麵湯頭偏鹹，雖然店內可以單點飲料，但沒有提供飲用水，這點有點困擾。唐心蛋感覺有點太熟了，不夠軟。\n\n內用、外帶都採用點餐機點餐，點餐機的操作沒那麼流暢，有看過客人操作到一半不知道怎麼繼續的，（提醒一下：載具在點餐機的側面、紙鈔只收百元鈔，可以跟店員換錢），店面有簡單裝潢，以這個價位來說我覺得裝潢挺用心的，但也看得出來有些年頭。\n\n服務態度，因為是點餐機點餐，跟顧客有互動的部分，大概只剩下送餐而已，所以就沒甚麼好評論的。\n\n評價標準如下：\n\n5星---高於預期\n4星---符合預期\n3星---低於預期\n2星---不推薦\n1星---嚴重問題",null,[0,107]]]],[null,null,null,null,null,"https://business.google.com/local/business/5573041991271936127/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZDFWR1FraGlNalZzVFVjMVVWTnNTbkZoVjBaVFUwZE9jRkV5WXhBQhAA",[null,null,null,"/local/business/5573041991271936127/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZDFWR1FraGlNalZzVFVjMVVWTnNTbkZoVjBaVFUwZE9jRkV5WXhBQhAA"],"https://business.google.com/local/business/5573041991271936127/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZDFWR1FraGlNalZzVFVjMVVWTnNTbkZoVjBaVFUwZE9jRkV5WXhBQhAA",[null,null,null,"/local/business/5573041991271936127/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhhZDFWR1FraGlNalZzVFVjMVVWTnNTbkZoVjBaVFUwZE9jRkV5WXhBQhAA"],null,"https://business.google.com/local/business/5573041991271