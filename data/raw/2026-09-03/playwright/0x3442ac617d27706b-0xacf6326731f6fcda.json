,[0,49]]]],[null,1736920506000000,1736920506000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQkY1bDVqb2JEazluaDAyNkFBR2VGUQ%7CCAEQrcz1_gkiLwoZQ0hfQkY1bDVqb2JEazluaDAyNkFBR2VGURoSQ2dzSXVwdWR2QVlRbGRYdExn\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi3gdXlwdKWAxWDnq8BHVVfK3cQ_2MIgQEoCQ"],"https://business.google.com/local/business/11087343036127346454/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmZjWEZRYldoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/11087343036127346454/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmZjWEZRYldoQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/11087343036127346454/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmZjWEZRYldoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/11087343036127346454/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmZjWEZRYldoQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/11087343036127346454/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmZjWEZRYldoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/11087343036127346454/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmZjWEZRYldoQlJSQUIQAA%3D%3D"],null,["zh-Hant"],[["感謝您選擇我們餐廳用餐，對於餐具清潔不夠嚴謹向您致上誠摯的歉意，我們會更加強清潔流程，確保餐具達到潔淨標準\n\n對於餐點口味部分我們會採納各方意見做些微調，也可以針對客人不同濃淡口味做調整，謝謝您的回饋😊",null,[0,101]]]],[null,null,9671,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUNfcXFQbWhBRRAB!2m1!1s0x0:0xacf6326731f6fcda!3m1!1s2@1:CIHM0ogKEICAgIC_qqPmhAE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUNfcXFQbWhBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUNfcXFQbWhBRRIsChZDSUhNMG9nS0VJQ0FnSUNfcXFQbVJBEhJDZ3NJdmMyY3ZBWVFzSVh1VmcaLQoXQ0lITTBvZ0tFSUNBZ0lDX3FxUG14QUUSEkNnc0l2YzJjdkFZUXNJWHVWZyISCQAAAAAAAAAAEdr89jFnMvasKgswYldtUHg5cXM5aw\u0026wv\u003d1\u0026