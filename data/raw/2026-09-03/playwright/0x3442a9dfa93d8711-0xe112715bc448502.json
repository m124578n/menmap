DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjaz5_jvdKWAxWEcvUHHYC3KI8Q3YcHCOcBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjaz5_jvdKWAxWEcvUHHYC3KI8Q3IcHCOYBKCE",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjaz5_jvdKWAxWEcvUHHYC3KI8Q3IcHCOgBKCI",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjaz5_jvdKWAxWEcvUHHYC3KI8Q3IcHCOkBKCM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjaz5_jvdKWAxWEcvUHHYC3KI8Q3IcHCOoBKCQ",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["近期越開越多的連鎖拉麵店，原以為會是跟O將一樣是走台式拉麵風，結果初嘗發現…跟我原先想像的不同，雖然比不上很濃厚的日式名店，但感覺是朝著這個方向發展的，也比一般台拉好吃很多。\n\n這裡的環境相當明亮乾淨，用餐還有舒服的音樂陪襯著，讓上班族一整天的勞碌獲得平靜。\n\n🍜醬油拉麵 135\n作為一個拉麵愛好者，看到這個價錢，是有點小擔心，畢竟一般好吃的拉麵大多要近200起跳。淺嚐了一口湯，發現意外清爽甘甜；再吃一口叉燒肉，頗有特色，特殊的調味與炙燒的氣味表現得還不賴！麵體本身與筍乾中規中矩，也還可以；而中間一團蔥油應該是整碗最有特色的配角了，拌入湯中，增添了很多香氣層次，大概是整碗拉麵的靈魂所在了。\n\n對了，特製辣椒一定要再剩下半碗的時候加來嚐嚐，屬於微麻、重香的辣味，相當順口！",null,[0,87]]]],[null,1694015308000000,1694015308000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04RXpFd0lrRFprLUo5TUFBMGx0dw%7CCAEQrcz1_gkiMAoZQ0hfQm04RXpFd0lrRFprLUo5TUFBMGx0dxoTQ2d3SXpMN2lwd1lRbVpydG1nTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjaz5_jvdKWAxWEcvUHHYC3KI8Q_2MI6wEoJQ"],"https://business.google.com/local/business/2874671841874029397/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmFha3RFYmxobkVBRRAA",[null,null,null,"/local/business/2874671841874029397/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmFha3RFYmxobkVBRRAA"],"https://business.google.com/local/business/2874671841874029397/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmFha3RFYmxobkVBRRAA",[null,null,null,"/local/business/2874671841874029397/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5