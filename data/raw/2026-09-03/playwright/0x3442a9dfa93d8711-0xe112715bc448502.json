吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjaz5_jvdKWAxWEcvUHHYC3KI8Q3YcHCI0BKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjaz5_jvdKWAxWEcvUHHYC3KI8Q3IcHCIwBKAs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["位於林森北路上靠近景福宮德惠街口的麵匡匡食堂，是前三個月上重訓運動課途中必經店家，自門面往内看就很吸睛，終於在最後一堂課程結束後（晚上7點），有機會犒賞味蕾。餐點種類選項很多，與一般拉麵專賣店不同，是我最喜歡的部分，除了味噌拉麵，加點烤櫛瓜玉蜀黍和麥茶，價位在可接受範圍內，也可以其他線上付款方式代替現金，工作人員態度親切，是會再訪的店家。",null,[0,170]]]],[null,null,null,null,null,"https://business.google.com/local/business/2874671841874029397/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4VEZSRmRGVmpNVm8xV2xoS2VsSkdRWFJrTVZwU1ZrWndWRkpYWXhBQhAA",[null,null,null,"/local/business/2874671841874029397/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4VEZSRmRGVmpNVm8xV2xoS2VsSkdRWFJrTVZwU1ZrWndWRkpYWXhBQhAA"],"https://business.google.com/local/business/2874671841874029397/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4VEZSRmRGVmpNVm8xV2xoS2VsSkdRWFJrTVZwU1ZrWndWRkpYWXhBQhAA",[null,null,null,"/local/business/2874671841874029397/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4VEZSRmRGVmpNVm8xV2xoS2VsSkdRWFJrTVZwU1ZrWndWRkpYWXhBQhAA"],null,"https://business.google.com/local/business/2874671841874029397/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4VEZSRmRGVmpNVm8xV2xoS2VsSkdRWFJrTVZwU1ZrWndWRkpYWXhBQhAA",[null,null,null,"/local/business/2874671841874029397/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4VEZSRmRGVmpNVm8xV2xoS2VsSkdRWFJrTVZwU1ZrWndWRkpYWXhBQhAA"]],[null,null,5326,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2kxTFRFdFVjMVo1WlhKelJGQXRkMVpSVkZwVFJXYxAB!2m1!1s0x0:0xe112715bc448502!3m1!1s2@1:CAIQACodChtycF9oOi1LTEtUc1Z5ZXJzRFAtd1ZRVFpTRWc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2kxTFRFdFVjMVo1WlhKe