leusercontent.com/a-/ALV-UjWOqiKX0SWXH_MSiV0sMatu7w04yvYDu0rtKmb58klTblQ_dEA\u003ds120-c-rp-mo-ba12-br100",null,null,"114259914468927918098"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,6,30,14,null,null,null,null,["2 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhCxlK9oiaJ8kuhkPP8DcLqF\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x30d47a23d8226149"]],1,null,null,null,null,null,null,["0","3518571503251775817"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2s1NFNYVm5WR1ZrU1hGb2IxOW5UMDFGZWs0emNVRRAB"]],"CIABIhCxlK9oiaJ8kuhkPP8DcLqF",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ3YcHCGIoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ3IcHCGEoBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ3IcHCGMoBQ",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ3IcHCGQoBg",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ3IcHCGUoBw",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["不是第一次來了\n今天21:40左右前來用餐。看店內還有很多空位，兩個人因東西也不少，就順勢入座了四人座，硬是被趕去坐2人座，跟我們說「你們兩個人，只能坐兩人座」。「2個人坐兩人座。」「那是四人桌。」（口氣越來越強硬）\n（一位控場的男生長輩跑來講）\n\n重點是有一組就是兩個人坐四人座（如圖）也是兩個人坐在四人座，還吃很久。\n還有一組4人的已經碗很空明顯要離開了。\n結果到用晚餐為止，根本就沒增加其他客人，做這麼久餐飲業，這樣的帶位方式真的很不理想，讓人很不舒服，還這麼強硬。\n如果標準一致還不會這麼無言。主要就很難理解這麼雙標還跟我及朋友共講了三四次要我們換位置，不知道是因為不順他意就不行？還是看他心情。\n看了評論也有看到其他因為位置被強迫的人，還是單人換單人，更慘。真的是很沒必要。\n\n然後明明這次湯給得超少（如圖。）\n我說不好意思，因為這個蠻鹹的，想要加湯，而且這次一開始湯就很少，之前沒有這麼少，店員（一樣是男生長輩）連仔細聽我問題都沒有，甩頭就急著回答說，這比例都是固定的，只能加熱水。然後我就加了熱水⋯\n\n你們這些無謂的堅持，讓人下次不想再來了。\n之前來 年輕有活力的老闆在，就不會這樣。",null,[0,108]]]],[null,1784880945000000,1784880945000000,"1 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfRVU5cF9qOVNzaHZPV2tJV3B1Wjh5UQ%7CCAEQrcz1_gkiMAoZQ0hfRVU5cF9qOVNzaHZPV2tJV3B1Wjh5URoTQ2d3SXNiNk0wd1lRN1lxbGlnTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ_2MIZigI"],"https://business.google.com/local/business/6714804748944074029/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxTkZOWVZtNVdSMVpyVTFoR2IySXhPVzVVTURGR1pXczBlbU5WUlJBQhAA",[null,null,null,"/local/business/6714804748944074029/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxTkZOWVZtNVdSMVpyVTFoR2IySXhPVzVVTURGR1pXczBlbU5WUlJBQhAA"],"https://business.google.com/local/business/6714804748944074029/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxTkZOWVZtNVdSMVpyVTFoR2IySXhPVzVVTURGR1pXczBlbU5WUlJBQhAA",[null,null,null,"/local/business/6714804748944074029/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxTkZOWVZtNVdSMVpyVTFoR2IySXhPVzVVTURGR1pXczBlbU5WUlJBQhAA"],null,"https://business.google.com/local/business/6714804748944074029/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxTkZOWVZtNVdSMVpyVTFoR2IySXhPVzVVTURGR1pXczBlbU5WUlJBQhAA",[null,null,null,"/local/business/6714804748944074029/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMxTkZOWVZtNVdSMVpyVTFoR2IySXhPVzVVTURGR1pXczBlbU5WUlJBQhAA"],null,["zh-Hant"],[["對不起 帶位標準不一致，這真的是我們的問題，會跟現場同仁重新溝通清楚原則，不能讓客人有雙標的感覺。湯量和加湯的回應方式也會再檢討 這次真的不好意思，希望還能有機會讓你感受到不一樣的服務。",null,[0,93]]]],[null,null,2149,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2s1NFNYVm5WR1ZrU1hGb2IxOW5UMDFGZWs0emNVRRAB!2m1!1s0x0:0x30d47a23d8226149!3m1!1s2@1:CAIQACodChtycF9oOk54SXVnVGVkSXFob19nT01Fek4zcUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2s1NFNYVm5WR1ZrU1hGb2IxOW5UMDFGZWs0emNVRRAB\u0026t\u003d1\u0026en