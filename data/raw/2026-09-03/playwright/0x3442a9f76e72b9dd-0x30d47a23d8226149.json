,null,"平均每人消費金額",null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ3IcHCFMoBg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ3IcHCFUoBw",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ3IcHCFYoCA",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjZm4bTxNKWAxUnZvUHHVQqGHYQ3IcHCFcoCQ",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["2026/5/30點了一碗雞白豚骨拉面\n1.送餐時，就看到湯份量很很離譜！！！\n湯也太少了，就問湯是不太少了，這樣面很快就吸掉了。\n有位比較年長的店員就說：這是固定份量.\n我們是固定份量的。\n我上了評價一看.....發現給評的照片中的湯都是比較滿。\n所以店家說的固定份量，真的是固定嗎？\n2.有加30元，甜品吃到飽。\n發現甜品區都沒有貼“取餐時請勿交談”\n客人取餐都在聊天\n都大加料“口水”！！很不衛生\n下次不考慮來光臨了。",null,[0,65]]]],[null,null,null,null,null,"https://business.google.com/local/business/6714804748944074029/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaTVdWSGREUlZNMjgwVm14a1IxbFZkRlpPUld4bVdWYzVSMkZJWXhBQhAA",[null,null,null,"/local/business/6714804748944074029/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaTVdWSGREUlZNMjgwVm14a1IxbFZkRlpPUld4bVdWYzVSMkZJWXhBQhAA"],"https://business.google.com/local/business/6714804748944074029/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaTVdWSGREUlZNMjgwVm14a1IxbFZkRlpPUld4bVdWYzVSMkZJWXhBQhAA",[null,null,null,"/local/business/6714804748944074029/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaTVdWSGREUlZNMjgwVm14a1IxbFZkRlpPUld4bVdWYzVSMkZJWXhBQhAA"],null,"https://business.google.com/local/business/6714804748944074029/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaTVdWSGREUlZNMjgwVm14a1IxbFZkRlpPUld4bVdWYzVSMkZJWXhBQhAA",[null,null,null,"/local/business/6714804748944074029/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBaTVdWSGREUlZNMjgwVm14a1IxbFZkRlpPUld4bVdWYzVSMkZJWXhBQhAA"]],[