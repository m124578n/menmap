1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjL5tuyxtKWAxXjlK8BHclYDTwQ3IcHCFQoBw",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["沒有服務費，但店員對於進入的客人還是很專業招呼、也很親切，主動詢問置物籃，椅子很大，坐起來很舒服⋯\n\n有提供水及柚子茶，柚子茶清甜好喝。 四種肉的表現都很不錯，感覺下次還是要繼續特盛了～ 配菜有木耳、洋蔥、（依湯底可能有蔥），而且還有兩片很大方的海苔和整顆蛋！\n\n雖然都是雞白湯底，但柚子吃起來更清爽一些，下次想回訪試試辣味的～\n\n牛蒡也不會過於醃漬而失去食材本身的味道。\n飯個人還好，覺得蛋黃醬反而讓飯更膩，整體也略甜的感覺～",null,[0,130]]]],[null,null,null,null,null,"https://business.google.com/local/business/5969569317565256701/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3U2xadFNreGlhM00xWTFWd2FtTklielZVTVVwU1ZIcGtkRnBYWXhBQhAA",[null,null,null,"/local/business/5969569317565256701/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3U2xadFNreGlhM00xWTFWd2FtTklielZVTVVwU1ZIcGtkRnBYWXhBQhAA"],"https://business.google.com/local/business/5969569317565256701/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3U2xadFNreGlhM00xWTFWd2FtTklielZVTVVwU1ZIcGtkRnBYWXhBQhAA",[null,null,null,"/local/business/5969569317565256701/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3U2xadFNreGlhM00xWTFWd2FtTklielZVTVVwU1ZIcGtkRnBYWXhBQhAA"],null,"https://business.google.com/local/business/5969569317565256701/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3U2xadFNreGlhM00xWTFWd2FtTklielZVTVVwU1ZIcGtkRnBYWXhBQhAA",[null,null,null,"/local/business/5969569317565256701/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3U2xadFNreGlhM00xWTFWd2FtTklielZVTVVwU1ZIcGtkRnBYWXhBQhAA"]],[null,null,4073,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21wSlZtSkxia3M1Y1VwamNIbzVUMUpSVHpkdFpXYxAB!2m1!1s0x0:0x7cb0fb5557dbb6bf!3m1!1s2@1:CAIQACodChtycF9oOmpJVmJLbks5cUpjcHo5T1JRTzdtZWc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21wSlZtSkxia3M1Y1VwamNIbzVUMUpSVHpkdFpX