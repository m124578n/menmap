,"0ahUKEwjkgM6QxdKWAxWgoa8BHTobODQQ3IcHCJcBKA0",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjkgM6QxdKWAxWgoa8BHTobODQQ3YcHCJkBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjkgM6QxdKWAxWgoa8BHTobODQQ3IcHCJgBKA4",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這間店面小小的，位置不多，點餐是用 QR Code 掃碼，對於喜歡自己慢慢看菜單的人來說很方便。內用有提供免費的麥茶跟熱水可以自取。\n當天試了「特濃豚骨拉麵」，湯頭看顏色就知道走濃郁路線，喝起來夠味但不會死鹹，細麵的口感也掌握得不錯。\n叉燒肉、舒肥雞肉跟溏心蛋的表現就比較中規中矩，雖然沒有到超級驚艷，但在這個價位段已經算很有誠意了。\n小菜部分反而很有驚喜！泡菜酥腐外酥內軟，配上泡菜真的很刷嘴；唐揚鐵丸小翅也完全不踩雷，肉質紮實不會乾柴。\n另外水煮鮮蔬的高麗菜非常鮮甜，很適合配著拉麵吃。\n至於韓式泡菜就比較普通一點，口味偏台式不會太辣。\n整體來說，以這樣的平價消費能吃到這種水準，CP 值算非常高，是日常想吃拉麵時會想回訪的名單！",null,[0,167]]]],[null,null,null,null,null,"https://business.google.com/local/business/12082012053423991737/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQ0YlU1VWFHMVpiRkp5VmxWb2JWZEVXa2xsVjJSSFdrWkNhbGRzUlJBQhAA",[null,null,null,"/local/business/12082012053423991737/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQ0YlU1VWFHMVpiRkp5VmxWb2JWZEVXa2xsVjJSSFdrWkNhbGRzUlJBQhAA"],"https://business.google.com/local/business/12082012053423991737/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQ0YlU1VWFHMVpiRkp5VmxWb2JWZEVXa2xsVjJSSFdrWkNhbGRzUlJBQhAA",[null,null,null,"/local/business/12082012053423991737/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQ0YlU1VWFHMVpiRkp5VmxWb2JWZEVXa2xsVjJSSFdrWkNhbGRzUlJBQhAA"],null,"https://business.google.com/local/business/12082012053423991737/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQ0YlU1VWFHMVpiRkp5VmxWb2JWZEVXa2xsVjJSSFdrWkNhbGRzUlJBQhAA",[null,null,null,"/local/business/12082012053423991737/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQ0YlU1VWFHMVpiRkp5VmxWb2JWZEVXa2xsVjJSSFdrWkNhbGRzUlJBQhAA"]],[null,null,10090,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZEN