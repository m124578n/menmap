null,null,null,null,null,null,["zh-Hant"],[["明太子叉燒飯好吃，感覺超越拉麵本體。\n拉麵通常我都吃偏硬的，這次拜訪認為麵條偏硬的還不錯，但這個價位吃下來有點空虛，不是說不好，但少了一些食材（用料或是精緻度），吃完就只有「吃完麵」的感覺。\n另外店家有些單位是有配合的，可以帶證件來抵消費。\n還有，這次點了明太子叉燒飯，店員邀請加入LINE會員，但點完發現Line裡面的優惠卷，竟然有十元的明太子叉燒飯折價卷。我感覺若是店員主動告知能折抵會更好。",null,[0,120]]]],[null,null,null,null,null,"https://business.google.com/local/business/16235809232869911519/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBHVkZkSE1YWmFiR2hSVVc1YVRrMUVaM1JTTUd3MFRrZHNkbUV6WXhBQhAA",[null,null,null,"/local/business/16235809232869911519/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBHVkZkSE1YWmFiR2hSVVc1YVRrMUVaM1JTTUd3MFRrZHNkbUV6WXhBQhAA"],"https://business.google.com/local/business/16235809232869911519/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBHVkZkSE1YWmFiR2hSVVc1YVRrMUVaM1JTTUd3MFRrZHNkbUV6WXhBQhAA",[null,null,null,"/local/business/16235809232869911519/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBHVkZkSE1YWmFiR2hSVVc1YVRrMUVaM1JTTUd3MFRrZHNkbUV6WXhBQhAA"],null,"https://business.google.com/local/business/16235809232869911519/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBHVkZkSE1YWmFiR2hSVVc1YVRrMUVaM1JTTUd3MFRrZHNkbUV6WXhBQhAA",[null,null,null,"/local/business/16235809232869911519/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBHVkZkSE1YWmFiR2hSVVc1YVRrMUVaM1JTTUd3MFRrZHNkbUV6WXhBQhAA"]],[null,null,3651,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pGVFdHMXZabGhRUW5aTk1EZ3RSMGw0TkdsdmEzYxAB!2m1!1s0x0:0x6bd47f28faf27026!3m1!1s2@1:CAIQACodChtycF9oOjFTWG1vZlhQQnZNMDgtR0l4NGlva3c%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pGVFdHMXZabGhRUW5aTk1EZ3RSMGw0TkdsdmEzYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pGVFdHMXZabGhRUW5aTk1EZ3RSMGw0TkdsdmEzYxI-Ci9DQUlRQUNvZENodHljRjlvT2pGVFdHMXZabGhRUW5aTk1EZ3RSMGw0TkdsdmEz