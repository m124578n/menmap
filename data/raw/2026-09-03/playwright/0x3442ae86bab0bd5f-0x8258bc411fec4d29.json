l,null,null,null,null,null,["zh-Hant"],[["二子山拉麵台式拉麵份量很大，味道不錯。本來沒有點炸豬排，後來聽到老闆認真搥打豬排的聲音，感覺很好吃，後來單點了一份炸豬排，超好吃😋。店家無刷卡，但有提供發票。\n唯一的建議是老闆的菜單照片可以更新一下，因為一開始看到炸豬排的照片，感覺炸物顏色偏暗，所以才沒點豬排。但實際上炸出來的豬排，顏色很漂亮，肉也好吃。更新菜單照片會更吸引人一些。",null,[0,167]]]],[null,null,null,null,null,"https://business.google.com/local/business/12507885845901584355/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHUWxkWVRtOVlNMDVXWWxaYVExbHNSakpqTWtwSlVsaFNORXhWUlJBQhAA",[null,null,null,"/local/business/12507885845901584355/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHUWxkWVRtOVlNMDVXWWxaYVExbHNSakpqTWtwSlVsaFNORXhWUlJBQhAA"],"https://business.google.com/local/business/12507885845901584355/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHUWxkWVRtOVlNMDVXWWxaYVExbHNSakpqTWtwSlVsaFNORXhWUlJBQhAA",[null,null,null,"/local/business/12507885845901584355/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHUWxkWVRtOVlNMDVXWWxaYVExbHNSakpqTWtwSlVsaFNORXhWUlJBQhAA"],null,"https://business.google.com/local/business/12507885845901584355/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHUWxkWVRtOVlNMDVXWWxaYVExbHNSakpqTWtwSlVsaFNORXhWUlJBQhAA",[null,null,null,"/local/business/12507885845901584355/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHUWxkWVRtOVlNMDVXWWxaYVExbHNSakpqTWtwSlVsaFNORXhWUlJBQhAA"]],[null,null,9857,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21GQldYTm9YM05WYlZaQ1lsRjJjMkpJUlhSNExVRRAB!2m1!1s0x0:0x8258bc411fec4d29!3m1!1s2@1:CAIQACodChtycF9oOmFBWXNoX3NVbVZCYlF2c2JIRXR4LUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21GQldYTm9YM05WYlZaQ1lsRjJjMkpJUlhSNExVRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT21GQldYTm9YM05WYlZaQ1lsRjJjMkpJUlhSNExVRRI-Ci9DQUlRQUNvZENodHljRjlvT21GQldYTm9YM05WYlZaQ1lsRjJjMkpJUlhSNExVRRILMGNUdmU5c3RPVU8aPgovQ0FJUUFDb2RD