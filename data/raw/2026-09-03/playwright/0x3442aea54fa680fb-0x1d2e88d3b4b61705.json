，實在有些可惜⋯⋯寫下這評論下次有再來台北吃的時候記得要提醒自己點一般辣味噌拉麵就好，才能好好享受濃郁湯頭～",null,[0,225]]]],[null,null,null,null,null,"https://business.google.com/local/business/6762372654130041113/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnByTVdWVVpEUmxhelZvWkZWU1UyRXlSblJTYWtKclRsVm9lVXhYWXhBQhAA",[null,null,null,"/local/business/6762372654130041113/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnByTVdWVVpEUmxhelZvWkZWU1UyRXlSblJTYWtKclRsVm9lVXhYWXhBQhAA"],"https://business.google.com/local/business/6762372654130041113/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnByTVdWVVpEUmxhelZvWkZWU1UyRXlSblJTYWtKclRsVm9lVXhYWXhBQhAA",[null,null,null,"/local/business/6762372654130041113/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnByTVdWVVpEUmxhelZvWkZWU1UyRXlSblJTYWtKclRsVm9lVXhYWXhBQhAA"],null,"https://business.google.com/local/business/6762372654130041113/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnByTVdWVVpEUmxhelZvWkZWU1UyRXlSblJTYWtKclRsVm9lVXhYWXhBQhAA",[null,null,null,"/local/business/6762372654130041113/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnByTVdWVVpEUmxhelZvWkZWU1UyRXlSblJTYWtKclRsVm9lVXhYWXhBQhAA"]],[null,null,820,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2prMWVUZDRlazVoZFVSU2EyRnRSakJrTlVoeUxXYxAB!2m1!1s0x0:0x1d2e88d3b4b61705!3m1!1s2@1:CAIQACodChtycF9oOjk1eTd4ek5hdURSa2FtRjBkNUhyLWc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2prMWVUZDRlazVoZFVSU2EyRnRSakJrTlVoeUxXYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2prMWVUZDRlazVoZFVSU2EyRnRSakJrTlVoeUxXYxI-Ci9DQUlRQUNvZENodHljRjlvT2prMWVUZDRlazVoZFVSU2EyRnRSakJrTlVoeUxXYxILMGVMR2t1WmhJSngaPgovQ0FJUUFDb2RDaHR5Y0Y5b09qazFlVGQ0ZWs1aGRVUlNhMkZ0UmpCa05VaHlMV2MSCzBlTEdrdVpoSUp4IhIJAAAAAAAAAAARBRe2tNOILh0qCzBlTEdrdVpoSUp4\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0