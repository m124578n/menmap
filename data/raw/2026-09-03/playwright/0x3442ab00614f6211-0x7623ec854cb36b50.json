null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiS793_wNKWAxXXjK8BHaSZN_YQ3IcHCFQoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiS793_wNKWAxXXjK8BHaSZN_YQ3IcHCFUoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiS793_wNKWAxXXjK8BHaSZN_YQ3IcHCFYoCQ",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["生意很好需要先填單候位，會先結帳，結完帳不會馬上入坐，因為前面還有人更早就結完帳在等待。\n\n小碗麵量是200g，店家表示一般是100g，要調整的話點餐時就要說，麵條偏粗硬，跟其他家二郎系比起來感覺沒到特別重口味，下次湯底想試試濃的。配菜爆多的量是3倍，聽到有其他人點4倍，不知道是因為認識或是有加錢，還是其實也可以這樣點。\n\n服務是剛剛好的親切，不冷淡也不會過度關注。",null,[0,44]]]],[null,null,null,null,null,"https://business.google.com/local/business/7726299136435455624/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZDFaV1VtdGpSbWhOVkc1b05sbHFUbk5rVjFFelZqQjRVMlJYWXhBQhAA",[null,null,null,"/local/business/7726299136435455624/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZDFaV1VtdGpSbWhOVkc1b05sbHFUbk5rVjFFelZqQjRVMlJYWXhBQhAA"],"https://business.google.com/local/business/7726299136435455624/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZDFaV1VtdGpSbWhOVkc1b05sbHFUbk5rVjFFelZqQjRVMlJYWXhBQhAA",[null,null,null,"/local/business/7726299136435455624/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZDFaV1VtdGpSbWhOVkc1b05sbHFUbk5rVjFFelZqQjRVMlJYWXhBQhAA"],null,"https://business.google.com/local/business/7726299136435455624/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZDFaV1VtdGpSbWhOVkc1b05sbHFUbk5rVjFFelZqQjRVMlJYWXhBQhAA",[null,null,null,"/local/business/7726299136435455624/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA0ZDFaV1VtdGpSbWhOVkc1b05sbHFUbk5rVjFFelZqQjRVMlJYWXhBQhAA"]],[null,null,14406,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT204d1ZWUmtjRmh