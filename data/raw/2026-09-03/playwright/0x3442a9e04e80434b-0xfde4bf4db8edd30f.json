tKWAxVoe_UHHXNoOTgQ1bMECOgBKC8",null,null,null,[[2]]],[["/m/07cmh2"],"甜湯",null,[null,null,null,null,5,0,6],null,"0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQ1bMECOkBKDA",null,null,null,[[2]]],[["/g/155ph13j"],"煎餃",null,[null,null,null,null,5,0,5],null,"0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQ1bMECOoBKDE",null,null,null,[[2]]],[["/g/1213hnk6"],"高湯",null,[null,null,null,null,5,0,5],null,"0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQ1bMECOsBKDI",null,null,null,[[2]]],[["/m/01g7cg"],"溏心蛋",null,[null,null,null,null,5,0,5],null,"0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQ1bMECOwBKDM",null,null,null,[[2]]],[["/m/08d_8c"],"湯麵",null,[null,null,null,null,5,75,40],"CgsKCS9tLzA4ZF84Yw\u003d\u003d","0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQ1bMECO0BKDQ",null,null,null,[[2]]],[["/m/07s7dz"],"叉燒",null,[null,null,null,null,5,0,5],"CgsKCS9tLzA3czdkeg\u003d\u003d","0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQ1bMECO4BKDU",null,null,null,[[2]]]]],[["您好，我們是來自日本東京門前仲町的「麺屋 四季 〜Shiki〜」。踏踏實實，只為喜愛拉麵的您奉上一碗真心。\n我們在東京門前仲町落腳時，思考著如何做出能溫暖人心、卻又能展現食材本質的風味。於是，我們試著將西式傳統的「Potage（法式濃湯）」概念，融入了日式傳統的雞白湯與沾麵中。\n\n這並不是為了追求特立獨行。我們只是著迷於將大量的季節性根莖類蔬菜，與雞骨一同經過長時間慢火細燉，直到它們完全化不開地融合在一起。這種做法非常費時費工，但它能讓湯頭既有如慕斯般細緻濃郁的「掛湯力」，卻又帶著蔬菜天然的甘甜與清爽，不會給身體帶來過重的負擔。\n\n不論是濃郁的沾麵，還是清澈優雅、平衡雞骨與蔬菜風味的「雞白湯拉麵」，我們都用一樣最樸實、最費時的功夫去熬煮。連同舒肥叉燒的熟成時間、麵條的齒切口感，每一個看似微不足道的細節，都是我們日復一日、在廚房裡與食材對話的成果。\n今年，我們做了一個很大的決定——「麵屋 四季 ～Shiki～」要跨出日本，來到台灣展開我們的海外第一家分店，並且正式落腳於新北市板橋。\n\n對於台灣這個充滿熱情、且同樣深深熱愛拉麵文化的地方，我們內心既期待又充滿忐忑。我們知道板橋與整個台灣有非常多優秀的拉麵前輩與嘴甜心細的饕客，因此，我們不敢說自己帶來了多麼震撼的美味，我們帶來的，只有當年在東京初次開店時，那份毫無保留的初心。\n我們已經準備好了。在接下來的日子裡，我們會一直在板橋的廚房裡守著那口湯鍋，用最謙卑的心、最專注的眼神，為每一位走進店裡的您，遞上一碗溫熱的拉麵。期待能看見您完食後，那一抹滿足的微笑。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-45hLBsFEk0c/AAAAAAAAAAI/AAAAAAAAAAA/B7-KssNSZTo/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"新北市板橋區",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQhbADCPABKAA","全部",[["CIABIhDZbAb