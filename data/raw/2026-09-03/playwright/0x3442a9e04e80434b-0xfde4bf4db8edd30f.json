,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["好像是這禮拜才開始營業，原本是京樂町拉麵的店面，以為是生意不好，頂讓改名重新營業。查了一下東京真的有Menya Shiki 麵屋四季，賣的拉麵品項也一樣。\n\n餐廳裡的裝潢大概跟之前的京樂町差不多。開放式廚房裡有一位日本廚師在煮麵，一位台灣廚師跟在旁邊做邊學。\n\n只賣三種麵，基本款醬油拉麵，雞白湯拉麵，沾麵，另外還有煎餃。\n\n今天吃了兩種湯麵，算是中規中矩，雞白湯蠻濃醇的，喝得出膠質。豬叉燒有點柴，雞肉叉燒比較好吃。湯麵可以免費加一球，可以吃很撐。\n\n沒吃過東京的店，所以不知道有沒有為了台灣人的口味調整？湯不太鹹，麵也不算硬，蠻適合台灣人的口感。\n\n台灣的廚師加油啊，要維持住品質。很多拉麵店在日本人回國後就會走鐘...",null,[0,129]]]],[null,1784632661000000,1784632661000000,"1 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfZXdKLWJFQTlhdFZ6NE9xLXpldzZaUQ%7CCAEQrcz1_gkiMAoZQ0hfZXdKLWJFQTlhdFZ6NE9xLXpldzZaURoTQ2d3STFhcjkwZ1lRdTRURXZ3TQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQ_2MIXigI"],"https://business.google.com/local/business/1010212529372194571/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTVUZKcVRqSlpNalZRWlVodk1GSjVNVTlqYld3MlVXcE9ObU14UlJBQhAA",[null,null,null,"/local/business/1010212529372194571/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTVUZKcVRqSlpNalZRWlVodk1GSjVNVTlqYld3MlVXcE9ObU14UlJBQhAA"],"https://business.google.com/local/business/1010212529372194571/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTVUZKcVRqSlpNalZRWlVodk1GSjVNVTlqYld3MlVXcE9ObU14UlJBQhAA",[null,null,null,"/local/business/1010212529372194571/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTVUZKcVRqSlpNalZRWlVodk1GSjVNVTlqYld3MlVXcE9ObU14UlJBQhAA"],null,"https://business.google.com/local/business/1010212529372194571/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTVUZKcVRqSlpNalZRWlVodk1GSjVNVTlqYld3MlVXcE9ObU14UlJBQhAA",[null,null,null,"/local/business/1010212529372194571/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTVUZKcVRqSlpNalZRWlVodk1GSjVNVTlqYld3MlVXcE9ObU14UlJBQhAA"],null,["zh-Hant"],[["Lopin Kuo 您好！非常感謝您在開業初期就蒞臨麵屋 四季 板橋店，並為我們留下這麼詳細且溫暖的評價與 5 星支持 ！  \n\n您觀察得非常細緻！我們確實是來自日本東京門前仲町的「麺屋 四季 〜Shiki〜」，這次跨海來到板橋開設海外第一家分店 。\n關於叉燒口感：感謝您坦誠指出豬叉燒偏柴、雞肉叉燒較佳的狀況。對於肉質熟成與舒肥溫控的細節 ，廚房團隊已經記錄下來並著手調整，務求每一片叉燒都能呈現最完美的軟嫩狀態！\n\n風味與品質傳承：我們的湯頭在日本本身就是主打蔬菜甘甜與雞骨的自然平衡，並未刻意調得過鹹 。麵的軟硬度在點單時已經可以自行選擇，請您放心，在味道上絕不會讓品質隨著時間走鐘，請給我們台灣的夥伴加油！ \n\n再次感謝您的細心觀察與勉勵，期待您下次再來試試我們的沾麵 ！  \n\n麵屋 四季 板橋店 敬上 🍜   ",null,[0,125]]]],[null,null,7973,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25SUFJqTjJZMjVQZUhvMFJ5MU9jbWw2UWpONmMxRRAB!2m1!1s0x0:0xfde4bf4db8edd30f!3m1!1s2@1:CAIQACodChtycF9oOnRPRjN2Y25PeHo0Ry1Ocml6QjN6c1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25SUFJqTjJZMjVQZUhvMFJ5MU9jbWw2UWpONmMxRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25SUFJqTjJZMjVQZUhvMFJ5MU9jbWw2UWpONmMxRRI-Ci9DQUlRQUNvZENodHljRjlvT25SUFJqTjJZMjVQZUhvMFJ5MU9jbWw2UWpONmMxRRILMGVRb3RUNjg5TlEaPgovQ0FJUUFDb2RDaHR5Y0Y5b09uUlBSak4yWTI1UGVIbzBSeTFPY21sNlFqTjZjMUUSCzBlUW90VDY4OU5RIhIJAAAAAAAAAAARD9PtuE2_5P0qCzBlUW90VDY4OU5R\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQoykIXygJ"],null,[null,[[1,0]]]],"0ahUKEwis36qIxtKWAxX7eV4EHf_JDv0Q0pMFCAIoAA"],null,null,null,"0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQ0pMFCFEoAA"],[["Ci9DQUlRQUNvZENodHljRjlvT2w5VGEzUTRSRWRIYkVOemQySktVMnQwU0RWR2JrRRAB",["0x0:0xfde4bf4db8edd30f",null,1784371728826976,1784371728826976,[null,null,["https://www.google.com/maps/contrib/107217055415454632335/reviews?hl\u003dzh-TW"],null,null,["江二爺（羊一隻）","https://lh3.googleusercontent.com/a-/ALV-UjUK9GDMgvyPpXaWMrPtWuKT9cKJMmd-QjXe3NjaKjhrHfh3ouwc\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/107217055415454632335?hl\u003dzh-TW"],"107217055415454632335",null,32,200,null,[1,6,1],0,["在地嚮導 · 32 則評論",null,null,null,null,[null,"0ahUKEwiW86KIxtKWAxVoe_UHHXNoOTgQpr8GCGEoAA"]]]],null,"1 個月前",null,null,null,null,null,null,["Google","https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,1],[[5]