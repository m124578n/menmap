停車場",2,null,null,"0ahUKEwjF-5_GyNKWAxUlj68BHfwDL7sQ3YcHCIwBKAI"],[["E:KID_FRIENDLINESS"],"親子友善程度",2,null,null,"0ahUKEwjF-5_GyNKWAxUlj68BHfwDL7sQ3YcHCI0BKAM"],[["E:ACCESSIBILITY"],"無障礙設施",2,null,null,"0ahUKEwjF-5_GyNKWAxUlj68BHfwDL7sQ3YcHCI4BKAQ"]]],null,null,null,"0ahUKEwjF-5_GyNKWAxUlj68BHfwDL7sQ3IcHCIkBKBA",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["這份餐點以番茄肉醬烏龍麵搭配溫泉蛋，再附上一塊炸物，整體份量適中，兼顧主食與配菜。烏龍麵麵條口感Q彈有嚼勁，吸附濃郁的番茄肉醬後，每一口都能吃到番茄的微酸與肉醬的香氣，風味層次豐富。溫泉蛋熟度恰到好處，蛋黃滑順濃郁，拌入醬汁後讓整體口感更加柔和，也增添了濕潤度，使麵條吃起來更加順口。上方撒上的蔥花、芝麻及七味粉不僅提升香氣，也帶來些許辛香，讓整體味道更有層次，不會感到單調。附餐炸物外皮酥脆，內部保有一定的鮮嫩口感，雖然份量不多，但能增加餐點的豐富性。不過，番茄肉醬的味道稍微偏重，吃到後段可能會覺得有些膩，如果能搭配一杯飲料或一份生菜沙拉，整體平衡感會更好。此外，炸物若能搭配醬料或增加一點配菜，會讓整套餐點更有完整性。整體而言，這是一份兼具飽足感與美味的餐點，適合喜歡濃郁醬汁及烏龍麵的人享用，無論作為午餐或晚餐都相當合適，整體表現令人滿意。",null,[0,240]]]],[null,1785720448000000,1785720448000000,"1 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfSFAyXzYwTUNwbzk4R0ZyTkdLbmhXUQ%7CCAEQrcz1_gkiMAoZQ0hfSFAyXzYwTUNwbzk4R0ZyTkdLbmhXURoTQ2d3SWdOMl8wd1lRaFpXWnBRSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjF-5_GyNKWAxUlj68BHfwDL7sQ_2MIjwEoEQ"],"https://business.google.com/local/business/10559407455466063253/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYldWRmJHNVpNMUp6WlVaa1EyVnVRa0ppTUdod1UxaGFUbE5zUlJBQhAA",[null,null,null,"/local/business/10559407455466063253/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYldWRmJHNVpNMUp6WlVaa1EyVnVRa0ppTUdod1UxaGFUbE5zUlJBQhAA"],"https://business.google.com/local/business/10559407455466063253/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYldWRmJHNVpNMUp6WlVaa1EyVnVRa0ppTUdod1UxaGFUbE5zUlJBQhAA",[null,null,null,"/local/business/10559407455466063253/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLYldWRmJHNVpNMUp6WlVaa1EyVnVRa0ppTUdod1UxaGFUbE5zUlJBQhAA"],null,"https://business.google.com/local/business/10559407455466063253/customers/reviews