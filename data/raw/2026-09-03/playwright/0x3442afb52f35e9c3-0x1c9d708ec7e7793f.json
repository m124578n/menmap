cQ3IcHCKwBKAg",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3IcHCK0BKAk",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:RESERVATIONS_NOT_REQUIRED"],"不需要訂位",2,null,null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3YcHCK8BKAA"]],1],null,null,"預訂網址",null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3IcHCK4BKAo",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3YcHCLEBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3IcHCLABKAs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["假日中午到不需等候。\n依店員推薦招牌鹽味拉麵，點濃味偏台式跟日式結合感，辣有提升層次，麵只有軟跟硬的選項。\n大盛跟一般店員介紹說差在兩種肉都會增加，因為小孩想吃厚叉燒所以點了大盛，但上來只有薄叉燒有增加。詢問原介紹的店員，她說現在菜單改了，所以只有多另一種口味的叉燒（那介紹時幹嘛要講兩種肉都會增加？）菜單上也是寫兩種都增加，食物與介紹前後不一，令人感受不佳。\n\n叉燒很薄在日式拉麵中這家算不太好吃的，如果知道多付費只增加薄叉燒我們就點一般的了，大盛很不推。\n叉燒飯視覺很好，但滿滿黑胡椒口感，有種配台式碎臘肉的錯覺，跟一般認知的炙燒叉燒飯有落差。\n整體不是難吃的拉麵，但吃過這麼多好吃的拉麵。看這家店價錢跟拉麵內容物改來改去，店員也搞不清楚都要請客人看ig，不太好的用餐經驗。",null,[0,53]]]],[null,null,null,null,null,"https://business.google.com/local/business/17883067080851371912/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDU1U0eGJ6VlZhbVJRVVd0b1NWUkVRbkZqVlZJMFRVVjRURTVZWXhBQhAA",[null,null,null,"/local/business/17883067080851371912/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDU1U0eGJ6VlZhbVJRVVd0b1NWUkVRbkZqVlZJMFRVVjRURTVZWXhBQhAA"],"https://business.google.com/local/business/17883067080851371912/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDU1U0eGJ6VlZhbVJRVVd0b1NWUkVRbkZqVlZJMFRVVjRURTVZWXhBQhAA",[null,null,null,"/local/business/17883067080851371912/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhDU1U0eGJ6VlZhbVJRVVd0b1NWUkVRbkZqVlZJMFRVVjRURTVZWXhBQhAA"],null,"https://business.google.com/local/business/17883067080851371912/customers/reviews/reply?p\u