,["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhD57_Zl3FAeGcFk5vu5CfIe\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x1c9d708ec7e7793f"]],1,null,null,null,null,null,null,["0","2061927962947057983"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pnMVlqSXlTMUZPUTJ0clkzaDFaemx3TVhsdlJHYxAB"]],"CIABIhD57_Zl3FAeGcFk5vu5CfIe",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3YcHCGkoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3IcHCGgoBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3IcHCGooBQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3IcHCGsoBg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3IcHCGwoBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3YcHCG4oAA"]],1],null,null,"預訂網址",null,"0ahUKEwjB6I_nwtKWAxVynK8BHVvCKMcQ3IcHCG0oCA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["🔻總結: 求新求變的台式拉麵，值得一訪\n\n已來訪多次，定番拉麵品質穩定，每道皆有不同風味蘊含其中。\n老闆常有創新限定餐點，服務親切，且常常構思如何讓餐點更好，是一家對料理非常熱忱用心的拉麵店。\n\n本次第一次前來嘗試限定拉麵\n🍜和牛一反・緋紅琥珀 NT$420\n\n一碗拉麵裡面，融入了日式及義式的作風，醬汁入口一股義式肉醬味道直衝而來，卻並沒有過於厚重，店家在醬汁熬煮下了功夫，使其中味道帶有層次，尾韻帶有洋蔥的甜味。麵條採用「ㄧ反木綿」充分發揮了吸湯能力強的優勢，而粗厚的麵體增加了口感，吃起來非常涮嘴，讓人想一口接一口非常爽。和牛保有其溫潤的口感以及豐厚的油脂，不過可惜大部分肉片咬不斷，影響進食，另外如果有額外提供山葵的話會更好，因為整碗味道已經非常重，吃到後面會膩口，雖然碗裡有提供大量的蔥，但並不能與和牛搭在一起。",null,[0,49]]]],[null,null,null,null,null,"https://business.google.com/local/business/17883067080851371912/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBuTVZscVNYbFRNVVpQVVRKMGNsa3phREZhZW14M1RWaHNkbEpIWXhBQhAA",[null,null