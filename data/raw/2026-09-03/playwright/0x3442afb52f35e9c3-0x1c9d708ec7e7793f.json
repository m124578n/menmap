，皮脆脆的沾湯吃也很香\n\n整體來說餐點口味偏甜偏台式，好吃價格偏高",null,[0,136]]]],[null,null,null,null,null,"https://business.google.com/local/business/17883067080851371912/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzTVZadVJsQmlTRko2WVZWemQxTXhTa1JWYkdzMFZVWndOVkpyUlJBQhAA",[null,null,null,"/local/business/17883067080851371912/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzTVZadVJsQmlTRko2WVZWemQxTXhTa1JWYkdzMFZVWndOVkpyUlJBQhAA"],"https://business.google.com/local/business/17883067080851371912/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzTVZadVJsQmlTRko2WVZWemQxTXhTa1JWYkdzMFZVWndOVkpyUlJBQhAA",[null,null,null,"/local/business/17883067080851371912/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzTVZadVJsQmlTRko2WVZWemQxTXhTa1JWYkdzMFZVWndOVkpyUlJBQhAA"],null,"https://business.google.com/local/business/17883067080851371912/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzTVZadVJsQmlTRko2WVZWemQxTXhTa1JWYkdzMFZVWndOVkpyUlJBQhAA",[null,null,null,"/local/business/17883067080851371912/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzTVZadVJsQmlTRko2WVZWemQxTXhTa1JWYkdzMFZVWndOVkpyUlJBQhAA"]],[null,null,3856,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2psMVZuRlBiSFJ6YVVzd1MxSkRVbGs0VUZwNVJrRRAB!2m1!1s0x0:0x1c9d708ec7e7793f!3m1!1s2@1:CAIQACodChtycF9oOjl1VnFPbHRzaUswS1JDUlk4UFp5RkE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2psMVZuRlBiSFJ6YVVzd1MxSkRVbGs0VUZwNVJrRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2psMVZuRlBiSFJ6YVVzd1MxSkRVbGs0VUZwNVJrRRI-Ci9DQUlRQUNvZENodHljRjlvT2psMVZuRlBiSFJ6YVVzd1MxSkRVbGs0VUZwNVJrRRILMGRrX2U0WmZZem8aPgovQ0FJUUFDb2RDaHR5Y0Y5b09qbDFWbkZQYkhSemFVc3dTMUpEVWxrNFVGcDVSa0USCzBka19lNFpmWXpvIhIJAAAAAAAAAAARP3nnx45wnRwqCzBka19lNFpmWXpv\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjB6I_n