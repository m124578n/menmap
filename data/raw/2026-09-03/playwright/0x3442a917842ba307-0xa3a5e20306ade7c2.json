額",null,"0ahUKEwiC9aynu9KWAxUwU_UHHQx6C-sQ3IcHCHcoCg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiC9aynu9KWAxUwU_UHHQx6C-sQ3IcHCHkoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiC9aynu9KWAxUwU_UHHQx6C-sQ3IcHCHooDA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiC9aynu9KWAxUwU_UHHQx6C-sQ3IcHCHsoDQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwiC9aynu9KWAxUwU_UHHQx6C-sQ3YcHCH0oAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiC9aynu9KWAxUwU_UHHQx6C-sQ3IcHCHwoDg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["歡迎追蹤IG看更多👉：yingeatfood\n\n🔸不敢吃煮干的阿泓都覺得好吃的輕煮干醬油拉麵（期間限定）/ $320\n🔸沫白辻葉雞湯拉麵（濃湯）/ $300\n\n這次是為了期間限定的拉麵而來，吃完只能說阿泓沒有騙人，湯頭帶著淡淡的小魚乾香氣，不會有濃重的魚味，尾韻多了醬油的清甜回甘，層次感十足，喝起來清爽又耐喝，我不愛煮干的人都覺得非常好喝，希望這可以成為定番。\n\n另一碗沫白辻葉雞湯拉麵則完全是另一種風格，泡系雞白湯綿密又濃厚，每一口都有滿滿雞湯香氣，雖然口味偏重一點，但不會死鹹，也沒有喝幾口就膩的問題，細麵條滑順會巴附湯汁，而且還能免費加麵一次。\n\n兩碗拉麵的配料除了濃湯少一片鴨叉燒之外，其餘都一樣。有2片雞叉燒，2片軟嫩入味的豬叉燒，以及嫩中帶點嚼勁的鴨叉燒，一碗就能吃到三種肉，三種願望一次滿足。",null,[0,58]]]],[null,null,null,null,null,"https://business.google.com/local/business/12028219985502106725/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhKTTFkRk5VdFZNazUyWVROS2JXUXdUbEpQUlhoclpHMHhOazFJWXhBQhAA",[null,null,null,"/local/business/12028219985502106725/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhKTTFkRk5VdFZNazUyWVROS2JXUXdUbEpQUlhoclpHMHhOazFJWXhBQhAA"],"https://business.google.com/local/business/12028219985502106725/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhKTTFkRk5VdFZNazUyWVROS2JXUXdUbEpQUlhoclpHMHhOazFJWXhBQhAA",[null,null,null,"/local/business/12028219985502106725/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhKTTFkRk5VdFZNazUyWVROS2JXUXdUbEpQUlhoclpHMHhOazFJWXhBQhAA"]