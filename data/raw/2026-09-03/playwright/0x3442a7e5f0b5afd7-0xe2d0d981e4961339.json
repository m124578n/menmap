ll,null,null,["zh-Hant"],[["距離輔大站，走路約6-8分鐘，離好市多近一些，店家主要分為二種湯頭，濃湯豚骨及清湯雞骨，選擇都一樣，有特盛、蔬菜、辣肉燥及一般，一般問了老闆才知道，基本上就是會有一片叉燒跟二片雞肉及一顆蛋和筍乾，而特盛則是除了一般後多3-4片叉燒及2-3片雞肉。\n\n這次我們點了濃湯豚骨特盛跟清湯雞骨拉麵，口味上雞骨淡些，豚骨則除了原本就濃郁外，還會有蒜末，叉燒表現算還不錯，但雞肉個人覺得柴了點，叉燒飯很特別，第一次吃到上面有加蛋黃液，可惜個人覺得飯偏貴些，不然就極推他了。\n\n整體來說還不錯，第一次看到可以免費加2球麵的，真的不怕你吃，但基本上我覺得不用加就很飽了，尤其是如果胃口小的，建議點一般拉麵即可，不然會吃不完，再來比較可惜的是，僅現金結帳，答案店家外頭貼有信用卡可結帳方式，支付方式若可仔多元些就更好了。",null,[0,123]]]],[null,null,null,null,null,"https://business.google.com/local/business/15262203072201744758/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmljRFpNWVhoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/15262203072201744758/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmljRFpNWVhoQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/15262203072201744758/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmljRFpNWVhoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/15262203072201744758/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmljRFpNWVhoQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/15262203072201744758/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmljRFpNWVhoQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/15262203072201744758/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUmljRFpNWVhoQlJSQUIQAA%3D%3D"]],[null,null,14883,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURicDZMYXhBRRAB!2m1!1s0x0:0xe2d0d981e4961339!3m1!1s2@1:CIHM0ogKEICAgIDbp6LaxAE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURicDZMYXhBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURicDZMYXhBRRItChZDSUhNMG9nS0VJQ0FnSURicDZMYUpBEhNDZ3dJMXRuYnRRWVEyTlB3aVFJGi4KF0NJSE0wb2dLRUlDQWdJRGJwNkxhcEFFEhNDZ3dJMXRuYnRRWVEyTlB3aVFJIhIJAAAAAAAAAAAROROW5IHZ0OIqCzBhaGluTFdFMWJO\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjZ79GqyNKWAxWWaPUHHXHnMN4QoykInAEoEQ"