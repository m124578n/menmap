ull,null,"餐點類型",null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3IcHCNoBKBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3YcHCN0BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3IcHCNwBKBE",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3IcHCN4BKBI",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3IcHCN8BKBM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3IcHCOABKBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3YcHCOIBKAA"]]],null,"用餐人數",null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3IcHCOEBKBU",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3YcHCOQBKAA"],[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3YcHCOUBKAE"]]],null,"座位類型",null,"0ahUKEwjwhvP_ydKWAxW-jK8BHWy3IrAQ3IcHCOMBKBY",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這家位於新店中正路189巷內的拉麵店＜壹味亭食堂＞，窗明几淨，環境整潔，座位不多但生意很好，一人店主，動作流暢，有條不紊，態度非常親切！\n.\n老闆是廚藝世家，從小旅居橫濱，在新店區開店兩年多，主打＜橫濱中華街白湯拉麵＞，味道與口感令人驚艷，保證一試成主顧！\n.\n🍜 拉麵系列\n.\n❣️味噌白湯拉麵 - 濃郁白湯與味噌的鹹香完美結合，風味層次豐富。\n❣️香蒜白湯拉麵 - 蒜香愛好者首選，激發出白湯的深度香氣，口感濃烈過癮。\n❣️魚介白湯拉麵 - 在雞骨濃白湯中融入魚乾的鮮味，呈現出「魚豚」融合的雙重鮮美。\n.\n🍛 飯食類\n.\n❣️肉醬咖哩飯 - 日式家常風味，肉醬與溫和的咖哩結合，是拉麵之外的飽足選擇。\n.\n🥗 沙拉與小菜\n.\n❣️青花椰沙拉 - 清爽解膩，平衡拉麵的濃厚感。\n❣️凉拌海带絲 - 經典開胃小菜，酸甜爽口。\n❣️黄金泡菜 - 帶有果香和微辣發酵風味的台式泡菜，非常開胃。\n.\n🍤 炸物料理\n.\n❣️唐揚雞塊 - 日式經典炸雞，外酥內嫩多汁，必點人氣小菜。\n❣️蝦仁可樂餅 - 內餡為滿滿的蝦仁，海鮮風味濃郁。\n❣️洋芋起司可樂餅 - 馬鈴薯泥與融化起司的組合，綿密香濃。\n❣️南瓜可樂餅 - 以香甜南瓜為內餡，口感香甜鬆軟。\n.\n🥚 配料追加\n.\n❣️溏心蛋 - 拉麵的絕配配料，蛋黃半凝固狀，為佳餚點綴濃厚口感。",null,[0,128]]]],[null,null,null,null,null,"https://business.google.com/local/business/12759888098702857854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvUjAxRWF6UmFNMjh5V1RBd2VGSklhRk5oYldjd1dtczRlRmxyUlJBQhAA",[null,null,null,"/local/business/12759888098702857854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvUjAxRWF6UmFNMjh5V1RBd2VGSklhRk5oYldjd1dtczRlRmxyUlJBQhAA"],"https://business.google.com/local/business/12759888098702857854/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvUjAxRWF6UmFNMjh5V1RBd2VGSklhRk5oYldjd1dtczRlRmxyUlJBQhAA",[null,null,null,"/local/business/12759888098702857854/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvUjAxRWF6UmFNMjh5V1RBd2VGSklhRk5oYldjd1dtczRlRmxyUlJBQhAA"],null,"https://business.google.com/local/business/12759888098702857854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvUjAxRWF6UmFNMjh5V1RBd2VGSklhRk5oYldjd1dtczRlRmxyUlJBQhAA",[null,null,null,"/local/business/12759888098702857854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhvUjAxRWF6UmFNMjh5V1RBd2VGSklhRk5oYldjd1dtczRlRmxyUlJBQhAA"]],[null,null,10203,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xoR01EazRaM28yWTAweFJIaFNhbWcwWms4eFlrRRAB!2m1!1s0x0:0xd4e3ea712c1c64d9!3m1!1s2@1:CAIQACodChtycF9oOlhGMDk4Z3o2Y00xRHhSamg0Zk8xYkE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xoR01EazRaM28yWTAweFJIaFNhbWcwWms4eFlrRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xoR01EazRaM28yWTAweFJIaFNhbWcwWms4eFlrRRI-Ci9DQUlRQUNvZENodHljRjlvT2xoR01EazRaM28yWTAweFJIaFNhbWcwWms4eFlrRRILMGNqSDZjY1dnUFUaPgovQ0FJUUFDb2RDaHR5Y0Y5b09saEdNRGs0WjNvMlkwMHhSSGhTYW1nMFprOHhZa0USCzBjakg2Y2NXZ1BVIhIJAAAAAAAAAAAR2WQcLHHq49QqCzBjakg2Y2NXZ1BV\u002