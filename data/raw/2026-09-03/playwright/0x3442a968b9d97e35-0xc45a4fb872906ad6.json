"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi9_MWzwdKWAxW6i68BHTjHL8cQ3IcHCJ8CKCY",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi9_MWzwdKWAxW6i68BHTjHL8cQ3IcHCKECKCc",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi9_MWzwdKWAxW6i68BHTjHL8cQ3IcHCKICKCg",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi9_MWzwdKWAxW6i68BHTjHL8cQ3IcHCKMCKCk",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11swknk7lt"],"麵體",2,null,null,"0ahUKEwi9_MWzwdKWAxW6i68BHTjHL8cQ3YcHCKUCKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwi9_MWzwdKWAxW6i68BHTjHL8cQ3IcHCKQCKCo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這是第一次吃乾的拉麵，是叫沾麵😂，感覺很外行，沒關係，這樣吃起來才公正，純粹的口感，説服力才高🤭\n第一次來直接就點招牌來吃，特製濃厚魚介沾麵，隔壁客人點一樣先上桌，他直接問服務生如何使用（所以建議服務人員，點這餐點的客人，如是第一次用餐，就該說明一下），我加點了一顆原味溏心蛋，麵是涼的，可放到魚介湯汁中滷一下，就可吃，麵的硬度有嚼勁，魚介據說是雞高湯跟魚介及特製醬油調合而成，作為沾醬口感很不錯，加了點辣醬，覺得更有跳脫的層次感，只沾魚介的口味，感覺太規矩了😂\n魚介中有雞肉丸子，味道沒特別，但，我很介意的是，筍乾，蔥花也太少了吧！雞肉和豬肉片倒是很嫰好吃，沾了魚介，味道鮮美；看到隔壁用魚介碗加湯，我也請小姐幫忙加湯，就想喝喝看拉麵湯🤭大家吃甜不辣後，是不是一定要喝碗甜不辣湯才完美（最好碗底還有甜不辣的沾醬），覺得應該是一樣的原理，但，這魚介湯..有點鹹，我硬品嚐了半碗，相信會口渴到不行🤨\n一燈整個環境寬敞，我更喜歡二樓窗邊的位置，看著窗外的夜色，吃碗熱熱拉麵（下次點真正的湯麵吃看看），下班後的疲累得以釋放👍最後的冰淇淋沒有吸引我，更覺得是多此一舉 🙃\n此外，我不能理解，用餐環境美美，一碗拉麵要300，但確有服務生一直在旁邊掃地😂掃好幾回，環境很乾凈啊！限定60分鐘用餐時間,可以讓客人優雅一點吃麵嗎？可以，下班後再整理或掃地嗎？這是我衷心地建議📝",null,[0,48]]]],[null,null,null,null,null,"https://business.google.com/local/business/5852855742768164933/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkNORFp5Y1dsUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/5852855742768164933/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkNORFp5Y1dsUlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/5852855742768164933/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkNORFp5Y1dsUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/5852855742768164933/cu