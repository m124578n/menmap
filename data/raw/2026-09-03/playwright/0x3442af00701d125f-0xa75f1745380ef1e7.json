ll,null,7,41,34],"CgsKCS9tLzA3bDhwNQ\u003d\u003d","0ahUKEwjsvpeAw9KWAxU2afUHHXdrAwIQ1bMECNQBKCY",null,null,null,[[2]]],[["/m/017pqv"],"香",null,[null,null,null,null,5,0,5],null,"0ahUKEwjsvpeAw9KWAxU2afUHHXdrAwIQ1bMECNUBKCc",null,null,null,[[2]]],[["/g/122hcwgd"],"鹹",null,[null,null,null,null,5,0,5],null,"0ahUKEwjsvpeAw9KWAxU2afUHHXdrAwIQ1bMECNYBKCg",null,null,null,[[2]]],[["/m/033t__"],"細麵",null,[null,null,null,null,4,0,28],null,"0ahUKEwjsvpeAw9KWAxU2afUHHXdrAwIQ1bMECNcBKCk",null,null,null,[[2]]],[["/m/068whz"],"店長",null,[null,null,null,null,3,0,3],null,"0ahUKEwjsvpeAw9KWAxU2afUHHXdrAwIQ1bMECNgBKCo",null,null,null,[[2]]],[["/m/04kkgm"],"碗",null,[null,null,null,null,3,45,38],"CgsKCS9tLzA0a2tnbQ\u003d\u003d","0ahUKEwjsvpeAw9KWAxU2afUHHXdrAwIQ1bMECNkBKCs",null,null,null,[[2]]],[["/m/0186b6"],"柚子醋",null,[null,null,null,null,2,0,2],null,"0ahUKEwjsvpeAw9KWAxU2afUHHXdrAwIQ1bMECNoBKCw",null,null,null,[[2]]]]],[["一階堂IKAIDO傳承日本拉麵職人的精神，究極拉麵之美味體驗。有別於其他職人拉麵，一階堂精挑細選台灣當地的新鮮梅花豬，將食材的鮮美與日本的傳統拉麵工藝完美結合。\n\n製作一階堂叉燒的過程長達18小時，經過繁複的層層工序，新鮮的梅花肉首先以高達250度的火候炙烤，透過梅納反應將多餘的油脂慢慢化開，同時鎖住豐富的肉汁，讓每一片叉燒都充滿濃郁香氣與多層次口感。炙烤後，叉燒進行第二道工序，需要在72度進行舒肥慢煮，這一過程不僅讓肉質內部更加柔嫩多汁，還能讓風味更豐富。\n\n我們堅持選用日本原裝特級濃口醬油與刺身醬油作為基底，細緻熬煮豬大骨與雞骨，再輔以昆布與小魚乾等乾貨，每一口湯與叉燒肉完美融合，提供低鈉卻濃郁的日式拉麵口感。\n\n一階堂IKAIDO希望傳達日本傳統拉麵技藝與台灣在地食材的完美結合，從博多細麵到筍乾皆出自我們獨家研發製作，貫穿我們日本拉麵職人的精神，究極拉麵的熱愛。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh3.googleusercontent.com/-DSNvSL8KFtU/AAAAAAAAAAI/AAAAAAAAAAA/qCXUXlyoroQ/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"臺北市士林區蘭興里",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwjsvpeAw9KWAxU2afUHHXdrAwIQhbADCNwBKAA","全部",[["CIABIhCHAxuxasoXYX0wpvuOWd8d",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkdbM6_HHx90Q_yN-SJDqL26yFxYLrRnl8-Ik3g9wbO73xrtUM7B_pdZo4EXlkJBjgeSaU8TBP6EpgFv_JarKuSH4wfKct48HEowG0OoJwawUn8LJ4fFJvYtKSfpDBhgLoHbGQalEVLt-g9\u003