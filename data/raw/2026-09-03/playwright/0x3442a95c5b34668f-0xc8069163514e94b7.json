,[null,[10,"CIABIhCeOrDuIXHvGvo1LzzgrEmh"],[10,3,[4032,2688]],[null,null,null,null,null,["小卷與蛤蜊濃湯拉麵"],null,["瓦力拉麵"]],[null,[[["Joyce.L"],"https://www.google.com/maps/contrib/111569561941324657569?hl\u003dzh-TW","https://lh3.googleusercontent.com/a/ACg8ocK7qLDY8tEgUa_hDoDRiujDmLvybOF7MvmiTclDSjRAvvWS2Q\u003ds120-c-rp-mo-br100",null,null,"111569561941324657569"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,7,4,16,null,null,null,null,["1 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhCeOrDuIXHvGvo1LzzgrEmh\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xc8069163514e94b7"]],1,null,null,null,null,null,null,["0","-4033376560511806281"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT21Gck9HVlhRV2RVVWpreWRUUlBSbXhwV1ZaNVNrRRAB"]],"CIABIhCeOrDuIXHvGvo1LzzgrEmh",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjY3Me9v9KWAxU3na8BHeNYJxIQ3IcHCFYoAg",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjY3Me9v9KWAxU3na8BHeNYJxIQ3IcHCFcoAw",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjY3Me9v9KWAxU3na8BHeNYJxIQ3IcHCFgoBA",null,null,null,[1],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["7/4 路過看到新開的拉麵店，身為拉麵控我連想都沒想就走進去了。點了蛤蜊拉麵跟小卷拉麵，結果直接大踩雷，這是我此生吃過最難吃的拉麵沒有之一🤡🤡🤡\n\n不只食物，連服務都讓人匪夷所思到滿頭問號，以下跟大家好好說明：\n1. 麵條軟爛還粉粉的，店員告知是因為「麩質比較多」所以是正常的？？？？但我吃過那麼多好吃的細麵，從來沒吃過這種粉感。\n好～沒有關係，口味這件事本來就很主觀，店家可能就喜歡這種風格，我不喜歡但我尊重～\n2.蛤蜊拉麵裡有三顆沒開，反應後店員說因為是每天新鮮現買的（後面吧啦吧啦我沒聽懂），並說會重做一份。\n最傻眼的部分來了😍 當時我已經把原本拉麵裡的蛤蜊撈到小碗正在吃，店員走過來，放下一份新蛤蜊後，直接把我正在吃的那碗蛤蜊整碗端走，而且一句話也沒說！！！😍😍？？？？？\n我看不懂，真的看不懂這是什麼操作🤡\n如果重做要回收，提早講一聲我當然沒意見，但當著客人的面直接把正在吃的東西端走，到底是什麼意思？？？重點是，他補給我的是「一份蛤蜊」而不是「整碗新拉麵」欸拜託😍😍😍\n如果我今天沒有把蛤蜊撈出來，我是不是整碗拉麵都會被他端走？？？😍😍大腦真的瞬間跑出一百個問號欸\n喔對了，翻了一下 Google 評論，發現只要有負評，店家基本上都會用『因為新店剛開，很多食材都在測試與提升，要求客人應該來吃過最新的再來評論』來當藉口，既然店家這麼看重『測試期』，我想我作為剛剛吃過最新版本的拉麵的人，我應該是最有資格留下這則評論的人😍😍😍",null,[0,105]]]],[null,1783189302000000,1783189302000000,"1 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfaFhHX1lJQkFHWFV6SlZybUJwNU5jZw%7CCAEQrcz1_gkiLwoZQ0hfaFhHX1lJQkFHWFV6SlZybUJwNU5jZxoSQ2dzSXRwNmwwZ1lROF8yLWNB\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjY3Me9v9KWAxU3na8BHeNYJxIQ_2MIWSgF"],"https://business.google.com/local/business/1842000656310056066/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHY2s5SFZsaFJWMlJWVldwcmVXUlVVbEJTYlhod1YxWmFOVk5yUlJBQhAA",[null,null,null,"/local/business/1842000656310056066/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHY2s5SFZsaFJWMlJWVldwcmVXUlVVbEJTYlhod1YxWmFOVk5yUlJBQhAA"],"https://business.google.com/local/business/1842000656310056066/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHY2s5SFZsaFJWMlJWVldwcmVXUlVVbEJTYlhod1YxWmFOVk5yUlJBQhAA",[null,null,null,"/local/business/1842000656310056066/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHY2s5SFZsaFJWMlJWVldwcmVXUlVVbEJTYlhod1YxWmFOVk5yUlJBQhAA"],null,"https://business.google.com/local/business/1842000656310056066/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHY2s5SFZsaFJWMlJWVldwcmVXUlVVbEJTYlhod1YxWmFOVk5yUlJBQhAA",[null,null,null,"/local/business/1842000656310056066/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHY2s5SFZsaFJWMlJWVldwcmVXUlVVbEJTYlhod1YxWmFOVk5yUlJBQhAA"],null,["zh-Hant"],[["你好：先感謝今天來本店用餐，讓你有不愉快的用餐體驗我先說聲抱歉。\n關於你說的「店員走過來，放下一份新蛤蜊後，直接把我正在吃的那碗蛤蜊整碗端走，而且一句話也沒說！！」我們詢問員工和看監視器後，員工補給你一份新的蛤蠣時有跟你說：補給你新的一份，那我把吃完的先收走。你們回覆：好謝謝。 再跟你說明我們出海鮮拉麵時都會給你一個空碗裝空殼，當下員工可能是以為碗裡面都是吃剩的蛤蠣殼所以才會把你的碗收走。 所以這裡可能有點誤會。 但還是謝謝你來本店用餐，祝您愉快。",null,[0,226]]]],[null,null,752,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21Gck9HVlhRV2RVVWpreWRUUlBSbXhwV1ZaNVNrRRAB!2m1!1s0x0:0xc806916