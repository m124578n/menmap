GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11vy53tmks"],"叉燒",2,null,null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3YcHCGcoAA"],[["M:/g/11sdx18c79"],"溏心蛋",2,null,null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3YcHCGgoAQ"],[["M:/g/11svmykrdy"],"辣麻味噌沾麵",2,null,null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3YcHCGkoAg"],[["M:/g/11x0whqzmf"],"麻辣味噌拉麵",2,null,null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3YcHCGooAw"]],[1]],null,"建議的餐點",null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3IcHCGYoEg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3YcHCGwoAA"]],1],null,null,"預訂網址",null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3IcHCGsoEw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3YcHCG4oAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3YcHCG8oAQ"]]],null,"用餐人數",null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3IcHCG0oFA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_30_TO_60_MIN"],"30 到 60 分鐘",2,null,null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3YcHCHEoAA"]],1],null,null,"等待時間",null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQ3IcHCHAoFQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["解鎖存在口袋名單已久，位於中山北路一段上的鬼金棒。週六中午一開店半小時後抵達，排隊等候時間約30分鐘。\n\n初訪選擇招牌的「辣麻味噌拉麵」（辣普通、麻普通），再額外加點一顆溏心蛋（原本配置是沒有蛋的）。\n\n濃郁的味噌豚骨湯頭非常好喝，有深度也有厚度，將上頭的辣粉與花椒粉一同拌入湯中提升豐富的層次感，非常開胃與過癮。普通的辣度與麻度讓無辣不歡的本人有了「終於會辣」的感覺，但依舊很好掌握難度不高，下次會想要試試辣麻增量。\n\n偏粗的麵體Q彈有嚼勁，外層帶有些許蕎麥顆粒，讓表層呈現不規則狀更容易掛上湯汁；溏心蛋的熟度更是優秀，是剛好會流心的濃稠狀態。\n\n重頭戲則是那一塊肥瘦相間的叉燒，從裡到外滷到十分入味的同時，還能保有肉質軟嫩多汁的口感，一抿彷彿快要化開，拌入辣麻的湯汁簡直完美，會讓人想多加點一塊。\n\n另一大亮點則是現場大火爆炒的豆芽菜，鍋氣十足又十分清脆，與整碗麵的適配性很高，強烈建議多加點一份。\n\n整體而言，拉麵堪稱完美演出，特別適合愛吃辣的客群，下次會想試試辣麻增量的沾麵。座位稍嫌擁擠，用餐途中容易碰到隔壁客人的手臂。\n\n雖然網上常說老闆很有個性，但實際走訪遇到的女店員很親切客氣又可愛，用餐過程並沒有什麼壓迫感。雖說店內有些規定，但對於想要專注享受一碗好拉麵的本人來說都很合理，個人覺得相當值得造訪。",null,[0,100]]]],[null,null,null,null,null,"https://business.google.com/local/business/6781132535250818714/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4ZEZwSFpEQmFTRTVNVjFWak5XTllhRFZpYld4Q1dsYzViMDVyUlJBQhAA",[null,null,null,"/local/business/6781132535250818714/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4ZEZwSFpEQmFTRTVNVjFWak5XTllhRFZpYld4Q1dsYzViMDVyUlJBQhAA"],"https://business.google.com/local/business/6781132535250818714/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4ZEZwSFpEQmFTRTVNVjFWak5XTllhRFZpYld4Q1dsYzViMDVyUlJBQhAA",[null,null,null,"/local/business/6781132535250818714/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4ZEZwSFpEQmFTRTVNVjFWak5XTllhRFZpYld4Q1dsYzViMDVyUlJBQhAA"],null,"https://business.google.com/local/business/6781132535250818714/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4ZEZwSFpEQmFTRTVNVjFWak5XTllhRFZpYld4Q1dsYzViMDVyUlJBQhAA",[null,null,null,"/local/business/6781132535250818714/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4ZEZwSFpEQmFTRTVNVjFWak5XTllhRFZpYld4Q1dsYzViMDVyUlJBQhAA"]],[null,null,6935,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2kxdFpHZDBaSE5MV1VjNWNYaDVibWxCWlc5b05rRRAB!2m1!1s0x0:0xb3054e4e4b79bcdf!3m1!1s2@1:CAIQACodChtycF9oOi1tZGd0ZHNLWUc5cXh5bmlBZW9oNkE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2kxdFpHZDBaSE5MV1VjNWNYaDVibWxCWlc5b05rRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2kxdFpHZDBaSE5MV1VjNWNYaDVibWxCWlc5b05rRRI-Ci9DQUlRQUNvZENodHljRjlvT2kxdFpHZDBaSE5MV1VjNWNYaDVibWxCWlc5b05rRRILMGU4WThuYUVjNDEaPgovQ0FJUUFDb2RDaHR5Y0Y5b09pMXRaR2QwWkhOTFdVYzVjWGg1Ym1sQlpXOW9Oa0USCzBlOFk4bmFFYzQxIhIJAAAAAAAAAAAR37x5S05OBbMqCzBlOFk4bmFFYzQx\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwisq7qI49GWAxUHZvUHHRHeJHQQoykIcigW"],null,[null,[[1,0]]]],"0ahUKEwjZ9b-I49GWAxXzdV4E