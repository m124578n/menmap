,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiqhruLw9KWAxWxna8BHZQIH0UQ3IcHCLsBKA4",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiqhruLw9KWAxWxna8BHZQIH0UQ3IcHCLwBKA8",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiqhruLw9KWAxWxna8BHZQIH0UQ3IcHCL0BKBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwiqhruLw9KWAxWxna8BHZQIH0UQ3YcHCL8BKAA"]]],null,"用餐人數",null,"0ahUKEwiqhruLw9KWAxWxna8BHZQIH0UQ3IcHCL4BKBE",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["台灣台北 🆃🅰🅸🅿🅴🅸, 🆃🅰🅸🆆🅰🅽\n📍店名｜🅽🅰🅼🅴：#小倉酒場 #kokura_sakaba\n\n超過十年無去過#士林夜市，以前真係必去😂\n環境同我印象中好似唔同左，無去Food court食，揀左去牌坊對面馬路嘅一間#居酒屋，貪唔洗自己去買！\n\n💯必食｜🅼🆄🆂🆃 🆃🆁🆈:\n鹽烤干貝｜ꜱᴀʟᴛ-ɢʀɪʟʟᴇᴅ ꜱᴄᴀʟʟᴏᴘꜱ｜TWD120\n勁大粒元貝！佢啲確有小少dry過，用鹽輕輕調過味，同時食到鹽香同貝香\n\n烤脆皮大腸串｜ɢʀɪʟʟᴇᴅ ᴄʀɪꜱᴘʏ ɪɴᴛᴇꜱᴛɪɴᴇ｜TWD80\n睇個樣好乾好柴，估唔到勁脆，而且燒得超香口 出色\n\n⭐️推介｜🆁🅴🅲🅾🅼🅼🅴🅽🅳:\n元氣蛤蜊煮｜ᴄʟᴀᴍ ꜱᴏᴜᴘ｜TWD140\n好鮮嘅蜆湯，每啖都有好濃嘅蜆香，如果飲完酒第二日有依碗湯堅正\n\n鹽烤雞牡蠣｜ꜱᴀʟᴛ-ɢʀɪʟʟᴇᴅ ᴄʜɪᴄᴋᴇɴ ᴏʏꜱᴛᴇʀ\n好少可會有雞蠔肉食！一串足足有5舊，好滑好好味！如果調味再濃啲仲正\n\n椒鹽炸雞膝骨｜ꜱᴀʟᴛ \u0026 ᴘᴇᴘᴘᴇʀ ᴄʜɪᴄᴋᴇɴ ᴄᴀʀᴛɪʟᴀɢᴇ ｜TWD180\n其實係咪即係雞軟骨？但佢真係好大粒！椒鹽好香，加埋青檸落去好Fresh，送酒正\n\n🆗普通｜🅰🆅🅴🆁🅰🅶🅴:\n鹽烤厚切牛舌串｜ꜱᴀʟᴛ-ɢʀɪʟʟᴇᴅ ᴛʜɪᴄᴋ-ᴄᴜᴛ ʙᴇᴇꜰ ᴛᴏɴɢᴜᴇ｜TWD170\n牛舌比我想像中細塊，好彩都厚切！不過燒得太乾口感唔好\n\n提燈｜ᴄʜᴏᴜ ᴄʜɪɴ｜TWD140\n絕對唔會錯過嘅提燈！有成三粒比我想像中多，食落去爆漿都好香蛋黃味，不過佢啲肉粒令我有啲卻步\n\n其實佢食物選擇唔多，不過環境好靚，而且服務勁好！仲要俾兩把大風扇吹住我哋，飲住啤酒勁a Chill勁爽\n\n#MFJ台灣 #MFJ台北 #MFJ台灣菜\n\n🧭地址｜🅰🅳🅳🆁🅴🆂🆂：111台灣台北市士林區基河路110號\n💰人均消費｜🅲🅾🆂🆃 🅿🅴🆁 🅿🅰🆇: TWD935\n✅推介指數｜🆁🅴🅲🅾🅼🅼🅴🅽🅳🅰🆃🅸🅾🅽: 4/5\n\n#mfoodjournal #japanesefood #TaipeiFood #izakaya #skewers #台灣 #台北 #台北美食 #日本菜 #居酒屋 #串燒",null,[0,49]]]],[null,null,null,null,null,"https://business.google.com/local/business/16834678661798838703/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzTkdWSFdqSlZNRlp0VFhwR1dsWXlOVEZUYTA1WFl6RktTMk16WXhBQhAA",[null,null,null,"/local/business/16834678661798838703/customers