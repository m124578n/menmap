_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjwopX1ydKWAxXkk68BHUSeDooQ3IcHCIIBKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwjwopX1ydKWAxXkk68BHUSeDooQ3YcHCIQBKAA"]]],null,"座位類型",null,"0ahUKEwjwopX1ydKWAxXkk68BHUSeDooQ3IcHCIMBKAc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這間拉麵店藏在一條比較不起眼的巷弄裡，原本只是抱著隨意試試看的心情走進去，沒想到整體表現意外地很不錯\n\n點了蒜味拉麵，湯頭濃郁、有明顯的蒜香，但不會過度死鹹，麵條和叉燒搭配起來也很順口，吃完整碗相當有滿足感。麵條還可以免費續加，對食量較大的人來說很加分!另外點了一份炸雞(忘了拍照)，雖然價格不算便宜，但還蠻好吃的\n\n除了餐點之外，老闆也很親切，整個用餐過程讓人感覺很自在。店內播放的歌曲和一般拉麵店常見的類型不太一樣，挺有意思\n\n店面規模不大，位置也不算顯眼，但無論餐點、服務還是氣氛都能感受到店家的用心。這次完全超出原本的預期，之後有機會會再回訪。",null,[0,50]]]],[null,1785125435000000,1785125435000000,"1 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfMWQ0QnRnWGZLS0lKcllJaWU3X1Nzdw%7CCAEQrcz1_gkiLwoZQ0hfMWQ0QnRnWGZLS0lKcllJaWU3X1NzdxoSQ2dzSXU3U2Iwd1lRME56cWJ3\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjwopX1ydKWAxXkk68BHUSeDooQ_2MIhQEoCA"],"https://business.google.com/local/business/16662918959180402149/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLYmxOclJsVmlNR2Q1VWxaUmRGZHRXakJqUlZGNllVZGFkRlJHUlJBQhAA",[null,null,null,"/local/business/16662918959180402149/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLYmxOclJsVmlNR2Q1VWxaUmRGZHRXakJqUlZGNllVZGFkRlJHUlJBQhAA"],"https://business.google.com/local/business/16662918959180402149/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLYmxOclJsVmlNR2Q1VWxaUmRGZHRXakJqUlZGNllVZGFkRlJHUlJBQhAA",[null,null,null,"/local/business/16662918959180402149/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLYmxOclJsVmlNR2Q1VWxaUmRGZHRXakJqUlZGNllVZGFkRlJHUlJBQhAA"],null,"https://business.google.com/local/business/16662918959180402149/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaR