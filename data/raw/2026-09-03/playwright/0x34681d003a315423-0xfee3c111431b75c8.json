]],[["/m/02g3g4"],"油條",null,[null,null,null,null,6,0,9],null,"0ahUKEwiIt_C6y9KWAxVEcPUHHchhKwQQ1bMECNECKE4",null,null,null,[[2]]],[["/m/0j3d76m"],"冬瓜茶",null,[null,null,null,null,5,0,8],null,"0ahUKEwiIt_C6y9KWAxVEcPUHHchhKwQQ1bMECNICKE8",null,null,null,[[2]]],[["/g/122np7v2"],"飯",null,[null,null,null,null,5,54,5],"Cg0KCy9nLzEyMm5wN3Yy","0ahUKEwiIt_C6y9KWAxVEcPUHHchhKwQQ1bMECNMCKFA",null,null,null,[[2]]],[["/m/06wqb"],"空間",null,[null,null,null,null,5,106,40],"CgoKCC9tLzA2d3Fi","0ahUKEwiIt_C6y9KWAxVEcPUHHchhKwQQ1bMECNQCKFE",null,null,null,[[2]]]]],[["「有些味道，值得被記住；有些夢想，值得重新開始。」\n曾經，我與夥伴一起經營一家小小的拉麵店，用心熬湯、認真煮麵，也因此認識了許多支持我們的客人。\n後來，因為經營理念不同，我選擇離開，放下親手建立的一切。\n原以為故事已經結束，卻因為一句句溫暖的鼓勵而重新開始。\n被迫離開的夥伴告訴我： 「老闆，再開一次吧，我們願意跟著你。」\n熟悉的客人告訴我： 「我們想念那碗麵的味道。」\n正因為這些信任與支持，沐熹誕生了。\n「沐」代表洗去過往，重新出發； 「熹」代表晨曦微光，迎向希望。\n我們保留對拉麵的初心，也研發出屬於沐熹的特色鍋物湯底，讓一碗麵與一鍋湯，都能帶給人溫暖與力量。\n感謝每一位走進沐熹的朋友。\n因為有你們， 這份堅持才能繼續熬煮下去。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-R5Ueh_aS4jA/AAAAAAAAAAI/AAAAAAAAAAA/w-uknLV9Ptw/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,[[0,"拉麵店"],"查看相似地點"],[1],"新北市板橋區溪洲里",null,null,null,null,[[["CgIgAQ\u003d\u003d","0ahUKEwiIt_C6y9KWAxVEcPUHHchhKwQQhbADCNYCKAA","全部",[["CIABIhAA3ilWLjJpbWgIHyIADZLE",10,12,null,null,null,["https://lh3.googleusercontent.com/gps-cs-s/AHRPTWlZa0mMF3V7bJ9p961qizo9TNS0Ez4WQjvkiK6OMaa91gY7WKbDl7eRe6yB9buagI8F3RlqlZqLr7ONRsWM2IjHXEfeHgYt2r-s7mwUN9DBq8dxkbM3SQdpLgR51dVznjKYGttp3-qAE_rx\u003dw446-h298-k-no","",[730,487],[203,100]],null,[[3,121.42616470000002,24.9886692],[0,90],[730,487],75],"3n-ZaojQC8Tg1e8PyMOtIQ","0ahUKEwiIt_C6y9KWAxVEcPUHHchhKwQQzCcI1wIoAA",null,null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhAA3ilWLjJpbWgIHyIADZLE"],[10,3,[487,730]],null,null,[[[2],[[null,null,24.9886692,121.42616470000002]]]],[1,null,null,[2],null,[null,null,"bizbuilder:gmb_on_gmm_android",[6,7,4,1,3]],null,nul