l,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi6pcewvdKWAxWje_UHHQn1LZUQ3YcHCM4BKAA"]],1],null,null,"等待時間",null,"0ahUKEwi6pcewvdKWAxWje_UHHQn1LZUQ3IcHCM0BKAg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_OTHER_DIETARY_RESTRICTIONS_TIPS"],"特殊餐點",null,null,"分享特殊餐點相關資訊","特殊餐點",null,"0ahUKEwi6pcewvdKWAxWje_UHHQn1LZUQ3IcHCM8BKAk",null,null,["🐮"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:OTHER_DIETARY_RESTRICTIONS"],"特殊餐點",2,null,null,"0ahUKEwi6pcewvdKWAxWje_UHHQn1LZUQ3YcHCNEBKAA"]]],null,null,null,"0ahUKEwi6pcewvdKWAxWje_UHHQn1LZUQ3IcHCNABKAo",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["相比台中知名牛骨拉麵，我更偏好這間的口味，以近期來說我認為神無月是最被低估的店家之一，價格不算特別貴，牛骨湯頭濃郁有奶油味，牛叉燒也有相當的厚度，味道有點像煙燻後的火腿，相當不錯，麵硬算適中，湯溫稍嫌不足，整體可圈可點，目前基本上是不用排隊的情形，離捷運站有段距離，無論口味和鑒別度，在台北這個拉麵競爭已經白熱化的大環境裡都仍是值得紅起來的店家，希望老闆可以繼續撐下去，加油！\n\n小插曲：店內有一位長輩宣稱這間在日本有Tabelog 3.65的等級，很有趣的比喻（不過日本不同派系的拉麵評價也大相徑庭，台日人民的口味更有差距，故難以直接比較）",null,[0,188]]]],[null,null,null,null,null,"https://business.google.com/local/business/11540227143407923140/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMwTkV4VlRrUmlSWGh4VWxoT2QxRXpTVFZTU0VaWFkwUlNjbEZYWXhBQhAA",[null,null,null,"/local/business/11540227143407923140/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMwTkV4VlRrUmlSWGh4VWxoT2QxRXpTVFZTU0VaWFkwUlNjbEZYWXhBQhAA"],"https://business.google.com/local/business/11540227143407923140/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMwTkV4VlRrUmlSWGh4VWxoT2QxRXpTVFZTU0VaWFkwUlNjbEZYWXhBQhAA",[null,null,null,"/local/business/11540227143407923140/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMwTkV4VlRrUmlSWGh4VWxoT2QxRXpTVFZTU0VaWFkwUlNjbEZYWXhBQhAA"],null,"https://business.google.com/local/business/11540227143407923140/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnMwTkV4VlRrUmlSWGh