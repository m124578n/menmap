ull,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT21wS2MwUTFjMjVFZFZoSE1qaHJXa3czZVhWb09WRRAB"]],"CIABIhDF3IwFHQdZ99Gxp3cXh2-S",1]],null,null,null,[[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3YcHCKYBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3IcHCKUBKAI",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3IcHCKcBKAM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3IcHCKgBKAQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3IcHCKkBKAU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3YcHCKsBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3IcHCKoBKAY",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3YcHCK0BKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3YcHCK4BKAE"]]],null,"用餐人數",null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3IcHCKwBKAc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["我點采流赤海老拉麵。上餐時，我覺得拉麵超漂亮，用料也確實新鮮，整體是好吃，也願意回訪的。（友人的雞金塩湯頭也很讚）\n\n蝦仁雲吞（需要加點）吃起來超紮實！\n\n這次是點北海道細直麵跟加點熊本中卷麵。（加麵要錢）我認為細直麵比較好，後者不易攀附湯汁，較有麵味，但口感紮實。然後推薦一定要加點白飯（免費），整碗倒下去配合湯汁，變海鮮湯飯，很讚！！\n\n點餐是手機掃碼Line點餐，吃完現金結帳。吃完自助收拾餐具。店內位置偏少，只有一張四人桌，另有一個小桌可能可以拿椅子變雙人，其它是單人吧台桌。總計十人位吧。\n\n要說缺點是上餐速度比我想像中晚很多，當時甚至前面只有一名客人。不過整間店確實只有老闆一人，可以理解。建議大家若來訪要預留三十分鐘以上的等餐時間。而且不要太多人來，因為可能第一人吃完，第二人麵還沒來🤣 （老闆還很貼心問要幫忙加熱湯嗎，我有嚇到，這是我吃拉麵第一次被問）\n\n雖然有前述時間情況，但我還是很推這家店，只是提醒大家來訪務必多留時間。",null,[0,76]]]],[null,1762005159000000,1762005159000000,"10 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfWUk2cTl6aC0tTlVxb2Q0Q2t5RWRlZw%7CCAEQrcz1_gkiMAoZQ0hfWUk2cTl6aC0tTlVxb2Q0Q2t5RWRlZxoTQ2d3SXA2R1l5QVlRaVBhdmxBTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ_2MIrwEoCA"],"https://business.google.com/local/business/1201051210675199503/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3UzJNd1VURmpNalZGWkZab1NFMXFhSEpYYTNjelpWaFdiMDlXUlJBQhAA",[null,null,null,"/local/business/1201051210675199503/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3UzJNd1VURmpNalZGWkZab1NFMXFhSEpYYTNjelpWaFdiMDlXUlJBQhAA"],"https://business.google.com/local/business/1201051210675199503/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3UzJNd1VURmpNalZGWkZab1NFMXFhSEpYYTNjelpWaFdiMDlXUlJBQhAA",[null,null,null,"/local/business/1201051210675199503/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3UzJNd1VURmpNalZGWkZab1NFMXFhSEpYYTNjelpWaFdiMDlXUlJBQhAA"],null,"https://business.google.com/local/business/1201051210675199503/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3UzJNd1VURmpNalZGWkZab1NFMXFhSEpYYTNjelpWaFdiMDlXUlJBQhAA",[null,null,null,"/local/business/1201051210675199503/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3UzJNd1VURmpNalZGWkZab1NFMXFhSEpYYTNjelpWaFdiMDlXUlJBQhAA"],null,["zh-Hant"],[["🙏非常感謝您這麼細緻的分享與回饋。\n很開心您喜歡我們的海老蝦湯、蝦仁雲吞。\n還特別提到湯飯的吃法，我們真的很開心！\n\n上餐時間的部分，由於目前店內僅老闆一人作業，偶爾會稍慢，感謝您的理解與體諒。\n我們會持續努力調整，希望下次能以更順暢的節奏，讓您品嚐到同樣用心的拉麵哦。\n期待再度為您服務，也謝謝您願意推薦與再訪",null,[0,57]]]],[null,null,3866,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21wS2MwUTFjMjVFZFZoSE1qaHJXa3czZVhWb09WRRAB!2m1!1s0x0:0xd35e8a45b6956e21!3m1!1s2@1:CAIQACodChtycF9oOmpKc0Q1c25EdVhHMjhrWkw3eXVoOVE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\