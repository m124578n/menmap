ED"],"不需要訂位",2,null,null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3YcHCI0BKAA"]],1],null,null,"預訂網址",null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3IcHCIwBKAY",null,null,null,null,null,3,null,2],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3YcHCI8BKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3IcHCI4BKAc",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3YcHCJEBKAA"]]],null,"用餐人數",null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ3IcHCJABKAg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["一言難盡的餐點跟用餐體驗，有好有壞，能感覺的出老闆的熱忱跟用心，但餐點部分不甚滿意，點了300的蝦湯+25的麵，有兩隻蝦子,四顆蛤蜊跟一片檸檬，都很新鮮,紮實飽滿，但私心希望能多一點，湯的部分很蝦很濃，但不是很鹹（鹹度最鹹），而且感覺沒甚麼調味，就是很濃厚的純蝦，給的檸檬只有一片，對味道沒什麼提升，看其他照片有半顆小的可以擠，不確定是不是300塊的沒有，沒有任何轉味的空間；麵的話我選細硬麵，可能煮不夠久，吃起來很粉且有部分黏在一起。\n吃完後給我一種全靠數值沒有技術的感覺，用料紮實但沒經過搭配跟設計，蝦湯很濃，導致蝦子吃起來很普通，檸檬不好擠放裡面也對味道沒有任何提升還有點卡筷子。\n最後不知道為何，上餐的速度非常慢，在入座時已經有兩位客人點完餐加我共三張單的情況下，依舊等了25分鐘且漏看了我加麵的選項，看其他評論，老闆似乎是一碗一碗準備的，導致等餐時間很長。在上面種種原因下，今天的體驗真的差強人意。",null,[0,218]]]],[null,1760959798000000,1760959798000000,"10 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfNmQxYjJKcGJXeEwzeUhSN2VRb0lHZw%7CCAEQrcz1_gkiMAoZQ0hfNmQxYjJKcGJXeEwzeUhSN2VRb0lHZxoTQ2d3SXRycll4d1lRMVl5LTJRTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi_rOarydKWAxVmla8BHS5LM0EQ_2MIkgEoCQ"],"https://business.google.com/local/business/1201051210675199503/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBqTTFveGJ6VlVNbG96WWxSa1JtUXlaSFZNVlZwSVZEQlNXbE5IWXhBQhAA",[null,null,null,"/local/business/1201051210675199503/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBqTTFveGJ6VlVNbG96WWxSa1JtUXlaSFZNVlZwSVZEQlNXbE5IWXhBQhAA"],"https://business.google.com/local/business/1201051210675199503/customers/reviews/deletereply?p\u003dCkRDaTlE