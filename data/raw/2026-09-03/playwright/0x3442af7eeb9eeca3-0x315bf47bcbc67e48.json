7\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x315bf47bcbc67e48"]],1,null,null,null,null,null,null,["0","3556705143276076616"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUN4aUw2LVZnEAE"]],"CIHM0ogKEICAgICxiL6-jgE",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwiS2IWYzdKWAxUEdPUHHf_XMeIQ3YcHCJgBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwiS2IWYzdKWAxUEdPUHHf_XMeIQ3IcHCJcBKAY",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiS2IWYzdKWAxUEdPUHHf_XMeIQ3YcHCJoBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiS2IWYzdKWAxUEdPUHHf_XMeIQ3IcHCJkBKAc",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiS2IWYzdKWAxUEdPUHHf_XMeIQ3YcHCJwBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiS2IWYzdKWAxUEdPUHHf_XMeIQ3IcHCJsBKAg",null,null,null,null,null,1,[[2]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["🍽️\n位於階梯上的店家，店內空間寬敞、明亮，只是需要走階梯上來，行動不便的人不太方便。\n價格算是經濟實惠，附上飲料暢飲，餐點的份量上都算能夠滿足，不夠對於食量大的人，可能就會吃不飽了。\n\n第一次來相當反骨的沒有點拉麵\n這次點的是\n大海的味道黑咖哩$210：有著炸蝦🍤、蝦排、鱈魚排，和玉米、些許花椰菜作為配料。先說主角，黑咖哩，不同於一般咖哩的甜膩和濃稠，而是「帶點像是胡椒的辛味和洋蔥的辣感」，配著飯是越吃越香的。\n炸蝦🍤：能夠吃到蝦子的甜和嚼勁，麵衣不會很厚重，沒有讓整個味道都是麵糊味。\n蝦排：意外的很多蝦子，至少有兩三個，吃起來也很新鮮！\n鱈魚排：比較普通，營養午餐的食物。\n\n南瓜可樂餅：吃起來不會過甜，很綿密！不過比起南瓜，更像是超商烤地瓜的口感和味道，蠻好吃的。\n\n整體風格：大概環顧了一下周遭，大多是家庭單位的客人來用餐，我也覺得這個空間滿適合，晚上帶著小孩們來用餐，份量上小孩子也吃得飽。選擇上也有飯麵兩類可以選擇，也可以多點一些小菜類型，品項也算多，不怕吃膩，是晚餐的好選擇。",null,[0,92]]]],[null,null,null,null,null,"https://business.google.com/local/business/10663599718427331515/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjRhVXcyTFZabkVBRRAA",[null,null,null,"/local/business/10663599718427331515/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjRhVXcyTFZabkVBRRAA"],"https://business.google.com/local/business/10663599718427331515/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjRhV