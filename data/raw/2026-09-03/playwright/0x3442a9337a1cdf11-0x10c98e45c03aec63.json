lZPY0cxNFF6Qk1hVVp0WDJaTGVWRRAB"]],"CIABIhB749R-27eqNKphyS3Lf2ZU",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwiNkofHvtKWAxXBePUHHe3uAu4Q3YcHCJEBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiNkofHvtKWAxXBePUHHe3uAu4Q3IcHCJABKAU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiNkofHvtKWAxXBePUHHe3uAu4Q3YcHCJMBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiNkofHvtKWAxXBePUHHe3uAu4Q3IcHCJIBKAY",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiNkofHvtKWAxXBePUHHe3uAu4Q3IcHCJQBKAc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiNkofHvtKWAxXBePUHHe3uAu4Q3IcHCJUBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiNkofHvtKWAxXBePUHHe3uAu4Q3IcHCJYBKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwiNkofHvtKWAxXBePUHHe3uAu4Q3YcHCJgBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiNkofHvtKWAxXBePUHHe3uAu4Q3IcHCJcBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["熊越岳這間店經過很多次了，每次看到門口都排著長長的人龍，我就瞬間失去耐心，所以這麼多年來一直沒有機會吃到🤣\n\n印象中以前好像只是路邊的小麵攤，沒想到現在已經進駐百貨公司 B1，人氣依然很高。\n\n這次平日下午來用餐，人潮比想像中少一些，排隊後有座位可以坐著等，大約十幾分鐘就輪到了。\n\n我點的是醬油豚骨濃湯拉麵（背脂），湯頭濃郁香氣十足，不過對我來說稍微偏重口味一點😆 麵量也不少，吃完整碗其實蠻有飽足感，最後湯沒有喝完。\n\n店員服務態度很好，也有提供紙圍兜避免湯汁噴濺到衣服，算是蠻貼心的小細節。\n\n總算解鎖了一間經過很多年卻一直沒吃過的店，如果喜歡濃厚系拉麵，可以來試試看。",null,[0,95]]]],[null,null,null,null,null,"https://business.google.com/local/business/17118813351812930306/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPZUZVd01WVlRlbFpQWTBjeE5GRjZRazFoVlZwMFdESmFUR1ZXUlJBQhAA",[null,null,null,"/local/business/17118813351812930306/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVPZUZVd01WVlRlbFpQWTBje