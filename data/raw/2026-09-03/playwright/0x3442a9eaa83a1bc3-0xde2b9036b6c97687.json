null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["通常一般我評價店家都打五顆星\n但這次我打一顆星\n當中有四顆星，全被你們飯扣光\n\n明太子叉燒飯，一碗六十五\n看圖片感覺還以為是叉燒肉\n上面鋪上一層滿滿的明太子\n\n結果上來卻是叉燒碎肉\n除此之外明太子密集程度完全圖文不符\n\n那空隙的稀疏的程度\n就跟少林足球的髮量一樣充滿著稀疏空洞\n\n飯少，不打緊\n重點是你還給我鍋底那種！\n整個飯就像鍋底那種一坨一坨結整丸\n\n重點是有些沒熟的飯粒\n像塑膠一樣鑲嵌在牙齒上\n還要用手直接扣直接摳\n用拔的才拔得到\n\n能夠讓人吃那米飯吃到直接錄影\n拍攝那飯粒以及米飯的狀況\n這輩子我還真是第一次\n\n重點是一碗65元\n還給我吃鍋底飯\n我是什麼很賤的人嗎？\n\n備註：覺得我在黑的話\n麻煩請去看監視器\n\n看看我有沒有把手指伸進去嘴巴裡面\n把你們家飯粒摳掉放在桌上\n\n甚至是吃著飯\n直接把鍋巴塑膠飯吐在桌上\n\n不過放心，收拾的時候\n我還有把吐出來的飯\n重新收拾好，放在碗內\n\n總不可能吐出來的東西\n要吐在我吃的內容物上吧\n抱歉了，桌子",null,[0,38]]]],[null,null,null,null,null,"https://business.google.com/local/business/601616323475710245/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTUZvd1pIWmpWMVpTVFcwMVUwOVlXbE5QUkd4cVVqTlNiRk5XUlJBQhAA",[null,null,null,"/local/business/601616323475710245/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTUZvd1pIWmpWMVpTVFcwMVUwOVlXbE5QUkd4cVVqTlNiRk5XUlJBQhAA"],"https://business.google.com/local/business/601616323475710245/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTUZvd1pIWmpWMVpTVFcwMVUwOVlXbE5QUkd4cVVqTlNiRk5XUlJBQhAA",[null,null,null,"/local/business/601616323475710245/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTUZvd1pIWmpWMVpTVFcwMVUwOVlXbE5QUkd4cVVqTlNiRk5XUlJBQhAA"],null,"https://business.google.com/local/business/601616323475710245/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTUZvd1pIWmpWMVpTVFcwMVUwOVlXbE5QUkd4cVVqTlNiRk5XUlJBQhAA",[null,null,null,"/local/business/601616323475710245/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTUZvd1pIWmpWMVpTVFcwMVUwOVlXbE5QUkd4cVVqTlNiRk5XUlJBQhAA"]],[null,null,2085,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tZMFowZHZjV1ZSTW01U09YWlNPRGxqUjNSbFNWRRAB!2m1!1s0x0:0xde2b9036b6c97687!3m1!1s2@1:CAIQACodChtycF9oOkY0Z0dvcWVRMm5SOXZSODljR3RlSVE%7C%7C?hl\u003dzh-TW"],["h