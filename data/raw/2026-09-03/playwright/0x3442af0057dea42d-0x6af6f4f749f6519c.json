ocal/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDL2IiuhAE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x6af6f4f749f6519c",null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q-y4IlQIoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIDL2IiuhAE"],[10,3,[1818,2597]],[null,null,null,null,null,null,null,["藤哲商行"]],[null,[[["K"],"https://www.google.com/maps/contrib/113161320010929099881?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjU-FZYjYJ8bwSzsD8vXDR_rLO_xWdCy_ed1Lv2US7aCG6eEfn6K\u003ds120-c-rp-mo-ba12-br100",null,null,"113161320010929099881"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2024,6,25,7,null,null,null,null,["2 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDL2IiuhAE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x6af6f4f749f6519c"]],1,null,null,null,null,null,null,["0","7707617155226161564"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSURMMklpdWlBRRAB"]],"CIHM0ogKEICAgIDL2IiuhAE",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCJYCKA0",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCJcCKA4",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCJgCKA8",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["幾年前因小林推薦而到訪鳥哲用餐，試過雞白湯後也很喜歡覺得很濃郁（雞白湯拉麵為鳥哲的隱藏限量商品），一得知體系要開藤哲商行時很開心，且還是仿魚市場裝潢，瞬時想起去年巴黎的Kodawari Ramen (Tsukiji)，一開幕就抱著滿滿的期待來了。\n\n不得不說在台灣，藤哲的裝潢真的是有趣的，服務人員也滿友善的，但拉麵一入口我真的被震懾住了，不僅湯是溫的（一上桌表面的膠看起來就是有點時間了，且膠質下居然還能是溫的？可見放了一陣子）、麵條超級軟，毫無口感，湯頭很淡，完全不像是雞白湯，真的像是小吃店的陽春麵白湯，因為湯頭除了第一口未拌開時是湯，一開始吃麵後整碗湯就全部都是麵條味⋯\n\n配菜也超少，完全沒有記憶點然後一碗$360？\n真的是期待越高失望越高，如果是當看看裝潢來吃不是不行，但對我而言真的是一次店也不會推薦朋友去的程度。想念鳥哲還是去鳥哲就好（嚇壞）\n\n*當天也有發現評論中提到的上菜順序亂有出錯餐的問題，還請來訪者自行留意\n\n*請於店外先使用點餐機，可刷卡（算是一優點）",null,[0,123]]]],[null,1719708215000000,1719708215000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04RFBiVU85QUJtZ0tvM0FBcnZaQQ%7CCAEQrcz1_gkiMAoZQ0hfQm04RFBiVU85QUJtZ0tvM0FBcnZaQRoTQ2d3SXQ5U0N0QVlRbDdxSDBnSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q_2MImQIoEA"],"https://business.google.com/local/business/1866122680876020594/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUk1Na2xwZFdsQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/1866122680876020594/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUk1Na2xwZFdsQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/1866122680876020594/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUk1Na2xwZFdsQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/1866122680876020594/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUk1Na2xwZFdsQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/1866122680876020594/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUk1Na2xwZFdsQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/1866122680876020594/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUk1Na2xwZFdsQlJSQUIQAA%3D%3D"],null,["zh-Hant"],[["謝謝",null,[0,2]]]],[null,null,15275,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURMMklpdWlBRRAB!2m1!1s0x0:0x6af6f4f749f6519c!3m1!1s2@1:CIHM0ogKEICAgIDL2IiuiAE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURMMklpdWlBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSURMMklpdWlBRRItChZDSUhNMG9nS0VJQ0FnSURMMklpdVNBEhNDZ3dJMU5ycHN3WVE0SjJVc2dJGiwKFkNJSE0wb2dLRUlDQWdJREwySWl1S0ESEkNnc0loSkNGdEFZUTJMX2RYUSISCQAAAAAAAAAAEZxR9kn39PZqKgswYVZKVjNBaHB6Tg\u0026wv\u003d1\u0026d\u003d286732320",null,