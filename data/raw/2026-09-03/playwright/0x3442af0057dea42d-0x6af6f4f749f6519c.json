o4Q3IcHCMsBKA8",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCMwBKBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCM0BKBE",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11vxmhqf65"],"醬油拉麵",2,null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3YcHCM8BKAA"],[["M:/g/11vxmhgkk3"],"雞白湯拉麵",2,null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3YcHCNABKAE"]],[1]],null,"建議的餐點",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCM4BKBI",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_PLENTY_OF_PARKING"],"很多停車位",2,null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3YcHCNIBKAA"]],1],null,null,"停車位",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCNEBKBM",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_LOT"],"付費停車位",2,null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3YcHCNQBKAA"]]],null,"附近的停車場",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCNMBKBQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCNUBKBU",null,null,["同一條巷子就有一個露天停車場，平日1小時40元，假日1小時50元，走路只需要3分鐘。"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3YcHCNcBKAA"]]],null,null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCNYBKBY",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["整個像在日本魚市場內吃飯，有不少海鮮模型可以拍照，店內音樂也是播放不斷的叫賣聲，長桌桌上還鋪著藍色防水塑膠袋，趣味感十足。\n\n店內主廚似乎是日本人，坐吧檯一直聽到日文，當然也有台灣人，廚房人手不少，上菜時間算快。雞白湯拉麵最受歡迎，可以單點也可以直接選套餐，套餐含小菜四選一、加料五選一、飲料二選一。口味屬於清淡，是湯可以喝的拉麵。\n\n店內座位不算多，需先在門口機台點餐，再等候入座。同一條巷子就有一個露天停車場，平日1小時40元，假日1小時50元，走路只需要3分鐘，附近停車算方便。",null,[0,61]]]],[null,1719708205000