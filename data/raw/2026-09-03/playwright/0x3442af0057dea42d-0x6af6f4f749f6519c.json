G_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3YcHCLUCKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCLQCKAc",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3YcHCLcCKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCLYCKAg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCLgCKAk",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCLkCKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCLoCKAs",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["適合想體驗氣氛的朋友或是情侶。\n店面從外觀看起來是關門的，窗戶看起去也是一個人也沒有，實際上是有營業的哦～\n\n餐點的部分\n1. 日本味，偏重口，但是味道不錯\n2. 雞白湯很濃郁，好喝也好吃，上面有魚卵，結合湯味道超棒。\n3. 溏心蛋煮的很熟\n4. 份量是真的很少\n5. 煎餃脂肪豐富\n\n建議要有心理建設，當作到日本吃拉麵，不然你會覺得心有點痛，畢竟老闆說花了600萬裝潢，老闆也是日本人，薪水一定也是比較高，店家總是需要回本和賺錢，所以貴了些可以理解。\n我邊吃邊算了一下… 營運狀況是真的危險…\n\n如果荷包有點吃緊的或是食量較大，建議還是排旁邊的隱家。\n但是想要幫助他們或是想要體驗氣氛的，值得試一次！\n\nP.S 可刷卡，也能刷美國運通，也有開發票。\n\n我知道老闆會在下面說謝謝，嗯～不客氣^^",null,[0,53]]]],[null,1719708289000000,1719708289000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04RDJhOEpwUUptZ0txQkFBRGhlQQ%7CCAEQrcz1_gkiLwoZQ0hfQm04RDJhOEpwUUptZ0txQkFBRGhlQRoSQ2dzSWdkV0N0QVlRZzU3R0Z3\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q_2MIuwIoDA"],"https://business.google.com/local/business/1866122680876020594/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTk1hSE0zZHpkM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/1866122680876020594/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTk1hSE0zZHpkM1JSQUIQAA%3D%3D"],"h