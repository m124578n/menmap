KWAxWXYfUHHbMCLo4Q3IcHCKcBKDU",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCKkBKDY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCKoBKDc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiaj8qpw9KWAxWXYfUHHbMCLo4Q3IcHCKsBKDg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["藤哲商行真的一秒到日本。\n\n這家的麵真的好好吃，麵體是日本師傅在台灣請麵粉廠特製的麵體，這麵彈性嚼勁是我近期吃到最好吃的拉麵，細緻的麵體吸飽湯汁，浸泡在湯頭中卻毫不軟爛，咬起來非常Q彈且有嚼勁，將麵條單獨撈出後彈性更好了，配上店家特製的辣油那真的立馬變化口味，不得不說店家在佐料上用了很大的心力，這辣油開蓋後一公尺都可聞到那辣椒香氣，這辣味是飽滿的乾辣椒香，那是種會勾人的香味，真香真好吃。\n\n河豚的湯頭看似清澈，入口卻是滿滿的層次，這湯頭喝的到魚的鮮味與厚度，而且他的變化非常多，原味已經非常棒了，加上蔥花後又更上一層樓，魚湯的鮮味加上青蔥的甜香，真的是一口入魂，河豚肉質細緻但非常Q彈，他的嚼感彈中帶點脆度，有那種吃盲鰻的那種口感，十分的對我口味，對了這碗河豚拉麵每日限量30碗而已歐。\n\n本想說河豚湯頭加上辣油應該不會太搭，結果完全出乎我意料之外的合拍，這辣椒油加入湯頭後入口先浮現的是花椒的香氣，但我剛單吃辣椒時並沒有花椒味啊，甚至拿炸雞來沾辣油也是辣香十足但真的沒有花椒香啊，結果魚湯加辣椒居然先浮現出花椒香氣，辣味不重反而是湯頭香氣提升數倍，真不知道是湯頭厲害還是辣椒有特色啊。\n\n附餐的炸雞中規中矩，外酥內嫩的雞肉搭配美乃滋還不錯吃，但我推薦沾上特製辣椒油，那真的是一個舒服啊，我都懷疑店家其實主打辣椒油。\n這家拉麵非常有水準，可惜我是豬身小鳥胃沒法一次吃太多，下次一定要再來吃雞白湯拉麵，但我相信之後這家肯定是芝山站附近的排隊名店啊。\n\n藤哲商行\n台北市士林區福華路128巷4號\n\n#台北市 #士林區\n#餐廳 #拉麵 #藤哲商行",null,[0,12]]]],[null,null,null,null,null,"https://business.google.com/local/business/1866122680876020594/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTlVlVFJET0RKblJSQUIQAA%3D%3D",[null,null,null,"/local/business/1866122680876020594/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTlVlVFJET0RKblJSQUIQAA%3D%3D"],"https://business.google.com/local/business/1866122680876020594/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTlVlVFJET0RKblJSQUIQAA%3D%3D",[null,null,null,"/local/business/1866122680876020594/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTlVlVFJET0RKblJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/1866122680876020594/customers/reviews/reply?p\u0