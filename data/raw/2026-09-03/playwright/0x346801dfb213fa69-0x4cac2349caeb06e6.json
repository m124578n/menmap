27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x4cac2349caeb06e6"]],1,null,null,null,null,null,null,["0","5524829642720741094"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pSbk0yOWhNMVowVTFnNE5ubHBiVFZGZUdGdmEzYxAB"]],"CIABIhD4J3D6bK0AHdHLVKIGDxJ1",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["中和\u003e永和\u003e木柵，一路吃了15年吧...\n（附上中和店的菜單，代表沒豪洨）\n\n評價基本就參考永和店那樣\n反正就是吃到老闆都認識了\n基本上都點鮮菇拉麵（以前叫野菇）\n印象中從120吃到現在180\n回顧一下物價還真是了不起...\n\n個人覺得野菇拉麵有種魔力\n即使沒有放叉燒，讓我願意買單\n\n湯頭\n比起以前有點偏淡（但味道一致）\n喝起來有層次，又不會太鹹\n雖然沒有叉燒肉，但其實瑕不掩瑜\n\n麵條\n台式拉麵，麵體偏軟，份量多\n口感有點彈，有集中我的喜好\n和日式拉麵吃起來口感不同\n做硬麵可能會變不好吃...（？\n\n私心給5星（只給野菇拉麵和炸雞）\n叉燒飯沒有美乃滋有點不習慣\n其他口味我就不特別推薦\n因為我吃過一輪還是喜歡野菇...\n\n如果遇到吃不慣，又很要求的客人\n大概就和目前評價差不多\n整體真實評價大概是4星上下吧...\n\n現場只收現金，搭車稍有不便\n附近還算好停車，但建議騎機車",null,[0,37]]]],[],[null,null,2927,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pSbk0yOWhNMVowVTFnNE5ubHBiVFZGZUdGdmEzYxAB!2m1!1s0x0:0x4cac2349caeb06e6!3m1!1s2@1:CAIQACodChtycF9oOjRnM29hM1Z0U1g4NnlpbTVFeGFva3c%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pSbk0yOWhNMVowVTFnNE5ubHBiVFZGZUdGdmEzYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pSbk0yOWhNMVowVTFnNE5ubHBiVFZGZUdGdmEzYxI-Ci9DQUlRQUNvZENodHljRjlvT2pSbk0yOWhNMVowVTFnNE5ubHBiVFZGZUdGdmEzYxILMGRVbDRVX3BtZ04aPgovQ0FJUUFDb2RDaHR5Y0Y5b09qUm5NMjloTTFaMFUxZzRObmxwYlRWRmVHRnZhM2MSCzBkVWw0VV9wbWdOIhIJAAAAAAAAAAAR5gbrykkjrEwqCzBkVWw0VV9wbWdO\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi5uJXHxNKWAxUQoK8BHVJuDzoQoykIuAEoBg"],null,[null,[[1,0]]]],"0ahUKEwiN95vHxNKWAxXwd14EHWrGL5MQ0pMFCGQoBA"],null,null,null,"0ahUKEwi5uJXHxNKWAxUQoK8BHVJuDzoQ0pMFCKwBKAQ"],[["Ci9DQUlRQUNvZENodHljRjlvT2xWZk5WQkpOVTVLYlRBeWVVeEZkRXhTWmw5NGJYYxAB",["0x0:0x4cac2349caeb06e6",null,1768696106052767,1768971451366433,[null,null,["https://www.google.com/maps/contrib/118399325629969118575/reviews?hl\u003dzh-