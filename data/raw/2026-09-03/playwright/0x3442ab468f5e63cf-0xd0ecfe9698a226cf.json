KABKAY",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3IcHCKEBKAc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3IcHCKIBKAg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3YcHCKQBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3IcHCKMBKAk",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["🍜 尋覓一碗心靈與味蕾的雙重慰藉\n走進「博多幸龍總本店」，原本因日常奔波而稍微緊湊的步調，瞬間被店裡輕鬆且自在的氣氛給溫柔地接住了。沒有過度刻板的拘謹，工作人員親切的招呼讓人感到格外安心與放鬆，是一個無論是獨自前來、還是與重要的人一起，都能舒適享受美食的空間。\n這次點了期間限定～2026/7/15的「煮干蛤仔清雞湯拉麵」。\n湯頭一入口，先是煮干（小魚乾）特有的淡淡鮮香在舌尖散開，緊接著迎來的是蛤仔的清甜與清雞湯的醇厚。兩者調和得恰到好處，完全沒有厚重的負擔感，反而多了一種清澈的層次，溫潤而優雅。每一口湯、每一根完美吸附湯汁的麵條，都讓人感受到店家對食材的用心，食物美味得令人微笑。\n這不僅是一碗拉麵，更是一份能在日常裡撫慰身心的美好滋味。不論是想犒賞自己，還是尋找一處能安心落腳的美味角落，這裡都非常值得再次拜訪。",null,[0,130]]]],[null,1784094047000000,1784094047000000,"1 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfNFNLZk9MQjVhOFEyUGhjRlhSTjFhUQ%7CCAEQrcz1_gkiMAoZQ0hfNFNLZk9MQjVhOFEyUGhjRlhSTjFhURoTQ2d3STM3cmMwZ1lROXZ6TnBBTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ_2MIpQEoCg"],"https://business.google.com/local/business/9384360638507443649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVzVTJOWWF6TmhlbWN5VVZoRmVXVkhOVFZSTTNCMVkyMTRSazVWUlJBQhAA",[null,null,null,"/local/business/9384360638507443649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVzVTJOWWF6TmhlbWN5VVZoRmVXVkhOVFZSTTNCMVkyMTRSazVWUlJBQhAA"],"https://business.google.com/local/business/9384360638507443649/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVzVTJOWWF6TmhlbWN5VVZoRmVXVkhOVFZSTTNCMVkyMTRSazVWUlJBQhAA",[null,null,null,"/local/business/9384360638507443649/c