l,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3YcHCOkBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3IcHCOgBKAk",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3IcHCOoBKAo",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3IcHCOsBKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3IcHCOwBKAw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[null,[1]],null,"建議的餐點",null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3IcHCO0BKA0",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3YcHCO8BKAA"]],1],null,null,"等待時間",null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ3IcHCO4BKA4",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["第一次來，店員幫忙點餐，吃完結帳。\n\n點了醬油豚骨，麵的硬度、湯的鹽度、蔥跟豆芽菜都可以自選。其他店吃正常鹽度的我，這家店點正常結果感覺有點鹹喝不太完，第一次吃的人可以先選淡味。另外加點炸雞(2顆)跟餃子(5顆)，各70元覺得小貴，炸雞是現炸好就上桌，夠燙肉汁會噴要小心、沾的辣椒粉有個沒嚐過的辣味，不確定是花椒還是什麼，覺得蠻特別可以試著沾看看；餃子比日本吃到的好吃多了！店內座位附了很多沾料，但因為湯口味有點重就沒外加。店員很友善，結帳的時候會小聊一下。建議平常口味吃重一點的人去試試。",null,[0,17]]]],[null,1768791382000000,1768791382000000,"7 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfR0VJYkFQY25aM0lLazJwenNZS0lNUQ%7CCAEQrcz1_gkiMAoZQ0hfR0VJYkFQY25aM0lLazJwenNZS0lNURoTQ2d3STFycTJ5d1lRa2RHczFnTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ_2MI8AEoDw"],"https://business.google.com/local/business/9384360638507443649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh2TTFSRlVsQlJWMk41VFROd1NGbHRVbmxpYWxwM1dsWnJkMlF4UlJBQhAA",[null,null,null,"/local/business/9384360638507443649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh2TTFSRlVsQlJWMk41VFROd1NGbHRVbmxpYWxwM1dsWnJkMlF4UlJBQhAA"],"https://business.google.com/local/business/9384360638507443649/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh2TTFSRlVsQlJWMk41VFROd1NGbHRVbmxpYWxwM1dsWnJkMlF4UlJBQhAA",[null,null,null,"/local/business/9384360638507443649/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh2TTFSRlVsQlJWMk41VFROd1NGbHRVbmxpYWxwM1dsWnJkMlF4UlJBQhAA"],null,"https://business.google.com/local/business/9384360638507443649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh2TTFSRlVsQlJWMk41VFROd1NGbHRVbmxpYWxwM1dsWnJkMlF4UlJBQhAA",[null,null,null,"/local/business/9384360638507443649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh2TTFSRlVsQlJWMk41VFROd1NGbHRVbmxpYWxwM1dsWnJkMlF4UlJBQhAA"],null,["zh-Hant"],[["非常感謝您這麼詳細的分享！您把醬油豚骨拉麵的客製化選項（麵硬度、湯鹹度、蔥與豆芽）描述得很清楚，也提醒第一次嘗試的人可以先選淡味，這樣的建議非常實用。炸雞現炸上桌、肉汁燙口的細節讓人感覺到臨場感，搭配特別的辣椒粉更添趣味；餃子比在日本吃到的還好吃，這樣的評價對我們是很大的鼓勵。雖然您覺得價格稍高，但能感受到您仍覺得值得一試。最後提到店員友善、結帳時的小聊，更讓整體體驗多了溫度。",null,[0,190]]]],[null,null,20584,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xvM1RFUlBRV2N5TTNwSFltUnlialp3WlZrd2QxRRAB!2m1!1s0x0:0xd0ecfe9698a226cf!3m1!1s2@1:CAIQACodChtycF9oOlo3TERPQWcyM3pHYmRybjZwZVkwd1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xvM1RFUlBRV2N5TTNwSFltUnlialp3WlZrd2QxRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xvM1RFUlBRV2N5TTNwSFltUnlialp3WlZrd2QxRRI-Ci9DQUlRQUNvZENodHljRjlvT2xvM1RFUlBRV2N5TTNwSFltUnlialp3WlZrd2QxRRILMGRRSFFNak1jQW0aPgovQ0FJUUFDb2RDaHR5Y0Y5b09sbzNURVJQUVdjeU0zcEhZbVJ5Ympad1pWa3dkMUUSCzBkUUhRTWpNY0FtIhIJAAAAAAAAAAARzyaimJb-7NAqCzBkUUhRTWpNY0Ft\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQoykI8QEoEA"],null,[null,[[1,0]