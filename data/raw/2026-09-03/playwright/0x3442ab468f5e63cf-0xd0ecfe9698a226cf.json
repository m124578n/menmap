null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,2,14,6,null,null,null,null,["6 個月前"]]],["//www.google.com/local/imagery/report/?cb_client\u003dmaps_sv.tactile\u0026image_key\u003d!1e10!2sCIABIhDPJGt3oShpD1elvfuzoHBJ\u0026fid\u003d0x0:0xd0ecfe9698a226cf"]],1,null,null,null,null,null,null,["0","-3392056496557513009"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xOcFJITkNhVW96WjBZM09GZDJjMlI1YjNkVFZWRRAB"]],"CIABIhDPJGt3oShpD1elvfuzoHBJ",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["醬油豚骨拉麵（大）\n\n外觀：\n擺盤很吸睛，比臉還大的海苔直接遮住半邊碗，配上鋪滿碗面的大片薄切肉片和一顆糖心蛋，光看這視覺張力就覺得很有誠意。\n\u200b味道精華：\n\u200b湯頭與麵體：湯頭屬於口感輕盈但口味重的類型，搭配表現不錯的麵體非常順口，超硬麵處理得不錯。加進辣醬後，味道層次感提升，蠻好吃的。\n\u200b肉品：肉是切成薄片狀，雖然味道表現普通，但口感處理得恰到好處。\n\u200b小吃：餃子超級好吃，大概是近期吃過最讚的日式餃子！炸雞做成圓形的造型很酷，味道也蠻好的。\n\u200b小扣分：唯一比較可惜的是豆芽菜，吃起來不像炒過的，少了點鍋氣和油香。\n\n對了這間價格非常親民 太不可思議了 衝著這點五星好評",null,[0,14]]]],[null,1771214947000000,1771214947000000,"6 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfZU9uajNOa1QybFVuR0F4VHZqQm9lQQ%7CCAEQrcz1_gkiMAoZQ0hfZU9uajNOa1QybFVuR0F4VHZqQm9lQRoTQ2d3STQ3REt6QVlRc19EWGl3SQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjKmrjk4tGWAxXxdfUHHULjAYAQ_2MIXCgF"],"https://business.google.com/local/business/9384360638507443649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPY0ZKSVRrTmhWVzk2V2pCWk0wOUdaREpqTWxJMVlqTmtWRlpXUlJBQhAA",[null,null,null,"/local/business/9384360638507443649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPY0ZKSVRrTmhWVzk2V2pCWk0wOUdaREpqTWxJMVlqTmtWRlpXUlJBQhAA"],"https://business.google.com/local/business/9384360638507443649/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPY0ZKSVRrTmhWVzk2V2pCWk0wOUdaREpqTWxJMVlqTmtWRlpXUlJBQhAA",[null,null,null,"/local/business/9384360638507443649/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPY0Z