,null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjtndPavdKWAxVNcfUHHY_1BbUQ3YcHCHAoAA"]],1],null,null,"等待時間",null,"0ahUKEwjtndPavdKWAxVNcfUHHY_1BbUQ3IcHCG8oFA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["第一眼注意到「力量拉麵」，不是因為香味，而是門口那個充滿氣勢的拳頭招牌👊經過好幾次都已經吃飽，只能默默記在口袋名單，今天中午終於如願走進店裡😌店內空間不大，採日式吧檯與面壁座位設計，環境乾淨簡約，一開始只有零星幾位客人，不到一會兒便陸續客滿，可見頗受附近上班族與拉麵愛好者青睞。點餐方式也相當貼心，除了選擇拉麵口味，還能依喜好調整湯頭鹹淡、麵條軟硬、份量及是否加蔥花，客製化程度很高👍\n我點的是「特製醬油拉麵」，端上桌時就讓人食指大動。一整顆溏心蛋咬開金黃誘人，搭配豬肉叉燒與舒肥雞肉叉燒，肉質各有特色，前者油香濃郁、後者軟嫩多汁。醬油湯頭層次鮮明，鹹香中帶有甘甜，與偏硬口感的細麵十分合拍，每一口都能牢牢吸附湯汁，越吃越順口。整碗份量十足，吃完相當有飽足感，也讓我明白這間低調小店，為何能在拉麵迷之間累積不少好口碑🥰",null,[0,192]]]],[null,null,null,null,null,"https://business.google.com/local/business/15899995124172379402/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVV4WVRtRk1XRXBxVjFSR2JGUlhjRVpqYW1jMFlsVlZNbUZHUlJBQhAA",[null,null,null,"/local/business/15899995124172379402/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVV4WVRtRk1XRXBxVjFSR2JGUlhjRVpqYW1jMFlsVlZNbUZHUlJBQhAA"],"https://business.google.com/local/business/15899995124172379402/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVV4WVRtRk1XRXBxVjFSR2JGUlhjRVpqYW1jMFlsVlZNbUZHUlJBQhAA",[null,null,null,"/local/business/15899995124172379402/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVV4WVRtRk1XRXBxVjFSR2JGUlhjRVpqYW1jMFlsVlZNbUZHUlJBQhAA"],null,"https://business.google.com/local/business/15899995124172379402/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVV4WVRtRk1XRXBxVjFSR2JGUlhjRVpqYW1jMFlsVlZNbUZHUlJBQhAA",[null,null,null,"/local/business/15899995124172379402/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHWVV4WVRtRk1XRXBxVjFSR2JGUlhjRVpqYW1jMFlsVlZNbUZHUlJBQhAA"]],[null,null,441,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21G