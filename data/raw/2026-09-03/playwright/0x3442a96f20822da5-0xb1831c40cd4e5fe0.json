ull,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["731雞白湯，另外還單點了厚切叉燒和辣油，麵本身非常非常非常非常油膩，原配置的雞叉燒片十分普通，蛋也是，平平無奇當中的平平無奇，豬叉燒甚至給我未完成的感覺，肥肉部分是脆的，尖叫，有點噁心，組在一起整碗大概就是40-50分的水準，不太可能會再訪。\n\n後兩者單點的倒是好吃，厚切叉燒體量很大但有燉透，跟麵裡原配置的叉燒完全是天壤之別，辣醬有點鹹甜口，又香又麻，真的很讚，據說之前這兩個都是內含的，可能店家也知道這兩個是招牌，所以拉出來單點菜單可以多賺我100多塊吧。",null,[0,122]]]],[null,null,null,null,null,"https://business.google.com/local/business/9018888481136732138/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrTkU5WFpFVlZNSFJyVFVkSk1sVkVSbGRqYlhCRFRWWlNTbVZZWXhBQhAA",[null,null,null,"/local/business/9018888481136732138/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrTkU5WFpFVlZNSFJyVFVkSk1sVkVSbGRqYlhCRFRWWlNTbVZZWXhBQhAA"],"https://business.google.com/local/business/9018888481136732138/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrTkU5WFpFVlZNSFJyVFVkSk1sVkVSbGRqYlhCRFRWWlNTbVZZWXhBQhAA",[null,null,null,"/local/business/9018888481136732138/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrTkU5WFpFVlZNSFJyVFVkSk1sVkVSbGRqYlhCRFRWWlNTbVZZWXhBQhAA"],null,"https://business.google.com/local/business/9018888481136732138/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrTkU5WFpFVlZNSFJyVFVkSk1sVkVSbGRqYlhCRFRWWlNTbVZZWXhBQhAA",[null,null,null,"/local/business/9018888481136732138/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrTkU5WFpFVlZNSFJyVFVkSk1sVkVSbGRqYlhCRFRWWlNTbVZZWXhBQhAA"]],[null,null,3933,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pkNE9XZEVVMHRrTUdJMlVERldjbXBDTVZSSmVYYxAB!2m1!1s0x0:0xb1831c40cd4e5fe0!3m1!1s2@1:CAIQACodChtycF9oOjd4OWdEU0tkMGI2UDFWcmpCMVRJeXc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2pkNE9XZEVVMHRrTUdJMlVERldjbXBDTVZSSmVYYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2pkNE9XZEVVMHRrTUdJMlVERldjbXBDTVZSSmVYYxI-Ci9DQUlRQUNvZ