null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwilpY7tutKWAxXWla8BHakHEckQ3YcHCFQoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwilpY7tutKWAxXWla8BHakHEckQ3IcHCFMoBQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwilpY7tutKWAxXWla8BHakHEckQ3IcHCFUoBg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwilpY7tutKWAxXWla8BHakHEckQ3IcHCFYoBw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwilpY7tutKWAxXWla8BHakHEckQ3IcHCFcoCA",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["2/3中午特地來用餐，聽說評價很好、蠻有名的店，但實際到現場才發現沒有串串，覺得有點可惜，串串要晚上才有。拉麵的選項也偏少，選擇不算多。\n\n我點了白湯拉麵，麵條選粗麵，另外加了細麵，還點了炸雞。\n老實說一開始吃粗麵時覺得有點失望，麵體偏厚實但吸附湯汁的感覺不明顯，單吃會覺得味道比較淡，差點以為踩雷。後來換吃細麵後，發現細麵比較容易吸附湯頭，整體味道明顯許多，也比較順口。\n\n湯頭本身算濃郁，但不會過鹹，屬於耐喝型，不會有負擔感，這點還不錯。\n\n炸雞部分就比較不推薦，外皮酥脆度普通，吃起來有一點雞腥味，整體表現一般。不過份量給得算多，CP值還可以。\n\n整體來說，如果是為了串串來可能會有落差，但白湯拉麵搭配細麵會比較合適。",null,[0,97]]]],[null,null,null,null,null,"https://business.google.com/local/business/9018888481136732138/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZUUxcmRFcFhiVFZEWWxoTmRGcFdTWGRXUm14TVdERTRNR0pzUlJBQhAA",[null,null,null,"/local/business/9018888481136732138/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZUUxcmRFcFhiVFZEWWxoTmRGcFdTWGRXUm14TVdERTRNR0pzUlJBQhAA"],"https://business.google.com/local/business/9018888481136732138/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZUUxcmRFcFhiVFZEWWxoTmRGcFdTWGRXUm14TVdERTRNR0pzUlJBQhAA",[null,null,null,"/local/business/9018888481136732138/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvZUUxcmRFcFhiVFZEWWxoTmRGcFdTWGRXUm14TVdERTRNR0pzUlJBQhAA"],null,"https://business.google.com/local/business/9018888481136732138/customers/reviews/reply?p\u003dCkRDaTlEUV