report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfZWY1TkthU1JGbjJ1MWJkbU5qbUNPdw%7CCAEQrcz1_gkiLwoZQ0hfZWY1TkthU1JGbjJ1MWJkbU5qbUNPdxoSQ2dzSWhxSHp6Z1lRazZyZmZ3\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjHoLr9xdKWAxWKma8BHRZuLF8Q_2MIaCgL"],"https://business.google.com/local/business/10241835355923173233/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUmswd1VrUmFNbFpaVDBoc1FrNVVaRXBoTUZwRlVtcEdhR0p1WXhBQhAA",[null,null,null,"/local/business/10241835355923173233/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUmswd1VrUmFNbFpaVDBoc1FrNVVaRXBoTUZwRlVtcEdhR0p1WXhBQhAA"],"https://business.google.com/local/business/10241835355923173233/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUmswd1VrUmFNbFpaVDBoc1FrNVVaRXBoTUZwRlVtcEdhR0p1WXhBQhAA",[null,null,null,"/local/business/10241835355923173233/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUmswd1VrUmFNbFpaVDBoc1FrNVVaRXBoTUZwRlVtcEdhR0p1WXhBQhAA"],null,"https://business.google.com/local/business/10241835355923173233/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUmswd1VrUmFNbFpaVDBoc1FrNVVaRXBoTUZwRlVtcEdhR0p1WXhBQhAA",[null,null,null,"/local/business/10241835355923173233/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjEwUmswd1VrUmFNbFpaVDBoc1FrNVVaRXBoTUZwRlVtcEdhR0p1WXhBQhAA"],null,["zh-Hant"],[["本店無綠豆湯服務喔！！😊",null,[0,12]]]],[null,null,3043,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT210Rk0wUkRaMlZZT0hsQk5UZEphMFpFUmpGaGJuYxAB!2m1!1s0x0:0x1416a8b22162b54d!3m1!1s2@1:CAIQACodChtycF9oOmtFM0RDZ2VYOHlBNTdJa0ZERjFhbnc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT210Rk0wUkRaMlZZT0hsQk5UZEphMFpFUmpGaGJuYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT210Rk0wUkRaMlZZT0hsQk5UZEphMFpFUmpGaGJuYxI-Ci9DQUlRQUNvZENodHljRjlvT210Rk0wUkRaMlZZT0hsQk