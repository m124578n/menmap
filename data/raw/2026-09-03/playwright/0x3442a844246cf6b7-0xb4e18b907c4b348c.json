u003d%E7%84%A1%E4%BA%8C%E4%BA%AD%E9%A3%9F%EF%BC%88%E5%8E%9F%E7%84%A1%E4%BA%8C%E4%BA%AD%E6%8B%89%E9%BA%B5%EF%BC%89\u0026ludocid\u003d13033852249263781004\u0026lpsid\u003dCIHM0ogKEKuFwqvi5O-cmAE\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5W2JoQcr6PuKSbjYMivGCy4","0ahUKEwjnkf-lv9KWAxVPna8BHaKpNlkQ544CCLgCKDs",null,"2026年6月4日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u10769450912268087798/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChI0NzY5NTc0NDQ0MjA0MzQ4MjM%3D","https://business.google.com/mm/posts/l/u10769450912268087798/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChI0NzY5NTc0NDQ0MjA0MzQ4MjM%3D",null,null,null,null,null,["476957444420434823","CIHM0ogKEKuFwqvi5O-cmAE","CgwI0NiD0QYQqPj6rQI"]],[null,[[["今天，是無二亭食「滿月」的日子。✨\n\n承接原本的店面繼續經營，所以一路走來其實背負著不小的壓力。\n\n我們知道，對許多老客人來說，熟悉的味道不能變；同時也希望能讓第一次上門的新客人，願意留下好的印象，甚至再次回來。\n\n這一個月裡，最讓我們感動的，就是收到大家很多溫暖又真誠的回饋——\n\n「味道沒變，而且更好吃了。」\n「這口味真的好好吃喔！」\n「味道調得剛剛好。」\n\n還有許多願意特地在網路上留言鼓勵我們的客人，以及一次又一次回來支持的熟面孔。\n\n真的很謝謝大家。\n每一句鼓勵、每一次再訪，對我們來說都是很大的力量。\n\n接下來的日子，我們也會繼續更努力，把每一道料理、每一次服務，都做到更好。\n\n希望未來的每一天，無二亭食都能成為大家想再回來吃一碗熱騰騰料理的地方。🍜✨",1]]],[1779441772,1795252972],null,null,[["https://lh3.googleusercontent.com/geougc/AF1QipPL01uZ_tdg7RTQ5avMGqaM5T_U-nijcZWy6hFL\u003dh400-no",1,null,"","AF1QipPL01uZ_tdg7RTQ5avMGqaM5T_U-nijcZWy6hFL"]],"3285854166946663368","10769450912268087798",["https://www.google.com/search?sca_esv\u003dd777865217e22ae8\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003d%E7%84%A1%E4%BA%8C%E4%BA%AD%E9%A3%9F%EF%BC%88%E5%8E%9F%E7%84%A1%E4%BA%8C%E4%BA%AD%E6%8B%89%E9%BA%B5%EF%BC%89\u0026ludocid\u003d13033852249263781004\u0026lpsid\u003dCIHM0ogKEMqZ1NSL9Oy4vwE\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEMqZ1NSL9Oy4vwE,ar","/gmb/local_post/accounts%2F-%2Flocations%2F10769450912268087798%2FlocalPosts%2F3285854166946663368/version/1779441771734000","https://www.google.com/local/content/rap/report?postId\u003dCMiX36TK3uzMLRIXQ0lITTBvZ0tFTXFaMU5TTDlPeTR2d0U