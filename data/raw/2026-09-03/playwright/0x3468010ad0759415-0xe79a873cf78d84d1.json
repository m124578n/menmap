www.google.com/maps/contrib/109760109229702714885?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVHU2INGCWQ02IUZe42DY4cCNSuoquIJgvvEIs8ArjG8R_z0t56\u003ds120-c-rp-mo-ba12-br100",null,null,"109760109229702714885"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2022,4,27,16,null,null,null,null,["4 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIC2o6_KCA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xe79a873cf78d84d1"]],1,null,null,null,null,null,null,["0","-1757944008613722927"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUMybzdlWW5nRRAB"]],"CIHM0ogKEICAgIC2o6_KCA",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["4/27傍晚紀錄，午後雷陣雨一路下到了四五點，原本預定來試看看雞白濃湯拉麵，但被淋一身雨而改變計畫。\n店面位置在熱鬧的光明街內，沒有太明顯的立式招牌，所以騎車開車很容易錯過，但店門口是有特色的街邊拉麵攤感覺，店內座位不多，但不會太過擁擠。\n服務人員十分親切熱情，店內許多餐具以及調味要自行拿取，店內裝飾讓人感覺出用心經營的感覺。\n嘗試的是黑蒜拉麵，拉麵乘上有滿滿的配料以及厚實大片的叉燒，視覺上有豐富感，叉燒肉感在吸飽湯頭後有不錯的味覺口感享受。\n可惜湯頭味道不夠渾厚濃厚，沒有蒜味的香味表現，湯味也較為清淡，但是沒有許多拉麵店太過死鹹的味道。\n麵條的選擇上是固定的，但是跟湯頭搭配非常有味且很有彈性。\n整碗麵在230左右的價位上也是很有飽足感的。\n有機會再來嘗試其他口味的拉麵。",null,[0,164]]]],[null,null,null,null,null,"https://business.google.com/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXliemRsV1c1blJSQUIQAA%3D%3D",[null,null,null,"/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXliemRsV1c1blJSQUIQAA%3D%3D"],"https://business.google.com/local/business/15861239741813641236/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXliemRsV1c1blJSQUIQAA%3D%3D",[null,null,null,"/local/business/15861239741813641236/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXliemRsV1c1blJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTXliemRsV1c1blJSQUIQAA%3D%3D",[null,null,