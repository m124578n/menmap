DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3YcHCIABKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCH8oCg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCIEBKAs",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCIIBKAw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCIMBKA0",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["🧾 點餐方式：畫單後直接給老闆\n\n✔店內位置不多，有兩張兩人位的桌位，以及吧台座位，店面為老闆一人經營，不過上菜速度不會太慢，拉麵份量也還可以。店內雖然小小的，有一些可愛的小裝飾增加一些氣氛，整體來說算是比較家常的拉麵店，如果住在附近會願意常來光臨\n\n✔ 塩味拉麵（139$）：叉燒為雞肉，吃起來清爽，不會有很油膩的感覺\n\n✔正油拉麵+豪華（209$）：比一般款多了幾塊一樣是雞肉的叉燒，還有一顆溏心蛋，比一般款加價70$價格還算可以，正油拉麵為醬油拉麵，口味一樣不會太重\n\n💰支付方式：現金、街口支付，無發票",null,[0,15]]]],[null,null,null,null,null,"https://business.google.com/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkVjblJVTVVsbkVBRRAA",[null,null,null,"/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkVjblJVTVVsbkVBRRAA"],"https://business.google.com/local/business/15861239741813641236/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkVjblJVTVVsbkVBRRAA",[null,null,null,"/local/business/15861239741813641236/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkVjblJVTVVsbkVBRRAA"],null,"https://business.google.com/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkVjblJVTVVsbkVBRRAA",[null,null,null,"/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUkVjblJVTVVsbkVBRRAA"]],[null,null,5209,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m