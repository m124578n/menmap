_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3YcHCMEBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCMABKAk",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCMIBKAo",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCMMBKAs",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCMQBKAw",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["第一次來吃，試試看塩味拉麵\n麵條是我自己比較偏好的極細麵條，麵條的軟硬度應該是可以調整，但是需要提前告知或是點餐時跟店員告知（因為我在點完餐一下後才問的已經有點來不及了）\n麵湯的部份感覺是熬出來的，點的是塩味拉麵湯喝起來會有胡椒的辣，跟麵條搭起來剛好也不會蓋過麵條本身的味道，喝起來不會太淡或太鹹\n配料的部份覺得比較可惜，筍片的部分覺得味道不夠重，雞叉燒味道比較淡所以建議可以先跟麵一起吃比較後面吃的話可能會覺得沒味道，蔥花給的量還蠻多的\n正油拉麵：味道偏淡一些，感覺比較適合口味沒很重的人，雞叉燒蠻大塊\n有機會再來試試其他口味的拉麵",null,[0,148]]]],[null,null,null,null,null,"https://business.google.com/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmliVXhZYTBkbkVBRRAA",[null,null,null,"/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmliVXhZYTBkbkVBRRAA"],"https://business.google.com/local/business/15861239741813641236/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmliVXhZYTBkbkVBRRAA",[null,null,null,"/local/business/15861239741813641236/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmliVXhZYTBkbkVBRRAA"],null,"https://business.google.com/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmliVXhZYTBkbkVBRRAA",[null,null,null,"/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTmliVXhZYTBkbkVBRRAA"]],[null,null,3697,["https://www.google.com/maps/reviews/data\u003d!4m8!14