NNER"],"晚餐",2,null,null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3YcHCKYBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCKUBKBA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3YcHCKgBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCKcBKBE",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCKkBKBI",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCKoBKBM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCKsBKBQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[null,[1]],null,"建議的餐點",null,"0ahUKEwjvl6LeytKWAxWVk68BHUVBLa8Q3IcHCKwBKBU",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["在生活範圍圈裡臨近碧潭的新店光明街商圈，是日式拉麵！\n這家店感覺有趣、店長應該是扭蛋愛好者，不只是日本風格的陳設，而是牆面上的裝飾、裡面有幾位武將(大名)的頭盔喔！\n店家座席分為吧檯區與內用桌，快速瞄一下大約12~15個座位、室內空間算寬闊卻只放兩張，應該是想要給室內用餐者有較舒適的用餐空間，加上看到外帶與叫熊貓外送來來去去~所以這空間也方便取餐。\n這天食用的是「松露拉麵」與「黑蒜拉麵(豪華版)」，幸花拉麵的湯頭屬於比較接近台灣人習慣的鹹度，所以怕傳統日式拉麵偏鹹的人完全無須擔心，這適當鹹度讓台灣熊整碗湯喝到見底沒問題 ^_^ 。尤其個人喜歡松露的香氣、在呈現淡淡奶香的雞白湯搭配下完全不搶戲~很搭、特別提一下~幸花松露拉麵裡的舒肥雞胸肉真的是份量十足。熊家女王很滿意黑蒜拉麵的湯頭、豪華版追加糖心蛋與三片叉燒肉，完食很自然的飽足感滿滿！\n幸花雞白湯拉麵 (新北光明店)的環境OK、湯頭麵體配料OK~價格不貴可接受，覺得來到新店區與碧潭周邊的人可以來吃吃看喔！✨",null,[0,82]]]],[null,null,null,null,null,"https://business.google.com/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTkthbVF5V1dabkVBRRAA",[null,null,null,"/local/business/15861239741813641236/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTkthbVF5V1dabkVBRRAA"],"https://business.google.com/local/business/15861239741813641236/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTk