ps://lh3.googleusercontent.com/grass-cs/ACvplmN0Vvll619DTLq9eZrdQ3sYbIq8nmyBbJp36h9u5oIggxo2hol2yHK4w9nlFQibyY4l8v64CmTZMeYetm8Afx5kEKbxQMUDEqf0lkUhT572DnxYCB8vnrA1B35B8GfDqkGvfVx-a6wQMoHX\u003dk-no",null,[4624,3468]],null,[[3,121.51531117470175,25.045944075957575],[0,90],[4624,3468],75],"F3WZavrrO_Wm1e8P-4LLqAs","0ahUKEwi609SXwdKWAxV1U_UHHXvBErUQzCcIpQIoAw",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhBFHWf-wKMnLr4gBOMj_715\u0026t\u003d27\u0026cb_client\u003dugc_photo_posts\u0026fid\u003d0x0:0xb5c745da894b3827",null,null,"0ahUKEwi609SXwdKWAxV1U_UHHXvBErUQ-y4IpgIoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhBFHWf-wKMnLr4gBOMj_715"],[10,3,[3468,4624]],[null,null,null,null,null,null,null,["丸亀製麵 新光三越台北站前店 烏龍麵餐廳"]],[null,[[["mu mu"],"https://www.google.com/maps/contrib/115675681630425395358?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVsS5iQfpLz5lSxUlc6zSXK7IYjemCdKDYC-EcFYkqtX6Qt54gmow\u003ds120-c-rp-mo-ba12-br100",null,null,"115675681630425395358"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2025,9,15,10,null,null,null,null,["11 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhBFHWf-wKMnLr4gBOMj_715\u0026t\u003d27\u0026cb_client\u003dugc_photo_posts\u0026fid\u003d0x0:0xb5c745da894b3827"]],1,null,null,null,null,null,null,["0","-5348229227570579417"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHRjRjlvT2pWblh6TnFRVXhRU2xKeU1taHhiMlJGTUhnM1NHYxAB"]],"CIABIhBFHWf-wKMnLr4gBOMj_715",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["是位於百貨公司內的美食街店面，所以內用要自己找位子，比較麻煩的是熱門用餐時段位子不好找，等得很累又有些人沒公德心吃完不會自己收垃圾還要幫他收（超噁），所以下次我不會想要再來這種店型。\n\n點了豆皮烏龍麵，加溏心蛋，另外點了一份炸白身魚，整體滿好吃的，佐料區很大方的提供了青蔥、芝麻、七味粉、薑泥跟蒜泥等可以無限自取，加了滋味變得滿豐富。\n\n我點的這碗是屬於湯烏龍，湯頭喝起來甜甜的算不錯喝，麵條Q彈且量多，也喜歡甜甜的豆皮，口感很厚實，加上溏心蛋吃很讚（不過覺得溏心蛋有點貴！）。\n\n另外炸白身魚也不錯，魚肉有厚度，雖然炸皮看起來有點厚，但起來還OK不會覺得都是在吃炸皮，是好吃的不油膩。",null,[0,91]]]],[null,null,null,null,null,"htt