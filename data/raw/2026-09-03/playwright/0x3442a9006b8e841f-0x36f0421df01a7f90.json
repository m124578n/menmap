06962521990953250?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVqmhm54V3zbqR4ZCJnS8Cz2nV6gPGY4AL7ZBD9XPEZPTpHUlM\u003ds120-c-rp-mo-ba12-br100",null,null,"104006962521990953250"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,2,23,15,null,null,null,null,["6 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhCAoPZU-HZ4UN9Tu4YB2jTA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x36f0421df01a7f90"]],1,null,null,null,null,null,null,["0","3958736768808419216"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pRM1N6YzRjRzVxZURaQmJrTTRXRWRUUTB4d2FsRRAB"]],"CIABIhCAoPZU-HZ4UN9Tu4YB2jTA",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["臺北 捷運中山站 麵屋鶴立\n\n第一次來吃，便嚐個招牌，鶴立雞白湯拉麵！\n\n櫻桃鴨胸、豬梅花和舒肥雞都被滿滿的炸牛蒡絲壓在下面，泡在濃湯中。\n\n麵體選擇偏軟，但依然有嚼勁，是恰好的口感，搭著上頭的炸牛蒡絲的口感很是有趣，炸脆的牛蒡絲帶著滿是濃湯的麵條入口，衝突卻又有趣。\n\n當牛蒡慢慢減少時，坐在吧台才發覺滿是炙燒味和滋滋聲的聽覺，才發現連玉米筍都被燒過。\n\n專心吃麵的過程，肉片逐一入口，都忘記吃到什麼肉，只覺得入口美味，回想我喜歡海鮮勝過叉燒拉麵，是因為肉的腥味總是讓人不敢恭維，但在這碗的任何肉片都沒有異味！\n\n碗邊的柚子胡椒煞氣十足，舀一濃湯，一點柚子胡椒混勻在一湯匙內，配著剩下的麵條，又是一個新世界。\n\n雞白湯也是我少數會點的湯底，還是前者的擔憂，擔心腥味讓人出戲，但這碗的洋蔥清甜，配著白湯，不知不覺連湯都快見碗底，為了腎好，還是剛剛好就好。",null,[0,35]]]],[null,null,null,null,null,"https://business.google.com/local/business/5008846104871522143/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBSTTFONll6UmpSelZ4WlVSYVFtSnJUVFJYUldSVVVUQjRkMkZzUlJBQhAA",[null,null,null,"/local/business/5008846104871522143/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBSTTFONll6UmpSelZ4WlVSYVFtSnJUVFJYUldSVVVUQjRkMkZzUlJBQhAA"],"https://business.google.com/local/business/5008846104871522143/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBSTTFONll6UmpSelZ4WlVSYVFtSnJUVFJYUldSVVVUQjRkMkZzUlJBQhAA",[null,null,null,"/local/business/5008846104871522143/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBSTTFONll6UmpSelZ4WlVSYVFtSnJUVFJYUldSVVV