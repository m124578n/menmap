每碗麵可免費加麵一次",null,[0,44]]]],[null,null,null,null,null,"https://business.google.com/local/business/5008846104871522143/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1V0dSR1RuZFZhMUpMVjBkUmRHRklXbTlpUldjMFVrZEdRMDR4UlJBQhAA",[null,null,null,"/local/business/5008846104871522143/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1V0dSR1RuZFZhMUpMVjBkUmRHRklXbTlpUldjMFVrZEdRMDR4UlJBQhAA"],"https://business.google.com/local/business/5008846104871522143/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1V0dSR1RuZFZhMUpMVjBkUmRHRklXbTlpUldjMFVrZEdRMDR4UlJBQhAA",[null,null,null,"/local/business/5008846104871522143/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1V0dSR1RuZFZhMUpMVjBkUmRHRklXbTlpUldjMFVrZEdRMDR4UlJBQhAA"],null,"https://business.google.com/local/business/5008846104871522143/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1V0dSR1RuZFZhMUpMVjBkUmRHRklXbTlpUldjMFVrZEdRMDR4UlJBQhAA",[null,null,null,"/local/business/5008846104871522143/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjA1V0dSR1RuZFZhMUpMVjBkUmRHRklXbTlpUldjMFVrZEdRMDR4UlJBQhAA"]],[null,null,5512,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT205WGRGTndVa1JLV0dRdGFIWm9iRWc0UkdGQ04xRRAB!2m1!1s0x0:0x36f0421df01a7f90!3m1!1s2@1:CAIQACodChtycF9oOm9XdFNwUkRKWGQtaHZobEg4RGFCN1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT205WGRGTndVa1JLV0dRdGFIWm9iRWc0UkdGQ04xRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT205WGRGTndVa1JLV0dRdGFIWm9iRWc0UkdGQ04xRRI-Ci9DQUlRQUNvZENodHljRjlvT205WGRGTndVa1JLV0dRdGFIWm9iRWc0UkdGQ04xRRILMGR6aWVQLS1NVG0aPgovQ0FJUUFDb2RDaHR5Y0Y5b09tOVhkRk53VWtSS1dHUXRhSFpvYkVnNFJHRkNOMUUSCzBkemllUC0tTVRtIhIJAAAAAAAAAAARkH8a8B1C8DYqCzBkemllUC0tTVRt\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiIhNSMwdKWAxVJg68BHbeAMVwQoykImQEoEQ"]