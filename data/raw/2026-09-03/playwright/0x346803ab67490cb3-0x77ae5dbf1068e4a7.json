E_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwj5rdH8y9KWAxWsUfUHHXrzKHsQ3IcHCFcoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwj5rdH8y9KWAxWsUfUHHXrzKHsQ3YcHCFkoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwj5rdH8y9KWAxWsUfUHHXrzKHsQ3IcHCFgoCw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這陣子連吃了三次 真的是太愛這間店了...\n因為本身是雞白湯的愛好者，所以三次都點了雞豚白湯😅\n濃濃的白湯底帶著香氣十足的煙燻味，配置內的雞腿和大片薄燻味里肌又嫩又香，較常見的舒肥雞胸也處理的很好。\n上方的風乾金針菇帶來不一樣的口感，時蔬及彩椒則適時地提供轉味的功能，讓人能舒服的完食而不致如其他濃湯拉麵有些尾韻會帶著的膩感。\n入口時，配合的虎軒製麵能把這碗拉麵的所有優點扒入口中，可以說這碗拉麵所有材料都各司其職、互相配合的完成了這碗拉麵🍜\n因為本人特愛有美乃滋的叉燒飯，故本店的叉燒飯也是必點項目。\n人家說不太甜的甜點是對甜點最好的稱讚，這家店的布丁🍮(沒拍到😅)也做到了，一口又一口，吃完是意猶未盡，只能感嘆自己的錢包不夠深，不能再來一顆🥲\n友人吃的醬油清湯試喝了兩次也是相當順口不死鹹，但因為本人吃的醬油拉麵不多就不多做評論了🤣\n小小的店只有兩人作業，希望能一直維持這個水準，相信開在中山那種一級戰區也是非常能打，謝謝招待😋",null,[0,99]]]],[null,null,null,null,null,"https://business.google.com/local/business/2418171492475180810/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRyTWxKVmR6VmtlbU4zVlZSc1ZGb3lPVEpaTUdSd1RXdEdWbVZGUlJBQhAA",[null,null,null,"/local/business/2418171492475180810/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRyTWxKVmR6VmtlbU4zVlZSc1ZGb3lPVEpaTUdSd1RXdEdWbVZGUlJBQhAA"],"https://business.google.com/local/business/2418171492475180810/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRyTWxKVmR6VmtlbU4zVlZSc1ZGb3lPVEpaTUdSd1RXdEdWbVZGUlJBQhAA",[null,null,null,"/local/business/2418171492475180810/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRyTWxKVmR6VmtlbU4zVlZSc1ZGb3lPVEpaTUdSd1RXdEdWbVZGUlJBQhAA"],null,"https://business.google.com/local/business/2418171492475180810/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRyTWxKVmR6VmtlbU4zVlZSc1ZGb3lPVEpaTUdSd1RXdEdWbVZGUlJBQhAA",[null,null,null,"/local/business/2418171492475180810/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRyTWxKVmR6VmtlbU4zVlZSc