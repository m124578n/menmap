必點👍",null,[0,44]]]],[null,null,null,null,null,"https://business.google.com/local/business/2904753738490998532/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZNemd6UkRKQlJSQUIQAQ%3D%3D",[null,null,null,"/local/business/2904753738490998532/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZNemd6UkRKQlJSQUIQAQ%3D%3D"],"https://business.google.com/local/business/2904753738490998532/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZNemd6UkRKQlJSQUIQAQ%3D%3D",[null,null,null,"/local/business/2904753738490998532/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZNemd6UkRKQlJSQUIQAQ%3D%3D"],null,"https://business.google.com/local/business/2904753738490998532/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZNemd6UkRKQlJSQUIQAQ%3D%3D",[null,null,null,"/local/business/2904753738490998532/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZNemd6UkRKQlJSQUIQAQ%3D%3D"]],[null,null,null,["https://www.google.com/maps/@/data\u003d!4m7!23m6!1m5!1sChdDSUhNMG9nS0VJQ0FnSUN6MzgzRDJBRRAB!2m1!1s0x0:0xff3e7c5152b3aec2!3m1!1s2@1:CIHM0ogKEICAgICz383D2AE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUN6MzgzRDJBRRAB\u0026t\u003d3\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUN6MzgzRDJBRRItChZDSUhNMG9nS0VJQ0FnSUN6MzgzRE9BEhNDZ3dJM0pDSHN3WVEySmFLbVFFIhIJAAAAAAAAAAARwq6zUlF8Pv8qCzBhTlJXUkk3Y2hO\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjO75fdwNKWAxV_ZfUHHT-kLCsQoykIggIoAw"],null,[null,[[1,1]]]],"0ahUKEwjH26DdwNKWAxW6ncAFHSDkDmAQ0pMFCLUBKAg"],null,null,null,"0ahUKEwjO75fdwNKWAxV_ZfUHHT-kLCsQ0pMFCPwBKAA"],[["ChZDSUhNMG9nS0VJQ0FnSUN6bjRMV2ZnEAE",["0x0:0xff3e7c5152b3aec2",null,1717677772277616,1717677772277616,[null,null,["https://www.google.com/maps/contrib/108912043784843771484/reviews?hl\u003dzh-TW"],null,null,["Mazer Yeh","https://lh3.googleusercontent.com/a-/ALV-UjXTNxk5j5BPTUBTuScgiyYpQqi6jIhrPA6kStObDabUWJk9YiZGPA\u003ds12