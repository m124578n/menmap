https://lh3.googleusercontent.com/gpms-cs-s/AFP8RcP0XoMDodABn6uZO9_51H2DEjbujIH0Pu3H_v2apAX-j5z-R6VmcqZUInFxmCUbMVgkLhKW2fP8DUH3qkRICiTbpwwYUcY_SPUWK4raEKOkDgqi9365yUX-idfslhEzKOufvoxWGQ\u003dm37",1],[22,1280,720,"https://lh3.googleusercontent.com/gpms-cs-s/AFP8RcP0XoMDodABn6uZO9_51H2DEjbujIH0Pu3H_v2apAX-j5z-R6VmcqZUInFxmCUbMVgkLhKW2fP8DUH3qkRICiTbpwwYUcY_SPUWK4raEKOkDgqi9365yUX-idfslhEzKOufvoxWGQ\u003dm22",1],[0,1920,1080,"https://lh3.googleusercontent.com/gpms-cs-s/AFP8RcP0XoMDodABn6uZO9_51H2DEjbujIH0Pu3H_v2apAX-j5z-R6VmcqZUInFxmCUbMVgkLhKW2fP8DUH3qkRICiTbpwwYUcY_SPUWK4raEKOkDgqi9365yUX-idfslhEzKOufvoxWGQ\u003dmm,dash",2],[0,1920,1080,"https://lh3.googleusercontent.com/gpms-cs-s/AFP8RcP0XoMDodABn6uZO9_51H2DEjbujIH0Pu3H_v2apAX-j5z-R6VmcqZUInFxmCUbMVgkLhKW2fP8DUH3qkRICiTbpwwYUcY_SPUWK4raEKOkDgqi9365yUX-idfslhEzKOufvoxWGQ\u003dmm,hls?ibw\u003d750000",3]]],null,null,["0","-54469456760164670"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSURGOHB1TXh3RRAB"]],"CIHM0ogKEICAgIDF8puMpwE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["2023 1104\n16：42 排隊 No 4\n17：26 滿員\n17：46 進場\n18：02 叉燒飯製作\n18：03 完成\n18：03 上麵\n18：15 完食\n濃厚雞白湯拉麵 280\n叉燒飯 70\nNG醣心蛋 20\n二訪完全不同的觀感\n不知道是師傅有調整還是\n第一次吃自己的誤解\n上麵速度有加快\n一碗平均4-5分鐘\n師傅明確提醒提早出叉燒飯\n所以飯麵幾乎同時上\n今天叉燒飯較沒甜味\n反而鹹味略明顯\n肉粒也比較軟爛順口\n清脆的焦糖感這次沒有吃到\n上次不解的可能是洋蔥粒吧\n叉燒肉汁的部分\n可能和湯品口味有關\n上次是醬油清湯\n所以對濃醇的肉汁比較顯著\n這次是濃湯所以湯頭把肉汁蓋過了\n是捲麵條\n不過卻和上次細麵一樣合我胃口\n不會過韌過生 有脆度\n雞汁湯頭油脂感十分醇厚濃郁\n一口一口不自覺會直接喝乾\n不過結束時鮮味會佔住舌頭\n擺盤配菜部分\nNG醣心蛋並不NG\n蔥絲辛辣和芽蔥辛香\n柚子胡椒對我而言有點畫蛇添足\n因為我不想清除他的濃郁湯頭\n\n整體濃郁需要一氣呵成吃完\n拖延遲疑會使溫度下降 稍有負擔\n\n給分84\n\n我還是愛清湯細麵",null,[0,32]]]],[null,1701631482000000,1701631482000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04SDRHQU1ENUJsYk5YNkFBYWs3UQ%7CCAEQrcz1_gkiMAoZQ0hfQm04SDRHQU1ENUJsYk5YNkFBYWs3URoTQ2d3SS1xdXpxd1lRZ3ZMUXp3RQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjO75fdwNKWAxV_ZfUHHT-kLCsQ_2MIrQIoAg"],"https