,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjUreapwdKWAxWfkK8BHdQQFkAQ3IcHCNABKAQ",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["很少都是吧台位的拉麵店還能提供很好的服務，排隊也禁止解壓縮，能感覺到很用心在經營的店家。\n位置間隔也很舒適，不會跟鄰座碰在一起，服務人員充足，店員跟師傅都是年輕的弟弟妹妹，很有朝氣，時不時地招呼、補水，連廁所壞掉都是在點餐時就提醒可以點完先去捷運站的細心，用餐一陣子之後會來問口味合不合，要不要調整等等。\n拉麵的湯頭鹹淡、麵體、軟硬都可以選擇，湯是我個人喜愛的濃稠感，叉燒也沒有豬臭味，跟孩子都很喜歡來。",null,[0,152]]]],[null,null,null,null,null,"https://business.google.com/local/business/12243181635370566383/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTUlZwSWNITk5SazVEWkRBME0xVjZUa3RUYkU1dVdqQldWR0pzUlJBQhAA",[null,null,null,"/local/business/12243181635370566383/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTUlZwSWNITk5SazVEWkRBME0xVjZUa3RUYkU1dVdqQldWR0pzUlJBQhAA"],"https://business.google.com/local/business/12243181635370566383/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTUlZwSWNITk5SazVEWkRBME0xVjZUa3RUYkU1dVdqQldWR0pzUlJBQhAA",[null,null,null,"/local/business/12243181635370566383/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTUlZwSWNITk5SazVEWkRBME0xVjZUa3RUYkU1dVdqQldWR0pzUlJBQhAA"],null,"https://business.google.com/local/business/12243181635370566383/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTUlZwSWNITk5SazVEWkRBME0xVjZUa3RUYkU1dVdqQldWR0pzUlJBQhAA",[null,null,null,"/local/business/12243181635370566383/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTUlZwSWNITk5SazVEWkRBME0xVjZUa3RUYkU1dVdqQldWR0pzUlJBQhAA"]],[null,null,7635,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25SRVpIcHNNRk5DZDA0M1V6TktTbE5uWjBWVGJsRRAB!2m1!1s0x0:0xf569173eb7a06f2d!3m1!1s2@1:CAIQACodChtycF9oOnREZHpsMFNCd043UzNKSlNnZ0VTblE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25SRVpIcHNNRk5DZDA0M1V6TktT