,null,"餐點",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCHgoCw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCHkoDA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCHooDQ",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3YcHCHwoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCHsoDg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3YcHCH4oAA"],[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3YcHCH8oAQ"]]],null,"用餐人數",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCH0oDw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["偏獨立作為類型，蠻適合一個人去享受的\n\n湯頭是這間店最吸引人的地方，將柑橘的清香與拉麵本身的濃厚結合得很好，喝起來清爽卻不單薄，層次相當豐富。旁邊附的三分鐘小沙漏也蠻有巧思，提醒檸檬片不要浸泡過久，避免苦味跑出來影響整體風味。\n\n很喜歡他們的胡椒柚子系列的調味料，配合肉類很搭\n\n補充一下這次的感受，泡系這種偏重口味的湯頭確實會比較鹹一點，對平常吃比較清淡的人來說可能需要一點時間適應。不過如果本來就喜歡濃厚系拉麵的人，應該會覺得很過癮。\n\n另外真的蠻推薦鴨叉燒可以直接加點一份，整體表現很加分，搭配湯頭一起吃更有層次。整碗拉麵從湯底、麵體到配料的搭配都相當完整，風味變化豐富，不會有單一味道吃到後面膩掉的問題。\n\n不過鴨肉淡淡地苦味 不是很喜歡\n\n整體來說還不錯",null,[0,18]]]],[null,null,null,null,null,"https://business.google.com/local/business/17347037834898378119/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBHVlU5WFRscFdibFowVFd4Wk5WTlhXWHBWVjJ4d1V6QjBTMVpGUlJBQhAA",[null,null,null,"/local/business/17347037834898378119/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBHVlU5WFRscFdibFowVFd4Wk5WTlhXWHBWVjJ4d1V6QjBTMVpGUlJBQhAA"],"https://business.google.com/local/business/17347037834898378119/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBHVlU5WFRscFdibFowVFd4Wk5WTlhXWHBWVjJ4d1V6Q