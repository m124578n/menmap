l,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3YcHCFsoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCFooCA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCFwoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCF0oCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCF4oCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3YcHCGAoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjT3Jj4vdKWAxUnn68BHWZeKjkQ3IcHCF8oDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["【柑橘Shinn 鴨蔥】久違的幸福碳水🤩\n\u2061\n可以忽略季節的食物，除了火鍋就是拉麵🍜\n除非你胃食道逆流，不然拉麵可以解決85%的難題。(包含落枕)\n\u2061\n#柑橘蛤蜊鹽味雞白湯 $320: 相較於溫柔婉約的雞白湯，鴨白湯多了濃濃的野性 (大拇指刷鼻頭)。\n真的是好好吃餒~\n\u2061\n感謝蛤蜊的助攻，整體湯頭相當鹹鮮濃郁，並散發出強烈的鴨肉香氣，搭配著軟嫩的鴨叉燒，好! 好! 好!\n麵條選了硬面，讓整體口感再更具層次且壽命更長，真的好好吃。\n\u2061\n我個人的習慣是會用檸檬皮/柑橘皮包裹住麵條一起吸入，有點酸，有點鹹，有點苦，有點好吃。(但怕苦的不要這樣吃)。\n\u2061\n結論: 好吃一直吃。",null,[0,42]]]],[null,null,null,null,null,"https://business.google.com/local/business/17347037834898378119/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDTkU1RmNFZGlhbVJXVEZWamVGcHVZM2hUUlU1b1ZtdFNXVlZXUlJBQhAA",[null,null,null,"/local/business/17347037834898378119/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDTkU1RmNFZGlhbVJXVEZWamVGcHVZM2hUUlU1b1ZtdFNXVlZXUlJBQhAA"],"https://business.google.com/local/business/17347037834898378119/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBDTkU1RmNFZGlhbVJXVEZWamVGcHVZM2hUUlU1b1ZtdFNXVlZXUlJBQhAA",[null,null,null,"/local/business/173