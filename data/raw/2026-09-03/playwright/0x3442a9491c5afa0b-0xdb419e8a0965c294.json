KAA"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwj-y7mFvtKWAxWyZfUHHYRZK9EQ3YcHCKEBKAE"]]],null,"用餐人數",null,"0ahUKEwj-y7mFvtKWAxWyZfUHHYRZK9EQ3IcHCJ8BKBQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwj-y7mFvtKWAxWyZfUHHYRZK9EQ3YcHCKMBKAA"]],1],null,null,"等待時間",null,"0ahUKEwj-y7mFvtKWAxWyZfUHHYRZK9EQ3IcHCKIBKBU",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["九湯屋日式拉麵\n大部分是大骨湯底，\n2025/10\n札幌味增139味道比較奇怪，\n九州白湯139味道不錯，\n加麵漲價需要25，份量是不減，\n釜山紅湯149，\n平價拉麵\n口味台式但很美味，\n不會太鹹，\n加麵份量很足夠是兩倍，\n捲麵麵條不會太軟嫩沒彈性，\n要軟嫩一點則點細麵，\n叉燒兩大塊，雖然較薄但嫩，\n加麵後滿滿一大碗154，\nCP值很高。\n泡菜拉麵139是豚骨湯底加上泡菜口味，\n口味上也是不錯，\n下次再嘗試其他口味。",null,[0,25]]]],[null,null,null,null,null,"https://business.google.com/local/business/9651692590354347741/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXTVZsck5URmtNMk4zVkRGTmRGb3lTbkZrYTNCclRWVmthV1J1WXhBQhAA",[null,null,null,"/local/business/9651692590354347741/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXTVZsck5URmtNMk4zVkRGTmRGb3lTbkZrYTNCclRWVmthV1J1WXhBQhAA"],"https://business.google.com/local/business/9651692590354347741/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXTVZsck5URmtNMk4zVkRGTmRGb3lTbkZrYTNCclRWVmthV1J1WXhBQhAA",[null,null,null,"/local/business/9651692590354347741/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXTVZsck5URmtNMk4zVkRGTmRGb3lTbkZrYTNCclRWVmthV1J1WXhBQhAA"],null,"https://business.google.com/local/business/9651692590354347741/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXTVZsck5URmtNMk4zVkRGTmRGb3lTbkZrYTNCclRWVmthV1J1WXhBQhAA",[null,null,null,"/local/business/9651692590354347741/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXTVZsck5URmtNMk4zVkRGTmRGb3lTbkZrYTNCclRWVmthV1J1WXhBQhAA"]],[null,null,6487,["https://www.google.com/maps/reviews/data\u003d!4m8