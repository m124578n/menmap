TMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjYqaTlw9KWAxXGha8BHQYxJgAQ3IcHCLsBKA0",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwjYqaTlw9KWAxXGha8BHQYxJgAQ3YcHCL0BKAA"]],1],null,null,"預訂網址",null,"0ahUKEwjYqaTlw9KWAxXGha8BHQYxJgAQ3IcHCLwBKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjYqaTlw9KWAxXGha8BHQYxJgAQ3YcHCL8BKAA"]],1],null,null,"等待時間",null,"0ahUKEwjYqaTlw9KWAxXGha8BHQYxJgAQ3IcHCL4BKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["「黑蒜油替豚骨湯體注入靈魂，溫柔交織、香氣融合。」\n\n🍜 黑蒜豚骨拉麵拉麵 $130（週年歡慶價）+ 溏心蛋 $40\n\n一口喝下黑蒜油香氣四溢，溫柔地與豚骨湯底交織融合，有別於日式背脂膠質的濃稠衝擊感，這碗符合大眾口味質地輕柔、順口，夏天來吃也不會覺得有負擔～\n\n豬叉燒2大片～沒有過多調味，但是完全沒有腥味，薄嫩有嚼勁且不乾柴，在咀嚼中品嚐豬叉燒本身的原始香氣！老闆娘特別提醒豬叉燒要泡過湯再吃更好吃哦～\n\n配料中的蔥絲、木耳、筍乾份量都很有誠意，其中最喜歡筍乾，清脆爽口、鹹甜鹹甜的滋味個人很喜歡。\n\n溏心蛋需要另外加購，是完美的流心狀，吃起來甘甜富有淡香，推薦大家加點。\n\n麵體部分為細麵，軟硬適中，帶湯力ok！\n\n🔸整體 🌕🌕🌕🌕🌘\n\n店內還有許多自製小菜可以搭配選擇，老闆娘相當親切，環境乾淨整潔，整體用餐體驗很舒服😌\n\n一週年活動現正熱映中，5/9～5/31內用招牌黑蒜豚骨拉麵特價130元（原價180元），歡慶價真的超甜，不來吃會後悔～\n\n📍一宣堂拉麵\n台北市北投區中央北路一段115號\n\n目前暫無公休日（休假日詳見FB粉專）\n午場11:30-14:30\n晚場16:30-20:30\n-\n更多拉麵分享\n#00吃拉麵\nIG：00eatramen",null,[0,58]]]],[null,1751986401000000,1751986401000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfRVMtb21sUWJXV2RUTWNxZi1TcWtDZw%7CCAEQrcz1_gkiMAoZQ0hfRVMtb21sUWJXV2RUTWNxZi1TcWtDZxoTQ2d3STRlRzB3d1lReGR2MG1RTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjYqaTlw9KWAxXGha8BHQYxJgAQ_2MIwAEoEA"],"https://business.google.com/local/business/16665007275069408389/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZQWVZONk5WaGxjMlZ0UjE5QlJSQUIQAA%3D%3D",[null,null,null,"/local/business/16665007275069408389/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZQWVZONk5WaGxjMlZ0UjE5QlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/16665007275069408389/customers/reviews/deletereply?p\u