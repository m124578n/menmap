4367481"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUMxd29xX3ZBRRAB"]],"CIHM0ogKEICAgIC1woq_Yg",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ3YcHCNcBKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ3IcHCNYBKAg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ3YcHCNkBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ3IcHCNgBKAk",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ3YcHCNsBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ3IcHCNoBKAo",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ3IcHCNwBKAs",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ3IcHCN0BKAw",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ3IcHCN4BKA0",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["原下意識上菜拍了每樣品項，店家上菜時也見正在拍攝菜單及菜色，但當下店家只告知排骨會在另外呈上，於後我見店內牆上貼公告禁止拍照，於是之後並未再作拍攝動作，只是不解拍照當下並未被阻止。\n\n溫泉蛋:很不錯。\n\n海藻醋:個人覺得太酸，喜愛吃酸的應該覺得不錯。\n\n排骨拉麵:湯頭肉腥味很重，拉麵內含一塊白肉還可以，排骨另外裝盤於後呈上，店家會極力推薦排骨，個人覺得排骨屬於沾薄粉的酥脆感，味道還可以，不知是否是店主至進門開始並一直推薦的關係，導致期待過大，所以到覺得其實還好而已。\n\n整體價位個人覺得不便宜，且沒那個價值，湯頭腥味偏重，喜愛肉味的或許可考慮，溫泉蛋不錯價格也還可以，停車部分因附近為溫泉飯店區，不好停車。",null,[0,90]]]],[],[null,null,18447,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUMxd29xX3ZBRRAB!2m1!1s0x0:0x1dc711393ae72c79!3m1!1s2@1:CIHM0ogKEICAgIC1woq_vAE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUMxd29xX3ZBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUMxd29xX3ZBRRItChZDSUhNMG9nS0VJQ0FnSUMxd29xX2ZBEhNDZ3dJazZDcHJBWVEyTlRvemdNGi4KF0NJSE0wb2dLRUlDQWdJQzF3b3FfX0FFEhNDZ3dJazZDcHJBWVEyTlRvemdNIhIJAAAAAAAAAAAReSznOjkRxx0qCzBfWF8tSXRxWGRO\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQoykI3wEoDg"],null,[null,[[1,2]]]],"0ahUKEwjWhYPyw9KWAxUgeF4EHd5_HfIQ0pMFCH4oBw"],null,null,null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ0pMFCMYBKAc"]],null,null,null,"other_user_google_review_posts__and__hotel_and_vr_partner_review_posts",null,"CjEIARIpCgoAP7_LANSo____EhATYROkRGZqbylq8twAAAAAGgn92Q8Cc1u3Mf0YACIA"]],null,null,null,[3,1,null,null,null,[2]],["顧客表示這家拉麵店提供份量十足的美味台式拉麵，他們特別提到風味濃郁的叉燒和酥脆的排骨，以及可口的溫泉蛋。\n\n部分評論則提到，拉麵的口味可能偏淡，而且服務有時候不太周到。",null,"https://www.google.com/local/content/rap/report?postId\u003d5%401:CAIQACodChtyc19oOnVzbmVkaGY4Q1cySWExOW9XNndJSlE%7CCAIQACorChtyc19oOnVzbmVkaGY4Q1cySWExOW9XNndJSlESDAip4OHTBhDQn_PEAQ\u0026d\u003d286732321\u0026t\u003d8",49,null,[["https://lh3.googleusercontent.com/a-/ALV-UjUnwkhXPcWO4gc9Ep1r4ffvOnLpEhkYsyw3L7iRa_86LAjqPuk\u003ds120-c-rp-mo-ba12-br100"],["https://lh3.googleusercontent.com/a-/ALV-UjXoTBDH4IVvPjNg8JcTVf8qlZOEAyCdHc9u-EiVPAclyPOWVu0\u003ds120-c-rp-mo-br100"],["https://lh3.googleusercontent.com/a-/ALV-UjW0_jrOnu5TRMEYHWq1jVFAR2RFlpuZO2czluaNAlj9lkutUSlT\u003ds120-c-rp-mo-br100"]]]],null,null,[["02 2893 7958",[["02 2893 7958",1],["+886 2 2893 7958",2]],null,"0228937958",null,["tel:0228937958",null,null,"0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQ_doBCA0oCg"]]],null,null,null,null,[[[7,[["滿客屋拉麵"],["112臺北市北投區林泉里溫泉路110號"]]],[2,[["112臺北市北投區林泉里溫泉路110號滿客屋拉麵"]]],[1,[["112臺北市北投區林泉里溫泉路110號"]]],[4,[["臺北市北投區林泉里"]]]],[null,"溫泉路110號","溫泉路110號","林泉里","112","臺北市北投區","TW"],["0ahUKEwjB1Prxw9KWAxXbgK8BHVhMHPAQqtMBCAkoBg",["7QQ34GP6+F9"],["4GP6+F9 林泉里 臺北市北投區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[["星期四",4,[2026,9,3],[["11:00–14:00",[[11],[14]]],["17:00–20:0