ull,null,null,null,null,null,["zh-Hant"],[["今天來試吃5/5才正式開賣的韓式莎莎蔬果沾麵，這家的拉麵我幾乎每種口味都吃過了（除了一個什麼黑蒜的因為五辛的關係我沒點。）\n一直很怕店家會賣到虧錢，除了集點五碗可以換一碗，還有當月生日任選免費。然後每次吃無論什麼口味都吃很飽，雖然很好吃，可是麵常常吃不完。這點真的讓我很困擾。\n\n但今天很神奇的是韓式新口味因為太爽口了，竟然完全吃光光！不過店家大方闊氣的形式還是沒改！蔬果莎莎醬給了好多啊，完食後，我望著滿滿香菜還有蕃茄蔬果的濃郁醬汁，還剩了一大半，覺得真的太可惜了。\n\n除此之外，一切都很棒，清爽的口感真的很適合夏天呢！\n\n會繼續用行動支持佛心店家，也謝謝店家願意持續推出新口味，繼續推廣素食❤️",null,[0,138]]]],[null,1777864236000000,1777864253000000,"3 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfYmluYXcyVzY5bU9xUE9IXy1ZRG5aUQ%7CCAEQrcz1_gkiMAoZQ0hfYmluYXcyVzY5bU9xUE9IXy1ZRG5aURoTQ2d3SXZaemd6d1lRM3RTY3BBSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjN_7uovtKWAxWmk68BHZlNAYgQ_2MIXygM"],"https://business.google.com/local/business/12466397357648748125/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZVdGSFdtWldWazVVVDFaU2VsSjZRalZrUm5BeVZVVTVXRTB6WXhBQhAA",[null,null,null,"/local/business/12466397357648748125/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZVdGSFdtWldWazVVVDFaU2VsSjZRalZrUm5BeVZVVTVXRTB6WXhBQhAA"],"https://business.google.com/local/business/12466397357648748125/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZVdGSFdtWldWazVVVDFaU2VsSjZRalZrUm5BeVZVVTVXRTB6WXhBQhAA",[null,null,null,"/local/business/12466397357648748125/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZVdGSFdtWldWazVVVDFaU2VsSjZRalZrUm5BeVZVVTVXRTB6WXhBQhAA"],null,"https://business.google.com/local/business/12466397357648748125/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZVdGSFdtWldWazVVVDFaU2VsSjZRalZrUm5BeVZVVTVXRTB6WXhBQhAA",[null,null,null,"/local/business/12466397357648748125/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBGZVdGSFdtWldWazVVVDFaU2VsSjZRalZrUm5BeVZVVTVXRTB6WXhBQhAA"],null,["zh-Hant"],[["非常謝謝您願意給我們品嚐與回饋，另外因為試吃活動的回饋與測試，我們韓式莎莎未來上市將會改成五辛素的方式，我們會繼續研發優質純素的料理，讓更多人喜愛，也謝謝您願意給參與我們的活動～",null,[0,89]]]],[n