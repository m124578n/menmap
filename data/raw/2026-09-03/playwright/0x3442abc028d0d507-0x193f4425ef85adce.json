_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwjN_7uovtKWAxWmk68BHZlNAYgQ3YcHCPEBKAA"]]],null,"用餐人數",null,"0ahUKEwjN_7uovtKWAxWmk68BHZlNAYgQ3IcHCPABKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwjN_7uovtKWAxWmk68BHZlNAYgQ3YcHCPMBKAA"],[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwjN_7uovtKWAxWmk68BHZlNAYgQ3YcHCPQBKAE"]]],null,"座位類型",null,"0ahUKEwjN_7uovtKWAxWmk68BHZlNAYgQ3IcHCPIBKA8",null,null,null,null,null,3,null,2],[["GUIDED_DINING_VEGETARIAN_OPTIONS_TIPS"],"素食餐點",null,null,"分享素食餐點相關資訊","素食餐點",null,"0ahUKEwjN_7uovtKWAxWmk68BHZlNAYgQ3IcHCPUBKBA",null,null,["純素、五辛素、奶素"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:VEGETARIAN_OPTIONS"],"素食餐點",2,null,null,"0ahUKEwjN_7uovtKWAxWmk68BHZlNAYgQ3YcHCPcBKAA"]]],null,null,null,"0ahUKEwjN_7uovtKWAxWmk68BHZlNAYgQ3IcHCPYBKBE",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["［食素記] NÜDOO Veg - Raman Slurp Bar\nNÜDOO，名字靈感來自「New」與「Noodle」，開在台北101旁的蛋黃地帶，映入眼簾店貌大片落地窗，白色建築顯得時尚萬分，趁著太座生日，店家可以招待壽星一碗拉麵，趕緊來嚐鮮！\n\n我們點了\n🍜 牛肝箘野菇湯拉麵 ：一端上來，牛肝菌厚實的菇味就撲鼻而來，滿滿配菜（紅捲葉萵苣、烤南瓜、豆皮捲、櫛瓜、糯米椒、炸金針菇、鴻禧菇）一碗滿滿飽足感，湯頭是鮮菇的香味（不敢吃菇的要避免😆)、蔬菜的甜、炸物的香、椒類微苦，味道層次非常多，麵條偏軟，但還是保有Q度。\n\n🍜栗子南瓜沾麵：擺盤上更加日式，配菜與牛肝菌拉麵大致相同，但這麵的靈魂在於醬汁，南瓜濃湯加上栗子直接把濃郁的味道昇華，吃在嘴裡栗子的甜與南瓜的綿密超級豐富，重點因為是全素，沒有加上牛奶，能如此香濃，非常厲害，份量上也十分足夠，太座飽到整個肚皮再吞一條麵就會爆開。\n\n另外還點了天婦羅、炸玉米，因為炸物主餐也有附，其實可以不用加點，加官方Ig 還送炸洋芋片。\n\n—————店家資訊———\n\nNÜDOO\n🎯地址: 台北市信義區信義路四段415-2號1F\n🎯營業時間：週一至週五 11:30–15:00（最後點餐14:00）；17:00–22:00（最後點餐21:00）｜週六、週日 11:30–22:00\n🎯可以直接線上點餐結帳很方便，但沒有預約方式\n🎯店裡約25-30個座位",null,[0,124]]]],[null,1765469227000000,1765469227000000,"8 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfaVJWdzZVeVFLb1R4MWtHR0dGMGVnUQ%7CCAEQrcz1_gkiLwoZQ0hfaVJWdzZVeVFLb1R4MWtHR0dGMGVnURoSQ2dzSXE5anJ5UVlRbnNHd0VR\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUK