",null,"0ahUKEwjKwODszNKWAxVKma8BHTB3AXAQ3IcHCE0oBg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjKwODszNKWAxVKma8BHTB3AXAQ3YcHCFAoAA"]]],null,"用餐人數",null,"0ahUKEwjKwODszNKWAxVKma8BHTB3AXAQ3IcHCE8oBw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwjKwODszNKWAxVKma8BHTB3AXAQ3YcHCFIoAA"]]],null,"座位類型",null,"0ahUKEwjKwODszNKWAxVKma8BHTB3AXAQ3IcHCFEoCA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["與太太來吃，說實在蠻失望的。一個人加10%服務費幾乎是300元了，但是……\n\n湯頭完全不濃郁，偏稀，完全沒有濃郁豚骨的感覺，喝到中後段真的以為自己在喝有味道的水。\n麵條也很平庸，店家都是給硬麵(軟麵的話要另外勾選)，我平常是非常愛吃硬麵的人，但這邊的麵完全沒有Q感、沒有嚼勁 (我是端上來的30秒內就開吃了)，算是日式拉麵中很糟的口感。\n\n肉非常的少，點了「肉加倍」共280，再加10%共308元，只有四片薄薄的叉燒肉，也是沒有明顯的肉味和口感，這個價位配這種肉實在不行😕😕\n\n從頭到尾自己掃QR code點餐，自己倒水，不知道10%的清潔服務費是算在哪裡的呢？\n\n總之以300元左右的日式拉麵，這裡完全不會想再來了，踩雷的一次店，品質很對不起這個價位，台北有很多更好的選擇",null,[0,81]]]],[null,null,null,null,null,"https://business.google.com/local/business/1488570718288863440/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyTVdSRk1EUmxSbXh5WkVNeGMwNXJTbEJsUmtKUldUSndlRll3UlJBQhAA",[null,null,null,"/local/business/1488570718288863440/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyTVdSRk1EUmxSbXh5WkVNeGMwNXJTbEJsUmtKUldUSndlRll3UlJBQhAA"],"https://business.google.com/local/business/1488570718288863440/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyTVdSRk1EUmxSbXh5WkVNeGMwNXJTbEJsUmtKUldUSndlRll3UlJBQhAA",[null,null,null,"/local/business/1488570718288863440/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyTVdSRk1EUmxSbXh5WkVNeGMwNXJTbEJsUmtKUldUSndlRll3UlJBQhAA"],null,"https://business.google.com/local/business/1488570718288863440/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVyTVdSRk1EUmxSbXh5WkVNeGMwNXJTbEJsUmtKUldUSndlRll3UlJBQhAA",[nu