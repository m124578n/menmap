0ahUKEwiKp97Qy9KWAxXIm68BHaL9GrMQ3IcHCO0BKBw",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["這家位於樹林秀泰的點爭鮮，用餐環境舒適且乾淨衛生。這次點了多款壽司，鮭魚與鮪魚握壽司表現平穩，肉質尚算軟嫩。特別推薦焦糖鮭魚握壽司，炙燒過的糖衣酥脆，與油脂豐富的鮭魚結合後香氣四溢。章魚握壽司搭配微酸的醬料，口感彈牙且開胃。\n蛤蜊鮑魚烏龍麵湯頭鮮甜，蛤蜊份量給得不少，鮑魚也處理得不錯，是一道溫暖的暖胃料理。另外，焗烤馬鈴薯起司味濃郁，搭配鬆軟的薯塊非常飽足。最後以爭鮮經典的烤布丁結尾，口感綿密扎實，甜度適中。整體服務快速，手機點餐方便，雖然是連鎖品牌，但品質維持得不錯，是來秀泰影城看電影前後用餐的好選擇。",null,[0,112]]]],[null,null,null,null,null,"https://business.google.com/local/business/5534425097683862525/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXY0ZKRk9VbE9XRTVvVEZac1dWTlVhelZOYms1dVVYcG9XbU5GUlJBQhAA",[null,null,null,"/local/business/5534425097683862525/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXY0ZKRk9VbE9XRTVvVEZac1dWTlVhelZOYms1dVVYcG9XbU5GUlJBQhAA"],"https://business.google.com/local/business/5534425097683862525/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXY0ZKRk9VbE9XRTVvVEZac1dWTlVhelZOYms1dVVYcG9XbU5GUlJBQhAA",[null,null,null,"/local/business/5534425097683862525/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXY0ZKRk9VbE9XRTVvVEZac1dWTlVhelZOYms1dVVYcG9XbU5GUlJBQhAA"],null,"https://business.google.com/local/business/5534425097683862525/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXY0ZKRk9VbE9XRTVvVEZac1dWTlVhelZOYms1dVVYcG9XbU5GUlJBQhAA",[null,null,null,"/local/business/5534425097683862525/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVXY0ZKRk9VbE9XRTVvVEZac1dWTlVhelZOYms1dVVYcG9XbU5GUlJBQhAA"]],[null,null,2386,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25WcFJFOUlOWE5oTFZsWVNUazVNbk5uUXpoWmNFRRAB!2m1!1s0x0:0x4b15f27b5ed29def!3m1!1s2@1:CAIQACodChtycF9oOnVpRE9INXNhLVlYSTk5MnNnQzhZcEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25WcFJFOUlOWE5oTFZsWVNUazVNbk5uUXpoWmNFRRAB\u0026t\u003d1\u0026entityid\