",["CIHM0ogKEICAgICy08-ixwE",10,12,null,null,null,["https://lh3.googleusercontent.com/grass-cs/ACvplmO2XpLhRxoebncfQ9sWKUjn4gGmCLh5rAG5cbcXTSUgESXeX6qbagPhC7r0adJMfrfZc57DXZ19jEsEodI-Dbsr_CxCzpck2Rq8I4-F4Sth-yLcPWs6s3-Fx8PZcN4_u44pvw1KCQ\u003dk-no",null,[4032,3024]],null,[[3,121.43589864336292,25.032925920634263],[0,90],[4032,3024],75],"A32ZauvEG8bs1e8Pm8vhkQw","0ahUKEwir0rfeyNKWAxVGdvUHHZtlOMIQzCcIdCgC",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICy08-ixwE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xe47c5eb9c0bb3b50",null,null,"0ahUKEwir0rfeyNKWAxVGdvUHHZtlOMIQ-y4IdSgA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgICy08-ixwE"],[10,3,[3024,4032]],[null,null,null,null,null,null,null,["麵屋駟"]],[null,[[["莊家豪"],"https://www.google.com/maps/contrib/117718537005216405665?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjXDooyTatqOU1l6QKj1_sWVhQIv_-TDan5m9Rv0YqVQY81ou6D9\u003ds120-c-rp-mo-ba12-br100",null,null,"117718537005216405665"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2021,2,12,3,null,null,null,null,["5 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgICy08-ixwE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xe47c5eb9c0bb3b50"]],1,null,null,null,null,null,null,["0","-1982605584054404272"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUN5MDhfb1ZBEAE"]],"CIHM0ogKEICAgICy08-ixwE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["2021/1/26  初訪\n清雞湯拉麵、炙烤明太子舒肥雞叉燒\n\n簡單來說，以價格對應口味來說，加上店家所在的位置，算是有些競爭力，蠻符合學生的味道。\n一端上來清湯蠻香的，湯的油脂算多(雞油或香味油) 所以湯溫不錯，也不會降太快 。\n\n對我來說，一開始喝有點像我們切仔麵或鴨肉麵鵝肉麵那種家鹽水的湯頭，其實是順口，\n但，多喝幾口之後其實會覺得湯頭稍微單薄，留在口腔裡的就只是反覆反覆單一個鹽味的味道而已，我麵跟配料吃完其實就沒有再多喝幾口了。\n\n麵條我覺得跟麵屋山茶有類似的感覺，我不知道是麵條本身的問題，還是煮麵者的問題，麵條的口感就是稍差，因為像麵屋山茶後來其實湯頭跟一些配料都越來越有創意，配合度也不錯，但麵條本身我還是覺得不夠好吃。\n\n拉麵裡的雞叉燒的話就中規中矩，可能是因為我前面已經吃了加點的明太子炙燒叉燒，所以拉麵裡面這幾片叉燒就很吃虧😅\n\n此外，蒜片跟豆莢等配料讓整碗拉麵看起來跟別人家不一樣，蠻有自己風格的。不過說真的蒜片跟湯頭不搭，跟麵條也不怎麼搭，和叉燒也是如此。",null,[0,30]]]],[null,null,null,null,null,"https://business.google.com/local/business/15516913135656932346/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjVNRGhmYjFaQkVBRRAA",[null,null,null,"/local/business/15516913135656932346/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjVNRGhmYjFaQkVBRRAA"],"https://business.google.com/local/business/15516913135656932346/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjVNRGhmYjFaQkVBRRAA",[null,null,null,"/local/business/15516913135656932346/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjVNRGhmYjFaQkVBRRAA"],null,"https://business.google.com/local/business/15516913135656932346/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjVNRGhmYjFaQkVBRRAA",[null,null,null,"/local/business/15516913135656932346/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjVNRGhmYjFaQkVBRRAA"]],[null,null,3596,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUN5MDhfb1ZBEAE!2m1!1s0x0:0xe47c5eb9c0bb3b50!3m1!1s2@1:CIHM0ogKEICAgICy08_oVA%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUN5MDhfb1ZBEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUN5MDhfb1ZBEi4KF0NJSE0wb2dLRUlDQWdJQ3kwOF9vMUFFEhNDZ3dJa1BHWGdRWVFpTExZa3dJGi0KFkNJSE0wb2dLRUlDQWdJQ3kwOF9vTkESE0Nnd0lrUEdYZ1FZUWlMTFlrd0kiEgkAAAAAAAAAABFQO7vAuV585CoLMFY4VVhwbWl3Zy0\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwir0rfeyNKWAxVGdvUHHZtlOMIQoykIdigD"],null,[null,[[1,3]]]],"0ahUKEwji-r3eyNKWAxVMYMIFHb_7LX4Q0pMFCDgoAg"],null,null,null,"0ahUKEwir0rfeyNKWAxVGdvUHHZtlOMIQ0pMFCHAoAg"],[["ChZDSUhNMG9nS0VJQ0FnSUN5MU5iQ0l3EAE",["0x0:0xe47c5eb9c0bb3b50",null,1611190325960850,1611219692512477,[null,null,["https://www.google.com/maps/contrib/112172226177637065507/reviews?hl\u003dzh-TW"],null,null,["Stars Yang","https