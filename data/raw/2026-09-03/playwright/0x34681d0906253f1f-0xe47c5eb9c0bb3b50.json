63],[0,90],[2250,4000],75],"A32ZauvEG8bs1e8Pm8vhkQw","0ahUKEwir0rfeyNKWAxVGdvUHHZtlOMIQzCcIbSgM",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDywpqubA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xe47c5eb9c0bb3b50",null,null,"0ahUKEwir0rfeyNKWAxVGdvUHHZtlOMIQ-y4IbigA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIDywpqubA"],[10,3,[4000,2250]],[null,null,null,null,null,null,null,["麵屋駟"]],[null,[[["jean Li"],"https://www.google.com/maps/contrib/102739794458234159579?hl\u003dzh-TW","https://lh3.googleusercontent.com/a/ACg8ocKa-SIveClsYOd7ejnEqXkw0nngrX9cIJABE1eFEOXF-hDm8A\u003ds120-c-rp-mo-ba12-br100",null,null,"102739794458234159579"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2021,3,1,1,null,null,null,null,["5 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDywpqubA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xe47c5eb9c0bb3b50"]],1,null,null,null,null,null,null,["0","-1982605584054404272"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUR5d3VydEdREAE"]],"CIHM0ogKEICAgIDywpqubA",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-TW"],[["⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀\n位於輔大捷運站跟輔大中間的小小店面。門口就是公車站牌，捷運輔大站出來不用兩分鐘就到了。騎車的也可以停在捷運站旁的機車停車區，交通算是很便利。\n店面真的很小，座位都是沿著吧檯，全部坐滿大概也就8-9人\n因為就在大馬路邊，除了比較吵雜，落塵也很嚴重。但絕對不是老闆沒清潔，只是這個擦完沒一會就又都是灰塵了。\n就座時記得自己再清潔一下桌面跟餐具，如果是很講究用餐環境的人請三思。\n因為只有老闆一人，所以大家要有點耐心，可能因為我們是除夕前一天去用餐，學生們還在放假，我們因為是第一組也沒其他人，上餐時間不會很慢。\n老闆很和善，規矩算少就看到的那張告示而已。\n營業時間是晚餐時間開到凌晨一點，如果在新莊大晚上的想吃拉麵，這也不失為是間好選擇。\n\n極品雞白湯拉麵$180\n我們選擇的是硬麵，吃起來的口感是我喜歡的。\n雞白湯通常都是很濃稠的口感，他們家的湯頭濃但是不稠，怕那種很黏稠口感的人倒是可以試看看他們家的。\n麵跟湯也不會像感情不合的夫妻一樣各過各的，蠻入味的。雞肉厚實，嫩度沒我想像中的嫩但也不柴，溏心蛋也OK。\n\n辛味雞白湯拉麵$180\n這個跟極品差在沒有溏心蛋，然後辣椒老闆是另外附，讓我們自己加（這點倒是挺妙的）。這個辣椒老實說看來有點突兀，但加進去的味道我個人是覺得還可以。不過也是有看到不喜歡的評論。我覺得是可以跟老闆要一些來加看看，不喜歡就繼續吃原味就好。\n⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀\n炸雞$50\n吃拉麵就是要配個炸雞才能結束這一餐。\n有另外附上沾醬，而且雞肉也蠻大塊的。",null,[0,123]]]],[null,null,null,null,null,"https://business.google.com/local/business/15516913135656932346/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUjVkM1Z5ZEVkUkVBRRAA",[null,null,null,"/local/business/15516913135656932346/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUjVkM1Z5ZEVkUkVBRRAA"],"https://business.google.com/local/business/15516913135656932346/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUjVkM1Z5ZEVkUkVBRRAA",[null,null,null,"/local/business/15516913135656932346/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUjVkM1Z5ZEVkUkVBRRAA"],null,"https://business.google.com/local/business/15516913135656932346/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUjVkM1Z5ZEVkUkVBRRAA",[null,null,null,"/local/business/15516913135656932346/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUjVkM1Z5ZEVkUkVBRRAA"]],[null,null,6665,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUR5d3VydEdREAE!2m1!1s0x0:0xe47c5eb9c0bb3b50!3m1!1s2@1:CIHM0ogKEICAgIDywurtGQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUR5d3VydEdREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUR5d3VydEdREi0KF0NJSE0wb2dLRUlDQWdJRHl3dXJ0bVFFEhJDZ3NJZ1lQeGdRWVFvSktyQVEaLAoWQ0lITTBvZ0tFSUNBZ0lEeXd1cnRXURISQ2dzSWdZUHhnUVlRb0pLckFRIhIJAAAAAAAAAAARUDu7wLlefOQqCzBWRTM1MFFPSVFG\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwir0rfeyNKWAxVGdvUHHZtlOMIQoykIbygN"],null,[null,[[1,1]]]],"0ahUKEwji-r3eyNKWAxVMYMIFHb_7LX4Q0pMFCB0oAQ"],null,null,null,"0ahUKEwir0rfeyNKWAxVGdvUHHZtlOMIQ0pMFCFUoAQ"],[["ChZDSUhNMG9nS0VJQ0FnSUN5MDhfb1ZBEAE",["0x0:0xe47c5eb9c0bb3b50",null,1613101200578165,1613101237851168,[null,null,["https://www.google.com/maps/contrib/117718537005216405665/reviews?hl\u003dzh-TW"],null,null,["莊家豪","https://lh3.googleusercontent.com/a-/ALV-UjXDooyTatqOU1l6QKj1_sWVhQIv_-TDan5m9Rv0YqVQY81ou6D9