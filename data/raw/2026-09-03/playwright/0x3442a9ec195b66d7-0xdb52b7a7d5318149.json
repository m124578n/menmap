會？",null,[[[["E:NOT_SURE"],"不確定",2,null,null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3YcHCJIBKAA"]]],null,"用餐人數",null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3IcHCJEBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3YcHCJQBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3IcHCJMBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這次點了極上貝貝拉麵，湯頭我蠻喜歡的，是那種帶有海鮮甜味的風味，不會太鹹也不油膩，整體喝起來很清爽順口。干貝本身也蠻鮮甜的，只是尺寸稍微小了一點點，如果再大顆一點會更有滿足感。\n\n麵條可以免費續加這點我覺得很加分，因為在看評論有人說份量很小我還有點擔心吃不飽，食量比較大的人也不用擔心吃不飽，以拉麵店來說CP值算是蠻高的。\n\n另外叉燒飯我覺得也算必點，跟我以前在其他地方吃過的叉燒飯相比，最大的差別是它不會油膩，味道夠但不會讓人覺得負擔重。我個人其實很喜歡這種清爽一點的做法，而且份量也不會太大，剛好可以搭配拉麵一起吃，不會太撐。\n\n整體吃下來是會想再回訪的類型",null,[0,88]]]],[null,null,null,null,null,"https://business.google.com/local/business/12286942624022503511/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTTA5WVVsUmhiSEJHVFZkak5GUXdhREJPVkVKNFRWaEdZVnBzUlJBQhAA",[null,null,null,"/local/business/12286942624022503511/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTTA5WVVsUmhiSEJHVFZkak5GUXdhREJPVkVKNFRWaEdZVnBzUlJBQhAA"],"https://business.google.com/local/business/12286942624022503511/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTTA5WVVsUmhiSEJHVFZkak5GUXdhREJPVkVKNFRWaEdZVnBzUlJBQhAA",[null,null,null,"/local/business/12286942624022503511/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTTA5WVVsUmhiSEJHVFZkak5GUXdhREJPVkVKNFRWaEdZVnBzUlJBQhAA"],null,"https://business.google.com/local/business/12286942624022503511/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTTA5WVVsUmhiSEJHVFZkak5GUXdhREJPVkVKNFRWaEdZVnBzUlJBQhAA",[null,null,null,"/local/business/12286942624022503511/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVKTTA5WVVsUmhiSEJHVFZkak5GUXdhREJPVkVKNFRWaEdZVnBzUlJBQhAA"]],[null,null,1895,["https:/