\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xdb52b7a7d5318149"]],1,null,null,null,null,null,null,["0","-2642848099848847031"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xwV1YxcHRkMTl5YVdKcmVtWXRZMjEwU0c1ZlltYxAB"]],"CIABIhATxnJRlbGiOs1mU3cT-tss",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3YcHCFwoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3IcHCFsoAg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3IcHCF0oAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3IcHCF4oBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3IcHCF8oBQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_MODERATE"],"有點吵雜",2,null,null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3YcHCGEoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3IcHCGAoBg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3YcHCGMoAA"]]],null,"用餐人數",null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3IcHCGIoBw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3YcHCGUoAA"]],1],null,null,"等待時間",null,"0ahUKEwiwmdG3vdKWAxX8nq8BHcKqDVcQ3IcHCGQoCA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["墨洋拉麵是吃完才明白，原來排隊不是沒有道理。\n\n價錢很實惠，味道卻不肯馬虎。炙燒干貝鮮甜，沒有一絲勉強；湯頭尤其討喜，清清的，不濁，不膩，只留下一種很自然的鮮味，在嘴裡慢慢散著。麵條帶點彈性，Q勁有，卻不生硬。\n\n特製叉燒、炙燒干貝、自製溏心蛋，都安安穩穩地擺在碗裡，再襯著幾絲碎紫洋蔥，顏色淡淡的，味道也剛好。不是刻意鋪張，卻樣樣都合適。\n\n之前路過東南亞戲院總有人願意排隊。幸好今天我晚了一點來，人潮鬆些，吃麵也就從容。\n\n吃到一半，店長還贈送一小碗炙燒叉燒飯。炙燒的香氣，遇上日式美乃滋，倒有點畫龍點睛的意思。\n\n唯一後悔的是，竟沒有空著肚子來。像這樣的一碗麵，本該留更多胃口給它。\n\n這家麵的味道，像一個舊識。彼此也不必多說什麼，各自做著手邊的事，像是這樣的相遇，本來就不必特別交代。入口沒有驚天動地，只是慢慢回想起來，愈吃愈覺得熟悉。",null,[0,22]]]],[null,null,null,null,null,"https://business.google.com/local/business/12286942624022503511/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3VjFZeGNIUmtNVGw1WVZkS2NtVnRXWFJaTWpFd1UwYzFabGx0WXhBQhAA",[null,null,null,"/local/business/12286942624022503511/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3VjFZeGNIUmtNVGw1WVZkS2NtVnRXWFJaTWpFd1UwYzFabGx0WXhBQhAA"],"https://business.google.com/local/business/12286942624022503511/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3VjFZeGNIUmtNVGw1WVZkS2NtVnRXWFJaTWpFd1UwYzFabGx0WXhBQhAA",[null,null,null,"/local/business/12286942624022503511/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3VjFZeGNIUmtNVGw1WVZkS2NtVnRXWFJaTWpFd1UwYzFabGx0WXhBQhAA"],null,"https://business.google.com/local/business/12286942624022503511/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3VjFZeGNIUmtNVGw1WVZkS2NtVnRXWFJaTWpFd1UwYzFabGx0WXhBQhAA",[null,null,null,"/local/business/12286942624022503511/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3VjFZeGNIUmtNVGw1WVZkS2NtVnRXWFJaTWpFd1UwYzFabGx0WXhBQhAA"]],[null,null,991,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xwV1YxcHRkMTl5YVdKcmVtWXRZMjEwU0c1ZlltYxAB!2m1!1s0x0:0xdb52b7a7d5318149!3m1!1s2@1:CAIQACodChtycF9oOlpWV1ptd19yaWJremYtY210SG5fYmc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xwV1YxcHRkMTl5YVdKcmVtWXRZMjEwU0c1ZlltYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xwV1YxcHRkMTl5YVdKcmVtWXRZMjEwU0c1ZlltYxI-Ci9DQUlRQUNvZENodHljRjlvT2xwV1YxcHRkMTl5YVdKcmVtWXRZMjEwU0c1ZlltYxILMGVRYVE4cUZaSFQaPgovQ0FJUUFDb2RDaHR5Y0Y5b09scFdWMXB0ZDE5eWF