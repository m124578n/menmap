/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIDzqq2GFA\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xe4262672302deb5c"]],1,null,null,null,null,null,null,["0","-2006874312070534308"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUR6cXEzYWtnRRAB"]],"CIHM0ogKEICAgIDzqq2GFA",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiRl-aIytKWAxVgoq8BHSwUFqkQ3IcHCI0BKAw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiRl-aIytKWAxVgoq8BHSwUFqkQ3IcHCI4BKA0",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["佐堂拉麵\n店內空間密集，燈光溫暖偏明亮，內部空間佈置擺滿了航海王的模型，給我的感覺好像新店另一間淳拉麵，pos機反應有點卡頓，螢幕反應有點差，晚上來品項數量都剩不多，有點好奇豪華拉麵的價錢\n\n出汁唐揚雞\n唐揚雞油炸的偏老，口感偏硬，肉質還算有彈性，跟我印象中爆漿軟嫩的部份有些差距，除了肉質老了些，其實還不算太差\n\n味增拉麵\n點了麵硬感覺麵條還是軟了些，叉燒是直接用噴槍炙燒的，時間拿捏的很恰當，微焦的口感搭配剛逼出的油脂，口味很棒。拉麵裡沒有筍乾，反而是用大白菜當作配料，令我有點驚訝，味增湯頭小鹹，是真的滿濃郁的，比起百元拉麵、台式拉麵來說，真的好很多，品質上除了上述的配菜和麵的軟度，基本上不輸日式拉麵，以這個價格來說真的滿佛心的，店內的辣椒看著像七味唐辛子，沾起來又有些差距，感覺的確是辣味多了些，或許稱之為辣椒片也沒錯",null,[0,94]]]],[null,null,null,null,null,"https://business.google.com/local/business/7444093032096632150/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUjZjWEV6WVd0blJSQUIQAA%3D%3D",[null,null,null,"/local/business/7444093032096632150/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUjZjWEV6WVd0blJSQUIQAA%3D%3D"],"https://business.google.com/local/business/7444093032096632150/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUjZjWEV6WVd0blJSQUIQAA%3D%3D",[null,null,null,"/local/business/7444093032096632150/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUjZjWEV6WVd0blJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/7444093032096632150/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUjZjWEV6WVd0blJSQUIQAA%3D%3D",[null,null,null,"/local/business/7444093032096632150/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1H