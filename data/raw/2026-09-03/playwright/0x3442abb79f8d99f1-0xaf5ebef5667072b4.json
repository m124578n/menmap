,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_PARKING_LOT"],"付費停車位",2,null,null,"0ahUKEwiOhdigvNKWAxWodPUHHTG7MGQQ3YcHCJcBKAA"],[["E:PARKING_OPTION_PAID_STREET_PARKING"],"付費路邊停車",2,null,null,"0ahUKEwiOhdigvNKWAxWodPUHHTG7MGQQ3YcHCJgBKAE"]]],null,"附近的停車場",null,"0ahUKEwiOhdigvNKWAxWodPUHHTG7MGQQ3IcHCJYBKA8",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwiOhdigvNKWAxWodPUHHTG7MGQQ3IcHCJkBKBA",null,null,["機車車位算好找，但汽車要繞餓一繞尤其是吃飯時間🫶🏻"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiOhdigvNKWAxWodPUHHTG7MGQQ3YcHCJsBKAA"]]],null,null,null,"0ahUKEwiOhdigvNKWAxWodPUHHTG7MGQQ3IcHCJoBKBE",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["真的好久沒來吃了，但只要來到附近，腦中第一個浮現的還是這家拉麵店。這次一樣點了最愛的麻辣豚骨拉麵，味道依然穩定在線，濃郁的湯頭帶點麻辣的刺激，再配上香氣十足的肉燥，層次感很棒，每一口都很滿足。\n\n份量也給得很有誠意，吃起來非常有飽足感。再加點一份帶有濃濃鍋氣香的炒飯，香氣十足，直接把整餐的滿足感拉滿。\n\n整體來說，不只好吃，CP值也很高，是會讓人一來再來的口袋名單 👍",null,[0,96]]]],[null,null,null,null,null,"https://business.google.com/local/business/10009464027420227038/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYm1WdWFGVlpWV015WTNwT1lWbFhWbmROV0VrelUyeGtTVm93UlJBQhAA",[null,null,null,"/local/business/10009464027420227038/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYm1WdWFGVlpWV015WTNwT1lWbFhWbmROV0VrelUyeGtTVm93UlJBQhAA"],"https://business.google.com/local/business/10009464027420227038/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYm1WdWFGVlpWV015WTNwT1lWbFhWbmROV0VrelUyeGtTVm93UlJBQhAA",[null,null,null,"/local/business/10009464027420227038/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhYm1WdWFGVlpWV015WTNwT1lWbFhWbmROV0VrelUyeGtTVm93UlJBQhAA"],null,"https://business.google.com/local/business/10009464027420227038/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZU