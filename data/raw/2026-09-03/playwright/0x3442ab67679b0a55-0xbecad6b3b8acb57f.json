WRg68BHTAtAqMQ3IcHCH4oGQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwieu66hxdKWAxWRg68BHTAtAqMQ3IcHCH8oGg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwieu66hxdKWAxWRg68BHTAtAqMQ3YcHCIEBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwieu66hxdKWAxWRg68BHTAtAqMQ3YcHCIIBKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwieu66hxdKWAxWRg68BHTAtAqMQ3YcHCIMBKAI"]]],null,"用餐人數",null,"0ahUKEwieu66hxdKWAxWRg68BHTAtAqMQ3IcHCIABKBs",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwieu66hxdKWAxWRg68BHTAtAqMQ3YcHCIUBKAA"]],1],null,null,"等待時間",null,"0ahUKEwieu66hxdKWAxWRg68BHTAtAqMQ3IcHCIQBKBw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["連鎖壽喜燒第一品牌\n蔬菜、肉品品質穩定，SOP都已很成熟，除了板橋大遠百靠窗viwe很讚外，到哪家分店吃，差異都不大，蔬菜選擇也很多，副食品也相當豐富，壽喜燒可續雞蛋，飲料吧也算該有都有。\n\n重點\n肉品：美牛五花、澳肩胛肉、豬五花、豬里脊、雞肉，也算齊全。另有和牛無限選項。\n湯底：除壽喜燒、辣味增、蕃茄鍋、鹽味豚骨、涮涮清湯鍋外，還有季節限定 咖哩、瑪格麗特、柚子鹽味（現在），略有變化。\n\n是個少數想大口吃菜 或大口吃肉的好地方，都是原型食物，放縱一下的好選擇。\n\n壽喜燒湯底 是首選，建議一開始整罐水到進去，才不會太鹹太甜。\n\n記得加會員\n單身友善\n百貨店雙重累點",null,[0,94]]]],[null,1777901114000000,1777901114000000,"3 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfNTVuUGhqMEVlMEpPRnFNVkRjV0xNdw%7CCAEQrcz1_gkiLwoZQ0hfNTVuUGhqMEVlMEpPRnFNVkRjV0xNdxoSQ2dzSXVyeml6d1lRMF8zUEd3\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwieu66hxdKWAxWRg68BHTAtAqMQ_2MIhgEoHQ"],"https://business.google.com/local/business/237880861467204881/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLY1dGdFZuQmxXR2QzWVVkb1RGb3hZekZPV0VwMlRrVlNiRmd3UlJBQhAA",[null,null,null,"/local/business/237880861467204881/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLY1dGdFZuQmxXR2QzWVVkb1RGb3hZekZPV0VwMlRrVlNiRmd3UlJBQhAA"],"