u003d!1e10!2sCIHM0ogKEICAgICSy76_igE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xa77f0af2d4e28550"]],1,null,null,null,null,null,null,["0","-6377366509263354544"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUNTeTc2X3NnRRAB"]],"CIHM0ogKEICAgICSy76_igE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["我點味噌拉麵90元+虱目魚條只要10元!!!\n味噌很甜很香，湯我幾乎全部喝完！\n麵非常軟而沒有嚼勁，我覺得不是拉麵啦，\n但這種麵搭這種湯蠻可以的！\n梅花豬肉片很大片又不會腥、\n高麗菜很甜而且量比其餘店家更多\n(一般這種麵根本不會給你高麗菜的配置)\n還有豐富的海鮮，有魷魚、蛤蠣和蝦、\n都不會腥而且也沒吃到沙，可圈可點；\n腸泥如果在意的話要自己清。\n也有虱目魚丸、竹輪等火鍋料，沒有廉價的感覺。\n預設是不含蛋的。\n尖峰時間需要等10分多鐘，\n建議可以打電話預約，店家態度很和善。\n環境就路邊攤，座位在騎樓，介意的人就不要來，\n雖然攤位略顯老舊，\n但仔細看會發現店家很注重桌面和餐具的清潔。",null,[0,59]]]],[],[null,null,6533,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUNTeTc2X3NnRRAB!2m1!1s0x0:0xa77f0af2d4e28550!3m1!1s2@1:CIHM0ogKEICAgICSy76_sgE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUNTeTc2X3NnRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUNTeTc2X3NnRRIuChdDSUhNMG9nS0VJQ0FnSUNTeThIaHlBRRITQ2d3STBlVHRfZ1VRc09udDRRSRotChZDSUhNMG9nS0VJQ0FnSUNTeTc2X2NnEhNDZ3dJX2M3cl9nVVF5S21MLWdJIhIJAAAAAAAAAAARUIXi1PIKf6cqCzBVcXI4R2dEckhr\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiJ8tafvtKWAxUWgK8BHT5rLGoQoykIogEoBA"],null,[null,[[1,1]]]],"0ahUKEwiJpN6fvtKWAxU8icAFHQKWIgEQ0pMFCGIoBw"],null,null,null,"0ahUKEwiJ8tafvtKWAxUWgK8BHT5rLGoQ0pMFCJoBKAc"]],null,null,null,"other_user_google_review_posts__and__hotel_and_vr_partner_review_posts",null,"CjEIARIpCgoAP7_LAyhR____EhDXkU6kMMpuX_iktrkAAAAAGgn92WoCiY7JcLEYACIA"]],null,null,null,[3,1,null,null,null,[2]]],null,null,[["02 2556 4576",[["02 2556 4576",1],["+886 2 2556 4576",2]],null,"0225564576",null,["tel:0225564576",null,null,"0ahUKEwiJ8tafvtKWAxUWgK8BHT5rLGoQ_doBCA0oCg"]]],null,null,null,null,[[[7,[["崑山藤椅店海鮮拉麵"],["103臺北市大同區永樂里民生西路354號"]]],[2,[["103臺北市大同區永樂里民生西路354號崑山藤椅店海鮮拉麵"]]],[1,[["103臺北市大同區永