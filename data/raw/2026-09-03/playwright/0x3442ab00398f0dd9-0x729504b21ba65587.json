ll,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCJYCKBU",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCJcCKBY",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCJgCKBc",null,null,null,[1],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["今天在一風堂用餐，選擇了雙人套餐，整體來說，拉麵的部分表現還不錯，湯頭濃郁，麵條彈牙，讓人滿意。但這次的用餐體驗也並非全無瑕疵，特別是一些小菜，讓我有些失望。\n\n首先，鍋貼的品質不太令人滿意，外皮過油且有些腥臭味，顯然是油炸過度，口感油膩且不新鮮。接著是薯條，這道小菜也未達預期，薯條不僅超硬，而且又過於油膩，咬下去的口感相當不佳，明顯不符合雙人套餐的水準。至於桌上的白色小菜碟，當時我並不確定它的用途，總共四個放在桌上，每個都充滿油膩感，讓人頗為困惑。我向服務生反映後，雖然換來了新的四個，但依然油膩，而且其中有一個碟子甚至帶有髒污，這對於餐廳的衛生管理來說，確實需要加強。\n\n總的來看，一風堂的拉麵表現尚可，但餐廳的細節控管，特別是在小菜的品質和餐具的清潔上，仍有待改善。希望未來能在這些方面做得更好，讓顧客有更完整的用餐體驗。",null,[0,79]]]],[null,1734332127000000,1734332127000000,"1 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04WDB1NFlDU1JuWDg3ZkFBWGFRdw%7CCAEQrcz1_gkiMAoZQ0hfQm04WDB1NFlDU1JuWDg3ZkFBWGFRdxoTQ2d3STM1M191Z1lRdzRlcXJ3RQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ_2MImQIoGA"],"https://business.google.com/local/business/10123756379004889975/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjJhemxJVDNkUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/10123756379004889975/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjJhemxJVDNkUlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/10123756379004889975/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjJhemxJVDNkUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/10123756379004889975/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjJhemxJVDNkUlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/10123756379004889975/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjJhemxJVDNkUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/10123756379004889975/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjJhemxJVDNkUlJSQUIQAA%3D%3D"],null,["zh-Hant"],[["親愛的顧客您好，\n感謝您蒞臨一風堂南港Citylink店，謝謝您的餐後反饋，以及對於拉麵的讚賞。\n很抱歉人員未留意到器皿的潔淨，我們會再加強人員碗盤的清洗流程，以提供安全舒適的用餐環境。\n祝日安\n台灣一風堂敬上 J",null,[0,93]]]],[null,null,4135,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUN2azlIT3dRRRAB!2m1!1s0x0:0x729504b21ba65587!3m1!1s2@1:CIHM0ogKEICAgICvk9HOwQE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUN2azlIT3dRRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUN2azlIT3dRRRItChZDSUhNMG9nS0VJQ0FnSUN2azlIT0lREhNDZ3dJeUp6MXVnWVFpS1R2X3dFGi4KF0NJSE0wb2dLRUlDQWdJQ3ZrOUhPb1FFEhNDZ3dJeUp6MXVnWVFpS1R2X3dFIhIJAAAAAAAAAAARh1WmG7IElXIqCzBiTUp0N1V5eDc3\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQoykImgIoGQ"],null,[null,[[1,0]]]],"0ahUKEwiNs7P1xNKWAxXSdF4EHfbPJv0Q0pMFCKMBKAY"],null,null,null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ0pMFCOwBKAY"],[["Ci9DQUlRQUNvZENodHljRjlvT2pKTldUbHNiVmh4TWxrMFVEWnhUSHBHVjFGWVYxRRAB",["0x0:0x729504b21ba65587",null,1753878646541121,1753878646541121,[null,null,["https://www.google.com/maps/contrib/103023870386877207742/reviews?hl\u003dzh-TW"],null,null,["鼠比比","https://lh3.googleusercontent.com/a-/ALV-UjWlrAk0oNhBiLErC7u1OTkzVhzaHvvaLWY5s9utWvhnlwBl0wc\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/103023870386877207742?hl\u003dzh-TW"],"103023870386877207742",null,1065,21264,null,[1,10,1],21,["在地嚮導 · 1065 則評論",null,null,null,null,[null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQpr8GCJwCKAA"]]]],null,"1 年前",null,null,null,null,null,null,["Google","https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,1],[[4],null,[["CIABIhDUVXsNtwbFoWMgk3sDtgFr",["CIABIhDUVXsNtwbFoWMgk3sDtgFr",10,10,null,null,null,["https://lh3.googleusercontent.com/grass-cs/ACvp