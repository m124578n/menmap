,[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3YcHCGwoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCGsoEA",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_400_TO_600"],"$400-600",2,null,"$400 到 $600","0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3YcHCG4oAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCG0oEQ",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCG8oEg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCHAoEw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCHEoFA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_SUITABLE_FOR_ALL"],"多人聚餐/單人用餐皆宜",2,null,null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3YcHCHMoAA"]]],null,"用餐人數",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCHIoFQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3YcHCHUoAA"]]],null,"座位類型",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCHQoFg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["拉麵湯頭走濃厚系路線：豚骨白湯香氣很夠、湯面油脂細緻但不會太膩，叉燒口感軟嫩不乾柴，搭配青蔥、木耳等配料，吃起來更有層次也比較不容易膩。半熟蛋熟度漂亮，蛋黃濃郁加分。\n\n同行家人點了辣肉味噌「大辣」，入口其實不太覺得很辣，辣度偏溫和，是味噌香氣與濃度比較突出；但很神奇的是吃到一半頭頂會不自覺一直冒汗，屬於「不辣嘴、但很熱很開胃」的那種辣，整體滿過癮的。\n\n小菜也很加分：毛豆調味剛好、薯條酥脆不油，唐揚雞外酥內嫩，配醬料或直接吃都好吃。最驚喜的是辣豆芽，只有一點點辣度，小朋友也完全可以接受，反而會一口接一口停不下來；而且可以免費續點，超適合拿來解膩、配麵一起吃。\n\n甜點也值得一提：花生煉乳團子是熱的，搭上花生粉香氣很濃，但甜度拿捏得剛好，不會甜膩，當作收尾很舒服。\n\n環境明亮、座位舒適，桌面與餐具整潔；出餐速度正常，尖峰時段可能需要稍等，但服務態度友善、用餐節奏流暢。下次會想再來試不同口味或加點配料。",null,[0,83]]]],[null,null,null,null,null,"https://business.google.com/local/business/10123756379004889975/customers/reviews