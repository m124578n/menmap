SPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCLQBKBM",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3YcHCLYBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjWo6f1xNKWAxVJjq8BHRm6LdgQ3IcHCLUBKBQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["我點的是辣肉味噌玉子拉麵，屬於濃稠湯底，表面就如同傳統拉麵帶有一些味道油光，但口味適中，不會太鹹也不會油膩，還蠻好喝的，麵條偏細，但是很有嚼勁（我選的硬度是一般），我選的中等辣度很剛好，不會不夠辣；煎餃比一般台灣的煎餃還要小一些，很好吃，很意外咬下去的時候裡面會微微的出水，搭配他的醋醬油其實味道很剛好，可惜我的煎餃裡面有兩顆黏在一起，我試圖分開他們，但他們卻破掉了，這裡感覺有點扣分；有雞胸肉做成的雞肉叉燒，是有微微調味過的、不是清水煮過而已，感覺比較健康；現場還有招待辣豆芽。",null,[0,240]]]],[null,null,null,null,null,"https://business.google.com/local/business/10123756379004889975/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnM1TUZGVVFrUmllbVJJWWpCc2FVNVZNWHBUV0dScVRVZEpNbFF4UlJBQhAA",[null,null,null,"/local/business/10123756379004889975/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnM1TUZGVVFrUmllbVJJWWpCc2FVNVZNWHBUV0dScVRVZEpNbFF4UlJBQhAA"],"https://business.google.com/local/business/10123756379004889975/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnM1TUZGVVFrUmllbVJJWWpCc2FVNVZNWHBUV0dScVRVZEpNbFF4UlJBQhAA",[null,null,null,"/local/business/10123756379004889975/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnM1TUZGVVFrUmllbVJJWWpCc2FVNVZNWHBUV0dScVRVZEpNbFF4UlJBQhAA"],null,"https://business.google.com/local/business/10123756379004889975/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnM1TUZGVVFrUmllbVJJWWpCc2FVNVZNWHBUV0dScVRVZEpNbFF4UlJBQhAA",[null,null,null,"/local/business/10123756379004889975/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnM1TUZGVVFrUmllbVJJWWpCc2FVNVZNWHBUV0dScVRVZEpNbFF4UlJBQhAA"]],[null,null,5497,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2s5MFFUQkRiemRIYjBsaU5VMXpTWG