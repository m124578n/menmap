,[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_LOUD"],"吵雜，但還是能交談",2,null,null,"0ahUKEwiU8J-exdKWAxXXjK8BHaSZN_YQ3YcHCM8BKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiU8J-exdKWAxXXjK8BHaSZN_YQ3IcHCM4BKAc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["《熟悉的日式家常味｜大戶屋南港車站店》\n\n在 大戶屋南港車站店 用餐，依舊是熟悉的日式家庭料理風味，無論是一個人吃飯或和家人朋友聚餐，都能輕鬆享受一頓美味餐點。\n\n店內提供各式日式定食、丼飯、烤魚、炸物等料理，每份定食都搭配白飯、味噌湯與小菜，營養均衡又有飽足感。餐點調味清爽、不過於油膩，很符合日式家常料理的特色。\n\n餐廳位於南港車站內，交通便利，環境乾淨舒適，服務親切，出餐速度也相當穩定，是逛街、搭車前後都很方便的用餐選擇。\n\n整體而言，大戶屋一直維持穩定的品質，想吃一份簡單又有溫度的日式定食時，這裡會是值得再訪的餐廳。\n\n#大戶屋\n#南港車站店\n#日式定食\n#日本料理\n#台北美食\n#南港美食\n#家庭聚餐\n#日式家常料理",null,[0,80]]]],[null,null,null,null,null,"https://business.google.com/local/business/9276281855465162693/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR2TVU0eVdrUlBWbEpGVTFSUk0xTXdTbmRrTVZwSFdrVm5NMk14UlJBQhAA",[null,null,null,"/local/business/9276281855465162693/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR2TVU0eVdrUlBWbEpGVTFSUk0xTXdTbmRrTVZwSFdrVm5NMk14UlJBQhAA"],"https://business.google.com/local/business/9276281855465162693/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR2TVU0eVdrUlBWbEpGVTFSUk0xTXdTbmRrTVZwSFdrVm5NMk14UlJBQhAA",[null,null,null,"/local/business/9276281855465162693/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR2TVU0eVdrUlBWbEpGVTFSUk0xTXdTbmRrTVZwSFdrVm5NMk14UlJBQhAA"],null,"https://business.google.com/local/business/9276281855465162693/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR2TVU0eVdrUlBWbEpGVTFSUk0xTXdTbmRrTVZwSFdrVm5NMk14UlJBQhAA",[null,null,null,"/local/business/9276281855465162693/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnR2TVU0eVdrUlBWbEpGVTFSUk0xTXdTbmRrTVZwSFdrVm5NMk14UlJBQhAA"]],[null,null,293,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tvMU4yWkRPVlJFU1RRM1MwSndkMVpHWkVnM2MxRRAB!2m1!1s0x0:0x55e2fe