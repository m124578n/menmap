ps8Gx1Bpsfa6Hwwq\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x7d04ce064665ff5b"]],1,null,null,null,null,null,null,["0","9008551680994049883"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUN5bTRmQ0VREAE"]],"CIABIhCGDjfPps8Gx1Bpsfa6Hwwq",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ3YcHCJ8BKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ3IcHCJ4BKA0",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:BRUNCH"],"早午餐",2,null,null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ3YcHCKEBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ3IcHCKABKA4",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ3YcHCKMBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ3IcHCKIBKA8",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ3IcHCKQBKBA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ3IcHCKUBKBE",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ3IcHCKYBKBI",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["豆皮甜甜蠻好吃的～\n-\n後悔點照燒雞肉丼，製作快速，口感粗糙，尤其是美乃滋會讓整碗味道超膩！\n-\n晚上八點多來用餐點了麻婆豆腐，麵端上桌時外觀感覺和圖片有些落差（自己加了蔥花就又還好。麻婆豆腐麵不會不好吃但豆腐有點少，醬汁不多但口味算是重的。今天另一些狀況是1. 煮麵要等（之前很快，可能接近打烊人手不多 2. 盤上的炸物品項接近空 ，每位客人都在等 3.結帳系統連不上網路 4. 後台負責打烊的兩位男店員，清洗收拾器具都用丟的，不但觀感不太好，客人用餐的同時也製造了些聲音影響用餐環境\n-\n豬肉口感不錯～工作人員態度非常親切、熱情正向！\n-\n本店限定花蛤烏龍麵_點餐後工作人員立即拿出一包蛤蠣真空包加熱，蛤蠣超多，湯清加上蔥花蒜泥和胡椒粉味道很不錯！以這個價錢真的划算！\n-\n牛肉蛋拌烏龍麵_乾烏龍麵拌蛋口感滑順，牛肉鹹甜好吃，再配上一盤炸物，簡單美味。下了捷運來這吃完上樓剛好公車也到站直接上車，一切都剛剛好。來這裡吃過很多次，覺得這間店的管理好，工作人員都服務很到位！\n-\n用餐時間蠻多人的，內用場地寬敞目前還沒有其他飲食店，在新店捷運站有丸龜製麵，方便快速算是多了一個還不錯的選擇。",null,[0,46]]]],[null,1655176237000000,1696470143000000,"上次編輯：2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQ21WRGdwd0FaT1JrWUYtcUFBanBhQQ%7CCAEQrcz1_gkiMAoZQ0hfQ21WRGdwd0FaT1JrWUYtcUFBanBhQRoTQ2d3SV82ajRxQVlReXZhVG1nTQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ_2MIpwEoEw"],"https://business.google.com/local/business/1871203146827534779/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjViVFJtUTBWUkVBRRAA",[null,null,null,"/local/business/1871203146827534779/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjViVFJtUTBWUkVBRRAA"],"https://business.google.com/local/business/1871203146827534779/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjViVFJtUTBWUkVBRRAA",[null,null,null,"/local/business/1871203146827534779/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjViVFJtUTBWUkVBRRAA"],null,"https://business.google.com/local/business/1871203146827534779/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjViVFJtUTBWUkVBRRAA",[null,null,null,"/local/business/1871203146827534779/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjViVFJtUTBWUkVBRRAA"],null,["zh-Hant"],[["謝謝您的喜愛，歡迎再次光臨^^",null,[0,15]]]],[null,null,12902,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUN5bTRmQ0VREAE!2m1!1s0x0:0x7d04ce064665ff5b!3m1!1s2@1:CIHM0ogKEICAgICym4fCEQ%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUN5bTRmQ0VREAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUN5bTRmQ0VREiYKF0NJSE0wb2dLRUlDQWdJQ3ltNGZDa1FFEgswY1JHT2JxSzRORRosChZDSUhNMG9nS0VJQ0FnSUN5bTRmQ1VREhJDZ3NJNTY3ZHVRWVE0S1gwSlEiEgkAAAAAAAAAABFb_2VGBs4EfSoLMGNSR09icUs0TkU\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQoykIqAEoFA"],null,[null,[[1,3]]]],"0