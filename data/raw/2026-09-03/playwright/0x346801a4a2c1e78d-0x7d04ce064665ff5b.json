null,null,null,null,null,null,["zh-Hant"],[["#來碧潭風景區看風景💓，漫遊💓\n#回程先到碧潭廣場B1，遇見丸龜製麵😄，炸魚、炸雞、炸花枝～每次必點這三樣，魚好新鮮，肉質厚度夠滿足饕客的味蕾～^_^～吃🉐️真開心😄～吃飽～^_^～再搭捷運回家；輕鬆愉快😄～\n#不用下廚烹調，不用洗碗，不用整理清潔廚房😁～\n#把你妳的時間用在更讚的事上，煮飯真的很累，自己煮的又不好吃的時候，一起吃飯的家人會吃得很勉強，又不敢說難吃😆🤣😆😆🤣😆🤣\n#出門去旅行，享受當地的美食，天天開心快樂💞丸龜製麵～好吃，不貴喔😄\n#加入line 集點數，可換餐點，🉑換好禮（外面買不到的，丸龜專屬💞）\n\n💕來碧潭風景區看風景，一定來丸龜製麵吃晚餐，吃飽，快樂搭捷運💓回家😄",null,[0,104]]]],[null,1715060562000000,1715060562000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQ0RkRkZEQUlJMWxtT2I5U0FBRDhYQQ%7CCAEQrcz1_gkiLwoZQ0hfQ0RkRkZEQUlJMWxtT2I5U0FBRDhYQRoSQ2dzSTB2N21zUVlRb1o3V0d3\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjMg-O3ytKWAxWxlK8BHcHzHhQQ_2MIogIoOA"],"https://business.google.com/local/business/1871203146827534779/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnFNMkpxWVdsUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/1871203146827534779/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnFNMkpxWVdsUlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/1871203146827534779/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnFNMkpxWVdsUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/1871203146827534779/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnFNMkpxWVdsUlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/1871203146827534779/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnFNMkpxWVdsUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/1871203146827534779/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUnFNMkpxWVdsUlJSQUIQAA%3D%3D"],null,["zh-Hant"],[["謝謝您的喜愛，歡迎再次光臨^^",null,[0,15]]]],[null,null,7491,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURqM2JqYWlRRRAB!2m1!1s0x0:0x7d04ce064665ff5b!3m1!1s2@1:CIHM0ogKEICAgIDj3bjaiQE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSURqM2JqYWlR