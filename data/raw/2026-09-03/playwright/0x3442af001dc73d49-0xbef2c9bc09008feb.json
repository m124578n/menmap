UoAA"]],1],null,null,"訂單類型",null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3IcHCFQoBw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3YcHCFcoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3IcHCFYoCA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3IcHCFgoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3IcHCFkoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3IcHCFooCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3YcHCFwoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3IcHCFsoDA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3YcHCF4oAA"]]],null,"用餐人數",null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q3IcHCF0oDQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這天中午，我們前往北投進行假日小旅行，找了一下新北投附近的素食店，似乎不是沒營業，不然就是沒有我們都喜歡的拉麵麵食選項，突然看到地圖有一個素食壽司拉麵，離捷運站不遠，剛好是我們路途會經過的點。\n\n提前於石牌站下車，步行約8~10分鐘，邊散步邊聊著我們意猶未竟的話題，沿著捷運高架下的公園，很快就到素食壽司拉麵店。\n\n店面不大，約可容納二個客人，剛好還沒人，我們趕緊把東西放下，選我們想要的麵。\n\n我們選了福井白醬拉麵、味噌蔬菜拉麵，蔬菜很多，跟麵條的比率約2:3，所以一口麵搭配一小撮菜，口感很爽口。\n\n最後吃完我們還覺得沒吃飽，又再多點了咖哩拉麵，可惜忘了問老闆娘咖哩是乾的還是湯，因為我們都喜歡喝湯，雖然少了點湯頭，整個吃完仍滿滿的飽足感，我們就一路繼續走到其哩岸捷運站。",null,[0,96]]]],[],[null,null,1389,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xBNVNYYzFTVkJ1YVc1UGVURlpWRU0yZEd4RmMwRRAB!2m1!1s0x0:0xbef2c9bc09008feb!3m1!1s2@1:CAIQACodChtycF9oOlA5SXc1SVBuaW5PeTFZVEM2dGxFc0E%7C%7C?hl\u003dzh-TW"],["https://www.google.co