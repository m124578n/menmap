ass-cs/ACvplmObKqlktoXPZnn9MZG0ccEF9RQ_ZXu3hwaZ60eDrkDLenIm6-R5gT3X8Hg7KMpPT0wg5Vk3CXHnpf2xZY7jCsTev1ipbG0wwZt8AERt-qvaBNQB1Nza02nmMIGVXDCPqMWQxdcUsEaWRxuO\u003dk-no",null,[2268,4032]],null,[[3,121.51309863877172,25.117296003172022],[0,90],[2268,4032],75],"AHiZasLDGMHx1e8P7d2L8A4","0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4QzCcIlgEoBw",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDDido6nDbs-HK7ZARTY6WY\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xbef2c9bc09008feb",null,null,"0ahUKEwjCw9D6w9KWAxXBePUHHe3uAu4Q-y4IlwEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhDDido6nDbs-HK7ZARTY6WY"],[10,3,[4032,2268]],[null,null,null,null,null,null,null,["春 素食壽司拉麵店"]],[null,[[["老賓喵"],"https://www.google.com/maps/contrib/106330053537380358963?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjWCCpvTq_x14bURw3JqDVIo-ricKGGI6nbbitAw1KMmFR6Vo7I\u003ds120-c-rp-mo-ba12-br100",null,null,"106330053537380358963"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2025,11,13,12,null,null,null,null,["9 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDDido6nDbs-HK7ZARTY6WY\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xbef2c9bc09008feb"]],1,null,null,null,null,null,null,["0","-4687462452697198613"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2paM01scERlSEpSYTFOR1ZIZEtlVWRpTFhKMlZGRRAB"]],"CIABIhDDido6nDbs-HK7ZARTY6WY",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["在這裡用餐是一種很的特殊的體驗，會讓你感覺是在日本用餐，而且是為了你倆而開的店（包場）。因為座位只有兩個。\n以台北物價來說，這家店的性價比非常高，因為老闆娘很堅持用好的食材來料理。尤其那個飯糰與咖哩飯都是用同一種米來料理，但都相當的好吃。老闆娘說米是用比較好的米。老闆娘對於自己的東西相當有自信。這點我想當肯定。\n\n今日吃了兩碗拉麵，一碗咖哩飯，一個飯糰，以及外帶一盒豆皮壽司（最後一盒）。總共消費才500元。兩個人去吃的超飽！\n\n很推薦有來石牌站的朋友，可以來這裡吃看看美味的全素料理。這裡的蛋是要額外加錢的，料理都是全素為主。來這裡用餐的體驗真的很特殊。大推！！！",null,[0,156]]]],[],[null,null,3958,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sC