1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3YcHCKkBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3IcHCKgBKAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3YcHCKsBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3IcHCKoBKA0",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3IcHCKwBKA4",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3IcHCK0BKA8",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3IcHCK4BKBA",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11ld27v2pd"],"溏心蛋",2,null,null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3YcHCLABKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3IcHCK8BKBE",null,null,null,null,null,3,null,2],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3YcHCLIBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwikhJjfw9KWAxWIQ_UHHfXdA2YQ3IcHCLEBKBI",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["🍜好吃、價格也不貴的拉麵店。\n\n這家店位在捷運北投站步行3分鐘不到的位置，是前往北投市場/新北投方向的要道，之前經過曾經看到有不少人排隊，就存進名單，剛好這次路過沒人，就進來吃吃了！\n\n拉麵基本配料是一片海苔+三片雞叉燒，佐料的部分有洋蔥、青蔥段、檸檬。照片裡的拉麵是有另外加雞叉燒和溏心蛋。\n\n先來講基本的湯跟麵吧！\n湯頭部分沒話說，雞湯熬得夠久，雞味非常濃厚。我這次先試喝最基本款、原味的雞白湯底，但有勾選加重口味，大概就是某些拉麵店會區分的日本濃/台灣濃。不過加重後確實挺鹹的，如果不習慣吃日本味拉麵的要慎選。\n麵體是採用細麵，雖然我比較喜歡粗一點兒的麵體，口感比較好，不過因為這家會煮得偏硬，抵銷掉細麵泡在湯裡後容易變糊的問題，因此口感上是可以過關的！\n溏心蛋，如照片呈現，蛋白也是沒有完全固化。像我自己是更愛吃蛋白凝固但蛋黃還沒凝固的那種溏心蛋，不過這家的蛋味道是不錯的。\n\n整體來說，我覺得這家的拉麵吃起來相當舒服，而且價格適中，基本款的配料有點少但價格也不高。\n\n環境上面，確實比較簡陋，但不至於糟糕。原本經過時看起來就像辦活動設攤的那種帳篷拉出來的空間，甚至很擔心炎炎夏日裡面會很熱，但挺意外裡面還有裝冷氣，至少當天吃起來是沒到不舒適。但空間確實比較狹窄、擁擠一些，內用也只有八個席位，無洗手間但有提供洗手台。\n可以外帶、也可以電話訂餐。\n\n付款方式，目前似乎支援現金跟Line Pay.",null,[0,91]]]],[null,null,null,null,null,"https://business.google.com/local/business/1508758073159859852/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrYldGR1NuWk1WM0IxVFd0d2FXUkVUbFZOZW1oMFVXdGtjMDlIWXhBQhAA",[null,null,null,"/local/business/1508758073159859852/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrYldGR1NuWk1WM0IxVFd0d2FXUkVUbFZOZW1oMFVXdGtjMDlIWXhBQhAA"],"https://business.google.com/local/business/1508758073159859852/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrYldGR1NuWk1WM0IxVFd0d2FXUkVUbFZOZW1oMFVXdGtjMDlIWXhBQhAA",[null,null,null,"/local/business/1508758073159859852/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrYldGR1NuWk1WM0IxVFd0d2FXUkVUbFZOZW1oMFVXdGtjMDlIWXhBQhAA"],null,"https://business.google.com/local/business/1508758073159859852/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrYldGR1NuWk1WM0IxVFd0d2FXUkVUbFZOZW1oMFVXdGtjMDlIWXhBQhAA",[null,null,null,"/local/business/1508758073159859852/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhrYldGR1NuWk1WM0IxVFd0d2FXUkVUbFZOZW1oMFVXdGtjMDlIWXhBQhAA"]],[null,null,10856,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xkbWFGSnZMV3B1TWtwaWRETlVNemh0UWtkc09HYxAB!2m1!1s0x0:0xf4f4be6f911aa319!3m1!1s2@1:CAIQACodChtycF9oOldmaFJvLWpuMkpidDNUMzhtQkdsOGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xkbWFGSnZMV3B1TWtwaWRETlVNemh0UWtkc09HYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xkbWFGSnZMV3B1TWtwaWRETlVNemh0UWtkc09HYxI-Ci9DQUlRQUNvZENodHljRjlvT2xkbWFGSnZMV3B1TWtwaWRETlVNemh0UWtkc09HYxILMGNzczNlNWJpZzEaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sZG1hRkp2TFdwdU1rcGlkRE5VTXpodFFrZHNPR2MSCzBjc3MzZTViaWcxIhIJAAAAAAAAAAARGaMakW--9PQqC