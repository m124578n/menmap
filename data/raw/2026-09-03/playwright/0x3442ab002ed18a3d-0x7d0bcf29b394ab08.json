WAxUDiq8BHYfDInIQ3IcHCIMBKAM",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjQke6awdKWAxUDiq8BHYfDInIQ3IcHCIUBKAQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjQke6awdKWAxUDiq8BHYfDInIQ3IcHCIYBKAU",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjQke6awdKWAxUDiq8BHYfDInIQ3IcHCIcBKAY",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["連細節都不馬虎，一碗真正能打動人心的上乘拉麵。\n\n主角的超級濃牛肉麵自然不用多說，濃郁的滋味，完全沒有令人失望。\n\n更讓我驚豔的，還有桌上的那些配角。\n\n蒜泥、辣醬、特製調味料，每一種都不是為了存在而存在，而是經過仔細設計，能替同一碗麵帶來截然不同的風味層次。即使吃到最後，依然能透過不同搭配感受到新的變化。\n\n單點的漢堡排更是精彩。\n\n無論是淋醬、火候，還是漢堡排本體，都有足以獨立開設專門店的水準，完全不是一道隨手搭配的配餐，而是一道值得被認真品嚐的料理。\n\n當每一道料理、每一個細節，都維持著這樣的完成度，也就不難理解，為什麼這間店每天需要花費大量時間準備，也因此始終無法延長營業時間。\n\n或許，唯一讓人想挑剔的，反而不是料理本身。\n\n而是它實在太難吃到了。",null,[0,56]]]],[null,null,null,null,null,"https://business.google.com/local/business/10469682739376971649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VFZkcVRsWldWekYyVWxjNVFrMUdiR3BaZWtFMVVqTk5OV1ZIWXhBQhAA",[null,null,null,"/local/business/10469682739376971649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VFZkcVRsWldWekYyVWxjNVFrMUdiR3BaZWtFMVVqTk5OV1ZIWXhBQhAA"],"https://business.google.com/local/business/10469682739376971649/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VFZkcVRsWldWekYyVWxjNVFrMUdiR3BaZWtFMVVqTk5OV1ZIWXhBQhAA",[null,null,null,"/local/business/10469682739376971649/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VFZkcVRsWldWekYyVWxjNVFrMUdiR3BaZWtFMVVqTk5OV1ZIWXhBQhAA"],null,"https://business.google.com/local/business/10469682739376971649/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF3VFZkcVRsWldWekYyVWxjNVFrMUdiR3BaZWtFMVVqTk5OV1ZIWXhBQhAA",[null,null,null,"/local/business/10469682739376971649/customers/reviews/reply?p\u003dCkRDa