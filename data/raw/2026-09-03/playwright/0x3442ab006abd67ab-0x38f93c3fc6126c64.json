null,[[["盧婕瀅"],"https://www.google.com/maps/contrib/110188485879628088719?hl\u003dzh-TW","https://lh3.googleusercontent.com/a/ACg8ocKgrriVlsqtQwEUuNbTHWxerZA_gx9fRcHf_UK1m17S_RDuSg\u003ds120-c-rp-mo-ba12-br100",null,null,"110188485879628088719"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2020,6,24,9,null,null,null,null,["6 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIC8mJLHjwE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x38f93c3fc6126c64"]],1,null,null,null,null,null,null,["0","4105378779928620132"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUM4bUpMNDBnRRAB"]],"CIHM0ogKEICAgIC8mJLHjwE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["今日Order\n豚骨拉麵$280\n味噌拉麵$280\n黃金豬排飯$180\n外加一份套餐+$120(唐揚雞or煎餃or叉燒飯三選一+飲品(NT.60)\n首先登場的飲料…可爾必思去冰，就是你可以想想到的味道XD\n接著唐揚雞上桌了\n一盤四大塊，邊角附上日式沙拉醬，黃金外皮不難想像它的酥脆，一口咬下，肉汁滴到盤中，十分多汁，但熱騰騰的，怕燙的或小朋友都要小心喔!!\n味噌拉麵\n好大的一碗麵啊!!熱騰騰香呼呼的，先喝一口湯，果然濃郁，比較像關東的口味顏色較深，味道偏重，適合吃重鹹的我，我愛。再吃一口麵，麵條本體是由日本麵粉製作而成，難怪Ｑ彈富有嚼勁，兩片約手掌大小的叉燒肉，油花分布均勻而且吸了滿滿的湯汁，一口咬下有不同的層次在口中散開，很可以。還有一整顆煮的剛剛好的糖心蛋，讓整個畫面更加協調。\n豚骨拉麵\n配置跟味增拉麵是一樣的，只是比起味增拉麵，鹹味淡一點，但一樣呈現出濃郁的乳白色，而且因為鹹味淡些，更喝得出充滿豚骨精華的湯頭。\n黃金豬排飯\n小巧可愛的碗裝，適合小鳥味的捧油們喔!!豬排很厚實，從切面看來，肉質扎實，外層裹著一層薄薄的粉，不會搶走肉質的鮮味，卻可以將肉汁鎖在裡面，一口咬下，外皮酥脆肉質不老柴，是好吃的。\n整體下來，雖沒有特別驚豔，但符合一般拉麵的水準，有空經過可以來試試。",null,[0,25]]]],[],[null,null,4286,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUM4bUpMNDBnRRAB!2m1!1s0x0:0x38f93c3fc6126c64!3m1!1s2@1:CIHM0ogKEICAgIC8mJL40gE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUM4bUpMNDBnRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnSUM4bUpMNDBnRRItChZDSUhNMG9nS0VJQ0FnSUM4bUpMNE1nEhNDZ3dJeExfTTl3VVFzT1d6MlFJGi4KF0NJSE0wb2dLRUlDQWdJQzhtSkw0c2dFEhNDZ3dJeExfTTl3VVFzT1d6MlFJIhIJAAAAAAAAAAARZGwSxj88-TgqCzBUd20wRm11c3FG\u0026wv\u003d1\u0026d\u003d286732320",null,null