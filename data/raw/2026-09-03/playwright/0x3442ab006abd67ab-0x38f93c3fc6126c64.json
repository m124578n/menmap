IcHCFgoAw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjK39y3vtKWAxV3oa8BHcQVDjEQ3IcHCFooBA",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjK39y3vtKWAxV3oa8BHcQVDjEQ3IcHCFsoBQ",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjK39y3vtKWAxV3oa8BHcQVDjEQ3IcHCFwoBg",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjK39y3vtKWAxV3oa8BHcQVDjEQ3YcHCF4oAA"]],1],null,null,"等待時間",null,"0ahUKEwjK39y3vtKWAxV3oa8BHcQVDjEQ3IcHCF0oBw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["想用最高的價格吃到最廉價的拉麵嗎？那你來對地方了，在這裡你可以享用最腥的叉燒片，最不熱的湯，加超多蔥的拉麵，湯不是不好喝，但那一大堆的蔥擺在上面你也喝不到味道。\n很後悔沒有先看這家店的評論，吃完後覺得這是有史以來最難吃最貴的拉麵，外面隨便一家就算味道不好也算對得起價格，而這家真的是優點沒有，缺點倒是一堆。\n想吃好的，附近的一蘭拉麵推薦給你，想吃天婦羅，何不去吃丸龜製麵。\n這家拉麵店的出現讓我知道以前吃的已經是良物，媽媽說得好，多走出去看看外面的世界，長點見識，才知道自己已在舒適圈",null,[0,153]]]],[],[null,null,843,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xsQlJXMXVNR3hPUkd0UFYwMVhTMWN3YjBJNVVVRRAB!2m1!1s0x0:0x38f93c3fc6126c64!3m1!1s2@1:CAIQACodChtycF9oOllBRW1uMGxORGtPV01XS1cwb0I5UUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xsQlJXMXVNR3hPUkd0UFYwMVhTMWN3YjBJNVVVRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xsQlJXMXVNR3hPUkd0UFYwMVhTMWN3YjBJNVVVRRI-Ci9DQUlRQUNvZENodHljRjlvT2xsQlJXMXVNR3hPUkd0UFYwMVhTMWN3YjBJNVVVRRILMGRiU3Uwcm5lNmIaPgovQ0FJUUFDb2RDaHR5Y0Y5b09sbEJSVzF1TUd4T1JHdFBWMDFYUzFjd2IwSTVVVUUSCzBkYlN1MHJuZTZiIhIJAAAAAAAAAAARZGwSxj88-TgqCzBkYlN1MHJuZTZi\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjK39y3vtKWAxV3oa8BHcQVDjEQoykIXygI"],null,[null,[[1,0]]]],"0ahUKEwjYleO3vtKWAxWrbV4EHWTbLf0Q0pMFCA8oAQ"],null,null,null,"0ahUKEwjK39y3vtKWAxV3oa8BHcQVDjEQ0pMFCFIoAQ"],[["ChdDSUhNMG9nS0VJQ0FnSUNLeU