\n店內有廁所亦有檸檬開水\n現在支援現金跟全支付 LinePay",null,[0,35]]]],[null,null,null,null,null,"https://business.google.com/local/business/6369948001229225199/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxV1U0elRtbGFSVGxHVmxkV05HVkhaRWxSYWtwWVRsaEdUVkZWUlJBQhAA",[null,null,null,"/local/business/6369948001229225199/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxV1U0elRtbGFSVGxHVmxkV05HVkhaRWxSYWtwWVRsaEdUVkZWUlJBQhAA"],"https://business.google.com/local/business/6369948001229225199/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxV1U0elRtbGFSVGxHVmxkV05HVkhaRWxSYWtwWVRsaEdUVkZWUlJBQhAA",[null,null,null,"/local/business/6369948001229225199/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxV1U0elRtbGFSVGxHVmxkV05HVkhaRWxSYWtwWVRsaEdUVkZWUlJBQhAA"],null,"https://business.google.com/local/business/6369948001229225199/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxV1U0elRtbGFSVGxHVmxkV05HVkhaRWxSYWtwWVRsaEdUVkZWUlJBQhAA",[null,null,null,"/local/business/6369948001229225199/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxV1U0elRtbGFSVGxHVmxkV05HVkhaRWxSYWtwWVRsaEdUVkZWUlJBQhAA"]],[null,null,2616,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT201WU4zTmlaRTlGVldWNGVHZElRakpYTlhGTVFVRRAB!2m1!1s0x0:0x1baf625062148bdd!3m1!1s2@1:CAIQACodChtycF9oOm5YN3NiZE9FVWV4eGdIQjJXNXFMQUE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT201WU4zTmlaRTlGVldWNGVHZElRakpYTlhGTVFVRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT201WU4zTmlaRTlGVldWNGVHZElRakpYTlhGTVFVRRI-Ci9DQUlRQUNvZENodHljRjlvT201WU4zTmlaRTlGVldWNGVHZElRakpYTlhGTVFVRRILMGRkbGV5LWI0VEEaPgovQ0FJUUFDb2RDaHR5Y0Y5b09tNVlOM05pWkU5RlZXVjRlR2RJUWpKWE5YRk1RVUUSCzBkZGxleS1iNFRBIhIJAAAAAAAAAAAR3YsUYlBirxsqCzBkZGxleS1iNFRB\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwilpseVzdKWAxUgo