0ahUKEwjZ-q2SwNKWAxVYY_UHHQZcHbUQ3IcHCIMBKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjZ-q2SwNKWAxVYY_UHHQZcHbUQ3IcHCIQBKA0",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjZ-q2SwNKWAxVYY_UHHQZcHbUQ3IcHCIUBKA4",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["從大坪林捷運站五號出口往裕隆城路過，平日晚餐時間不用排隊，店內約10個座位，是桌邊點餐，餐後現金付款。\n雞清湯拉麵一碗320，價格偏貴，但若多選擇加肉30元，感覺就稍微合理一些，加肉能選擇雞叉燒或豬叉燒。\n湯頭不像鷹流那種直拳型，雞湯的香氣比較淡，自製醬油入湯，喝起來溫潤順口，鹹度不會太高，是一碗可以順順吃完沒什麼負擔的拉麵，醬油香氣也能在口中停留不少時間。\n能調整的部分有麵的軟硬度，與蔥/洋蔥兩者，個人選擇麵硬，麵體相當彈牙好吃。\n拉麵配置海苔、溏心蛋、兩個雞肉丸、一片豬叉燒，溏心蛋調味沒有很重，搭配湯頭鹹度處理得恰到好處；雞肉丸有吃到一點軟骨部分，沒什麼腥味，個人是喜歡的；豬叉燒有炙燒過，香氣十足，只可惜油花略多，又有部分瘦肉略為乾柴，是今天表現比較差的地方。\n進來用餐的貌似都是常客，老闆娘都能夠立刻說出客人喜歡的配置，感覺還不錯，非常溫馨，有路過的話可以來試試看。",null,[0,180]]]],[null,null,null,null,null,"https://business.google.com/local/business/1651202929112204821/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwU1dWVk1XeFBSVFExV2tVeFNWUnNiRTVTU0VaYVUwY3hSMWt4UlJBQhAA",[null,null,null,"/local/business/1651202929112204821/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwU1dWVk1XeFBSVFExV2tVeFNWUnNiRTVTU0VaYVUwY3hSMWt4UlJBQhAA"],"https://business.google.com/local/business/1651202929112204821/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwU1dWVk1XeFBSVFExV2tVeFNWUnNiRTVTU0VaYVUwY3hSMWt4UlJBQhAA",[null,null,null,"/local/business/1651202929112204821/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwU1dWVk1XeFBSVFExV2tVeFNWUnNiRTVTU0VaYVUwY3hSMWt4UlJBQhAA"],null,"https://business.google.com/local/business/1651202929112204821/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwU1dWVk1XeFBSVFExV2tVeFNWUnNiRTVTU0VaYVUwY3hSMWt4UlJBQhAA",[null,null,null,"/local/business/1651202929112204821/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnQwU1dWVk1XeFBSVFExV2tVeFNWUnNiRTVTU0VaYVUwY3hSMWt4UlJ