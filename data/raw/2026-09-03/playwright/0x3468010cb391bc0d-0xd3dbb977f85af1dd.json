ll,null,"服務",null,"0ahUKEwjZ-q2SwNKWAxVYY_UHHQZcHbUQ3IcHCE4oAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjZ-q2SwNKWAxVYY_UHHQZcHbUQ3IcHCE8oBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjZ-q2SwNKWAxVYY_UHHQZcHbUQ3YcHCFEoAA"]],1],null,null,"等待時間",null,"0ahUKEwjZ-q2SwNKWAxVYY_UHHQZcHbUQ3IcHCFAoBQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["今天颱風天，意外發現這家拉麵店竟然有營業！老闆娘非常熱情又親切地招呼我們一家人。雖然今天只有她一個人忙進忙出，但動作俐落得讓人佩服，很快就把炸豆腐和唐揚雞送上桌，真的很厲害。\n我們一家人點的都是紅油雞白湯拉麵，湯頭非常濃郁香醇，帶點微辣卻不會過於刺激；麵條口感也恰到好處，不會因為泡在湯裡太久而變得軟爛，每一口都讓人覺得很滿足。\n在這樣的天氣裡，能夠吃到這麼用心的一碗拉麵，真的覺得很開心，也感受到店家的溫暖。推薦給大家，有機會一定要來試試！",null,[0,221]]]],[null,null,null,null,null,"https://business.google.com/local/business/1651202929112204821/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF2TkdGVlNuQlRWMFpGWlVSV1ExSlZaSE5OTVhCc1VWaGtkMlF6WXhBQhAA",[null,null,null,"/local/business/1651202929112204821/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF2TkdGVlNuQlRWMFpGWlVSV1ExSlZaSE5OTVhCc1VWaGtkMlF6WXhBQhAA"],"https://business.google.com/local/business/1651202929112204821/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF2TkdGVlNuQlRWMFpGWlVSV1ExSlZaSE5OTVhCc1VWaGtkMlF6WXhBQhAA",[null,null,null,"/local/business/1651202929112204821/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF2TkdGVlNuQlRWMFpGWlVSV1ExSlZaSE5OTVhCc1VWaGtkMlF6WXhBQhAA"],null,"https://business.google.com/local/business/1651202929112204821/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF2TkdGVlNuQlRWMFpGWlVSV1ExSlZaSE5OTVhCc1VWaGtkMlF6WXhBQhAA",[null,null,null,"/local/business/1651202929112204821/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjF2TkdGVlNuQlRWMFpGWlVSV1ExSlZaSE5OTVhCc1VWaGtkMlF6WXhBQhAA"]],[null,null,1141,["https://www.google.com/maps