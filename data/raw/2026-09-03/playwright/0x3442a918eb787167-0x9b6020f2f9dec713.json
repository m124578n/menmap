ll,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjZg8mcv9KWAxXsjK8BHWmOJuUQ3IcHCK8BKBA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11w7lpj4bp"],"雞白湯 焦蔥油",2,null,null,"0ahUKEwjZg8mcv9KWAxXsjK8BHWmOJuUQ3YcHCLEBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwjZg8mcv9KWAxXsjK8BHWmOJuUQ3IcHCLABKBE",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwjZg8mcv9KWAxXsjK8BHWmOJuUQ3YcHCLMBKAA"]]],null,"座位類型",null,"0ahUKEwjZg8mcv9KWAxXsjK8BHWmOJuUQ3IcHCLIBKBI",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["2025/1021晚上近8點，下著大雨，附近常吃的店都沒開，只好走來永貞路覓食，意外發現這小店，店內空間不大，大概只能收10位左右的客人。\n1、湯底：鰹魚醬油、雞清湯、雞白湯、醬油豚骨可選擇。\n2、湯頭鹹度：可以依個人喜好選擇鹹、正常、淡。\n3、麵條硬度：也是可依個人喜好選擇硬、正常、軟。\n有人因為不吃肉，又討厭肉湯味，我們2人點了鰹魚醬油清湯、鹽味雞清湯；湯頭鹹度都選擇正常，比較二種湯底，我們都偏愛鹽味雞清湯，湯頭看似清淡，喝起來非常有味道好喝；麵條硬度也是選擇正常，麵條都是細麵，看起來有點硬，完全吸附湯汁吃起來軟硬適中，下次想點軟麵來試試；雞肉塊雖然很厚實，卻非常軟嫩好吃。",null,[0,120]]]],[null,null,null,null,null,"https://business.google.com/local/business/8054786247900985761/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYmxSRlRqTmFSR2hyV1d4S1MyVklVbHBVYTAxNlVUQXhkbFl6WXhBQhAA",[null,null,null,"/local/business/8054786247900985761/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYmxSRlRqTmFSR2hyV1d4S1MyVklVbHBVYTAxNlVUQXhkbFl6WXhBQhAA"],"https://business.google.com/local/business/8054786247900985761/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYmxSRlRqTmFSR2hyV1d4S1MyVklVbHBVYTAxNlVUQXhkbFl6WXhBQhAA",[null,null,null,"/local/business/8054786247900985761/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYmxSRlRqTmFSR2hyV1d4S1MyVklVbHBVYTAxNlVUQXhkbFl6WXhBQhAA"],null,"https://business.google.com/local/business/8054786247900985761/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYmxSRlRqTmFS