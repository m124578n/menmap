vUHHaKzDfcQ3YcHCKoBKAA"]]],null,"附近的停車場",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCKkBKB0",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_TIPS"],"分享停車相關資訊",null,null,"請提供停車場地點和停車位數量等資訊","停車場",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCKsBKB4",null,null,["附近自己找地方停"],null,null,3,null,2],[["GUIDED_DINING_KID_FRIENDLINESS_TIPS"],"親子友善程度",null,null,"分享親子友善程度相關資訊","親子友善程度",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCKwBKB8",null,null,["受控的孩子可以前往用餐"],null,null,3,null,2],[["GUIDED_DINING_ACCESSIBILITY_TIPS"],"無障礙設施",null,null,"分享無障礙空間相關資訊","無障礙設施",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCK0BKCA",null,null,["門口有樓梯，應該沒有無障礙設施"],null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:VEGETARIAN_OPTIONS"],"素食餐點",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCK8BKAA"],[["E:OTHER_DIETARY_RESTRICTIONS"],"特殊餐點",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCLABKAE"],[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCLEBKAI"],[["E:KID_FRIENDLINESS"],"親子友善程度",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCLIBKAM"],[["E:ACCESSIBILITY"],"無障礙設施",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCLMBKAQ"]]],null,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCK4BKCE",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["在肥宅我公司附近，經過幾次太太體驗想嘗試看看，終於找到機會前往。\n太太點了他的黑蒜頭雞白湯拉麵，我覺得整體口味很好，麵也可以調整硬度，是細麵那種拉麵，湯頭是滿滿的蒜香味，我覺得拉麵給過。\n我點了叉燒丼跟勝丼，叉燒丼非常好吃，肉給的很多上面淋上美乃滋，我覺得非常好吃，而且CP值也很高。勝丼…是我唯一想要批評的餐點，肉柴到不行，醬汁沒有味道，雖然有提供更多醬汁，但是味道也不對，我是覺得乾脆可以取消這個品項，真的極度差評。\n其他的小菜我們覺得都很好吃，筍乾更是滿滿一盤，不是小氣給你3-5片。\n味噌湯我覺得也還不錯，但是就也沒什麼特別。\n服務我覺得算中上，算是親切有禮貌。",null,[0,93]]]],[null,null,null,null,null,"https://business.google.com/local/business/4555460974341016686/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTkJkM0EzVDFOUkVBRRAA",[null,null,null,"/local/business/4555460974341016686/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVTkJkM0EzVDFOUkVBRRAA"],"https://business.google.com/local/business/455546