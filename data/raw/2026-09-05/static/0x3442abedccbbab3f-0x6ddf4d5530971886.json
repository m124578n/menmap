GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCEIoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCEMoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCEQoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_MODERATE"],"有點吵雜",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCEYoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCEUoDA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCEgoAA"]],1],null,null,"等待時間",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCEcoDQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_SPACE_AVAILABILITY"],"這裡的停車情況如何？",[[[["E:PARKING_SPACE_DIFFICULT_TO_FIND"],"停車不方便",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCEooAA"]],1],null,null,"停車位",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCEkoDg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_PARKING_OPTIONS"],"有哪些停車選項？",null,[[[["E:PARKING_OPTION_PAID_STREET_PARKING"],"付費路邊停車",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCEwoAA"]]],null,"附近的停車場",null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCEsoDw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_TIPS_TOPICS"],"可以針對這些主題分享更多資訊嗎？",null,[[[["E:PARKING"],"停車場",2,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3YcHCE4oAA"]]],null,null,null,"0ahUKEwiF6ZHfu9eWAxUPZvUHHaKzDfcQ3IcHCE0oEA",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["從店外的日式門面開始，就能感受到濃濃的日本街邊拉麵店氛圍，紅色門簾隨風擺動，搭配溫暖燈光與木質裝潢，營造出一種低調卻充滿生活感的日式風情。\n走進店內，更能看到吧台座位緊鄰開放式廚房，師傅專注煮麵的畫面一覽無遺，這種臨場感非常加分，也讓整體用餐更有參與感。\n\n這次點的是黑蒜油雞湯拉麵，一上桌香氣就非常有存在感。\n湯頭以雞白湯為基底，濃郁卻不厚重，搭配黑蒜油帶來的焦香與微苦韻味，層次非常豐富。\n\n麵條的表現同樣穩定，帶有Q彈口感，能很好地吸附湯汁，每一口都能感受到湯與麵的結合。\n配料部分也很有誠意，雞肉口感嫩而不柴，叉燒則帶有炙燒香氣，油脂與肉香兼具，兩種肉類的搭配讓整碗拉麵層次更加豐富。\n溏心蛋熟度恰到好處，蛋黃滑順濃郁，是標準水準之上的表現；木耳與蔥花則提供了清爽口感，讓整體不會過於油膩。\n\n另外加點的三友可樂餅也讓人印象深刻。\n外層炸得金黃酥脆，內餡綿密細緻，帶有馬鈴薯自然的甜味，是很典型的日式炸物。\n\n店內氛圍也值得一提，用餐時間幾乎客滿，可以看到許多熟客與朋友聚餐，也有吧台一人用餐的客人，整體氣氛輕鬆自然。燈光偏暖，搭配窗邊夜景，讓人可以很放鬆地享受一碗拉麵的時間。這種既有日本風格、又帶點台灣日常感的空間，是三友拉麵的一大特色。\n\n整體來說，三友拉麵並不是完全走「原汁原味日本拉麵」路線，而是將日本濃厚系拉麵技術融入台灣飲食習慣，做出屬於自己的風格。",null,[0,127]]]],[null,null,null,null,null,"https://business.google.com/local/business/4555460974341016686/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXVFdKR09WRlZiV3Q2VkZad2RHUnFiRnBXUlRsRlZWUkNlVTFXUlJBQhAA",[null,null,null,"/local/business/4555460974341016686/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXVFdKR09WRlZiV3Q2VkZad2RHUnFiRnBXUlRsRlZWUkNlVTFXUlJBQhAA"],"https://business.google.com/local/business/4555460974341016686/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXVFdKR09WRlZiV3Q2VkZad2RHUnFiRnBXUlRsRlZWUkNlVTFXUlJBQhAA",[null,null,null,"/local/business/4555460974341016686/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXVFdKR09WRlZiV3Q2VkZad2RHUnFiRnBXUlRsRlZWUkNlVTFXUlJBQhAA"],null,"https://business.google.com/local/business/4555460974341016686/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXVFdKR09WRlZiV3Q2VkZad2RHUnFiRnBXUlRsRlZWUkNlVTFXUlJBQhAA",[null,null,null,"/local/business/4555460974341016686/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRXVFdKR09WRlZiV3Q2VkZad2RHUnFiRnBXUlRsRlZWUkNlVTFXUlJBQhAA"]],[null,null,2102,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tWTWJGOVFVbWt6VFZwdGRqbFpWRTlFVVRCeU1WRRAB!2m1!1s0x0:0x6ddf4d5530971886!3m1!1s2@1:CAIQACodChtycF9oOkVMbF9QUmkzTVptdjlZVE9EUTByMVE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2tWTWJGOVFVbWt6VFZwdGRqbFpWRTlFVVRCeU1WRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodH