/has_wheelchair_accessible_seating","無障礙座位",[1,[[0,"不提供無障礙座位"]],[0,"不提供無障礙座位","無障礙座位","不提供無障礙座位"]],1,[2],0],["/geo/type/establishment_poi/has_wheelchair_accessible_parking","無障礙停車場",[1,[[0,"不提供無障礙停車場"]],[0,"不提供無障礙停車場","無障礙停車場","不提供無障礙停車場"]],1,[2],0]]]]],null,null,null,null,null,null,null,null,null,"zh-TW",null,null,null,null,null,null,null,null,null,null,null,[["銀座 篝 台北店","https://lh5.googleusercontent.com/-xnrrbD4y1tA/AAAAAAAAAAI/AAAAAAAAAAA/8LSgEWPnxnI/s40-c-k-mo/photo.jpg"],null,1],null,null,null,null,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["日本🇯🇵 雞白湯\n銀座 篝。設立於 2013 年，如同法式濃湯般的湯頭為此品牌的特徵。\n曾於 2016 , 2017 年蟬聯 2 年榮獲米其林推薦，至今依舊廣受國內外顧客喜愛，\n高湯及醬汁於日本急速冷凍後出口，因此在台灣也可以 100% 重現品牌道地的美味。\n- 現有店點 -\n・銀座本店\n・アトレ浦和店\n・大手町店\n・札幌店\n・池袋店\n・大阪店\n・鎌倉店\n・六本木店\n・虎ノ門店\n・成田空港店\n・神戸三宮店\n\n日本的銀座篝被選為象徵銀座的代表性指標，以及獲得米其林必比登推薦的殊榮，在日本擁有高人氣以外，也受到了很多海外客人的喜愛。\n\n雖然日式拉麵店總給人環境小而亂的印象，但銀座篝不一樣喔！\n我們的拉麵是優雅富有氣質的擺盤，制服也是和日本本店一致，非常具有時尚感的服裝，突破了以往大家對拉麵店既有的制定印象，並且依節慶、季節性，推出限定拉麵及聯名合作，不斷創新傳統拉麵店的極限。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-xnrrbD4y1tA/AAAAAAAAAAI/AAAAAAAAAAA/8LSgEWPnxnI/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市中山區聚葉里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"10507699573977237357","100390204697554396506"],null,[[[7,[["銀座 篝 台北店"],["10491臺北市中山區聚葉里中山北路二段115巷3弄No. 6號"],["No. 6"]]],[2,[["10491臺北市中山區聚葉里中山北路二段115巷3弄No. 6號銀座 篝 台北店 No. 6"]]],[1,[["No. 6, No. 6號中山北路二段115巷3弄聚葉里中山區臺北市10491"]]],[4,[["臺北市中山區聚葉里"]]]],[null,"No. 6, No. 6號中山北路二段115巷3弄","No. 6, No. 6號中山北路二段115巷3弄","聚葉里","10491","臺北市中山區","TW"],["0ahUKEwj5ivC4tdeWAxVbUPUHHcSNJbYQqtMBCAsoCA",["7QQ33G6F+