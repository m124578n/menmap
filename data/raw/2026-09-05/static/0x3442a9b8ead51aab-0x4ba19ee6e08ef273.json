https://support.google.com/legal/troubleshooter/1114905#ts\u003d9723198%2C7170398"],["檢舉商業行為","https://support.google.com/maps/contact/14718793?url\u003dhttps://maps.google.com/maps?cid%3D0x3442a9b8ead51aab:0x4ba19ee6e08ef273"],["你是業主嗎？","https://business.google.com/create?hl\u003dzh-TW\u0026getstarted\u0026authuser\u003d0\u0026fp\u003d5449811738542142067\u0026gmbsrc\u003dtw-zh-TW-et-ip-mp-s-l~mkp%7Cclaimbz_aoc_a%7Crt_intercept_u\u0026ppsrc\u003dGMBSI"]]],null,null,null,[null,[["accessibility","無障礙程度",[["/geo/type/establishment_poi/has_wheelchair_accessible_entrance","無障礙入口",[1,[[0,"不提供無障礙入口"]],[0,"不提供無障礙入口","無障礙入口","不提供無障礙入口"]],1,[2],0],["/geo/type/establishment_poi/has_wheelchair_accessible_seating","無障礙座位",[1,[[0,"不提供無障礙座位"]],[0,"不提供無障礙座位","無障礙座位","不提供無障礙座位"]],1,[2],0],["/geo/type/establishment_poi/has_wheelchair_accessible_parking","無障礙停車場",[1,[[0,"不提供無障礙停車場"]],[0,"不提供無障礙停車場","無障礙停車場","不提供無障礙停車場"]],1,[2],0]]]]],null,null,null,null,null,null,null,null,null,"zh-TW",null,null,null,null,null,null,null,null,null,null,null,[["好呷拉麵 甜品吃到飽(永和) *呷：ㄒㄧㄚˊ","https://lh3.googleusercontent.com/-dP7oGOd-agI/AAAAAAAAAAI/AAAAAAAAAAA/6ZqFnz-aOts/s40-c-k-mo/photo.jpg"],null,1],null,null,null,null,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["🌟 湯頭全面提升\n全新雞骨豚骨湯底，融入老母雞與豬大骨的精華，經12小時慢火熬煮，湯色乳黃、濃郁綿厚，滿滿的膠原蛋白與極致鮮味，讓每一口都像在擁抱溫暖的幸福。\n\n🌟 叉燒香氣升級\n以日本職人工法製作的五花肉燒肉叉燒，搭配國產純釀醬油低溫熟成，炙燒的梅納反應更添濃郁香氣。每一片叉燒都鎖住鮮甜肉汁，入口即化，滿足每一位饕客的期待。\n\n🌟 麵條口感升級\n嚴選美澳黃金小麥，經九道揉壓工法製成的26番切細麵，硬中帶Q，完美吸附湯頭精華。每一口麵條，都是精工細作的體現。\n好呷豆花的三大堅持 |\n✅ 天然非基改大豆：手工鹽滷製作，不含石膏，口感細緻滑嫩。\n✅ 40年傳承秘糖水：嘉義糖廠老員工的獨門技法，選用純甘蔗熬煮，濃郁不膩。\n✅ 綿密配料：飽滿紅豆、古早味大麥、低糖綠豆，每一口都是回憶的味道。\n\n甜品起家的何家，保留古早味！ 愛吃甜品的朋友們，來好呷拉麵，記得留點胃給這碗 「被拉麵耽誤的豆花」！甜品吃到飽，ho-chia，好呷❤️"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh3.googleusercontent.com/-dP7oGOd-agI/AAAAAAAAAAI/AAAAAAAAAAA/6ZqFnz-aOts/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市永和區協和里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,null,null,null,[null,null,null,null,null,"4694982192475151116","100586083776760234888"],null,[[[7,[["好呷拉麵 甜品吃到飽(永和) *呷：ㄒㄧㄚˊ"],["234新北市永和區協和里保平路15號"]]],[2,[["234新北市永和區協和里保平路15號好呷拉麵 甜品吃到飽(永和) *呷：ㄒㄧㄚˊ"]]],[1,[["234新北市永和區協和里保平路15號"]]],[4,[["新北市永和區協和里"]]]],[null,"保平路15號","保平路15號","協和里","234","新北市永和區","TW"],["0ahUKEwijqrGVtdeWAxVUdfUHHfHXOSwQqtMBCAkoBg",["7QQ32G47+X3"],["2G47+X3 協和里 新北市永和區"],2]],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[["星期六",6,[2026,9,5],[["11:30–14:20",[[11,30],[14,20]]],["17:00–22:30",[[17],[22,30]]]],0,1]],[["星期六",6,[2026,9,5],[["11:30–14:20",[[11,30],[14,20]]],["17:00–22:30",[[17],[22,30]]]],0,1],1,1,null,["營業中 · 打烊時間：22:30",[[0,3,[null,[4281040703,4285388172]]]]],["營業中 · 打烊時間：22:30",[[0,3,[null,[4281040703,4285388172]]]]],null,[21,30],["營業時間",[[0,4,[null,[4281040703,4285388172]]]]]],6,null,null,null,1],null,1,null,null,null,"ChDmi4npurUg5Y-w5YyX5biCWhMiEeaLiem6tSDlj7DljJcg5biCkgEQcmFtZW5fcmVzdGF1cmFudJoBI0NoWkRTVWhOTUc5blMwVkpRMEZuU1VSMk5XSmhNMVZCRUFF4AEA-gEECAAQDw",null,null,null,null,1,null,null,null,null,null,null,null,null,null,null,null,null,[["0x3442a9b8ead51aab:0x4ba19ee6e08ef273",null,null,"/g/11jg67ny0p","ChIJqxrV6ripQjQRc_KO4OaeoUs","4694982192475151116","100586083776760234888"]],null,["0ahUKEwijqrGVtdeWAxVUdfUHHfHXOSwQxsoICCUoGA",[[[2,[900,"15 分"]],null,1,null,0,"0ahUKEwijqrGVtdeWAxVUdfUHHfHXOSwQvbsKCCYoAA"],[[2,[1800,"30 分"]],[null,null,25.0077578,121.51383109999999],1,null,2.087834E-7,"0ahUKEwijqrGVtdeWAxVUdfUHHfHXOSwQvbsKCCcoAQ"],[[0,[900,"15 分"]],[null,null,25.0077578,121.51383109999999],1,null,7.2463774E-7,"0ahUKEwijqrGVtdeWAxVUdfUHHfHXOSwQvbsKCCgoAg"],[[0,[1800,"30 分"]],[null,null,25.0077578,121.51383109999999],1,n