\u003d!1e10!2sCIABIhC4f5jHrMKFYS4n3S_fJYuO\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xff3e7c5152b3aec2"]],1,null,null,null,null,null,null,["0","-54469456760164670"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25odGVEVldOMGhpYkZkc2QzZEJNVWhKT1hKWlJuYxAB"]],"CIABIhC4f5jHrMKFYS4n3S_fJYuO",1]],null,null,null,[[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3YcHCD4oAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3IcHCD0oBw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3IcHCD8oCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3IcHCEAoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3IcHCEEoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3YcHCEMoAA"]],1],null,null,"預訂網址",null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3IcHCEIoCw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["『全林口最頂拉麵，沒有之一！』\n排隊等1h30m真的很值得，工作人員服務態度良好輕聲細語的問候，用餐環境雖然不大，但很有人置身在日本當地用餐的氣氛，拉麵湯頭濃郁又好喝像牛奶一樣，叉燒肉片入口即化。十分能夠感受到，老闆有深厚且紮實的日本拉麵餐點製作技術。\n\n另外，推薦大家來一定要點『叉燒肉飯』，這是這家店的手路菜，讓我感受到老闆很像是位魔術師，第一口飯入口的瞬間味覺感官真的衝擊感非常大，是燒烤過的叉燒肉，醬汁非比尋常的特別又令人難忘，是外面吃不到的那一種口感。\n\n可惜一個人，只有一張嘴與一個胃可以享用，在這邊與老闆承諾，我一定會再回鍋，吃本次沒享用到的品項：醬油鷄清湯拉麵、黑蒜鷄白湯拉麵、極濃鷄白湯拉麵。\n＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿\n6/7回訪更新：\n本次點『醬油清雞湯拉麵』品項，這次老闆給的肉，比上次還要多真的大呼過癮，（且老闆說這次是招待的），對愛吃肉的我來說，給我的感覺真的是誠意十足😍，醬油湯汁不油膩像在喝水一樣，有加了調味料的水真好喝😂，麵條軟硬度適中，老闆配合的麵條製造商真的很厲害，那個口感吃起來很像一層一層帶有口感的顆粒，嚼在嘴巴裡面的那種感覺，讓自己十分難忘，轉味的松露、檸檬巧思讓人吃了兩碗拉麵的滿足感，這點我與Jacko Huang是同樣的心得。\n\n與老闆回覆一下：塩味清湯回歸後，我一定會回訪吃吃看，沒吃過的品項真令人期待。",null,[0,126]]]],[null,1780386374000000,1780386374000000,"3 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfMHZZYWotcGR0NjM2QnJEX3hGTXV0UQ%7CCAEQrcz1_gkiMAoZQ0hfMHZZYWotcGR0NjM2QnJEX3hGTXV0URoTQ2d3SXhwVDYwQVlReW9PNDRnSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ_2MIRCgM"],"https://business.google.com/local/business/2904753738490998532/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvZEdWRVZsZE9NR2hwWWtaa2MyUXpaRUpOVldoS1QxaEtXbEp1WXhBQhAA",[null,null,null,"/local/business/2904753738490998532/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvZEdWRVZsZE9NR2hwWWtaa2MyUXpaRUpOVldoS1QxaEtXbEp1WXhBQhAA"],"https://business.google.com/local/business/2904753738490998532/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvZEdWRVZsZE9NR2hwWWtaa2MyUXpaRUpOVldoS1QxaEtXbEp1WXhBQhAA",[null,null,null,"/local/business/2904753738490998532/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvZEdWRVZsZE9NR2hwWWtaa2MyUXpaRUpOVldoS1QxaEtXbEp1WXhBQhAA"],null,"https://business.google.com/local/business/2904753738490998532/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvZEdWRVZsZE9NR2hwWWtaa2MyUXpaRUpOVldoS1QxaEtXbEp1WXhBQhAA",[null,null,null,"/local/business/2904753738490998532/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvZEdWRVZsZE9NR2hwWWtaa2MyUXpaRUpOVldoS1QxaEtXbEp1WXhBQhAA"],null,["zh-Hant"],[["不好意思因人手不足 \u0026 新人熟悉中陣痛期，讓您久等了... 我們會盡快恢復正常速度，也歡迎您再來吃麵🙏\n（目前定番是醬油/白湯/極濃，第四碗品項等人員上手後會恢復供應 - 沒意外會是塩味清湯。黑蒜可能要等秋冬了喔...",null,[0,109]]]],[null,null,5477,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25odGVEVldOMGhpYkZkc2QzZEJNVWhKT1hKWlJuYxAB!2m1!1s0x0:0xff3e7c5152b3aec2!3m1!1s2@1:CAIQACodChtycF9oOnhteDVWN0hibFdsd3dBMUhJOXJZRnc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHlj