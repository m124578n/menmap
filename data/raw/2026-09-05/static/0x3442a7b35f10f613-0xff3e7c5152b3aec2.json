GsoCw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3IcHCG0oDA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3IcHCG4oDQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3IcHCG8oDg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3YcHCHEoAA"]],1],null,null,"預訂網址",null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ3IcHCHAoDw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["下大雨的天氣還是不少人來吃就知道它的厲害👍\n\n特別喜歡醬油清湯拉麵，湯頭甘味香醇麵條彈脆，吸起來滑順。叉燒都處理的很好，轉味的松露、檸檬巧思讓人吃了兩碗拉麵的滿足感。\n\n極濃湯白湯拉麵濃郁厚重，但一點都不會過鹹。但配料的蘿蔔絲？跟湯頭裡類似吃鮪魚罐頭肉的沙沙口感比較不合口味。\n\n這碗吸麵滑順感降低許多，味道呈現是可以的，上頭的芹菜珠很特別。\n\n角煮口味不甜膩十分剛好，若肥瘦比瘦再多一點就更棒了。",null,[0,83]]]],[null,1780928857000000,1780928857000000,"2 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQVl4WUtHZzEteTN4YlM4S1Iwd0JJQQ%7CCAEQrcz1_gkiMAoZQ0hfQVl4WUtHZzEteTN4YlM4S1Iwd0JJQRoTQ2d3STJhS2IwUVlRdXRiRjRBRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwi33f-htdeWAxW3cfUHHWVEFlIQ_2MIcigQ"],"https://business.google.com/local/business/2904753738490998532/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4VTJFd2NFbGFWRlUxWTFWd2NGTnNXbHBOTVdSNFZtMU9WMDlGUlJBQhAA",[null,null,null,"/local/business/2904753738490998532/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4VTJFd2NFbGFWRlUxWTFWd2NGTnNXbHBOTVdSNFZtMU9WMDlGUlJBQhAA"],"https://business.google.com/local/business/2904753738490998532/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4VTJFd2NFbGFWRlUxWTFWd2NGTnNXbHBOTVdSNFZtMU9WMDlGUlJBQhAA",[null,null,null,"/local/business/2904753738490998532/customers/reviews/deletereply?p\