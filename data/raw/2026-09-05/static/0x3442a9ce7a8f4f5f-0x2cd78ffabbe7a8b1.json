003d1115658%2C1115689"]],null,null,"https://lh4.googleusercontent.com/-GzOcRCSQ428/AAAAAAAAAAI/AAAAAAAAAAA/Xzy5T4N13oM/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"臺北市萬華區西門里",null,null,null,null,null,null,null,null,[null,[null,1],0,[21,11,43,156,871],["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,[[[[["Ci9DQUlRQUNvZENodHljRjlvT2xKWFdHaHFTV0pVTnpZNWExRmlabFpyWVVwemMzYxAB",["0x0:0x2cd78ffabbe7a8b1",null,1781211647006452,1781211647006452,[null,null,["https://www.google.com/maps/contrib/117299788075039703766/reviews?hl\u003dzh-TW"],null,null,["李小安","https://lh3.googleusercontent.com/a/ACg8ocJhsFP7mGbTXB5jNcbbagTmoBDh1FWQQiXQqKdOvswRyE_CMw\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/117299788075039703766?hl\u003dzh-TW"],"117299788075039703766",null,28,78,null,[1,5,1],13,["在地嚮導 · 28 則評論",null,null,null,null,[null,"0ahUKEwiB-92UvNeWAxXvga8BHcFBDQsQpr8GCDEoAA"]]]],null,"2 個月前",null,null,null,null,null,null,["Google","https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,1],[[4],null,[["CIABIhDJWcb7UeEdh4H6A07JsNHC",["CIABIhDJWcb7UeEdh4H6A07JsNHC",10,12,null,null,null,["https://lh3.googleusercontent.com/grass-cs/ACvplmPVrzng89WIYVTMNsU8hCIVjULbjNNve3lDWqDZdkinMcBfLh_LMdVbnoe365wtNaaPGYwdZ5OX1V_zckpzUSqbpBfWZqwJt2-LkbnEP_iLj6hKXMl2WqSmVwPSG4ODgcTQDk1PTUv3DnkL\u003dk-no",null,[5712,4284]],null,[[3,121.50529800492517,25.041673028755582],[0,90],[5712,4284],75],"6g6caoHeFe-Dvr0PwYO1WA","0ahUKEwiB-92UvNeWAxXvga8BHcFBDQsQzCcIMigB",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDJWcb7UeEdh4H6A07JsNHC\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x2cd78ffabbe7a8b1",null,null,"0ahUKEwiB-92UvNeWAxXvga8BHcFBDQsQ-y4IMygA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhDJWcb7UeEdh4H6A07JsNHC"],[10,3,[4284,5712]],[null,null,null,null,null,null,null,["麵屋 有漁"]],[null,[[["李小安"],"https://www.google.com/maps/contrib/117299788075039703766