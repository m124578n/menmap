A",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiB-92UvNeWAxXvga8BHcFBDQsQ3IcHCEIoCQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiB-92UvNeWAxXvga8BHcFBDQsQ3IcHCEMoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiB-92UvNeWAxXvga8BHcFBDQsQ3IcHCEQoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiB-92UvNeWAxXvga8BHcFBDQsQ3YcHCEYoAA"]],1],null,null,"等待時間",null,"0ahUKEwiB-92UvNeWAxXvga8BHcFBDQsQ3IcHCEUoDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["上次來排隊排太多人就沒吃了，這次週一傍晚6點半跟女朋友來用餐，可能因為下雨不用排隊了，位置在西門比較外圍的地方了，裝潢漂亮室內環境舒適整潔，但空間偏窄約莫只有10個位置，點餐跟一般的拉麵店一樣使用機台點餐，上菜速度正常點完餐大概等5分鐘。\n\n這次用餐點了原味石斑魚白湯（280元）、卡布奇諾蝦湯（320元）。\n\n❤原味石斑魚白湯：比較少接觸魚類的拉麵，搭配的是細麵（點餐時可選擇麵硬度），感覺很像在喝魚湯加了麵，湯頭味道非常濃醇又很順口，整碗吃完都不會膩，魚肉好吃但覺得有點少，有附一片叉燒肉，肉的部分就一般般，但整體是非常滿意的。\n\n🉑卡布奇諾蝦湯：搭配的是粗麵，湯頭非常濃郁，湯已經到達有點黏稠感，搭配粗麵剛剛好，第一口吃下去滿滿的蝦味，有搭配4隻蝦子，蝦子好吃，有搭配一坨白白的東西，應該是奶泡嗎？其實我不知道，因為基本上都是蝦的味道，吃到後面會有點膩，但整體還是好吃的，蝦味的拉麵的話我可能還是會比較推像五之神、一幻之類的。\n\n總結：補充一下調味料的部分，覺得算是誠意十足，都蠻有特色的，有拉麵胡椒等，辣椒也夠辣又香，不過本人吃拉麵比較不常搭配調味料，喜歡搭配的人可以嘗試看看，整體還是非常滿意的，回訪意願高，應該還會去嘗試看看辛味噌跟黑蒜魚湯。",null,[0,119]]]],[null,null,null,null,null,"https://business.google.com/local/business/9673365112040388517/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLV0ZkSGFIRlRWMHBWVG5wWk5XRXhSbWxhYkZweVdWVndlbU16WXhBQhAA",[null,null,null,"/local/business/9673365112040388517/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLV0ZkSGFIRlRWMHBWVG5wWk5XRXhSbWxhYkZweVdWVndlbU16WXhBQhAA"],"https://business.google.com/local/business/9673365112040388517/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhLV0ZkSGFIRlRWMHBWVG5wWk5XRXhSbWxhYkZweVdWVndlbU16WXhBQhAA",[null,null,null,"/local/business/9673365112040388517/customers/reviews/deleter