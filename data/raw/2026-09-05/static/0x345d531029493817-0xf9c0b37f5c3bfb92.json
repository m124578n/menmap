l,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi-0eb_udeWAxVHk68BHRSyIGgQ3IcHCOEBKBY",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi-0eb_udeWAxVHk68BHRSyIGgQ3IcHCOIBKBc",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["2025/10 門口候位需在板子上登記姓氏以及人數，會依序叫姓氏，入座前，須先於點餐機點餐，只有現金。有三種湯底的拉麵：鹽味、醬油以及柚子鹽拉麵。$190 選擇鹽味拉麵（台灣口味、普通麵條），湯頭沒有特別的鹽味，反而因為加了海帶芽，一開始喝蠻清爽，吃到後面海帶芽泡久了，有點微微像泡麵附得湯，搭配一塊叉燒、兩塊雞胸肉，叉燒很推，完全沒有豬騷味，處理的很好，整體叉燒是肥肉佔比多，但肥而不膩，很好吃，雞胸肉的部分，不柴還可以；$70 叉燒飯就是叉燒加上雞胸肉切塊，上面淋上日式美乃滋後炙燒，一開始入口偏鹹，後來習慣口味後，日式美乃滋炙燒後的鹹口搭配叉燒肉、雞肉肉塊，還蠻好吃。\n2026/01/23 $200 醬油拉麵，湯底有昆布以及醬油味，湯頭微鹹，硬麵條稍硬一些；$230 柚子拉麵，佶醬、兩種不同的檸檬片、高麗菜、兩片舒肥雞胸肉、一片叉燒肉，湯頭蠻有層次，叉燒肉一如慣例，處理的很好，沒有豬肉味，很乾淨的味道，微肥，好吃；$70 唐揚雞，炸得還不錯，還保有肉汁，但味道微鹹，淋上檸檬，搭配日式美乃滋，還不錯。現金付款。",null,[0,215]]]],[null,null,null,null,null,"https://business.google.com/local/business/8189832682589851145/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTTVdSc1ZUVlRSbXhXVWtoc1VWVnRaRTFYUmxKUlpGVmFSVXhYWXhBQhAA",[null,null,null,"/local/business/8189832682589851145/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTTVdSc1ZUVlRSbXhXVWtoc1VWVnRaRTFYUmxKUlpGVmFSVXhYWXhBQhAA"],"https://business.google.com/local/business/8189832682589851145/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTTVdSc1ZUVlRSbXhXVWtoc1VWVnRaRTFYUmxKUlpGVmFSVXhYWXhBQhAA",[null,null,null,"/local/business/8189832682589851145/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTTVdSc1ZUVlRSbXhXVWtoc1VWVnRaRTFYUmxKUlpGVmFSVXhYWXhBQhAA"],null,"https://business.google.com/local/business/8189832682589851145/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTTVdSc1ZUVlRSbXhXVWtoc1VWVnRaRTFYUmxKUlpGVmFSVXhYWXhBQhAA",[null,null,null,"/local/business/8189832682589851145/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFTTVdSc1ZUVlRSbXhXVWtoc1VWVnRaRTFYUmxKUlpGVmFSVXhYWXhBQhAA"]]