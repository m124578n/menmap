EAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3YcHCDYoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3IcHCDUoBQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3YcHCDgoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3IcHCDcoBg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3IcHCDkoBw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3IcHCDooCA",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3IcHCDsoCQ",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3YcHCD0oAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3YcHCD4oAQ"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3YcHCD8oAg"]]],null,"用餐人數",null,"0ahUKEwjV2cOSvNeWAxVOe_UHHeV8CRQQ3IcHCDwoCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["小高拉麵連城店是連鎖分店，進店前先在門口的點餐機完成點餐，再依序於門口等候入場。麵條軟硬、湯頭濃淡及份量都可以客製化，操作方式清楚，不熟悉的人稍微看一下也能完成。這次點了醬油豚骨拉麵和麻辣豚骨拉麵，醬油口味較溫和順口，麻辣口味則多了香辣感，但不會只剩下辣味。叉燒、筍乾、蔥花和滷蛋等配料搭配起來很完整，麵條口感也可以依個人喜好調整。價格約135至145元，以目前物價來說算相當實惠，而且還可以免費加麵、無限續麵，食量較大的人會覺得很划算。店內環境簡單乾淨，座位不算寬敞，但翻桌速度快。以這個價位、份量和口味來說，確實沒有太多好挑剔，是一次還可以的用餐體驗。",null,[0,278]]]],[null,null,null,null,null,"https://business.google.com/local/business/6837063209098378157/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXVWxSRmNISk9SV1JyVjI1c2JWRlZhREpsV0ZwU1lteFNOVll6WXhBQhAA",[null,null,null,"/local/business/6837063209098378157/customers/reviews/reply?p\u003dCkRDaTlEUVV