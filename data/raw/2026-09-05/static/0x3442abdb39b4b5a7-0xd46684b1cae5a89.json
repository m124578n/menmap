CEMoCg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwimu_3Xu9eWAxXbna8BHalVIUsQ3IcHCEQoCw",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["網路上狂刷「CP值超高」、「大安區名店」，但現實總是骨感的。這家店的整體水準就是普通偏難吃，完美展示了網路評價跟現實的平行時空。\n\u200b台日混血的四不像拉麵：號稱博多風味，但湯頭喝起來更像過度稀釋的台式大骨湯。配料竟然是玉米、一堆海帶芽加上一大坨生洋蔥，這不是拉麵，這是巷口麵攤老闆對日本文化的強行解讀。\n\u200b生洋蔥大放送的小菜：這家店的廚師對生洋蔥有著莫名的狂熱，炸雞、肉排全被洋蔥淹沒，且肉質乾癟。炸豬排和可樂餅的麵衣與內餡貌合神離，吃的是一種咀嚼的空虛感。\n\u200b熱炒店靈魂的炸豆腐：網推第一名的「超級炸豆腐」，裹著粗糙的麵包粉猛炸，再配上一坨台式辣豆瓣醬，會讓你瞬間以為自己坐在熱炒店喝台啤。\n問我好吃嗎？我說：普通偏下\n問我划算嗎？我說：普通",null,[0,150]]]],[null,null,null,null,null,"https://business.google.com/local/business/10979813342079208786/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBXVWxJeWRITldWMUpMVDFoYVJsRlVVbXRPUld3d1RqSk9kR0pYWXhBQhAA",[null,null,null,"/local/business/10979813342079208786/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBXVWxJeWRITldWMUpMVDFoYVJsRlVVbXRPUld3d1RqSk9kR0pYWXhBQhAA"],"https://business.google.com/local/business/10979813342079208786/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBXVWxJeWRITldWMUpMVDFoYVJsRlVVbXRPUld3d1RqSk9kR0pYWXhBQhAA",[null,null,null,"/local/business/10979813342079208786/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBXVWxJeWRITldWMUpMVDFoYVJsRlVVbXRPUld3d1RqSk9kR0pYWXhBQhAA"],null,"https://business.google.com/local/business/10979813342079208786/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBXVWxJeWRITldWMUpMVDFoYVJsRlVVbXRPUld3d1RqSk9kR0pYWXhBQhAA",[null,null,null,"/local/business/10979813342079208786/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBXVWxJeWRITldWMUpMVDFoYVJsRlVVbXRPUld3d1RqSk9kR0pYWXhBQhAA"]],[null,null,3575,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pWUlIydHNWV1JLT1haRlFUUmtORWwwTjJOdGJXYxAB!2m1!1s0x0:0xd46684b1cae5a89!3m1!1s2@1:CAIQACodChtycF9oOjVRR2tsVWRKOXZF