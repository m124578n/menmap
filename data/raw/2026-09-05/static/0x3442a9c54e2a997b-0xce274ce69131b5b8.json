null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwiX--CMtdeWAxWYZfUHHWAXFZUQ3YcHCEcoAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiX--CMtdeWAxWYZfUHHWAXFZUQ3IcHCEYoCQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwiX--CMtdeWAxWYZfUHHWAXFZUQ3YcHCEkoAA"]],1],null,null,"等待時間",null,"0ahUKEwiX--CMtdeWAxWYZfUHHWAXFZUQ3IcHCEgoCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["周二中午1213開始排隊點餐，1230進場坐好。等待時間十七分鐘包含點餐還OK。\n\n我是點了SP干貝濃湯拉麵380元，全粒粉細麵(較Q軟)，鹹度軟硬都選正常。\n\n湯頭濃郁好喝，不過鮮味稍淡。喝了一口同事的偏鹹版本，除了更鹹之外還是另外一種風味，正常與偏鹹的差異並不只是比較鹹而已，值得試試。\n\n雞和豬叉燒各兩片滿厚的，很驚人的是在這麼濃厚的湯裡面，舒肥雞和炙燒過的豬肉都非常有自己的味道，厚度應該有幫上一點忙，若再薄一些，味道可能就會比較淡。口感都很不錯，嫩而不柴，有口感不軟爛。一顆炙烤過的半熟大干貝雖然沒有多加什麼調味，但它在這裡就夠了，它甚至提供了一些轉味的功能。\n\n湯汁很好的扒附麵條，甚至有點像白醬拌麵的程度，很愉快地吃到最後一口。吃了一口同事的加麵：九州全粒粉（偏硬），真的硬滿多的，不是我的菜。\n\n配菜有玉米、紫洋蔥，效果不錯，增加滿好的口感，但可惜沒有什麼轉味元素，尤其是湯那麼濃的時候。\n\n整體好吃，下次想再回來吃蝦清湯麵。",null,[0,79]]]],[null,null,null,null,null,"https://business.google.com/local/business/1762333081755287181/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhYWxWWFRuaGhXR1JxVjBNeFRWUXpUa3hNVlU1elZsaGFZVXhWUlJBQhAA",[null,null,null,"/local/business/1762333081755287181/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhYWxWWFRuaGhXR1JxVjBNeFRWUXpUa3hNVlU1elZsaGFZVXhWUlJBQhAA"],"https://business.google.com/local/business/1762333081755287181/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhYWxWWFRuaGhXR1JxVjBNeFRWUXpUa3hNVlU1elZsaGFZVXhWUlJBQhAA",[null,null,null,"/local/business/1762333081755287181/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhYWxWWFRuaGhXR1JxVjBNeFRWUXpUa3hNVlU1elZsaGFZVXhWUlJBQhAA"],null,"https://business.google.com/local/business/1762333081755287181/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhYWxWWFRuaGhXR1JxVjBNeFRW