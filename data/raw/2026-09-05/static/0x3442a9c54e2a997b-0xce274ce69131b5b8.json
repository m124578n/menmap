[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11s2l1w_nc"],"雞叉燒",2,null,null,"0ahUKEwiX--CMtdeWAxWYZfUHHWAXFZUQ3YcHCH0oAA"],[["M:/g/11rxv3klb8"],"冰水",2,null,null,"0ahUKEwiX--CMtdeWAxWYZfUHHWAXFZUQ3YcHCH4oAQ"]],[1]],null,"建議的餐點",null,"0ahUKEwiX--CMtdeWAxWYZfUHHWAXFZUQ3IcHCHwoGg",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwiX--CMtdeWAxWYZfUHHWAXFZUQ3YcHCIABKAA"]],1],null,null,"等待時間",null,"0ahUKEwiX--CMtdeWAxWYZfUHHWAXFZUQ3IcHCH8oGw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["以龍蝦和干貝製作湯頭的人氣拉麵，先在機器點餐(僅現金)再等待叫號，平日中午12:10幸運點到最後一碗限量的SP大蝦干貝龍蝦拉麵，大約等20分鐘進場。內用空間極窄，大概只有七個位置。\n之前吃過分店湮鯱的螃蟹濃湯，覺得腥味偏重不是很滿意，這次來本店再給龍蝦清湯一個機會，點了招牌的SP大蝦干貝龍蝦拉麵(460元)。大蝦蠻好吃的，肉質緊實Q彈，干貝就是個普通好吃的干貝，還有雞肉叉燒和豬肉叉燒各兩片，肉質鮮美硬度剛好，水準也不錯。\n湯頭是清爽系不是濃郁系，有淡淡的龍蝦香；但選了麵硬好像還是軟趴趴，有待加強呀。整體來說個別的食材都不錯吃，但合在一起融合感不足，基本上就只是把高級食材加進拉麵混在一起而已，以這個價格可以再用心點。\n紅油抄手(4顆50元)和分店湮鯱的一樣好吃，應該是一樣的東西，值得加點，抄手內餡飽滿不膩口，沾上辣度輕的紅油和醋味，好吃又無負擔。",null,[0,90]]]],[null,null,null,null,null,"https://business.google.com/local/business/1762333081755287181/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRHUjFkVk5WaFNNRlpTWVRCb1NVMHhSazFoVldoUFRrVnNWMDVZWXhBQhAA",[null,null,null,"/local/business/1762333081755287181/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRHUjFkVk5WaFNNRlpTWVRCb1NVMHhSazFoVldoUFRrVnNWMDVZWXhBQhAA"],"https://business.google.com/local/business/1762333081755287181/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRHUjFkVk5WaFNNRlpTWVRCb1NVMHhSazFoVldoUFRrVnNWMDVZWXhBQhAA",[null,null,null,"/local/business/1762333081755287181/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRHUjFkVk5WaFNNRlpTWVRCb1NVMHhSazFoVldoUFRrVnNWMDVZWXhBQhAA"],null,"https://business.google.com/local/business/1762333081755287181/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRHUjFkVk5WaFNN