]],1,[2],0],["/geo/type/establishment_poi/has_wheelchair_accessible_parking","無障礙停車場",[1,[[0,"不提供無障礙停車場"]],[0,"不提供無障礙停車場","無障礙停車場","不提供無障礙停車場"]],1,[2],0]]]]],null,null,null,null,null,null,null,null,null,"zh-TW",null,null,null,null,null,null,null,null,null,null,null,[["日本富士八峰拉麵【竹圍民生店】","https://lh5.googleusercontent.com/-9PqoHLG6syA/AAAAAAAAAAI/AAAAAAAAAAA/51-lfhzJeLk/s40-c-k-mo/photo.jpg"],null,1],null,null,null,null,null,null,null,0,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[9],null,null,null,null,null,null,null,[["🗻日本富士八峰拉麺的起源🍜\n日本富士山下的山梨縣，有間營業了近50年的拉麵老店，經營者是位從小定居於日本的華僑蔡桑。\n蔡桑秉持著將日本傳統美食與台灣民眾分享的精神，在台成立多間分店，並請身在台灣的親戚林桂蘭女士一同幫忙。\n拉麵好吃的重點，在於湯頭的熬製方式。日本道地拉麵風味濃郁厚重，但因個人口感不一、喜好也不同，並非所有台灣饕客都能接受，所以剛開始無法成功打入台灣市場，因此蔡桑將拉麵湯頭及叉燒熬製技術傳承給林桂蘭女士。\n林桂蘭女士本是一位熱衷於美食料理的饌研者，在不影響原本日式風味的前題下，用所學技術將日式拉麵改良成較適合台灣民眾的口味，成功的讓愛好拉麵的饕客讚賞與肯定，並擁有了越來越多愛好者。\n一直以來，老闆娘秉持著健康、養生的原則，堅持做好吃的拉麵給顧客，讓每一位顧客喝到熱騰騰的豚骨湯頭，帶著如此的理想及目標，將日本的拉麵分享給所有愛好拉麵的消費者。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-9PqoHLG6syA/AAAAAAAAAAI/AAAAAAAAAAA/51-lfhzJeLk/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市淡水區民生里",null,null,null,null,null,null,null,null,[null,[null,1],0,null,["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,null,null,null,null,[3,1,null,null,null,[2]]],null,null,[["02 2808 4789",[["02 2808 4789",1],["+886 2 2808 4789",2]],null,"0228084789",null,["tel:0228084789",null,null,"0ahUKEwih5PGwu9eWAxUtmq8BHTx4LPUQ_doBCA0oCg"]]],null,null,[null,null,null,null,null,"5844386105418045979","101357022685385684261"],null,[[[7,[["日本富士八峰拉麵【竹圍民生店】"],["251新北市淡水區民生里民生路52巷2弄3號"]]],[2,[["251新北市淡水區民生里民生路52巷2弄3號日本富士八峰拉麵【竹圍民生店】"]]],[1,[["251新北市淡水區民生里民生路52巷2弄3號"]]],[4,[["新北市淡水區民生里"]]]],["竹圍","民生路52巷2弄3號","民生路52巷2弄3號","民生里","251","新北市淡水區","TW"],["0ahUKEwih5PGwu9eWAxUtmq8BHTx4LPUQqtMBCAkoBg",["7QQ34FP6+XQ"],["4FP6+XQ 民生里 新北市淡水區"],2