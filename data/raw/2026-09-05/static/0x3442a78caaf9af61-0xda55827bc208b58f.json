ECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjE9bn0uNeWAxUqhq8BHc8hKUUQ3IcHCEsoDg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjE9bn0uNeWAxUqhq8BHc8hKUUQ3IcHCEwoDw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjE9bn0uNeWAxUqhq8BHc8hKUUQ3IcHCE0oEA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_LOUD"],"吵雜，但還是能交談",2,null,null,"0ahUKEwjE9bn0uNeWAxUqhq8BHc8hKUUQ3YcHCE8oAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjE9bn0uNeWAxUqhq8BHc8hKUUQ3IcHCE4oEQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwjE9bn0uNeWAxUqhq8BHc8hKUUQ3YcHCFEoAA"]]],null,"座位類型",null,"0ahUKEwjE9bn0uNeWAxUqhq8BHc8hKUUQ3IcHCFAoEg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["市場巷子裡的拉麵\n在新北到桃園都有據點\n宵夜好選擇\n價位很平價\n\n📍炙燒肉飯 90元\n上面的美奶滋和碎塊燒肉搭配起來相當美味，不會太過油膩，飯底部也會帶一點肉的醬汁，鹹度剛好，配一些關東煮相當適合。\n\n📍天神拉麵 260元\n些許豆芽和青蔥，叉燒是薄的那種也不會太乾柴，豚骨的味道比較淡，但總體來說鹹度也比較低，麵體細麵偏軟，如果宵夜和簡單吃符合市場口味，偏台式一點。\n\n關東主的醬是胡麻醬，旁邊有擠一點黃芥末醬，蠻提味的，帶一點點嗆感。",null,[0,25]]]],[null,null,null,null,null,"https://business.google.com/local/business/14324259327917661378/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvYldOVk1UTlZNazVvWVd4S2JHVkZaSEZOTVZKR1pHdEplR1J0WXhBQhAA",[null,null,null,"/local/business/14324259327917661378/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvYldOVk1UTlZNazVvWVd4S2JHVkZaSEZOTVZKR1pHdEplR1J0WXhBQhAA"],"https://business.google.com/local/business/14324259327917661378/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvYldOVk1UTlZNazVvWVd4S2JHVkZaSEZOTVZKR1pHdEplR1J0WXhBQhAA",[null,null,null,"/local/business/14324259327917661378/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVvYldOVk1UTlZNazVvWVd4S2JHVkZaSEZOTVZKR1pHdEpl