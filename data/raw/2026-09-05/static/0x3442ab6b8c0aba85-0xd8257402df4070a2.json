],["#台北拉麵",3,null,"台北拉麵"],["\n",1],["#重新開幕",3,null,"重新開幕"],["\n",1],["#限時優惠",3,null,"限時優惠"],["\n",1],["#每日限量100碗",3,null,"每日限量100碗"],["\n",1],["#日本本店的味道",3,null,"日本本店的味道"],["\n",1],["#台北美食",3,null,"台北美食"]]],[1781082365,1796893565],null,null,[["https://lh3.googleusercontent.com/geougc/AF1QipO9tTX71JQSkvDfwuyQzyrt1ncECSGhW3AUJec\u003dh400-no",1,null,"","AF1QipO9tTX71JQSkvDfwuyQzyrt1ncECSGhW3AUJec"],["https://lh3.googleusercontent.com/geougc/AF1QipN-xCTei5cF0Lr7i6PLeLV1h4fSah1dghojsxI\u003dh400-no",1,null,"","AF1QipN-xCTei5cF0Lr7i6PLeLV1h4fSah1dghojsxI"],["https://lh3.googleusercontent.com/geougc/AF1QipMiw_EGV4YQe2iwUT8LlOkhi30CQ9IF9lGdKR0\u003dh400-no",1,null,"","AF1QipMiw_EGV4YQe2iwUT8LlOkhi30CQ9IF9lGdKR0"]],"5610081141037120200","5451450629285259661",["https://www.google.com/search?sca_esv\u003dabca9301b52d9f7f\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003d%E5%A1%A9%E3%82%89%E3%80%9C%E9%BA%BA+%E6%9C%AC%E4%B8%B8%E4%BA%AD\u0026ludocid\u003d15574982442015027362\u0026lpsid\u003dCIHM0ogKEJiu9Ozv35uORA\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEJiu9Ozv35uORA,ar","/gmb/local_post/accounts%2F-%2Flocations%2F5451450629285259661%2FlocalPosts%2F5610081141037120200/version/1781082365122000","https://www.google.com/local/content/rap/report?postId\u003dCMj1iqWw4sDtTRIWQ0lITTBvZ0tFSml1OU96djM1dU9SQRoTQ2d3SV9kR2swUVlRMk1DNTJBRQ\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003d%E5%A1%A9%E3%82%89%E3%80%9C%E9%BA%BA+%E6%9C%AC%E4%B8%B8%E4%BA%AD\u0026ludocid\u003d15574982442015027362\u0026lpsid\u003dCIHM0ogKEJiu9Ozv35uORA\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5Xq5em-eaMNvCHSGX74HXk5","0ahUKEwjXgNastdeWAxWIZ_UHHV1CKvcQ544CCJ4BKBw",null,"2026年6月10日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u5451450629285259661/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM1NjEwMDgxMTQxMDM3MTIwMjAw","https://business.google.com/mm/posts/l/u5451450629285259661/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM1NjEwMDgxMTQxMDM3MTIwMjAw",null,null,null,null,null,["5610081141037120200","CIHM0ogKEJiu9Ozv35uORA","CgwI_dGk0QYQ2MC52AE"]],[null,[[["⭐️【重新開幕公告】 ⭐️\n\n本店將於6月15日（一）起正式重新開始營業！\n\n店主即將回台灣囉！\n這段時間在日本，全力支援新開的店舖。\n從湯頭、製法到細節，每天幾乎沒有休息地重新從零開始學習，一心希望能更完整地把真正的日本味道帶回台灣。\n\n除了原有的人氣品項之外，也會重新調整部分菜單內容，新增更多不同版本的鹽味拉麵，希望讓大家品嚐到更進化、更接近日本現地風味的一碗拉麵。\n\n為了慶祝菜單改版 \u0026 重新開幕🎉\n6月15日（一）～6月17日（三）限定三天，\n將以「特別優惠價格」歡迎一直以來愛護我們的粉絲們唷～💕\n\n詳細活動內容之後也會陸續公布，歡迎大家再回來吃看看我們嶄新呈現的味道。\n\n謝謝大家一直以來的支持！未來也請多多指教。\n\n\n⭐️【リニューアルオープンのお知らせ】⭐️\n\n当店は6月15日（月）より営業を再開いたします！\n\n店主が台湾に帰ってきます！\nこの期間、日本で新店舗の立ち上げを全力でサポートしながら、\nスープ作りから製法、細かな部分に至るまで、\nほとんど休みなく一から学び直してきました。\n\n本場・日本の味を、より忠実に台湾で再現したい――\nそんな想いを込めて、今回のリニューアルを迎えます。\n\n再開後は、これまでの人気メニューに加え、\nメニュー内容を一部リニューアルし、\n塩ラーメンのバリエーションもさらに増やします！\n\nより進化した、\nより日本現地の味に近い一杯を、\nぜひ楽しみにしていてください。\n\nそして、メニューリニューアル＆営業再開を記念して、\n6月15日（月）〜6月17日（水）の3日間限定で、\n特別価格にて営業いたします💕\n\n詳細なキャンペーン内容につきましては、\n後日あらためてお知らせいたします。\n\nぜひ新しくなった味を食べに来てください！\n\nいつも応援してくださる皆さま、\n本当にありがとうございます。\n今後ともどうぞよろしくお願いいたします。",1]]],[1779293432,1795104632],null,null,null,"8531142789804660586","5451450629285259661",["https://www.google.com/search?sca_esv\u003dabca9301b52d9f7f\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003d%E5%A1%A9%E3%82%89%E3%80%9C%E9%BA%BA+%E6%9C%AC%E4%B8%B8%E4%BA%AD\u0026ludocid\u003d15574982442015027362\u0026lpsid\u003dCIHM0ogKEPDE443h1LTvHA\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKEPDE443h1LTvHA,ar","/gmb/local_post/accounts%2F-%2Flocations%2F5451450629285259661%2FlocalPosts%2F8531142789804660586/version/1779293523297000","https://www.google.com/local/content/rap/report?postId\u003dCOquxNOtpa2ydhIWQ0lITTBvZ0tFUERFNDQzaDFMVHZIQRoTQ2d3STA3cTMwQVlROEsyUnJBSQ\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003d%E5%A1%A9%E3%82%89%E3%80%9C%E9%BA%BA+%E6%9C%AC%E4%B8%B8%E4%BA%AD\u0026ludocid\u003d15574982442015027362\u0026lpsid\u003dCIHM0ogKEPDE443h1LTvHA\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5Xq5em-eaMNvCHSGX74HXk5","0ahUKEwjXgNastdeWAxWIZ_UHHV1CKvcQ544CCJ8BKB0",null,"2026年5月21日",null,null,1,null,null,"https://business.google.com/mm/posts/l/u5451450629285259661/delete?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM4NTMxMTQyNzg5ODA0NjYwNTg2","https://business.google.com/mm/posts/l/u5451450629285259661/edit?s\u003dEAA%3D\u0026ih\u003dtactile\u0026p\u003dChM4NTMxMTQyNzg5ODA0NjYwNTg2",null,null,null,null,null,["8531142789804660586","CIHM0ogKEPDE443h1LTvHA","CgwI07q30AYQ8K2RrAI"]],[null,[[["由於本丸亭在日本橫濱開展了新店舖，店主預計到五月底之前都在日本橫濱的新店舖駐店支援。\n\n關於本丸亭台灣本店的暫時停止營業，希望愛護我們的粉絲們多多諒解、多多包涵！\n\n店主十分期待回台灣與粉絲們相見的那天，希望能快點再次為各位粉絲們呈現一碗好吃的拉麵。\n\n關於開店訊息，敬請關注Google地圖的最新情報欄。\n\n謝謝大家🤗\n\n\nこのたび、本丸亭は日本・横浜にて新店舗をオープンいたしました。\nそれに伴い、店主は5月末頃まで横浜の新店舗にてサポートに入る予定でございます。\n\n台湾本店をご愛顧いただいている皆さまには臨時休業についてご不便をおかけいたしますが、何卒ご理解いただけますと幸いです。\n\nまた台湾に戻り、皆さまとお会いできる日を心より楽しみにしております。\n\nそして、再び皆さまに美味しい一杯のラーメンをお届けできることを願っております。\n\n営業に関する最新情報は、Googleマップの最新情報欄にて随時お知らせいたしますので、ぜひご確認くださいませ。\n\nありがとうございます😊",1]]],[1777267572,1793078772],null,null,null,"4303579678658942286","5451450629285259661",["https://www.google.com/search?sca_esv\u003dabca9301b52d9f7f\u0026authuser\u003d0\u0026hl\u003dzh-TW\u0026gl\u003dtw\u0026output\u003dsearch\u0026q\u003d%E5%A1%A9%E3%82%89%E3%80%9C%E9%BA%BA+%E6%9C%AC%E4%B8%B8%E4%BA%AD\u0026ludocid\u003d15574982442015027362\u0026lpsid\u003dCIHM0ogKELnOz6iKv7n2fA\u0026ibp\u003dgwp;0,10#lpstate\u003dpid:CIHM0ogKELnOz6iKv7n2fA,ar","/gmb/local_post/accounts%2F-%2Flocations%2F5451450629285259661%2FlocalPosts%2F4303579678658942286/version/1777267572651000","https://www.google.com/local/content/rap/report?postId\u003dCM6qucip3djcOxIWQ0lITTBvZ0tFTG5PejZpS3Y3bjJmQRoTQ2d3STlPYTd6d1lROFBXYW5nTQ\u0026d\u003d286732320\u0026t\u003d20"],"https://search.google.com/local/posts?q\u003d%E5%A1%A9%E3%82%89%E3%80%9C%E9%BA%BA+%E6%9C%AC%E4%B8%B8%E4%BA%AD\u0026ludocid\u003d15574982442015027362\u0026lpsid\u003dCIHM0ogKELnOz6iKv7n2fA\u0026source\u003dsh/x/loc/post\u0026lsig\u003dAB86z5Xq5em-eaMNvCHSGX74HX