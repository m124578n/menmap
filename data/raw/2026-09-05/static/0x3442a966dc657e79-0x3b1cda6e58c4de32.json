oAA"]],1],null,null,"餐點類型",null,"0ahUKEwipl6-vs9eWAxUqnK8BHT6yIfkQ3IcHCG0oBg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwipl6-vs9eWAxUqnK8BHT6yIfkQ3IcHCG8oBw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwipl6-vs9eWAxUqnK8BHT6yIfkQ3IcHCHAoCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwipl6-vs9eWAxUqnK8BHT6yIfkQ3IcHCHEoCQ",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["在西門町萬年地下一樓，這裡環境也就那樣，跟周遭店家差不多，甚至比較乾淨些，簡單吃一餐還是可以的。\n\n餐點味道還不錯，是還會想再光顧的濃湯味道。可能最近吃比較清淡，覺得腸胃有點負擔，所以配上水蓮覺得舒服很多。\n點了豚肉叉燒飯，吃拉麵有點膩的時候可以換個味道，豬肉不算很嫩，屬於比較瘦肉的部分多。而章魚不會有太重的哇沙比味道，覺得還挺剛好。\n\n出餐效率高，服務親切👍。",null,[0,103]]]],[null,null,null,null,null,"https://business.google.com/local/business/1618156032664939757/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3ZUZWcmVFdGhWbXhMWXpJNU5FNVhWVFJPUmtWM1pXeHdTVkZZWXhBQhAA",[null,null,null,"/local/business/1618156032664939757/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3ZUZWcmVFdGhWbXhMWXpJNU5FNVhWVFJPUmtWM1pXeHdTVkZZWXhBQhAA"],"https://business.google.com/local/business/1618156032664939757/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3ZUZWcmVFdGhWbXhMWXpJNU5FNVhWVFJPUmtWM1pXeHdTVkZZWXhBQhAA",[null,null,null,"/local/business/1618156032664939757/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3ZUZWcmVFdGhWbXhMWXpJNU5FNVhWVFJPUmtWM1pXeHdTVkZZWXhBQhAA"],null,"https://business.google.com/local/business/1618156032664939757/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3ZUZWcmVFdGhWbXhMWXpJNU5FNVhWVFJPUmtWM1pXeHdTVkZZWXhBQhAA",[null,null,null,"/local/business/1618156032664939757/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt3ZUZWcmVFdGhWbXhMWXpJNU5FNVhWVFJPUmtWM1pXeHdTVkZZWXhBQhAA"]],[null,null,8031,["https://w