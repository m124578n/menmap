ull,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjyn4rHs9eWAxVOa_UHHdPtBhEQ3YcHCM8BKAA"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwjyn4rHs9eWAxVOa_UHHdPtBhEQ3YcHCNABKAE"]]],null,"用餐人數",null,"0ahUKEwjyn4rHs9eWAxVOa_UHHdPtBhEQ3IcHCM4BKAs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["這次到らあめん花月嵐吃拉麵，整體感覺算是還可以。\n\n這次點了銀次郎魚豚骨拉麵和大蒜拳骨拉麵兩種主餐。\n\n銀次郎魚豚骨拉麵是豚骨加魚介的組合，湯頭喝起來蠻濃郁的，還帶一點鮮甜味，裡面加了洋蔥丁增加口感，叉燒上面也有撒一些鰹魚粉，整體味道層次蠻豐富的。\n\n大蒜拳骨拉麵則是店裡的人氣招牌，湯頭主打蒜香跟豚骨的濃厚風味，喝起來確實很重口味，如果本身喜歡蒜味的人應該會蠻喜歡。\n\n店裡還有很多免費配料可以自己加，像是生鮮大蒜、黑胡椒和辣韭菜豆芽都可以自由搭配，加入湯裡味道會更有層次，也蠻有趣的。\n\n兩碗吃下來我自己比較推薦銀次郎魚豚骨拉麵，味道比較平衡一點。\n\n算是口味偏重的日式拉麵，如果喜歡濃厚系湯頭的人應該會覺得不錯。",null,[0,50]]]],[null,null,null,null,null,"https://business.google.com/local/business/6004055306566183285/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA",[null,null,null,"/local/business/6004055306566183285/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA"],"https://business.google.com/local/business/6004055306566183285/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA",[null,null,null,"/local/business/6004055306566183285/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA"],null,"https://business.google.com/local/business/6004055306566183285/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA",[null,null,null,"/local/business/6004055306566183285/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVaZDFWcVVrOVpWMVpUWlVoQ01XRklTa3BoV0U1eVVraHNjMVJIWXhBQhAA"]],[null,null,3067,["https://www.google.com/maps/rev