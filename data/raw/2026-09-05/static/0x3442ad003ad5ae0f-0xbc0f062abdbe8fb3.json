null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["餐點美味： 90分\n用餐環境： 90分\n服務態度： 95分\n\n心得：新開幕的餐飲店今天經過已經19:55了趕在先20:00打烊前點餐，一位壯碩的男性服務人員服務態度非常非常好，還幫我操作機器並介紹餐點特色～\n用餐環境很寬敞並且乾淨明亮，總共有八桌兩人座可以容納16個人，點完餐到取餐大約只需3分鐘左右，碗筷在自助區並且有提供檸檬水跟豆花可以取用，這一點很加分！\n我今天是吃原味豪華雙拼拉麵，一碗是$188，湯底很鮮甜鮮很棒（服務人員本來說原味的很清淡，但我個人覺得味道超級剛好），有兩片大的叉燒肉、雞肉、筍干清脆好吃，還有一顆溫泉蛋專題來說用料我覺得還蠻豐富的，我覺得一碗$188這樣的菜色在台北真的算很便宜了，我個人是蠻推薦的，並且之後也會再來吃～\n如果要說缺點的話，目前只能用現金付款沒有行動支付，沒有提供發票，我想應該是在試營運的期間的原因吧。",null,[0,29]]]],[null,1786386642000000,1786386642000000,"3 週前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfOEplSmRwOHNRZDFEaDM0YnROUVdLQQ%7CCAEQrcz1_gkiMAoZQ0hfOEplSmRwOHNRZDFEaDM0YnROUVdLQRoTQ2d3STBySG8wd1lRX2V1dHZ3TQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiahr3UtdeWAxUIdPUHHavUC2kQ_2MIXigY"],"https://business.google.com/local/business/6821010362023493783/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLVkdGSVpHWk9iVXB1WTBodk1sTXpiM1JWTUd4UFRYcHNjRmRXUlJBQhAA",[null,null,null,"/local/business/6821010362023493783/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLVkdGSVpHWk9iVXB1WTBodk1sTXpiM1JWTUd4UFRYcHNjRmRXUlJBQhAA"],"https://business.google.com/local/business/6821010362023493783/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLVkdGSVpHWk9iVXB1WTBodk1sTXpiM1JWTUd4UFRYcHNjRmRXUlJBQhAA",[null,null,null,"/local/business/6821010362023493783/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLVkdGSVpHWk9iVXB1WTBodk1sTXpiM1JWTUd4UFRYcHNjRmRXUlJBQhAA"],null,"https://business.google.com/local/business/6821010362023493783/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLVkdGSVpHWk9iVXB1WTBodk1sTXpiM1JWTUd4UFRYcHNjRmRXUlJBQhAA",[null,null,null,"/local/business/6821010362023493783/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLVkdGSVpHWk9iVXB1WTBodk1sTXpiM1JWTUd4UFRYcHNjRmRXUlJBQhAA"],null,["zh-Hant"],[["您好！非常感謝您留