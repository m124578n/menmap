","0ahUKEwjqqY6juteWAxVGdvUHHY3SAesQ1bMECK0BKCQ",null,null,null,[[2]]],[["/m/08xgn7"],"舒適",null,[null,null,null,null,8,1,9],"CgsKCS9tLzA4eGduNw\u003d\u003d","0ahUKEwjqqY6juteWAxVGdvUHHY3SAesQ1bMECK4BKCU",null,null,null,[[2]]],[["/m/02g3g4"],"油條",null,[null,null,null,null,6,0,9],null,"0ahUKEwjqqY6juteWAxVGdvUHHY3SAesQ1bMECK8BKCY",null,null,null,[[2]]],[["/m/0j3d76m"],"冬瓜茶",null,[null,null,null,null,5,0,8],null,"0ahUKEwjqqY6juteWAxVGdvUHHY3SAesQ1bMECLABKCc",null,null,null,[[2]]],[["/g/122np7v2"],"飯",null,[null,null,null,null,5,54,5],"Cg0KCy9nLzEyMm5wN3Yy","0ahUKEwjqqY6juteWAxVGdvUHHY3SAesQ1bMECLEBKCg",null,null,null,[[2]]],[["/m/06wqb"],"空間",null,[null,null,null,null,5,106,40],"CgoKCC9tLzA2d3Fi","0ahUKEwjqqY6juteWAxVGdvUHHY3SAesQ1bMECLIBKCk",null,null,null,[[2]]]]],[["「有些味道，值得被記住；有些夢想，值得重新開始。」\n曾經，我與夥伴一起經營一家小小的拉麵店，用心熬湯、認真煮麵，也因此認識了許多支持我們的客人。\n後來，因為經營理念不同，我選擇離開，放下親手建立的一切。\n原以為故事已經結束，卻因為一句句溫暖的鼓勵而重新開始。\n被迫離開的夥伴告訴我： 「老闆，再開一次吧，我們願意跟著你。」\n熟悉的客人告訴我： 「我們想念那碗麵的味道。」\n正因為這些信任與支持，沐熹誕生了。\n「沐」代表洗去過往，重新出發； 「熹」代表晨曦微光，迎向希望。\n我們保留對拉麵的初心，也研發出屬於沐熹的特色鍋物湯底，讓一碗麵與一鍋湯，都能帶給人溫暖與力量。\n感謝每一位走進沐熹的朋友。\n因為有你們， 這份堅持才能繼續熬煮下去。"],["https://www.google.com/local/place/rap/merchantdescription","https://support.google.com/legal/troubleshooter/1114905#ts\u003d1115658%2C1115689"]],null,null,"https://lh5.googleusercontent.com/-R5Ueh_aS4jA/AAAAAAAAAAI/AAAAAAAAAAA/w-uknLV9Ptw/s44-p-k-no-ns-nd/photo.jpg",null,null,null,null,null,null,null,[1],"新北市板橋區溪洲里",null,null,null,null,null,null,null,null,[null,[null,1],0,[3,3,7,15,148],["評分和評論","分享你的經驗供他人參考",1,"詳細說明你在這個地點的親身體驗"],null,null,null,null,[[[[["Ci9DQUlRQUNvZENodHljRjlvT21aQk1HSTJkakJRV0hOSlpGZElibE5OZEVWdkxXYxAB",["0x0:0xfee3c111431b75c8",null,1772350035954109,1772350035954109,[null,null,["https://www.google.com/maps/contrib/103758429650517194805/reviews?hl\u003dzh-TW"],null,null,["Doggy Doggy","https://lh3.googleusercontent.com/a-/ALV-UjVUpybEqp3v39f0HEZLjPU-HZPaRhi7Ww6cg9zgYievP7siV_B9\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/10375842965