,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2tWTFNYcG5NUzExZWpac1JEWnBjbnAwTmxOTlpHYxAB"]],"CIABIhA3w2dg0VodQOY55pjpY82k",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3YcHCFYoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3IcHCFUoBw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3YcHCFgoAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3YcHCFkoAQ"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3YcHCFooAg"]]],null,"用餐人數",null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3IcHCFcoCA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3YcHCFwoAA"]],1],null,null,"等待時間",null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3IcHCFsoCQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["肥宅拉麵鄙視鏈的吠舍(大概吠舍與首陀之間),算是開啟台北大拉麵時代的始祖,第一間在台北東區,現已歇業,那時候吃屯京都要排隊呢.屯京算是對想嘗試日系拉麵的朋友很好的入門,個人只要有魚介的選項,幾乎九成都會點魚介.然後這次發現屯京有賣沾麵(記得以前沒有),就來嚐嚐看了(也是幾乎有沾麵就點沾麵),整體表現中歸中舉,麵條是用很一般的捲麵,不像鬼金棒 一燈 壹の穴都用比較粗且有咬勁的麵條,麵屋緣甚至用蕎麥,沾麵汁也比較水(沾麵汁其實都會弄得比較稠),不過魚介的濃厚度其實是夠的,麵條吸附湯汁效果佳是其優點,個人覺得其實蠻好吃的,不過叉燒跟溏心蛋就真的很普XDDD奶油菠菜好吃,屯京特色是有一些別家沒有的鐵板小菜,例如鐵板蛋液炸豬排,奶油蛤蠣,奶油菠菜,另外還有生菜沙拉,這比很多沒有蔬菜的拉麵店來說是其優點~如果你覺得大熱天不想在中山排知名拉麵店排到天荒地老,來屯京也不錯喔~而且樓上有四人桌,適合家庭來吃~",null,[0,174]]]],[],[null,null,2408,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tWTFNYcG5NUzExZWpac1JEWnBjbnAwTmxOTlpHYxAB!2m1!1s0x0:0x681a0464964fd86a!3m1!1s2@1:CAIQACodChtycF9oOkVLSXpnMS11ejZsRDZpcnp0NlNNZGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2tWTFNYcG5NUzExZWpac1JEWnBjbnAwTmxOTlpHYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNv