[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3YcHCEUoAA"]],1],null,null,"等待時間",null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ3IcHCEQoCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["如果你是老饕，【屯京】算是台灣拉麵熱潮的時代眼淚，也是少數歷經十多年競爭，依然還活得優雅的日本拉麵品牌。\n\n屯京的豚骨拉麵，品質穩定！無論你十年前來吃，還是今天來吃，那碗熟悉的豚骨醬油湯頭幾乎沒有太大變化。湯頭以豚骨為基底，加入醬油提味，濃郁卻不至於厚重到讓人有負擔。最大的特色在於帶有明顯魚介香氣，入口先是豚骨的油脂與醬油鹹香，尾韻則有柴魚與魚乾堆疊出的鮮味，層次比一般豚骨拉麵更豐富一些。\n\n近年台北陸續出現許多來自東京一線名店的品牌，無論湯頭細節、食材講究或風味創新，都把拉麵競爭拉到另一個層級。今天再吃屯京，你未必會感到驚艷，畢竟，味蕾嚐過驚艷就回不去了！",null,[0,52]]]],[],[null,null,3110,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25oMU5WTXRaVTlHWjNNdGRsVmZVbWRzT1ZWWFRHYxAB!2m1!1s0x0:0x681a0464964fd86a!3m1!1s2@1:CAIQACodChtycF9oOnh1NVMtZU9GZ3MtdlVfUmdsOVVXTGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25oMU5WTXRaVTlHWjNNdGRsVmZVbWRzT1ZWWFRHYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25oMU5WTXRaVTlHWjNNdGRsVmZVbWRzT1ZWWFRHYxI-Ci9DQUlRQUNvZENodHljRjlvT25oMU5WTXRaVTlHWjNNdGRsVmZVbWRzT1ZWWFRHYxILMGU4RzYxczJyYUQaPgovQ0FJUUFDb2RDaHR5Y0Y5b09uaDFOVk10WlU5R1ozTXRkbFZmVW1kc09WVlhUR2MSCzBlOEc2MXMycmFEIhIJAAAAAAAAAAARathPlmQEGmgqCzBlOEc2MXMycmFE\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQoykIRigL"],null,[null,[[1,0]]]],"0ahUKEwiQyta4steWAxUmeV4EHchhI8YQ0pMFCAIoAA"],null,null,null,"0ahUKEwiRjs-4steWAxUXlK8BHXPaEGwQ0pMFCDEoAA"],[["Ci9DQUlRQUNvZENodHljRjlvT2tWTFNYcG5NUzExZWpac1JEWnBjbnAwTmxOTlpHYxAB",["0x0:0x681a0464964fd86a",null,1780324152362771,1780324152362771,[null,null,["https://www.google.com/maps/contrib/117818472633041116166/reviews?hl\u003dzh-TW"],null,null,["張智銓","https://lh3.googleusercontent.com/a-/ALV-UjX1oi8-7nYMRyF_qQJg3mwdTABVHQWq9MIsM1vKgNk6GGpkUCNdyw\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/117818472633041116166?hl\u003dzh-TW"],"117818472633041116166",null,498,4620,null,[1