,null,null,null,null,null,["zh-Hant"],[["麵體是細麵，吃起來蠻不錯的，湯頭也不會太鹹，麵跟湯整體表現都還不錯。\n\n桌面上還有免費的蔥絲可以自己加，另外也有胡椒、辣椒醬、蒜泥三種調料，可以依照自己喜歡的口味調整。\n\n叉燒就比較普通，沒有特別驚艷。\n套餐裡的炸雞反而讓我很喜歡！雞肉非常多汁。\n\n另外加點了迷你布丁 $29，這個非常普通，如果沒有特別想吃甜點，可以直接略過\n\n最加分的還是服務！店員都很有朝氣地互相喊聲、回應，連廚房人員也會一起回應，整間店很有活力。\n\n整體來說餐點中規中矩，炸雞跟服務是我覺得比較值得稱讚的部分！",null,[0,84]]]],[],[null,null,null,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21WdVQyNUxSRFZrYnkxdVRHeEhVa1ZUUWsxcGVHYxAB!2m1!1s0x0:0x1338a9ccf7214e2c!3m1!1s2@1:CAIQACodChtycF9oOmVuT25LRDVkby1uTGxHUkVTQk1peGc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21WdVQyNUxSRFZrYnkxdVRHeEhVa1ZUUWsxcGVHYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT21WdVQyNUxSRFZrYnkxdVRHeEhVa1ZUUWsxcGVHYxI-Ci9DQUlRQUNvZENodHljRjlvT21WdVQyNUxSRFZrYnkxdVRHeEhVa1ZUUWsxcGVHYxILMGVhdnhZbS1HUWMaPgovQ0FJUUFDb2RDaHR5Y0Y5b09tVnVUMjVMUkRWa2J5MXVUR3hIVWtWVFFrMXBlR2MSCzBlYXZ4WW0tR1FjIhIJAAAAAAAAAAARLE4h98ypOBMqCzBlYXZ4WW0tR1Fj\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiBmJfusteWAxULa_UHHcKIGYIQoykISSgN"],null,[null,[[1,0]]]],"0ahUKEwig1Z3usteWAxWhgNYIHUZ8FhwQ0pMFCAooAQ"],null,null,null,"0ahUKEwiBmJfusteWAxULa_UHHcKIGYIQ0pMFCDIoAQ"],[["Ci9DQUlRQUNvZENodHljRjlvT2s1SFVWOTBZVWhrUjBkc1dYRlhTUzAwTFRaZlRFRRAB",["0x0:0x1338a9ccf7214e2c",null,1788580766328141,1788580766328141,[null,null,["https://www.google.com/maps/contrib/112557744550773586234/reviews?hl\u003dzh-TW"],null,null,["AKUEI LITTLE","https://lh3.googleusercontent.com/a-/ALV-UjXZ3rLVoxqJWyvKZoaEElbUSpfLNzfYWyYrLdHYFTSBRk23rPHa\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/112557744550773586234?hl\u003dzh-TW"],"112557744550773586234",null,30,97,null,[1,5,1],0,["在地嚮導 · 30 則評論",null,null,null,null,[null,"0ahUKEwiBmJfusteWAxULa_UHHcKIGYIQpr8GCEsoAA"]]]],null,"8 小時前",null,null,null,null,null,null,["Google","https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",null,null,5],null,1],[[4],null