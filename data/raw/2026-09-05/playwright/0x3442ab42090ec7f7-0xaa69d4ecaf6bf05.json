873897466?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjUwuLMA6xQGwMu8iOQ4fzN4rwoQDg90778n4JfAHT9fsbzCpWh5\u003ds120-c-rp-mo-ba12-br100",null,null,"105625373493873897466"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,6,7,11,null,null,null,null,["2 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhC7qHpimpdl8n_hGY7tWHVU\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xaa69d4ecaf6bf05"]],1,null,null,null,null,null,null,["0","767473748251426565"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xoQ2FEQnFVWHBFUlhkSFJXMVRkV0Z0VGxKNlIwRRAB"]],"CIABIhC7qHpimpdl8n_hGY7tWHVU",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwiUj7XnsteWAxXmk68BHZ8CA1YQ3YcHCIsBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiUj7XnsteWAxXmk68BHZ8CA1YQ3IcHCIoBKAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiUj7XnsteWAxXmk68BHZ8CA1YQ3YcHCI0BKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiUj7XnsteWAxXmk68BHZ8CA1YQ3IcHCIwBKA0",null,null,null,null,null,1,[[2]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["那日去爬象山前在路上發現拉麵店…\n実正拉麵很不起眼的一家店…\n但很有日本拉麵店感覺…\n店內的位置不多…\n面對窗戶及吧檯的座位滿溫馨的…\n店員跟老闆都很親切…\n店員會請你先用機器購票…\n然後再出去外面候位等待叫號…\n那天很幸運等一下就入內用餐了…\n加麵可選粗麵、細麵…\n可以客製化去調整軟硬…\n雞豚骨味增拉麵大豐收$350…\n拉麵在蔥花、洋蔥和水蓮的點綴…\n一上桌都會手機先吃….\n湯頭味增十分濃郁味增湯頭偏香辣…\n第一次在拉麵看到加入水蓮…\n店家很豪氣直接給一整顆…\n一口咬下沒預期下的驚喜…\n溏心蛋熟度掌握得恰到好處…\n拉麵選擇細麵…\n每一條麵條都包裹著湯汁…\n叉燒肉更是這碗拉麵的亮點之一…\n豬梅花叉燒處理的真的軟嫩好吃…\n在肉量上店家也給的大方…\n火炒叉燒飯$80…\n跟在其他家吃的叉燒不一樣…\n火炒叉燒塊鑊氣十足…\n整體口味調味偏重…\n感覺就很像台式醬油炒肉塊…\n搭配上紫洋蔥跟蔥花超合…\n鯖味豆腐$50…\n雞蛋豆腐不大塊…\n淋上鰹魚、柴魚、鯖魚薄淡醬油…\n有讓我們驚艷到…\n原來這口感可以這麼豐富…\n可樂$30",null,[0,42]]]],[null,1780849035000000,1780849035000000,"2 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfdjhVTGVnWlgtNk1BSHhWM204NlpRUQ%7CCAEQrcz1_gkiMAoZQ0hfdjhV