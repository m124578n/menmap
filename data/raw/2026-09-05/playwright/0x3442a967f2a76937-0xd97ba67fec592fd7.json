,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiMtajqtNeWAxUTVPUHHSRDLOYQ3IcHCL8BKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiMtajqtNeWAxUTVPUHHSRDLOYQ3IcHCMABKAk",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["今天吃柚子柑橘也好好吃😋😋\n\n-\n\n這次用餐體驗實在太差！\n一顆還嫌太多\n\n今天再度到貴店用餐\n1:47拉麵上桌\n2:00整直接關冷氣🙂\n都還沒吃完…也不是說在滑手機幹嘛的\n若真的很著急要關店\n建議1:30過後就考慮是否接客？\n這種天氣關不到兩分鐘裡面就比外面還熱\n到底要讓人怎麼吃？\n（哦對～連水也沒有）\n之前每次都是遇到老闆\n也都是很開心的用餐體驗！\n這位阿姨直接把這家店黑了\n關冷氣還門甩來甩去\n真的不需要這樣趕客人欸😒\n\n用餐結束\n阿姨：今天口味都還行嗎？\n現在回覆你：口味可以！就妳不行✋\n\n- - - - - - - - - - - - - - -\n今日吃每日限定-柚子柑橘醬油叉燒拉麵\n湯頭、麵條及份量都能請店家調整\n內用也會給予紙杯 提供冰塊水～非常友善\n個人喜歡「麵體硬、湯頭鹹度普通」\n真的煮的都非常剛剛好！\n唯一美中不足 溏心蛋不夠入味\n點餐至上菜約15-20分鐘左右\n可能要時間充裕才有辦法吃\n老闆對食材很有自己的堅持\n感覺是處女座🤣🤣（瞎猜）\n不過也因此才會有好的品質🌟",null,[0,16]]]],[null,1718872203000000,1718872203000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04QzJHOEhtUlJtYy1pTEFBbloxdw%7CCAEQrcz1_gkiMAoZQ0hfQm04QzJHOEhtUlJtYy1pTEFBbloxdxoTQ2d3SWk5SFBzd1lRMElfdXJnSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiMtajqtNeWAxUTVPUHHSRDLOYQ_2MIwQEoCg"],"https://business.google.com/local/business/11298354278043006394/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjRjM0o1TTFabkVBRRAA",[null,null,null,"/local/business/11298354278043006394/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjRjM0o1TTFabkVBRRAA"],"https://business.google.com/local/business/11298354278043006394/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjRjM0o1TTFabkVBRRAA",[null,null,null,"/local/business/11298354278043006394/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjRjM0o1TTFabkVBRRAA"],null,"https://business.google.com/local/business/11298354278043006394/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTjRjM0o1TTFabkVBRRAA",[null,null,null,"/local/business/1129835427804300