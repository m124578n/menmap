ull,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiMtajqtNeWAxUTVPUHHSRDLOYQ3IcHCJgBKAk",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiMtajqtNeWAxUTVPUHHSRDLOYQ3YcHCJoBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiMtajqtNeWAxUTVPUHHSRDLOYQ3IcHCJkBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["拉麵的店門不大，第一次來前後走幾遍還沒看到，哈\n門口是現煮拉麵的桌檯，還可以清楚看到雞白湯湯桶，鮮白濃郁的湯放在那!\n裡面大約四五個桌子有冷氣吹，簡單乾淨。\n我們點了雞白湯，醬油，還有一碗麻辣口味的\n個人覺得麵條很Q越嚼越香，口感好吃的細麵。\n湯頭不會太油膩，配上蒜香真的香濃好喝，川味的辣也夠味帶勁，\n肉體算嫩油脂中等，糖心蛋稍嫌破蛋時乾了點，但也算OK~\n價錢我覺得算實惠，\n好吃會再訪的拉麵店!",null,[0,78]]]],[null,null,null,null,null,"https://business.google.com/local/business/11298354278043006394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZEZKVWJGSlZSM1JaVVdwR1NsTXlVbUZSTTJ4bVlWUk9URmRJWXhBQhAA",[null,null,null,"/local/business/11298354278043006394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZEZKVWJGSlZSM1JaVVdwR1NsTXlVbUZSTTJ4bVlWUk9URmRJWXhBQhAA"],"https://business.google.com/local/business/11298354278043006394/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZEZKVWJGSlZSM1JaVVdwR1NsTXlVbUZSTTJ4bVlWUk9URmRJWXhBQhAA",[null,null,null,"/local/business/11298354278043006394/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZEZKVWJGSlZSM1JaVVdwR1NsTXlVbUZSTTJ4bVlWUk9URmRJWXhBQhAA"],null,"https://business.google.com/local/business/11298354278043006394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZEZKVWJGSlZSM1JaVVdwR1NsTXlVbUZSTTJ4bVlWUk9URmRJWXhBQhAA",[null,null,null,"/local/business/11298354278043006394/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZEZKVWJGSlZSM1JaVVdwR1NsTXlVbUZSTTJ4bVlWUk9URmRJWXhBQhAA"]],[null,null,10386,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT20wdFJUbFJVR3RZUW