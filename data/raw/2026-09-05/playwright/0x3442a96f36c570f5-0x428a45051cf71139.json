,null,"服務",null,"0ahUKEwjmm-GJs9eWAxVWlK8BHYRGJ7UQ3IcHCMIBKAQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjmm-GJs9eWAxVWlK8BHYRGJ7UQ3IcHCMMBKAU",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["樂山娘拉麵是日本一家歷史悠久的拉麵連鎖店，專賣道地的札幌拉麵。 在台灣，樂山娘拉麵引進已有四十多年的歷史，但目前在台灣僅剩高雄和台北林森兩家店。 這家店的特色在於其較粗且Q彈的麵條，以及豐富的配料，如叉燒、筍乾、豆芽菜、等。 湯頭則偏向傳統日式拉麵的風味，較為濃郁。\n\n樂山娘拉麵的名稱「どさん娘」在愛奴語中意為北海道原住民。 儘管在台灣拉麵店競爭激烈，樂山娘拉麵憑藉其特色和品質，在高雄經營了十多年，仍有其獨特魅力。 除了拉麵，樂山娘也提供其他日式料理，如親子丼。 親子丼的雞肉滑嫩，搭配甜鹹的醬汁和滑嫩的蛋液，與米飯結合，相當美味。\n\n樂山娘拉麵的店內裝潢簡樸，但對細節相當講究，例如湯匙的設計，以避免湯匙滑入湯碗中。 儘管在台灣經營不易，樂山娘拉麵仍堅持提供道地的日本風味拉麵。",null,[0,133]]]],[null,null,null,null,null,"https://business.google.com/local/business/23841529203633120/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLTTFWWGVITlZiazV6VTFkV2FVNHdaRzVTTTJjeVYycE9UMkpHUlJBQhAA",[null,null,null,"/local/business/23841529203633120/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLTTFWWGVITlZiazV6VTFkV2FVNHdaRzVTTTJjeVYycE9UMkpHUlJBQhAA"],"https://business.google.com/local/business/23841529203633120/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLTTFWWGVITlZiazV6VTFkV2FVNHdaRzVTTTJjeVYycE9UMkpHUlJBQhAA",[null,null,null,"/local/business/23841529203633120/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLTTFWWGVITlZiazV6VTFkV2FVNHdaRzVTTTJjeVYycE9UMkpHUlJBQhAA"],null,"https://business.google.com/local/business/23841529203633120/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLTTFWWGVITlZiazV6VTFkV2FVNHdaRzVTTTJjeVYycE9UMkpHUlJBQhAA",[null,null,null,"/local/business/23841529203633120/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFLTTFWWGVITlZiazV6VTFkV2FVNHdaRzVTTTJjeVYycE9UMkpHUlJBQhAA"]],[null,null,5809,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21KM1VXeHNVbk5zU1dWaU4wZG5SM2cyV2pOT2JGRRAB!2m1!1s0x0:0x428a45051cf7113