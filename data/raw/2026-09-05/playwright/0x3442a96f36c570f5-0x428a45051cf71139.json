偏低.\n還會再訪，下次來點關東煮或煎餃跟炒物.",null,[0,40]]]],[null,null,null,null,null,"https://business.google.com/local/business/23841529203633120/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTm9hVFJ4UWtsM0VBRRAA",[null,null,null,"/local/business/23841529203633120/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTm9hVFJ4UWtsM0VBRRAA"],"https://business.google.com/local/business/23841529203633120/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTm9hVFJ4UWtsM0VBRRAA",[null,null,null,"/local/business/23841529203633120/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTm9hVFJ4UWtsM0VBRRAA"],null,"https://business.google.com/local/business/23841529203633120/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTm9hVFJ4UWtsM0VBRRAA",[null,null,null,"/local/business/23841529203633120/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTm9hVFJ4UWtsM0VBRRAA"]],[null,null,4986,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNoaTRxQkl3EAE!2m1!1s0x0:0x428a45051cf71139!3m1!1s2@1:CIHM0ogKEICAgIChi4qBIw%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUNoaTRxQkl3EAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUNoaTRxQkl3Ei0KF0NJSE0wb2dLRUlDQWdJQ2hpNHFCb3dFEhJDZ3NJN09qVm53WVF1UFg1WmcaLQoWQ0lITTBvZ0tFSUNBZ0lDaGk0cUJZdxITQ2d3SW5PYlZud1lRdVBPS29RTSISCQAAAAAAAAAAETkR9xwFRYpCKgswWXhNR2dCcmJlcw\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjmm-GJs9eWAxVWlK8BHYRGJ7UQoykI2QEoCg"],null,[null,[[1,0]]]],"0ahUKEwjbs-iJs9eWAxUmeV4EHchhI8YQ0pMFCH0oBg"],null,null,null,"0ahUKEwjmm-GJs9eWAxVWlK8BHYRGJ7UQ0pMFCMUBKAY"],[["ChdDSUhNMG9nS0VJQ0FnSUQ1dXNQX3JnRRAB",["0x0:0x428a45051cf71139",null,1698064760682922,1698064760682922,[null,null,["https://www.google.com/maps/contrib/107235499576271756130/reviews?hl\u003dzh-TW"],null,null,["Troy Mi","https://lh3.googleusercontent.com/a-/ALV-UjWFKBuPPY5lupSMfgLX74wvGVTsTZUzBSQ