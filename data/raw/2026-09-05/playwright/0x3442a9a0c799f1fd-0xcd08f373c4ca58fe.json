null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3YcHCIQBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCIMBKAY",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCIUBKAc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCIYBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCIcBKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11vt5v6cwn"],"東京醬油拉麵",2,null,null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3YcHCIkBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCIgBKAo",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3YcHCIsBKAA"]],1],null,null,"等待時間",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCIoBKAs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["在捷運善導寺站附近，本來好像也是一間拉麵店，不過是連鎖的那一種，後來沒有開了之後，店面空了一段時間，現在又還是拉麵店。\n\n我是在11點半的時候進去用餐，也就是剛開店的時候，不太需要等待，點了一碗醬油拉麵NT$250 可以免費加麵 加的面上面會有一塊叉燒，感覺還挺不錯的。\n\n進到店裡之後，右邊會有一臺自助點餐機，會需要用那台點餐機點餐，點完之後入座之後，拉麵煮好會直接送上桌。\n\n面的內容物包含了叉燒、筍絲、海苔以及一顆溏心蛋，味道我覺得也還算不錯。可以免費加麵這一點，我覺得挺加分的。而且感覺加密也加的蠻有誠意的。\n\n結論我覺得如果是在附近需要吃午餐的話，是一間可以來吃的拉麵店，不過店裡面的內用座位不多，如果是用餐期來有可能會需要排隊。",null,[0,135]]]],[null,null,null,null,null,"https://business.google.com/local/business/1009342438046655534/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzUTJJeFpFaFdWamxFVmpOTmVsZ3lOVkJVYkdSdVpERnNVMDlJWXhBQhAA",[null,null,null,"/local/business/1009342438046655534/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzUTJJeFpFaFdWamxFVmpOTmVsZ3lOVkJVYkdSdVpERnNVMDlJWXhBQhAA"],"https://business.googl