,null,null,null,null,null,["0","-3672417817572255490"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUQ1Z015Tjd3RRAB"]],"CIHM0ogKEICAgID5gMyt9wE",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3YcHCJ0CKAA"]],1],null,null,"訂單類型",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCJwCKA4",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3YcHCJ8CKAA"]],1],null,null,"餐點類型",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCJ4CKA8",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3YcHCKECKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCKACKBA",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCKICKBE",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCKMCKBI",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi546O0steWAxV9kK8BHaVbLVEQ3IcHCKQCKBM",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["★拉麵迷請進→FB搜尋：『台灣拉麵愛好會』、IG：twramenclub\n\n▎區域／鄰近地點：台北市／捷運善導寺出口2\n▎排隊狀況：有\n▎拉麵名稱／價格：濃厚魚介醬油沾麵SP／360\n\n★採QR線上點餐再結帳\n★點餐前可免費加大，請考量自身食量不要浪費\n\n這間蘭丸開幕的過程可以說是非常像電視劇，充滿意外！\n\n從一開始掛招牌被麵友拍照轉到社團引發討論後，大家就一直期待開幕；結果反而沒有等到開幕卻等到要頂讓的消息出來，又讓麵友們震驚與意外...\n\n本來以為沒戲了，卻又突然迸出要開幕了消息，真的是驚喜不斷充滿意外。\n\n這間蘭丸跟其他蘭丸品項有做出區隔且有一些呈現方式不同，如下：\n1.定番主打為沾麵\n2.沒有濃湯\n3.採QR線上點餐且可以使用支付\n4.加麵點餐前就需確認，事後加要加價\n\n剛開幕那週幾乎每天收到的消息都是排滿滿的人潮，我特別安排下一周再過去，那天莫名的很幸運只排一下下，因為隔天又是收到大排長龍的情報，真的麵神保佑！\n\n蘭丸的店內都是圓桌的方式呈現，這點也跟其他拉麵店不太一樣。\n而這間蘭丸除了主打沾麵不同外，另外一個重點也是亮點就是把〔鷹流製麵］這塊招牌展現出來！\n\n台灣自家製麵的店的可以說是少之又少，而其中又能將製麵客製化發揮的淋漓盡致，大概鷹流一定是其中的翹楚了。\n\n蘭丸林森主打的沾麵太麵麵條，在之前的鷹流限定沾麵有出現過相同的手法，就是在麵條中間處會有一條線，據了解和前輩們文章說明，可以加快煮麵的時間外也可以增加麵條巴湯的量*。\n\n(*麵條是由外往內慢慢熟，中間壓線會讓最難熟透的部分厚度沒那麼厚可能讓最難熟的地方相對少一點時間，此外麵條煮好還是可以看到細微的凹痕，這凹痕也是可以巴多一點沾湯的關鍵)\n\n沾麵出餐會比較慢的其中一個原因就是沾麵的麵條要煮的時間比較久，此外也需要在洗過冰鎮讓其口感更佳。所以這麵條特點認真說我覺得以一間主打沾麵的店來說，上麵的速度我覺得是快的！\n\n另外內場的空間配置也有別於其他拉麵店，內場是在店的最裡面，而且是透明玻璃呈現可以從用餐區直接看到內場煮麵的過程，那天社長也有在現場且站煮麵的位置，店內也有一位員工幫忙擺盤和其他事情。\n\n外場就是負責招呼和結帳還有排隊的事情，同時也會幫忙送餐。\n我們入座之後就是會提供我QR進行線上點餐，但是點餐有一個Bug就是沒辦法刪除點錯的品項...\n\n▎濃厚魚介醬油沾麵SP：\n\nＳＰ跟一般就是差在叉燒量和一顆溏心蛋，沾麵麵條預設煮前２５０ｇ，加大３８０ｇ。\n\n我不確定我們的撒必斯是加大的份量還是再更多，我只知道加大的量真的也很多，食量不大的麵友真的不要嘗試，量力而為。\n\n沾湯油度蠻高的，且有較大一點背脂顆粒在沾湯內，上面還有撒上一小堆的魚粉。\n\n味道上是帶一點酸味的豚骨魚介風味，沾湯濃度是屬於比較水的呈現，但是油度高的關係，湯還是可以很順利的巴在麵上，鹹度上單喝稍高，但是搭配麵吃就很剛好，很順口可以一直吃，沾湯的量我大份量麵吃完還有一半以上左右。\n\n麵條也同樣是這碗的精華，有軟Ｑ口感，其實這碗我認真說素沾麵就非常可以了。\n\n叉燒肉我自己覺得跟和創一樣有點沒存在感，瘦肉的厚度算薄，帶皮五花就比較厚一點且軟嫩。\n筍乾一貫的鷹流好吃的多汁帶點甜口的醬油味道。\n溏心蛋溏心很棒，是流心帶膏的蛋黃，如果是下次來我應該會點一般加溏心蛋和筍乾。\n\n湯割的清湯是自行取用，我因為光要把麵條吃光就很困難了，所以那次就沒有湯割了，覺得很可惜！",null,[0,59]]]],[null,null,null,null,null,"https://business.google.com/local/business/1009342438046655534/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUTFaMDE1VGpkM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/1009342438046655534/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUTFaMDE1VGpkM1JSQUIQAA%3D%3D"],"https://business.google.com/local/business/1009342438046655534/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUTFaMDE1VGpkM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/1009342438046655534/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUTFaMDE1VGpkM1JSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/1009342438046655534/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUTFaMDE1VGpkM1JSQUIQAA%3D%3D",[null,null,null,"/local/business/1009342438046655534/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVUTFaMDE1VGpkM1JSQUIQAA%3D%3D"]],[null,null,22571,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUQ1Z015Tjd3RRAB!2m1!1s0x0:0xcd