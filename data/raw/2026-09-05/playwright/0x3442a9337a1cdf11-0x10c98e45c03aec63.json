",null,"0ahUKEwiihJnqs9eWAxX7YvUHHddYM6EQ3IcHCH4oCw",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiihJnqs9eWAxX7YvUHHddYM6EQ3IcHCH8oDA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiihJnqs9eWAxX7YvUHHddYM6EQ3IcHCIABKA0",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11t6gfvq0t"],"招牌清湯叉燒拉麵",2,null,null,"0ahUKEwiihJnqs9eWAxX7YvUHHddYM6EQ3YcHCIIBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiihJnqs9eWAxX7YvUHHddYM6EQ3IcHCIEBKA4",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwiihJnqs9eWAxX7YvUHHddYM6EQ3YcHCIQBKAA"]]],null,"座位類型",null,"0ahUKEwiihJnqs9eWAxX7YvUHHddYM6EQ3IcHCIMBKA8",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["朝聖新莊名店～\n這間位於幸福路上，平日來至少還是需要等20-30分鐘，店員相當貼心，在等待同時會一直關心需不需要水或茶，會先到自動點餐機先選好，等到帶下樓後再將單子明細給服務人員。\n\n📍招牌清湯叉燒拉麵 420元\n叉燒肉片非常的薄，有點炙燒香氣，肉品的軟嫩度是有的，麵體我選偏硬，但吃起來還是算軟一些（是細拉麵），店員會建議先吃麵和肉片，因為留點湯等等都還可免費加麵，不加蔥會另外給你海苔片，湯頭適中有洋蔥和蔬菜的甜味。\n\n📍叉燒飯 70元\n上面有滿滿的蒜酥和紫洋蔥碎，裡面燒肉醬和美乃滋讓飯體口感滑順，肉塊切和洋蔥碎大小，份量其實蠻多的，吃起來不會太鹹但飯偏濕軟。\n\n續麵也可以選麵偏硬或適中，份量非常足夠。",null,[0,90]]]],[null,null,null,null,null,"https://business.google.com/local/business/17118813351812930306/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4WVU0d1ZubGxWamxtWVZVNVNWcEVWazFZTTA1cVRXMDROV1JyUlJBQhAA",[null,null,null,"/local/business/17118813351812930306/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4WVU0d1ZubGxWamxtWVZVNVNWcEVWazFZTTA1cVRXMDROV1JyUlJBQhAA"],"https://business.google.com/local/business/17118813351812930306/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4WVU0d1ZubGxWamxtWVZVNVNWcEVWazFZTTA1cVRXMDROV1JyUlJBQhAA",[null,null,null,"/local/business/17118813351812930306/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaR