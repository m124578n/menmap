點",null,"0ahUKEwinyPnJsteWAxXoZvUHHRSVKnQQ3IcHCHgoCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwinyPnJsteWAxXoZvUHHRSVKnQQ3IcHCHkoCw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwinyPnJsteWAxXoZvUHHRSVKnQQ3IcHCHooDA",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["會喔，這一家店是會想要推薦給吃素的朋友來唷。\n沒想到素食餐廳也有拉麵，而且這個蕃茄湯頭還挺不錯的，以後會想要帶媽媽來吃。\n\n份量還挺大的，一碗拉麵裡面那厚厚的百葉兩塊就把我給弄飽了，雖然多，我們還是有加套餐，另外品嚐了三種不同的小菜：炸杏鮑菇我覺得是第一名，玉子燒口感很好，味道偏甜，再一個藍帶起司，很有特色！\n\n套餐的小菜一起分享，各自再吃一碗麵，我們三個人AA一個人吃下來四百多台幣。\n\n店裡面的座位還挺多的，有洗手間，方便。\n服務很親切。",null,[0,60]]]],[null,null,null,null,null,"https://business.google.com/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUdWR1pHbFdhMHBMWlZWc1IySnJSakZNVjAxNlZEQm9RbUZGUlJBQhAA",[null,null,null,"/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUdWR1pHbFdhMHBMWlZWc1IySnJSakZNVjAxNlZEQm9RbUZGUlJBQhAA"],"https://business.google.com/local/business/15943577517523358854/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUdWR1pHbFdhMHBMWlZWc1IySnJSakZNVjAxNlZEQm9RbUZGUlJBQhAA",[null,null,null,"/local/business/15943577517523358854/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUdWR1pHbFdhMHBMWlZWc1IySnJSakZNVjAxNlZEQm9RbUZGUlJBQhAA"],null,"https://business.google.com/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUdWR1pHbFdhMHBMWlZWc1IySnJSakZNVjAxNlZEQm9RbUZGUlJBQhAA",[null,null,null,"/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjB3ZUdWR1pHbFdhMHBMWlZWc1IySnJSakZNVjAxNlZEQm9RbUZGUlJBQhAA"]],[null,null,9232,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT20weGVGZGlWa0pLZVVsR2JrRjFMV016VDBoQ