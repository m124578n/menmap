,[4],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwinyPnJsteWAxXoZvUHHRSVKnQQ3YcHCKQBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwinyPnJsteWAxXoZvUHHRSVKnQQ3IcHCKMBKAk",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwinyPnJsteWAxXoZvUHHRSVKnQQ3YcHCKYBKAA"]]],null,"用餐人數",null,"0ahUKEwinyPnJsteWAxXoZvUHHRSVKnQQ3IcHCKUBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["我的口味\n一般的鹹淡若是5分，我的大概是4分這樣的正常偏淡\n\n我喜歡吃辣，但不太能吃辣\n\n番茄火焰拉麵，對我來說，有一點太辣，需要分次吃完，非常好吃\n原味的番茄湯頭很好喝，酸甜的濃郁番茄，再加上辣醬後，湯頭更香了，再加上多種中藥就更有層次感了，海苔提了鮮味、溏心蛋也很棒，讓我願意分次吃完湯再把湯喝完🤤\n\n餐點上桌後，服務員都會來詢問是否需要調整，所以也是這樣再調整成更適合自己的口味\n\n醬油拉麵，甘醇的湯頭讓人願意再多點一碗白飯，吃完麵後，再來一碗湯泡飯",null,[0,29]]]],[null,null,null,null,null,"https://business.google.com/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3YW1WdFVrMU9hemgwV1RGR1JGcHRjRzFsUlZZd1kyNUNiMkpHUlJBQhAA",[null,null,null,"/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3YW1WdFVrMU9hemgwV1RGR1JGcHRjRzFsUlZZd1kyNUNiMkpHUlJBQhAA"],"https://business.google.com/local/business/15943577517523358854/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3YW1WdFVrMU9hemgwV1RGR1JGcHRjRzFsUlZZd1kyNUNiMkpHUlJBQhAA",[null,null,null,"/local/business/15943577517523358854/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3YW1WdFVrMU9hemgwV1RGR1JGcHRjRzFsUlZZd1kyNUNiMkpHUlJBQhAA"],null,"https://business.google.com/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3YW1WdFVrMU9hemgwV1RGR1JGcHRjRzFsUlZZd1kyNUNiMkpHUlJBQhAA",[null,null,null,"/local/business/15943577517523358854/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3YW1WdFVrMU9hemgwV1RGR1JGcHRjRzFsUlZZd1kyNUNiMkpHUlJBQ