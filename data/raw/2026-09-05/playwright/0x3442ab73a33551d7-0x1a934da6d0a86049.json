,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjO0dansteWAxVUZ_UHHfx7KYkQ3YcHCIcBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjO0dansteWAxVUZ_UHHfx7KYkQ3IcHCIYBKA0",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwjO0dansteWAxVUZ_UHHfx7KYkQ3YcHCIkBKAA"]]],null,"座位類型",null,"0ahUKEwjO0dansteWAxVUZ_UHHfx7KYkQ3IcHCIgBKA4",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["入店門邊有點菜單，劃單後給店員，有空位都可以坐。\n吃完結帳，可現金、第三方支付及刷卡。\n\n豚骨/雞骨及雞貝湯頭，推出鹽味、黑蒜油及限定版醬油拉麵。\n\n首訪品嚐限定-鴨鰹櫛醬油拉麵$310\n\n湯頭偏甜蓋掉了不少鰹節味道，需要一口鴨肉配一口湯增添香味。\n\n厚切鴨肉跟梅花豬叉燒份量足很有誠意，麵條爽滑脆彈口感絕佳。\n\n整體來說算值得一吃的限定拉麵\n\n單點唐揚雞很厲害，炸牡蠣的粉皮略厚了點。\n\n限定-燻旨牡蠣拉麵$340\n\n煙燻油封牡蠣x 牡蠣魚介貝旨金湯\n\n如文案所說湯頭濃郁滑順，味道平衡和融入感極具水準，麵條是軟彈很順口哪種，非常好吃不要錯過了。",null,[0,43]]]],[null,null,null,null,null,"https://business.google.com/local/business/4807877109313218834/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTU0UxSE5USmxhM0JyVVRKV1NVNTZaRnBXYTNoNlRYcEpNR05zUlJBQhAA",[null,null,null,"/local/business/4807877109313218834/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTU0UxSE5USmxhM0JyVVRKV1NVNTZaRnBXYTNoNlRYcEpNR05zUlJBQhAA"],"https://business.google.com/local/business/4807877109313218834/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTU0UxSE5USmxhM0JyVVRKV1NVNTZaRnBXYTNoNlRYcEpNR05zUlJBQhAA",[null,null,null,"/local/business/4807877109313218834/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTU0UxSE5USmxhM0JyVVRKV1NVNTZaRnBXYTNoNlRYcEpNR05zUlJBQhAA"],null,"https://business.google.com/local/business/4807877109313218834/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTU0UxSE5USmxhM0JyVVRKV1NVNTZaRnBXYTNoNlRYcEpNR05zUlJBQhAA",[null,null,null,"/local/business/4807877109313218834/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBTU0