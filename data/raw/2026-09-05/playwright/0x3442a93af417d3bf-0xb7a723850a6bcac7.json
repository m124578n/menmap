p-mo-ba12-br100",null,null,"113199160726799469034"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,6,30,15,null,null,null,null,["2 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDxwDrvPZ2zyA-JNwsXC0FB\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0xb7a723850a6bcac7"]],1,null,null,null,null,null,null,["0","-5213158989345600825"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pNM1VHOWFiVkpEWmpoM2Vtc3RTa1pwTVVkQk1IYxAB"]],"CIABIhDxwDrvPZ2zyA-JNwsXC0FB",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["蛤出汁醬油味玉 - 湯頭非常棒，第一次嘗試蛤蜊湯底的拉麵，完全不會突兀，海鮮的鮮味和湯底簡單的醬油調味搭配的恰到好處。醬油味道比較清甜一些，完全不會死鹹，算是少數完全可以把湯喝完的拉麵。麵條貌似沒辦法調整硬度，但韌勁剛剛好，是我喜歡的類型。蛤蜊給的超級多，非常有誠意，每一顆都很飽滿新鮮。雞肉和豬肉的叉燒整體都表現的不錯，嫩度剛好但又不失肉味，個人比較喜歡豬叉燒，溏心蛋表現的也不錯。店家提供的辣粉真的很辣，存在感很強，也很適合中間變換口味來解膩。整碗表現的很棒，我很喜歡。\n還另外單點了脆皮燒肉，脆皮處理的不錯，但口味稍微比較鹹，而且溫度有點不太夠（個人喜好），亦或是需要搭配熱熱的湯。\n整體來說是很棒的拉麵店，口味很好，用餐的體驗也不錯，不會覺得很有壓力，環境也維持的比較整潔。",null,[0,237]]]],[null,null,null,null,null,"https://business.google.com/local/business/12521728942448216741/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBOTTFWSE9XRmlWa3BFV21wb00yVnRjM1JUYTFwd1RWVmtRazFJWXhBQhAA",[null,null,null,"/local/business/12521728942448216741/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBOTTFWSE9XRmlWa3BFV21wb00yVnRjM1JUYTFwd1RWVmtRazFJWXhBQhAA"],"https://business.google.com/local/business/12521728942448216741/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBOTTFWSE9XRmlWa3BFV21wb00yVnRjM1JUYTFwd1RWVmtRazFJWXhBQhAA",[null,null,null,"/local/business/12521728942448216741/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBOTTFWSE9XRmlWa3BFV21wb00yVnRjM1JUYTFwd1RWVmtRazFJWXhBQhAA"],null,"https://business.google.com/local/business/12521728942448216741/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBOTTFWSE9XRmlWa3BFV21wb