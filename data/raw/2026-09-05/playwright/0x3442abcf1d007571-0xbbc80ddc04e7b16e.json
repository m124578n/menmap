null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjQkKu5steWAxXpm68BHeebACoQ3IcHCKMBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjQkKu5steWAxXpm68BHeebACoQ3IcHCKQBKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwjQkKu5steWAxXpm68BHeebACoQ3YcHCKYBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwjQkKu5steWAxXpm68BHeebACoQ3YcHCKcBKAE"]]],null,"用餐人數",null,"0ahUKEwjQkKu5steWAxXpm68BHeebACoQ3IcHCKUBKAo",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_30_TO_60_MIN"],"30 到 60 分鐘",2,null,null,"0ahUKEwjQkKu5steWAxXpm68BHeebACoQ3YcHCKkBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjQkKu5steWAxXpm68BHeebACoQ3IcHCKgBKAs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["假日晚上前往，大約需要等待四十分鐘左右。排隊過程中，店員會先請客人掃描 QR Code 點餐並提前結帳，之後再依序安排入座。如果願意接受併桌，店家還會額外贈送半份叉燒。\n\n淡麗柑橘蛤蜊湯麵\n拉麵上桌時，視覺呈現相當漂亮，會搭配檸檬切片與柑橘切片，不只是裝飾而已，香氣也因此變得鮮明。麵條硬度可以客製化，選擇偏硬的口感，麵體吃起來彈性十足，而且熟度控制得非常精準，可以感受到店家在細節上的講究。\n\n湯頭則是這碗拉麵最讓人印象深刻的地方。以蛤蜊為基底的湯頭本身鮮味就很突出，再加入柑橘元素後，整體層次變得非常特別。不只是單純的柑橘清香而已，甚至可以明顯喝到柑橘皮帶來的一點微苦香氣，再搭配胡椒香，讓整碗湯喝起來既清爽又富有深度。\n\n叉燒的表現也相當不錯，主體是使用大片薄切的方式呈現，口感非常嫩，油脂與肉感的平衡抓得很好，吃起來相當順口，也替整碗拉麵增加不少高級感。不過併桌贈送的叉燒則是捲成小條狀的版本，雖然不差，但相比主餐附的大薄片叉燒，無論口感還是存在感都明顯普通一些。\n\n整體來說，柑橘 Shinn 是一家很有特色的拉麵店，從香氣設計、湯頭層次到麵體控制，都十分優秀。排隊時間不短，喜歡偏清爽、講究香氣變化的拉麵風格，相當值得一試。",null,[0,84]]]],[null,null,null,null,null,"https://business.google.com/local/business/15578589045687056626/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhVFdOR2F6UmpWMDVzVjBkR2NHRXlXVFJpYlhOMFRWYzFhbE5GUlJBQhAA",[null,null,null,"/local/business/15578589045687056626/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFhVFdOR2F6UmpWMDVzVjBkR2NHRXlXVFJpYlhOMFRWYzFhbE5GUlJBQhAA"],"https://business.google.com/local/business/15578589045687056626/customers/reviews/