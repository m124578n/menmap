WAxU9ePUHHUPnLNgQzCcIqQEoAw",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDCsQU0clo03sF1eLek4nG5\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x3c07e75a11948e95",null,null,"0ahUKEwiY0_6RsteWAxU9ePUHHUPnLNgQ-y4IqgEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIABIhDCsQU0clo03sF1eLek4nG5"],[10,3,[4032,3024]],[null,null,null,null,null,null,null,["辰拉麵"]],[null,[[["林Bobo"],"https://www.google.com/maps/contrib/102782059503372414858?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjU69PH35Otkg5KwFutT0pDdnCC2eJl6upYLonyL-foq0VBufDla\u003ds120-c-rp-mo-ba12-br100",null,null,"102782059503372414858"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,1,6,5,null,null,null,null,["7 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhDCsQU0clo03sF1eLek4nG5\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x3c07e75a11948e95"]],1,null,null,null,null,null,null,["0","4325680341140672149"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xwd1UxbENNbVJOY2pWRldVTjRXRVoyVWw5UlRIYxAB"]],"CIABIhDCsQU0clo03sF1eLek4nG5",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiY0_6RsteWAxU9ePUHHUPnLNgQ3IcHCKsBKAQ",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiY0_6RsteWAxU9ePUHHUPnLNgQ3IcHCKwBKAU",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiY0_6RsteWAxU9ePUHHUPnLNgQ3IcHCK0BKAY",null,null,null,[2],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["情緒價值跟服務態度大於美味程度的店，有時間可以來吃吃看。\n\n開店前25分鐘到已經排不少人，店家預估13:00進去，實際13:08進去，進去後大概13:13左右就吃到麵了。\n\n今天吃豚骨大滿足，湯真的很鹹跟膩的，吃到一半沒有轉味的方式就膩到有點吃不下去了，肉算嫩但有筋多而且豬味有點重，麵普通，以這個等候時間來說覺得不太行。\n\n叉燒飯不錯吃。\n\n開店前的排隊可以解壓縮，快要到的時候再來就好，不過當天遇到有一組五人的客人，最開始點餐登記的時候就有一人沒點，這樣也能登記？最後到他們的時候甚至人沒到齊也能帶位進去？\n那一位比其他人遲到好幾分鐘最後還是直接進去🤣看來闆娘口中的熟客還有門外的規則（未到齊優先下一組）有機會因人而異！但確實就是店家解釋權最大那就尊重！只是供麵友們參考囉～ 更：能理解店家很細心服務態度也很好，只是說人沒到齊就進去會讓麵友有疑慮而已，客人有什麼理由所以人還沒到，應該還是遵守同一規則才好，服務態度真的好呦👍\n\n喜歡安靜快速吃麵跟遵守規則想快點吃到麵的不太適合來，裡面人聲鼎沸充滿活力！看人喜好可吃看看！",null,[0,85]]]],[null,1767680962000000,1767680962000000,"7 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfWnZ5MDVubnkxVk1qSW5hNFFsZ0ZmQQ%7CCAEQrcz1_gkiMAoZQ0hfWnZ5MDVubnkxVk1qSW5hNFFsZ0ZmQRoTQ2d3SXd0Znl5Z1lRNDR2Mm5RRQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiY0_6RsteWAxU9ePUHHUPnLNgQ_2MIrgEoBw"],"https://business.google.com/local/business/6168209519588645144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZDFVeGJFTk5iVkpPWTJwV1JsZFZUalJYUlZveVZXdzVVbFJJWXhBQhAA",[null,null,null,"/local/business/6168209519588645144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZDFVeGJFTk5iVkpPWTJwV1JsZFZUalJYUlZveVZXdzVVbFJJWXhBQhAA"],"https://business.google.com/local/business/6168209519588645144/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZDFVeGJFTk5iVkpPWTJwV1JsZFZUalJYUlZveVZXdzVVbFJJWXhBQhAA",[null,null,null,"/local/business/6168209519588645144/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZDFVeGJFTk5iVkpPWTJwV1JsZFZUalJYUlZveVZXdzVVbFJJWXhBQhAA"],null,"https://business.google.com/local/business/6168209519588645144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZDFVeGJFTk5iVkpPWTJwV1JsZFZUalJYUlZveVZXdzVVbFJJWXhBQhAA",[null,null,null,"/local/business/6168209519588645144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnh3ZDFVeGJFTk5iVkpPWTJwV1JsZFZUalJYUlZveVZXdzVVbFJJWXhBQhAA"],null,["zh-Hant"],[["感謝您的指教與建議，也謝謝您願意留下評論供其他客人參考。\n祝福 12/6 登記五號、13:00 兩位的弟妹，之後能找到更符合口味喜好的拉麵，新年快樂，也辛苦候位了。\n\n這邊補充說明幾點，也提供給第一次來的朋友參考：\n\n1️⃣ 關於湯頭口味\n三個口味其中的豚骨拉麵在介紹菜單時，我們都會主動提醒屬於較為濃稠、重口味的湯頭。\n若偏好清淡、喜歡喝湯的客人，可以選擇「塩味雞湯」或「醬油雞湯」。\n若覺得湯頭偏鹹，也都可以隨時向我們索取清湯稀釋，或一開始就告知調整鹹度，都是沒有問題的 ❤️\n\n2️⃣ 關於候位與代排方式\n小店的運作方式中有提到可代為登記候位，登記時完成點餐及結帳，方便店家計算剩餘碗數及降低登記no show的狀況，相關說明在 Facebook、IG 及 Google 貼文皆可查閱，資訊皆為公開透明。\n\n3️⃣ 關於當天五位客人的安排說明\n弟妹提到的五位客人，為登記表第二輪 1 號。\n當天開店排隊時，熟客已先協助五位點好餐點（五碗豚骨拉麵及叉燒飯），但當下僅先支付1碗，其餘款項因錢不夠後續補齊。\n約12:30-12:40 五位到齊時，店內僅剩 1、1、2 分散座位，熟客過往多希望能同桌，因此闆娘先行安排後續客人入座（2 號呂先生 1 位、3 號常客把拔 1 位、4 號新朋友弟妹 2 位）。\n待現場空出五個相連座位後，才安排 1 號五位入座，其中一位當時尚在便利商店提款途中，以上為當天實際狀況說明。\n\n再次謝謝兩位五號弟妹的評論與回饋，\n也感謝您們的回饋❤️\n謝謝！\n",null,[0,82]]]],[null,null,21302,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xwd1UxbENNbVJOY2pWRldVTjRXRVoyVWw5UlRIYxAB!2m1!1s0x0:0x3c07e75a11948e95!3m1!1s2@1:CAIQACodChtycF9oOlpwU1lCMmRNcjVFWUN4WEZ2Ul9RTHc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xwd1UxbENNbVJOY2pWRldVTjRXRVoyVWw5UlRIYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xwd1UxbENNbVJOY2pWRldVTjRXRVoyVWw5UlRIYxI-Ci9DQUlRQUNvZENodHljRjlvT2xwd1UxbENNbVJOY2pWRldVTjRXRVoyVWw5UlRIYxILMGRNRGpFQTVSSmgaPgovQ0FJUUFDb2RDaHR5Y0Y5b09scHdVMWxDTW1STmNqVkZXVU40V0VaMlVsOVJUSGMSCzBkTURqRUE1UkpoIhIJAAAAAAAAAAARlY6UEVrnBzwqCzBkTURqRUE1Ukpo\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiY0_6RsteWAxU9ePUHHUPnLNgQoykIrwEoCA"],null,[null,[[1,0]]]],"0ahUKEwi_yYSSsteWAxWveV4EHQTiLdIQ0pMFCF4oBg"],null,null,null,"0ahUKEwiY0_6RsteWAxU9ePUHHUPnLNgQ0pMFCKMBKAY"],[["Ci9DQUlRQUNvZENodHljRjlvT210VlFqQlRTbVJpVTNCM05rWkZUV0ZmUVdsZlYzYxAB",["0x0:0x3c07e75a11948e95",null,1783570958956133,1783570958956133,[null,null,["https://www.google.com/maps/contrib/102496682298114332122/reviews?hl\u003dzh-TW"],null,null,["彭建澄","https://lh3.googleusercontent.com/a-/ALV-UjUroTk8yCNOjc9tnIbOvDg_peLetx6bixF4kzEUtgNFWo4yptRD\u003ds120-c-rp-mo-ba12-br100",["https://www.google.com/maps/contrib/102496682298114332122?hl\u003dzh-TW"],"102496682298114332122",null,18,12,null,[1,4,1],6,["在地嚮導 · 18 則評論",null,null,null,null,[null,"0ahUKEwiY0_6RsteWAxU9ePUHHUPnLNgQpr8GCLEBKAA"]]]],null,"1 個月前",null,null,null,null,null,null,["Goo