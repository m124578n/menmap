oogle.com/local/business/6168209519588645144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLUTFReWFFNWhNRnB2Vm5wc1RVNXRkSEZUTTJSWVdWVkdORlV3UlJBQhAA",[null,null,null,"/local/business/6168209519588645144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLUTFReWFFNWhNRnB2Vm5wc1RVNXRkSEZUTTJSWVdWVkdORlV3UlJBQhAA"],"https://business.google.com/local/business/6168209519588645144/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLUTFReWFFNWhNRnB2Vm5wc1RVNXRkSEZUTTJSWVdWVkdORlV3UlJBQhAA",[null,null,null,"/local/business/6168209519588645144/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLUTFReWFFNWhNRnB2Vm5wc1RVNXRkSEZUTTJSWVdWVkdORlV3UlJBQhAA"],null,"https://business.google.com/local/business/6168209519588645144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLUTFReWFFNWhNRnB2Vm5wc1RVNXRkSEZUTTJSWVdWVkdORlV3UlJBQhAA",[null,null,null,"/local/business/6168209519588645144/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRLUTFReWFFNWhNRnB2Vm5wc1RVNXRkSEZUTTJSWVdWVkdORlV3UlJBQhAA"]],[null,null,4407,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tKQ1QyaE5hMFpvVnpsTU5tdHFTM2RYWVVGNFUwRRAB!2m1!1s0x0:0x3c07e75a11948e95!3m1!1s2@1:CAIQACodChtycF9oOkJCT2hNa0ZoVzlMNmtqS3dXYUF4U0E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2tKQ1QyaE5hMFpvVnpsTU5tdHFTM2RYWVVGNFUwRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2tKQ1QyaE5hMFpvVnpsTU5tdHFTM2RYWVVGNFUwRRI-Ci9DQUlRQUNvZENodHljRjlvT2tKQ1QyaE5hMFpvVnpsTU5tdHFTM2RYWVVGNFUwRRILMGRwRHlhQVFPQWoaPgovQ0FJUUFDb2RDaHR5Y0Y5b09rSkNUMmhOYTBab1Z6bE1ObXRxUzNkWFlVRjRVMEUSCzBkcER5YUFRT0FqIhIJAAAAAAAAAAARlY6UEVrnBzwqCzBkcER5YUFRT0Fq\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiY0_6RsteWAxU9ePUHHUPnLNgQoykIVCgI"],null,[null,[[1,1]]]],"0ahUKEwi_yYSSsteWAxWveV4EHQTiLdIQ0pMFCAIoAA"],null,