null,null,null,[3],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjH2eTPsteWAxVOla8BHbdnJ0MQ3IcHCNsBKA8",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjH2eTPsteWAxVOla8BHbdnJ0MQ3IcHCNwBKBA",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["20250214\n太餓了就來吃這家拉麵\n位於忠孝新生出口不遠處\n經過公園即可到達\n星期五晚上人不太多\n還有位置可以坐不用等\n店內裝潢算復古（？\n不太通風\n所以店員把門打開\n但太冷了我去關了幾次\n拉麵就是普通偏台式的拉麵\n味道沒有特別驚豔\n麵軟吃起來很像麵糊\n我以為是牙齒咬不動結果是太軟沒有嚼勁\n硬的麵又對我來說太硬\n細麵很細粗麵不粗\n湯頭普通，比較像調理包而不是熬煮的味道（但實際不知道\n料不算多，加麵才吃得飽\n就中規中矩這樣吧\n不過店員不會趕人\n可以稍微坐著休息一下\n只是店裡比較舊而已",null,[0,31]]]],[null,null,null,null,null,"https://business.google.com/local/business/17290239222458417689/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTjNNeloyYUd4QlJSQUIQAA%3D%3D",[null,null,null,"/local/business/17290239222458417689/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTjNNeloyYUd4QlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/17290239222458417689/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTjNNeloyYUd4QlJSQUIQAA%3D%3D",[null,null,null,"/local/business/17290239222458417689/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTjNNeloyYUd4QlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/17290239222458417689/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTjNNeloyYUd4QlJSQUIQAA%3D%3D",[null,null,null,"/local/business/17290239222458417689/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblRVTjNNeloyYUd4QlJSQUIQAA%3D%3D"]],[null,null,10965,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnTUN3MzZ2aGxBRRAB!2m1!1s0x0:0x586b1ea2ead75ebb!3m1!1s2@1:CIHM0ogKEICAgMCw36vhlAE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnTUN3MzZ2aGxBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0FnTUN3MzZ2aGxBRRItCh