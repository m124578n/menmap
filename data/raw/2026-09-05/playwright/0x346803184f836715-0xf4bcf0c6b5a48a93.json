位時間多久？",[[[["E:DINING_WAIT_TIME_10_TO_30_MIN"],"10 到 30 分鐘",2,null,null,"0ahUKEwj0vNbstNeWAxUtb_UHHRi7OHQQ3YcHCI8BKAA"]],1],null,null,"等待時間",null,"0ahUKEwj0vNbstNeWAxUtb_UHHRi7OHQQ3IcHCI4BKAw",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["叉燒盛宴豚骨拉麵320\n\n麵可免費續半碗甚至一碗！麵的表現屬於有嚼勁的種類\n湯頭的由於我選日本味，確實也有濃厚到\n由於我是特盛所以肉是有3種各2片，分別是雞叉燒跟五花肉叉燒跟里脊肉叉燒\n雞肉表現還好，里脊肉口感較為紮實，但仍帶有適度的油脂算不錯，但五花肉叉燒有做到入口即化的程度，很讚！\n溏心蛋是一整顆，也很好加上海苔3片\n\n叉燒飯（限量）60\n叉燒飯中，有在叉燒上淋上美乃滋再炙燒，增添風味和口感，在這平衡上抓的很好，很推薦額外加點食用\n\n內用有提供含冰塊的冰水在吧台上可供使用\n\n最後食用完畢，還會問有沒有吃飽，算小貼心，進去牆壁上有衣帽掛可掛，然後這間很會排隊，所以要排隊可以在外面準備好的簽到簿寫就行了，不需進去問",null,[0,37]]]],[null,null,null,null,null,"https://business.google.com/local/business/12528766041847503037/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhZUZsclpISmFWMnhzVGpCa1JFOVhWbnBqUmxsNlRVUlNOV1ZHUlJBQhAA",[null,null,null,"/local/business/12528766041847503037/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhZUZsclpISmFWMnhzVGpCa1JFOVhWbnBqUmxsNlRVUlNOV1ZHUlJBQhAA"],"https://business.google.com/local/business/12528766041847503037/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhZUZsclpISmFWMnhzVGpCa1JFOVhWbnBqUmxsNlRVUlNOV1ZHUlJBQhAA",[null,null,null,"/local/business/12528766041847503037/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhZUZsclpISmFWMnhzVGpCa1JFOVhWbnBqUmxsNlRVUlNOV1ZHUlJBQhAA"],null,"https://business.google.com/local/business/12528766041847503037/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhZUZsclpISmFWMnhzVGpCa1JFOVhWbnBqUmxsNlRVUlNOV1ZHUlJBQhAA",[null,null,null,"/local/business/12528766041847503037/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVhZUZsclpISmFWMnhzVGpCa1JFOVhWbnBqUmxsNlRVUlNOV1ZHUlJBQhAA"]],[null,null,25819,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25aeFlrZHJaV2xsTjBkRE9XVnpjRll6TURSNWVGRRAB!2m1!1s0x0:0xf4bcf0c6b5a48a93!3m1!1s2@1:CAIQACodC