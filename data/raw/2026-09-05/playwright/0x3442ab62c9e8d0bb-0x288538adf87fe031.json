www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhBmR55zTxpfBFBnB5w8kH65\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x288538adf87fe031"]],1,null,null,null,null,null,null,["0","2919802253269262385"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25vd01sTnNPVFpaV1UwMU9WTmhlRlJ3Y1dzd1EzYxAB"]],"CIABIhBmR55zTxpfBFBnB5w8kH65",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwjEkr7Zs9eWAxXNm68BHVurCY4Q3YcHCHUoAA"]],1],null,null,"餐點類型",null,"0ahUKEwjEkr7Zs9eWAxXNm68BHVurCY4Q3IcHCHQoFQ",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjEkr7Zs9eWAxXNm68BHVurCY4Q3IcHCHYoFg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjEkr7Zs9eWAxXNm68BHVurCY4Q3IcHCHcoFw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjEkr7Zs9eWAxXNm68BHVurCY4Q3IcHCHgoGA",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["店內空間寬敞明亮，乾淨整潔，店員服務親切有禮。\n\n麵條可以選細麵或是粗麵\n麵條硬度也分成軟、基本、硬三種，湯頭也多種選擇。\n\n配料豐富：叉燒、溏心蛋、玉米筍、花椰菜、筍乾，叉燒是炙燒過的，吃得出烤過的味道。\n\n川味炙燒牛拉麵\n牛五花肉，通過炙燒後去除了多數油脂，不但不會油膩，還增添了炙燒後炭烤的香氣，再撒上些許的黑胡椒增香，整體吃起來很有層次，而且肉給的份量非常實在，幾乎快蓋滿半圈的碗，口味上不會太麻太辣。\n\n🎉【新菜色更是讓人眼睛一亮】\n\n➡️柑橘鹽味豪華海鮮拉麵\n主打清新柑橘香氣融合濃郁雞湯與海鮮精華，創造層次豐富又不失清爽的湯頭 。\n\n➡️柑橘鹽味拉麵\n黃澄澄色湯底，湯頭很清爽，柑橘果香與雞高湯完美結合，創造出爽口甘甜風味，鹽味不死鹹，好好喝，喜歡果香豐富湯底的老饕，必定會很愛這款招牌款。\n\n➡️唐揚豆腐【內用限定】\n健康美味▪︎秒殺完食\n金黃色的豆腐，外酥內軟，搭配爽脆的黃金泡菜以及灑上胡椒粉的濃郁風味，無論單吃或與拉麵搭配都毫無違和。\n\n➡️煉乳糰子～香Q軟糯的炸丸子，淋上香甜的煉乳，灑上濃郁的黃豆粉，香甜軟Q又可口，一串接一串，每一口都能讓我很滿足！（超讚的飯後甜點）\n\n唐揚雞～外酥內嫩又多汁，每次來必點。\n\n開心享受美好的午餐時光，簡單卻充滿幸福，每次來都覺得被溫暖的味道和氛圍給包圍。",null,[0,36]]]],[null,1774106321000000,1774106321000000,"5 個月前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQVRwd0pySkI0a19fREtlQ0thVmx6UQ%7CCAEQrcz1_gkiLwoZQ0hfQVRwd0pySkI0a19fREtlQ0thVmx6URoSQ2dzSTBlMzZ6UVlRdnFMdlpR\u0026t\u003d7