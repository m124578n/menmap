AE"]],"CIHM0ogKEICAgIDWodH1oQE",1]],null,null,null,[[["GUIDED_DINING_MODE"],"你是內用、外帶或是使用外送服務？",[[[["E:DINE_IN"],"內用",2,null,null,"0ahUKEwjPi4vcs9eWAxUbc_UHHRU1MlQQ3YcHCL8BKAA"]],1],null,null,"訂單類型",null,"0ahUKEwjPi4vcs9eWAxUbc_UHHRU1MlQQ3IcHCL4BKAw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:DINNER"],"晚餐",2,null,null,"0ahUKEwjPi4vcs9eWAxUbc_UHHRU1MlQQ3YcHCMEBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjPi4vcs9eWAxUbc_UHHRU1MlQQ3IcHCMABKA0",null,null,null,null,null,1,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["今天下雨天八點十分路過此店\n原本以為我想吃拉麵的心今天無局了，沒想到店家還有接帶呢，一對老夫妻經營這家店。\n\n我點了一個日式特濃口味\n特濃九州白湯+79元（小菜兩份+飲料），店家招待了小小份的生菜沙拉用心滿滿呢。\n\n小菜部分我點了蠔油雞胗+小魚乾\n蠔油雞胗非常入味，都切小小一份一口一個剛剛好直接吃爆。\n小魚乾偏大眾口味，甜鹹甜鹹好吃\n\n招待小菜花椰菜+杏鮑菇+紅青椒\n覺得還不錯呢開心.....雖然我不敢吃青椒跟花椰菜\n\n拉麵部分分兩種麵能選\n口味真的濃郁+一點辣椒粉超合我口味直接吃到乾",null,[0,53]]]],[null,null,null,null,null,"https://business.google.com/local/business/5892718791580303018/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUlhiMlJJWldKM0VBRRAA",[null,null,null,"/local/business/5892718791580303018/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUlhiMlJJWldKM0VBRRAA"],"https://business.google.com/local/business/5892718791580303018/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUlhiMlJJWldKM0VBRRAA",[null,null,null,"/local/business/5892718791580303018/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUlhiMlJJWldKM0VBRRAA"],null,"https://business.google.com/local/business/5892718791580303018/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUlhiMlJJWldKM0VBRRAA",[null,null,null,"/local/business/5892718791580303018/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVUlhiMlJJWldKM0VBRRAA"]],[null,null,9582,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSURXb2RIZWJ3EAE!2m1!1s0x0:0xc671d4a9cc18e4ec!3m1!1s2@1:CIHM0ogKEICAgIDWodHebw%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/repor