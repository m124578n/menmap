INING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3YcHCFkoAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3IcHCFgoAw",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3IcHCFooBA",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3IcHCFsoBQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3IcHCFwoBg",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3YcHCF4oAA"]],1],null,null,"預訂網址",null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3IcHCF0oBw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_30_TO_60_MIN"],"30 到 60 分鐘",2,null,null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3YcHCGAoAA"]],1],null,null,"等待時間",null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3IcHCF8oCA",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3YcHCGIoAA"],[["E:DINING_SEATING_TYPE_COUNTER_SEATING"],"吧台座位",2,null,null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3YcHCGMoAQ"]]],null,"座位類型",null,"0ahUKEwi4yJactNeWAxXiUfUHHXUXAI8Q3IcHCGEoCQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["連來吃兩天，但不知道怎樣剛好連兩次用餐，旁邊坐的客人都超鬼😐用餐體驗大打折扣…進而影響到餐點美味度…\n但男女店員都蠻熱情的，店家本身服務態度都沒問題，就是排隊問題可以優化。\n\n比起隔壁條路的拉麵店，這邊排隊進度快些，加上開店時間是錯開的，白天如果想吃另外一家沒吃到，可以晚上來吃這家。\n\n餐點部分，泡系雞湯比較濃郁，喜歡清爽者可略過，個人不愛，喝起來像飯店的熬雞湯，醬油湯頭不會過鹹，是可以喝完的。\n叉燒飯調味不錯，但飯很軟爛不太喜。\n最重要的一點是，拉麵沒有溏心蛋🥲蛋是靈魂，所以它沒辦法是心目中滿分拉麵，但很適合對蛋過敏者。\n\n另排隊方式確實可以參考一下別人，要讓客人提早排隊卻又要站著等，又是轉角人行道，另家拉麵店也是要提早排隊，但老闆娘都會知道開店前的候位順序！也減少一些不必要的紛爭，強烈建議店家把點餐機外移吧，先到的就先點，開店後按照點餐號碼叫號。\n\n剛好那天大家都沒站在門口等，結果遇到不要臉的兩位女生，看到店家準備開門馬上衝到門口去😐當其他在那邊等的客人都是傻子嗎…店家好像也無法控管，體感很差。（而且很吵從排隊就講話很大聲，吃飯也是，有夠吵！）",null,[0,86]]]],[null,null,null,null,null,"https://business.google.com/local/business/2270775935772479147/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDUzJSNlRtaGhNVVpEVlZkd1RWbFhhM2xhTTBwdVRVZGFhMkV3UlJBQhAA",[null,null,null,"/local/business/2270775935772479147/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDUzJSNlRtaGhNVVpEVlZkd1RWbFhhM2xhTTBwdVRVZGFhMkV3UlJBQhAA"],"https://business.google.com/local/business/2270775935772479147/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDUzJSNlRtaGhNVVpEVlZkd1RWbFhhM2xhTTBwdVRVZGFhMkV3UlJBQhAA",[null,null,null,"/local/business/2270775935772479147/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDUzJSNlRtaGhNVVpEVlZkd1RWbFhhM2xhTTBwdVRVZGFhMkV3UlJBQhAA"],null,"https://business.google.com/local/business/2270775935772479147/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDUzJSNlRtaGhNVVpEVlZkd1RWbFhhM2xhTTBwdVRVZGFhMkV3UlJBQhAA",[null,null,null,"/local/business/2270775935772479147/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDUzJSNlRtaGhNVVpEVlZkd1RWbFhhM2xhTTBwdVRVZGFhMkV3UlJBQhAA"]],[null,null,3513,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25CS2R6TmhhMUZDVVdwTVlXa3laM0puTUdaa2EwRRAB!2m1!1s0x0:0xc4a0d5867b1f554!3m1!1s2@1:CAIQACodChtycF9oOnBKdzNha1FCUWpMYWkyZ3JnMGZka0E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25CS2R6TmhhMUZDVVdwTVlXa3laM0puTUdaa2EwRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25CS2R6TmhhMUZDVVdwTVlXa3laM0puTUdaa2EwRRI-Ci9DQUlRQUNvZENodHljRjlvT25CS2R6TmhhMUZDVVdwTVlXa3laM0puTUdaa2EwRRILMGRyUUZYR2JxdjUaPgovQ0FJUUFDb2RDaHR5Y0Y5b09uQktkek5oYTFGQ1VXcE1ZV2t5WjNKbk1HWmthMEUSCzBkclFGWEdicXY1IhIJAAAAAAAAAAARVPWxZ1gNSgwqCzBkclFGWEdicXY1\u0026wv\u003d