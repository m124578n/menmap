晚餐",2,null,null,"0ahUKEwja0fjvtNeWAxV8dfUHHfatLzgQ3YcHCJoBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwja0fjvtNeWAxV8dfUHHfatLzgQ3IcHCJkBKAI",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwja0fjvtNeWAxV8dfUHHfatLzgQ3YcHCJwBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwja0fjvtNeWAxV8dfUHHfatLzgQ3IcHCJsBKAM",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwja0fjvtNeWAxV8dfUHHfatLzgQ3IcHCJ0BKAQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwja0fjvtNeWAxV8dfUHHfatLzgQ3IcHCJ4BKAU",null,null,null,[2],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwja0fjvtNeWAxV8dfUHHfatLzgQ3IcHCJ8BKAY",null,null,null,[1],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwja0fjvtNeWAxV8dfUHHfatLzgQ3YcHCKEBKAA"]]],null,"用餐人數",null,"0ahUKEwja0fjvtNeWAxV8dfUHHfatLzgQ3IcHCKABKAc",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["食物本身不錯，麵也蠻好吃的，店員態度也沒有問題。\n但用餐環境真的太悶熱了…\n\n店內是開放式廚房，加上客滿狀態，整間店幾乎像在蒸桑拿，冷氣根本只是裝飾品，吃麵吃到直接滿身汗。\n當天看起來也沒有因應人潮變多，去調低冷氣溫度，體感真的很不舒服，客滿時真的會建議轉到16度。\n\n⭐️如果是比較怕熱的人，來之前可能要先有心理準備⭐️準備好涼感毛巾跟冷感風扇…\n希望店家之後能改善一下空調問題，不然真的會影響整體用餐體驗。",null,[0,37]]]],[null,null,null,null,null,"https://business.google.com/local/business/18397722655821309215/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTkdGWE9EVk9NWEJKVTFSSk0xUnJhSFJqTUhScFdXNUdabEpHUlJBQhAA",[null,null,null,"/local/business/18397722655821309215/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTkdGWE9EVk9NWEJKVTFSSk0xUnJhSFJqTUhScFdXNUdabEpHUlJBQhAA"],"https://business.google.com/local/business/18397722655821309215/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRaTkdGWE9EVk9NWEJKVTFSSk0xUnJhSFJqTUhScFdXNUdabEpHUlJBQhAA",[null,n