://www.google.com/maps/contrib/113922346827659765071?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjVjw_IvZNceIDSIEMzdkSzTyfj-w3N54hX4nL5_C04tx-YEscQ\u003ds120-c-rp-mo-ba12-br100",null,null,"113922346827659765071"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2026,5,8,5,null,null,null,null,["3 個月前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIABIhBWNDaDyu5N7PsZHa7cCaZz\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x365380467d0985ba"]],1,null,null,null,null,null,null,["0","3914613541348935098"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2pFemNrRlZNbmhQYnpJMlNUWm5hbVpMY0RWSVlVRRAB"]],"CIABIhBWNDaDyu5N7PsZHa7cCaZz",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwiP256ftNeWAxWQcvUHHRz2Ig8Q3YcHCGIoAA"]],1],null,null,"餐點類型",null,"0ahUKEwiP256ftNeWAxWQcvUHHRz2Ig8Q3IcHCGEoCw",null,null,null,null,null,1,null,2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiP256ftNeWAxWQcvUHHRz2Ig8Q3IcHCGMoDA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiP256ftNeWAxWQcvUHHRz2Ig8Q3IcHCGQoDQ",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiP256ftNeWAxWQcvUHHRz2Ig8Q3IcHCGUoDg",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["裝潢漂亮的麵店通常是吃氣氛的，沒想到吃完真的有被驚豔到，完全是一間有實力的好店！\n我們點了兩碗不同風味的麵。第一碗是「清燉雪花牛拉麵」，這碗真的很考驗熬湯功夫。湯頭看起來清澈透亮，但喝下去卻充滿牛骨的醇厚甘甜，完全不覺得油膩。雪花牛肉片給得很大方，肉質軟嫩、吸飽了鮮美的湯汁，搭配順口的麵條，用一般民眾的口語來形容，就是讓人忍不住一口接一口暴風吸入。\n另一碗「酸菜梅花豬拉麵」則是完全不同的路線，超級適合重口味愛好者！裡頭的酸菜酸爽夠味，完美扮演了開胃的角色。梅花豬肉片帶點油花但不柴，配著帶勁的酸香湯頭一起吃，口感層次超豐富。我本來那天工作太累有點沒胃口，結果喝了第一口湯就直接大開殺戒。\n除了主食，他們家的小菜也很有水準。特別推薦「麻辣鴨血」和「溏心蛋」！鴨血非常滑嫩入味，咬下去還會微微爆汁，那股麻而不辣的香氣很過癮；溏心蛋的熟度則是控制得堪稱完美，膏狀的濃郁蛋黃不管單吃還是拌著麵湯都超級搭。",null,[0,175]]]],[null,null,null,null,null,"https://business.google.com/local/business/