ll,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3IcHCGQoCQ",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3YcHCGYoAA"]]],null,"用餐人數",null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3IcHCGUoCg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["大概半年前，十一點多來的話整間店只有我一個人。\n現在超過十一點半來就有機會進不來了...不知道為何人氣突然暴增。\n\n以台灣的蝦拉麵來說，算是蠻好吃的。\n蝦子的味道並不會不舒服，而是蠻好的融合在湯頭裡。\n\n喜歡湯麵的可以選拉麵，喜歡口感Q一點的可以選沾面。\n如果怕太鹹的，可以選番茄沾面，口味會稍微更平衡一點。\n不過整體來說還是算口味蠻重的。\n\n座位蠻多的，用餐空間也還算寬敞。\n可惜店內消費只收現金，不能刷卡也沒有行動支付。",null,[0,56]]]],[null,null,null,null,null,"https://business.google.com/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTWVUxR1FrNWhiVEYwVDBoQ2JHSklXalpWUldScVZWZDRjV0l4UlJBQhAA",[null,null,null,"/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTWVUxR1FrNWhiVEYwVDBoQ2JHSklXalpWUldScVZWZDRjV0l4UlJBQhAA"],"https://business.google.com/local/business/12138693963750328653/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTWVUxR1FrNWhiVEYwVDBoQ2JHSklXalpWUldScVZWZDRjV0l4UlJBQhAA",[null,null,null,"/local/business/12138693963750328653/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTWVUxR1FrNWhiVEYwVDBoQ2JHSklXalpWUldScVZWZDRjV0l4UlJBQhAA"],null,"https://business.google.com/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTWVUxR1FrNWhiVEYwVDBoQ2JHSklXalpWUldScVZWZDRjV0l4UlJBQhAA",[null,null,null,"/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVTWVUxR1FrNWhiVEYwVDBoQ2JHSklXalpWUldScVZWZDRjV0l4UlJBQhAA"]],[null,null,47301,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodH