],"午餐",2,null,null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3YcHCJUCKAA"]],1],null,null,"餐點類型",null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3IcHCJQCKAg",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3YcHCJcCKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3IcHCJYCKAk",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3IcHCJgCKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3IcHCJkCKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3IcHCJoCKAw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11tdtm1gtw"],"濃厚豚骨蝦沾麵豪華版",2,null,null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3YcHCJwCKAA"],[["M:/g/11n525vww9"],"濃出汁蝦拉麵",2,null,null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3YcHCJ0CKAE"]],[1]],null,"建議的餐點",null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3IcHCJsCKA0",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3YcHCJ8CKAA"]],1],null,null,"等待時間",null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30Q3IcHCJ4CKA4",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["台北必訪的實力派拉麵\n\n身為拉麵愛好者，久聞五之神的大名，這次來訪果然名不虛傳。一推開門，撲鼻而來的就是極其強烈且充滿質感的蝦香，讓人瞬間食慾大增。\n\n• 濃厚豚骨蝦沾麵（驚艷之作）： 這道的沾醬非常濃厚，蝦的鮮味與豚骨的甜味完美融合，味道的厚度跟在日本吃到的水準差不多。雖然為了因應台灣市場，鹹度似乎有稍微調低（不像日本原版那麼重鹹），但也因此變得更耐喝、更好入口，是台灣人絕對能接受並愛上的極致口味。\n• 濃出汁蝦拉麵： 湯頭雖然清一點但鮮味依然爆炸，蝦味清甜且不會讓人感到油膩。\n• 麵條表現： 兩款的麵條都非常紮實且充滿嚼勁，尤其是沾麵的粗麵，掛湯力極佳，每一口都能吃到濃濃的蝦精華。\n\n店內的佈置很有趣，到處都可以看到螃蟹和龍蝦的小裝飾。雖然是排隊名店，但服務節奏很好，開放式廚房還可以看到師傅現場處理食材與炙燒，非常有臨場感。\n\n這兩款拉麵都讓人感到驚艷與誠意，是那種「以後來台北絕對會再訪」的清單首選。如果你喜歡海鮮系、蝦系拉麵，這間店絕對不會讓你失望！",null,[0,74]]]],[null,null,null,null,null,"https://business.google.com/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4UkZSSFRtOWhWWFExWWtaR2RsWlhVbEZaTTBaeFVWUldRMlJ1WXhBQhAA",[null,null,null,"/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4UkZSSFRtOWhWWFExWWtaR2RsWlhVbEZaTTBaeFVWUldRMlJ1WXhBQhAA"],"https://business.google.com/local/business/12138693963750328653/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4UkZSSFRtOWhWWFExWWtaR2RsWlhVbEZaTTBaeFVWUldRMlJ1WXhBQhAA",[null,null,null,"/local/business/12138693963750328653/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4UkZSSFRtOWhWWFExWWtaR2RsWlhVbEZaTTBaeFVWUldRMlJ1WXhBQhAA"],null,"https://business.google.com/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4UkZSSFRtOWhWWFExWWtaR2RsWlhVbEZaTTBaeFVWUldRMlJ1WXhBQhAA",[null,null,null,"/local/business/12138693963750328653/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnN4UkZSSFRtOWhWWFExWWtaR2RsWlhVbEZaTTBaeFVWUldRMlJ1WXhBQhAA"]],[null,null,15586,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2sxRFRHTm9hVXQ1YkZGdlZXUlFZM0ZxUVRWQ2RuYxAB!2m1!1s0x0:0x98aed6ab02f6c2cc!3m1!1s2@1:CAIQACodChtycF9oOk1DTGNoaUt5bFFvVWRQY3FqQTVCdnc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2sxRFRHTm9hVXQ1YkZGdlZXUlFZM0ZxUVRWQ2RuYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2sxRFRHTm9hVXQ1YkZGdlZXUlFZM0ZxUVRWQ2RuYxI-Ci9DQUlRQUNvZENodHljRjlvT2sxRFRHTm9hVXQ1YkZGdlZXUlFZM0ZxUVRWQ2RuYxILMGRuSEFIUmVHMWcaPgovQ0FJUUFDb2RDaHR5Y0Y5b09rMURUR05vYVV0NWJGRnZWV1JRWTNGcVFUVkNkbmMSCzBkbkhBSFJlRzFnIhIJAAAAAAAAAAARzML2AqvWrpgqCzBkbkhBSFJlRzFn\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjcxJ2lsteWAxWghq8BHRYiC30QoykIoAIoDw"],null,[null,[[1,0]]]],"0ahUKEwjx3