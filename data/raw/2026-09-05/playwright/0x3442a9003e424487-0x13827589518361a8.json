null,null,"餐點",null,"0ahUKEwiQ4LH6steWAxUPna8BHQlOCwAQ3IcHCJcBKAo",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiQ4LH6steWAxUPna8BHQlOCwAQ3IcHCJgBKAs",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiQ4LH6steWAxUPna8BHQlOCwAQ3IcHCJkBKAw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwiQ4LH6steWAxUPna8BHQlOCwAQ3YcHCJsBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwiQ4LH6steWAxUPna8BHQlOCwAQ3YcHCJwBKAE"]]],null,"用餐人數",null,"0ahUKEwiQ4LH6steWAxUPna8BHQlOCwAQ3IcHCJoBKA0",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["🔅七星潭炸魚 $250👍🏻👍🏻\n炸魚必點！份量不少，適合2～3人分食。魚肉是鬼頭刀，口感軟嫩又多汁，一點腥味都沒有。\n\n🔅時蔬佐特製胡麻醬(龍鬚菜) $80👍🏻\n龍鬚菜很嫩，特製醬汁風味也很特別，甜甜的，有胡麻醬和花生醬的香氣。\n\n🔅鮮魚美白湯麵 $280\n湯頭呈乳白色，風味就是魚湯的味道，沒有特別濃厚或濃稠。配料有半顆溏心蛋與四片炙燒鬼頭刀生魚片。魚肉很新鮮，但因為是半生的關係，口感冰冰脆脆的，有點吃不太習慣。麵條是細拉麵，和湯汁的味道是分離的，口感也沒有到很好。\n\n🔅招牌柚子胡椒麵 $290\n是在基本款魚湯麵上加入柚子胡椒與少許檸檬皮，整體味蕾刺激感會更強烈。如果柚子胡椒能另外附上，作為風味轉換的調味料會更好。\n\nℹ️內用低消$250(沒有強制要點拉麵)。\nℹ️可以免費加湯、加麵。",null,[0,58]]]],[null,null,null,null,null,"https://business.google.com/local/business/6787760459440062479/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhTVZKcWFISlpNMWt3VmxVeE1HRXdhRTFPVkVsNFZXMXdZVkV4UlJBQhAA",[null,null,null,"/local/business/6787760459440062479/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhTVZKcWFISlpNMWt3VmxVeE1HRXdhRTFPVkVsNFZXMXdZVkV4UlJBQhAA"],"https://business.google.com/local/business/6787760459440062479/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhTVZKcWFISlpNMWt3VmxVeE1HRXdhRTFPVkVsNFZXMXdZVkV4UlJBQhAA",[null,null,null,"/local/business/6787760459440062479/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRhTVZKcWFISlpNMWt3VmxVeE1HRXdhRTFPVkVsNFZXMXdZVkV4UlJBQhAA"],null,"https://business.google.com/local/busine