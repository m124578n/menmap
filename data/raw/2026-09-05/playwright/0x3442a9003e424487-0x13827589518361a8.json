d!1e10!2sCIABIhCQaOmw3l2dD3Yaz_K9CjXS\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x13827589518361a8"]],1,null,null,null,null,null,null,["0","1405815266331550120"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2tsTUxYRktXbkJwYldZeGFGVmtOM0ZHYXpsNFNFRRAB"]],"CIABIhCQaOmw3l2dD3Yaz_K9CjXS",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiQ4LH6steWAxUPna8BHQlOCwAQ3IcHCI8CKAg",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiQ4LH6steWAxUPna8BHQlOCwAQ3IcHCJACKAk",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiQ4LH6steWAxUPna8BHQlOCwAQ3IcHCJECKAo",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["有別於其它拉麵的豬骨湯頭，定置漁場三代目 是用鮮魚湯頭 很不一樣的體驗！\n\n中山店位於在晶華酒店旁，是一棟獨特的灰色建築。 店內有濃厚的日式和風裝潢。整體氛圍舒適有質感，非常適合輕鬆用餐。\n\n招牌柚子胡椒麵：魚湯頭有鮮又有柚香 湯頭濃而不膩 湯頭的辛香與海鮮的甜味交織，口感層次非常豐富，魚肉片處理得鮮嫩且完全無腥味！麵是用細麵 。\n\n小川椒胡麻沾麵 川椒沾麵非常開胃 用的是粗一點的Q拉麵，鮮魚片 也是用薄片有炙燒，還送一碗魚湯。\n\n香蔥串炸白帶魚 非常特別好吃\n\n內用還提供免費加湯、加麵的服務。",null,[0,94]]]],[null,null,null,null,null,"https://business.google.com/local/business/6787760459440062479/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzVFV4WVJrdFhia0p3WWxkWmVHRkdWbXRPTTBaSFlYcHNORk5GUlJBQhAA",[null,null,null,"/local/business/6787760459440062479/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzVFV4WVJrdFhia0p3WWxkWmVHRkdWbXRPTTBaSFlYcHNORk5GUlJBQhAA"],"https://business.google.com/local/business/6787760459440062479/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzVFV4WVJrdFhia0p3WWxkWmVHRkdWbXRPTTBaSFlYcHNORk5GUlJBQhAA",[null,null,null,"/local/business/6787760459440062479/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnRzVFV4WVJrdFhia0p3WWxkWmVHRkdWbXRPTTBaSFlYcHNORk5GUlJBQhAA"],null,"https://business.google.com/local/business/678776045944006