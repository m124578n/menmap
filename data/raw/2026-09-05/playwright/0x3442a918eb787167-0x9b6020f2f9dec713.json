BKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3IcHCNMBKAs",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11svmtt355"],"叉燒飯 50",2,null,null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3YcHCNUBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3IcHCNQBKAw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3YcHCNcBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3YcHCNgBKAE"]]],null,"用餐人數",null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3IcHCNYBKA0",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3YcHCNoBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3IcHCNkBKA4",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["*醬油豚骨 +蔥焦油  口味調整：湯鹹、麵硬\n第一次來訪就直接選湯頭鹹度為鹹，果然沒錯！這就是剛好當時我想吃到的拉麵口味！蔥焦油的香氣讓醬油豚骨的風味更有層次，不一會兒已經決定要追加麵。\n\n*叉燒飯\n等待追加麵的短暫期間直接以叉燒飯接力，結果又讓我驚艷一波，剛好以另一道美食轉換口味。炙燒香氣佈滿口腔，叉燒的香醇油脂和醬汁和飽滿分明的好吃米飯讓手裡的湯匙和嘴巴停不下來享受。吃完的意猶未盡，只好藉由追加麵的到來，重回拉麵來彌補口腹。\n\n絕對還要再訪，試試其他口味，但也想要繼續品嚐吃過的好吃餐點，實在兩難。",null,[0,93]]]],[null,null,null,null,null,"https://business.google.com/local/business/8054786247900985761/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHVFdOdGRGVlRWVkpKWTFWWk0yRldWVE5YVjJ4VFZHMVJlV1JWUlJBQhAA",[null,null,null,"/local/business/8054786247900985761/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHVFdOdGRGVlRWVkpKWTFWWk0yRldWVE5YVjJ4VFZHMVJlV1JWUlJBQhAA"],"https://business.google.com/local/business/8054786247900985761/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVHVFdOdGRGVlRWVkpKWTFWWk0yRldWVE5YVjJ4VFZHMVJlV1JWUlJBQhAA",[null,null,null,"/local/business/80547862