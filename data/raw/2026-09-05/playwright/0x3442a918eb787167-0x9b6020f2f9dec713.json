ull,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11svmtt355"],"叉燒飯 50",2,null,null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3YcHCIwCKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwiw6_W_tNeWAxWFn68BHc8SG2wQ3IcHCIsCKAs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["平日晚上路過的拉麵店，即便接近打烊時間客人還是陸陸續續進店裡。\n一拿到菜單就先劃了叉燒飯，後來發現每組客人來都有點，叉燒配上醬汁與美乃滋，大火炙燒，香氣撲鼻。每口飯還都能配上好幾塊叉燒丁，價格實惠，吃得非常滿足。\n拉麵點了鰹魚醬油跟雞白湯（焦蔥油），醬油湯頭很清，不死鹹，味道反而讓麵體剛剛好入味。\n雞白湯湯頭濃郁不膩，麵體（正常）軟硬適中，裡面的雞肉口感軟嫩，溏心蛋流心恰到好處，整體而言非常美味。",null,[0,200]]]],[null,null,null,null,null,"https://business.google.com/local/business/8054786247900985761/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLUjFkdVpIQk5NREUwVkRJMVdsSlZiekpZZWtKQ1QxWnZNV0p0WXhBQhAA",[null,null,null,"/local/business/8054786247900985761/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLUjFkdVpIQk5NREUwVkRJMVdsSlZiekpZZWtKQ1QxWnZNV0p0WXhBQhAA"],"https://business.google.com/local/business/8054786247900985761/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLUjFkdVpIQk5NREUwVkRJMVdsSlZiekpZZWtKQ1QxWnZNV0p0WXhBQhAA",[null,null,null,"/local/business/8054786247900985761/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLUjFkdVpIQk5NREUwVkRJMVdsSlZiekpZZWtKQ1QxWnZNV0p0WXhBQhAA"],null,"https://business.google.com/local/business/8054786247900985761/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLUjFkdVpIQk5NREUwVkRJMVdsSlZiekpZZWtKQ1QxWnZNV0p0WXhBQhAA",[null,null,null,"/local/business/8054786247900985761/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVLUjFkdVpIQk5NREUwVkRJMVdsSlZiekpZZWtKQ1QxWnZNV0p0WXhBQhAA"]],[null,null,7545,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25KR1duZHBNMDE0VDI1WlJVbzJYekJCT1ZvMWJtYxAB!2m1!1s0x0:0x9b6020f2f9dec713!3m1!1s2@1:CAIQACodChtycF9oOnJGWndpM014T25ZRUo2XzBBOVo1bmc%7C%7C?hl\u003dzh-TW"],["https://www