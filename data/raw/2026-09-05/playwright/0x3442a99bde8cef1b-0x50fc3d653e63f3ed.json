,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChdDSUhNMG9nS0VJQ0FnSUN0N2R1cW5nRRAB"]],"CIHM0ogKEICAgIDt_e3jJQ",1]],null,null,null,[[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjq37SXsteWAxWEa_UHHZv0O2EQ3IcHCJABKBU",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjq37SXsteWAxWEa_UHHZv0O2EQ3IcHCJEBKBY",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjq37SXsteWAxWEa_UHHZv0O2EQ3IcHCJIBKBc",null,null,null,[4],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["評價：4.1顆星\n\n一、東京豚骨拉麵不錯。\n1.東京豚骨拉麵：湯不油，豚骨湯頭味道還不錯，叉燒肉呈圓形，有二片，實測直徑與厚度約7*0.2公分，軟嫩鮮甜，糖心蛋半個，蛋黃濕潤軟嫩，蛋白沒有完全入味，部分稍淡而不夠鹹，海帶芽、玉米粒還不錯，乾海苔軟韌不脆，麵條選用細拉麵，不過軟，口感可以，若能硬Q點會更好。整體份量可以，連湯帶麵吃完，一般男士約八分飽。以價位而言，這樣的品質與份量算不錯。\n2.札幌味噌拉麵：湯的味噌味道普通，若能再濃一點會更好，配料與東京豚骨拉麵相同，海帶芽口感可以，味道普通，玉米粒甜脆，糖心蛋軟嫩入味，叉燒肉軟嫩鮮甜，但稍淡而不夠鹹，麵條軟而不爛，若能硬Q點會更好。\n二、店內選用木桌木凳，有二張4人桌，一張2人桌，一張靠牆2人長桌，共可容納12人用餐。光線明亮度、環境清潔度還可以。週二晚上19:40只有一位店員兼管內外場，並無其他顧客，點餐後約十分鐘出餐。\n三、點餐時付款，可用LINE Pay支付。",null,[0,21]]]],[null,null,null,null,null,"https://business.google.com/local/business/16261199067448619346/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjBOMlIxY1c1blJSQUIQAA%3D%3D",[null,null,null,"/local/business/16261199067448619346/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjBOMlIxY1c1blJSQUIQAA%3D%3D"],"https://business.google.com/local/business/16261199067448619346/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjBOMlIxY1c1blJSQUIQAA%3D%3D",[null,null,null,"/local/business/16261199067448619346/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjBOMlIxY1c1blJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/16261199067448619346/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjBOMlIxY1c1blJSQUIQAA%3D%3D",[null,null,null,"/local/business/16261199067448619346/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBG