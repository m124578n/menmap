e\u0026fid\u003d0x0:0x1edd4325fd0e5742"]],1,null,null,null,null,null,null,["0","2224007621429319490"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT25CWlNGTXhkSFZzVkVFelJqSmtabU5oWjJGRldFRRAB"]],"CIABIhAsCsVHTvahIDhDeZBMGZSe",1]],null,null,null,[[["GUIDED_DINING_MEAL_TYPE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3YcHCI4BKAA"]],1],null,null,"餐點類型",null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3IcHCI0BKBU",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3YcHCJABKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3IcHCI8BKBY",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3IcHCJEBKBc",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3IcHCJIBKBg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3IcHCJMBKBk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_QUIET"],"安靜，適合交談",2,null,null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3YcHCJUBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3IcHCJQBKBo",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3YcHCJcBKAA"]],1],null,null,"等待時間",null,"0ahUKEwiKk_q0s9eWAxUHk68BHZnjKOMQ3IcHCJYBKBs",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["——\n\n樂山娘拉麵中山店整體給人的感覺相當接地氣，是一間很有「台式靈魂」的拉麵店。湯頭走的是濃郁路線，鹹香厚實，不是日式那種清爽型，反而更貼近台灣人熟悉的口味，喝起來很有滿足感，而且可以加湯這點真的大加分，對於湯控來說非常友善，也讓整碗拉麵從頭到尾都維持在好喝的狀態。\n\n店面裝潢走復古風格，帶點老派懷舊的味道，不浮誇但很有特色，坐在裡面吃麵會有一種時光慢下來的感覺，氣氛輕鬆自在。至於餃子表現就比較普通，口味中規中矩，沒有特別驚艷，如果是第一次來，其實可以把胃容量留給拉麵本身。\n\n另外一個讓人覺得貼心的小細節是支援行動支付，結帳快速又方便，對現在習慣無現金的人來說相當加分。整體來說，樂山娘拉麵不是走精緻系，而是靠實在的湯頭取勝，單純為了拉麵本身，我會願意再回訪。🍜",null,[0,2]]]],[null,null,null,null,null,"https://business.google.com/local/business/3591866835394466115/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDV2xOR1RYaGtTRlp6VmtWRmVsSnFTbXRhYlU1b1dqSkdSbGRGUlJBQhAA",[null,null,null,"/local/business/3591866835394466115/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDV2xOR1RYaGtTRlp6VmtWRmVsSnFTbXRhYlU1b1dqSkdSbGRGUlJBQhAA"],"https://business.google.com/local/business/3591866835394466115/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDV2xOR1RYaGtTRlp6VmtWRmVsSnFTbXRhYlU1b1dqSkdSbGRGUlJBQhAA",[null,null,null,"/local/business/3591866835394466115/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDV2xOR1RYaGtTRlp6VmtWRmVsSnFTbXRhYlU1b1dqSkdSbGRGUlJBQhAA"],null,"https://business.google.com/local/business/3591866835394466115/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDV2xOR1RYaGtTRlp6VmtWRmVsSnFTbXRhYlU1b1dqSkdSbGRGUlJBQhAA",[null,null,null,"/local/business/3591866835394466115/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjVDV2xOR1RYaGtTRlp6VmtWRmVsSnFTbXRhYlU1b1dqSkdSbGRGUlJBQhAA"]],[null,null,3843,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25CWlNGTXhkSFZzVkVFelJqSmtabU5oWjJGRldFRRAB!2m1!1s0x0:0x1edd4325fd0e5742!3m1!1s2@1:CAIQACodChtycF9oOnBZSFMxdHVsVEEzRjJkZmNhZ2FFWEE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT25CWlNGTXhkSFZzVkVFelJqSmtabU5oWjJGRldFRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT25CWlNGTXhkSFZzVkVFelJqSmtabU5oWjJGRldFRRI-Ci9DQUlRQUNvZENodHljRjlvT25CWlNGTXhkSFZzVkVFelJqSmtabU5oWjJGRldFRRILMGRUaWYyLU16VG4aPgovQ0FJUUFDb2RDaHR5Y0Y5b09uQlpTRk14ZEhWc1ZFRXpSakprWm1OaFoyRkZXRUUSCzBkVGlmMi1NelRuIhIJAAAAAAAAAAARQlcO_SVD3R4qCzBkVGl