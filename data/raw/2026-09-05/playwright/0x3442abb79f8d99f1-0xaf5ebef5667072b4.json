DsteWAxXTk68BHf5IDWkQ3IcHCK8BKAk",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_200_TO_400"],"$200-400",2,null,"$200 到 $400","0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3YcHCLIBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3IcHCLEBKAo",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3IcHCLMBKAs",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3IcHCLQBKAw",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3IcHCLUBKA0",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3YcHCLcBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3IcHCLYBKA4",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["評價很高的一間拉麵店，店內除了廚房其他都可以拍，也營業到凌晨，很適合晚上肚子餓的時候來，每天都有不一樣的限定拉麵讓我覺得很特別很酷，以後有機會也可以來試試看限定拉麵。\n\n🍜徹濃 鹽：光用看的就知道很濃了，實際上味道也很濃郁，很重的豚骨味，也因為我多蒜，所以蒜味也超重，吃的很爽，很好吃。\n\n🍜清爽 醬油：湯喝起來比較沒這麼重口味，很清爽尾韻又帶有一股醬油的甜味，比起徹濃我個人好像更喜歡清爽。\n\n🍜一般拉麵的配料都一樣，青菜部分加爆就真的加爆，超級多豆芽菜吃起來超爽，肉有兩種，兩個都偏瘦的肉，讓整體不會變的更油膩，我覺得拉麵很好吃，以後還會再來。\n\n🍜麵條：有中捲麵/細麵/天龍麵，每一碗拉麵都可以免費續一次，這次我三種麵都吃過了，個人覺得天龍麵太硬，細麵還不錯，而我最喜歡的是中捲麵！\n不知道要吃什麼麵的人，我推薦點中捲麵。\n\n🥟炸餃子：我覺得有點太硬了，餃子的麵粉也太多太厚，吃不太到肉的感覺，個人沒有很喜歡可以不用點。\n\n🥢豆芽菜：自助吧那邊有提供豆芽菜，豆芽菜吃起來微辣，淡淡的辣配上脆脆的豆芽菜，不管是單吃或是泡著拉麵吃都很好吃！\n\n整體來說是一家還不錯的拉麵店，以後想吃豚骨拉麵的話又多一個選擇了。",null,[0,83]]]],[null,null,null,null,null,"https://business.google.com/local/business/10009464027420227038/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzTUZKNlFscE5lbXcwV1ZaWmQxWXdaek5qUmtKc1dIcHNSRkl6WXhBQhAA",[null,null,null,"/local/business/10009464027420227038/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBzTUZKNlFscE5lbXcwV1ZaWmQxWXdaek5qUmtKc1dIcHNSRkl6WXhBQ