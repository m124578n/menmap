oCg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11h0fdm5rs"],"徹濃醬油豚骨拉麵",2,null,null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3YcHCGQoAA"]],[1]],null,"建議的餐點",null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3IcHCGMoCw",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3YcHCGYoAA"]],1],null,null,"等待時間",null,"0ahUKEwjNzMjDsteWAxXTk68BHf5IDWkQ3IcHCGUoDA",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["📍豚人拉麵 台灣本店🍜\n\n這次來到豚人拉麵，點了招牌的徹濃醬油拉麵。店家可依照喜好客製化，從湯底、麵條種類到蒜泥、豆芽菜等配料都能自由調整，對喜歡調整口味的人來說相當有彈性。\n\n這次選擇的是徹濃豚骨醬油湯底，豬骨熬煮得相當濃郁，湯頭充滿膠質感與豚骨香氣，醬油則增添了鹹香與層次，整體濃厚卻不至於死鹹。\n\n麵條選擇中捲麵，吸附湯汁的能力很好，帶有Q彈咬勁，每一口都能吃到濃郁的豚骨風味。\n\n配料也相當豐富，炙燒叉燒油脂香氣十足，另一片瘦肉叉燒則保有扎實肉感；溏心蛋熟度恰到好處，豆芽菜增加爽脆口感，大量蒜泥拌入湯中後讓整碗拉麵更加過癮，很適合重口味拉麵愛好者。\n\nAlvin給星｜⭐️⭐️⭐️⭐️⭐️⭐️⭐️\n如果喜歡濃郁系豚骨拉麵，又希望能依照自己的喜好客製化配料與口味，豚人拉麵會是不錯的選擇。\n不過整體口味偏重，建議搭配冰水一起享用，吃起來會更舒服。🍜\n\n2026.04初訪",null,[0,87]]]],[null,null,null,null,null,"https://business.google.com/local/business/10009464027420227038/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVUdKcVNrdGpiV2hJVEZaR2RWUlVhRVppYmsweldXdEtUbUZYWXhBQhAA",[null,null,null,"/local/business/10009464027420227038/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVUdKcVNrdGpiV2hJVEZaR2RWUlVhRVppYmsweldXdEtUbUZYWXhBQhAA"],"https://business.google.com/local/business/10009464027420227038/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVUdKcVNrdGpiV2hJVEZaR2RWUlVhRVppYmsweldXdEtUbUZYWXhBQhAA",[null,null,null,"/local/business/10009464027420227038/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVUdKcVNrdGpiV2hJVEZaR2RWUlVhRVppYmsweldXdEtUbUZYWXhBQhAA"],null,"https://business.google.com/local/business/10009464027420227038/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFHVUdKcVNrdGpiV2hJVEZaR2RWUlVhRVppYmsweldXdEtUbUZYWXhBQhAA