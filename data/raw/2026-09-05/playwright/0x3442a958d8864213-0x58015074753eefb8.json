,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwimpKXQs9eWAxW9d_UHHV2SGj8Q3IcHCOABKAQ",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwimpKXQs9eWAxW9d_UHHV2SGj8Q3IcHCOEBKAU",null,null,null,[3],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["九湯屋的分店現在真的寥寥無幾，本來在我家旁邊有一家，但撐不久就結束營業倒了。當時很喜歡跟同學下課去吃一碗，當然一碗豚骨的只要99元，現在雖然漲價了大概30元，但味道還是沒變，依然是便宜的小吃！（雖然講到這邊可能有人要說那根本台式拉麵，你還吃那麼爽哈哈哈，但我自己是覺得整體來說不難吃。）\n\n今天吃了一碗辣味拉麵加大169元，這樣的價格確實不便宜，但現在要吃到一碗拉麵這已經算是很甜的價格了。味道依舊不變，我覺得主要是麵的硬度我很喜歡，偏軟的麵配上辣味的湯我覺得很可以！\n\n店內的飲料還是喝到飽，真的蠻滿足的，有機會我一定回購！\n\nps.大概19:50左右一進店沒有半個客人有些嚇到...但後來有零星幾位客人進來用餐啦～",null,[0,143]]]],[null,null,null,null,null,"https://business.google.com/local/business/1999306028066652556/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmlNMTk2UVRGQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/1999306028066652556/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmlNMTk2UVRGQlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/1999306028066652556/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmlNMTk2UVRGQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/1999306028066652556/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmlNMTk2UVRGQlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/1999306028066652556/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmlNMTk2UVRGQlJSQUIQAA%3D%3D",[null,null,null,"/local/business/1999306028066652556/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTmlNMTk2UVRGQlJSQUIQAA%3D%3D"]],[null,null,6086,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSUNiM196QTFBRRAB!2m1!1s0x0:0x58015074753eefb8!3m1!1s2@1:CIHM0ogKEICAgICb3_zA1AE%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChdDSUhNMG9nS0VJQ0FnSUNiM196QTFBRRAB\u0026t\u003d1\u0026entityid\u003dChdDSUhNMG9nS0VJQ0Fn