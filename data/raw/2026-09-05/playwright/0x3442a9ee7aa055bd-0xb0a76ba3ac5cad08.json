LkBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwjpyKH5s9eWAxVCka8BHXioDhMQ3IcHCLgBKAg",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwjpyKH5s9eWAxVCka8BHXioDhMQ3IcHCLoBKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjpyKH5s9eWAxVCka8BHXioDhMQ3IcHCLsBKAo",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjpyKH5s9eWAxVCka8BHXioDhMQ3IcHCLwBKAs",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["交通位置超方便，在京站一樓外側的飲食區第一間，很好找\n松露雞白湯選濃的，好吃，味道很夠，愛好松露的必點！還有一顆超大的干貝！\n店內環境不錯，店員很敬業，可惜音樂和點餐的平板綁在一起，有人點餐音樂就會暫停有點好玩\n有超冰的檸檬水和冰水，炎炎夏日很需要！\n免費點加麵的出餐速度不快，建議要加麵的朋友們吃一半就可以點了，但來的加麵竟然是有湯的！根本就是一碗小的沒有料的拉麵！太意外了！讚讚👍是會回訪的店！\n朋友點的叉燒20塊有三片…燒得又漂亮，沒吃到好可惜啊啊，下次必點！",null,[0,105]]]],[null,1717368715000000,1717368715000000,"2 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQm04RDJZY0t6WkJtWFBlTEFBVTB6Zw%7CCAEQrcz1_gkiMAoZQ0hfQm04RDJZY0t6WkJtWFBlTEFBVTB6ZxoTQ2d3SWktX3pzZ1lRNlBuTW53RQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwjpyKH5s9eWAxVCka8BHXioDhMQ_2MIvQEoDA"],"https://business.google.com/local/business/9968557866310692638/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZla296ZUc5M1JSQUIQAA%3D%3D",[null,null,null,"/local/business/9968557866310692638/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZla296ZUc5M1JSQUIQAA%3D%3D"],"https://business.google.com/local/business/9968557866310692638/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZla296ZUc5M1JSQUIQAA%3D%3D",[null,null,null,"/local/business/9968557866310692638/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZla296ZUc5M1JSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/9968557866310692638/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTjZla296ZUc5M1JSQUIQAA%3D%3D",