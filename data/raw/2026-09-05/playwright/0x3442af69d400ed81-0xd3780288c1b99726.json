hUKEwjM2oD9steWAxV4fPUHHa0gOa4Q3IcHCKABKBI",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:WALK_INS_ONLY"],"不接受訂位",2,null,null,"0ahUKEwjM2oD9steWAxV4fPUHHa0gOa4Q3YcHCKIBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwjM2oD9steWAxV4fPUHHa0gOa4Q3IcHCKEBKBM",null,null,null,null,null,3,null,2],[["GUIDED_DINING_NOISE_LEVEL"],"你覺得吵雜程度如何？",[[[["E:DINING_NOISE_LEVEL_LOUD"],"吵雜，但還是能交談",2,null,null,"0ahUKEwjM2oD9steWAxV4fPUHHa0gOa4Q3YcHCKQBKAA"]],1],null,null,"吵雜程度",null,"0ahUKEwjM2oD9steWAxV4fPUHHa0gOa4Q3IcHCKMBKBQ",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_UP_TO_10_MIN"],"最多 10 分鐘",2,null,null,"0ahUKEwjM2oD9steWAxV4fPUHHa0gOa4Q3YcHCKYBKAA"]],1],null,null,"等待時間",null,"0ahUKEwjM2oD9steWAxV4fPUHHa0gOa4Q3IcHCKUBKBU",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["📍 黃金雞湯拉麵（豬）$240\n📍 TKG飯$80\n\n從士林捷運站走出來大約10分鐘內可以抵達，儘量錯開用餐時間，否則就要開始在外面排隊，但店家得出餐速度算是挺快的，所以等候的時間也不會太久。\n\n先自主販賣機點餐結帳，然後等候入座等餐點。麵條有兩種可選擇粗麵及中捲麵條可選擇，雞湯拉麵口味偏重而且湯算是偏油，但是舒肥豬的口感味道很喜歡的，算是有入味，厚度也適中不會讓人咬很久還在吃肉！\n\n但是TKG飯⋯炙燒過後的肉塊加上美乃滋與一顆半熟蛋，可能味道沒有中我的味，他像是介於台式跟日式中間，像是在吃溫泉蛋滷肉飯但是又有加上炙燒跟美乃滋的味道，整體來說，不給過⋯如果你是喜歡是吃完拉麵後來上一碗燒肉飯的人就可以吃看看味道就好了⋯⋯\n\n吧台座位可以清楚看到拉麵的製作過程，工作檯面很乾淨，這一點很加分！店家門口的注意事項記得看過，排隊的時候記得要等人員到齊喔！然後不要解壓縮，不然要重新來過。",null,[0,25]]]],[null,null,null,null,null,"https://business.google.com/local/business/6954279598648027760/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrVVZWclRUSldWa3BzWTNreFQyUlRNRE5qTUZacldWaFpOV1JXUlJBQhAA",[null,null,null,"/local/business/6954279598648027760/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrVVZWclRUSldWa3BzWTNreFQyUlRNRE5qTUZacldWaFpOV1JXUlJBQhAA"],"https://business.google.com/local/business/6954279598648027760/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnBrVVZWclRUSldWa3BzWTNreFQyUlRNRE5qTUZacldWaFpOV1JXUlJBQhAA",[null,null,null,"/local/business/6954279598648027760/customers/reviews/deletereply?p\u003dCkRDaTlE