NING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwj0qMiPtNeWAxXXha8BHe9bMKUQ3IcHCM8BKBE",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_RESERVATION"],"建議訂位嗎？",[[[["E:NOT_SURE"],"不確定",2,null,null,"0ahUKEwj0qMiPtNeWAxXXha8BHe9bMKUQ3YcHCNEBKAA"]],1],null,null,"預訂網址",null,"0ahUKEwj0qMiPtNeWAxXXha8BHe9bMKUQ3IcHCNABKBI",null,null,null,null,null,3,null,2],[["GUIDED_DINING_GROUP_SIZE"],"這裡適合幾個人的聚會？",null,[[[["E:DINING_GROUP_SIZE_ONE"],"1 人",2,null,null,"0ahUKEwj0qMiPtNeWAxXXha8BHe9bMKUQ3YcHCNMBKAA"],[["E:DINING_GROUP_SIZE_TWO"],"2 人",2,null,null,"0ahUKEwj0qMiPtNeWAxXXha8BHe9bMKUQ3YcHCNQBKAE"],[["E:DINING_GROUP_SIZE_THREE_TO_FOUR"],"3 到 4 人",2,null,null,"0ahUKEwj0qMiPtNeWAxXXha8BHe9bMKUQ3YcHCNUBKAI"]]],null,"用餐人數",null,"0ahUKEwj0qMiPtNeWAxXXha8BHe9bMKUQ3IcHCNIBKBM",null,null,null,null,null,3,null,2],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwj0qMiPtNeWAxXXha8BHe9bMKUQ3YcHCNcBKAA"]],1],null,null,"等待時間",null,"0ahUKEwj0qMiPtNeWAxXXha8BHe9bMKUQ3IcHCNYBKBQ",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["來江子翠辦事，先查找美食，春㐂馬上列入名單；今午到時已非一般尖峰時段，所以機器點餐馬上就入座了，先來杯冰水解渴，在吧位靜觀職人煮食。\n首訪點了回憶SP，當然不知回憶什麼？一來是被豐盛吸引、再來是SP肯定是老闆特別設計，首入眼簾的是8~10片叉燒鋪滿碗面，像護著碗裡的神秘力量，再來筍干、蔥花、蒜泥、還有一顆溏心蛋，滿滿的一大碗，還真無處下箸。\n小心掀開一片叉燒，底下又是一層輕燙的高麗菜葉與豆芽，再往下就是搭配的粗麵條，今日選擇稍硬口感，無論是掛湯與口感都上乘，小心吸入麵條，稍硬的豆芽與軟嫩的叉燒形成對比（叉燒應是舒肥再輕炙燒），刻意不混入蒜泥，先品嚐最原先的調配。\n免費的替玉只能有細麵，依然選擇略硬口感，量頗大，但與原來的粗麵條相比，遜色不少；這次將蒜泥和入湯中轉味，初嚐蒜香不錯，但口口都是濃烈，有點吃不消，不過與背脂是相得益彰。\n品一兩口醬油雞湯拉麵，對其柚子底味印象不錯，湯清味厚。\n喔，值得一題的是，個人連替玉都吃完後，湯幾已見底，碗內仍冒出熱氣餘煙，顯然整體保溫不錯，美好的一次用餐。",null,[0,171]]]],[null,null,null,null,null,"https://business.google.com/local/business/2280445106663200326/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvUTFSdVRreFhWbFY2WWxoc2FWSXhXa1psYmxweVlUQnNkMHhZWXhBQhAA",[null,null,null,"/local/business/2280445106663200326/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvUTFSdVRreFhWbFY2WWxoc2FWSXhXa1psYmxweVlUQnNkMHhZWXhBQhAA"],"https: