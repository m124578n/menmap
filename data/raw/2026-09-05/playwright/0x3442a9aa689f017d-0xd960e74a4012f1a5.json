n總結來說，這是一家如果突然想念日本風味、想要體驗道地拉麵職人精神時，非常適合來訪的溫馨小店 🇯🇵👍",null,[0,49]]]],[null,null,null,null,null,"https://business.google.com/local/business/2280445106663200326/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYlZORmVFOVVTRkYzVVROT2RsUXdNVzFWTUVaWFQxWm5NbGx1WXhBQhAA",[null,null,null,"/local/business/2280445106663200326/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYlZORmVFOVVTRkYzVVROT2RsUXdNVzFWTUVaWFQxWm5NbGx1WXhBQhAA"],"https://business.google.com/local/business/2280445106663200326/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYlZORmVFOVVTRkYzVVROT2RsUXdNVzFWTUVaWFQxWm5NbGx1WXhBQhAA",[null,null,null,"/local/business/2280445106663200326/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYlZORmVFOVVTRkYzVVROT2RsUXdNVzFWTUVaWFQxWm5NbGx1WXhBQhAA"],null,"https://business.google.com/local/business/2280445106663200326/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYlZORmVFOVVTRkYzVVROT2RsUXdNVzFWTUVaWFQxWm5NbGx1WXhBQhAA",[null,null,null,"/local/business/2280445106663200326/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFXYlZORmVFOVVTRkYzVVROT2RsUXdNVzFWTUVaWFQxWm5NbGx1WXhBQhAA"]],[null,null,2340,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21WbVNFeE9USFF3UTNOdlQwMW1VMEZXT1ZnMlluYxAB!2m1!1s0x0:0xd960e74a4012f1a5!3m1!1s2@1:CAIQACodChtycF9oOmVmSExOTHQwQ3NvT01mU0FWOVg2Ync%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT21WbVNFeE9USFF3UTNOdlQwMW1VMEZXT1ZnMlluYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT21WbVNFeE9USFF3UTNOdlQwMW1VMEZXT1ZnMlluYxI-Ci9DQUlRQUNvZENodHljRjlvT21WbVNFeE9USFF3UTNOdlQwMW1VMEZXT1ZnMlluYxILMGVGY2NINzJjUUEaPgovQ0FJUUFDb2RDaHR5Y0Y5b09tVm1TRXhPVEhRd1EzTnZUMDFtVTBGV09WZzJZbmMSCzBlRmNjSDcyY1FBIhIJAAAAAAAAAAARpfESQErnYNkqCzBlRmNjSDcyY1FB\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUK