null,null,null,[3],null,2,null,1],[["GUIDED_DINING_WAIT_TIME"],"候位時間多久？",[[[["E:DINING_WAIT_TIME_NO_WAIT"],"不需等候",2,null,null,"0ahUKEwiroanTs9eWAxVtYvUHHf5gK-UQ3YcHCL0BKAA"]],1],null,null,"等待時間",null,"0ahUKEwiroanTs9eWAxVtYvUHHf5gK-UQ3IcHCLwBKAc",null,null,null,null,null,3,null,2],[["GUIDED_DINING_SEATING_TYPE"],"可選擇哪些類型的座位？",null,[[[["E:DINING_SEATING_TYPE_INDOOR_DINING_AREA"],"室內用餐區",2,null,null,"0ahUKEwiroanTs9eWAxVtYvUHHf5gK-UQ3YcHCL8BKAA"]]],null,"座位類型",null,"0ahUKEwiroanTs9eWAxVtYvUHHf5gK-UQ3IcHCL4BKAg",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["南瓜沾麵好吃，南瓜湯很鹹，不過旁邊有附高湯可自己調整，很用心，推薦\n不過餐點來的時候不是超熱的，加上冷氣強，食物很快便涼掉\n\n胡麻豆漿麵，本來期待是滑順的湯，但其實是像豆漿加到酸那樣結塊，湯吃起來比較油膩\n\n正好音箱在頭上，音樂只有幾個稍快節奏不斷重複，加上旁邊客人講話很大聲，整個氣氛會讓人厭煩\n\n餐桌蠻小、每人一份餐點後就很擁擠，最好不要加點東西，會放不下\n\n餐巾紙只有少少幾張、還有水、辣椒..等沒有了都需要再麻煩服務生拿，偏偏服務生目光都不太會看過來、引起注意有點難度，得要自己走過去或是大聲加大動作引起關注😅😅😅",null,[0,61]]]],[null,1786501168000000,1786501168000000,"3 週前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfcVJaQ0VWcXJpRlNFbGZDOTFCRzZmZw%7CCAEQrcz1_gkiMAoZQ0hfcVJaQ0VWcXJpRlNFbGZDOTFCRzZmZxoTQ2d3SXNMRHYwd1lReVA3NC1BSQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwiroanTs9eWAxVtYvUHHf5gK-UQ_2MIwAEoCQ"],"https://business.google.com/local/business/12466397357648748125/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxY2xwSVpITlpla1Y2VVRBd01XRnVhSGRaTUhoeVpXc3hNbE5YWXhBQhAA",[null,null,null,"/local/business/12466397357648748125/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxY2xwSVpITlpla1Y2VVRBd01XRnVhSGRaTUhoeVpXc3hNbE5YWXhBQhAA"],"https://business.google.com/local/business/12466397357648748125/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxY2xwSVpITlpla1Y2VVRBd01XRnVhSGRaTUhoeVpXc3hNbE5YWXhBQhAA",[null,null,null,"/local/business/12466397357648748125/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjAxY2xwSVpITlpla1Y2VVRBd01XRnVhSGRaTUhoeVpXc3hNbE5YW