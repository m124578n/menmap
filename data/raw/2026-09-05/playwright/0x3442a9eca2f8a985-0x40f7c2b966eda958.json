QQ3IcHCH0oDQ",null,null,null,null,null,4,[[3]],2]],null,null,null,null,null,null,null,["zh-Hant"],[["帶媽媽來吃\n原來自家附近還有這麼好吃的拉麵\n點完餐老闆娘還貼心的問一下阿姨的麵要軟一點嗎\n拉麵好吃，吃起來有日本拉麵的水準\n唐揚雞更是好吃，有湯汁（我個人覺得比日本拉麵店的好吃😅）\n店內竟敢還有販賣巴斯克蛋糕跟焦糖布丁，超想吃的，可惜已經吃不下了\n下次再專門來吃甜點。\n老闆加油，手藝很讚，阿母說好吃。",null,[0,44]]]],[null,null,null,null,null,"https://business.google.com/local/business/6419021934772385637/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPV2xveE9YbFJWVW8yWld0d1psb3llR3hVV0VrMFVURTVVR014UlJBQhAA",[null,null,null,"/local/business/6419021934772385637/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPV2xveE9YbFJWVW8yWld0d1psb3llR3hVV0VrMFVURTVVR014UlJBQhAA"],"https://business.google.com/local/business/6419021934772385637/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPV2xveE9YbFJWVW8yWld0d1psb3llR3hVV0VrMFVURTVVR014UlJBQhAA",[null,null,null,"/local/business/6419021934772385637/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPV2xveE9YbFJWVW8yWld0d1psb3llR3hVV0VrMFVURTVVR014UlJBQhAA"],null,"https://business.google.com/local/business/6419021934772385637/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPV2xveE9YbFJWVW8yWld0d1psb3llR3hVV0VrMFVURTVVR014UlJBQhAA",[null,null,null,"/local/business/6419021934772385637/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhPV2xveE9YbFJWVW8yWld0d1psb3llR3hVV0VrMFVURTVVR014UlJBQhAA"]],[null,null,1487,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xOWloxOXlRVUo2ZWtwZloyeGxUWEk0UTE5UGMxRRAB!2m1!1s0x0:0x40f7c2b966eda958!3m1!1s2@1:CAIQACodChtycF9oOlNZZ19yQUJ6ekpfZ2xlTXI4Q19Pc1E%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xOWloxOXlRVUo2ZWtwZloyeGxUWEk0UTE5UGMxRRAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlRQUNvZENodHljRjlvT2xOWloxOXlRVUo2ZWtwZloyeGxUWEk0UTE5UGMxRRI-Ci9DQUlRQUNvZENodHljRjlvT2xOWloxOXlRVUo2ZWtwZloyeGxUWEk0UT