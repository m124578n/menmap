2oOrEDfBXIrLKqB9lmMACe8PsvpL3Er76x1HSHw9UI1q4NjGuTooQEU0Nv7mz3xmCGsZ6v-bPCzu1vzD791G1LjN2p99-O5hY1i2SWlwXQ0BcUPQOgRvOmuslIcE7GyBim9FqA\u003dk-no",null,[3024,3024]],null,[[3,121.49062922109552,25.057469963068712],[0,90],[3024,3024],75],"8gacaprWGOO7vr0Pnv_hoAY","0ahUKEwial4HItNeWAxXjna8BHZ5_GGQQzCcI8wEoBQ",["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIC8qpPQkQE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x40f7c2b966eda958",null,null,"0ahUKEwial4HItNeWAxXjna8BHZ5_GGQQ-y4I9AEoAA"],null,null,null,null,null,null,null,null,null,[null,[10,"CIHM0ogKEICAgIC8qpPQkQE"],[10,3,[3024,3024]],[null,null,null,null,null,null,null,["恩麵屋 N-noodle House"]],[null,[[["Sohy"],"https://www.google.com/maps/contrib/103374187254901087662?hl\u003dzh-TW","https://lh3.googleusercontent.com/a-/ALV-UjUEYQJIqZkUa0-tmhcSBSGw9icsm0xG8BEWrackjWjj78CBFGcp\u003ds120-c-rp-mo-ba12-br100",null,null,"103374187254901087662"]]],[[[2],[[null,null,null,null,1]]]],[2,null,null,null,null,[null,null,null,[7,3]],null,null,[2020,7,2,6,null,null,null,null,["6 年前"]]],["//www.google.com/local/content/rap/report?postId\u003d!1e10!2sCIHM0ogKEICAgIC8qpPQkQE\u0026t\u003d27\u0026cb_client\u003dmaps_sv.tactile\u0026fid\u003d0x0:0x40f7c2b966eda958"]],1,null,null,null,null,null,null,["0","4681424439226509656"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["ChZDSUhNMG9nS0VJQ0FnSUM4cXFQcExBEAE"]],"CIHM0ogKEICAgIC8qpPQkQE",1]],null,null,null,null,null,null,null,null,null,null,null,["zh-Hant"],[["麵熟有勁，湯頭應是自熬，沒有味精的回甘澀味和調出來的粉味，香不死鹹，湯頭很順，也沒有可怕的大蒜味去蓋過，這次點唐揚炸雞拉麵（炸物分開），湯麵部分非常穩定，給料很實在，該有的都有，尤其是炸物，點一次還會想再點一盤からげ，另點的拌麵，其中叉燒有厚度有口感，不像附近的連鎖拉麵屋薄薄一片筷子攪一下就化掉的那種，且叉燒肉有炭烤的香氣，油脂和肉的比例拿捏的不錯，尤其是這扮麵給的叉燒分量，對於這價位真的是是很超值了，口味和湯麵一樣穩定，整體性佳。\n\nBUT：套餐附的冰鮮奶茶有點過甜，要喝奶之前請先問店員可否調整甜度。\n\n總結：平民的價格，有著這價位水準之上的一間拉麵店，所有麵類可以免費再加麵一次，店面乾淨舒服(用餐區尾巴有手洗台)，是一間顧客回頭率很高的拉麵店，私心認為以這價位其品質，在三盧地區絕對能排前三，因開店不久，希望能持續保持這水準，推薦大家嘗試。",null,[0,218]]]],[null,1593914786000000,1593919446000000,"6 年前",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQUFWRk5ra05ReXRrVll0ckFBSnBsdw%7CCAEQrcz1_gkiMAoZQ0hfQUFWRk5ra05ReXRrVll0ckFBSnBsdxoTQ2d3STFvLUYtQVVReU1LRXZ3TQ\u0026t\u003d7\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwial4HItNeWAxXjna8BHZ5_GGQQ_2MI9QEoBg"],"https://business.google.com/local/business/6419021934772385637/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTTRjWEZRY0V4QkVBRRAA",[null,null,null,"/local/business/6419021934772385637/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTTRjWEZRY0V4QkVBRRAA"],"https://business.google.com/local/business/6419021934772385637/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTTRjWEZRY0V4QkVBRRAA",[null,null,null,"/local/business/6419021934772385637/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTTRjWEZRY0V4QkVBRRAA"],null,"https://business.google.com/local/business/6419021934772385637/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTTRjWEZRY0V4QkVBRRAA",[null,null,null,"/local/business/6419021934772385637/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTTRjWEZRY0V4QkVBRRAA"],null,["zh-Hant"],[["感謝您的推薦和評價 我們會繼續努力 歡迎再次光臨😊",null,[0,25]]]],[null,null,7205,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUM4cXFQcExBEAE!2m1!1s0x0:0x40f7c2b966eda958!3m1!1s2@1:CIHM0ogKEICAgIC8qqPpLA%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnSUM4cXFQcExBEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnSUM4cXFQcExBEi4KF0NJSE0wb2dLRUlDQWdJQzhxcVBwckFFEhNDZ3dJcXZmMjl3VVFrS1QyaEFFGi0KFkNJSE0wb2dLRUlDQWdJQzhxcVBwYkESE0Nnd0l1ZjcxOXdVUXVMQ3FpQUUiEgkAAAAAAAAAABFYqe1mucL3QCoLMFR6UWpzVVJwbGs\u0026wv\u003d1\u0026d\u003d286732320",null,null,"0ahUKEwial4HItNeWAxXjna8BHZ5_GGQQoykI9gEoBw"],null,[null,[[1,11]]]],"0ahUKEwiZsIjItNeWAxWveV4EHQTiLdIQ0pMFCJ8BKAc"],null,null,null,"0ahUKEwial4HItNeWAxXjna8BHZ5_GGQQ0pMFCOkBKAc"]],