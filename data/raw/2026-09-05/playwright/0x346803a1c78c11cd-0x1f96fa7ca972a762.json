ull,null,[4],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwj126-ltNeWAxWGjq8BHVBnCIcQ3IcHCLEBKBI",null,null,null,[3],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[null,[1]],null,"建議的餐點",null,"0ahUKEwj126-ltNeWAxWGjq8BHVBnCIcQ3IcHCLIBKBM",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["路過很多次，店家不大，位置很少，看到很多人排隊吃，但從沒吃過，是好吃的台式拉麵值得吃2次以上。店家要關火了，還會提前問每個客人是否還要再加麵，相當貼心，開店的真的不要怕好客人吃（奧客除外）。這服務態度以及認真的態度贏過太多店家了。\n\n湯頭（正常），比一般家裡的鹹在鹹一點。湯頭濃算好喝。\n麵條（正常），也是偏硬，吃的到麵心的感覺，但我自己覺得剛好。\n叉燒，有稍微炙燒過，味道剛好。\n糖心蛋，冰涼冰涼，就是搭配而已，裡面最普通的比筍絲還普通。",null,[0,115]]]],[null,null,null,null,null,"https://business.google.com/local/business/16107387692899060807/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUkpkSFpEYkV4bkVBRRAA",[null,null,null,"/local/business/16107387692899060807/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUkpkSFpEYkV4bkVBRRAA"],"https://business.google.com/local/business/16107387692899060807/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUkpkSFpEYkV4bkVBRRAA",[null,null,null,"/local/business/16107387692899060807/customers/reviews/deletereply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUkpkSFpEYkV4bkVBRRAA"],null,"https://business.google.com/local/business/16107387692899060807/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUkpkSFpEYkV4bkVBRRAA",[null,null,null,"/local/business/16107387692899060807/customers/reviews/reply?p\u003dCiNDaFpEU1VoTk1HOW5TMFZKUTBGblRVUkpkSFpEYkV4bkVBRRAA"]],[null,null,10674,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnTURJdHZDbExnEAE!2m1!1s0x0:0x1f96fa7ca972a762!3m1!1s2@1:CIHM0ogKEICAgMDItvClLg%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dChZDSUhNMG9nS0VJQ0FnTURJdHZDbExnEAE\u0026t\u003d1\u0026entityid\u003dChZDSUhNMG9nS0VJQ0FnTURJdHZDbExnEi4KF0NJSE0wb2dLRUlDQWdNREl0dkNscmdFEhNDZ3dJN2FIYXZ3WVE2T1g4M3dJGi0KFkNJSE0wb2dLRU