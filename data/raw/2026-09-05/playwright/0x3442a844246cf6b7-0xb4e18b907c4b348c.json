l,"0ahUKEwjJwKPCtNeWAxU8j68BHeW5BbMQ3IcHCH4oBw",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwjJwKPCtNeWAxU8j68BHeW5BbMQ3IcHCH8oCA",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwjJwKPCtNeWAxU8j68BHeW5BbMQ3IcHCIABKAk",null,null,null,[4],null,2,null,1],[["GUIDED_DINING_DISH_RECOMMENDATION"],"你推薦哪道料理？",null,[[[["M:/g/11fpgh_15n"],"胡麻豆腐",2,null,null,"0ahUKEwjJwKPCtNeWAxU8j68BHeW5BbMQ3YcHCIIBKAA"]],[1]],null,"建議的餐點",null,"0ahUKEwjJwKPCtNeWAxU8j68BHeW5BbMQ3IcHCIEBKAo",null,null,null,null,null,3,null,2]],null,null,null,null,null,null,null,["zh-Hant"],[["每次用餐時間外面總是大排長龍，觀望了很久終於來吃啦！\n\n這次點了胡麻豆腐，真的非常好吃✨豆腐口感細膩滑順，搭配濃郁胡麻醬超合拍，直接列入我的必點清單❤️相較之下揚出豆腐就覺得比較普通，個人還是偏好外皮裹粉、炸到會掉屑屑的那種炸法\n\n另外一個必點是餃子🥟\n如果只看酥脆度算是中規中矩，但餃子皮的厚度我很喜歡，有嚼勁又不會太厚重，內餡滿滿高麗菜的鮮甜，沾上靈魂醬油真的好好吃🤤\n\n拉麵點了野菜豚骨拉麵，跟招牌豚骨拉麵比起來，多了高麗菜、木耳、玉米，還有一點像燒肉飯會出現的燒肉，不過就少了叉燒、筍乾跟海苔。這次選細麵，麵條表現不錯，跟豚骨湯頭蠻搭的～只是把蔬菜吃完後，底下的湯已經有點涼掉，覺得有點可惜，好想每一口湯都能熱騰騰🍜\n\n附的茶也意外地好喝，整體來說是一家在家裡附近、讓人感覺很溫馨的拉麵館，下次還會想再來吃餃子跟胡麻豆腐！",null,[0,26]]]],[null,null,null,null,null,"https://business.google.com/local/business/10769450912268087798/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4V1dSclZuUmFNMEYwVG14Sk1GSXhUVFJpU0ZZeVpWY3dkRTFXUlJBQhAA",[null,null,null,"/local/business/10769450912268087798/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4V1dSclZuUmFNMEYwVG14Sk1GSXhUVFJpU0ZZeVpWY3dkRTFXUlJBQhAA"],"https://business.google.com/local/business/10769450912268087798/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4V1dSclZuUmFNMEYwVG14Sk1GSXhUVFJpU0ZZeVpWY3dkRTFXUlJBQhAA",[null,null,null,"/local/business/10769450912268087798/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMmt4V1dSclZuUmFNMEYwVG14Sk1GSXhUVFJpU0ZZeVpWY3dkRTFXUlJBQhAA"],null,"https://business.google.com/local/business/10769450912268087798/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMm