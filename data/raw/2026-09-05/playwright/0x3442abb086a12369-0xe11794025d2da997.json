ull,"氣氛",null,"0ahUKEwiuwZzAsteWAxWSa_UHHVKxALcQ3IcHCOABKAU",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["這次來吃一幻拉麵，整體印象還不錯。店內主打蝦味濃厚的湯頭，一上桌就可以聞到很香的海鮮氣息，入口之後更是濃郁又帶點甘甜，層次感很夠，喜歡重口味的人應該會很滿意。\n\n不過份量的部分稍微偏少，吃完會有一點意猶未盡的感覺，尤其如果平常食量比較大，可能需要加麵或點一些配菜才會比較有飽足感。以這個價位來說，CP值就稍微被拉低了一點。\n\n整體來說，湯頭真的很有記憶點，是會讓人想再回訪的關鍵。如果你是第一次嘗試蝦味拉麵，這家很值得試試看，但建議可以做好「吃不太飽」的心理準備。",null,[0,161]]]],[null,null,null,null,null,"https://business.google.com/local/business/882834120084311278/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZEU5Rk5XdGtWVXB6VVZac1IxVkZValZUVjFJeVZsVjBUMXBZWXhBQhAA",[null,null,null,"/local/business/882834120084311278/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZEU5Rk5XdGtWVXB6VVZac1IxVkZValZUVjFJeVZsVjBUMXBZWXhBQhAA"],"https://business.google.com/local/business/882834120084311278/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZEU5Rk5XdGtWVXB6VVZac1IxVkZValZUVjFJeVZsVjBUMXBZWXhBQhAA",[null,null,null,"/local/business/882834120084311278/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZEU5Rk5XdGtWVXB6VVZac1IxVkZValZUVjFJeVZsVjBUMXBZWXhBQhAA"],null,"https://business.google.com/local/business/882834120084311278/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZEU5Rk5XdGtWVXB6VVZac1IxVkZValZUVjFJeVZsVjBUMXBZWXhBQhAA",[null,null,null,"/local/business/882834120084311278/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhGZEU5Rk5XdGtWVXB6VVZac1IxVkZValZUVjFJeVZsVjBUMXBZWXhBQhAA"]],[null,null,2964,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xFdE9FNWtkVUpzUVZsR1VFUjVTV1IyVlV0T1pYYxAB!2m1!1s0x0:0xe11794025d2da997!3m1!1s2@1:CAIQACodChtycF9oOlEtOE5kdUJsQVlGUER5SWR2VUtOZXc%7C%7C?hl\u003dzh-TW"],["https://www.google.com/local/content/rap/report?postId\u003dCi9DQUlRQUNvZENodHljRjlvT2xFdE9FNWtkVUpzUVZsR1VFUjVTV1IyVlV0T1pYYxAB\u0026t\u003d1\u0026entityid\u003dCi9DQUlR