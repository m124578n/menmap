PE"],"用餐類型為何？",[[[["E:LUNCH"],"午餐",2,null,null,"0ahUKEwih5s_UtNeWAxWZQfUHHfRBHgoQ3YcHCMYBKAA"]],1],null,null,"餐點類型",null,"0ahUKEwih5s_UtNeWAxWZQfUHHfRBHgoQ3IcHCMUBKAY",null,null,null,null,null,1,null,2],[["GUIDED_DINING_PRICE_RANGE"],"每個人平均花費多少？",[[[["E:TWD_1_TO_200"],"$1-200",2,null,"$1 到 $200","0ahUKEwih5s_UtNeWAxWZQfUHHfRBHgoQ3YcHCMgBKAA"]],1],null,null,"平均每人消費金額",null,"0ahUKEwih5s_UtNeWAxWZQfUHHfRBHgoQ3IcHCMcBKAc",null,null,null,null,null,1,[[2]],2],[["GUIDED_DINING_FOOD_ASPECT"],"餐點",null,null,null,"餐點",null,"0ahUKEwih5s_UtNeWAxWZQfUHHfRBHgoQ3IcHCMkBKAg",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_SERVICE_ASPECT"],"服務",null,null,null,"服務",null,"0ahUKEwih5s_UtNeWAxWZQfUHHfRBHgoQ3IcHCMoBKAk",null,null,null,[5],null,2,null,1],[["GUIDED_DINING_ATMOSPHERE_ASPECT"],"氣氛",null,null,null,"氣氛",null,"0ahUKEwih5s_UtNeWAxWZQfUHHfRBHgoQ3IcHCMsBKAo",null,null,null,[5],null,2,null,1]],null,null,null,null,null,null,null,["zh-Hant"],[["原址是我在附近最喜歡的飲料店，很可惜敵不過疫情GG了。\n新開了連鎖的拉麵店，光從碗的外觀來看的話會覺得很空虛，但實際吃完麵份量還是可以的。拉麵所有的肉在上桌前都會炙烤一下，別有一股香氣。\n拉麵湯頭還可以，特製辣醬其實不辣，但很香，可以一試。\n唐揚雞有點軟弱，其實不是特別好吃，對唐揚雞很要求的人來說可能會影響用餐體驗。\n服務態度很好，人員很熱情。以同等價位來看，整體是值得有五星評價的店，希望可以維持下去。",null,[0,120]]]],[null,null,null,null,null,"https://business.google.com/local/business/9540172155158087582/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTktjVFJoUVRGUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/9540172155158087582/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTktjVFJoUVRGUlJSQUIQAA%3D%3D"],"https://business.google.com/local/business/9540172155158087582/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTktjVFJoUVRGUlJSQUIQAA%3D%3D",[null,null,null,"/local/business/9540172155158087582/customers/reviews/deletereply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTktjVFJoUVRGUlJSQUIQAA%3D%3D"],null,"https://business.google.com/local/business/9540172155158087582/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTktjVFJoUVRGUlJSQUIQAA%3D%3D",[null,null,null,"/local